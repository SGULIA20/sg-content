Dialogue: 0,0:00:00.00,0:00:01.70,Default,,0,0,0,,Ravan ne Ram ki maa ko
Dialogue: 0,0:00:01.70,0:00:03.16,Default,,0,0,0,,samundar mein qaid kiya?
Dialogue: 0,0:00:03.16,0:00:04.61,Default,,0,0,0,,Woh bhi Ram ke janm se
Dialogue: 0,0:00:04.61,0:00:05.10,Default,,0,0,0,,pehle.
Dialogue: 0,0:00:05.10,0:00:07.29,Default,,0,0,0,,Yeh katha har taraf phones par
Dialogue: 0,0:00:07.29,0:00:08.26,Default,,0,0,0,,ghoom rahi hai.
Dialogue: 0,0:00:08.26,0:00:10.20,Default,,0,0,0,,Lekin yeh likhi kahan hai?
Dialogue: 0,0:00:10.65,0:00:12.27,Default,,0,0,0,,Jawab chaunkane wala hai.
Dialogue: 0,0:00:12.27,0:00:13.88,Default,,0,0,0,,Yeh katha sach mein Sanskrit ke
Dialogue: 0,0:00:13.88,0:00:14.89,Default,,0,0,0,,granth mein likhi hai.
Dialogue: 0,0:00:14.89,0:00:16.71,Default,,0,0,0,,Uska naam hai Ananda Ramayan.
Dialogue: 0,0:00:16.71,0:00:18.93,Default,,0,0,0,,Lekin woh Valmiki ki Ramayan nahi
Dialogue: 0,0:00:18.93,0:00:19.13,Default,,0,0,0,,hai.
Dialogue: 0,0:00:19.58,0:00:21.12,Default,,0,0,0,,To phir sawaal uthta hai.
Dialogue: 0,0:00:21.12,0:00:23.31,Default,,0,0,0,,Valmiki mein yeh katha kyun nahi
Dialogue: 0,0:00:23.31,0:00:23.75,Default,,0,0,0,,milti?
Dialogue: 0,0:00:23.75,0:00:25.95,Default,,0,0,0,,Aur Ananda Ramayan likhi kab gayi?
Dialogue: 0,0:00:25.95,0:00:28.36,Default,,0,0,0,,Iska jawab aapko hairaan karega,
Dialogue: 0,0:00:28.36,0:00:30.34,Default,,0,0,0,,kyunki tareekh bahut baad ki hai.
Dialogue: 0,0:00:30.79,0:00:31.22,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:00:31.22,0:00:32.74,Default,,0,0,0,,sabut ke saath chalte hain.
Dialogue: 0,0:00:32.74,0:00:34.92,Default,,0,0,0,,Viral katha se shuru karenge,
Dialogue: 0,0:00:34.92,0:00:35.78,Default,,0,0,0,,phir Sanskrit granth,
Dialogue: 0,0:00:35.78,0:00:37.74,Default,,0,0,0,,phir mitti ke neeche ke sabut.
Dialogue: 0,0:00:37.74,0:00:39.91,Default,,0,0,0,,Har kadam par label saaf rahega.
Dialogue: 0,0:00:40.36,0:00:42.00,Default,,0,0,0,,Lekin pehle samajhiye,
Dialogue: 0,0:00:42.00,0:00:44.35,Default,,0,0,0,,yeh katha itni pakad kyun rahi
Dialogue: 0,0:00:44.35,0:00:44.59,Default,,0,0,0,,hai.
Dialogue: 0,0:00:44.59,0:00:46.70,Default,,0,0,0,,Kyunki isme Ravan ka darr hai,
Dialogue: 0,0:00:46.70,0:00:48.82,Default,,0,0,0,,Brahma ki bhavishyavani hai,
Dialogue: 0,0:00:48.82,0:00:51.16,Default,,0,0,0,,aur samundar ke beech chhupa dibba
Dialogue: 0,0:00:51.16,0:00:51.40,Default,,0,0,0,,hai.
Dialogue: 0,0:00:51.85,0:00:52.85,Default,,0,0,0,,Shuruaat granth se.
Dialogue: 0,0:00:52.85,0:00:55.61,Default,,0,0,0,,Ananda Ramayan ke Sara Kanda mein
Dialogue: 0,0:00:55.61,0:00:57.11,Default,,0,0,0,,yeh katha aati hai.
Dialogue: 0,0:00:57.11,0:00:59.62,Default,,0,0,0,,Kanda yaani granth ka bada hissa,
Dialogue: 0,0:00:59.62,0:01:01.38,Default,,0,0,0,,jaise kitab ka adhyay.
Dialogue: 0,0:01:01.38,0:01:03.13,Default,,0,0,0,,Ab suniye kya likha hai.
Dialogue: 0,0:01:03.58,0:01:05.72,Default,,0,0,0,,Katha mein Ravan Brahma se poochhta
Dialogue: 0,0:01:05.72,0:01:05.94,Default,,0,0,0,,hai,
Dialogue: 0,0:01:05.94,0:01:07.66,Default,,0,0,0,,meri maut kiske haath hogi?
Dialogue: 0,0:01:07.66,0:01:09.37,Default,,0,0,0,,Brahma ka jawab seedha hai.
Dialogue: 0,0:01:09.37,0:01:12.16,Default,,0,0,0,,Kaushalya aur Dasharath ka beta tumhari
Dialogue: 0,0:01:12.16,0:01:13.66,Default,,0,0,0,,maut ka kaaran banega.
Dialogue: 0,0:01:14.11,0:01:14.56,Default,,0,0,0,,Socho,
Dialogue: 0,0:01:14.56,0:01:15.90,Default,,0,0,0,,Ravan jaisa raja,
Dialogue: 0,0:01:15.90,0:01:17.69,Default,,0,0,0,,aur usse darr lag raha hai.
Dialogue: 0,0:01:17.69,0:01:18.13,Default,,0,0,0,,Kisse?
Dialogue: 0,0:01:18.13,0:01:19.25,Default,,0,0,0,,Aise bachche se,
Dialogue: 0,0:01:19.25,0:01:21.26,Default,,0,0,0,,jo abhi paida bhi nahi hua.
Dialogue: 0,0:01:21.26,0:01:23.50,Default,,0,0,0,,Yahi darr poori katha ko aage
Dialogue: 0,0:01:23.50,0:01:24.39,Default,,0,0,0,,dhakelta hai.
Dialogue: 0,0:01:24.84,0:01:25.71,Default,,0,0,0,,Granth kehta hai,
Dialogue: 0,0:01:25.71,0:01:28.11,Default,,0,0,0,,Kaushalya ki shaadi hone hi wali
Dialogue: 0,0:01:28.11,0:01:28.33,Default,,0,0,0,,thi.
Dialogue: 0,0:01:28.33,0:01:30.52,Default,,0,0,0,,Theek usse pehle Ravan aata hai,
Dialogue: 0,0:01:30.52,0:01:32.92,Default,,0,0,0,,aur rajkumari ko utha le jaata
Dialogue: 0,0:01:32.92,0:01:33.13,Default,,0,0,0,,hai.
Dialogue: 0,0:01:33.13,0:01:34.22,Default,,0,0,0,,Shaadi se pehle,
Dialogue: 0,0:01:34.22,0:01:34.88,Default,,0,0,0,,dhyaan dijiye.
Dialogue: 0,0:01:35.33,0:01:37.17,Default,,0,0,0,,Phir Ravan use maarta nahi.
Dialogue: 0,0:01:37.17,0:01:39.22,Default,,0,0,0,,Woh Kaushalya ko lakdi ke dibbe
Dialogue: 0,0:01:39.22,0:01:40.25,Default,,0,0,0,,mein band karta hai.
Dialogue: 0,0:01:40.25,0:01:42.30,Default,,0,0,0,,Aur dibba rakh deta hai samundar
Dialogue: 0,0:01:42.30,0:01:42.71,Default,,0,0,0,,ke beech,
Dialogue: 0,0:01:42.71,0:01:43.53,Default,,0,0,0,,sunsaan dweep par.
Dialogue: 0,0:01:43.98,0:01:46.23,Default,,0,0,0,,Dweep yaani paani se ghira zameen
Dialogue: 0,0:01:46.23,0:01:46.90,Default,,0,0,0,,ka tukda.
Dialogue: 0,0:01:46.90,0:01:47.80,Default,,0,0,0,,Na koi raasta,
Dialogue: 0,0:01:47.80,0:01:48.47,Default,,0,0,0,,na koi naav.
Dialogue: 0,0:01:48.47,0:01:49.59,Default,,0,0,0,,Ravan sochta hai,
Dialogue: 0,0:01:49.59,0:01:51.17,Default,,0,0,0,,shaadi hi nahi hogi,
Dialogue: 0,0:01:51.17,0:01:52.74,Default,,0,0,0,,to beta kaise hoga?
Dialogue: 0,0:01:53.19,0:01:54.64,Default,,0,0,0,,Lekin yahan twist hai.
Dialogue: 0,0:01:54.64,0:01:58.02,Default,,0,0,0,,Raja Dasharath samundar ke raste nikalte
Dialogue: 0,0:01:58.02,0:01:58.27,Default,,0,0,0,,hain.
Dialogue: 0,0:01:58.27,0:02:00.92,Default,,0,0,0,,Raaste mein Ravan ghaat lagakar hamla
Dialogue: 0,0:02:00.92,0:02:01.65,Default,,0,0,0,,karta hai.
Dialogue: 0,0:02:01.65,0:02:04.31,Default,,0,0,0,,Ghaat lagana yaani chhup kar achanak
Dialogue: 0,0:02:04.31,0:02:04.55,Default,,0,0,0,,waar.
Dialogue: 0,0:02:05.00,0:02:06.69,Default,,0,0,0,,Dasharath bach jaate hain.
Dialogue: 0,0:02:06.69,0:02:08.86,Default,,0,0,0,,Lehron ke saath woh usi sunsaan
Dialogue: 0,0:02:08.86,0:02:10.30,Default,,0,0,0,,dweep tak pahunchte hain.
Dialogue: 0,0:02:10.30,0:02:12.23,Default,,0,0,0,,Aur wahan unhe milta hai,
Dialogue: 0,0:02:12.23,0:02:14.16,Default,,0,0,0,,wahi lakdi ka band dibba.
Dialogue: 0,0:02:14.61,0:02:15.78,Default,,0,0,0,,Dibba khulta hai,
Dialogue: 0,0:02:15.78,0:02:17.17,Default,,0,0,0,,andar Kaushalya hain.
Dialogue: 0,0:02:17.17,0:02:18.34,Default,,0,0,0,,Aur granth kehta hai,
Dialogue: 0,0:02:18.34,0:02:21.14,Default,,0,0,0,,unka Gandharva vivah dibbe ke andar
Dialogue: 0,0:02:21.14,0:02:22.30,Default,,0,0,0,,hi ho jaata hai.
Dialogue: 0,0:02:22.30,0:02:25.33,Default,,0,0,0,,Gandharva vivah yaani aapsi sahmati ki
Dialogue: 0,0:02:25.33,0:02:25.80,Default,,0,0,0,,shaadi,
Dialogue: 0,0:02:25.80,0:02:26.73,Default,,0,0,0,,bina baraat.
Dialogue: 0,0:02:27.18,0:02:27.60,Default,,0,0,0,,Socho,
Dialogue: 0,0:02:27.60,0:02:29.50,Default,,0,0,0,,Ravan ne jis shaadi ko rokne
Dialogue: 0,0:02:29.50,0:02:30.34,Default,,0,0,0,,ke liye sab kiya,
Dialogue: 0,0:02:30.34,0:02:32.66,Default,,0,0,0,,wahi shaadi uske banaye dibbe mein
Dialogue: 0,0:02:32.66,0:02:32.88,Default,,0,0,0,,hui.
Dialogue: 0,0:02:32.88,0:02:35.41,Default,,0,0,0,,Kahani ka yahi palatvaar logon ko
Dialogue: 0,0:02:35.41,0:02:36.46,Default,,0,0,0,,pakad leta hai.
Dialogue: 0,0:02:36.91,0:02:38.35,Default,,0,0,0,,Kahani zabardast hai,
Dialogue: 0,0:02:38.35,0:02:39.59,Default,,0,0,0,,isme koi shak nahi.
Dialogue: 0,0:02:39.59,0:02:41.66,Default,,0,0,0,,Par asli sawaal ab shuru hota
Dialogue: 0,0:02:41.66,0:02:41.86,Default,,0,0,0,,hai.
Dialogue: 0,0:02:41.86,0:02:43.51,Default,,0,0,0,,Yeh Ananda Ramayan hai kya,
Dialogue: 0,0:02:43.51,0:02:45.37,Default,,0,0,0,,aur Valmiki ki Ramayan mein yeh
Dialogue: 0,0:02:45.37,0:02:45.99,Default,,0,0,0,,kyun nahi?
Dialogue: 0,0:02:46.44,0:02:48.29,Default,,0,0,0,,Ab chaliye us Ramayan ki taraf,
Dialogue: 0,0:02:48.29,0:02:50.15,Default,,0,0,0,,jo Valmiki ke naam se jaani
Dialogue: 0,0:02:50.15,0:02:50.77,Default,,0,0,0,,jaati hai.
Dialogue: 0,0:02:50.77,0:02:53.03,Default,,0,0,0,,Hum Bala Kanda aur Uttara Kanda
Dialogue: 0,0:02:53.03,0:02:53.65,Default,,0,0,0,,kholenge,
Dialogue: 0,0:02:53.65,0:02:55.92,Default,,0,0,0,,kyunki suraag inhi mein hona chahiye.
Dialogue: 0,0:02:56.37,0:02:58.10,Default,,0,0,0,,Bala Kanda yaani Ram ke janm
Dialogue: 0,0:02:58.10,0:02:59.45,Default,,0,0,0,,aur bachpan wala hissa.
Dialogue: 0,0:02:59.45,0:03:01.96,Default,,0,0,0,,Agar Kaushalya ka apaharan hua hota,
Dialogue: 0,0:03:01.96,0:03:04.08,Default,,0,0,0,,to sabse sahi jagah yahi hoti.
Dialogue: 0,0:03:04.08,0:03:06.97,Default,,0,0,0,,Apaharan yaani zabardasti utha le jaana.
Dialogue: 0,0:03:07.42,0:03:08.74,Default,,0,0,0,,Lekin scholars kehte hain,
Dialogue: 0,0:03:08.74,0:03:10.81,Default,,0,0,0,,Valmiki ki purani Ramayan mein yeh
Dialogue: 0,0:03:10.81,0:03:12.88,Default,,0,0,0,,dibbe wali katha milti hi nahi.
Dialogue: 0,0:03:12.88,0:03:14.01,Default,,0,0,0,,Na Ravan ka hamla,
Dialogue: 0,0:03:14.01,0:03:15.14,Default,,0,0,0,,na samundar ka dweep.
Dialogue: 0,0:03:15.59,0:03:17.81,Default,,0,0,0,,Bala Kanda mein Dasharath pehle se
Dialogue: 0,0:03:17.81,0:03:18.41,Default,,0,0,0,,raja hain,
Dialogue: 0,0:03:18.41,0:03:20.03,Default,,0,0,0,,aur Kaushalya unki rani.
Dialogue: 0,0:03:20.03,0:03:21.84,Default,,0,0,0,,Santan ke liye yagya hota hai,
Dialogue: 0,0:03:21.84,0:03:22.65,Default,,0,0,0,,phir Ram ka janm.
Dialogue: 0,0:03:22.65,0:03:25.07,Default,,0,0,0,,Beech mein koi samundari kidnapping nahi.
Dialogue: 0,0:03:25.52,0:03:27.02,Default,,0,0,0,,Ab Uttara Kanda.
Dialogue: 0,0:03:27.02,0:03:28.52,Default,,0,0,0,,Yeh aakhri hissa hai,
Dialogue: 0,0:03:28.52,0:03:31.26,Default,,0,0,0,,jahan Ravan ki apni kahani bhi
Dialogue: 0,0:03:31.26,0:03:32.01,Default,,0,0,0,,aati hai.
Dialogue: 0,0:03:32.01,0:03:32.76,Default,,0,0,0,,Uska janm,
Dialogue: 0,0:03:32.76,0:03:34.01,Default,,0,0,0,,uski tapasya,
Dialogue: 0,0:03:34.01,0:03:35.01,Default,,0,0,0,,uske vardaan.
Dialogue: 0,0:03:35.01,0:03:37.51,Default,,0,0,0,,Yahan to suraag milna hi chahiye
Dialogue: 0,0:03:37.51,0:03:37.76,Default,,0,0,0,,tha.
Dialogue: 0,0:03:38.21,0:03:40.71,Default,,0,0,0,,Lekin yahan bhi Kaushalya ke dibbe
Dialogue: 0,0:03:40.71,0:03:42.31,Default,,0,0,0,,ki katha nahi milti,
Dialogue: 0,0:03:42.31,0:03:44.12,Default,,0,0,0,,scholars aisa batate hain.
Dialogue: 0,0:03:44.12,0:03:45.94,Default,,0,0,0,,To yeh katha aayi kahan se?
Dialogue: 0,0:03:45.94,0:03:48.45,Default,,0,0,0,,Jawab Ananda Ramayan ki tareekh mein
Dialogue: 0,0:03:48.45,0:03:49.13,Default,,0,0,0,,chhupa hai.
Dialogue: 0,0:03:49.58,0:03:51.31,Default,,0,0,0,,Ram katha ke aur bhi roop
Dialogue: 0,0:03:51.31,0:03:51.55,Default,,0,0,0,,hain.
Dialogue: 0,0:03:51.55,0:03:53.03,Default,,0,0,0,,Adhyatma Ramayan hai,
Dialogue: 0,0:03:53.03,0:03:55.01,Default,,0,0,0,,Kamban ki Tamil Ramayan hai.
Dialogue: 0,0:03:55.01,0:03:57.97,Default,,0,0,0,,Hamare sabut yeh dibbe wala prasang
Dialogue: 0,0:03:57.97,0:04:00.19,Default,,0,0,0,,saaf taur par sirf Ananda Ramayan
Dialogue: 0,0:04:00.19,0:04:01.42,Default,,0,0,0,,mein dikhate hain.
Dialogue: 0,0:04:01.87,0:04:03.50,Default,,0,0,0,,To ab tak ki tasveer saaf
Dialogue: 0,0:04:03.50,0:04:03.73,Default,,0,0,0,,hai.
Dialogue: 0,0:04:03.73,0:04:06.29,Default,,0,0,0,,Viral katha ka asli ghar Ananda
Dialogue: 0,0:04:06.29,0:04:06.99,Default,,0,0,0,,Ramayan hai,
Dialogue: 0,0:04:06.99,0:04:08.16,Default,,0,0,0,,Valmiki nahi.
Dialogue: 0,0:04:08.16,0:04:10.25,Default,,0,0,0,,Par Ananda Ramayan ko bhi to
Dialogue: 0,0:04:10.25,0:04:12.35,Default,,0,0,0,,log Valmiki ki hi maante hain?
Dialogue: 0,0:04:12.80,0:04:14.33,Default,,0,0,0,,Ab sabse bada sawaal.
Dialogue: 0,0:04:14.33,0:04:16.30,Default,,0,0,0,,Ananda Ramayan likhi kisne,
Dialogue: 0,0:04:16.30,0:04:16.73,Default,,0,0,0,,aur kab?
Dialogue: 0,0:04:16.73,0:04:20.01,Default,,0,0,0,,Yahan parampara aur itihaaskar alag alag
Dialogue: 0,0:04:20.01,0:04:21.10,Default,,0,0,0,,jawab dete hain.
Dialogue: 0,0:04:21.10,0:04:24.16,Default,,0,0,0,,Parampara yaani pidhiyon se chali maanyata.
Dialogue: 0,0:04:24.61,0:04:25.88,Default,,0,0,0,,Parampara kehti hai,
Dialogue: 0,0:04:25.88,0:04:28.05,Default,,0,0,0,,Ananda Ramayan bhi rishi Valmiki ki
Dialogue: 0,0:04:28.05,0:04:28.78,Default,,0,0,0,,hi rachna hai.
Dialogue: 0,0:04:28.78,0:04:30.59,Default,,0,0,0,,Isiliye kai bhakt ise utna hi
Dialogue: 0,0:04:30.59,0:04:31.68,Default,,0,0,0,,pavitra maante hain,
Dialogue: 0,0:04:31.68,0:04:33.13,Default,,0,0,0,,jitna Valmiki Ramayan ko.
Dialogue: 0,0:04:33.58,0:04:35.59,Default,,0,0,0,,Ab itihaaskaron ki taraf.
Dialogue: 0,0:04:35.59,0:04:37.82,Default,,0,0,0,,Text ke itihaaskar yaani woh log,
Dialogue: 0,0:04:37.82,0:04:39.61,Default,,0,0,0,,jo granth ki bhasha aur shaili
Dialogue: 0,0:04:39.61,0:04:41.39,Default,,0,0,0,,se uski umar naapte hain.
Dialogue: 0,0:04:41.39,0:04:43.18,Default,,0,0,0,,Unki raay bilkul alag hai.
Dialogue: 0,0:04:43.63,0:04:46.01,Default,,0,0,0,,Zyaadatar modern scholars kehte hain,
Dialogue: 0,0:04:46.01,0:04:48.64,Default,,0,0,0,,Ananda Ramayan 15th century CE mein
Dialogue: 0,0:04:48.64,0:04:49.35,Default,,0,0,0,,likhi gayi,
Dialogue: 0,0:04:49.35,0:04:51.74,Default,,0,0,0,,yaani 1500 tak ke daur mein.
Dialogue: 0,0:04:51.74,0:04:53.40,Default,,0,0,0,,Yeh madhyakaal ka granth hai,
Dialogue: 0,0:04:53.40,0:04:55.55,Default,,0,0,0,,madhyakaal yaani medieval daur.
Dialogue: 0,0:04:56.00,0:04:56.83,Default,,0,0,0,,Matlab saaf hai.
Dialogue: 0,0:04:56.83,0:04:58.91,Default,,0,0,0,,Scholars ke hisaab se yeh Valmiki
Dialogue: 0,0:04:58.91,0:05:00.78,Default,,0,0,0,,ki original rachna nahi,
Dialogue: 0,0:05:00.78,0:05:02.65,Default,,0,0,0,,balki baad mein likhi gayi kriti
Dialogue: 0,0:05:02.65,0:05:02.86,Default,,0,0,0,,hai.
Dialogue: 0,0:05:02.86,0:05:05.35,Default,,0,0,0,,Aur wahi dibbe wali katha sunati
Dialogue: 0,0:05:05.35,0:05:05.56,Default,,0,0,0,,hai.
Dialogue: 0,0:05:06.01,0:05:07.55,Default,,0,0,0,,Phir yeh granth likha kyun gaya?
Dialogue: 0,0:05:07.55,0:05:08.65,Default,,0,0,0,,Scholars kehte hain,
Dialogue: 0,0:05:08.65,0:05:10.64,Default,,0,0,0,,iski khaas baat nayi kahaniyan hain.
Dialogue: 0,0:05:10.64,0:05:13.29,Default,,0,0,0,,Aisi kahaniyan jo Valmiki Ramayan ki
Dialogue: 0,0:05:13.29,0:05:15.71,Default,,0,0,0,,kahani ko peeche ka background deti
Dialogue: 0,0:05:15.71,0:05:15.93,Default,,0,0,0,,hain.
Dialogue: 0,0:05:16.38,0:05:18.27,Default,,0,0,0,,Jaise film ka prequel hota hai.
Dialogue: 0,0:05:18.27,0:05:20.36,Default,,0,0,0,,Main kahani pehle se pata hai,
Dialogue: 0,0:05:20.36,0:05:22.67,Default,,0,0,0,,prequel batata hai ki usse pehle
Dialogue: 0,0:05:22.67,0:05:23.09,Default,,0,0,0,,kya hua.
Dialogue: 0,0:05:23.09,0:05:25.39,Default,,0,0,0,,Kaushalya ka dibba waisa hi prequel
Dialogue: 0,0:05:25.39,0:05:26.02,Default,,0,0,0,,lagta hai.
Dialogue: 0,0:05:26.47,0:05:28.53,Default,,0,0,0,,Lekin bhakton ka sawaal bhi waajib
Dialogue: 0,0:05:28.53,0:05:28.74,Default,,0,0,0,,hai.
Dialogue: 0,0:05:28.74,0:05:30.59,Default,,0,0,0,,Kya yeh kahaniyan bilkul nayi thi,
Dialogue: 0,0:05:30.59,0:05:32.44,Default,,0,0,0,,ya pehle se logon ki zubaan
Dialogue: 0,0:05:32.44,0:05:33.47,Default,,0,0,0,,par chal rahi thi,
Dialogue: 0,0:05:33.47,0:05:34.71,Default,,0,0,0,,aur baad mein likhi gayi?
Dialogue: 0,0:05:35.16,0:05:36.78,Default,,0,0,0,,Yahi asli bahas hai.
Dialogue: 0,0:05:36.78,0:05:37.70,Default,,0,0,0,,Kuch kehte hain,
Dialogue: 0,0:05:37.70,0:05:40.24,Default,,0,0,0,,yeh purani maukhik parampara hai,
Dialogue: 0,0:05:40.24,0:05:41.86,Default,,0,0,0,,maukhik yaani zubaani,
Dialogue: 0,0:05:41.86,0:05:43.01,Default,,0,0,0,,jo sirf sunai gayi.
Dialogue: 0,0:05:43.01,0:05:44.17,Default,,0,0,0,,Baaki kehte hain,
Dialogue: 0,0:05:44.17,0:05:46.48,Default,,0,0,0,,yeh baad ki rachnatmak kalpana hai.
Dialogue: 0,0:05:46.93,0:05:47.86,Default,,0,0,0,,Kaun sahi hai,
Dialogue: 0,0:05:47.86,0:05:50.18,Default,,0,0,0,,yeh tay karna hamara kaam nahi.
Dialogue: 0,0:05:50.18,0:05:51.80,Default,,0,0,0,,Hum sirf sabut rakhte hain.
Dialogue: 0,0:05:51.80,0:05:53.88,Default,,0,0,0,,Par is katha ki banawat mein,
Dialogue: 0,0:05:53.88,0:05:55.97,Default,,0,0,0,,aur bhi bada suraag chhupa hai.
Dialogue: 0,0:05:56.42,0:05:57.72,Default,,0,0,0,,Ab zara dhyaan se suniye.
Dialogue: 0,0:05:57.72,0:05:59.75,Default,,0,0,0,,Raja ko bhavishyavani milti hai,
Dialogue: 0,0:05:59.75,0:06:01.61,Default,,0,0,0,,ki aane wala bachcha uski maut
Dialogue: 0,0:06:01.61,0:06:02.16,Default,,0,0,0,,banega.
Dialogue: 0,0:06:02.16,0:06:04.20,Default,,0,0,0,,Kya yeh kahani aapne pehle kahin
Dialogue: 0,0:06:04.20,0:06:04.94,Default,,0,0,0,,aur suni hai?
Dialogue: 0,0:06:05.39,0:06:05.58,Default,,0,0,0,,Haan,
Dialogue: 0,0:06:05.58,0:06:07.09,Default,,0,0,0,,Bhagavata Purana mein.
Dialogue: 0,0:06:07.09,0:06:08.97,Default,,0,0,0,,Wahan Kamsa ko pata chalta hai,
Dialogue: 0,0:06:08.97,0:06:10.86,Default,,0,0,0,,ki Devaki ka beta uska ant
Dialogue: 0,0:06:10.86,0:06:11.42,Default,,0,0,0,,karega.
Dialogue: 0,0:06:11.42,0:06:13.12,Default,,0,0,0,,Aur Kamsa Devaki ko qaid mein
Dialogue: 0,0:06:13.12,0:06:13.87,Default,,0,0,0,,daal deta hai.
Dialogue: 0,0:06:14.32,0:06:16.47,Default,,0,0,0,,Ab kahaniyan aamne saamne rakhiye.
Dialogue: 0,0:06:16.47,0:06:17.55,Default,,0,0,0,,Darra hua raja,
Dialogue: 0,0:06:17.55,0:06:18.62,Default,,0,0,0,,bhavishyavani,
Dialogue: 0,0:06:18.62,0:06:20.35,Default,,0,0,0,,aur hone wali maa ki qaid.
Dialogue: 0,0:06:20.35,0:06:22.28,Default,,0,0,0,,Dhaancha bilkul milta julta hai,
Dialogue: 0,0:06:22.28,0:06:23.36,Default,,0,0,0,,sirf naam badle hain.
Dialogue: 0,0:06:23.81,0:06:26.14,Default,,0,0,0,,Folklorists yaani lok kathaon ke jaankaar,
Dialogue: 0,0:06:26.14,0:06:27.62,Default,,0,0,0,,ise motif kehte hain.
Dialogue: 0,0:06:27.62,0:06:30.16,Default,,0,0,0,,Motif yaani kahani ka aisa saancha,
Dialogue: 0,0:06:30.16,0:06:32.06,Default,,0,0,0,,jo katha se katha mein safar
Dialogue: 0,0:06:32.06,0:06:32.70,Default,,0,0,0,,karta hai,
Dialogue: 0,0:06:32.70,0:06:33.97,Default,,0,0,0,,jaise gaane ki dhun.
Dialogue: 0,0:06:34.42,0:06:35.25,Default,,0,0,0,,Unki raay hai,
Dialogue: 0,0:06:35.25,0:06:37.73,Default,,0,0,0,,Kaushalya ke apaharan wala saancha,
Dialogue: 0,0:06:37.73,0:06:40.00,Default,,0,0,0,,Kamsa aur Devaki ki kahani se
Dialogue: 0,0:06:40.00,0:06:41.25,Default,,0,0,0,,prerit ho sakta hai.
Dialogue: 0,0:06:41.25,0:06:44.14,Default,,0,0,0,,Prerit yaani usse inspiration lekar bana.
Dialogue: 0,0:06:44.59,0:06:46.18,Default,,0,0,0,,Lekin yeh bhi samajhiye,
Dialogue: 0,0:06:46.18,0:06:48.68,Default,,0,0,0,,kahaniyon ka aise milna koi apmaan
Dialogue: 0,0:06:48.68,0:06:49.13,Default,,0,0,0,,nahi.
Dialogue: 0,0:06:49.13,0:06:51.63,Default,,0,0,0,,Bharat mein kathayen hamesha aapas mein
Dialogue: 0,0:06:51.63,0:06:52.76,Default,,0,0,0,,baat karti aayi hain,
Dialogue: 0,0:06:52.76,0:06:53.67,Default,,0,0,0,,gaon se gaon tak.
Dialogue: 0,0:06:54.12,0:06:56.51,Default,,0,0,0,,Dadi naani bhi kahani sunate waqt,
Dialogue: 0,0:06:56.51,0:06:58.30,Default,,0,0,0,,purani katha mein naya rang bhar
Dialogue: 0,0:06:58.30,0:06:58.89,Default,,0,0,0,,deti thi.
Dialogue: 0,0:06:58.89,0:07:00.69,Default,,0,0,0,,Shayad granthon ke likhne walon ne
Dialogue: 0,0:07:00.69,0:07:01.88,Default,,0,0,0,,bhi kuch aisa hi kiya.
Dialogue: 0,0:07:02.33,0:07:04.14,Default,,0,0,0,,Par granth to kaagaz ki baat
Dialogue: 0,0:07:04.14,0:07:04.39,Default,,0,0,0,,hai.
Dialogue: 0,0:07:04.39,0:07:06.97,Default,,0,0,0,,Asli sawaal ab shuru hota hai.
Dialogue: 0,0:07:06.97,0:07:09.04,Default,,0,0,0,,Kya zameen ke neeche se bhi,
Dialogue: 0,0:07:09.04,0:07:11.88,Default,,0,0,0,,Kaushalya ke Kosala ka koi sabut
Dialogue: 0,0:07:11.88,0:07:12.65,Default,,0,0,0,,milta hai?
Dialogue: 0,0:07:13.10,0:07:13.85,Default,,0,0,0,,Ab granth band,
Dialogue: 0,0:07:13.85,0:07:15.08,Default,,0,0,0,,aur kudaal haath mein.
Dialogue: 0,0:07:15.08,0:07:17.32,Default,,0,0,0,,Kudaal yaani khudai ka auzaar.
Dialogue: 0,0:07:17.32,0:07:20.55,Default,,0,0,0,,Archaeology yaani zameen khod kar purane
Dialogue: 0,0:07:20.55,0:07:23.03,Default,,0,0,0,,logon ke nishaan dhoondhne ka vigyan.
Dialogue: 0,0:07:23.03,0:07:24.02,Default,,0,0,0,,Chaliye Ayodhya.
Dialogue: 0,0:07:24.47,0:07:26.34,Default,,0,0,0,,1975 ke season mein,
Dialogue: 0,0:07:26.34,0:07:29.15,Default,,0,0,0,,Archaeology of Ramayana Sites naam ka
Dialogue: 0,0:07:29.15,0:07:30.79,Default,,0,0,0,,project Ayodhya pahuncha.
Dialogue: 0,0:07:30.79,0:07:31.96,Default,,0,0,0,,Maqsad seedha tha.
Dialogue: 0,0:07:31.96,0:07:34.30,Default,,0,0,0,,Ramayan se jude sthanon ki mitti
Dialogue: 0,0:07:34.30,0:07:35.47,Default,,0,0,0,,mein kya chhupa hai?
Dialogue: 0,0:07:35.92,0:07:37.64,Default,,0,0,0,,Yeh kaam ASI ke project ke
Dialogue: 0,0:07:37.64,0:07:38.29,Default,,0,0,0,,tahat hua.
Dialogue: 0,0:07:38.29,0:07:41.30,Default,,0,0,0,,ASI yaani Archaeological Survey of India,
Dialogue: 0,0:07:41.30,0:07:43.03,Default,,0,0,0,,desh ki puraatattva sanstha.
Dialogue: 0,0:07:43.03,0:07:45.39,Default,,0,0,0,,Unhone zameen ki parat dar parat
Dialogue: 0,0:07:45.39,0:07:46.04,Default,,0,0,0,,khudai ki.
Dialogue: 0,0:07:46.49,0:07:47.50,Default,,0,0,0,,Parat yaani layer.
Dialogue: 0,0:07:47.50,0:07:49.50,Default,,0,0,0,,Jaise cake ki tahein hoti hain,
Dialogue: 0,0:07:49.50,0:07:51.31,Default,,0,0,0,,neeche wali sabse purani.
Dialogue: 0,0:07:51.31,0:07:53.12,Default,,0,0,0,,Zameen bhi waise hi sadiyon ki
Dialogue: 0,0:07:53.12,0:07:54.53,Default,,0,0,0,,tahein jod kar banti hai.
Dialogue: 0,0:07:54.98,0:07:56.76,Default,,0,0,0,,Aur sabse neeche kya mila?
Dialogue: 0,0:07:56.76,0:07:59.21,Default,,0,0,0,,Lagaataar insaani basti ke nishaan,
Dialogue: 0,0:07:59.21,0:08:01.22,Default,,0,0,0,,jo 7th century BCE tak jaate
Dialogue: 0,0:08:01.22,0:08:01.44,Default,,0,0,0,,hain.
Dialogue: 0,0:08:01.44,0:08:03.44,Default,,0,0,0,,BCE yaani Isa Masih ke janm
Dialogue: 0,0:08:03.44,0:08:04.78,Default,,0,0,0,,se pehle ka samay.
Dialogue: 0,0:08:05.23,0:08:07.61,Default,,0,0,0,,Basti yaani log yahan rehte the,
Dialogue: 0,0:08:07.61,0:08:08.80,Default,,0,0,0,,ghar banate the,
Dialogue: 0,0:08:08.80,0:08:10.70,Default,,0,0,0,,roz ki zindagi jeete the.
Dialogue: 0,0:08:10.70,0:08:13.08,Default,,0,0,0,,Mitti ki tahein unke rehne ki
Dialogue: 0,0:08:13.08,0:08:14.51,Default,,0,0,0,,gawahi deti hain.
Dialogue: 0,0:08:14.96,0:08:15.98,Default,,0,0,0,,Lekin dhyaan dijiye.
Dialogue: 0,0:08:15.98,0:08:18.42,Default,,0,0,0,,Khudai batati hai ki purani basti
Dialogue: 0,0:08:18.42,0:08:18.62,Default,,0,0,0,,thi.
Dialogue: 0,0:08:18.62,0:08:20.86,Default,,0,0,0,,Woh yeh nahi batati ki Kaushalya
Dialogue: 0,0:08:20.86,0:08:22.28,Default,,0,0,0,,kisi dibbe mein band thi.
Dialogue: 0,0:08:22.28,0:08:24.52,Default,,0,0,0,,Mitti katha ko sabit nahi karti.
Dialogue: 0,0:08:24.97,0:08:26.97,Default,,0,0,0,,Aur na hi woh use jhuthlati
Dialogue: 0,0:08:26.97,0:08:27.20,Default,,0,0,0,,hai.
Dialogue: 0,0:08:27.20,0:08:29.64,Default,,0,0,0,,Katha aur khudai alag sawaalon ke
Dialogue: 0,0:08:29.64,0:08:30.76,Default,,0,0,0,,jawab dete hain.
Dialogue: 0,0:08:30.76,0:08:33.21,Default,,0,0,0,,Par Kosala ki kahani sirf Ayodhya
Dialogue: 0,0:08:33.21,0:08:34.32,Default,,0,0,0,,tak simit nahi.
Dialogue: 0,0:08:34.32,0:08:35.21,Default,,0,0,0,,Aage chaliye.
Dialogue: 0,0:08:35.66,0:08:36.50,Default,,0,0,0,,Ab Shravasti,
Dialogue: 0,0:08:36.50,0:08:38.61,Default,,0,0,0,,Kosala ki purani rajdhani.
Dialogue: 0,0:08:38.61,0:08:41.14,Default,,0,0,0,,Ramayan mein Kosala ke raja Dasharath
Dialogue: 0,0:08:41.14,0:08:41.36,Default,,0,0,0,,hain.
Dialogue: 0,0:08:41.36,0:08:43.47,Default,,0,0,0,,Kosala yaani Ayodhya ke aas paas
Dialogue: 0,0:08:43.47,0:08:44.52,Default,,0,0,0,,ka bada rajya,
Dialogue: 0,0:08:44.52,0:08:46.21,Default,,0,0,0,,jo aaj ke Uttar Pradesh mein
Dialogue: 0,0:08:46.21,0:08:46.42,Default,,0,0,0,,tha.
Dialogue: 0,0:08:46.87,0:08:49.25,Default,,0,0,0,,Yahan ASI ki khudai mein kilebandi
Dialogue: 0,0:08:49.25,0:08:49.64,Default,,0,0,0,,mili.
Dialogue: 0,0:08:49.64,0:08:52.42,Default,,0,0,0,,Kilebandi yaani shahar ko bachane wali
Dialogue: 0,0:08:52.42,0:08:53.41,Default,,0,0,0,,deewar aur ghera.
Dialogue: 0,0:08:53.41,0:08:55.20,Default,,0,0,0,,Saath mein shahri basti ki tahein
Dialogue: 0,0:08:55.20,0:08:55.79,Default,,0,0,0,,bhi mili.
Dialogue: 0,0:08:56.24,0:08:58.27,Default,,0,0,0,,Yeh tahein 6th century BCE se
Dialogue: 0,0:08:58.27,0:08:59.40,Default,,0,0,0,,shuru hoti hain.
Dialogue: 0,0:08:59.40,0:09:02.11,Default,,0,0,0,,Yaani Kosala mein shahar ki zindagi,
Dialogue: 0,0:09:02.11,0:09:04.14,Default,,0,0,0,,Isa se kai sadiyan pehle phal
Dialogue: 0,0:09:04.14,0:09:05.04,Default,,0,0,0,,phool rahi thi.
Dialogue: 0,0:09:05.49,0:09:07.11,Default,,0,0,0,,To mitti kya kehti hai?
Dialogue: 0,0:09:07.11,0:09:09.42,Default,,0,0,0,,Kosala mein purane shahar the,
Dialogue: 0,0:09:09.42,0:09:09.88,Default,,0,0,0,,log the,
Dialogue: 0,0:09:09.88,0:09:10.81,Default,,0,0,0,,deewarein thi.
Dialogue: 0,0:09:10.81,0:09:13.12,Default,,0,0,0,,Lekin samundar ke dweep par rakha
Dialogue: 0,0:09:13.12,0:09:13.59,Default,,0,0,0,,dibba,
Dialogue: 0,0:09:13.59,0:09:16.13,Default,,0,0,0,,iska koi khudai wala sabut nahi.
Dialogue: 0,0:09:16.58,0:09:17.50,Default,,0,0,0,,Aur sach kahein,
Dialogue: 0,0:09:17.50,0:09:19.81,Default,,0,0,0,,kisi katha ke liye aisa sabut
Dialogue: 0,0:09:19.81,0:09:21.19,Default,,0,0,0,,milna mushkil hi hai.
Dialogue: 0,0:09:21.19,0:09:23.50,Default,,0,0,0,,Lakdi ka dibba lehron mein sadiyon
Dialogue: 0,0:09:23.50,0:09:24.65,Default,,0,0,0,,tak kaise bachta?
Dialogue: 0,0:09:24.65,0:09:26.50,Default,,0,0,0,,Par sawaal abhi baaki hai.
Dialogue: 0,0:09:26.95,0:09:28.89,Default,,0,0,0,,Ab woh hissa jo koi viral
Dialogue: 0,0:09:28.89,0:09:30.34,Default,,0,0,0,,clip nahi batata.
Dialogue: 0,0:09:30.34,0:09:32.52,Default,,0,0,0,,Kya abhi tak pata hi nahi
Dialogue: 0,0:09:32.52,0:09:33.00,Default,,0,0,0,,chala?
Dialogue: 0,0:09:33.00,0:09:33.73,Default,,0,0,0,,Jawab hai,
Dialogue: 0,0:09:33.73,0:09:34.45,Default,,0,0,0,,kaafi kuch.
Dialogue: 0,0:09:34.45,0:09:36.39,Default,,0,0,0,,Aur yahi sabse dilchasp hai.
Dialogue: 0,0:09:36.84,0:09:38.61,Default,,0,0,0,,Sabse bada raaz yeh hai.
Dialogue: 0,0:09:38.61,0:09:41.13,Default,,0,0,0,,Sanskrit mein likhe jaane se pehle,
Dialogue: 0,0:09:41.13,0:09:43.91,Default,,0,0,0,,yeh dibbe wali katha kahan janmi?
Dialogue: 0,0:09:43.91,0:09:45.17,Default,,0,0,0,,Kis ilaake mein,
Dialogue: 0,0:09:45.17,0:09:46.18,Default,,0,0,0,,kis bhasha mein,
Dialogue: 0,0:09:46.18,0:09:47.44,Default,,0,0,0,,kiski zubaan par?
Dialogue: 0,0:09:47.89,0:09:49.85,Default,,0,0,0,,Ho sakta hai yeh kisi kshetriya
Dialogue: 0,0:09:49.85,0:09:51.81,Default,,0,0,0,,bhasha ki lok katha rahi ho.
Dialogue: 0,0:09:51.81,0:09:54.42,Default,,0,0,0,,Kshetriya yaani kisi ilaake ki apni
Dialogue: 0,0:09:54.42,0:09:54.86,Default,,0,0,0,,bhasha.
Dialogue: 0,0:09:54.86,0:09:55.51,Default,,0,0,0,,Par kaunsi,
Dialogue: 0,0:09:55.51,0:09:57.25,Default,,0,0,0,,yeh abhi koi nahi jaanta.
Dialogue: 0,0:09:57.70,0:09:58.42,Default,,0,0,0,,Agla raaz,
Dialogue: 0,0:09:58.42,0:10:01.07,Default,,0,0,0,,Ananda Ramayan ka asli lekhak kaun?
Dialogue: 0,0:10:01.07,0:10:03.48,Default,,0,0,0,,Parampara Valmiki kehti hai,
Dialogue: 0,0:10:03.48,0:10:05.65,Default,,0,0,0,,scholars baad ke kisi lekhak ki
Dialogue: 0,0:10:05.65,0:10:06.61,Default,,0,0,0,,baat karte hain.
Dialogue: 0,0:10:06.61,0:10:09.02,Default,,0,0,0,,Pakki pehchaan abhi tak dhundhli hai.
Dialogue: 0,0:10:09.47,0:10:11.32,Default,,0,0,0,,Aakhri sawaal sabse gehra hai.
Dialogue: 0,0:10:11.32,0:10:14.00,Default,,0,0,0,,Kya yeh kahani kisi purani zubaani
Dialogue: 0,0:10:14.00,0:10:16.06,Default,,0,0,0,,parampara ki bachi hui goonj hai?
Dialogue: 0,0:10:16.06,0:10:17.91,Default,,0,0,0,,Ya kavi ki apni kalpana?
Dialogue: 0,0:10:17.91,0:10:19.35,Default,,0,0,0,,Bahas abhi khuli hai.
Dialogue: 0,0:10:19.80,0:10:21.65,Default,,0,0,0,,To ab aapke paas poori tasveer
Dialogue: 0,0:10:21.65,0:10:21.86,Default,,0,0,0,,hai.
Dialogue: 0,0:10:21.86,0:10:23.71,Default,,0,0,0,,Katha Ananda Ramayan mein hai.
Dialogue: 0,0:10:23.71,0:10:25.36,Default,,0,0,0,,Valmiki mein nahi milti.
Dialogue: 0,0:10:25.36,0:10:27.22,Default,,0,0,0,,Aur uski jad abhi bhi dhoondhi
Dialogue: 0,0:10:27.22,0:10:28.04,Default,,0,0,0,,ja rahi hai.
Dialogue: 0,0:10:28.49,0:10:30.62,Default,,0,0,0,,Agar aap yeh duniya khud dekhna
Dialogue: 0,0:10:30.62,0:10:31.32,Default,,0,0,0,,chahte hain,
Dialogue: 0,0:10:31.32,0:10:32.27,Default,,0,0,0,,to Ayodhya jaiye.
Dialogue: 0,0:10:32.27,0:10:33.92,Default,,0,0,0,,Saryu ke ghaat par shaam ki
Dialogue: 0,0:10:33.92,0:10:34.87,Default,,0,0,0,,aarti dekhiye.
Dialogue: 0,0:10:34.87,0:10:37.23,Default,,0,0,0,,Wahi nadi jiska zikr Ramayan baar
Dialogue: 0,0:10:37.23,0:10:38.17,Default,,0,0,0,,baar karti hai.
Dialogue: 0,0:10:38.62,0:10:39.68,Default,,0,0,0,,Phir Shravasti jaiye.
Dialogue: 0,0:10:39.68,0:10:42.02,Default,,0,0,0,,Wahan khule mein purane teele aur
Dialogue: 0,0:10:42.02,0:10:43.30,Default,,0,0,0,,khandahar dikhte hain.
Dialogue: 0,0:10:43.30,0:10:45.22,Default,,0,0,0,,Teela yaani mitti ka ubhaar,
Dialogue: 0,0:10:45.22,0:10:47.98,Default,,0,0,0,,jiske neeche sadiyon purani basti dabi
Dialogue: 0,0:10:47.98,0:10:48.62,Default,,0,0,0,,hoti hai.
Dialogue: 0,0:10:49.07,0:10:50.19,Default,,0,0,0,,Aur granth padhna ho,
Dialogue: 0,0:10:50.19,0:10:52.67,Default,,0,0,0,,to Valmiki Ramayan ka Bala Kanda
Dialogue: 0,0:10:52.67,0:10:55.14,Default,,0,0,0,,aur Ananda Ramayan ka Sara Kanda,
Dialogue: 0,0:10:55.14,0:10:56.94,Default,,0,0,0,,aamne saamne rakh kar padhiye.
Dialogue: 0,0:10:56.94,0:10:58.51,Default,,0,0,0,,Fark aap khud pakad lenge.
Dialogue: 0,0:10:58.96,0:11:00.46,Default,,0,0,0,,Aur ghar mein dadi naani se
Dialogue: 0,0:11:00.46,0:11:00.84,Default,,0,0,0,,poochhiye.
Dialogue: 0,0:11:00.84,0:11:03.09,Default,,0,0,0,,Unhone yeh dibbe wali katha kahan
Dialogue: 0,0:11:03.09,0:11:03.65,Default,,0,0,0,,suni thi?
Dialogue: 0,0:11:03.65,0:11:04.21,Default,,0,0,0,,Kya pata,
Dialogue: 0,0:11:04.21,0:11:06.09,Default,,0,0,0,,unki yaad mein koi purana kshetriya
Dialogue: 0,0:11:06.09,0:11:06.84,Default,,0,0,0,,roop chhupa ho.
Dialogue: 0,0:11:07.29,0:11:08.50,Default,,0,0,0,,To wapas wahin,
Dialogue: 0,0:11:08.50,0:11:10.20,Default,,0,0,0,,jahan se shuru kiya tha.
Dialogue: 0,0:11:10.20,0:11:11.90,Default,,0,0,0,,Kya Ravan ne Ram ki maa
Dialogue: 0,0:11:11.90,0:11:13.60,Default,,0,0,0,,ko samundar mein qaid kiya?
Dialogue: 0,0:11:13.60,0:11:15.79,Default,,0,0,0,,Ananda Ramayan haan kehti hai.
Dialogue: 0,0:11:15.79,0:11:17.49,Default,,0,0,0,,Valmiki is par chup hai.
Dialogue: 0,0:11:17.94,0:11:20.38,Default,,0,0,0,,Scholars ise 15th century ki rachna
Dialogue: 0,0:11:20.38,0:11:21.04,Default,,0,0,0,,maante hain,
Dialogue: 0,0:11:21.04,0:11:23.03,Default,,0,0,0,,Kamsa ki kahani ki goonj ke
Dialogue: 0,0:11:23.03,0:11:23.25,Default,,0,0,0,,saath.
Dialogue: 0,0:11:23.25,0:11:26.13,Default,,0,0,0,,Parampara ise Valmiki ki den maanti
Dialogue: 0,0:11:26.13,0:11:26.35,Default,,0,0,0,,hai.
Dialogue: 0,0:11:26.35,0:11:27.90,Default,,0,0,0,,Faisla aapki samajh par.
Dialogue: 0,0:11:28.35,0:11:30.39,Default,,0,0,0,,Agla safar samundar ka.
Dialogue: 0,0:11:30.39,0:11:31.15,Default,,0,0,0,,Ram Setu,
Dialogue: 0,0:11:31.15,0:11:34.22,Default,,0,0,0,,jiska ISRO ke satellite naksha ne
Dialogue: 0,0:11:34.22,0:11:35.49,Default,,0,0,0,,29 km lamba,
Dialogue: 0,0:11:35.49,0:11:38.80,Default,,0,0,0,,paani ke neeche chattani silsila dikhaya.
Dialogue: 0,0:11:38.80,0:11:40.59,Default,,0,0,0,,Lekin woh bana kaise?
Dialogue: 0,0:11:41.04,0:11:43.80,Default,,0,0,0,,Geological Survey of India ise lehron
Dialogue: 0,0:11:43.80,0:11:46.34,Default,,0,0,0,,se bani kudrati banawat maanta hai.
Dialogue: 0,0:11:46.34,0:11:48.25,Default,,0,0,0,,Kuch log ise insaani haath ka
Dialogue: 0,0:11:48.25,0:11:49.10,Default,,0,0,0,,kaam kehte hain.
Dialogue: 0,0:11:49.10,0:11:49.74,Default,,0,0,0,,Sach kya hai?
Dialogue: 0,0:11:49.74,0:11:50.80,Default,,0,0,0,,Agle video mein.
Dialogue: 0,0:11:51.25,0:11:52.40,Default,,0,0,0,,Aur ab aapse sawaal.
Dialogue: 0,0:11:52.40,0:11:54.51,Default,,0,0,0,,Aapne yeh dibbe wali katha sabse
Dialogue: 0,0:11:54.51,0:11:55.86,Default,,0,0,0,,pehle kahan suni thi,
Dialogue: 0,0:11:55.86,0:11:57.59,Default,,0,0,0,,dadi naani se ya phone par?
Dialogue: 0,0:11:57.59,0:11:58.93,Default,,0,0,0,,Comments mein zaroor batayiye.
