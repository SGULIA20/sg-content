Dialogue: 0,0:00:00.00,0:00:02.86,Default,,0,0,0,,RBI kal banks ko 50,000 crore
Dialogue: 0,0:00:02.86,0:00:03.67,Default,,0,0,0,,dega,
Dialogue: 0,0:00:03.67,0:00:05.71,Default,,0,0,0,,sirf 1 din ke liye.
Dialogue: 0,0:00:05.71,0:00:06.12,Default,,0,0,0,,Kyun?
Dialogue: 0,0:00:06.57,0:00:09.30,Default,,0,0,0,,Wednesday ko RBI ek Variable Rate
Dialogue: 0,0:00:09.30,0:00:11.04,Default,,0,0,0,,Repo auction karega.
Dialogue: 0,0:00:11.04,0:00:13.77,Default,,0,0,0,,Notified amount hai 50,000 crore rupaye.
Dialogue: 0,0:00:14.22,0:00:15.89,Default,,0,0,0,,Tenor sirf 1 din ka hai.
Dialogue: 0,0:00:15.89,0:00:18.03,Default,,0,0,0,,Thursday ko yeh paisa wapas RBI
Dialogue: 0,0:00:18.03,0:00:18.98,Default,,0,0,0,,ke paas jayega.
Dialogue: 0,0:00:19.43,0:00:21.18,Default,,0,0,0,,Kabhi kabhi banks ke paas roz
Dialogue: 0,0:00:21.18,0:00:22.71,Default,,0,0,0,,ka cash tight ho jata hai.
Dialogue: 0,0:00:22.71,0:00:24.90,Default,,0,0,0,,Tab overnight udhaar ki dar upar
Dialogue: 0,0:00:24.90,0:00:25.99,Default,,0,0,0,,bhaagne lagti hai.
Dialogue: 0,0:00:26.44,0:00:28.63,Default,,0,0,0,,RBI auction se thoda cash system
Dialogue: 0,0:00:28.63,0:00:29.60,Default,,0,0,0,,mein daalta hai,
Dialogue: 0,0:00:29.60,0:00:31.30,Default,,0,0,0,,taaki rates shant rahein.
Dialogue: 0,0:00:31.30,0:00:34.22,Default,,0,0,0,,Yeh liquidity ka chhota injection hai,
Dialogue: 0,0:00:34.22,0:00:35.44,Default,,0,0,0,,rate cut nahi.
Dialogue: 0,0:00:35.89,0:00:38.37,Default,,0,0,0,,Par loan ki dar pehle hi
Dialogue: 0,0:00:38.37,0:00:39.79,Default,,0,0,0,,badh chuki hai.
Dialogue: 0,0:00:39.79,0:00:42.63,Default,,0,0,0,,SBI ne apna EBLR 8.15 percent
Dialogue: 0,0:00:42.63,0:00:43.69,Default,,0,0,0,,kar diya hai.
Dialogue: 0,0:00:44.14,0:00:45.63,Default,,0,0,0,,Aapke liye matlab?
Dialogue: 0,0:00:45.63,0:00:47.41,Default,,0,0,0,,SBI ka RLLR bhi ab 7.75
Dialogue: 0,0:00:47.41,0:00:48.30,Default,,0,0,0,,percent hai.
Dialogue: 0,0:00:48.30,0:00:50.98,Default,,0,0,0,,Home loan repo se juda hai,
Dialogue: 0,0:00:50.98,0:00:53.36,Default,,0,0,0,,to agli EMI check kariye.
Dialogue: 0,0:00:53.36,0:00:56.33,Default,,0,0,0,,Yeh auction aapki EMI turant kam
Dialogue: 0,0:00:56.33,0:00:57.82,Default,,0,0,0,,nahi karega.
Dialogue: 0,0:00:58.27,0:01:00.48,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:00.48,0:01:02.26,Default,,0,0,0,,Loan ya FD ka faisla apne
Dialogue: 0,0:01:02.26,0:01:04.03,Default,,0,0,0,,advisor se pooch kar lijiye.
Dialogue: 0,0:01:04.48,0:01:06.98,Default,,0,0,0,,Kya is saal aapki EMI badhi
Dialogue: 0,0:01:06.98,0:01:07.26,Default,,0,0,0,,hai?
Dialogue: 0,0:01:07.26,0:01:09.20,Default,,0,0,0,,Comments mein bas haan ya na
Dialogue: 0,0:01:09.20,0:01:09.76,Default,,0,0,0,,likhiye.
