Dialogue: 0,0:00:00.00,0:00:02.29,Default,,0,0,0,,500 rupaye mahine ki SIP se
Dialogue: 0,0:00:02.29,0:00:03.54,Default,,0,0,0,,sach mein kuch banta hai?
Dialogue: 0,0:00:03.54,0:00:05.63,Default,,0,0,0,,Yahi sawaal Bhai ne pichhle hafte
Dialogue: 0,0:00:05.63,0:00:06.46,Default,,0,0,0,,mujhse poocha.
Dialogue: 0,0:00:06.46,0:00:08.13,Default,,0,0,0,,Uske phone par SIP ka app
Dialogue: 0,0:00:08.13,0:00:08.76,Default,,0,0,0,,khula tha.
Dialogue: 0,0:00:08.76,0:00:10.63,Default,,0,0,0,,Screen par paisa wahin ka wahin
Dialogue: 0,0:00:10.63,0:00:10.84,Default,,0,0,0,,tha.
Dialogue: 0,0:00:10.84,0:00:11.88,Default,,0,0,0,,Aur usne kaha,
Dialogue: 0,0:00:11.88,0:00:12.09,Default,,0,0,0,,bhaiya,
Dialogue: 0,0:00:12.09,0:00:13.76,Default,,0,0,0,,main ise band kar raha hoon.
Dialogue: 0,0:00:14.21,0:00:16.16,Default,,0,0,0,,Bhai ne yeh SIP June 2024
Dialogue: 0,0:00:16.16,0:00:17.13,Default,,0,0,0,,mein shuru ki thi.
Dialogue: 0,0:00:17.13,0:00:18.88,Default,,0,0,0,,Har mahine 500 rupaye,
Dialogue: 0,0:00:18.88,0:00:20.43,Default,,0,0,0,,bank se apne aap kat jaate
Dialogue: 0,0:00:20.43,0:00:20.63,Default,,0,0,0,,the.
Dialogue: 0,0:00:20.63,0:00:21.60,Default,,0,0,0,,Usne socha tha,
Dialogue: 0,0:00:21.60,0:00:22.57,Default,,0,0,0,,chhota amount hai,
Dialogue: 0,0:00:22.57,0:00:23.55,Default,,0,0,0,,chubhega nahi.
Dialogue: 0,0:00:23.55,0:00:25.30,Default,,0,0,0,,Aur dheere dheere kuch bada ban
Dialogue: 0,0:00:25.30,0:00:25.69,Default,,0,0,0,,jaayega.
Dialogue: 0,0:00:25.69,0:00:26.85,Default,,0,0,0,,Sab yahi sochte hain,
Dialogue: 0,0:00:26.85,0:00:28.41,Default,,0,0,0,,aur yeh soch galat nahi hai.
Dialogue: 0,0:00:28.86,0:00:30.65,Default,,0,0,0,,Dinner par Papa ne FD ki
Dialogue: 0,0:00:30.65,0:00:31.99,Default,,0,0,0,,rasidein nikaal li.
Dialogue: 0,0:00:31.99,0:00:32.44,Default,,0,0,0,,Bole,
Dialogue: 0,0:00:32.44,0:00:33.78,Default,,0,0,0,,maine kaha tha na,
Dialogue: 0,0:00:33.78,0:00:34.68,Default,,0,0,0,,FD safe hai.
Dialogue: 0,0:00:34.68,0:00:36.91,Default,,0,0,0,,Share market mein paisa doobta hai.
Dialogue: 0,0:00:36.91,0:00:39.15,Default,,0,0,0,,Mummy chai lekar chupchaap sun rahi
Dialogue: 0,0:00:39.15,0:00:39.38,Default,,0,0,0,,thi.
Dialogue: 0,0:00:39.38,0:00:42.06,Default,,0,0,0,,Unke chehre par wahi purani chinta
Dialogue: 0,0:00:42.06,0:00:42.28,Default,,0,0,0,,thi,
Dialogue: 0,0:00:42.28,0:00:43.18,Default,,0,0,0,,paisa gaya toh?
Dialogue: 0,0:00:43.63,0:00:45.71,Default,,0,0,0,,Behen ne phone se nazar uthayi
Dialogue: 0,0:00:45.71,0:00:46.96,Default,,0,0,0,,aur seedha sawaal kiya.
Dialogue: 0,0:00:46.96,0:00:47.17,Default,,0,0,0,,Bhai,
Dialogue: 0,0:00:47.17,0:00:49.05,Default,,0,0,0,,tumhe pata bhi hai SIP hoti
Dialogue: 0,0:00:49.05,0:00:49.46,Default,,0,0,0,,kya hai?
Dialogue: 0,0:00:49.46,0:00:51.34,Default,,0,0,0,,Ya bas kisi video mein suna
Dialogue: 0,0:00:51.34,0:00:52.38,Default,,0,0,0,,aur shuru kar di?
Dialogue: 0,0:00:52.38,0:00:53.21,Default,,0,0,0,,Bhai chup ho gaya.
Dialogue: 0,0:00:53.21,0:00:53.83,Default,,0,0,0,,Sach yeh hai,
Dialogue: 0,0:00:53.83,0:00:56.12,Default,,0,0,0,,zyaadatar log bina samjhe SIP shuru
Dialogue: 0,0:00:56.12,0:00:56.75,Default,,0,0,0,,karte hain.
Dialogue: 0,0:00:57.20,0:00:57.87,Default,,0,0,0,,Toh chaliye,
Dialogue: 0,0:00:57.87,0:00:59.89,Default,,0,0,0,,usi dinner table ki baat aaj
Dialogue: 0,0:00:59.89,0:01:01.23,Default,,0,0,0,,aapke saath karte hain.
Dialogue: 0,0:01:01.23,0:01:02.35,Default,,0,0,0,,Aaj teen sawaal hain.
Dialogue: 0,0:01:02.35,0:01:02.80,Default,,0,0,0,,Pehla,
Dialogue: 0,0:01:02.80,0:01:05.04,Default,,0,0,0,,500 rupaye ki SIP asal mein
Dialogue: 0,0:01:05.04,0:01:06.39,Default,,0,0,0,,kaam kaise karti hai?
Dialogue: 0,0:01:06.39,0:01:06.61,Default,,0,0,0,,Phir,
Dialogue: 0,0:01:06.61,0:01:08.63,Default,,0,0,0,,market seedha na chale toh kya
Dialogue: 0,0:01:08.63,0:01:09.30,Default,,0,0,0,,hota hai?
Dialogue: 0,0:01:09.30,0:01:10.20,Default,,0,0,0,,Aur aakhir mein,
Dialogue: 0,0:01:10.20,0:01:12.44,Default,,0,0,0,,chupchaap aapka paisa kaun khata hai?
Dialogue: 0,0:01:12.89,0:01:13.92,Default,,0,0,0,,Pehle seedhi baat,
Dialogue: 0,0:01:13.92,0:01:14.94,Default,,0,0,0,,SIP hoti kya hai.
Dialogue: 0,0:01:14.94,0:01:17.20,Default,,0,0,0,,SIP yaani Systematic Investment Plan.
Dialogue: 0,0:01:17.20,0:01:19.45,Default,,0,0,0,,Matlab har mahine fixed taarikh par,
Dialogue: 0,0:01:19.45,0:01:21.50,Default,,0,0,0,,fixed rakam mutual fund mein jaati
Dialogue: 0,0:01:21.50,0:01:21.71,Default,,0,0,0,,hai.
Dialogue: 0,0:01:21.71,0:01:23.96,Default,,0,0,0,,Mutual fund yaani bahut saare logon
Dialogue: 0,0:01:23.96,0:01:25.19,Default,,0,0,0,,ka paisa ek jagah.
Dialogue: 0,0:01:25.19,0:01:27.86,Default,,0,0,0,,Use professional fund manager shares ya
Dialogue: 0,0:01:27.86,0:01:29.09,Default,,0,0,0,,bonds mein lagata hai.
Dialogue: 0,0:01:29.54,0:01:30.72,Default,,0,0,0,,Aur sabse achhi baat,
Dialogue: 0,0:01:30.72,0:01:32.89,Default,,0,0,0,,shuruaat badi rakam se nahi karni
Dialogue: 0,0:01:32.89,0:01:33.28,Default,,0,0,0,,padti.
Dialogue: 0,0:01:33.28,0:01:35.64,Default,,0,0,0,,AMFI ke mutabik SIP 500 rupaye
Dialogue: 0,0:01:35.64,0:01:37.61,Default,,0,0,0,,mahine se bhi shuru ho sakti
Dialogue: 0,0:01:37.61,0:01:37.80,Default,,0,0,0,,hai.
Dialogue: 0,0:01:37.80,0:01:39.97,Default,,0,0,0,,Yaani mahine ka bahar ka pizza
Dialogue: 0,0:01:39.97,0:01:40.36,Default,,0,0,0,,chhod do,
Dialogue: 0,0:01:40.36,0:01:40.56,Default,,0,0,0,,bas.
Dialogue: 0,0:01:40.56,0:01:42.53,Default,,0,0,0,,Ameer hona zaroori nahi hai,
Dialogue: 0,0:01:42.53,0:01:44.10,Default,,0,0,0,,shuru karna zaroori hai.
Dialogue: 0,0:01:44.55,0:01:46.97,Default,,0,0,0,,Lekin yahin log pehli galti karte
Dialogue: 0,0:01:46.97,0:01:47.19,Default,,0,0,0,,hain.
Dialogue: 0,0:01:47.19,0:01:48.07,Default,,0,0,0,,Woh sochte hain,
Dialogue: 0,0:01:48.07,0:01:49.84,Default,,0,0,0,,SIP koi scheme hai jo fixed
Dialogue: 0,0:01:49.84,0:01:50.94,Default,,0,0,0,,return deti hai.
Dialogue: 0,0:01:50.94,0:01:51.38,Default,,0,0,0,,Nahi.
Dialogue: 0,0:01:51.38,0:01:53.58,Default,,0,0,0,,SIP sirf paisa daalne ka tareeka
Dialogue: 0,0:01:53.58,0:01:53.80,Default,,0,0,0,,hai.
Dialogue: 0,0:01:53.80,0:01:55.56,Default,,0,0,0,,Return us fund se aata hai
Dialogue: 0,0:01:55.56,0:01:57.11,Default,,0,0,0,,jisme paisa jaata hai.
Dialogue: 0,0:01:57.11,0:01:58.87,Default,,0,0,0,,Aur fund ka return market ke
Dialogue: 0,0:01:58.87,0:02:00.63,Default,,0,0,0,,saath upar neeche hota hai.
Dialogue: 0,0:02:01.08,0:02:02.29,Default,,0,0,0,,Ab pehla sawaal,
Dialogue: 0,0:02:02.29,0:02:04.95,Default,,0,0,0,,yeh 500 rupaye kaam kaise karte
Dialogue: 0,0:02:04.95,0:02:05.19,Default,,0,0,0,,hain?
Dialogue: 0,0:02:05.19,0:02:07.12,Default,,0,0,0,,Iske liye ek bhaari shabd hai,
Dialogue: 0,0:02:07.12,0:02:08.82,Default,,0,0,0,,rupee cost averaging.
Dialogue: 0,0:02:08.82,0:02:09.54,Default,,0,0,0,,Ghabraiye mat,
Dialogue: 0,0:02:09.54,0:02:11.72,Default,,0,0,0,,iska matlab bahut simple hai.
Dialogue: 0,0:02:11.72,0:02:14.62,Default,,0,0,0,,Chaliye ise sabzi mandi mein samajhte
Dialogue: 0,0:02:14.62,0:02:14.86,Default,,0,0,0,,hain,
Dialogue: 0,0:02:14.86,0:02:17.28,Default,,0,0,0,,jahan Wife har hafte jaati hai.
Dialogue: 0,0:02:17.73,0:02:19.50,Default,,0,0,0,,Maan lijiye tamatar sasta hai,
Dialogue: 0,0:02:19.50,0:02:21.47,Default,,0,0,0,,toh usi paise mein zyaada kilo
Dialogue: 0,0:02:21.47,0:02:22.06,Default,,0,0,0,,aate hain.
Dialogue: 0,0:02:22.06,0:02:23.24,Default,,0,0,0,,Tamatar mehnga hai,
Dialogue: 0,0:02:23.24,0:02:24.22,Default,,0,0,0,,toh kam aate hain.
Dialogue: 0,0:02:24.22,0:02:25.99,Default,,0,0,0,,Agar aap har hafte utne hi
Dialogue: 0,0:02:25.99,0:02:27.37,Default,,0,0,0,,paise ke tamatar lo,
Dialogue: 0,0:02:27.37,0:02:28.16,Default,,0,0,0,,toh kya hoga?
Dialogue: 0,0:02:28.16,0:02:29.53,Default,,0,0,0,,Kabhi zyaada milenge,
Dialogue: 0,0:02:29.53,0:02:30.12,Default,,0,0,0,,kabhi kam.
Dialogue: 0,0:02:30.12,0:02:32.09,Default,,0,0,0,,Average daam beech ka ho jaayega.
Dialogue: 0,0:02:32.54,0:02:34.35,Default,,0,0,0,,Mutual fund mein bhi yahi hota
Dialogue: 0,0:02:34.35,0:02:34.55,Default,,0,0,0,,hai.
Dialogue: 0,0:02:34.55,0:02:36.16,Default,,0,0,0,,Fund ka daam roz badalta hai,
Dialogue: 0,0:02:36.16,0:02:37.37,Default,,0,0,0,,ise NAV kehte hain.
Dialogue: 0,0:02:37.37,0:02:38.98,Default,,0,0,0,,NAV yaani fund ki ek unit
Dialogue: 0,0:02:38.98,0:02:39.99,Default,,0,0,0,,ka us din ka daam.
Dialogue: 0,0:02:39.99,0:02:42.40,Default,,0,0,0,,Aapke 500 rupaye se jitni units
Dialogue: 0,0:02:42.40,0:02:43.01,Default,,0,0,0,,aati hain,
Dialogue: 0,0:02:43.01,0:02:45.02,Default,,0,0,0,,utni aapke account mein jud jaati
Dialogue: 0,0:02:45.02,0:02:45.22,Default,,0,0,0,,hain.
Dialogue: 0,0:02:45.67,0:02:46.87,Default,,0,0,0,,Jab market upar hai,
Dialogue: 0,0:02:46.87,0:02:47.66,Default,,0,0,0,,NAV mehngi hai,
Dialogue: 0,0:02:47.66,0:02:49.06,Default,,0,0,0,,toh units kam milti hain.
Dialogue: 0,0:02:49.06,0:02:50.26,Default,,0,0,0,,Jab market neeche hai,
Dialogue: 0,0:02:50.26,0:02:51.05,Default,,0,0,0,,NAV sasti hai,
Dialogue: 0,0:02:51.05,0:02:52.65,Default,,0,0,0,,toh units zyaada milti hain.
Dialogue: 0,0:02:52.65,0:02:54.44,Default,,0,0,0,,Aapko kuch karna nahi padta.
Dialogue: 0,0:02:54.44,0:02:55.84,Default,,0,0,0,,Bank se paisa kat-ta hai,
Dialogue: 0,0:02:55.84,0:02:58.03,Default,,0,0,0,,aur system apne aap average kar
Dialogue: 0,0:02:58.03,0:02:58.63,Default,,0,0,0,,deta hai.
Dialogue: 0,0:02:59.08,0:03:00.47,Default,,0,0,0,,Ab Bhai ki galti dekhiye.
Dialogue: 0,0:03:00.47,0:03:02.26,Default,,0,0,0,,Usne sirf screen par total value
Dialogue: 0,0:03:02.26,0:03:02.66,Default,,0,0,0,,dekhi.
Dialogue: 0,0:03:02.66,0:03:03.85,Default,,0,0,0,,Value badhi nahi,
Dialogue: 0,0:03:03.85,0:03:05.65,Default,,0,0,0,,toh usne socha nuksaan ho gaya.
Dialogue: 0,0:03:05.65,0:03:07.44,Default,,0,0,0,,Par usne yeh nahi dekha ki
Dialogue: 0,0:03:07.44,0:03:09.82,Default,,0,0,0,,girte market mein uske 500 rupaye
Dialogue: 0,0:03:09.82,0:03:11.61,Default,,0,0,0,,zyaada units khareed rahe the.
Dialogue: 0,0:03:11.61,0:03:14.00,Default,,0,0,0,,Wahi units aage ka asli khazana
Dialogue: 0,0:03:14.00,0:03:14.20,Default,,0,0,0,,hain.
Dialogue: 0,0:03:14.65,0:03:15.66,Default,,0,0,0,,Isliye kehte hain,
Dialogue: 0,0:03:15.66,0:03:17.47,Default,,0,0,0,,SIP karne waale ke liye girta
Dialogue: 0,0:03:17.47,0:03:18.88,Default,,0,0,0,,market dushman nahi hai.
Dialogue: 0,0:03:18.88,0:03:20.28,Default,,0,0,0,,Woh sale ka season hai.
Dialogue: 0,0:03:20.28,0:03:22.09,Default,,0,0,0,,Dukaan pe sale lagti hai toh
Dialogue: 0,0:03:22.09,0:03:23.30,Default,,0,0,0,,hum bhaag ke jaate hain.
Dialogue: 0,0:03:23.30,0:03:25.31,Default,,0,0,0,,Share market pe sale lagti hai
Dialogue: 0,0:03:25.31,0:03:26.92,Default,,0,0,0,,toh hum bhaag ke nikalte hain.
Dialogue: 0,0:03:26.92,0:03:28.13,Default,,0,0,0,,Ulta nahi lagta?
Dialogue: 0,0:03:28.58,0:03:30.28,Default,,0,0,0,,Lekin ek imaandaar baat bhi sun
Dialogue: 0,0:03:30.28,0:03:30.66,Default,,0,0,0,,lijiye.
Dialogue: 0,0:03:30.66,0:03:32.74,Default,,0,0,0,,Rupee cost averaging nuksaan ko gayab
Dialogue: 0,0:03:32.74,0:03:33.50,Default,,0,0,0,,nahi karti.
Dialogue: 0,0:03:33.50,0:03:35.57,Default,,0,0,0,,Agar market bahut lambe samay tak
Dialogue: 0,0:03:35.57,0:03:36.52,Default,,0,0,0,,neeche hi rahe,
Dialogue: 0,0:03:36.52,0:03:38.79,Default,,0,0,0,,toh averaging bhi bacha nahi sakti.
Dialogue: 0,0:03:38.79,0:03:40.30,Default,,0,0,0,,Yeh bas itna karti hai ki
Dialogue: 0,0:03:40.30,0:03:42.38,Default,,0,0,0,,aapko sahi waqt dhundhna nahi padta.
Dialogue: 0,0:03:42.83,0:03:45.03,Default,,0,0,0,,Market ka sahi waqt koi nahi
Dialogue: 0,0:03:45.03,0:03:45.51,Default,,0,0,0,,jaanta.
Dialogue: 0,0:03:45.51,0:03:46.49,Default,,0,0,0,,Na TV waale,
Dialogue: 0,0:03:46.49,0:03:48.20,Default,,0,0,0,,na tip dene waale dost.
Dialogue: 0,0:03:48.20,0:03:50.39,Default,,0,0,0,,Ise market timing kehte hain,
Dialogue: 0,0:03:50.39,0:03:53.32,Default,,0,0,0,,yaani sabse neeche khareedna aur sabse
Dialogue: 0,0:03:53.32,0:03:54.29,Default,,0,0,0,,upar bechna.
Dialogue: 0,0:03:54.29,0:03:56.73,Default,,0,0,0,,Bade bade log isme fail hote
Dialogue: 0,0:03:56.73,0:03:56.98,Default,,0,0,0,,hain.
Dialogue: 0,0:03:56.98,0:03:59.17,Default,,0,0,0,,SIP aapko is game se bahar
Dialogue: 0,0:03:59.17,0:04:00.39,Default,,0,0,0,,nikaal deti hai.
Dialogue: 0,0:04:00.84,0:04:01.98,Default,,0,0,0,,Ab doosra sawaal,
Dialogue: 0,0:04:01.98,0:04:04.26,Default,,0,0,0,,jo Bhai ko sabse zyaada pareshaan
Dialogue: 0,0:04:04.26,0:04:05.18,Default,,0,0,0,,kar raha tha.
Dialogue: 0,0:04:05.18,0:04:06.77,Default,,0,0,0,,Market seedha na chale,
Dialogue: 0,0:04:06.77,0:04:08.37,Default,,0,0,0,,bas wahin ghoomta rahe,
Dialogue: 0,0:04:08.37,0:04:09.28,Default,,0,0,0,,toh kya karein?
Dialogue: 0,0:04:09.28,0:04:11.11,Default,,0,0,0,,Yeh sawaal sirf Bhai ka nahi
Dialogue: 0,0:04:11.11,0:04:11.34,Default,,0,0,0,,hai.
Dialogue: 0,0:04:11.34,0:04:13.62,Default,,0,0,0,,Bahut saare SIP waale aaj yahi
Dialogue: 0,0:04:13.62,0:04:14.53,Default,,0,0,0,,soch rahe hain.
Dialogue: 0,0:04:14.53,0:04:16.36,Default,,0,0,0,,Pehle dekhte hain ki hua kya.
Dialogue: 0,0:04:16.81,0:04:19.24,Default,,0,0,0,,Value Research ne Nifty ke Total
Dialogue: 0,0:04:19.24,0:04:21.43,Default,,0,0,0,,Return Index ka data dekha.
Dialogue: 0,0:04:21.43,0:04:23.62,Default,,0,0,0,,Total Return yaani daam ke saath
Dialogue: 0,0:04:23.62,0:04:25.08,Default,,0,0,0,,dividend bhi jod kar.
Dialogue: 0,0:04:25.08,0:04:28.48,Default,,0,0,0,,June 2024 se June 2026 tak,
Dialogue: 0,0:04:28.48,0:04:30.18,Default,,0,0,0,,isne sirf 2.2 percent diya.
Dialogue: 0,0:04:30.18,0:04:31.64,Default,,0,0,0,,Itne lambe waqt mein,
Dialogue: 0,0:04:31.64,0:04:32.37,Default,,0,0,0,,bas itna.
Dialogue: 0,0:04:32.37,0:04:34.31,Default,,0,0,0,,Bhai ki SIP ka poora samay
Dialogue: 0,0:04:34.31,0:04:35.53,Default,,0,0,0,,isi mein beeta.
Dialogue: 0,0:04:35.98,0:04:38.67,Default,,0,0,0,,Aur 2026 mein June ke aakhir
Dialogue: 0,0:04:38.67,0:04:38.91,Default,,0,0,0,,tak,
Dialogue: 0,0:04:38.91,0:04:40.86,Default,,0,0,0,,index 8.1 percent neeche tha.
Dialogue: 0,0:04:40.86,0:04:43.06,Default,,0,0,0,,Yaani Bhai ke shuru karne ke
Dialogue: 0,0:04:43.06,0:04:45.75,Default,,0,0,0,,baad market lagbhag wahin khada raha.
Dialogue: 0,0:04:45.75,0:04:47.45,Default,,0,0,0,,Upar se is saal aur gir
Dialogue: 0,0:04:47.45,0:04:47.70,Default,,0,0,0,,gaya.
Dialogue: 0,0:04:47.70,0:04:49.41,Default,,0,0,0,,Bhai ki screen par jo dikha,
Dialogue: 0,0:04:49.41,0:04:50.63,Default,,0,0,0,,woh jhooth nahi tha.
Dialogue: 0,0:04:50.63,0:04:52.58,Default,,0,0,0,,Market sach mein thaka hua tha.
Dialogue: 0,0:04:53.03,0:04:55.02,Default,,0,0,0,,Aise samay ko flat ya sideways
Dialogue: 0,0:04:55.02,0:04:56.01,Default,,0,0,0,,market kehte hain.
Dialogue: 0,0:04:56.01,0:04:58.00,Default,,0,0,0,,Yaani market na upar jaata hai,
Dialogue: 0,0:04:58.00,0:04:59.00,Default,,0,0,0,,na bahut neeche,
Dialogue: 0,0:04:59.00,0:05:00.59,Default,,0,0,0,,bas idhar udhar ghoomta hai.
Dialogue: 0,0:05:00.59,0:05:02.58,Default,,0,0,0,,Yeh sabse boring samay hota hai.
Dialogue: 0,0:05:02.58,0:05:04.17,Default,,0,0,0,,Aur boring samay mein hi log
Dialogue: 0,0:05:04.17,0:05:05.96,Default,,0,0,0,,sabse zyaada SIP band karte hain.
Dialogue: 0,0:05:05.96,0:05:06.96,Default,,0,0,0,,Dimaag kehta hai,
Dialogue: 0,0:05:06.96,0:05:08.35,Default,,0,0,0,,kuch ho hi nahi raha.
Dialogue: 0,0:05:08.80,0:05:10.32,Default,,0,0,0,,Bhai ka logic bhi yahi tha.
Dialogue: 0,0:05:10.32,0:05:11.09,Default,,0,0,0,,Usne kaha,
Dialogue: 0,0:05:11.09,0:05:12.61,Default,,0,0,0,,jab kuch mil hi nahi raha,
Dialogue: 0,0:05:12.61,0:05:13.76,Default,,0,0,0,,toh paisa kyun daalun?
Dialogue: 0,0:05:13.76,0:05:15.47,Default,,0,0,0,,Isse achha FD mein daal deta
Dialogue: 0,0:05:15.47,0:05:15.66,Default,,0,0,0,,hoon,
Dialogue: 0,0:05:15.66,0:05:16.43,Default,,0,0,0,,Papa bhi khush.
Dialogue: 0,0:05:16.43,0:05:18.33,Default,,0,0,0,,Sunne mein yeh logic bilkul sahi
Dialogue: 0,0:05:18.33,0:05:18.90,Default,,0,0,0,,lagta hai.
Dialogue: 0,0:05:18.90,0:05:20.81,Default,,0,0,0,,Lekin isme ek chhupi hui galti
Dialogue: 0,0:05:20.81,0:05:21.00,Default,,0,0,0,,hai.
Dialogue: 0,0:05:21.45,0:05:23.23,Default,,0,0,0,,Galti yeh hai ki flat market
Dialogue: 0,0:05:23.23,0:05:25.67,Default,,0,0,0,,mein bhi aapke 500 rupaye ruke
Dialogue: 0,0:05:25.67,0:05:26.34,Default,,0,0,0,,nahi hain.
Dialogue: 0,0:05:26.34,0:05:28.12,Default,,0,0,0,,Woh units khareed rahe hain,
Dialogue: 0,0:05:28.12,0:05:30.12,Default,,0,0,0,,aur girte daam par zyaada units.
Dialogue: 0,0:05:30.12,0:05:32.35,Default,,0,0,0,,Agar aur jab market aage chalta
Dialogue: 0,0:05:32.35,0:05:32.57,Default,,0,0,0,,hai,
Dialogue: 0,0:05:32.57,0:05:35.01,Default,,0,0,0,,yahi sasti units sabse zyaada kaam
Dialogue: 0,0:05:35.01,0:05:35.68,Default,,0,0,0,,aati hain.
Dialogue: 0,0:05:35.68,0:05:37.46,Default,,0,0,0,,Band karne waale ke paas yeh
Dialogue: 0,0:05:37.46,0:05:38.57,Default,,0,0,0,,hoti hi nahi.
Dialogue: 0,0:05:39.02,0:05:40.62,Default,,0,0,0,,Ab compounding samajhiye.
Dialogue: 0,0:05:40.62,0:05:42.44,Default,,0,0,0,,Compounding yaani byaaj par byaaj,
Dialogue: 0,0:05:42.44,0:05:43.81,Default,,0,0,0,,ya return par return.
Dialogue: 0,0:05:43.81,0:05:45.63,Default,,0,0,0,,Yeh tabhi kaam karti hai jab
Dialogue: 0,0:05:45.63,0:05:48.14,Default,,0,0,0,,paisa lambe samay tak bina toote
Dialogue: 0,0:05:48.14,0:05:49.06,Default,,0,0,0,,pada rahe.
Dialogue: 0,0:05:49.06,0:05:49.74,Default,,0,0,0,,SIP band ki,
Dialogue: 0,0:05:49.74,0:05:51.56,Default,,0,0,0,,toh compounding ki chain toot gayi.
Dialogue: 0,0:05:51.56,0:05:53.84,Default,,0,0,0,,Aur toota hua samay wapas nahi
Dialogue: 0,0:05:53.84,0:05:54.30,Default,,0,0,0,,aata.
Dialogue: 0,0:05:54.75,0:05:57.09,Default,,0,0,0,,Socho ek ladka har mahine gym
Dialogue: 0,0:05:57.09,0:05:57.80,Default,,0,0,0,,jaata hai,
Dialogue: 0,0:05:57.80,0:05:59.44,Default,,0,0,0,,par body nahi banti.
Dialogue: 0,0:05:59.44,0:06:01.55,Default,,0,0,0,,Kuch mahine baad woh chhod deta
Dialogue: 0,0:06:01.55,0:06:01.78,Default,,0,0,0,,hai.
Dialogue: 0,0:06:01.78,0:06:04.13,Default,,0,0,0,,Aur jis mahine se body banni
Dialogue: 0,0:06:04.13,0:06:05.07,Default,,0,0,0,,shuru hoti,
Dialogue: 0,0:06:05.07,0:06:06.71,Default,,0,0,0,,woh wahan hai hi nahi.
Dialogue: 0,0:06:06.71,0:06:08.58,Default,,0,0,0,,SIP band karna bhi waisa hi
Dialogue: 0,0:06:08.58,0:06:08.82,Default,,0,0,0,,hai.
Dialogue: 0,0:06:08.82,0:06:10.22,Default,,0,0,0,,Mehnat ke din jhele,
Dialogue: 0,0:06:10.22,0:06:11.63,Default,,0,0,0,,aur fal ke din aap gayab.
Dialogue: 0,0:06:12.08,0:06:14.00,Default,,0,0,0,,Lekin yahan bhi imaandaar baat.
Dialogue: 0,0:06:14.00,0:06:15.93,Default,,0,0,0,,Koi nahi keh sakta ki market
Dialogue: 0,0:06:15.93,0:06:16.78,Default,,0,0,0,,kab chalega.
Dialogue: 0,0:06:16.78,0:06:18.49,Default,,0,0,0,,Ho sakta hai flat samay aur
Dialogue: 0,0:06:18.49,0:06:19.35,Default,,0,0,0,,lamba chale.
Dialogue: 0,0:06:19.35,0:06:21.27,Default,,0,0,0,,Isiliye SIP sirf us paise se
Dialogue: 0,0:06:21.27,0:06:23.83,Default,,0,0,0,,karo jiski zaroorat jaldi na pade.
Dialogue: 0,0:06:23.83,0:06:25.97,Default,,0,0,0,,Tab aapko girte market mein bechna
Dialogue: 0,0:06:25.97,0:06:27.04,Default,,0,0,0,,nahi padega.
Dialogue: 0,0:06:27.49,0:06:28.71,Default,,0,0,0,,Ab teesra sawaal.
Dialogue: 0,0:06:28.71,0:06:31.14,Default,,0,0,0,,Aapke paise ko chupchaap kaun khata
Dialogue: 0,0:06:31.14,0:06:31.38,Default,,0,0,0,,hai?
Dialogue: 0,0:06:31.38,0:06:33.33,Default,,0,0,0,,Behen ne yahi poocha tha.
Dialogue: 0,0:06:33.33,0:06:33.57,Default,,0,0,0,,Bhaiya,
Dialogue: 0,0:06:33.57,0:06:35.76,Default,,0,0,0,,fund manager free mein kaam karta
Dialogue: 0,0:06:35.76,0:06:36.25,Default,,0,0,0,,hai kya?
Dialogue: 0,0:06:36.25,0:06:37.23,Default,,0,0,0,,Bilkul nahi.
Dialogue: 0,0:06:37.23,0:06:39.42,Default,,0,0,0,,Uski fees ka naam hai expense
Dialogue: 0,0:06:39.42,0:06:39.90,Default,,0,0,0,,ratio.
Dialogue: 0,0:06:39.90,0:06:41.61,Default,,0,0,0,,Aur yeh fees har saal lagti
Dialogue: 0,0:06:41.61,0:06:41.85,Default,,0,0,0,,hai.
Dialogue: 0,0:06:42.30,0:06:44.78,Default,,0,0,0,,Expense ratio yaani fund chalane ka
Dialogue: 0,0:06:44.78,0:06:45.82,Default,,0,0,0,,saalana kharcha.
Dialogue: 0,0:06:45.82,0:06:47.47,Default,,0,0,0,,Fund manager ki salary,
Dialogue: 0,0:06:47.47,0:06:48.09,Default,,0,0,0,,office,
Dialogue: 0,0:06:48.09,0:06:48.51,Default,,0,0,0,,research,
Dialogue: 0,0:06:48.51,0:06:49.75,Default,,0,0,0,,sab isme aata hai.
Dialogue: 0,0:06:49.75,0:06:51.40,Default,,0,0,0,,Yeh aapke bill mein alag se
Dialogue: 0,0:06:51.40,0:06:52.23,Default,,0,0,0,,nahi aata.
Dialogue: 0,0:06:52.23,0:06:53.89,Default,,0,0,0,,Yeh chupchaap fund ki value se
Dialogue: 0,0:06:53.89,0:06:54.72,Default,,0,0,0,,kat jaata hai.
Dialogue: 0,0:06:54.72,0:06:57.20,Default,,0,0,0,,Isliye zyaadatar log ise kabhi dekhte
Dialogue: 0,0:06:57.20,0:06:57.82,Default,,0,0,0,,hi nahi.
Dialogue: 0,0:06:58.27,0:06:59.73,Default,,0,0,0,,Kirana dukaan socho.
Dialogue: 0,0:06:59.73,0:07:01.61,Default,,0,0,0,,Shopkeeper har cheez par thoda sa
Dialogue: 0,0:07:01.61,0:07:02.65,Default,,0,0,0,,margin rakhta hai.
Dialogue: 0,0:07:02.65,0:07:04.74,Default,,0,0,0,,Ek saamaan par pata nahi chalta.
Dialogue: 0,0:07:04.74,0:07:06.40,Default,,0,0,0,,Par saal bhar ka hisaab jodo,
Dialogue: 0,0:07:06.40,0:07:08.49,Default,,0,0,0,,toh achhi khaasi rakam banti hai.
Dialogue: 0,0:07:08.49,0:07:10.58,Default,,0,0,0,,Expense ratio bhi aisa hi hai,
Dialogue: 0,0:07:10.58,0:07:11.62,Default,,0,0,0,,chhota dikhta hai,
Dialogue: 0,0:07:11.62,0:07:12.87,Default,,0,0,0,,par har saal lagta hai.
Dialogue: 0,0:07:13.32,0:07:15.24,Default,,0,0,0,,Aur yeh aapke poore jama paise
Dialogue: 0,0:07:15.24,0:07:16.01,Default,,0,0,0,,par lagta hai,
Dialogue: 0,0:07:16.01,0:07:17.93,Default,,0,0,0,,sirf naye 500 rupaye par nahi.
Dialogue: 0,0:07:17.93,0:07:20.04,Default,,0,0,0,,Jaise jaise corpus bada hota hai,
Dialogue: 0,0:07:20.04,0:07:21.76,Default,,0,0,0,,fees bhi badi hoti jaati hai.
Dialogue: 0,0:07:21.76,0:07:23.87,Default,,0,0,0,,Corpus yaani aapka kul jama paisa,
Dialogue: 0,0:07:23.87,0:07:24.64,Default,,0,0,0,,return ke saath.
Dialogue: 0,0:07:24.64,0:07:26.37,Default,,0,0,0,,Lambe samay mein yeh chhota farq
Dialogue: 0,0:07:26.37,0:07:27.52,Default,,0,0,0,,bada ban jaata hai.
Dialogue: 0,0:07:27.97,0:07:28.76,Default,,0,0,0,,Ab kaam ki baat.
Dialogue: 0,0:07:28.76,0:07:30.55,Default,,0,0,0,,Har fund ke direct aur regular
Dialogue: 0,0:07:30.55,0:07:31.34,Default,,0,0,0,,plan hote hain.
Dialogue: 0,0:07:31.34,0:07:33.13,Default,,0,0,0,,Regular plan mein beech mein agent
Dialogue: 0,0:07:33.13,0:07:34.71,Default,,0,0,0,,ya distributor hota hai,
Dialogue: 0,0:07:34.71,0:07:36.70,Default,,0,0,0,,uska commission bhi jud jaata hai.
Dialogue: 0,0:07:36.70,0:07:38.68,Default,,0,0,0,,Direct plan mein yeh commission nahi
Dialogue: 0,0:07:38.68,0:07:39.08,Default,,0,0,0,,hota.
Dialogue: 0,0:07:39.08,0:07:41.26,Default,,0,0,0,,Isliye direct plan ka expense ratio
Dialogue: 0,0:07:41.26,0:07:42.65,Default,,0,0,0,,aam taur par kam hota hai.
Dialogue: 0,0:07:43.10,0:07:44.62,Default,,0,0,0,,Aur ek chhupa kharcha hai,
Dialogue: 0,0:07:44.62,0:07:44.83,Default,,0,0,0,,tax.
Dialogue: 0,0:07:44.83,0:07:46.79,Default,,0,0,0,,Equity fund saal bhar se zyaada
Dialogue: 0,0:07:46.79,0:07:47.22,Default,,0,0,0,,rakha,
Dialogue: 0,0:07:47.22,0:07:49.39,Default,,0,0,0,,toh munafe ko long term capital
Dialogue: 0,0:07:49.39,0:07:50.25,Default,,0,0,0,,gain kehte hain.
Dialogue: 0,0:07:50.25,0:07:52.20,Default,,0,0,0,,Ispe 12.5 percent tax lagta hai.
Dialogue: 0,0:07:52.20,0:07:53.94,Default,,0,0,0,,Lekin har saal 1.25 lakh rupaye
Dialogue: 0,0:07:53.94,0:07:55.89,Default,,0,0,0,,tak ka aisa munafa tax se
Dialogue: 0,0:07:55.89,0:07:56.54,Default,,0,0,0,,chhoot mein hai.
Dialogue: 0,0:07:56.99,0:07:59.26,Default,,0,0,0,,500 rupaye ki SIP waale ko
Dialogue: 0,0:07:59.26,0:08:00.86,Default,,0,0,0,,yeh tax shuruaat mein shayad hi
Dialogue: 0,0:08:00.86,0:08:01.31,Default,,0,0,0,,lage.
Dialogue: 0,0:08:01.31,0:08:02.45,Default,,0,0,0,,Par jaankar rakhiye.
Dialogue: 0,0:08:02.45,0:08:04.73,Default,,0,0,0,,Return dekhte waqt hamesha socho,
Dialogue: 0,0:08:04.73,0:08:06.32,Default,,0,0,0,,kharcha aur tax ke baad haath
Dialogue: 0,0:08:06.32,0:08:07.46,Default,,0,0,0,,mein kya bachega.
Dialogue: 0,0:08:07.46,0:08:09.05,Default,,0,0,0,,Wahi asli return hai.
Dialogue: 0,0:08:09.05,0:08:10.87,Default,,0,0,0,,Baaki sab screen ki chamak hai.
Dialogue: 0,0:08:11.32,0:08:13.12,Default,,0,0,0,,Ab wapas dinner table par.
Dialogue: 0,0:08:13.12,0:08:14.02,Default,,0,0,0,,Bhai ne poocha,
Dialogue: 0,0:08:14.02,0:08:15.37,Default,,0,0,0,,toh kya FD bekaar hai?
Dialogue: 0,0:08:15.37,0:08:15.82,Default,,0,0,0,,Nahi.
Dialogue: 0,0:08:15.82,0:08:17.85,Default,,0,0,0,,Papa ki FD ki apni jagah
Dialogue: 0,0:08:17.85,0:08:18.07,Default,,0,0,0,,hai.
Dialogue: 0,0:08:18.07,0:08:19.65,Default,,0,0,0,,Emergency ka paisa,
Dialogue: 0,0:08:19.65,0:08:21.45,Default,,0,0,0,,jaldi chahiye waala paisa,
Dialogue: 0,0:08:21.45,0:08:22.35,Default,,0,0,0,,wahan theek hai.
Dialogue: 0,0:08:22.35,0:08:24.38,Default,,0,0,0,,Bank deposit par 5 lakh rupaye
Dialogue: 0,0:08:24.38,0:08:26.86,Default,,0,0,0,,tak ka insurance cover bhi hota
Dialogue: 0,0:08:26.86,0:08:27.08,Default,,0,0,0,,hai.
Dialogue: 0,0:08:27.53,0:08:29.27,Default,,0,0,0,,Sabse badi galti hai,
Dialogue: 0,0:08:29.27,0:08:30.27,Default,,0,0,0,,darr mein faisla.
Dialogue: 0,0:08:30.27,0:08:31.27,Default,,0,0,0,,Market gira,
Dialogue: 0,0:08:31.27,0:08:32.76,Default,,0,0,0,,news mein laal screen dikhi,
Dialogue: 0,0:08:32.76,0:08:33.51,Default,,0,0,0,,aur SIP band.
Dialogue: 0,0:08:33.51,0:08:34.76,Default,,0,0,0,,Phir market sambhla,
Dialogue: 0,0:08:34.76,0:08:36.50,Default,,0,0,0,,toh log upar ke daam par
Dialogue: 0,0:08:36.50,0:08:37.75,Default,,0,0,0,,wapas aate hain.
Dialogue: 0,0:08:37.75,0:08:39.24,Default,,0,0,0,,Yaani sasta chhod diya,
Dialogue: 0,0:08:39.24,0:08:40.49,Default,,0,0,0,,mehnga khareeda.
Dialogue: 0,0:08:40.49,0:08:42.73,Default,,0,0,0,,Yahi cheez SIP ko sabse zyaada
Dialogue: 0,0:08:42.73,0:08:43.73,Default,,0,0,0,,bigaadti hai.
Dialogue: 0,0:08:44.18,0:08:45.33,Default,,0,0,0,,Ek aur galti hai,
Dialogue: 0,0:08:45.33,0:08:47.16,Default,,0,0,0,,sirf pichhla return dekh kar fund
Dialogue: 0,0:08:47.16,0:08:47.61,Default,,0,0,0,,chunna.
Dialogue: 0,0:08:47.61,0:08:49.67,Default,,0,0,0,,Jo fund pichhle saal sabse upar
Dialogue: 0,0:08:49.67,0:08:49.90,Default,,0,0,0,,tha,
Dialogue: 0,0:08:49.90,0:08:52.19,Default,,0,0,0,,zaroori nahi aage bhi rahe.
Dialogue: 0,0:08:52.19,0:08:53.11,Default,,0,0,0,,Aur ek galti,
Dialogue: 0,0:08:53.11,0:08:54.02,Default,,0,0,0,,roz app kholna.
Dialogue: 0,0:08:54.02,0:08:54.94,Default,,0,0,0,,Roz khologe,
Dialogue: 0,0:08:54.94,0:08:56.31,Default,,0,0,0,,toh roz darr lagega.
Dialogue: 0,0:08:56.31,0:08:57.69,Default,,0,0,0,,SIP lambi race hai,
Dialogue: 0,0:08:57.69,0:08:59.06,Default,,0,0,0,,roz ka score nahi.
Dialogue: 0,0:08:59.51,0:09:00.37,Default,,0,0,0,,Toh kya karein?
Dialogue: 0,0:09:00.37,0:09:01.87,Default,,0,0,0,,Pehle emergency fund,
Dialogue: 0,0:09:01.87,0:09:02.29,Default,,0,0,0,,phir SIP.
Dialogue: 0,0:09:02.29,0:09:04.65,Default,,0,0,0,,SIP utni rakho jo bure mahine
Dialogue: 0,0:09:04.65,0:09:05.72,Default,,0,0,0,,mein bhi chal sake,
Dialogue: 0,0:09:05.72,0:09:07.86,Default,,0,0,0,,chahe 500 rupaye hi kyun na
Dialogue: 0,0:09:07.86,0:09:08.08,Default,,0,0,0,,ho.
Dialogue: 0,0:09:08.08,0:09:10.22,Default,,0,0,0,,Direct plan aur expense ratio check
Dialogue: 0,0:09:10.22,0:09:10.65,Default,,0,0,0,,karo.
Dialogue: 0,0:09:10.65,0:09:11.93,Default,,0,0,0,,Aur saal mein bas kuch baar
Dialogue: 0,0:09:11.93,0:09:12.79,Default,,0,0,0,,hisaab dekho,
Dialogue: 0,0:09:12.79,0:09:13.43,Default,,0,0,0,,roz nahi.
Dialogue: 0,0:09:13.88,0:09:15.41,Default,,0,0,0,,Aur jab salary badhe,
Dialogue: 0,0:09:15.41,0:09:16.95,Default,,0,0,0,,toh SIP bhi thodi badhao.
Dialogue: 0,0:09:16.95,0:09:18.70,Default,,0,0,0,,Ise step-up SIP kehte hain,
Dialogue: 0,0:09:18.70,0:09:20.45,Default,,0,0,0,,yaani har saal SIP ki rakam
Dialogue: 0,0:09:20.45,0:09:21.11,Default,,0,0,0,,badhana.
Dialogue: 0,0:09:21.11,0:09:21.98,Default,,0,0,0,,Bhai ne kaha,
Dialogue: 0,0:09:21.98,0:09:22.64,Default,,0,0,0,,theek hai bhaiya,
Dialogue: 0,0:09:22.64,0:09:23.96,Default,,0,0,0,,band nahi karunga.
Dialogue: 0,0:09:23.96,0:09:25.71,Default,,0,0,0,,Papa ne FD ki rasid rakh
Dialogue: 0,0:09:25.71,0:09:27.24,Default,,0,0,0,,kar halki si muskaan di.
Dialogue: 0,0:09:27.69,0:09:28.73,Default,,0,0,0,,Ek baat saaf kar doon.
Dialogue: 0,0:09:28.73,0:09:30.39,Default,,0,0,0,,Main kisi fund ka naam nahi
Dialogue: 0,0:09:30.39,0:09:31.01,Default,,0,0,0,,le raha,
Dialogue: 0,0:09:31.01,0:09:33.09,Default,,0,0,0,,aur kisi return ka vaada nahi
Dialogue: 0,0:09:33.09,0:09:33.71,Default,,0,0,0,,kar raha.
Dialogue: 0,0:09:33.71,0:09:35.37,Default,,0,0,0,,Market upar bhi jaata hai,
Dialogue: 0,0:09:35.37,0:09:35.99,Default,,0,0,0,,neeche bhi.
Dialogue: 0,0:09:35.99,0:09:38.07,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:09:38.07,0:09:39.52,Default,,0,0,0,,Apni zaroorat dekh kar,
Dialogue: 0,0:09:39.52,0:09:40.97,Default,,0,0,0,,samajh kar faisla kijiye.
Dialogue: 0,0:09:41.42,0:09:43.72,Default,,0,0,0,,Agle video mein baat karenge PPF
Dialogue: 0,0:09:43.72,0:09:44.41,Default,,0,0,0,,aur EPF ki,
Dialogue: 0,0:09:44.41,0:09:46.48,Default,,0,0,0,,jo Papa ko itne pasand hain.
