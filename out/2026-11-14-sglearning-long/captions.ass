Dialogue: 0,0:00:00.00,0:00:02.29,Default,,0,0,0,,500 rupaye mahine ki SIP se
Dialogue: 0,0:00:02.29,0:00:03.54,Default,,0,0,0,,sach mein kuch banta hai?
Dialogue: 0,0:00:03.54,0:00:05.63,Default,,0,0,0,,Yahi sawaal Bhai ne pichhle hafte
Dialogue: 0,0:00:05.63,0:00:06.46,Default,,0,0,0,,mujhse poocha.
Dialogue: 0,0:00:06.46,0:00:08.13,Default,,0,0,0,,Uske phone par SIP ka app
Dialogue: 0,0:00:08.13,0:00:08.76,Default,,0,0,0,,khula tha.
Dialogue: 0,0:00:08.76,0:00:10.63,Default,,0,0,0,,Screen par paisa wahin ka wahin
Dialogue: 0,0:00:10.63,0:00:10.84,Default,,0,0,0,,tha.
Dialogue: 0,0:00:10.84,0:00:11.88,Default,,0,0,0,,Aur usne kaha,
Dialogue: 0,0:00:11.88,0:00:12.09,Default,,0,0,0,,bhaiya,
Dialogue: 0,0:00:12.09,0:00:13.76,Default,,0,0,0,,main ise band kar raha hoon.
Dialogue: 0,0:00:14.21,0:00:16.16,Default,,0,0,0,,Bhai ne yeh SIP June 2024
Dialogue: 0,0:00:16.16,0:00:17.13,Default,,0,0,0,,mein shuru ki thi.
Dialogue: 0,0:00:17.13,0:00:18.88,Default,,0,0,0,,Har mahine 500 rupaye,
Dialogue: 0,0:00:18.88,0:00:20.43,Default,,0,0,0,,bank se apne aap kat jaate
Dialogue: 0,0:00:20.43,0:00:20.63,Default,,0,0,0,,the.
Dialogue: 0,0:00:20.63,0:00:21.60,Default,,0,0,0,,Usne socha tha,
Dialogue: 0,0:00:21.60,0:00:22.57,Default,,0,0,0,,chhota amount hai,
Dialogue: 0,0:00:22.57,0:00:23.55,Default,,0,0,0,,chubhega nahi.
Dialogue: 0,0:00:23.55,0:00:25.30,Default,,0,0,0,,Aur dheere dheere kuch bada ban
Dialogue: 0,0:00:25.30,0:00:25.69,Default,,0,0,0,,jaayega.
Dialogue: 0,0:00:25.69,0:00:26.85,Default,,0,0,0,,Sab yahi sochte hain,
Dialogue: 0,0:00:26.85,0:00:28.41,Default,,0,0,0,,aur yeh soch galat nahi hai.
Dialogue: 0,0:00:28.86,0:00:30.65,Default,,0,0,0,,Dinner par Papa ne FD ki
Dialogue: 0,0:00:30.65,0:00:31.99,Default,,0,0,0,,rasidein nikaal li.
Dialogue: 0,0:00:31.99,0:00:32.44,Default,,0,0,0,,Bole,
Dialogue: 0,0:00:32.44,0:00:33.78,Default,,0,0,0,,maine kaha tha na,
Dialogue: 0,0:00:33.78,0:00:34.68,Default,,0,0,0,,FD safe hai.
Dialogue: 0,0:00:34.68,0:00:36.91,Default,,0,0,0,,Share market mein paisa doobta hai.
Dialogue: 0,0:00:36.91,0:00:39.15,Default,,0,0,0,,Mummy chai lekar chupchaap sun rahi
Dialogue: 0,0:00:39.15,0:00:39.38,Default,,0,0,0,,thi.
Dialogue: 0,0:00:39.38,0:00:42.06,Default,,0,0,0,,Unke chehre par wahi purani chinta
Dialogue: 0,0:00:42.06,0:00:42.28,Default,,0,0,0,,thi,
Dialogue: 0,0:00:42.28,0:00:43.18,Default,,0,0,0,,paisa gaya toh?
Dialogue: 0,0:00:43.63,0:00:45.71,Default,,0,0,0,,Behen ne phone se nazar uthayi
Dialogue: 0,0:00:45.71,0:00:46.96,Default,,0,0,0,,aur seedha sawaal kiya.
Dialogue: 0,0:00:46.96,0:00:47.17,Default,,0,0,0,,Bhai,
Dialogue: 0,0:00:47.17,0:00:49.05,Default,,0,0,0,,tumhe pata bhi hai SIP hoti
Dialogue: 0,0:00:49.05,0:00:49.46,Default,,0,0,0,,kya hai?
Dialogue: 0,0:00:49.46,0:00:51.34,Default,,0,0,0,,Ya bas kisi video mein suna
Dialogue: 0,0:00:51.34,0:00:52.38,Default,,0,0,0,,aur shuru kar di?
Dialogue: 0,0:00:52.38,0:00:53.21,Default,,0,0,0,,Bhai chup ho gaya.
Dialogue: 0,0:00:53.21,0:00:53.83,Default,,0,0,0,,Sach yeh hai,
Dialogue: 0,0:00:53.83,0:00:56.12,Default,,0,0,0,,zyaadatar log bina samjhe SIP shuru
Dialogue: 0,0:00:56.12,0:00:56.75,Default,,0,0,0,,karte hain.
Dialogue: 0,0:00:57.20,0:00:57.87,Default,,0,0,0,,Toh chaliye,
Dialogue: 0,0:00:57.87,0:00:59.89,Default,,0,0,0,,usi dinner table ki baat aaj
Dialogue: 0,0:00:59.89,0:01:01.23,Default,,0,0,0,,aapke saath karte hain.
Dialogue: 0,0:01:01.23,0:01:02.35,Default,,0,0,0,,Aaj teen sawaal hain.
Dialogue: 0,0:01:02.35,0:01:02.80,Default,,0,0,0,,Pehla,
Dialogue: 0,0:01:02.80,0:01:05.04,Default,,0,0,0,,500 rupaye ki SIP asal mein
Dialogue: 0,0:01:05.04,0:01:06.39,Default,,0,0,0,,kaam kaise karti hai?
Dialogue: 0,0:01:06.39,0:01:06.61,Default,,0,0,0,,Phir,
Dialogue: 0,0:01:06.61,0:01:08.63,Default,,0,0,0,,market seedha na chale toh kya
Dialogue: 0,0:01:08.63,0:01:09.30,Default,,0,0,0,,hota hai?
Dialogue: 0,0:01:09.30,0:01:10.20,Default,,0,0,0,,Aur aakhir mein,
Dialogue: 0,0:01:10.20,0:01:12.44,Default,,0,0,0,,chupchaap aapka paisa kaun khata hai?
Dialogue: 0,0:01:12.89,0:01:13.92,Default,,0,0,0,,Pehle seedhi baat,
Dialogue: 0,0:01:13.92,0:01:14.94,Default,,0,0,0,,SIP hoti kya hai.
Dialogue: 0,0:01:14.94,0:01:17.20,Default,,0,0,0,,SIP yaani Systematic Investment Plan.
Dialogue: 0,0:01:17.20,0:01:19.45,Default,,0,0,0,,Matlab har mahine fixed taarikh par,
Dialogue: 0,0:01:19.45,0:01:21.50,Default,,0,0,0,,fixed rakam mutual fund mein jaati
Dialogue: 0,0:01:21.50,0:01:21.71,Default,,0,0,0,,hai.
Dialogue: 0,0:01:21.71,0:01:23.96,Default,,0,0,0,,Mutual fund yaani bahut saare logon
Dialogue: 0,0:01:23.96,0:01:25.19,Default,,0,0,0,,ka paisa ek jagah.
Dialogue: 0,0:01:25.19,0:01:27.86,Default,,0,0,0,,Use professional fund manager shares ya
Dialogue: 0,0:01:27.86,0:01:29.09,Default,,0,0,0,,bonds mein lagata hai.
Dialogue: 0,0:01:29.54,0:01:30.72,Default,,0,0,0,,Aur sabse achhi baat,
Dialogue: 0,0:01:30.72,0:01:32.89,Default,,0,0,0,,shuruaat badi rakam se nahi karni
Dialogue: 0,0:01:32.89,0:01:33.28,Default,,0,0,0,,padti.
Dialogue: 0,0:01:33.28,0:01:35.64,Default,,0,0,0,,AMFI ke mutabik SIP 500 rupaye
Dialogue: 0,0:01:35.64,0:01:37.61,Default,,0,0,0,,mahine se bhi shuru ho sakti
Dialogue: 0,0:01:37.61,0:01:37.80,Default,,0,0,0,,hai.
Dialogue: 0,0:01:37.80,0:01:39.97,Default,,0,0,0,,Yaani mahine ka bahar ka pizza
Dialogue: 0,0:01:39.97,0:01:40.36,Default,,0,0,0,,chhod do,
Dialogue: 0,0:01:40.36,0:01:40.56,Default,,0,0,0,,bas.
Dialogue: 0,0:01:40.56,0:01:42.53,Default,,0,0,0,,Ameer hona zaroori nahi hai,
Dialogue: 0,0:01:42.53,0:01:44.10,Default,,0,0,0,,shuru karna zaroori hai.
Dialogue: 0,0:01:44.55,0:01:46.97,Default,,0,0,0,,Lekin yahin log pehli galti karte
Dialogue: 0,0:01:46.97,0:01:47.19,Default,,0,0,0,,hain.
Dialogue: 0,0:01:47.19,0:01:48.07,Default,,0,0,0,,Woh sochte hain,
Dialogue: 0,0:01:48.07,0:01:49.84,Default,,0,0,0,,SIP koi scheme hai jo fixed
Dialogue: 0,0:01:49.84,0:01:50.94,Default,,0,0,0,,return deti hai.
Dialogue: 0,0:01:50.94,0:01:51.38,Default,,0,0,0,,Nahi.
Dialogue: 0,0:01:51.38,0:01:53.58,Default,,0,0,0,,SIP sirf paisa daalne ka tareeka
Dialogue: 0,0:01:53.58,0:01:53.80,Default,,0,0,0,,hai.
Dialogue: 0,0:01:53.80,0:01:55.56,Default,,0,0,0,,Return us fund se aata hai
Dialogue: 0,0:01:55.56,0:01:57.11,Default,,0,0,0,,jisme paisa jaata hai.
Dialogue: 0,0:01:57.11,0:01:58.87,Default,,0,0,0,,Aur fund ka return market ke
Dialogue: 0,0:01:58.87,0:02:00.63,Default,,0,0,0,,saath upar neeche hota hai.
Dialogue: 0,0:02:01.08,0:02:02.29,Default,,0,0,0,,Ab pehla sawaal,
Dialogue: 0,0:02:02.29,0:02:04.95,Default,,0,0,0,,yeh 500 rupaye kaam kaise karte
Dialogue: 0,0:02:04.95,0:02:05.19,Default,,0,0,0,,hain?
Dialogue: 0,0:02:05.19,0:02:07.12,Default,,0,0,0,,Iske liye ek bhaari shabd hai,
Dialogue: 0,0:02:07.12,0:02:08.82,Default,,0,0,0,,rupee cost averaging.
Dialogue: 0,0:02:08.82,0:02:09.54,Default,,0,0,0,,Ghabraiye mat,
Dialogue: 0,0:02:09.54,0:02:11.72,Default,,0,0,0,,iska matlab bahut simple hai.
Dialogue: 0,0:02:11.72,0:02:14.62,Default,,0,0,0,,Chaliye ise sabzi mandi mein samajhte
Dialogue: 0,0:02:14.62,0:02:14.86,Default,,0,0,0,,hain,
Dialogue: 0,0:02:14.86,0:02:17.28,Default,,0,0,0,,jahan Wife har hafte jaati hai.
Dialogue: 0,0:02:17.73,0:02:19.50,Default,,0,0,0,,Maan lijiye tamatar sasta hai,
Dialogue: 0,0:02:19.50,0:02:21.47,Default,,0,0,0,,toh usi paise mein zyaada kilo
Dialogue: 0,0:02:21.47,0:02:22.06,Default,,0,0,0,,aate hain.
Dialogue: 0,0:02:22.06,0:02:23.24,Default,,0,0,0,,Tamatar mehnga hai,
Dialogue: 0,0:02:23.24,0:02:24.22,Default,,0,0,0,,toh kam aate hain.
Dialogue: 0,0:02:24.22,0:02:25.99,Default,,0,0,0,,Agar aap har hafte utne hi
Dialogue: 0,0:02:25.99,0:02:27.37,Default,,0,0,0,,paise ke tamatar lo,
Dialogue: 0,0:02:27.37,0:02:28.16,Default,,0,0,0,,toh kya hoga?
Dialogue: 0,0:02:28.16,0:02:29.53,Default,,0,0,0,,Kabhi zyaada milenge,
Dialogue: 0,0:02:29.53,0:02:30.12,Default,,0,0,0,,kabhi kam.
Dialogue: 0,0:02:30.12,0:02:32.09,Default,,0,0,0,,Average daam beech ka ho jaayega.
Dialogue: 0,0:02:32.54,0:02:34.35,Default,,0,0,0,,Mutual fund mein bhi yahi hota
Dialogue: 0,0:02:34.35,0:02:34.55,Default,,0,0,0,,hai.
Dialogue: 0,0:02:34.55,0:02:36.16,Default,,0,0,0,,Fund ka daam roz badalta hai,
Dialogue: 0,0:02:36.16,0:02:37.37,Default,,0,0,0,,ise NAV kehte hain.
Dialogue: 0,0:02:37.37,0:02:38.98,Default,,0,0,0,,NAV yaani fund ki ek unit
Dialogue: 0,0:02:38.98,0:02:39.99,Default,,0,0,0,,ka us din ka daam.
Dialogue: 0,0:02:39.99,0:02:42.40,Default,,0,0,0,,Aapke 500 rupaye se jitni units
Dialogue: 0,0:02:42.40,0:02:43.01,Default,,0,0,0,,aati hain,
Dialogue: 0,0:02:43.01,0:02:45.02,Default,,0,0,0,,utni aapke account mein jud jaati
Dialogue: 0,0:02:45.02,0:02:45.22,Default,,0,0,0,,hain.
Dialogue: 0,0:02:45.67,0:02:46.93,Default,,0,0,0,,Jab market upar hai,
Dialogue: 0,0:02:46.93,0:02:47.76,Default,,0,0,0,,NAV mehngi hai,
Dialogue: 0,0:02:47.76,0:02:49.23,Default,,0,0,0,,toh units kam milti hain.
Dialogue: 0,0:02:49.23,0:02:50.48,Default,,0,0,0,,Jab market neeche hai,
Dialogue: 0,0:02:50.48,0:02:51.32,Default,,0,0,0,,NAV sasti hai,
Dialogue: 0,0:02:51.32,0:02:52.99,Default,,0,0,0,,toh units zyaada milti hain.
Dialogue: 0,0:02:52.99,0:02:54.88,Default,,0,0,0,,Aapko kuch karna nahi padta.
Dialogue: 0,0:02:54.88,0:02:56.34,Default,,0,0,0,,Bank se paisa kat-ta hai,
Dialogue: 0,0:02:56.34,0:02:58.64,Default,,0,0,0,,aur system apne aap average kar
Dialogue: 0,0:02:58.64,0:02:59.27,Default,,0,0,0,,deta hai.
Dialogue: 0,0:02:59.72,0:03:01.11,Default,,0,0,0,,Ab Bhai ki galti dekhiye.
Dialogue: 0,0:03:01.11,0:03:02.90,Default,,0,0,0,,Usne sirf screen par total value
Dialogue: 0,0:03:02.90,0:03:03.30,Default,,0,0,0,,dekhi.
Dialogue: 0,0:03:03.30,0:03:04.50,Default,,0,0,0,,Value badhi nahi,
Dialogue: 0,0:03:04.50,0:03:06.28,Default,,0,0,0,,toh usne socha nuksaan ho gaya.
Dialogue: 0,0:03:06.28,0:03:08.08,Default,,0,0,0,,Par usne yeh nahi dekha ki
Dialogue: 0,0:03:08.08,0:03:10.46,Default,,0,0,0,,girte market mein uske 500 rupaye
Dialogue: 0,0:03:10.46,0:03:12.25,Default,,0,0,0,,zyaada units khareed rahe the.
Dialogue: 0,0:03:12.25,0:03:14.64,Default,,0,0,0,,Wahi units aage ka asli khazana
Dialogue: 0,0:03:14.64,0:03:14.84,Default,,0,0,0,,hain.
Dialogue: 0,0:03:15.29,0:03:16.30,Default,,0,0,0,,Isliye kehte hain,
Dialogue: 0,0:03:16.30,0:03:18.11,Default,,0,0,0,,SIP karne waale ke liye girta
Dialogue: 0,0:03:18.11,0:03:19.51,Default,,0,0,0,,market dushman nahi hai.
Dialogue: 0,0:03:19.51,0:03:20.92,Default,,0,0,0,,Woh sale ka season hai.
Dialogue: 0,0:03:20.92,0:03:22.73,Default,,0,0,0,,Dukaan pe sale lagti hai toh
Dialogue: 0,0:03:22.73,0:03:23.94,Default,,0,0,0,,hum bhaag ke jaate hain.
Dialogue: 0,0:03:23.94,0:03:25.95,Default,,0,0,0,,Share market pe sale lagti hai
Dialogue: 0,0:03:25.95,0:03:27.56,Default,,0,0,0,,toh hum bhaag ke nikalte hain.
Dialogue: 0,0:03:27.56,0:03:28.77,Default,,0,0,0,,Ulta nahi lagta?
Dialogue: 0,0:03:29.22,0:03:30.92,Default,,0,0,0,,Lekin ek imaandaar baat bhi sun
Dialogue: 0,0:03:30.92,0:03:31.30,Default,,0,0,0,,lijiye.
Dialogue: 0,0:03:31.30,0:03:33.38,Default,,0,0,0,,Rupee cost averaging nuksaan ko gayab
Dialogue: 0,0:03:33.38,0:03:34.13,Default,,0,0,0,,nahi karti.
Dialogue: 0,0:03:34.13,0:03:36.22,Default,,0,0,0,,Agar market bahut lambe samay tak
Dialogue: 0,0:03:36.22,0:03:37.16,Default,,0,0,0,,neeche hi rahe,
Dialogue: 0,0:03:37.16,0:03:39.43,Default,,0,0,0,,toh averaging bhi bacha nahi sakti.
Dialogue: 0,0:03:39.43,0:03:40.94,Default,,0,0,0,,Yeh bas itna karti hai ki
Dialogue: 0,0:03:40.94,0:03:43.02,Default,,0,0,0,,aapko sahi waqt dhundhna nahi padta.
Dialogue: 0,0:03:43.47,0:03:45.66,Default,,0,0,0,,Market ka sahi waqt koi nahi
Dialogue: 0,0:03:45.66,0:03:46.15,Default,,0,0,0,,jaanta.
Dialogue: 0,0:03:46.15,0:03:47.13,Default,,0,0,0,,Na TV waale,
Dialogue: 0,0:03:47.13,0:03:48.84,Default,,0,0,0,,na tip dene waale dost.
Dialogue: 0,0:03:48.84,0:03:51.03,Default,,0,0,0,,Ise market timing kehte hain,
Dialogue: 0,0:03:51.03,0:03:53.96,Default,,0,0,0,,yaani sabse neeche khareedna aur sabse
Dialogue: 0,0:03:53.96,0:03:54.93,Default,,0,0,0,,upar bechna.
Dialogue: 0,0:03:54.93,0:03:57.37,Default,,0,0,0,,Bade bade log isme fail hote
Dialogue: 0,0:03:57.37,0:03:57.62,Default,,0,0,0,,hain.
Dialogue: 0,0:03:57.62,0:03:59.81,Default,,0,0,0,,SIP aapko is game se bahar
Dialogue: 0,0:03:59.81,0:04:01.03,Default,,0,0,0,,nikaal deti hai.
Dialogue: 0,0:04:01.48,0:04:02.62,Default,,0,0,0,,Ab doosra sawaal,
Dialogue: 0,0:04:02.62,0:04:04.90,Default,,0,0,0,,jo Bhai ko sabse zyaada pareshaan
Dialogue: 0,0:04:04.90,0:04:05.82,Default,,0,0,0,,kar raha tha.
Dialogue: 0,0:04:05.82,0:04:07.41,Default,,0,0,0,,Market seedha na chale,
Dialogue: 0,0:04:07.41,0:04:09.01,Default,,0,0,0,,bas wahin ghoomta rahe,
Dialogue: 0,0:04:09.01,0:04:09.93,Default,,0,0,0,,toh kya karein?
Dialogue: 0,0:04:09.93,0:04:11.75,Default,,0,0,0,,Yeh sawaal sirf Bhai ka nahi
Dialogue: 0,0:04:11.75,0:04:11.98,Default,,0,0,0,,hai.
Dialogue: 0,0:04:11.98,0:04:14.26,Default,,0,0,0,,Bahut saare SIP waale aaj yahi
Dialogue: 0,0:04:14.26,0:04:15.17,Default,,0,0,0,,soch rahe hain.
Dialogue: 0,0:04:15.17,0:04:17.00,Default,,0,0,0,,Pehle dekhte hain ki hua kya.
Dialogue: 0,0:04:17.45,0:04:19.88,Default,,0,0,0,,Value Research ne Nifty ke Total
Dialogue: 0,0:04:19.88,0:04:22.07,Default,,0,0,0,,Return Index ka data dekha.
Dialogue: 0,0:04:22.07,0:04:24.26,Default,,0,0,0,,Total Return yaani daam ke saath
Dialogue: 0,0:04:24.26,0:04:25.72,Default,,0,0,0,,dividend bhi jod kar.
Dialogue: 0,0:04:25.72,0:04:29.12,Default,,0,0,0,,June 2024 se June 2026 tak,
Dialogue: 0,0:04:29.12,0:04:30.82,Default,,0,0,0,,isne sirf 2.2 percent diya.
Dialogue: 0,0:04:30.82,0:04:32.28,Default,,0,0,0,,Itne lambe waqt mein,
Dialogue: 0,0:04:32.28,0:04:33.01,Default,,0,0,0,,bas itna.
Dialogue: 0,0:04:33.01,0:04:34.95,Default,,0,0,0,,Bhai ki SIP ka poora samay
Dialogue: 0,0:04:34.95,0:04:36.17,Default,,0,0,0,,isi mein beeta.
Dialogue: 0,0:04:36.62,0:04:39.31,Default,,0,0,0,,Aur 2026 mein June ke aakhir
Dialogue: 0,0:04:39.31,0:04:39.55,Default,,0,0,0,,tak,
Dialogue: 0,0:04:39.55,0:04:41.50,Default,,0,0,0,,index 8.1 percent neeche tha.
Dialogue: 0,0:04:41.50,0:04:43.70,Default,,0,0,0,,Yaani Bhai ke shuru karne ke
Dialogue: 0,0:04:43.70,0:04:46.38,Default,,0,0,0,,baad market lagbhag wahin khada raha.
Dialogue: 0,0:04:46.38,0:04:48.09,Default,,0,0,0,,Upar se is saal aur gir
Dialogue: 0,0:04:48.09,0:04:48.34,Default,,0,0,0,,gaya.
Dialogue: 0,0:04:48.34,0:04:50.05,Default,,0,0,0,,Bhai ki screen par jo dikha,
Dialogue: 0,0:04:50.05,0:04:51.27,Default,,0,0,0,,woh jhooth nahi tha.
Dialogue: 0,0:04:51.27,0:04:53.22,Default,,0,0,0,,Market sach mein thaka hua tha.
Dialogue: 0,0:04:53.67,0:04:55.66,Default,,0,0,0,,Aise samay ko flat ya sideways
Dialogue: 0,0:04:55.66,0:04:56.65,Default,,0,0,0,,market kehte hain.
Dialogue: 0,0:04:56.65,0:04:58.64,Default,,0,0,0,,Yaani market na upar jaata hai,
Dialogue: 0,0:04:58.64,0:04:59.64,Default,,0,0,0,,na bahut neeche,
Dialogue: 0,0:04:59.64,0:05:01.23,Default,,0,0,0,,bas idhar udhar ghoomta hai.
Dialogue: 0,0:05:01.23,0:05:03.22,Default,,0,0,0,,Yeh sabse boring samay hota hai.
Dialogue: 0,0:05:03.22,0:05:04.81,Default,,0,0,0,,Aur boring samay mein hi log
Dialogue: 0,0:05:04.81,0:05:06.60,Default,,0,0,0,,sabse zyaada SIP band karte hain.
Dialogue: 0,0:05:06.60,0:05:07.60,Default,,0,0,0,,Dimaag kehta hai,
Dialogue: 0,0:05:07.60,0:05:08.99,Default,,0,0,0,,kuch ho hi nahi raha.
Dialogue: 0,0:05:09.44,0:05:10.96,Default,,0,0,0,,Bhai ka logic bhi yahi tha.
Dialogue: 0,0:05:10.96,0:05:11.73,Default,,0,0,0,,Usne kaha,
Dialogue: 0,0:05:11.73,0:05:13.25,Default,,0,0,0,,jab kuch mil hi nahi raha,
Dialogue: 0,0:05:13.25,0:05:14.40,Default,,0,0,0,,toh paisa kyun daalun?
Dialogue: 0,0:05:14.40,0:05:16.11,Default,,0,0,0,,Isse achha FD mein daal deta
Dialogue: 0,0:05:16.11,0:05:16.30,Default,,0,0,0,,hoon,
Dialogue: 0,0:05:16.30,0:05:17.06,Default,,0,0,0,,Papa bhi khush.
Dialogue: 0,0:05:17.06,0:05:18.97,Default,,0,0,0,,Sunne mein yeh logic bilkul sahi
Dialogue: 0,0:05:18.97,0:05:19.54,Default,,0,0,0,,lagta hai.
Dialogue: 0,0:05:19.54,0:05:21.45,Default,,0,0,0,,Lekin isme ek chhupi hui galti
Dialogue: 0,0:05:21.45,0:05:21.64,Default,,0,0,0,,hai.
Dialogue: 0,0:05:22.09,0:05:23.87,Default,,0,0,0,,Galti yeh hai ki flat market
Dialogue: 0,0:05:23.87,0:05:26.31,Default,,0,0,0,,mein bhi aapke 500 rupaye ruke
Dialogue: 0,0:05:26.31,0:05:26.98,Default,,0,0,0,,nahi hain.
Dialogue: 0,0:05:26.98,0:05:28.76,Default,,0,0,0,,Woh units khareed rahe hain,
Dialogue: 0,0:05:28.76,0:05:30.76,Default,,0,0,0,,aur girte daam par zyaada units.
Dialogue: 0,0:05:30.76,0:05:32.99,Default,,0,0,0,,Agar aur jab market aage chalta
Dialogue: 0,0:05:32.99,0:05:33.21,Default,,0,0,0,,hai,
Dialogue: 0,0:05:33.21,0:05:35.65,Default,,0,0,0,,yahi sasti units sabse zyaada kaam
Dialogue: 0,0:05:35.65,0:05:36.32,Default,,0,0,0,,aati hain.
Dialogue: 0,0:05:36.32,0:05:38.10,Default,,0,0,0,,Band karne waale ke paas yeh
Dialogue: 0,0:05:38.10,0:05:39.21,Default,,0,0,0,,hoti hi nahi.
Dialogue: 0,0:05:39.66,0:05:41.26,Default,,0,0,0,,Ab compounding samajhiye.
Dialogue: 0,0:05:41.26,0:05:43.08,Default,,0,0,0,,Compounding yaani byaaj par byaaj,
Dialogue: 0,0:05:43.08,0:05:44.45,Default,,0,0,0,,ya return par return.
Dialogue: 0,0:05:44.45,0:05:46.27,Default,,0,0,0,,Yeh tabhi kaam karti hai jab
Dialogue: 0,0:05:46.27,0:05:48.78,Default,,0,0,0,,paisa lambe samay tak bina toote
Dialogue: 0,0:05:48.78,0:05:49.69,Default,,0,0,0,,pada rahe.
Dialogue: 0,0:05:49.69,0:05:50.38,Default,,0,0,0,,SIP band ki,
Dialogue: 0,0:05:50.38,0:05:52.20,Default,,0,0,0,,toh compounding ki chain toot gayi.
Dialogue: 0,0:05:52.20,0:05:54.48,Default,,0,0,0,,Aur toota hua samay wapas nahi
Dialogue: 0,0:05:54.48,0:05:54.94,Default,,0,0,0,,aata.
Dialogue: 0,0:05:55.39,0:05:57.73,Default,,0,0,0,,Socho ek ladka har mahine gym
Dialogue: 0,0:05:57.73,0:05:58.44,Default,,0,0,0,,jaata hai,
Dialogue: 0,0:05:58.44,0:06:00.08,Default,,0,0,0,,par body nahi banti.
Dialogue: 0,0:06:00.08,0:06:02.19,Default,,0,0,0,,Kuch mahine baad woh chhod deta
Dialogue: 0,0:06:02.19,0:06:02.42,Default,,0,0,0,,hai.
Dialogue: 0,0:06:02.42,0:06:04.77,Default,,0,0,0,,Aur jis mahine se body banni
Dialogue: 0,0:06:04.77,0:06:05.71,Default,,0,0,0,,shuru hoti,
Dialogue: 0,0:06:05.71,0:06:07.35,Default,,0,0,0,,woh wahan hai hi nahi.
Dialogue: 0,0:06:07.35,0:06:09.22,Default,,0,0,0,,SIP band karna bhi waisa hi
Dialogue: 0,0:06:09.22,0:06:09.46,Default,,0,0,0,,hai.
Dialogue: 0,0:06:09.46,0:06:10.86,Default,,0,0,0,,Mehnat ke din jhele,
Dialogue: 0,0:06:10.86,0:06:12.27,Default,,0,0,0,,aur fal ke din aap gayab.
Dialogue: 0,0:06:12.72,0:06:14.64,Default,,0,0,0,,Lekin yahan bhi imaandaar baat.
Dialogue: 0,0:06:14.64,0:06:16.57,Default,,0,0,0,,Koi nahi keh sakta ki market
Dialogue: 0,0:06:16.57,0:06:17.42,Default,,0,0,0,,kab chalega.
Dialogue: 0,0:06:17.42,0:06:19.13,Default,,0,0,0,,Ho sakta hai flat samay aur
Dialogue: 0,0:06:19.13,0:06:19.99,Default,,0,0,0,,lamba chale.
Dialogue: 0,0:06:19.99,0:06:21.91,Default,,0,0,0,,Isiliye SIP sirf us paise se
Dialogue: 0,0:06:21.91,0:06:24.47,Default,,0,0,0,,karo jiski zaroorat jaldi na pade.
Dialogue: 0,0:06:24.47,0:06:26.61,Default,,0,0,0,,Tab aapko girte market mein bechna
Dialogue: 0,0:06:26.61,0:06:27.68,Default,,0,0,0,,nahi padega.
Dialogue: 0,0:06:28.13,0:06:29.35,Default,,0,0,0,,Ab teesra sawaal.
Dialogue: 0,0:06:29.35,0:06:31.78,Default,,0,0,0,,Aapke paise ko chupchaap kaun khata
Dialogue: 0,0:06:31.78,0:06:32.02,Default,,0,0,0,,hai?
Dialogue: 0,0:06:32.02,0:06:33.97,Default,,0,0,0,,Behen ne yahi poocha tha.
Dialogue: 0,0:06:33.97,0:06:34.21,Default,,0,0,0,,Bhaiya,
Dialogue: 0,0:06:34.21,0:06:36.40,Default,,0,0,0,,fund manager free mein kaam karta
Dialogue: 0,0:06:36.40,0:06:36.89,Default,,0,0,0,,hai kya?
Dialogue: 0,0:06:36.89,0:06:37.87,Default,,0,0,0,,Bilkul nahi.
Dialogue: 0,0:06:37.87,0:06:40.06,Default,,0,0,0,,Uski fees ka naam hai expense
Dialogue: 0,0:06:40.06,0:06:40.54,Default,,0,0,0,,ratio.
Dialogue: 0,0:06:40.54,0:06:42.25,Default,,0,0,0,,Aur yeh fees har saal lagti
Dialogue: 0,0:06:42.25,0:06:42.49,Default,,0,0,0,,hai.
Dialogue: 0,0:06:42.94,0:06:45.42,Default,,0,0,0,,Expense ratio yaani fund chalane ka
Dialogue: 0,0:06:45.42,0:06:46.46,Default,,0,0,0,,saalana kharcha.
Dialogue: 0,0:06:46.46,0:06:48.11,Default,,0,0,0,,Fund manager ki salary,
Dialogue: 0,0:06:48.11,0:06:48.73,Default,,0,0,0,,office,
Dialogue: 0,0:06:48.73,0:06:49.15,Default,,0,0,0,,research,
Dialogue: 0,0:06:49.15,0:06:50.39,Default,,0,0,0,,sab isme aata hai.
Dialogue: 0,0:06:50.39,0:06:52.05,Default,,0,0,0,,Yeh aapke bill mein alag se
Dialogue: 0,0:06:52.05,0:06:52.87,Default,,0,0,0,,nahi aata.
Dialogue: 0,0:06:52.87,0:06:54.53,Default,,0,0,0,,Yeh chupchaap fund ki value se
Dialogue: 0,0:06:54.53,0:06:55.36,Default,,0,0,0,,kat jaata hai.
Dialogue: 0,0:06:55.36,0:06:57.84,Default,,0,0,0,,Isliye zyaadatar log ise kabhi dekhte
Dialogue: 0,0:06:57.84,0:06:58.46,Default,,0,0,0,,hi nahi.
Dialogue: 0,0:06:58.91,0:07:00.37,Default,,0,0,0,,Kirana dukaan socho.
Dialogue: 0,0:07:00.37,0:07:02.25,Default,,0,0,0,,Shopkeeper har cheez par thoda sa
Dialogue: 0,0:07:02.25,0:07:03.29,Default,,0,0,0,,margin rakhta hai.
Dialogue: 0,0:07:03.29,0:07:05.38,Default,,0,0,0,,Ek saamaan par pata nahi chalta.
Dialogue: 0,0:07:05.38,0:07:07.04,Default,,0,0,0,,Par saal bhar ka hisaab jodo,
Dialogue: 0,0:07:07.04,0:07:09.13,Default,,0,0,0,,toh achhi khaasi rakam banti hai.
Dialogue: 0,0:07:09.13,0:07:11.22,Default,,0,0,0,,Expense ratio bhi aisa hi hai,
Dialogue: 0,0:07:11.22,0:07:12.26,Default,,0,0,0,,chhota dikhta hai,
Dialogue: 0,0:07:12.26,0:07:13.51,Default,,0,0,0,,par har saal lagta hai.
Dialogue: 0,0:07:13.96,0:07:15.88,Default,,0,0,0,,Aur yeh aapke poore jama paise
Dialogue: 0,0:07:15.88,0:07:16.65,Default,,0,0,0,,par lagta hai,
Dialogue: 0,0:07:16.65,0:07:18.56,Default,,0,0,0,,sirf naye 500 rupaye par nahi.
Dialogue: 0,0:07:18.56,0:07:20.68,Default,,0,0,0,,Jaise jaise corpus bada hota hai,
Dialogue: 0,0:07:20.68,0:07:22.40,Default,,0,0,0,,fees bhi badi hoti jaati hai.
Dialogue: 0,0:07:22.40,0:07:24.51,Default,,0,0,0,,Corpus yaani aapka kul jama paisa,
Dialogue: 0,0:07:24.51,0:07:25.28,Default,,0,0,0,,return ke saath.
Dialogue: 0,0:07:25.28,0:07:27.01,Default,,0,0,0,,Lambe samay mein yeh chhota farq
Dialogue: 0,0:07:27.01,0:07:28.16,Default,,0,0,0,,bada ban jaata hai.
Dialogue: 0,0:07:28.61,0:07:29.40,Default,,0,0,0,,Ab kaam ki baat.
Dialogue: 0,0:07:29.40,0:07:31.19,Default,,0,0,0,,Har fund ke direct aur regular
Dialogue: 0,0:07:31.19,0:07:31.98,Default,,0,0,0,,plan hote hain.
Dialogue: 0,0:07:31.98,0:07:33.77,Default,,0,0,0,,Regular plan mein beech mein agent
Dialogue: 0,0:07:33.77,0:07:35.36,Default,,0,0,0,,ya distributor hota hai,
Dialogue: 0,0:07:35.36,0:07:37.34,Default,,0,0,0,,uska commission bhi jud jaata hai.
Dialogue: 0,0:07:37.34,0:07:39.32,Default,,0,0,0,,Direct plan mein yeh commission nahi
Dialogue: 0,0:07:39.32,0:07:39.72,Default,,0,0,0,,hota.
Dialogue: 0,0:07:39.72,0:07:41.90,Default,,0,0,0,,Isliye direct plan ka expense ratio
Dialogue: 0,0:07:41.90,0:07:43.29,Default,,0,0,0,,aam taur par kam hota hai.
Dialogue: 0,0:07:43.74,0:07:45.26,Default,,0,0,0,,Aur ek chhupa kharcha hai,
Dialogue: 0,0:07:45.26,0:07:45.47,Default,,0,0,0,,tax.
Dialogue: 0,0:07:45.47,0:07:47.43,Default,,0,0,0,,Equity fund saal bhar se zyaada
Dialogue: 0,0:07:47.43,0:07:47.86,Default,,0,0,0,,rakha,
Dialogue: 0,0:07:47.86,0:07:50.03,Default,,0,0,0,,toh munafe ko long term capital
Dialogue: 0,0:07:50.03,0:07:50.89,Default,,0,0,0,,gain kehte hain.
Dialogue: 0,0:07:50.89,0:07:52.85,Default,,0,0,0,,Ispe 12.5 percent tax lagta hai.
Dialogue: 0,0:07:52.85,0:07:54.58,Default,,0,0,0,,Lekin har saal 1.25 lakh rupaye
Dialogue: 0,0:07:54.58,0:07:56.53,Default,,0,0,0,,tak ka aisa munafa tax se
Dialogue: 0,0:07:56.53,0:07:57.18,Default,,0,0,0,,chhoot mein hai.
Dialogue: 0,0:07:57.63,0:07:59.90,Default,,0,0,0,,500 rupaye ki SIP waale ko
Dialogue: 0,0:07:59.90,0:08:01.50,Default,,0,0,0,,yeh tax shuruaat mein shayad hi
Dialogue: 0,0:08:01.50,0:08:01.95,Default,,0,0,0,,lage.
Dialogue: 0,0:08:01.95,0:08:03.09,Default,,0,0,0,,Par jaankar rakhiye.
Dialogue: 0,0:08:03.09,0:08:05.37,Default,,0,0,0,,Return dekhte waqt hamesha socho,
Dialogue: 0,0:08:05.37,0:08:06.96,Default,,0,0,0,,kharcha aur tax ke baad haath
Dialogue: 0,0:08:06.96,0:08:08.10,Default,,0,0,0,,mein kya bachega.
Dialogue: 0,0:08:08.10,0:08:09.69,Default,,0,0,0,,Wahi asli return hai.
Dialogue: 0,0:08:09.69,0:08:11.51,Default,,0,0,0,,Baaki sab screen ki chamak hai.
Dialogue: 0,0:08:11.96,0:08:13.76,Default,,0,0,0,,Ab wapas dinner table par.
Dialogue: 0,0:08:13.76,0:08:14.66,Default,,0,0,0,,Bhai ne poocha,
Dialogue: 0,0:08:14.66,0:08:16.01,Default,,0,0,0,,toh kya FD bekaar hai?
Dialogue: 0,0:08:16.01,0:08:16.46,Default,,0,0,0,,Nahi.
Dialogue: 0,0:08:16.46,0:08:18.49,Default,,0,0,0,,Papa ki FD ki apni jagah
Dialogue: 0,0:08:18.49,0:08:18.71,Default,,0,0,0,,hai.
Dialogue: 0,0:08:18.71,0:08:20.29,Default,,0,0,0,,Emergency ka paisa,
Dialogue: 0,0:08:20.29,0:08:22.09,Default,,0,0,0,,jaldi chahiye waala paisa,
Dialogue: 0,0:08:22.09,0:08:22.99,Default,,0,0,0,,wahan theek hai.
Dialogue: 0,0:08:22.99,0:08:25.02,Default,,0,0,0,,Bank deposit par 5 lakh rupaye
Dialogue: 0,0:08:25.02,0:08:27.50,Default,,0,0,0,,tak ka insurance cover bhi hota
Dialogue: 0,0:08:27.50,0:08:27.72,Default,,0,0,0,,hai.
Dialogue: 0,0:08:28.17,0:08:29.92,Default,,0,0,0,,Sabse badi galti hai,
Dialogue: 0,0:08:29.92,0:08:30.91,Default,,0,0,0,,darr mein faisla.
Dialogue: 0,0:08:30.91,0:08:31.91,Default,,0,0,0,,Market gira,
Dialogue: 0,0:08:31.91,0:08:33.40,Default,,0,0,0,,news mein laal screen dikhi,
Dialogue: 0,0:08:33.40,0:08:34.15,Default,,0,0,0,,aur SIP band.
Dialogue: 0,0:08:34.15,0:08:35.40,Default,,0,0,0,,Phir market sambhla,
Dialogue: 0,0:08:35.40,0:08:37.14,Default,,0,0,0,,toh log upar ke daam par
Dialogue: 0,0:08:37.14,0:08:38.39,Default,,0,0,0,,wapas aate hain.
Dialogue: 0,0:08:38.39,0:08:39.88,Default,,0,0,0,,Yaani sasta chhod diya,
Dialogue: 0,0:08:39.88,0:08:41.13,Default,,0,0,0,,mehnga khareeda.
Dialogue: 0,0:08:41.13,0:08:43.37,Default,,0,0,0,,Yahi cheez SIP ko sabse zyaada
Dialogue: 0,0:08:43.37,0:08:44.37,Default,,0,0,0,,bigaadti hai.
Dialogue: 0,0:08:44.82,0:08:45.97,Default,,0,0,0,,Ek aur galti hai,
Dialogue: 0,0:08:45.97,0:08:47.80,Default,,0,0,0,,sirf pichhla return dekh kar fund
Dialogue: 0,0:08:47.80,0:08:48.25,Default,,0,0,0,,chunna.
Dialogue: 0,0:08:48.25,0:08:50.31,Default,,0,0,0,,Jo fund pichhle saal sabse upar
Dialogue: 0,0:08:50.31,0:08:50.54,Default,,0,0,0,,tha,
Dialogue: 0,0:08:50.54,0:08:52.83,Default,,0,0,0,,zaroori nahi aage bhi rahe.
Dialogue: 0,0:08:52.83,0:08:53.75,Default,,0,0,0,,Aur ek galti,
Dialogue: 0,0:08:53.75,0:08:54.66,Default,,0,0,0,,roz app kholna.
Dialogue: 0,0:08:54.66,0:08:55.58,Default,,0,0,0,,Roz khologe,
Dialogue: 0,0:08:55.58,0:08:56.95,Default,,0,0,0,,toh roz darr lagega.
Dialogue: 0,0:08:56.95,0:08:58.33,Default,,0,0,0,,SIP lambi race hai,
Dialogue: 0,0:08:58.33,0:08:59.70,Default,,0,0,0,,roz ka score nahi.
Dialogue: 0,0:09:00.15,0:09:01.01,Default,,0,0,0,,Toh kya karein?
Dialogue: 0,0:09:01.01,0:09:02.51,Default,,0,0,0,,Pehle emergency fund,
Dialogue: 0,0:09:02.51,0:09:02.93,Default,,0,0,0,,phir SIP.
Dialogue: 0,0:09:02.93,0:09:05.29,Default,,0,0,0,,SIP utni rakho jo bure mahine
Dialogue: 0,0:09:05.29,0:09:06.36,Default,,0,0,0,,mein bhi chal sake,
Dialogue: 0,0:09:06.36,0:09:08.50,Default,,0,0,0,,chahe 500 rupaye hi kyun na
Dialogue: 0,0:09:08.50,0:09:08.72,Default,,0,0,0,,ho.
Dialogue: 0,0:09:08.72,0:09:10.86,Default,,0,0,0,,Direct plan aur expense ratio check
Dialogue: 0,0:09:10.86,0:09:11.29,Default,,0,0,0,,karo.
Dialogue: 0,0:09:11.29,0:09:12.57,Default,,0,0,0,,Aur saal mein bas kuch baar
Dialogue: 0,0:09:12.57,0:09:13.43,Default,,0,0,0,,hisaab dekho,
Dialogue: 0,0:09:13.43,0:09:14.07,Default,,0,0,0,,roz nahi.
Dialogue: 0,0:09:14.52,0:09:16.05,Default,,0,0,0,,Aur jab salary badhe,
Dialogue: 0,0:09:16.05,0:09:17.59,Default,,0,0,0,,toh SIP bhi thodi badhao.
Dialogue: 0,0:09:17.59,0:09:19.34,Default,,0,0,0,,Ise step-up SIP kehte hain,
Dialogue: 0,0:09:19.34,0:09:21.09,Default,,0,0,0,,yaani har saal SIP ki rakam
Dialogue: 0,0:09:21.09,0:09:21.75,Default,,0,0,0,,badhana.
Dialogue: 0,0:09:21.75,0:09:22.62,Default,,0,0,0,,Bhai ne kaha,
Dialogue: 0,0:09:22.62,0:09:23.28,Default,,0,0,0,,theek hai bhaiya,
Dialogue: 0,0:09:23.28,0:09:24.60,Default,,0,0,0,,band nahi karunga.
Dialogue: 0,0:09:24.60,0:09:26.35,Default,,0,0,0,,Papa ne FD ki rasid rakh
Dialogue: 0,0:09:26.35,0:09:27.88,Default,,0,0,0,,kar halki si muskaan di.
Dialogue: 0,0:09:28.33,0:09:29.25,Default,,0,0,0,,Ek baat saaf kar doon.
Dialogue: 0,0:09:29.25,0:09:30.72,Default,,0,0,0,,Main kisi fund ka naam nahi
Dialogue: 0,0:09:30.72,0:09:31.27,Default,,0,0,0,,le raha,
Dialogue: 0,0:09:31.27,0:09:33.11,Default,,0,0,0,,aur kisi return ka vaada nahi
Dialogue: 0,0:09:33.11,0:09:33.66,Default,,0,0,0,,kar raha.
Dialogue: 0,0:09:33.66,0:09:35.13,Default,,0,0,0,,Market upar bhi jaata hai,
Dialogue: 0,0:09:35.13,0:09:35.68,Default,,0,0,0,,neeche bhi.
Dialogue: 0,0:09:35.68,0:09:37.52,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:09:37.52,0:09:38.80,Default,,0,0,0,,Apni zaroorat dekh kar,
Dialogue: 0,0:09:38.80,0:09:40.09,Default,,0,0,0,,samajh kar faisla kijiye.
Dialogue: 0,0:09:40.54,0:09:42.84,Default,,0,0,0,,Agle video mein baat karenge PPF
Dialogue: 0,0:09:42.84,0:09:43.53,Default,,0,0,0,,aur EPF ki,
Dialogue: 0,0:09:43.53,0:09:45.60,Default,,0,0,0,,jo Papa ko itne pasand hain.
