Dialogue: 0,0:00:00.00,0:00:02.56,Default,,0,0,0,,25,000 chuhe aur ek bhi bimari
Dialogue: 0,0:00:02.56,0:00:03.13,Default,,0,0,0,,nahi,
Dialogue: 0,0:00:03.13,0:00:05.12,Default,,0,0,0,,Deshnoke mein kya raaz hai?
Dialogue: 0,0:00:05.12,0:00:07.97,Default,,0,0,0,,Rajasthan ke ek chhote kasbe mein
Dialogue: 0,0:00:07.97,0:00:09.96,Default,,0,0,0,,ek anokha mandir hai.
Dialogue: 0,0:00:09.96,0:00:13.09,Default,,0,0,0,,Yahan chuhon ko bhagaaya nahi jaata,
Dialogue: 0,0:00:13.09,0:00:14.52,Default,,0,0,0,,khilaaya jaata hai.
Dialogue: 0,0:00:14.52,0:00:16.51,Default,,0,0,0,,Log unhe keede nahi,
Dialogue: 0,0:00:16.51,0:00:18.50,Default,,0,0,0,,apne purvaj maante hain.
Dialogue: 0,0:00:18.50,0:00:20.78,Default,,0,0,0,,Aur yahi baat duniya bhar ko
Dialogue: 0,0:00:20.78,0:00:22.20,Default,,0,0,0,,hairaan karti hai.
Dialogue: 0,0:00:22.65,0:00:25.58,Default,,0,0,0,,Yeh hai Karni Mata ka mandir,
Dialogue: 0,0:00:25.58,0:00:27.20,Default,,0,0,0,,Bikaner ke paas,
Dialogue: 0,0:00:27.20,0:00:28.51,Default,,0,0,0,,Deshnoke mein.
Dialogue: 0,0:00:28.51,0:00:31.11,Default,,0,0,0,,Safed sangemarmar ka farsh,
Dialogue: 0,0:00:31.11,0:00:34.04,Default,,0,0,0,,aur us par daudte kaale chuhe.
Dialogue: 0,0:00:34.04,0:00:35.34,Default,,0,0,0,,Bhakt nange paanv,
Dialogue: 0,0:00:35.34,0:00:37.94,Default,,0,0,0,,bahut sambhal kar chalte hain.
Dialogue: 0,0:00:37.94,0:00:41.19,Default,,0,0,0,,Har kadam par neeche dekhna padta
Dialogue: 0,0:00:41.19,0:00:41.52,Default,,0,0,0,,hai.
Dialogue: 0,0:00:41.52,0:00:44.77,Default,,0,0,0,,Kyunki yahan farsh ke asli mehmaan
Dialogue: 0,0:00:44.77,0:00:46.07,Default,,0,0,0,,insaan nahi,
Dialogue: 0,0:00:46.07,0:00:47.05,Default,,0,0,0,,chuhe hain.
Dialogue: 0,0:00:47.50,0:00:49.66,Default,,0,0,0,,Lekin asli sawal yeh hai.
Dialogue: 0,0:00:49.66,0:00:50.74,Default,,0,0,0,,Itne chuhe,
Dialogue: 0,0:00:50.74,0:00:51.55,Default,,0,0,0,,itni bheed,
Dialogue: 0,0:00:51.55,0:00:53.99,Default,,0,0,0,,phir bimari ka dar kyon nahi?
Dialogue: 0,0:00:53.99,0:00:55.07,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:00:55.07,0:00:56.96,Default,,0,0,0,,yeh Mata ki kripa hai.
Dialogue: 0,0:00:56.96,0:00:58.31,Default,,0,0,0,,Doctor kehte hain,
Dialogue: 0,0:00:58.31,0:01:01.55,Default,,0,0,0,,chuhe khatarnak keetanu le kar chalte
Dialogue: 0,0:01:01.55,0:01:01.82,Default,,0,0,0,,hain.
Dialogue: 0,0:01:01.82,0:01:03.72,Default,,0,0,0,,Aaj hum yeh sab sabut ke
Dialogue: 0,0:01:03.72,0:01:04.80,Default,,0,0,0,,saath parkhenge,
Dialogue: 0,0:01:04.80,0:01:05.88,Default,,0,0,0,,bina mazaak,
Dialogue: 0,0:01:05.88,0:01:07.50,Default,,0,0,0,,bina faisla sunaaye.
Dialogue: 0,0:01:07.95,0:01:10.82,Default,,0,0,0,,Kahani kai sadiyon pehle ki hai,
Dialogue: 0,0:01:10.82,0:01:13.68,Default,,0,0,0,,Rajasthan ke tapte registaan ki.
Dialogue: 0,0:01:13.68,0:01:15.40,Default,,0,0,0,,Wahan ek sant stree thi,
Dialogue: 0,0:01:15.40,0:01:18.27,Default,,0,0,0,,jinhe log Karni Mata kehte hain.
Dialogue: 0,0:01:18.27,0:01:19.42,Default,,0,0,0,,Charan samaj,
Dialogue: 0,0:01:19.42,0:01:23.14,Default,,0,0,0,,yaani Rajasthan ka ek purana samudaay,
Dialogue: 0,0:01:23.14,0:01:25.72,Default,,0,0,0,,unse gehri aastha rakhta hai.
Dialogue: 0,0:01:25.72,0:01:28.59,Default,,0,0,0,,Unke liye yeh sirf kahani nahi,
Dialogue: 0,0:01:28.59,0:01:30.31,Default,,0,0,0,,apne ghar ki yaad hai.
Dialogue: 0,0:01:30.76,0:01:31.74,Default,,0,0,0,,Ab socho,
Dialogue: 0,0:01:31.74,0:01:33.37,Default,,0,0,0,,ek kachcha aangan,
Dialogue: 0,0:01:33.37,0:01:34.35,Default,,0,0,0,,shaam ka waqt.
Dialogue: 0,0:01:34.35,0:01:36.96,Default,,0,0,0,,Ek daadi bachchon ko gher kar
Dialogue: 0,0:01:36.96,0:01:37.94,Default,,0,0,0,,baithi hai.
Dialogue: 0,0:01:37.94,0:01:39.24,Default,,0,0,0,,Woh kehti hai,
Dialogue: 0,0:01:39.24,0:01:42.18,Default,,0,0,0,,ek baar Mata ke parivaar par
Dialogue: 0,0:01:42.18,0:01:43.48,Default,,0,0,0,,bada dukh aaya.
Dialogue: 0,0:01:43.48,0:01:46.09,Default,,0,0,0,,Mata ne haar nahi maani.
Dialogue: 0,0:01:46.09,0:01:48.70,Default,,0,0,0,,Woh seedhe Yamraj ke paas gayin,
Dialogue: 0,0:01:48.70,0:01:51.64,Default,,0,0,0,,yaani mrityu ke devta ke paas.
Dialogue: 0,0:01:52.09,0:01:54.13,Default,,0,0,0,,Kahani ke mutabik,
Dialogue: 0,0:01:54.13,0:01:55.87,Default,,0,0,0,,wahan ek saudha hua.
Dialogue: 0,0:01:55.87,0:01:58.20,Default,,0,0,0,,Mata ke vansh ke log marne
Dialogue: 0,0:01:58.20,0:02:00.82,Default,,0,0,0,,ke baad kahin bhatkenge nahi.
Dialogue: 0,0:02:00.82,0:02:03.15,Default,,0,0,0,,Woh chuhe ban kar Mata ke
Dialogue: 0,0:02:03.15,0:02:04.61,Default,,0,0,0,,paas hi rahenge.
Dialogue: 0,0:02:04.61,0:02:06.06,Default,,0,0,0,,Isi mandir mein,
Dialogue: 0,0:02:06.06,0:02:07.52,Default,,0,0,0,,isi aangan mein.
Dialogue: 0,0:02:07.52,0:02:10.13,Default,,0,0,0,,Daadi muskura kar kehti hai,
Dialogue: 0,0:02:10.13,0:02:13.92,Default,,0,0,0,,isiliye yahan ke chuhe hamare apne
Dialogue: 0,0:02:13.92,0:02:14.21,Default,,0,0,0,,hain.
Dialogue: 0,0:02:14.66,0:02:17.32,Default,,0,0,0,,In chuhon ko yahan kaba kehte
Dialogue: 0,0:02:17.32,0:02:17.59,Default,,0,0,0,,hain.
Dialogue: 0,0:02:17.59,0:02:19.99,Default,,0,0,0,,Kaba yaani pavitra chuhe,
Dialogue: 0,0:02:19.99,0:02:22.65,Default,,0,0,0,,jinhe log apne purvaj maante hain.
Dialogue: 0,0:02:22.65,0:02:25.31,Default,,0,0,0,,Purvaj yaani hamare baap dada,
Dialogue: 0,0:02:25.31,0:02:27.44,Default,,0,0,0,,jo hamse pehle jee chuke.
Dialogue: 0,0:02:27.44,0:02:27.98,Default,,0,0,0,,Socho,
Dialogue: 0,0:02:27.98,0:02:30.37,Default,,0,0,0,,jise duniya chuha kehti hai,
Dialogue: 0,0:02:30.37,0:02:33.04,Default,,0,0,0,,woh kisi ke pardada ho sakte
Dialogue: 0,0:02:33.04,0:02:33.30,Default,,0,0,0,,hain.
Dialogue: 0,0:02:33.30,0:02:36.50,Default,,0,0,0,,Isiliye yahan koi unhe nahi maarta.
Dialogue: 0,0:02:36.95,0:02:38.53,Default,,0,0,0,,Ab ek baat saaf kar dein,
Dialogue: 0,0:02:38.53,0:02:39.85,Default,,0,0,0,,imaandari se.
Dialogue: 0,0:02:39.85,0:02:42.50,Default,,0,0,0,,Yeh kahani kisi likhit granth se
Dialogue: 0,0:02:42.50,0:02:43.02,Default,,0,0,0,,nahi,
Dialogue: 0,0:02:43.02,0:02:45.66,Default,,0,0,0,,local parampara se aati hai.
Dialogue: 0,0:02:45.66,0:02:47.25,Default,,0,0,0,,Yeh peedhi dar peedhi,
Dialogue: 0,0:02:47.25,0:02:49.10,Default,,0,0,0,,zubaani chalti aayi hai.
Dialogue: 0,0:02:49.10,0:02:51.48,Default,,0,0,0,,Isliye is panel par label hai
Dialogue: 0,0:02:51.48,0:02:52.00,Default,,0,0,0,,legend.
Dialogue: 0,0:02:52.00,0:02:53.85,Default,,0,0,0,,Iska matlab jhooth nahi,
Dialogue: 0,0:02:53.85,0:02:56.76,Default,,0,0,0,,bas itna ki likhit sabut hamare
Dialogue: 0,0:02:56.76,0:02:57.55,Default,,0,0,0,,paas nahi.
Dialogue: 0,0:02:58.00,0:03:00.20,Default,,0,0,0,,Ab kahani se nikal kar patthar
Dialogue: 0,0:03:00.20,0:03:01.08,Default,,0,0,0,,par aate hain.
Dialogue: 0,0:03:01.08,0:03:02.85,Default,,0,0,0,,Jo mandir aaj aap dekhte ho,
Dialogue: 0,0:03:02.85,0:03:04.83,Default,,0,0,0,,woh bahut purana nahi hai.
Dialogue: 0,0:03:04.83,0:03:06.81,Default,,0,0,0,,Rajasthan Tourism ke mutabik,
Dialogue: 0,0:03:06.81,0:03:09.23,Default,,0,0,0,,iska nirmaan pichhli sadi ki shuruaat
Dialogue: 0,0:03:09.23,0:03:10.12,Default,,0,0,0,,mein poora hua.
Dialogue: 0,0:03:10.12,0:03:12.76,Default,,0,0,0,,Yeh kaam Bikaner ke Maharaja Ganga
Dialogue: 0,0:03:12.76,0:03:14.08,Default,,0,0,0,,Singh ki dekh rekh mein hua.
Dialogue: 0,0:03:14.53,0:03:18.00,Default,,0,0,0,,Poora mandir sangemarmar se bana hai,
Dialogue: 0,0:03:18.00,0:03:19.74,Default,,0,0,0,,upar se neeche tak.
Dialogue: 0,0:03:19.74,0:03:22.93,Default,,0,0,0,,Iski banawat mein Rajput shaili hai,
Dialogue: 0,0:03:22.93,0:03:25.53,Default,,0,0,0,,aur Mughal shaili ki jhalak bhi.
Dialogue: 0,0:03:25.53,0:03:28.43,Default,,0,0,0,,Shaili yaani banane ka andaaz,
Dialogue: 0,0:03:28.43,0:03:29.58,Default,,0,0,0,,jaise mehraab,
Dialogue: 0,0:03:29.58,0:03:31.32,Default,,0,0,0,,jaali aur nakkashi.
Dialogue: 0,0:03:31.32,0:03:34.21,Default,,0,0,0,,Alag alag zamaane ka hunar,
Dialogue: 0,0:03:34.21,0:03:36.53,Default,,0,0,0,,ek hi deewar par dikhta hai.
Dialogue: 0,0:03:36.98,0:03:39.78,Default,,0,0,0,,Mandir mein ghuste hi aankh darwaazon
Dialogue: 0,0:03:39.78,0:03:41.45,Default,,0,0,0,,par atak jaati hai.
Dialogue: 0,0:03:41.45,0:03:43.97,Default,,0,0,0,,Yeh thos chaandi ke darwaaze hain.
Dialogue: 0,0:03:43.97,0:03:47.04,Default,,0,0,0,,Inke panel par ubhri hui nakkashi
Dialogue: 0,0:03:47.04,0:03:47.32,Default,,0,0,0,,hai.
Dialogue: 0,0:03:47.32,0:03:50.39,Default,,0,0,0,,Ubhri nakkashi yaani aisi tasveer,
Dialogue: 0,0:03:50.39,0:03:52.91,Default,,0,0,0,,jo sateh se bahar uthi ho.
Dialogue: 0,0:03:52.91,0:03:55.70,Default,,0,0,0,,In tasveeron mein Karni Mata ki
Dialogue: 0,0:03:55.70,0:03:57.38,Default,,0,0,0,,kahaniyan khudi hain.
Dialogue: 0,0:03:57.83,0:04:01.99,Default,,0,0,0,,Yaani jo kahani daadi zubaani sunaati
Dialogue: 0,0:04:01.99,0:04:02.28,Default,,0,0,0,,hai,
Dialogue: 0,0:04:02.28,0:04:04.96,Default,,0,0,0,,wahi chaandi par bhi likhi hai.
Dialogue: 0,0:04:04.96,0:04:06.74,Default,,0,0,0,,Bas shabdon mein nahi,
Dialogue: 0,0:04:06.74,0:04:07.93,Default,,0,0,0,,tasveeron mein.
Dialogue: 0,0:04:07.93,0:04:10.60,Default,,0,0,0,,Kai bhakt darwaaze ke saamne ruk
Dialogue: 0,0:04:10.60,0:04:12.38,Default,,0,0,0,,kar sir jhukaate hain.
Dialogue: 0,0:04:12.38,0:04:14.46,Default,,0,0,0,,Kuch log har panel dhyaan se
Dialogue: 0,0:04:14.46,0:04:15.35,Default,,0,0,0,,dekhte hain,
Dialogue: 0,0:04:15.35,0:04:18.62,Default,,0,0,0,,jaise kisi kitaab ke panne palat
Dialogue: 0,0:04:18.62,0:04:19.51,Default,,0,0,0,,rahe hon.
Dialogue: 0,0:04:19.96,0:04:21.60,Default,,0,0,0,,Andar garbhgriha hai,
Dialogue: 0,0:04:21.60,0:04:24.59,Default,,0,0,0,,yaani mandir ka sabse andar wala
Dialogue: 0,0:04:24.59,0:04:25.96,Default,,0,0,0,,pavitra kamra.
Dialogue: 0,0:04:25.96,0:04:28.68,Default,,0,0,0,,Wahan Karni Mata ki patthar ki
Dialogue: 0,0:04:28.68,0:04:29.50,Default,,0,0,0,,murti hai.
Dialogue: 0,0:04:29.50,0:04:33.04,Default,,0,0,0,,Rajasthan Tourism ke anusaar iski oonchai
Dialogue: 0,0:04:33.04,0:04:34.68,Default,,0,0,0,,lagbhag 0.75 metre hai.
Dialogue: 0,0:04:34.68,0:04:37.13,Default,,0,0,0,,Matlab ek chhote bachche jitni.
Dialogue: 0,0:04:37.13,0:04:39.31,Default,,0,0,0,,Murti ke haath mein trishul hai,
Dialogue: 0,0:04:39.31,0:04:40.40,Default,,0,0,0,,sir par mukut.
Dialogue: 0,0:04:40.85,0:04:43.35,Default,,0,0,0,,Murti ke aas paas unki behnon
Dialogue: 0,0:04:43.35,0:04:45.01,Default,,0,0,0,,ki pratimaayein bhi hain.
Dialogue: 0,0:04:45.01,0:04:47.79,Default,,0,0,0,,Mukut aur maalaon se saji murti,
Dialogue: 0,0:04:47.79,0:04:50.01,Default,,0,0,0,,aur saamne bhakton ki qatar.
Dialogue: 0,0:04:50.01,0:04:50.84,Default,,0,0,0,,Aur yahin,
Dialogue: 0,0:04:50.84,0:04:52.23,Default,,0,0,0,,garbhgriha ke paas,
Dialogue: 0,0:04:52.23,0:04:54.45,Default,,0,0,0,,chuhe bhi jama rehte hain.
Dialogue: 0,0:04:54.45,0:04:56.95,Default,,0,0,0,,Aisa lagta hai jaise woh bhi
Dialogue: 0,0:04:56.95,0:04:59.45,Default,,0,0,0,,darshan ki line mein khade hon.
Dialogue: 0,0:04:59.90,0:05:01.20,Default,,0,0,0,,Ab upar dekhiye.
Dialogue: 0,0:05:01.20,0:05:03.79,Default,,0,0,0,,Aangan ke upar jaali lagi hai,
Dialogue: 0,0:05:03.79,0:05:05.08,Default,,0,0,0,,hifaazat ke liye.
Dialogue: 0,0:05:05.08,0:05:07.42,Default,,0,0,0,,Yeh jaali chuhon ko upar se
Dialogue: 0,0:05:07.42,0:05:10.27,Default,,0,0,0,,aane wale khatre se bachaati hai,
Dialogue: 0,0:05:10.27,0:05:12.34,Default,,0,0,0,,jaise shikari parinde.
Dialogue: 0,0:05:12.34,0:05:14.94,Default,,0,0,0,,Matlab mandir sirf chuhon ko sehta
Dialogue: 0,0:05:14.94,0:05:15.71,Default,,0,0,0,,nahi hai.
Dialogue: 0,0:05:15.71,0:05:18.82,Default,,0,0,0,,Woh unki hifaazat ka poora intezaam
Dialogue: 0,0:05:18.82,0:05:19.86,Default,,0,0,0,,bhi karta hai.
Dialogue: 0,0:05:20.31,0:05:22.94,Default,,0,0,0,,Ab mandir ke sabse bade raaz
Dialogue: 0,0:05:22.94,0:05:23.52,Default,,0,0,0,,ki baat.
Dialogue: 0,0:05:23.52,0:05:26.15,Default,,0,0,0,,Hazaron kaale chuhon ke beech,
Dialogue: 0,0:05:26.15,0:05:29.37,Default,,0,0,0,,kabhi kabhi ek safed chuha dikhta
Dialogue: 0,0:05:29.37,0:05:29.66,Default,,0,0,0,,hai.
Dialogue: 0,0:05:29.66,0:05:31.12,Default,,0,0,0,,Aur jab dikhta hai,
Dialogue: 0,0:05:31.12,0:05:33.75,Default,,0,0,0,,to aangan mein halchal mach jaati
Dialogue: 0,0:05:33.75,0:05:34.04,Default,,0,0,0,,hai.
Dialogue: 0,0:05:34.04,0:05:36.09,Default,,0,0,0,,Log ishaara karte hain,
Dialogue: 0,0:05:36.09,0:05:37.55,Default,,0,0,0,,phusphusaate hain.
Dialogue: 0,0:05:37.55,0:05:40.18,Default,,0,0,0,,Sabki nazar ek hi kone par
Dialogue: 0,0:05:40.18,0:05:41.35,Default,,0,0,0,,tik jaati hai.
Dialogue: 0,0:05:41.80,0:05:42.04,Default,,0,0,0,,Kyon?
Dialogue: 0,0:05:42.04,0:05:44.19,Default,,0,0,0,,Kyunki safed chuhon ko khaas taur
Dialogue: 0,0:05:44.19,0:05:46.34,Default,,0,0,0,,par pavitra maana jaata hai.
Dialogue: 0,0:05:46.34,0:05:48.25,Default,,0,0,0,,Rajasthan Tourism likhta hai,
Dialogue: 0,0:05:48.25,0:05:50.64,Default,,0,0,0,,log inhe Karni Mata aur unke
Dialogue: 0,0:05:50.64,0:05:52.80,Default,,0,0,0,,beton ka avatar maante hain.
Dialogue: 0,0:05:52.80,0:05:55.66,Default,,0,0,0,,Avatar yaani kisi devi devta ka
Dialogue: 0,0:05:55.66,0:05:57.10,Default,,0,0,0,,dharti par liya hua roop.
Dialogue: 0,0:05:57.10,0:06:00.20,Default,,0,0,0,,Isliye safed chuha dikhna bada saubhagya
Dialogue: 0,0:06:00.20,0:06:01.40,Default,,0,0,0,,maana jaata hai.
Dialogue: 0,0:06:01.85,0:06:04.86,Default,,0,0,0,,Bhakt unhe bahar bulaane ke liye
Dialogue: 0,0:06:04.86,0:06:06.96,Default,,0,0,0,,badi mehnat karte hain.
Dialogue: 0,0:06:06.96,0:06:08.46,Default,,0,0,0,,Mithai rakhte hain,
Dialogue: 0,0:06:08.46,0:06:11.47,Default,,0,0,0,,ghanton chupchaap intezaar karte hain.
Dialogue: 0,0:06:11.47,0:06:13.87,Default,,0,0,0,,Ek maa apne bete ka haath
Dialogue: 0,0:06:13.87,0:06:16.58,Default,,0,0,0,,pakad kar kone mein jhaankti hai.
Dialogue: 0,0:06:16.58,0:06:18.38,Default,,0,0,0,,Bas ek jhalak mil jaaye.
Dialogue: 0,0:06:18.38,0:06:21.09,Default,,0,0,0,,Unke liye yeh seedha Mata ka
Dialogue: 0,0:06:21.09,0:06:22.29,Default,,0,0,0,,aashirvaad hai.
Dialogue: 0,0:06:22.74,0:06:24.50,Default,,0,0,0,,Ab andaza lagaiye,
Dialogue: 0,0:06:24.50,0:06:26.56,Default,,0,0,0,,yahan kitne chuhe hain?
Dialogue: 0,0:06:26.56,0:06:28.92,Default,,0,0,0,,Ek anumaan ke mutabik,
Dialogue: 0,0:06:28.92,0:06:30.98,Default,,0,0,0,,lagbhag 25,000 kaale chuhe.
Dialogue: 0,0:06:30.98,0:06:34.21,Default,,0,0,0,,Inmein safed chuhe gine chune hi
Dialogue: 0,0:06:34.21,0:06:34.51,Default,,0,0,0,,hain.
Dialogue: 0,0:06:34.51,0:06:36.57,Default,,0,0,0,,To safed chuha dhoondhna,
Dialogue: 0,0:06:36.57,0:06:38.92,Default,,0,0,0,,bheed mein ek khaas chehra dhoondhne
Dialogue: 0,0:06:38.92,0:06:39.80,Default,,0,0,0,,jaisa hai.
Dialogue: 0,0:06:39.80,0:06:42.75,Default,,0,0,0,,Yahi rare hona use aur bhi
Dialogue: 0,0:06:42.75,0:06:45.10,Default,,0,0,0,,pavitra bana deta hai.
Dialogue: 0,0:06:45.55,0:06:47.48,Default,,0,0,0,,Ek baat science ki bhi.
Dialogue: 0,0:06:47.48,0:06:51.02,Default,,0,0,0,,Yahan ke kaale chuhe Rattus rattus
Dialogue: 0,0:06:51.02,0:06:51.34,Default,,0,0,0,,hain.
Dialogue: 0,0:06:51.34,0:06:54.24,Default,,0,0,0,,Yaani wahi aam kaala chuha,
Dialogue: 0,0:06:54.24,0:06:56.81,Default,,0,0,0,,jo ghar aur godaam mein milta
Dialogue: 0,0:06:56.81,0:06:57.13,Default,,0,0,0,,hai.
Dialogue: 0,0:06:57.13,0:07:00.03,Default,,0,0,0,,Koi anokhi jaati nahi hai.
Dialogue: 0,0:07:00.03,0:07:02.28,Default,,0,0,0,,Fark bas nazariye ka hai.
Dialogue: 0,0:07:02.28,0:07:05.82,Default,,0,0,0,,Baahar inhe dushman maana jaata hai,
Dialogue: 0,0:07:05.82,0:07:07.43,Default,,0,0,0,,yahan parivaar.
Dialogue: 0,0:07:07.88,0:07:09.04,Default,,0,0,0,,Ab woh sawal,
Dialogue: 0,0:07:09.04,0:07:11.36,Default,,0,0,0,,jiske liye shayad aap yeh video
Dialogue: 0,0:07:11.36,0:07:12.52,Default,,0,0,0,,dekh rahe ho.
Dialogue: 0,0:07:12.52,0:07:15.42,Default,,0,0,0,,Kya yahan sach mein bimari nahi
Dialogue: 0,0:07:15.42,0:07:16.00,Default,,0,0,0,,phailti?
Dialogue: 0,0:07:16.00,0:07:18.89,Default,,0,0,0,,Bhakton ka daava bahut bada hai.
Dialogue: 0,0:07:18.89,0:07:20.34,Default,,0,0,0,,Unka kehna hai,
Dialogue: 0,0:07:20.34,0:07:23.53,Default,,0,0,0,,yeh jagah plague se achhooti rahi.
Dialogue: 0,0:07:23.53,0:07:26.14,Default,,0,0,0,,Plague yaani woh mahamaari,
Dialogue: 0,0:07:26.14,0:07:28.75,Default,,0,0,0,,jo chuhon ke pissuon se phailti
Dialogue: 0,0:07:28.75,0:07:29.04,Default,,0,0,0,,hai.
Dialogue: 0,0:07:29.49,0:07:32.12,Default,,0,0,0,,Isse bhi chaunkane wala daava sun
Dialogue: 0,0:07:32.12,0:07:32.60,Default,,0,0,0,,lijiye.
Dialogue: 0,0:07:32.60,0:07:34.52,Default,,0,0,0,,Jis prasad ko chuhon ne chakh
Dialogue: 0,0:07:34.52,0:07:34.76,Default,,0,0,0,,liya,
Dialogue: 0,0:07:34.76,0:07:37.63,Default,,0,0,0,,use bahut pavitra maana jaata hai.
Dialogue: 0,0:07:37.63,0:07:38.59,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:07:38.59,0:07:40.98,Default,,0,0,0,,use khaane se koi nuksaan nahi
Dialogue: 0,0:07:40.98,0:07:41.46,Default,,0,0,0,,hota.
Dialogue: 0,0:07:41.46,0:07:43.86,Default,,0,0,0,,Yeh daava bahut logon ki aastha
Dialogue: 0,0:07:43.86,0:07:44.82,Default,,0,0,0,,se juda hai.
Dialogue: 0,0:07:44.82,0:07:46.97,Default,,0,0,0,,Hum ise halke mein nahi le
Dialogue: 0,0:07:46.97,0:07:47.45,Default,,0,0,0,,rahe.
Dialogue: 0,0:07:47.90,0:07:50.16,Default,,0,0,0,,Ab doosri taraf ki baat suniye.
Dialogue: 0,0:07:50.16,0:07:52.41,Default,,0,0,0,,Medical researchers kehte hain,
Dialogue: 0,0:07:52.41,0:07:55.42,Default,,0,0,0,,chuhe khatarnak pathogens le kar chalte
Dialogue: 0,0:07:55.42,0:07:55.67,Default,,0,0,0,,hain.
Dialogue: 0,0:07:55.67,0:07:58.43,Default,,0,0,0,,Pathogens yaani woh chhote keetanu,
Dialogue: 0,0:07:58.43,0:08:00.44,Default,,0,0,0,,jo bimari failaate hain.
Dialogue: 0,0:08:00.44,0:08:02.44,Default,,0,0,0,,Yeh baat duniya bhar ke chuhon
Dialogue: 0,0:08:02.44,0:08:03.95,Default,,0,0,0,,par laagu hoti hai.
Dialogue: 0,0:08:03.95,0:08:06.70,Default,,0,0,0,,Deshnoke ke chuhe bhi biology mein
Dialogue: 0,0:08:06.70,0:08:08.46,Default,,0,0,0,,wahi Rattus rattus hain.
Dialogue: 0,0:08:08.91,0:08:09.94,Default,,0,0,0,,To sach kya hai?
Dialogue: 0,0:08:09.94,0:08:11.23,Default,,0,0,0,,Seedhi baat suniye.
Dialogue: 0,0:08:11.23,0:08:13.81,Default,,0,0,0,,Is daave par koi verified study
Dialogue: 0,0:08:13.81,0:08:15.09,Default,,0,0,0,,maujood nahi hai.
Dialogue: 0,0:08:15.09,0:08:17.15,Default,,0,0,0,,Na yeh sabit hua ki yahan
Dialogue: 0,0:08:17.15,0:08:19.47,Default,,0,0,0,,bimari bilkul nahi hoti.
Dialogue: 0,0:08:19.47,0:08:21.54,Default,,0,0,0,,Na yeh sabit hua ki yahan
Dialogue: 0,0:08:21.54,0:08:23.60,Default,,0,0,0,,bimari zyada failti hai.
Dialogue: 0,0:08:23.60,0:08:24.37,Default,,0,0,0,,Daave hain,
Dialogue: 0,0:08:24.37,0:08:26.43,Default,,0,0,0,,par napa hua data nahi.
Dialogue: 0,0:08:26.88,0:08:29.59,Default,,0,0,0,,Yahan ek fark samajhna zaroori hai.
Dialogue: 0,0:08:29.59,0:08:31.31,Default,,0,0,0,,Bimari nahi hoti,
Dialogue: 0,0:08:31.31,0:08:33.77,Default,,0,0,0,,aur bimari ka record nahi hai,
Dialogue: 0,0:08:33.77,0:08:35.24,Default,,0,0,0,,yeh alag baatein hain.
Dialogue: 0,0:08:35.24,0:08:37.70,Default,,0,0,0,,Kabhi kabhi hum record ki kami
Dialogue: 0,0:08:37.70,0:08:39.67,Default,,0,0,0,,ko hi sabut maan lete hain.
Dialogue: 0,0:08:39.67,0:08:42.62,Default,,0,0,0,,Lekin khaali register kuch sabit nahi
Dialogue: 0,0:08:42.62,0:08:43.12,Default,,0,0,0,,karta.
Dialogue: 0,0:08:43.12,0:08:45.33,Default,,0,0,0,,Woh bas batata hai ki kisi
Dialogue: 0,0:08:45.33,0:08:46.56,Default,,0,0,0,,ne gina nahi.
Dialogue: 0,0:08:47.01,0:08:49.34,Default,,0,0,0,,Researchers ek khaas cheez ki kami
Dialogue: 0,0:08:49.34,0:08:50.38,Default,,0,0,0,,batate hain.
Dialogue: 0,0:08:50.38,0:08:52.71,Default,,0,0,0,,Epidemiological study,
Dialogue: 0,0:08:52.71,0:08:55.56,Default,,0,0,0,,yaani bade paimane par logon ki
Dialogue: 0,0:08:55.56,0:08:56.85,Default,,0,0,0,,sehat ka hisaab.
Dialogue: 0,0:08:56.85,0:08:57.89,Default,,0,0,0,,Kitne log aaye,
Dialogue: 0,0:08:57.89,0:08:59.44,Default,,0,0,0,,kitne beemar pade,
Dialogue: 0,0:08:59.44,0:09:00.74,Default,,0,0,0,,aur kis wajah se.
Dialogue: 0,0:09:00.74,0:09:03.85,Default,,0,0,0,,Aisa systematic adhyayan is mandir par
Dialogue: 0,0:09:03.85,0:09:04.88,Default,,0,0,0,,hua hi nahi.
Dialogue: 0,0:09:04.88,0:09:07.73,Default,,0,0,0,,Isliye vigyan abhi koi faisla nahi
Dialogue: 0,0:09:07.73,0:09:08.77,Default,,0,0,0,,suna sakta.
Dialogue: 0,0:09:09.22,0:09:11.40,Default,,0,0,0,,Isliye is panel par label hai
Dialogue: 0,0:09:11.40,0:09:12.12,Default,,0,0,0,,disputed.
Dialogue: 0,0:09:12.12,0:09:14.54,Default,,0,0,0,,Matlab bhakt aur experts alag alag
Dialogue: 0,0:09:14.54,0:09:15.51,Default,,0,0,0,,baat kehte hain.
Dialogue: 0,0:09:15.51,0:09:17.44,Default,,0,0,0,,Bhakt aastha ki baat karte hain.
Dialogue: 0,0:09:17.44,0:09:19.86,Default,,0,0,0,,Doctor saavdhani ki baat karte hain.
Dialogue: 0,0:09:19.86,0:09:21.79,Default,,0,0,0,,Aur beech mein woh khaali jagah
Dialogue: 0,0:09:21.79,0:09:22.03,Default,,0,0,0,,hai,
Dialogue: 0,0:09:22.03,0:09:24.21,Default,,0,0,0,,jahan sabut hona chahiye tha,
Dialogue: 0,0:09:24.21,0:09:25.66,Default,,0,0,0,,par abhi nahi hai.
Dialogue: 0,0:09:26.11,0:09:27.80,Default,,0,0,0,,Agar aap jaate ho,
Dialogue: 0,0:09:27.80,0:09:30.63,Default,,0,0,0,,to doctor wali saavdhani bhi saath
Dialogue: 0,0:09:30.63,0:09:31.19,Default,,0,0,0,,le jaiye.
Dialogue: 0,0:09:31.19,0:09:32.60,Default,,0,0,0,,Haath achhe se dhoiye,
Dialogue: 0,0:09:32.60,0:09:34.30,Default,,0,0,0,,chot ho to dhyaan rakhiye,
Dialogue: 0,0:09:34.30,0:09:36.27,Default,,0,0,0,,bachchon par nazar rakhiye.
Dialogue: 0,0:09:36.27,0:09:38.82,Default,,0,0,0,,Yeh aastha ke khilaaf nahi hai.
Dialogue: 0,0:09:38.82,0:09:41.92,Default,,0,0,0,,Yeh bas apni sehat ki zimmedari
Dialogue: 0,0:09:41.92,0:09:42.20,Default,,0,0,0,,hai.
Dialogue: 0,0:09:42.20,0:09:43.90,Default,,0,0,0,,Mata ka darshan bhi,
Dialogue: 0,0:09:43.90,0:09:45.31,Default,,0,0,0,,aur apna khayal bhi.
Dialogue: 0,0:09:45.76,0:09:46.68,Default,,0,0,0,,Ab woh baatein,
Dialogue: 0,0:09:46.68,0:09:48.53,Default,,0,0,0,,jo aaj bhi koi nahi jaanta.
Dialogue: 0,0:09:48.53,0:09:49.45,Default,,0,0,0,,Sabse pehle,
Dialogue: 0,0:09:49.45,0:09:51.76,Default,,0,0,0,,yeh chuhe kitni tezi se marte
Dialogue: 0,0:09:51.76,0:09:51.99,Default,,0,0,0,,hain?
Dialogue: 0,0:09:51.99,0:09:53.15,Default,,0,0,0,,Unki mrityu dar,
Dialogue: 0,0:09:53.15,0:09:55.46,Default,,0,0,0,,yaani kitne chuhe har saal marte
Dialogue: 0,0:09:55.46,0:09:55.69,Default,,0,0,0,,hain,
Dialogue: 0,0:09:55.69,0:09:57.76,Default,,0,0,0,,kabhi theek se napi nahi gayi.
Dialogue: 0,0:09:57.76,0:10:00.30,Default,,0,0,0,,Itni badi colony ka yeh hisaab
Dialogue: 0,0:10:00.30,0:10:01.92,Default,,0,0,0,,kisi ke paas nahi hai.
Dialogue: 0,0:10:02.37,0:10:04.36,Default,,0,0,0,,Phir sawal parjeeviyon ka.
Dialogue: 0,0:10:04.36,0:10:06.91,Default,,0,0,0,,Parjeevi yaani parasites,
Dialogue: 0,0:10:06.91,0:10:08.90,Default,,0,0,0,,jaise pissu aur keede,
Dialogue: 0,0:10:08.90,0:10:11.17,Default,,0,0,0,,jo doosre jeev par palte hain.
Dialogue: 0,0:10:11.17,0:10:14.29,Default,,0,0,0,,Yahi cheez bimari ka khatra badha
Dialogue: 0,0:10:14.29,0:10:15.43,Default,,0,0,0,,bhi sakti hai,
Dialogue: 0,0:10:15.43,0:10:17.13,Default,,0,0,0,,ghata bhi sakti hai.
Dialogue: 0,0:10:17.13,0:10:19.97,Default,,0,0,0,,Par in chuhon par kitne parjeevi
Dialogue: 0,0:10:19.97,0:10:20.25,Default,,0,0,0,,hain,
Dialogue: 0,0:10:20.25,0:10:23.09,Default,,0,0,0,,iska koi napa hua record nahi.
Dialogue: 0,0:10:23.54,0:10:26.31,Default,,0,0,0,,Aur sabse dilchasp sawal yeh hai.
Dialogue: 0,0:10:26.31,0:10:29.08,Default,,0,0,0,,Chuhe mandir chhod kar bahar kyon
Dialogue: 0,0:10:29.08,0:10:30.31,Default,,0,0,0,,nahi jaate?
Dialogue: 0,0:10:30.31,0:10:33.08,Default,,0,0,0,,Aas paas registaani kasba hai,
Dialogue: 0,0:10:33.08,0:10:34.61,Default,,0,0,0,,khula aur bada.
Dialogue: 0,0:10:34.61,0:10:38.00,Default,,0,0,0,,Phir bhi colony zyadatar mandir mein
Dialogue: 0,0:10:38.00,0:10:39.23,Default,,0,0,0,,hi rehti hai.
Dialogue: 0,0:10:39.23,0:10:42.30,Default,,0,0,0,,Bhakt ise Mata ka bandhan kehte
Dialogue: 0,0:10:42.30,0:10:42.61,Default,,0,0,0,,hain.
Dialogue: 0,0:10:42.61,0:10:45.38,Default,,0,0,0,,Vigyan ke paas sirf andaze hain.
Dialogue: 0,0:10:45.83,0:10:47.34,Default,,0,0,0,,Ek andaza hai,
Dialogue: 0,0:10:47.34,0:10:49.15,Default,,0,0,0,,roz ka bharpoor khaana.
Dialogue: 0,0:10:49.15,0:10:51.86,Default,,0,0,0,,Mithai aur prasad sab yahin mil
Dialogue: 0,0:10:51.86,0:10:52.77,Default,,0,0,0,,jaata hai,
Dialogue: 0,0:10:52.77,0:10:54.58,Default,,0,0,0,,to bahar kyon jaana?
Dialogue: 0,0:10:54.58,0:10:58.20,Default,,0,0,0,,Ek aur andaza hai social habituation.
Dialogue: 0,0:10:58.20,0:11:01.52,Default,,0,0,0,,Yaani jaanwar ek jagah aur insaanon
Dialogue: 0,0:11:01.52,0:11:03.63,Default,,0,0,0,,ke aadi ho jaate hain.
Dialogue: 0,0:11:03.63,0:11:05.74,Default,,0,0,0,,Par yeh sab andaze hain,
Dialogue: 0,0:11:05.74,0:11:07.55,Default,,0,0,0,,abhi sabit nahi.
Dialogue: 0,0:11:08.00,0:11:09.01,Default,,0,0,0,,To dekhiye,
Dialogue: 0,0:11:09.01,0:11:11.71,Default,,0,0,0,,kahani ke paas jawab hai,
Dialogue: 0,0:11:11.71,0:11:13.74,Default,,0,0,0,,vigyan ke paas sawal.
Dialogue: 0,0:11:13.74,0:11:16.78,Default,,0,0,0,,Aur yahi is jagah ko itna
Dialogue: 0,0:11:16.78,0:11:18.47,Default,,0,0,0,,khaas banata hai.
Dialogue: 0,0:11:18.47,0:11:19.48,Default,,0,0,0,,Ek mandir,
Dialogue: 0,0:11:19.48,0:11:23.19,Default,,0,0,0,,jahan aastha aur science aamne saamne
Dialogue: 0,0:11:23.19,0:11:24.21,Default,,0,0,0,,khade hain.
Dialogue: 0,0:11:24.21,0:11:26.91,Default,,0,0,0,,Aur beech mein hazaron chuhe,
Dialogue: 0,0:11:26.91,0:11:27.92,Default,,0,0,0,,bekhabar,
Dialogue: 0,0:11:27.92,0:11:30.96,Default,,0,0,0,,aaraam se prasad kha rahe hain.
Dialogue: 0,0:11:31.41,0:11:34.18,Default,,0,0,0,,Agar aap Deshnoke jaana chahte ho,
Dialogue: 0,0:11:34.18,0:11:36.20,Default,,0,0,0,,to yeh Bikaner ke paas hai.
Dialogue: 0,0:11:36.20,0:11:38.98,Default,,0,0,0,,Rajasthan Tourism ki website par is
Dialogue: 0,0:11:38.98,0:11:41.24,Default,,0,0,0,,mandir ki jaankari maujood hai.
Dialogue: 0,0:11:41.24,0:11:44.02,Default,,0,0,0,,Pahunch kar pehle chaandi ke darwaaze
Dialogue: 0,0:11:44.02,0:11:44.52,Default,,0,0,0,,dekhiye.
Dialogue: 0,0:11:44.52,0:11:46.54,Default,,0,0,0,,Har panel ek kahani hai.
Dialogue: 0,0:11:46.54,0:11:47.80,Default,,0,0,0,,Ruk kar dekhoge,
Dialogue: 0,0:11:47.80,0:11:50.57,Default,,0,0,0,,to poori katha tasveeron mein samajh
Dialogue: 0,0:11:50.57,0:11:51.33,Default,,0,0,0,,aa jaayegi.
Dialogue: 0,0:11:51.78,0:11:55.11,Default,,0,0,0,,Andar sangemarmar ka aangan hai,
Dialogue: 0,0:11:55.11,0:11:57.78,Default,,0,0,0,,upar hifaazat ki jaali.
Dialogue: 0,0:11:57.78,0:12:01.44,Default,,0,0,0,,Garbhgriha mein lagbhag 0.75 metre oonchi
Dialogue: 0,0:12:01.44,0:12:02.11,Default,,0,0,0,,murti,
Dialogue: 0,0:12:02.11,0:12:03.44,Default,,0,0,0,,trishul ke saath.
Dialogue: 0,0:12:03.44,0:12:06.11,Default,,0,0,0,,Aur farsh par har taraf kaba.
Dialogue: 0,0:12:06.11,0:12:08.77,Default,,0,0,0,,Nange paanv chalna hota hai,
Dialogue: 0,0:12:08.77,0:12:10.44,Default,,0,0,0,,to dheere chaliye.
Dialogue: 0,0:12:10.44,0:12:13.10,Default,,0,0,0,,Kisi ko chot na pahunche,
Dialogue: 0,0:12:13.10,0:12:14.10,Default,,0,0,0,,na aapko,
Dialogue: 0,0:12:14.10,0:12:15.10,Default,,0,0,0,,na unhe.
Dialogue: 0,0:12:15.55,0:12:16.45,Default,,0,0,0,,Yaad rakhiye,
Dialogue: 0,0:12:16.45,0:12:17.94,Default,,0,0,0,,yeh museum nahi,
Dialogue: 0,0:12:17.94,0:12:20.03,Default,,0,0,0,,jeeta jaagta mandir hai.
Dialogue: 0,0:12:20.03,0:12:23.02,Default,,0,0,0,,Yahan log pooja karne aate hain,
Dialogue: 0,0:12:23.02,0:12:25.11,Default,,0,0,0,,mannat maangne aate hain.
Dialogue: 0,0:12:25.11,0:12:26.31,Default,,0,0,0,,Photo lijiye,
Dialogue: 0,0:12:26.31,0:12:29.00,Default,,0,0,0,,par kisi ki aastha ka mazaak
Dialogue: 0,0:12:29.00,0:12:29.89,Default,,0,0,0,,mat banaiye.
Dialogue: 0,0:12:29.89,0:12:31.39,Default,,0,0,0,,Jo dekhne aaye ho,
Dialogue: 0,0:12:31.39,0:12:33.18,Default,,0,0,0,,use dil se dekhiye.
Dialogue: 0,0:12:33.18,0:12:34.38,Default,,0,0,0,,Sawal poochiye,
Dialogue: 0,0:12:34.38,0:12:35.87,Default,,0,0,0,,par izzat ke saath.
Dialogue: 0,0:12:36.32,0:12:36.82,Default,,0,0,0,,Aur haan,
Dialogue: 0,0:12:36.82,0:12:39.08,Default,,0,0,0,,nazar safed chuhe par rakhiye.
Dialogue: 0,0:12:39.08,0:12:41.09,Default,,0,0,0,,Shayad ghanton baad bhi na dikhe.
Dialogue: 0,0:12:41.09,0:12:42.60,Default,,0,0,0,,Shayad aate hi dikh jaaye.
Dialogue: 0,0:12:42.60,0:12:45.11,Default,,0,0,0,,Wahan khade logon ki aankhon mein
Dialogue: 0,0:12:45.11,0:12:46.61,Default,,0,0,0,,jo ummeed hoti hai,
Dialogue: 0,0:12:46.61,0:12:48.87,Default,,0,0,0,,woh apne aap mein ek nazara
Dialogue: 0,0:12:48.87,0:12:49.12,Default,,0,0,0,,hai.
Dialogue: 0,0:12:49.12,0:12:51.38,Default,,0,0,0,,Woh pal kisi photo mein poora
Dialogue: 0,0:12:51.38,0:12:52.64,Default,,0,0,0,,nahi samaata.
Dialogue: 0,0:12:53.09,0:12:54.85,Default,,0,0,0,,To aaj ki baat ka nichod
Dialogue: 0,0:12:54.85,0:12:55.36,Default,,0,0,0,,kya hai?
Dialogue: 0,0:12:55.36,0:12:57.87,Default,,0,0,0,,Mandir ka sangemarmar aur chaandi,
Dialogue: 0,0:12:57.87,0:13:00.39,Default,,0,0,0,,Rajasthan Tourism ke record mein hai.
Dialogue: 0,0:13:00.39,0:13:01.90,Default,,0,0,0,,Kaba ki kahani,
Dialogue: 0,0:13:01.90,0:13:03.91,Default,,0,0,0,,local parampara mein hai.
Dialogue: 0,0:13:03.91,0:13:05.67,Default,,0,0,0,,Bimari wala daava,
Dialogue: 0,0:13:05.67,0:13:08.19,Default,,0,0,0,,abhi bina kisi study ke hai.
Dialogue: 0,0:13:08.19,0:13:09.95,Default,,0,0,0,,Yeh sab alag cheezein hain,
Dialogue: 0,0:13:09.95,0:13:12.47,Default,,0,0,0,,aur inhe alag nazar se dekhna
Dialogue: 0,0:13:12.47,0:13:12.97,Default,,0,0,0,,chahiye.
Dialogue: 0,0:13:13.42,0:13:16.10,Default,,0,0,0,,Agle safar mein hum samundar ki
Dialogue: 0,0:13:16.10,0:13:17.45,Default,,0,0,0,,taraf chalenge.
Dialogue: 0,0:13:17.45,0:13:18.79,Default,,0,0,0,,Ek aisi nagri,
Dialogue: 0,0:13:18.79,0:13:21.47,Default,,0,0,0,,jiske baare mein kaha jaata hai
Dialogue: 0,0:13:21.47,0:13:23.62,Default,,0,0,0,,ki woh paani mein sama gayi.
Dialogue: 0,0:13:23.62,0:13:24.69,Default,,0,0,0,,Naam hai Dwarka.
Dialogue: 0,0:13:24.69,0:13:26.04,Default,,0,0,0,,Wahan kya mila,
Dialogue: 0,0:13:26.04,0:13:27.11,Default,,0,0,0,,kisne dhoondha,
Dialogue: 0,0:13:27.11,0:13:28.99,Default,,0,0,0,,kya abhi bhi sawal hai,
Dialogue: 0,0:13:28.99,0:13:30.33,Default,,0,0,0,,sab sabut ke saath.
Dialogue: 0,0:13:30.33,0:13:33.01,Default,,0,0,0,,Tab tak Deshnoke ki yeh kahani
Dialogue: 0,0:13:33.01,0:13:33.82,Default,,0,0,0,,yaad rakhiye.
Dialogue: 0,0:13:34.27,0:13:36.91,Default,,0,0,0,,Ab aapse ek aasaan sa sawal.
Dialogue: 0,0:13:36.91,0:13:40.43,Default,,0,0,0,,Agar Deshnoke mein aapke saamne safed
Dialogue: 0,0:13:40.43,0:13:41.60,Default,,0,0,0,,chuha aa jaaye,
Dialogue: 0,0:13:41.60,0:13:43.36,Default,,0,0,0,,to aap kya karoge?
Dialogue: 0,0:13:43.36,0:13:44.54,Default,,0,0,0,,Photo loge,
Dialogue: 0,0:13:44.54,0:13:46.59,Default,,0,0,0,,ya haath jod kar chupchaap ruk
Dialogue: 0,0:13:46.59,0:13:47.18,Default,,0,0,0,,jaoge?
Dialogue: 0,0:13:47.18,0:13:49.23,Default,,0,0,0,,Comments mein zaroor bataiye.
