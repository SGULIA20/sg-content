Dialogue: 0,0:00:00.00,0:00:00.91,Default,,0,0,0,,Kehte hain,
Dialogue: 0,0:00:00.91,0:00:04.56,Default,,0,0,0,,Tanjore ke mandir ki parchhai dopahar
Dialogue: 0,0:00:04.56,0:00:07.30,Default,,0,0,0,,mein zameen par girti hi nahi.
Dialogue: 0,0:00:07.30,0:00:10.04,Default,,0,0,0,,Log ise chamatkar kehte hain,
Dialogue: 0,0:00:10.04,0:00:12.47,Default,,0,0,0,,kuch log ise sirf kahani.
Dialogue: 0,0:00:12.47,0:00:14.91,Default,,0,0,0,,Sach kahin beech mein chhupa hai.
Dialogue: 0,0:00:14.91,0:00:17.34,Default,,0,0,0,,Is video mein hum sabut ke
Dialogue: 0,0:00:17.34,0:00:18.56,Default,,0,0,0,,saath dekhenge,
Dialogue: 0,0:00:18.56,0:00:21.60,Default,,0,0,0,,ki parchhai aakhir jaati kahan hai.
Dialogue: 0,0:00:22.05,0:00:24.61,Default,,0,0,0,,Aur parchhai se bhi bada sawal,
Dialogue: 0,0:00:24.61,0:00:27.74,Default,,0,0,0,,mandir ke sabse upar rakha patthar.
Dialogue: 0,0:00:27.74,0:00:30.02,Default,,0,0,0,,ASI ke records kehte hain,
Dialogue: 0,0:00:30.02,0:00:33.15,Default,,0,0,0,,gumbad ke neeche granite ka single
Dialogue: 0,0:00:33.15,0:00:33.72,Default,,0,0,0,,block hai.
Dialogue: 0,0:00:33.72,0:00:36.85,Default,,0,0,0,,Uska wazan lagbhag 80 ton bataya
Dialogue: 0,0:00:36.85,0:00:37.42,Default,,0,0,0,,gaya hai.
Dialogue: 0,0:00:37.42,0:00:38.56,Default,,0,0,0,,Na crane thi,
Dialogue: 0,0:00:38.56,0:00:39.13,Default,,0,0,0,,na truck,
Dialogue: 0,0:00:39.13,0:00:41.69,Default,,0,0,0,,phir yeh upar pahuncha kaise?
Dialogue: 0,0:00:42.14,0:00:44.42,Default,,0,0,0,,Gaon ki dadi aaj bhi bachchon
Dialogue: 0,0:00:44.42,0:00:46.99,Default,,0,0,0,,ko yeh kahani sunati hain.
Dialogue: 0,0:00:46.99,0:00:49.85,Default,,0,0,0,,Ki raja ne aisa mandir banwaya,
Dialogue: 0,0:00:49.85,0:00:51.84,Default,,0,0,0,,jo kabhi jhukta nahi,
Dialogue: 0,0:00:51.84,0:00:53.56,Default,,0,0,0,,kabhi tootta nahi.
Dialogue: 0,0:00:53.56,0:00:56.41,Default,,0,0,0,,Par dadi ki kahani aur ASI
Dialogue: 0,0:00:56.41,0:00:57.27,Default,,0,0,0,,ki report,
Dialogue: 0,0:00:57.27,0:00:59.84,Default,,0,0,0,,hamesha same nahi hoti.
Dialogue: 0,0:00:59.84,0:01:01.83,Default,,0,0,0,,Isliye har baat par hum saaf
Dialogue: 0,0:01:01.83,0:01:03.26,Default,,0,0,0,,label lagayenge.
Dialogue: 0,0:01:03.71,0:01:05.97,Default,,0,0,0,,Har panel par aap chhota sa
Dialogue: 0,0:01:05.97,0:01:07.09,Default,,0,0,0,,chip dekhenge.
Dialogue: 0,0:01:07.09,0:01:09.63,Default,,0,0,0,,Legend yaani mashhoor kahani,
Dialogue: 0,0:01:09.63,0:01:12.17,Default,,0,0,0,,jiska koi likha sabut nahi.
Dialogue: 0,0:01:12.17,0:01:15.55,Default,,0,0,0,,Archaeology yaani kisi sanstha ne khud
Dialogue: 0,0:01:15.55,0:01:17.53,Default,,0,0,0,,jaakar dekha aur likha.
Dialogue: 0,0:01:17.53,0:01:20.91,Default,,0,0,0,,Disputed yaani experts aapas mein sehmat
Dialogue: 0,0:01:20.91,0:01:21.47,Default,,0,0,0,,nahi.
Dialogue: 0,0:01:21.47,0:01:22.04,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:01:22.04,0:01:24.29,Default,,0,0,0,,pehle kahani sunte hain,
Dialogue: 0,0:01:24.29,0:01:26.55,Default,,0,0,0,,jaise log sunate aaye hain.
Dialogue: 0,0:01:27.00,0:01:30.24,Default,,0,0,0,,Kahani shuru hoti hai Kaveri nadi
Dialogue: 0,0:01:30.24,0:01:31.24,Default,,0,0,0,,ke delta se,
Dialogue: 0,0:01:31.24,0:01:33.73,Default,,0,0,0,,jahan Chola raja raj karte the.
Dialogue: 0,0:01:33.73,0:01:36.23,Default,,0,0,0,,Delta yaani nadi ka woh hissa,
Dialogue: 0,0:01:36.23,0:01:38.72,Default,,0,0,0,,jahan woh samundar se milne se
Dialogue: 0,0:01:38.72,0:01:40.22,Default,,0,0,0,,pehle phail jaati hai.
Dialogue: 0,0:01:40.22,0:01:42.22,Default,,0,0,0,,Yahan ki zameen upjau thi,
Dialogue: 0,0:01:42.22,0:01:44.71,Default,,0,0,0,,aur raja ka sapna bahut bada
Dialogue: 0,0:01:44.71,0:01:44.96,Default,,0,0,0,,tha.
Dialogue: 0,0:01:45.41,0:01:48.12,Default,,0,0,0,,ASI ke mutabik is mandir ko
Dialogue: 0,0:01:48.12,0:01:50.55,Default,,0,0,0,,Rajaraja Chola ne banwaya.
Dialogue: 0,0:01:50.55,0:01:52.72,Default,,0,0,0,,Mandir ke andar Shivling hai,
Dialogue: 0,0:01:52.72,0:01:55.42,Default,,0,0,0,,aur upar aasmaan chhoota vimana.
Dialogue: 0,0:01:55.42,0:01:58.94,Default,,0,0,0,,Vimana yaani garbhgriha ke upar uthi
Dialogue: 0,0:01:58.94,0:01:59.21,Default,,0,0,0,,hui,
Dialogue: 0,0:01:59.21,0:02:01.38,Default,,0,0,0,,seedhiyon jaisi oonchi meenar.
Dialogue: 0,0:02:01.38,0:02:04.62,Default,,0,0,0,,Garbhgriha yaani mandir ka sabse andar
Dialogue: 0,0:02:04.62,0:02:05.44,Default,,0,0,0,,ka kamra,
Dialogue: 0,0:02:05.44,0:02:07.33,Default,,0,0,0,,jahan pooja hoti hai.
Dialogue: 0,0:02:07.78,0:02:10.09,Default,,0,0,0,,Ab aati hain woh kahaniyan,
Dialogue: 0,0:02:10.09,0:02:12.40,Default,,0,0,0,,jo har guide sunata hai.
Dialogue: 0,0:02:12.40,0:02:14.42,Default,,0,0,0,,Sabse mashhoor kahani,
Dialogue: 0,0:02:14.42,0:02:17.60,Default,,0,0,0,,dopahar mein is vimana ki parchhai
Dialogue: 0,0:02:17.60,0:02:19.62,Default,,0,0,0,,zameen par nahi girti.
Dialogue: 0,0:02:19.62,0:02:20.78,Default,,0,0,0,,Log kehte hain,
Dialogue: 0,0:02:20.78,0:02:23.66,Default,,0,0,0,,Chola karigar suraj ko bhi maat
Dialogue: 0,0:02:23.66,0:02:24.24,Default,,0,0,0,,de gaye.
Dialogue: 0,0:02:24.24,0:02:26.55,Default,,0,0,0,,Par is baat ka koi purana
Dialogue: 0,0:02:26.55,0:02:28.86,Default,,0,0,0,,likha sabut nahi milta.
Dialogue: 0,0:02:29.31,0:02:30.60,Default,,0,0,0,,Agli kahani,
Dialogue: 0,0:02:30.60,0:02:33.71,Default,,0,0,0,,upar wala bhaari patthar bahut lambi
Dialogue: 0,0:02:33.71,0:02:36.03,Default,,0,0,0,,mitti ki dhalaan se upar gaya.
Dialogue: 0,0:02:36.03,0:02:38.88,Default,,0,0,0,,Kehte hain yeh dhalaan Sarapallam naam
Dialogue: 0,0:02:38.88,0:02:41.20,Default,,0,0,0,,ki jagah se shuru hoti thi.
Dialogue: 0,0:02:41.20,0:02:43.53,Default,,0,0,0,,Hathi aur bail patthar ko kheenchte
Dialogue: 0,0:02:43.53,0:02:44.05,Default,,0,0,0,,rahe,
Dialogue: 0,0:02:44.05,0:02:45.08,Default,,0,0,0,,din ke baad din,
Dialogue: 0,0:02:45.08,0:02:47.15,Default,,0,0,0,,mahine ke baad mahine.
Dialogue: 0,0:02:47.60,0:02:49.69,Default,,0,0,0,,Aur aakhri kahani,
Dialogue: 0,0:02:49.69,0:02:52.13,Default,,0,0,0,,is mandir mein aaj tak koi
Dialogue: 0,0:02:52.13,0:02:53.87,Default,,0,0,0,,daraar nahi aayi.
Dialogue: 0,0:02:53.87,0:02:57.36,Default,,0,0,0,,Daraar yaani deewar ya patthar mein
Dialogue: 0,0:02:57.36,0:02:59.80,Default,,0,0,0,,padi patli si phatan.
Dialogue: 0,0:02:59.80,0:03:01.19,Default,,0,0,0,,Log kehte hain,
Dialogue: 0,0:03:01.19,0:03:02.93,Default,,0,0,0,,sadiyon ki baarish,
Dialogue: 0,0:03:02.93,0:03:06.07,Default,,0,0,0,,dhoop aur bhookamp bhi ise hila
Dialogue: 0,0:03:06.07,0:03:07.12,Default,,0,0,0,,nahi paaye.
Dialogue: 0,0:03:07.12,0:03:10.25,Default,,0,0,0,,Yeh baat sunne mein shaandaar lagti
Dialogue: 0,0:03:10.25,0:03:10.60,Default,,0,0,0,,hai.
Dialogue: 0,0:03:11.05,0:03:13.02,Default,,0,0,0,,Toh kahaniyan saamne hain,
Dialogue: 0,0:03:13.02,0:03:13.59,Default,,0,0,0,,parchhai,
Dialogue: 0,0:03:13.59,0:03:15.00,Default,,0,0,0,,dhalaan aur daraar.
Dialogue: 0,0:03:15.00,0:03:17.25,Default,,0,0,0,,Ab sawal yeh hai ki inmein
Dialogue: 0,0:03:17.25,0:03:18.38,Default,,0,0,0,,kitna sach hai.
Dialogue: 0,0:03:18.38,0:03:22.04,Default,,0,0,0,,Iske liye humein kahani sunane walon
Dialogue: 0,0:03:22.04,0:03:22.88,Default,,0,0,0,,se hatkar,
Dialogue: 0,0:03:22.88,0:03:25.70,Default,,0,0,0,,naapne walon ke paas jaana hoga.
Dialogue: 0,0:03:25.70,0:03:27.11,Default,,0,0,0,,Chaliye dekhte hain,
Dialogue: 0,0:03:27.11,0:03:29.93,Default,,0,0,0,,ASI aur UNESCO ne kya likha
Dialogue: 0,0:03:29.93,0:03:30.21,Default,,0,0,0,,hai.
Dialogue: 0,0:03:30.66,0:03:33.15,Default,,0,0,0,,ASI ke records ke mutabik,
Dialogue: 0,0:03:33.15,0:03:36.47,Default,,0,0,0,,mandir lagbhag 1010 CE mein poora
Dialogue: 0,0:03:36.47,0:03:36.75,Default,,0,0,0,,hua.
Dialogue: 0,0:03:36.75,0:03:38.69,Default,,0,0,0,,CE yaani common era,
Dialogue: 0,0:03:38.69,0:03:40.90,Default,,0,0,0,,wahi saal ki ginti jo hum
Dialogue: 0,0:03:40.90,0:03:43.39,Default,,0,0,0,,calendar mein use karte hain.
Dialogue: 0,0:03:43.39,0:03:46.16,Default,,0,0,0,,Raja ne khud iska udghatan kiya,
Dialogue: 0,0:03:46.16,0:03:49.20,Default,,0,0,0,,aur ise apne naam par Rajesvara
Dialogue: 0,0:03:49.20,0:03:50.86,Default,,0,0,0,,Peruvudaiyar naam diya.
Dialogue: 0,0:03:51.31,0:03:53.76,Default,,0,0,0,,Yeh baat hum tak pahunchi kaise?
Dialogue: 0,0:03:53.76,0:03:56.48,Default,,0,0,0,,Mandir ki deewaron par khude hue
Dialogue: 0,0:03:56.48,0:03:57.57,Default,,0,0,0,,shilalekh se.
Dialogue: 0,0:03:57.57,0:04:00.56,Default,,0,0,0,,Shilalekh yaani patthar par likhe gaye
Dialogue: 0,0:04:00.56,0:04:01.92,Default,,0,0,0,,purane record.
Dialogue: 0,0:04:01.92,0:04:04.37,Default,,0,0,0,,Inmein raja ke daan aur mandir
Dialogue: 0,0:04:04.37,0:04:06.27,Default,,0,0,0,,ke kaam ka zikr milta hai.
Dialogue: 0,0:04:06.27,0:04:09.26,Default,,0,0,0,,Inhe Thanjavur inscriptions kehte hain,
Dialogue: 0,0:04:09.26,0:04:11.71,Default,,0,0,0,,patthar ki diary samajh lijiye.
Dialogue: 0,0:04:12.16,0:04:14.50,Default,,0,0,0,,UNESCO ne is mandir ko Great
Dialogue: 0,0:04:14.50,0:04:17.10,Default,,0,0,0,,Living Chola Temples naam ke samooh
Dialogue: 0,0:04:17.10,0:04:18.14,Default,,0,0,0,,mein rakha hai.
Dialogue: 0,0:04:18.14,0:04:21.00,Default,,0,0,0,,Living yaani aisa mandir jahan aaj
Dialogue: 0,0:04:21.00,0:04:22.82,Default,,0,0,0,,bhi roz pooja hoti hai.
Dialogue: 0,0:04:22.82,0:04:24.90,Default,,0,0,0,,Matlab yeh band museum nahi,
Dialogue: 0,0:04:24.90,0:04:26.72,Default,,0,0,0,,chalta phirta mandir hai.
Dialogue: 0,0:04:26.72,0:04:29.32,Default,,0,0,0,,Aur ASI iski dekhrekh karti hai.
Dialogue: 0,0:04:29.77,0:04:31.89,Default,,0,0,0,,Ab baat karte hain patthar ki.
Dialogue: 0,0:04:31.89,0:04:34.81,Default,,0,0,0,,Poora mandir granite se bana hai,
Dialogue: 0,0:04:34.81,0:04:37.19,Default,,0,0,0,,jo bahut sakht patthar hota hai.
Dialogue: 0,0:04:37.19,0:04:39.84,Default,,0,0,0,,Granite yaani woh patthar jo aap
Dialogue: 0,0:04:39.84,0:04:41.70,Default,,0,0,0,,kitchen slab mein dekhte hain,
Dialogue: 0,0:04:41.70,0:04:43.55,Default,,0,0,0,,jise kaatna mushkil hai.
Dialogue: 0,0:04:43.55,0:04:46.20,Default,,0,0,0,,Aur yeh bhaari blocks Kaveri delta
Dialogue: 0,0:04:46.20,0:04:47.53,Default,,0,0,0,,ke paar laaye gaye the.
Dialogue: 0,0:04:47.98,0:04:51.21,Default,,0,0,0,,Vimana ke bilkul upar ek gumbad
Dialogue: 0,0:04:51.21,0:04:51.50,Default,,0,0,0,,hai,
Dialogue: 0,0:04:51.50,0:04:53.85,Default,,0,0,0,,jise shikhara kehte hain.
Dialogue: 0,0:04:53.85,0:04:57.96,Default,,0,0,0,,ASI ke mutabik yeh shikhara octagonal
Dialogue: 0,0:04:57.96,0:04:58.25,Default,,0,0,0,,hai,
Dialogue: 0,0:04:58.25,0:05:00.89,Default,,0,0,0,,bilkul traffic ke stop sign jaisi
Dialogue: 0,0:05:00.89,0:05:01.48,Default,,0,0,0,,shape.
Dialogue: 0,0:05:01.48,0:05:04.42,Default,,0,0,0,,Aur yeh gumbad granite ke single,
Dialogue: 0,0:05:04.42,0:05:06.76,Default,,0,0,0,,chaukor block par tika hua hai.
Dialogue: 0,0:05:06.76,0:05:08.52,Default,,0,0,0,,Chaukor yaani square,
Dialogue: 0,0:05:08.52,0:05:10.58,Default,,0,0,0,,barabar bhujaon wala.
Dialogue: 0,0:05:11.03,0:05:12.98,Default,,0,0,0,,Isi chaukor block ke wazan ko
Dialogue: 0,0:05:12.98,0:05:15.14,Default,,0,0,0,,ASI bahut bhaari batati hai,
Dialogue: 0,0:05:15.14,0:05:16.23,Default,,0,0,0,,kai hathiyon jitna.
Dialogue: 0,0:05:16.23,0:05:18.18,Default,,0,0,0,,Aur ise zameen se uthakar,
Dialogue: 0,0:05:18.18,0:05:20.34,Default,,0,0,0,,vimana ki choti tak le jaana
Dialogue: 0,0:05:20.34,0:05:20.56,Default,,0,0,0,,tha.
Dialogue: 0,0:05:20.56,0:05:22.07,Default,,0,0,0,,Bina kisi motor ke,
Dialogue: 0,0:05:22.07,0:05:23.59,Default,,0,0,0,,bina kisi crane ke.
Dialogue: 0,0:05:23.59,0:05:25.75,Default,,0,0,0,,Yahi is mandir ka sabse bada
Dialogue: 0,0:05:25.75,0:05:27.27,Default,,0,0,0,,engineering sawal hai.
Dialogue: 0,0:05:27.72,0:05:29.11,Default,,0,0,0,,Ab agli khaas baat,
Dialogue: 0,0:05:29.11,0:05:31.60,Default,,0,0,0,,in patthron ke beech mortar nahi
Dialogue: 0,0:05:31.60,0:05:31.88,Default,,0,0,0,,hai.
Dialogue: 0,0:05:31.88,0:05:34.65,Default,,0,0,0,,Mortar yaani woh gaara jo eenton
Dialogue: 0,0:05:34.65,0:05:35.76,Default,,0,0,0,,ko jodta hai.
Dialogue: 0,0:05:35.76,0:05:39.36,Default,,0,0,0,,Chola karigaron ne patthar aise kaate,
Dialogue: 0,0:05:39.36,0:05:41.30,Default,,0,0,0,,ki woh aapas mein phans kar
Dialogue: 0,0:05:41.30,0:05:41.85,Default,,0,0,0,,jud jaayein.
Dialogue: 0,0:05:41.85,0:05:44.35,Default,,0,0,0,,Ise interlocking kehte hain,
Dialogue: 0,0:05:44.35,0:05:46.84,Default,,0,0,0,,bilkul Lego ke tukdon jaisa.
Dialogue: 0,0:05:47.29,0:05:50.64,Default,,0,0,0,,Yahi interlocking mandir ki takat ka
Dialogue: 0,0:05:50.64,0:05:52.32,Default,,0,0,0,,raaz maana jaata hai.
Dialogue: 0,0:05:52.32,0:05:53.72,Default,,0,0,0,,Bhookamp aata hai,
Dialogue: 0,0:05:53.72,0:05:55.95,Default,,0,0,0,,toh patthar thoda hilte hain,
Dialogue: 0,0:05:55.95,0:05:57.63,Default,,0,0,0,,par bikharte nahi.
Dialogue: 0,0:05:57.63,0:06:00.71,Default,,0,0,0,,Jaise kase hue jodon wali lakdi
Dialogue: 0,0:06:00.71,0:06:01.54,Default,,0,0,0,,ki kursi,
Dialogue: 0,0:06:01.54,0:06:04.34,Default,,0,0,0,,dhakka sehti hai par girti nahi.
Dialogue: 0,0:06:04.34,0:06:07.13,Default,,0,0,0,,Researchers is lachak ko mandir ki
Dialogue: 0,0:06:07.13,0:06:09.37,Default,,0,0,0,,lambi umar se jodte hain.
Dialogue: 0,0:06:09.82,0:06:12.63,Default,,0,0,0,,Toh daraar wali kahani ka kya?
Dialogue: 0,0:06:12.63,0:06:15.15,Default,,0,0,0,,Patthar ki har imarat waqt ke
Dialogue: 0,0:06:15.15,0:06:16.27,Default,,0,0,0,,saath ghisti hai,
Dialogue: 0,0:06:16.27,0:06:17.96,Default,,0,0,0,,yeh vigyan kehta hai.
Dialogue: 0,0:06:17.96,0:06:20.20,Default,,0,0,0,,Par is mandir ka dhaancha aaj
Dialogue: 0,0:06:20.20,0:06:21.88,Default,,0,0,0,,bhi majboot khada hai,
Dialogue: 0,0:06:21.88,0:06:22.73,Default,,0,0,0,,yeh sach hai.
Dialogue: 0,0:06:22.73,0:06:24.97,Default,,0,0,0,,Aur kabhi koi daraar nahi,
Dialogue: 0,0:06:24.97,0:06:27.78,Default,,0,0,0,,yeh daava kisi report mein aise
Dialogue: 0,0:06:27.78,0:06:29.46,Default,,0,0,0,,nahi likha milta.
Dialogue: 0,0:06:29.91,0:06:32.66,Default,,0,0,0,,Ab aate hain sabse mashhoor daave
Dialogue: 0,0:06:32.66,0:06:32.93,Default,,0,0,0,,par,
Dialogue: 0,0:06:32.93,0:06:33.48,Default,,0,0,0,,parchhai.
Dialogue: 0,0:06:33.48,0:06:36.23,Default,,0,0,0,,Is sawal ka jawab kisi kitaab
Dialogue: 0,0:06:36.23,0:06:37.05,Default,,0,0,0,,mein nahi,
Dialogue: 0,0:06:37.05,0:06:38.70,Default,,0,0,0,,seedhe aasmaan mein hai.
Dialogue: 0,0:06:38.70,0:06:41.17,Default,,0,0,0,,Thodi si geometry lagegi,
Dialogue: 0,0:06:41.17,0:06:42.27,Default,,0,0,0,,par ghabraiye mat.
Dialogue: 0,0:06:42.27,0:06:45.29,Default,,0,0,0,,Main ise utna hi aasaan rakhunga,
Dialogue: 0,0:06:45.29,0:06:47.76,Default,,0,0,0,,jitna chhat par khade hokar dhoop
Dialogue: 0,0:06:47.76,0:06:48.31,Default,,0,0,0,,dekhna.
Dialogue: 0,0:06:48.76,0:06:51.26,Default,,0,0,0,,Pehle samjhiye parchhai banti kaise hai.
Dialogue: 0,0:06:51.26,0:06:53.54,Default,,0,0,0,,Suraj ki roshni seedhi line mein
Dialogue: 0,0:06:53.54,0:06:54.22,Default,,0,0,0,,aati hai.
Dialogue: 0,0:06:54.22,0:06:55.36,Default,,0,0,0,,Jo cheez beech mein aaye,
Dialogue: 0,0:06:55.36,0:06:57.86,Default,,0,0,0,,uske peeche roshni nahi pahunchti.
Dialogue: 0,0:06:57.86,0:07:00.14,Default,,0,0,0,,Wahi andhera hissa parchhai hai.
Dialogue: 0,0:07:00.14,0:07:01.50,Default,,0,0,0,,Suraj jitna neeche,
Dialogue: 0,0:07:01.50,0:07:02.87,Default,,0,0,0,,parchhai utni lambi.
Dialogue: 0,0:07:02.87,0:07:04.24,Default,,0,0,0,,Suraj jitna upar,
Dialogue: 0,0:07:04.24,0:07:05.60,Default,,0,0,0,,parchhai utni chhoti.
Dialogue: 0,0:07:06.05,0:07:08.66,Default,,0,0,0,,Subah aur shaam suraj neeche hota
Dialogue: 0,0:07:08.66,0:07:08.92,Default,,0,0,0,,hai,
Dialogue: 0,0:07:08.92,0:07:11.53,Default,,0,0,0,,toh vimana ki lambi parchhai door
Dialogue: 0,0:07:11.53,0:07:12.57,Default,,0,0,0,,tak girti hai.
Dialogue: 0,0:07:12.57,0:07:14.66,Default,,0,0,0,,Yeh aap wahan jaakar khud dekh
Dialogue: 0,0:07:14.66,0:07:15.44,Default,,0,0,0,,sakte hain.
Dialogue: 0,0:07:15.44,0:07:18.05,Default,,0,0,0,,Matlab mandir parchhai banata hai,
Dialogue: 0,0:07:18.05,0:07:20.92,Default,,0,0,0,,bilkul baaki imaraton ki tarah.
Dialogue: 0,0:07:20.92,0:07:22.74,Default,,0,0,0,,Yahan koi jaadu nahi,
Dialogue: 0,0:07:22.74,0:07:24.57,Default,,0,0,0,,seedha suraj ka khel hai.
Dialogue: 0,0:07:25.02,0:07:27.41,Default,,0,0,0,,Ab dopahar ka samay sochiye.
Dialogue: 0,0:07:27.41,0:07:30.06,Default,,0,0,0,,Suraj lagbhag sar ke upar hota
Dialogue: 0,0:07:30.06,0:07:30.32,Default,,0,0,0,,hai.
Dialogue: 0,0:07:30.32,0:07:32.44,Default,,0,0,0,,Tab har cheez ki parchhai sikud
Dialogue: 0,0:07:32.44,0:07:34.56,Default,,0,0,0,,kar uske pairon ke paas aa
Dialogue: 0,0:07:34.56,0:07:35.36,Default,,0,0,0,,jaati hai.
Dialogue: 0,0:07:35.36,0:07:38.54,Default,,0,0,0,,Jaise dopahar mein aapki parchhai aapke
Dialogue: 0,0:07:38.54,0:07:40.93,Default,,0,0,0,,joote ke neeche chhup jaati hai.
Dialogue: 0,0:07:40.93,0:07:43.31,Default,,0,0,0,,Mandir ke saath bhi yahi hota
Dialogue: 0,0:07:43.31,0:07:43.58,Default,,0,0,0,,hai.
Dialogue: 0,0:07:44.03,0:07:45.16,Default,,0,0,0,,Ab twist dekhiye.
Dialogue: 0,0:07:45.16,0:07:48.56,Default,,0,0,0,,Vimana seedha zameen se nahi uthta,
Dialogue: 0,0:07:48.56,0:07:49.42,Default,,0,0,0,,woh chaudi,
Dialogue: 0,0:07:49.42,0:07:51.97,Default,,0,0,0,,seedhiyon wali neev par khada hai.
Dialogue: 0,0:07:51.97,0:07:54.80,Default,,0,0,0,,Plinth yaani woh oonchi chaudi platform,
Dialogue: 0,0:07:54.80,0:07:57.63,Default,,0,0,0,,jis par imarat tiki hoti hai.
Dialogue: 0,0:07:57.63,0:08:00.75,Default,,0,0,0,,Aur vimana upar jaate hue patla
Dialogue: 0,0:08:00.75,0:08:02.17,Default,,0,0,0,,hota jaata hai,
Dialogue: 0,0:08:02.17,0:08:03.87,Default,,0,0,0,,piramid ki tarah.
Dialogue: 0,0:08:04.32,0:08:07.10,Default,,0,0,0,,Toh dopahar ki chhoti parchhai kahan
Dialogue: 0,0:08:07.10,0:08:07.86,Default,,0,0,0,,girti hai?
Dialogue: 0,0:08:07.86,0:08:10.14,Default,,0,0,0,,Mandir ki apni chaudi plinth par
Dialogue: 0,0:08:10.14,0:08:10.39,Default,,0,0,0,,hi.
Dialogue: 0,0:08:10.39,0:08:12.67,Default,,0,0,0,,Zameen tak pahunchne se pehle,
Dialogue: 0,0:08:12.67,0:08:14.69,Default,,0,0,0,,woh mandir ke hi patthar par
Dialogue: 0,0:08:14.69,0:08:15.95,Default,,0,0,0,,simat jaati hai.
Dialogue: 0,0:08:15.95,0:08:18.49,Default,,0,0,0,,Neeche khade aadmi ko lagta hai,
Dialogue: 0,0:08:18.49,0:08:19.75,Default,,0,0,0,,parchhai gayab ho gayi.
Dialogue: 0,0:08:19.75,0:08:21.52,Default,,0,0,0,,Asal mein woh wahin hai.
Dialogue: 0,0:08:21.97,0:08:24.16,Default,,0,0,0,,Isliye parchhai nahi girti,
Dialogue: 0,0:08:24.16,0:08:25.81,Default,,0,0,0,,yeh adhoora sach hai.
Dialogue: 0,0:08:25.81,0:08:27.18,Default,,0,0,0,,Parchhai banti hai,
Dialogue: 0,0:08:27.18,0:08:29.92,Default,,0,0,0,,bas dopahar mein mandir ke bahar
Dialogue: 0,0:08:29.92,0:08:31.57,Default,,0,0,0,,dikhayi nahi deti.
Dialogue: 0,0:08:31.57,0:08:34.31,Default,,0,0,0,,Aur yeh bhi karigaron ki samajh
Dialogue: 0,0:08:34.31,0:08:35.41,Default,,0,0,0,,ka sabut hai,
Dialogue: 0,0:08:35.41,0:08:38.15,Default,,0,0,0,,chaudi neev aur patla hota shikhar.
Dialogue: 0,0:08:38.15,0:08:39.52,Default,,0,0,0,,Chamatkar nahi,
Dialogue: 0,0:08:39.52,0:08:41.17,Default,,0,0,0,,par kamaal zaroor hai.
Dialogue: 0,0:08:41.62,0:08:42.75,Default,,0,0,0,,Ab woh sawal,
Dialogue: 0,0:08:42.75,0:08:45.56,Default,,0,0,0,,jahan experts khud aapas mein sehmat
Dialogue: 0,0:08:45.56,0:08:46.13,Default,,0,0,0,,nahi.
Dialogue: 0,0:08:46.13,0:08:47.25,Default,,0,0,0,,Bada sawal,
Dialogue: 0,0:08:47.25,0:08:49.51,Default,,0,0,0,,kya upar ka gumbad sach mein
Dialogue: 0,0:08:49.51,0:08:50.92,Default,,0,0,0,,single patthar hai?
Dialogue: 0,0:08:50.92,0:08:52.61,Default,,0,0,0,,ASI ke shabdon mein,
Dialogue: 0,0:08:52.61,0:08:55.71,Default,,0,0,0,,shikhara granite ke single block par
Dialogue: 0,0:08:55.71,0:08:56.55,Default,,0,0,0,,tika hai.
Dialogue: 0,0:08:56.55,0:08:58.52,Default,,0,0,0,,Par kuch scholars kehte hain,
Dialogue: 0,0:08:58.52,0:09:01.34,Default,,0,0,0,,yeh kahani itni seedhi nahi.
Dialogue: 0,0:09:01.79,0:09:04.29,Default,,0,0,0,,Kuch engineers ka maanna hai ki
Dialogue: 0,0:09:04.29,0:09:05.69,Default,,0,0,0,,yeh monolith hai.
Dialogue: 0,0:09:05.69,0:09:09.30,Default,,0,0,0,,Monolith yaani poora ka poora akela,
Dialogue: 0,0:09:09.30,0:09:10.97,Default,,0,0,0,,bina jod ka patthar.
Dialogue: 0,0:09:10.97,0:09:12.37,Default,,0,0,0,,Baaki kehte hain,
Dialogue: 0,0:09:12.37,0:09:14.31,Default,,0,0,0,,yeh kai patthron ko kaat kar,
Dialogue: 0,0:09:14.31,0:09:16.82,Default,,0,0,0,,itni safai se joda gaya ki
Dialogue: 0,0:09:16.82,0:09:18.21,Default,,0,0,0,,single dikhta hai.
Dialogue: 0,0:09:18.21,0:09:19.88,Default,,0,0,0,,Paas se jaanch kiye bina,
Dialogue: 0,0:09:19.88,0:09:21.27,Default,,0,0,0,,faisla mushkil hai.
Dialogue: 0,0:09:21.72,0:09:23.15,Default,,0,0,0,,Ab ramp ka sawal.
Dialogue: 0,0:09:23.15,0:09:24.58,Default,,0,0,0,,Ramp yaani dhalaan,
Dialogue: 0,0:09:24.58,0:09:27.14,Default,,0,0,0,,jaise building mein wheelchair ke liye
Dialogue: 0,0:09:27.14,0:09:28.29,Default,,0,0,0,,dhalwaan raasta.
Dialogue: 0,0:09:28.29,0:09:30.86,Default,,0,0,0,,Purani kahani kehti hai,
Dialogue: 0,0:09:30.86,0:09:33.43,Default,,0,0,0,,Sarapallam se bahut lambi,
Dialogue: 0,0:09:33.43,0:09:36.28,Default,,0,0,0,,seedhi mitti ki dhalaan banayi gayi.
Dialogue: 0,0:09:36.28,0:09:38.57,Default,,0,0,0,,Us par hathi aur bail patthar
Dialogue: 0,0:09:38.57,0:09:40.28,Default,,0,0,0,,kheench kar upar le gaye.
Dialogue: 0,0:09:40.73,0:09:43.32,Default,,0,0,0,,Par kuch scholars aur engineers is
Dialogue: 0,0:09:43.32,0:09:46.49,Default,,0,0,0,,seedhi dhalaan par sawal uthate hain.
Dialogue: 0,0:09:46.49,0:09:47.93,Default,,0,0,0,,Unka sawal hai,
Dialogue: 0,0:09:47.93,0:09:51.10,Default,,0,0,0,,itni lambi dhalaan banti kaise aur
Dialogue: 0,0:09:51.10,0:09:52.83,Default,,0,0,0,,baad mein hatti kaise?
Dialogue: 0,0:09:52.83,0:09:55.13,Default,,0,0,0,,Isliye kuch log spiral ramp ki
Dialogue: 0,0:09:55.13,0:09:56.29,Default,,0,0,0,,baat karte hain.
Dialogue: 0,0:09:56.29,0:09:59.46,Default,,0,0,0,,Spiral yaani mandir ke aaspaas ghoomti
Dialogue: 0,0:09:59.46,0:10:00.03,Default,,0,0,0,,dhalaan,
Dialogue: 0,0:10:00.03,0:10:02.05,Default,,0,0,0,,jaise pahaadi sadak.
Dialogue: 0,0:10:02.50,0:10:05.12,Default,,0,0,0,,Seedhi dhalaan wale kehte hain,
Dialogue: 0,0:10:05.12,0:10:08.33,Default,,0,0,0,,lambi dhalaan halki chadhai deti hai,
Dialogue: 0,0:10:08.33,0:10:09.79,Default,,0,0,0,,toh kheenchna aasaan.
Dialogue: 0,0:10:09.79,0:10:11.83,Default,,0,0,0,,Spiral wale kehte hain,
Dialogue: 0,0:10:11.83,0:10:14.75,Default,,0,0,0,,ghoomti dhalaan kam jagah leti hai,
Dialogue: 0,0:10:14.75,0:10:17.37,Default,,0,0,0,,aur mandir ke saath upar uthti
Dialogue: 0,0:10:17.37,0:10:17.66,Default,,0,0,0,,hai.
Dialogue: 0,0:10:17.66,0:10:19.12,Default,,0,0,0,,Har taraf tark hai.
Dialogue: 0,0:10:19.12,0:10:21.45,Default,,0,0,0,,Par kisi ke paas likha hua
Dialogue: 0,0:10:21.45,0:10:22.62,Default,,0,0,0,,nakshaa nahi.
Dialogue: 0,0:10:23.07,0:10:25.66,Default,,0,0,0,,Aur Sarapallam wali kahani?
Dialogue: 0,0:10:25.66,0:10:27.48,Default,,0,0,0,,Yeh naam log aaj bhi lete
Dialogue: 0,0:10:27.48,0:10:27.74,Default,,0,0,0,,hain,
Dialogue: 0,0:10:27.74,0:10:30.85,Default,,0,0,0,,par iska purana likha record humein
Dialogue: 0,0:10:30.85,0:10:31.88,Default,,0,0,0,,nahi mila.
Dialogue: 0,0:10:31.88,0:10:34.73,Default,,0,0,0,,Isliye hum ise legend hi kahenge.
Dialogue: 0,0:10:34.73,0:10:36.29,Default,,0,0,0,,Ho sakta hai sach ho,
Dialogue: 0,0:10:36.29,0:10:38.36,Default,,0,0,0,,ho sakta hai baad mein judi
Dialogue: 0,0:10:38.36,0:10:39.40,Default,,0,0,0,,kahani ho.
Dialogue: 0,0:10:39.40,0:10:40.69,Default,,0,0,0,,Sabut aane tak,
Dialogue: 0,0:10:40.69,0:10:41.99,Default,,0,0,0,,sawal khula hai.
Dialogue: 0,0:10:42.44,0:10:44.89,Default,,0,0,0,,Ab sabse bada khalipan.
Dialogue: 0,0:10:44.89,0:10:48.57,Default,,0,0,0,,Kaveri delta ke paar bhaari granite
Dialogue: 0,0:10:48.57,0:10:49.79,Default,,0,0,0,,kaise laaya gaya?
Dialogue: 0,0:10:49.79,0:10:50.10,Default,,0,0,0,,Naav,
Dialogue: 0,0:10:50.10,0:10:52.55,Default,,0,0,0,,rassi ya lakdi ke rollers?
Dialogue: 0,0:10:52.55,0:10:55.62,Default,,0,0,0,,Rollers yaani lakdi ke gol latthe,
Dialogue: 0,0:10:55.62,0:10:58.38,Default,,0,0,0,,jin par bhaari cheez lurhkayi jaati
Dialogue: 0,0:10:58.38,0:10:58.68,Default,,0,0,0,,hai.
Dialogue: 0,0:10:58.68,0:11:00.83,Default,,0,0,0,,Us samay ke records mein,
Dialogue: 0,0:11:00.83,0:11:04.20,Default,,0,0,0,,yeh tareeka likha hi nahi milta.
Dialogue: 0,0:11:04.65,0:11:06.48,Default,,0,0,0,,Kitne mazdoor lage,
Dialogue: 0,0:11:06.48,0:11:08.00,Default,,0,0,0,,kaam kis kram mein hua,
Dialogue: 0,0:11:08.00,0:11:10.12,Default,,0,0,0,,patthar kahan rakhe gaye,
Dialogue: 0,0:11:10.12,0:11:11.64,Default,,0,0,0,,yeh bhi saaf nahi.
Dialogue: 0,0:11:11.64,0:11:13.77,Default,,0,0,0,,Ise staging kehte hain,
Dialogue: 0,0:11:13.77,0:11:16.51,Default,,0,0,0,,yaani bade kaam ko hisson mein
Dialogue: 0,0:11:16.51,0:11:17.73,Default,,0,0,0,,baant kar karna.
Dialogue: 0,0:11:17.73,0:11:20.46,Default,,0,0,0,,Itne bade kaam mein yeh planning
Dialogue: 0,0:11:20.46,0:11:21.99,Default,,0,0,0,,zaroor hui hogi.
Dialogue: 0,0:11:21.99,0:11:24.72,Default,,0,0,0,,Par woh kaagaz abhi tak nahi
Dialogue: 0,0:11:24.72,0:11:25.33,Default,,0,0,0,,mila.
Dialogue: 0,0:11:25.78,0:11:28.23,Default,,0,0,0,,Accountant hone ke naate,
Dialogue: 0,0:11:28.23,0:11:31.91,Default,,0,0,0,,mujhe sabse zyada hairani planning par
Dialogue: 0,0:11:31.91,0:11:32.83,Default,,0,0,0,,hoti hai.
Dialogue: 0,0:11:32.83,0:11:34.36,Default,,0,0,0,,Itna bada kaam,
Dialogue: 0,0:11:34.36,0:11:35.89,Default,,0,0,0,,bina computer,
Dialogue: 0,0:11:35.89,0:11:37.12,Default,,0,0,0,,bina spreadsheet.
Dialogue: 0,0:11:37.12,0:11:40.18,Default,,0,0,0,,Kisi ne toh hisaab rakha hoga,
Dialogue: 0,0:11:40.18,0:11:41.10,Default,,0,0,0,,patthar ka,
Dialogue: 0,0:11:41.10,0:11:42.02,Default,,0,0,0,,mazdoor ka,
Dialogue: 0,0:11:42.02,0:11:42.94,Default,,0,0,0,,khane ka.
Dialogue: 0,0:11:42.94,0:11:44.48,Default,,0,0,0,,Woh hisaab mil jaaye,
Dialogue: 0,0:11:44.48,0:11:47.54,Default,,0,0,0,,toh bahut bada rahasya khul jaaye.
Dialogue: 0,0:11:47.99,0:11:50.46,Default,,0,0,0,,Aaj bhi yeh mandir Thanjavur mein
Dialogue: 0,0:11:50.46,0:11:51.28,Default,,0,0,0,,khada hai,
Dialogue: 0,0:11:51.28,0:11:53.20,Default,,0,0,0,,aur roz pooja hoti hai.
Dialogue: 0,0:11:53.20,0:11:55.66,Default,,0,0,0,,Ise log Big Temple ya Periya
Dialogue: 0,0:11:55.66,0:11:57.30,Default,,0,0,0,,Kovil bhi kehte hain.
Dialogue: 0,0:11:57.30,0:12:00.32,Default,,0,0,0,,Andar jaakar aap vimana ko neeche
Dialogue: 0,0:12:00.32,0:12:01.69,Default,,0,0,0,,se dekh sakte hain.
Dialogue: 0,0:12:01.69,0:12:04.15,Default,,0,0,0,,Gardan peeche karni padti hai,
Dialogue: 0,0:12:04.15,0:12:06.07,Default,,0,0,0,,itna ooncha lagta hai.
Dialogue: 0,0:12:06.52,0:12:09.17,Default,,0,0,0,,Wahan jaayein toh subah aur dopahar,
Dialogue: 0,0:12:09.17,0:12:10.76,Default,,0,0,0,,parchhai khud check kijiye.
Dialogue: 0,0:12:10.76,0:12:12.88,Default,,0,0,0,,Subah lambi parchhai dekhiye,
Dialogue: 0,0:12:12.88,0:12:15.79,Default,,0,0,0,,dopahar mein use plinth par simatte
Dialogue: 0,0:12:15.79,0:12:16.32,Default,,0,0,0,,dekhiye.
Dialogue: 0,0:12:16.32,0:12:19.23,Default,,0,0,0,,Deewaron par khude shilalekh bhi dhyan
Dialogue: 0,0:12:19.23,0:12:20.03,Default,,0,0,0,,se dekhiye.
Dialogue: 0,0:12:20.03,0:12:22.41,Default,,0,0,0,,Yahi woh patthar ki diary hai,
Dialogue: 0,0:12:22.41,0:12:26.12,Default,,0,0,0,,jisse humein 1010 wali taareekh mili.
Dialogue: 0,0:12:26.57,0:12:28.64,Default,,0,0,0,,Mandir ke aangan mein ghoomiye,
Dialogue: 0,0:12:28.64,0:12:30.70,Default,,0,0,0,,aur granite ke jod dhyan se
Dialogue: 0,0:12:30.70,0:12:31.22,Default,,0,0,0,,dekhiye.
Dialogue: 0,0:12:31.22,0:12:33.80,Default,,0,0,0,,Kai jagah patthar itni safai se
Dialogue: 0,0:12:33.80,0:12:34.58,Default,,0,0,0,,jude hain,
Dialogue: 0,0:12:34.58,0:12:36.90,Default,,0,0,0,,ki line mushkil se dikhti hai.
Dialogue: 0,0:12:36.90,0:12:38.97,Default,,0,0,0,,Yahin aapko samajh aayega,
Dialogue: 0,0:12:38.97,0:12:41.29,Default,,0,0,0,,interlocking ka matlab kya hai.
Dialogue: 0,0:12:41.29,0:12:43.88,Default,,0,0,0,,Aur shikhara wala sawal bhi aur
Dialogue: 0,0:12:43.88,0:12:45.17,Default,,0,0,0,,gehra lagega.
Dialogue: 0,0:12:45.62,0:12:47.14,Default,,0,0,0,,Toh hisaab saaf hai.
Dialogue: 0,0:12:47.14,0:12:48.66,Default,,0,0,0,,Parchhai banti hai,
Dialogue: 0,0:12:48.66,0:12:51.40,Default,,0,0,0,,bas dopahar mein mandir par hi
Dialogue: 0,0:12:51.40,0:12:52.93,Default,,0,0,0,,simat jaati hai.
Dialogue: 0,0:12:52.93,0:12:55.67,Default,,0,0,0,,Upar ka bhaari patthar sach hai,
Dialogue: 0,0:12:55.67,0:12:57.80,Default,,0,0,0,,par woh kaise pahuncha,
Dialogue: 0,0:12:57.80,0:12:59.93,Default,,0,0,0,,yeh ab bhi rahasya hai.
Dialogue: 0,0:12:59.93,0:13:03.58,Default,,0,0,0,,Aur Sarapallam ki dhalaan ki kahani,
Dialogue: 0,0:13:03.58,0:13:06.02,Default,,0,0,0,,abhi tak sirf kahani hai.
Dialogue: 0,0:13:06.47,0:13:07.92,Default,,0,0,0,,Ab aapse sawal.
Dialogue: 0,0:13:07.92,0:13:09.66,Default,,0,0,0,,Aapko kya lagta hai,
Dialogue: 0,0:13:09.66,0:13:12.56,Default,,0,0,0,,patthar seedhi dhalaan se upar gaya,
Dialogue: 0,0:13:12.56,0:13:14.30,Default,,0,0,0,,ya ghoomti dhalaan se?
Dialogue: 0,0:13:14.30,0:13:16.04,Default,,0,0,0,,Comments mein bas likhiye,
Dialogue: 0,0:13:16.04,0:13:17.49,Default,,0,0,0,,seedhi ya spiral.
Dialogue: 0,0:13:17.49,0:13:20.39,Default,,0,0,0,,Agli baar hum chalenge Hampi ke
Dialogue: 0,0:13:20.39,0:13:22.42,Default,,0,0,0,,patthar ke rath ki taraf,
Dialogue: 0,0:13:22.42,0:13:25.90,Default,,0,0,0,,jahan naya rahasya intezaar kar raha
Dialogue: 0,0:13:25.90,0:13:26.19,Default,,0,0,0,,hai.
