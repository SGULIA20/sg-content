Dialogue: 0,0:00:00.00,0:00:00.97,Default,,0,0,0,,Kirtimukha:
Dialogue: 0,0:00:00.97,0:00:02.19,Default,,0,0,0,,Shiv ka banaya jeev,
Dialogue: 0,0:00:02.19,0:00:04.14,Default,,0,0,0,,apna hi sharir kyun kha gaya?
Dialogue: 0,0:00:04.59,0:00:05.44,Default,,0,0,0,,Skanda Puran:
Dialogue: 0,0:00:05.44,0:00:07.99,Default,,0,0,0,,asur Jalandhara ne doot Rahu bheja,
Dialogue: 0,0:00:07.99,0:00:09.68,Default,,0,0,0,,Mata Parvati ko maangne.
Dialogue: 0,0:00:09.68,0:00:11.17,Default,,0,0,0,,Shiv ke krodh se ek bhookha
Dialogue: 0,0:00:11.17,0:00:12.44,Default,,0,0,0,,sher-mukhi jeev nikla.
Dialogue: 0,0:00:12.89,0:00:14.69,Default,,0,0,0,,Rahu ne maafi maangi,
Dialogue: 0,0:00:14.69,0:00:15.72,Default,,0,0,0,,Shiv ne chhod diya.
Dialogue: 0,0:00:15.72,0:00:16.75,Default,,0,0,0,,Ab bhookh ka kya?
Dialogue: 0,0:00:16.75,0:00:17.53,Default,,0,0,0,,Shiv bole,
Dialogue: 0,0:00:17.53,0:00:18.55,Default,,0,0,0,,khud ko kha lo.
Dialogue: 0,0:00:18.55,0:00:19.84,Default,,0,0,0,,Sirf chehra bacha.
Dialogue: 0,0:00:20.29,0:00:22.25,Default,,0,0,0,,Shiv ne naam diya Kirtimukha,
Dialogue: 0,0:00:22.25,0:00:23.73,Default,,0,0,0,,yaani yash ka chehra.
Dialogue: 0,0:00:23.73,0:00:24.71,Default,,0,0,0,,Jagah mili,
Dialogue: 0,0:00:24.71,0:00:25.69,Default,,0,0,0,,mandir ka dwar.
Dialogue: 0,0:00:25.69,0:00:27.41,Default,,0,0,0,,Par pathar kya kehte hain?
Dialogue: 0,0:00:27.86,0:00:28.51,Default,,0,0,0,,Mayamata,
Dialogue: 0,0:00:28.51,0:00:30.49,Default,,0,0,0,,mandir banane ka Sanskrit granth,
Dialogue: 0,0:00:30.49,0:00:31.15,Default,,0,0,0,,kehta hai:
Dialogue: 0,0:00:31.15,0:00:33.56,Default,,0,0,0,,mehraab ke sabse upar Kirtimukha.
Dialogue: 0,0:00:34.01,0:00:36.04,Default,,0,0,0,,Rajasthan ke Nagari mein ASI,
Dialogue: 0,0:00:36.04,0:00:38.27,Default,,0,0,0,,yaani Bharat ka puratattva vibhag.
Dialogue: 0,0:00:38.27,0:00:39.69,Default,,0,0,0,,1920 ki report:
Dialogue: 0,0:00:39.69,0:00:40.70,Default,,0,0,0,,Gupta kaal ke dwar,
Dialogue: 0,0:00:40.70,0:00:42.32,Default,,0,0,0,,har khidki mein Kirtimukha.
Dialogue: 0,0:00:42.77,0:00:44.32,Default,,0,0,0,,Ajanta ki gufaon mein,
Dialogue: 0,0:00:44.32,0:00:46.31,Default,,0,0,0,,lagbhag 5th century ke mehraab.
Dialogue: 0,0:00:46.31,0:00:47.85,Default,,0,0,0,,Sabse upar wahi mukh.
Dialogue: 0,0:00:47.85,0:00:49.18,Default,,0,0,0,,Lekin twist baaki hai.
Dialogue: 0,0:00:49.63,0:00:50.95,Default,,0,0,0,,Kuch vidwan kehte hain,
Dialogue: 0,0:00:50.95,0:00:52.93,Default,,0,0,0,,yeh Bharat ke apne sher-mukh se
Dialogue: 0,0:00:52.93,0:00:53.37,Default,,0,0,0,,bana.
Dialogue: 0,0:00:53.37,0:00:55.57,Default,,0,0,0,,Heinrich Zimmer ne China ka Taotie
Dialogue: 0,0:00:55.57,0:00:56.01,Default,,0,0,0,,bataya,
Dialogue: 0,0:00:56.01,0:00:57.77,Default,,0,0,0,,sab nigalne wala chehra.
Dialogue: 0,0:00:58.22,0:00:59.64,Default,,0,0,0,,Stella Kramrisch kehti hain,
Dialogue: 0,0:00:59.64,0:01:02.09,Default,,0,0,0,,Kirtimukha wahi jo nigal raha ho.
Dialogue: 0,0:01:02.09,0:01:03.11,Default,,0,0,0,,Shuruaat kahan hui?
Dialogue: 0,0:01:03.11,0:01:04.13,Default,,0,0,0,,Koi nahi jaanta.
Dialogue: 0,0:01:04.58,0:01:05.00,Default,,0,0,0,,Aur twist?
Dialogue: 0,0:01:05.00,0:01:07.11,Default,,0,0,0,,Nalanda ke Buddh vihar ki mitti
Dialogue: 0,0:01:07.11,0:01:09.00,Default,,0,0,0,,ki tiles par bhi Kirtimukha.
Dialogue: 0,0:01:09.00,0:01:10.27,Default,,0,0,0,,Saath mein Dharmachakra,
Dialogue: 0,0:01:10.27,0:01:11.32,Default,,0,0,0,,Buddh dharm ka pahiya.
Dialogue: 0,0:01:11.77,0:01:12.56,Default,,0,0,0,,Aaj khud dekhiye:
Dialogue: 0,0:01:12.56,0:01:13.95,Default,,0,0,0,,Modhera Surya Mandir,
Dialogue: 0,0:01:13.95,0:01:15.13,Default,,0,0,0,,Gujarat ke khambe.
Dialogue: 0,0:01:15.13,0:01:15.92,Default,,0,0,0,,Aur Lakkundi,
Dialogue: 0,0:01:15.92,0:01:17.11,Default,,0,0,0,,Karnataka ke dwar.
Dialogue: 0,0:01:17.56,0:01:18.42,Default,,0,0,0,,Lok-maanyata:
Dialogue: 0,0:01:18.42,0:01:20.56,Default,,0,0,0,,ghar ke darwaze par Kirtimukha,
Dialogue: 0,0:01:20.56,0:01:21.85,Default,,0,0,0,,nazar battu jaisa.
Dialogue: 0,0:01:21.85,0:01:23.35,Default,,0,0,0,,Jo apna sharir kha gaya,
Dialogue: 0,0:01:23.35,0:01:25.06,Default,,0,0,0,,ab buri nazar khaata hai.
Dialogue: 0,0:01:25.51,0:01:26.93,Default,,0,0,0,,Us dost ko bhejo jo mandir
Dialogue: 0,0:01:26.93,0:01:28.17,Default,,0,0,0,,ke dwar par is chehre se
Dialogue: 0,0:01:28.17,0:01:28.70,Default,,0,0,0,,darta tha.
