Dialogue: 0,0:00:00.00,0:00:01.62,Default,,0,0,0,,Napoleon chhote nahi the,
Dialogue: 0,0:00:01.62,0:00:03.43,Default,,0,0,0,,toh duniya ne baauna kyun maana?
Dialogue: 0,0:00:03.43,0:00:05.05,Default,,0,0,0,,Ek cartoon ne yeh jhooth phailaya.
Dialogue: 0,0:00:05.50,0:00:07.15,Default,,0,0,0,,Kahani sab jaante hain.
Dialogue: 0,0:00:07.15,0:00:08.33,Default,,0,0,0,,France ka samraat,
Dialogue: 0,0:00:08.33,0:00:09.27,Default,,0,0,0,,kad mein thingna.
Dialogue: 0,0:00:09.27,0:00:11.40,Default,,0,0,0,,Phir bhi aadhe Europe par raaj.
Dialogue: 0,0:00:11.85,0:00:12.54,Default,,0,0,0,,Kehte hain,
Dialogue: 0,0:00:12.54,0:00:14.16,Default,,0,0,0,,kad ki chidh ne jung karwayi.
Dialogue: 0,0:00:14.16,0:00:14.85,Default,,0,0,0,,Naam pada,
Dialogue: 0,0:00:14.85,0:00:16.00,Default,,0,0,0,,Napoleon complex.
Dialogue: 0,0:00:16.00,0:00:17.85,Default,,0,0,0,,Par yeh tasveer bani kahan?
Dialogue: 0,0:00:18.30,0:00:18.67,Default,,0,0,0,,London.
Dialogue: 0,0:00:18.67,0:00:20.55,Default,,0,0,0,,Ek cartoonist kalam uthata hai,
Dialogue: 0,0:00:20.55,0:00:21.30,Default,,0,0,0,,James Gillray.
Dialogue: 0,0:00:21.30,0:00:22.80,Default,,0,0,0,,Napoleon ko banata hai,
Dialogue: 0,0:00:22.80,0:00:24.30,Default,,0,0,0,,gusse wala nanha baccha.
Dialogue: 0,0:00:24.30,0:00:25.05,Default,,0,0,0,,Naam deta hai,
Dialogue: 0,0:00:25.05,0:00:25.80,Default,,0,0,0,,Little Boney.
Dialogue: 0,0:00:26.25,0:00:28.09,Default,,0,0,0,,Yeh cartoon ghar ghar pahunchte hain.
Dialogue: 0,0:00:28.09,0:00:29.73,Default,,0,0,0,,Aur Napoleon ke apne guards?
Dialogue: 0,0:00:29.73,0:00:30.75,Default,,0,0,0,,Sab bahut lambe.
Dialogue: 0,0:00:31.20,0:00:32.52,Default,,0,0,0,,Lambe guards ke beech samraat aur
Dialogue: 0,0:00:32.52,0:00:33.35,Default,,0,0,0,,chhota dikhta hai.
Dialogue: 0,0:00:33.35,0:00:34.67,Default,,0,0,0,,Par asli naap kisne likha?
Dialogue: 0,0:00:35.12,0:00:35.56,Default,,0,0,0,,Saal 1815.
Dialogue: 0,0:00:35.56,0:00:37.77,Default,,0,0,0,,Napoleon haar kar British jahaz par
Dialogue: 0,0:00:37.77,0:00:38.43,Default,,0,0,0,,aate hain.
Dialogue: 0,0:00:38.43,0:00:39.98,Default,,0,0,0,,Captain Maitland likhta hai,
Dialogue: 0,0:00:39.98,0:00:40.42,Default,,0,0,0,,mazboot,
Dialogue: 0,0:00:40.42,0:00:41.52,Default,,0,0,0,,gathila aadmi.
Dialogue: 0,0:00:41.52,0:00:43.06,Default,,0,0,0,,Chhote ka zikr tak nahi.
Dialogue: 0,0:00:43.52,0:00:45.31,Default,,0,0,0,,Maut ke baad unka kad naapa
Dialogue: 0,0:00:45.31,0:00:45.54,Default,,0,0,0,,gaya.
Dialogue: 0,0:00:45.54,0:00:47.56,Default,,0,0,0,,Nateeja chaunkane wala tha.
Dialogue: 0,0:00:47.56,0:00:48.91,Default,,0,0,0,,Aam French aadmi jitna,
Dialogue: 0,0:00:48.91,0:00:50.04,Default,,0,0,0,,ya thoda zyada.
Dialogue: 0,0:00:50.49,0:00:51.57,Default,,0,0,0,,Toh baauna kaise?
Dialogue: 0,0:00:51.57,0:00:53.30,Default,,0,0,0,,French aur British inch alag the.
Dialogue: 0,0:00:53.30,0:00:55.47,Default,,0,0,0,,Historians aaj bhi bahas karte hain,
Dialogue: 0,0:00:55.47,0:00:56.56,Default,,0,0,0,,naap kis inch mein tha.
Dialogue: 0,0:00:57.01,0:00:58.20,Default,,0,0,0,,Aur Napoleon complex?
Dialogue: 0,0:00:58.20,0:00:59.59,Default,,0,0,0,,Kuch researchers kehte hain,
Dialogue: 0,0:00:59.59,0:01:01.38,Default,,0,0,0,,chhote mard zyada chaal chalte hain.
Dialogue: 0,0:01:01.38,0:01:02.77,Default,,0,0,0,,Doosri studies kehti hain,
Dialogue: 0,0:01:02.77,0:01:04.76,Default,,0,0,0,,lambe mard zyada maar-peet karte hain.
Dialogue: 0,0:01:05.21,0:01:05.67,Default,,0,0,0,,Sach yeh:
Dialogue: 0,0:01:05.67,0:01:06.36,Default,,0,0,0,,kad aam tha,
Dialogue: 0,0:01:06.36,0:01:07.74,Default,,0,0,0,,baauna sirf cartoon tha.
Dialogue: 0,0:01:07.74,0:01:09.58,Default,,0,0,0,,Par kya Napoleon khud kad se
Dialogue: 0,0:01:09.58,0:01:10.26,Default,,0,0,0,,chidhte the?
Dialogue: 0,0:01:10.26,0:01:12.33,Default,,0,0,0,,Koi kaagaz yeh nahi batata.
Dialogue: 0,0:01:12.78,0:01:13.98,Default,,0,0,0,,Us dost ko bhejo jo har
Dialogue: 0,0:01:13.98,0:01:15.52,Default,,0,0,0,,chhote ko Napoleon kehta hai.
