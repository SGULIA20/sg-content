Dialogue: 0,0:00:00.00,0:00:01.41,Default,,0,0,0,,RBI ne byaaj kaata,
Dialogue: 0,0:00:01.41,0:00:03.95,Default,,0,0,0,,toh aapki EMI utni kam kyun
Dialogue: 0,0:00:03.95,0:00:04.80,Default,,0,0,0,,nahi hui?
Dialogue: 0,0:00:05.25,0:00:06.26,Default,,0,0,0,,Pehla ghar,
Dialogue: 0,0:00:06.26,0:00:08.97,Default,,0,0,0,,bank counter par couple khush hai.
Dialogue: 0,0:00:08.97,0:00:11.33,Default,,0,0,0,,EMI ab halki hogi.
Dialogue: 0,0:00:11.78,0:00:14.54,Default,,0,0,0,,RBI ne repo rate kaafi ghataya.
Dialogue: 0,0:00:14.54,0:00:17.03,Default,,0,0,0,,Repo rate yaani banks ke liye
Dialogue: 0,0:00:17.03,0:00:17.86,Default,,0,0,0,,RBI ka byaaj.
Dialogue: 0,0:00:18.31,0:00:21.19,Default,,0,0,0,,Toh bank bhi utna ghatayega,
Dialogue: 0,0:00:21.19,0:00:21.55,Default,,0,0,0,,na?
Dialogue: 0,0:00:21.55,0:00:22.63,Default,,0,0,0,,Sign kar diya.
Dialogue: 0,0:00:23.08,0:00:25.37,Default,,0,0,0,,Lekin RBI ki apni report kehti
Dialogue: 0,0:00:25.37,0:00:25.59,Default,,0,0,0,,hai,
Dialogue: 0,0:00:25.59,0:00:27.88,Default,,0,0,0,,poora cut aap tak nahi pahuncha.
Dialogue: 0,0:00:28.33,0:00:31.76,Default,,0,0,0,,Samjho RBI ne 125 ki chhoot
Dialogue: 0,0:00:31.76,0:00:32.14,Default,,0,0,0,,di,
Dialogue: 0,0:00:32.14,0:00:35.57,Default,,0,0,0,,naye loans tak sirf 93 pahunchi.
Dialogue: 0,0:00:36.02,0:00:36.65,Default,,0,0,0,,Twist yeh,
Dialogue: 0,0:00:36.65,0:00:39.46,Default,,0,0,0,,isme bhi kuch hissa asli cut
Dialogue: 0,0:00:39.46,0:00:40.40,Default,,0,0,0,,nahi tha.
Dialogue: 0,0:00:40.40,0:00:42.91,Default,,0,0,0,,Bas zyada loan saste banks mein
Dialogue: 0,0:00:42.91,0:00:43.22,Default,,0,0,0,,gaye.
Dialogue: 0,0:00:43.67,0:00:45.31,Default,,0,0,0,,Loan se pehle kai banks ka
Dialogue: 0,0:00:45.31,0:00:46.25,Default,,0,0,0,,rate milao.
Dialogue: 0,0:00:46.25,0:00:48.59,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:49.04,0:00:50.72,Default,,0,0,0,,Us dost ko bhejo jo RBI
Dialogue: 0,0:00:50.72,0:00:52.88,Default,,0,0,0,,ki khabar sunke loan lene bhaag
Dialogue: 0,0:00:52.88,0:00:53.60,Default,,0,0,0,,raha hai.
