Dialogue: 0,0:00:00.00,0:00:02.40,Default,,0,0,0,,Lepakshi ka mashhoor latakta khamba,
Dialogue: 0,0:00:02.40,0:00:04.58,Default,,0,0,0,,asal mein poora hawa mein nahi
Dialogue: 0,0:00:04.58,0:00:04.80,Default,,0,0,0,,hai.
Dialogue: 0,0:00:04.80,0:00:06.33,Default,,0,0,0,,Jaanch mein paaya gaya ki iska
Dialogue: 0,0:00:06.33,0:00:08.29,Default,,0,0,0,,bas kona zameen ko chhoota hai.
Dialogue: 0,0:00:08.29,0:00:10.04,Default,,0,0,0,,Phir bhi log uske neeche se
Dialogue: 0,0:00:10.04,0:00:11.57,Default,,0,0,0,,kapda nikaal dete hain.
Dialogue: 0,0:00:11.57,0:00:12.88,Default,,0,0,0,,Toh yeh chamatkar hai,
Dialogue: 0,0:00:12.88,0:00:13.53,Default,,0,0,0,,galti hai,
Dialogue: 0,0:00:13.53,0:00:15.28,Default,,0,0,0,,ya kamaal ki engineering?
Dialogue: 0,0:00:15.73,0:00:18.97,Default,,0,0,0,,Andhra Pradesh ke Lepakshi gaon mein
Dialogue: 0,0:00:18.97,0:00:21.89,Default,,0,0,0,,Veerabhadra mandir khada hai.
Dialogue: 0,0:00:21.89,0:00:24.48,Default,,0,0,0,,Iske khambon wale hall mein,
Dialogue: 0,0:00:24.48,0:00:28.04,Default,,0,0,0,,baaki khambe chhat ko sambhaale khade
Dialogue: 0,0:00:28.04,0:00:28.37,Default,,0,0,0,,hain.
Dialogue: 0,0:00:28.37,0:00:31.61,Default,,0,0,0,,Lekin unke beech yeh khamba alag
Dialogue: 0,0:00:31.61,0:00:32.58,Default,,0,0,0,,dikhta hai.
Dialogue: 0,0:00:32.58,0:00:35.50,Default,,0,0,0,,Log kehte hain yeh khamba hawa
Dialogue: 0,0:00:35.50,0:00:37.12,Default,,0,0,0,,mein latakta hai,
Dialogue: 0,0:00:37.12,0:00:40.68,Default,,0,0,0,,jaise kisi ne use upar utha
Dialogue: 0,0:00:40.68,0:00:41.33,Default,,0,0,0,,liya ho.
Dialogue: 0,0:00:41.78,0:00:43.64,Default,,0,0,0,,Is video mein hum sabut ke
Dialogue: 0,0:00:43.64,0:00:44.57,Default,,0,0,0,,saath chalenge.
Dialogue: 0,0:00:44.57,0:00:46.67,Default,,0,0,0,,Shuru mein dekhenge ki granth kya
Dialogue: 0,0:00:46.67,0:00:47.37,Default,,0,0,0,,kehta hai.
Dialogue: 0,0:00:47.37,0:00:49.46,Default,,0,0,0,,Phir dekhenge jaanch mein kya mila,
Dialogue: 0,0:00:49.46,0:00:51.79,Default,,0,0,0,,jaankar kahan alag raay rakhte hain,
Dialogue: 0,0:00:51.79,0:00:53.65,Default,,0,0,0,,aur kya abhi tak koi nahi
Dialogue: 0,0:00:53.65,0:00:54.12,Default,,0,0,0,,jaanta.
Dialogue: 0,0:00:54.12,0:00:54.81,Default,,0,0,0,,Aakhir mein,
Dialogue: 0,0:00:54.81,0:00:56.91,Default,,0,0,0,,aap wahan jaakar kya dekh sakte
Dialogue: 0,0:00:56.91,0:00:57.14,Default,,0,0,0,,hain.
Dialogue: 0,0:00:57.59,0:01:00.30,Default,,0,0,0,,Kahani shuru hoti hai Skanda Purana
Dialogue: 0,0:01:00.30,0:01:00.51,Default,,0,0,0,,se.
Dialogue: 0,0:01:00.51,0:01:02.18,Default,,0,0,0,,Purana yaani prachin granth,
Dialogue: 0,0:01:02.18,0:01:03.01,Default,,0,0,0,,jismein devtaon,
Dialogue: 0,0:01:03.01,0:01:05.31,Default,,0,0,0,,teerthon aur jagahon ki kathayein likhi
Dialogue: 0,0:01:05.31,0:01:05.51,Default,,0,0,0,,hain.
Dialogue: 0,0:01:05.51,0:01:07.18,Default,,0,0,0,,Is granth mein Lepakshi ka naam
Dialogue: 0,0:01:07.18,0:01:07.81,Default,,0,0,0,,aata hai,
Dialogue: 0,0:01:07.81,0:01:09.69,Default,,0,0,0,,aur bade aadar ke saath aata
Dialogue: 0,0:01:09.69,0:01:09.89,Default,,0,0,0,,hai.
Dialogue: 0,0:01:09.89,0:01:12.19,Default,,0,0,0,,Yahin se is jagah ki pavitrata
Dialogue: 0,0:01:12.19,0:01:13.23,Default,,0,0,0,,ki neev padti hai.
Dialogue: 0,0:01:13.68,0:01:15.47,Default,,0,0,0,,Skanda Purana ke mutabik,
Dialogue: 0,0:01:15.47,0:01:17.46,Default,,0,0,0,,Lepakshi divyakshetron mein se hai.
Dialogue: 0,0:01:17.46,0:01:20.05,Default,,0,0,0,,Divyakshetra yaani aisi pavitra bhoomi,
Dialogue: 0,0:01:20.05,0:01:22.44,Default,,0,0,0,,jahan devta ki khaas upasthiti maani
Dialogue: 0,0:01:22.44,0:01:23.03,Default,,0,0,0,,jaati hai.
Dialogue: 0,0:01:23.03,0:01:25.42,Default,,0,0,0,,Yeh jagah Bhagwan Shiv ke mahatvapurna
Dialogue: 0,0:01:25.42,0:01:27.02,Default,,0,0,0,,teerthon mein gini jaati hai.
Dialogue: 0,0:01:27.02,0:01:29.40,Default,,0,0,0,,Isliye yahan sadiyon se shraddhalu aate
Dialogue: 0,0:01:29.40,0:01:30.00,Default,,0,0,0,,rahe hain.
Dialogue: 0,0:01:30.45,0:01:32.94,Default,,0,0,0,,Yeh mandir Veerabhadra ko samarpit hai.
Dialogue: 0,0:01:32.94,0:01:35.22,Default,,0,0,0,,Puranon ki kathaon mein Veerabhadra,
Dialogue: 0,0:01:35.22,0:01:37.09,Default,,0,0,0,,Shiv ka ugra roop maane jaate
Dialogue: 0,0:01:37.09,0:01:37.30,Default,,0,0,0,,hain.
Dialogue: 0,0:01:37.30,0:01:39.38,Default,,0,0,0,,Garbhagriha mein door se patthar ki
Dialogue: 0,0:01:39.38,0:01:40.41,Default,,0,0,0,,moorti dikhti hai,
Dialogue: 0,0:01:40.41,0:01:41.45,Default,,0,0,0,,deep ki roshni mein.
Dialogue: 0,0:01:41.45,0:01:43.32,Default,,0,0,0,,Shraddhalu haath jode khade hain,
Dialogue: 0,0:01:43.32,0:01:45.60,Default,,0,0,0,,aur hawa mein agarbatti ki khushboo
Dialogue: 0,0:01:45.60,0:01:45.81,Default,,0,0,0,,hai.
Dialogue: 0,0:01:46.26,0:01:47.92,Default,,0,0,0,,Gaon ke naam ke peeche bhi
Dialogue: 0,0:01:47.92,0:01:48.87,Default,,0,0,0,,kahani hai.
Dialogue: 0,0:01:48.87,0:01:50.30,Default,,0,0,0,,Lok katha kehti hai,
Dialogue: 0,0:01:50.30,0:01:52.67,Default,,0,0,0,,Ramayan mein ghayal Jatayu pakshi yahin
Dialogue: 0,0:01:52.67,0:01:53.38,Default,,0,0,0,,gire the.
Dialogue: 0,0:01:53.38,0:01:54.57,Default,,0,0,0,,Shri Ram ne kaha,
Dialogue: 0,0:01:54.57,0:01:55.28,Default,,0,0,0,,'Le Pakshi',
Dialogue: 0,0:01:55.28,0:01:56.71,Default,,0,0,0,,yaani utho pakshi.
Dialogue: 0,0:01:56.71,0:01:57.42,Default,,0,0,0,,Wahi shabd,
Dialogue: 0,0:01:57.42,0:01:58.13,Default,,0,0,0,,kehte hain,
Dialogue: 0,0:01:58.13,0:02:00.03,Default,,0,0,0,,aage chalkar is gaon ka naam
Dialogue: 0,0:02:00.03,0:02:01.22,Default,,0,0,0,,Lepakshi ban gaya.
Dialogue: 0,0:02:01.67,0:02:04.96,Default,,0,0,0,,Ab aate hain mandir banwane wale
Dialogue: 0,0:02:04.96,0:02:06.45,Default,,0,0,0,,Virupanna par.
Dialogue: 0,0:02:06.45,0:02:08.55,Default,,0,0,0,,Lok katha ke mutabik,
Dialogue: 0,0:02:08.55,0:02:10.94,Default,,0,0,0,,raja ke mantriyon ne un par
Dialogue: 0,0:02:10.94,0:02:12.13,Default,,0,0,0,,ilzaam lagaya.
Dialogue: 0,0:02:12.13,0:02:15.72,Default,,0,0,0,,Ilzaam tha ki unhone shahi khazane
Dialogue: 0,0:02:15.72,0:02:18.41,Default,,0,0,0,,ka paisa mandir par uda diya.
Dialogue: 0,0:02:18.41,0:02:19.31,Default,,0,0,0,,Yeh ilzaam,
Dialogue: 0,0:02:19.31,0:02:21.10,Default,,0,0,0,,kahani kehti hai,
Dialogue: 0,0:02:21.10,0:02:22.00,Default,,0,0,0,,jhootha tha,
Dialogue: 0,0:02:22.00,0:02:24.69,Default,,0,0,0,,aur galat salaah par lagaya gaya
Dialogue: 0,0:02:24.69,0:02:24.99,Default,,0,0,0,,tha.
Dialogue: 0,0:02:25.44,0:02:27.15,Default,,0,0,0,,Kahani aage kehti hai,
Dialogue: 0,0:02:27.15,0:02:30.13,Default,,0,0,0,,sazaa ka andaza lagakar Virupanna ne
Dialogue: 0,0:02:30.13,0:02:31.84,Default,,0,0,0,,khud apni aankhein nikaal di.
Dialogue: 0,0:02:31.84,0:02:34.18,Default,,0,0,0,,Unhone unhe mandir ki deewar par
Dialogue: 0,0:02:34.18,0:02:34.60,Default,,0,0,0,,phenk diya.
Dialogue: 0,0:02:34.60,0:02:36.10,Default,,0,0,0,,Aaj bhi deewar par laal se
Dialogue: 0,0:02:36.10,0:02:37.59,Default,,0,0,0,,nishaan dikhaye jaate hain.
Dialogue: 0,0:02:37.59,0:02:39.93,Default,,0,0,0,,Log inhe Virupanna ki aankhon ke
Dialogue: 0,0:02:39.93,0:02:41.00,Default,,0,0,0,,nishaan kehte hain.
Dialogue: 0,0:02:41.45,0:02:43.78,Default,,0,0,0,,Ab kahani se sabut ki taraf
Dialogue: 0,0:02:43.78,0:02:44.48,Default,,0,0,0,,chalte hain.
Dialogue: 0,0:02:44.48,0:02:45.65,Default,,0,0,0,,Sawaal seedha hai,
Dialogue: 0,0:02:45.65,0:02:47.52,Default,,0,0,0,,kya yeh khamba sach mein hawa
Dialogue: 0,0:02:47.52,0:02:47.98,Default,,0,0,0,,mein hai?
Dialogue: 0,0:02:47.98,0:02:50.08,Default,,0,0,0,,Iske liye humein khambe ko dhyaan
Dialogue: 0,0:02:50.08,0:02:51.25,Default,,0,0,0,,se dekhna hoga.
Dialogue: 0,0:02:51.25,0:02:53.58,Default,,0,0,0,,Aur samajhna hoga ki yeh mandir
Dialogue: 0,0:02:53.58,0:02:55.45,Default,,0,0,0,,aur iski chhat bani kaise.
Dialogue: 0,0:02:55.90,0:02:58.32,Default,,0,0,0,,Yeh mandir Vijayanagara samrajya ke daur
Dialogue: 0,0:02:58.32,0:02:58.69,Default,,0,0,0,,ka hai.
Dialogue: 0,0:02:58.69,0:03:01.30,Default,,0,0,0,,Vijayanagara yaani dakshin Bharat ka bada
Dialogue: 0,0:03:01.30,0:03:01.86,Default,,0,0,0,,samrajya,
Dialogue: 0,0:03:01.86,0:03:03.35,Default,,0,0,0,,jiski rajdhani Hampi thi.
Dialogue: 0,0:03:03.35,0:03:05.40,Default,,0,0,0,,Is samrajya ke kaarigar patthar ke
Dialogue: 0,0:03:05.40,0:03:06.33,Default,,0,0,0,,kaam mein mashhoor the.
Dialogue: 0,0:03:06.33,0:03:08.20,Default,,0,0,0,,Unke mandir aaj bhi apni barik
Dialogue: 0,0:03:08.20,0:03:10.06,Default,,0,0,0,,nakkashi ke liye jaane jaate hain.
Dialogue: 0,0:03:10.51,0:03:12.31,Default,,0,0,0,,Khamba granite ka bana hai.
Dialogue: 0,0:03:12.31,0:03:14.52,Default,,0,0,0,,Granite yaani bahut sakht aur bhaari
Dialogue: 0,0:03:14.52,0:03:14.92,Default,,0,0,0,,patthar,
Dialogue: 0,0:03:14.92,0:03:16.73,Default,,0,0,0,,jo dakshin Bharat mein khoob milta
Dialogue: 0,0:03:16.73,0:03:16.93,Default,,0,0,0,,hai.
Dialogue: 0,0:03:16.93,0:03:18.93,Default,,0,0,0,,Is patthar ko kaatna aur tarashna
Dialogue: 0,0:03:18.93,0:03:20.14,Default,,0,0,0,,aasan kaam nahi tha.
Dialogue: 0,0:03:20.14,0:03:21.94,Default,,0,0,0,,Aur jab patthar itna bhaari ho,
Dialogue: 0,0:03:21.94,0:03:23.95,Default,,0,0,0,,toh use hawa mein tikana aur
Dialogue: 0,0:03:23.95,0:03:25.15,Default,,0,0,0,,bhi mushkil lagta hai.
Dialogue: 0,0:03:25.60,0:03:27.06,Default,,0,0,0,,Yeh khamba mandap mein hai.
Dialogue: 0,0:03:27.06,0:03:29.34,Default,,0,0,0,,Mandap yaani khambon par tika khula
Dialogue: 0,0:03:29.34,0:03:29.55,Default,,0,0,0,,hall,
Dialogue: 0,0:03:29.55,0:03:31.63,Default,,0,0,0,,jahan log baithte aur utsav hote.
Dialogue: 0,0:03:31.63,0:03:33.71,Default,,0,0,0,,Lepakshi ke is mandap mein bahut
Dialogue: 0,0:03:33.71,0:03:34.75,Default,,0,0,0,,saare khambe hain.
Dialogue: 0,0:03:34.75,0:03:35.99,Default,,0,0,0,,Khambon par nartakiyon,
Dialogue: 0,0:03:35.99,0:03:38.49,Default,,0,0,0,,sangeetkaaron aur devtaon ki nakkashi hai,
Dialogue: 0,0:03:38.49,0:03:40.36,Default,,0,0,0,,jo dekhne mein jeevit lagti hai.
Dialogue: 0,0:03:40.81,0:03:43.34,Default,,0,0,0,,Ab sabse zaroori sabut.
Dialogue: 0,0:03:43.34,0:03:46.18,Default,,0,0,0,,Jab khambe ki physical jaanch hui,
Dialogue: 0,0:03:46.18,0:03:49.03,Default,,0,0,0,,yaani use paas se naapa aur
Dialogue: 0,0:03:49.03,0:03:49.97,Default,,0,0,0,,dekha gaya,
Dialogue: 0,0:03:49.97,0:03:51.87,Default,,0,0,0,,toh tasveer badal gayi.
Dialogue: 0,0:03:51.87,0:03:55.35,Default,,0,0,0,,Khamba poori tarah hawa mein nahi
Dialogue: 0,0:03:55.35,0:03:55.66,Default,,0,0,0,,hai.
Dialogue: 0,0:03:55.66,0:03:56.93,Default,,0,0,0,,Iska kona,
Dialogue: 0,0:03:56.93,0:03:57.87,Default,,0,0,0,,halka sa,
Dialogue: 0,0:03:57.87,0:03:59.77,Default,,0,0,0,,zameen ko chhoota hai.
Dialogue: 0,0:03:59.77,0:04:02.61,Default,,0,0,0,,Yahi is raaz ki pehli chaabi
Dialogue: 0,0:04:02.61,0:04:02.93,Default,,0,0,0,,hai.
Dialogue: 0,0:04:03.38,0:04:03.76,Default,,0,0,0,,Socho,
Dialogue: 0,0:04:03.76,0:04:05.68,Default,,0,0,0,,jab aap kapda neeche se nikaalte
Dialogue: 0,0:04:05.68,0:04:05.87,Default,,0,0,0,,ho,
Dialogue: 0,0:04:05.87,0:04:07.79,Default,,0,0,0,,toh woh zyaadatar hisse ke neeche
Dialogue: 0,0:04:07.79,0:04:08.94,Default,,0,0,0,,se nikal jaata hai.
Dialogue: 0,0:04:08.94,0:04:11.05,Default,,0,0,0,,Isliye lagta hai khamba latak raha
Dialogue: 0,0:04:11.05,0:04:11.24,Default,,0,0,0,,hai.
Dialogue: 0,0:04:11.24,0:04:13.16,Default,,0,0,0,,Lekin kone par patthar aur zameen
Dialogue: 0,0:04:13.16,0:04:14.69,Default,,0,0,0,,ka sampark bana rehta hai.
Dialogue: 0,0:04:14.69,0:04:16.42,Default,,0,0,0,,Bhram yahin se paida hota hai.
Dialogue: 0,0:04:16.87,0:04:19.63,Default,,0,0,0,,Archaeological Survey of India,
Dialogue: 0,0:04:19.63,0:04:20.73,Default,,0,0,0,,yaani ASI,
Dialogue: 0,0:04:20.73,0:04:23.77,Default,,0,0,0,,desh ke purane smarakon ki dekhbhaal
Dialogue: 0,0:04:23.77,0:04:24.59,Default,,0,0,0,,karti hai.
Dialogue: 0,0:04:24.59,0:04:28.18,Default,,0,0,0,,Lepakshi ka Veerabhadra mandir bhi ASI
Dialogue: 0,0:04:28.18,0:04:29.83,Default,,0,0,0,,ki suraksha mein hai.
Dialogue: 0,0:04:29.83,0:04:32.87,Default,,0,0,0,,Isliye khambe ko todna ya hilana
Dialogue: 0,0:04:32.87,0:04:33.97,Default,,0,0,0,,aaj mana hai.
Dialogue: 0,0:04:33.97,0:04:35.90,Default,,0,0,0,,Jaanch bhi bahut sambhal kar,
Dialogue: 0,0:04:35.90,0:04:38.11,Default,,0,0,0,,bina nuksaan ke hoti hai.
Dialogue: 0,0:04:38.56,0:04:40.37,Default,,0,0,0,,Toh sabse bada sabut yeh hai
Dialogue: 0,0:04:40.37,0:04:42.79,Default,,0,0,0,,ki khamba gravity ko chunauti nahi
Dialogue: 0,0:04:42.79,0:04:43.19,Default,,0,0,0,,deta.
Dialogue: 0,0:04:43.19,0:04:44.80,Default,,0,0,0,,Gravity yaani woh khinchav,
Dialogue: 0,0:04:44.80,0:04:46.21,Default,,0,0,0,,jo har cheez ko zameen ki
Dialogue: 0,0:04:46.21,0:04:47.21,Default,,0,0,0,,taraf kheenchta hai.
Dialogue: 0,0:04:47.21,0:04:48.82,Default,,0,0,0,,Khamba zameen ko chhoota hai,
Dialogue: 0,0:04:48.82,0:04:50.44,Default,,0,0,0,,bas itna kam ki aankh dhokha
Dialogue: 0,0:04:50.44,0:04:51.24,Default,,0,0,0,,kha jaati hai.
Dialogue: 0,0:04:51.69,0:04:53.56,Default,,0,0,0,,Ab sawaal aata hai,
Dialogue: 0,0:04:53.56,0:04:57.31,Default,,0,0,0,,agar khamba poora bojh nahi uthata,
Dialogue: 0,0:04:57.31,0:04:59.49,Default,,0,0,0,,toh chhat kaise tiki hai?
Dialogue: 0,0:04:59.49,0:05:02.61,Default,,0,0,0,,Jawab chhat ki banawat mein chhupa
Dialogue: 0,0:05:02.61,0:05:02.93,Default,,0,0,0,,hai.
Dialogue: 0,0:05:02.93,0:05:05.74,Default,,0,0,0,,Is mandap ki chhat corbelled hai,
Dialogue: 0,0:05:05.74,0:05:09.17,Default,,0,0,0,,aur dry-stone tareeke se bani hai.
Dialogue: 0,0:05:09.17,0:05:12.29,Default,,0,0,0,,Chaliye in shabdon ko aasan bhasha
Dialogue: 0,0:05:12.29,0:05:13.85,Default,,0,0,0,,mein samajhte hain.
Dialogue: 0,0:05:14.30,0:05:16.51,Default,,0,0,0,,Corbel yaani patthar ke upar patthar,
Dialogue: 0,0:05:16.51,0:05:18.51,Default,,0,0,0,,har parat thodi aage nikal kar
Dialogue: 0,0:05:18.51,0:05:18.91,Default,,0,0,0,,rakhna.
Dialogue: 0,0:05:18.91,0:05:20.32,Default,,0,0,0,,Aise parat dar parat,
Dialogue: 0,0:05:20.32,0:05:22.12,Default,,0,0,0,,patthar beech mein aakar mil jaate
Dialogue: 0,0:05:22.12,0:05:22.32,Default,,0,0,0,,hain.
Dialogue: 0,0:05:22.32,0:05:24.33,Default,,0,0,0,,Isse chhat ka vazan seedha neeche
Dialogue: 0,0:05:24.33,0:05:25.33,Default,,0,0,0,,girne ki bajaye,
Dialogue: 0,0:05:25.33,0:05:27.34,Default,,0,0,0,,bagal ke saharon par baant jaata
Dialogue: 0,0:05:27.34,0:05:27.54,Default,,0,0,0,,hai.
Dialogue: 0,0:05:27.99,0:05:30.79,Default,,0,0,0,,Dry-stone yaani patthar jode gaye bina
Dialogue: 0,0:05:30.79,0:05:32.19,Default,,0,0,0,,gare ya cement ke.
Dialogue: 0,0:05:32.19,0:05:32.89,Default,,0,0,0,,Na choona,
Dialogue: 0,0:05:32.89,0:05:33.83,Default,,0,0,0,,na masala,
Dialogue: 0,0:05:33.83,0:05:35.93,Default,,0,0,0,,bas patthar ka patthar par sahi
Dialogue: 0,0:05:35.93,0:05:36.39,Default,,0,0,0,,baithna.
Dialogue: 0,0:05:36.39,0:05:39.19,Default,,0,0,0,,Kaarigar patthar ko itni barikee se
Dialogue: 0,0:05:39.19,0:05:40.13,Default,,0,0,0,,tarashte the,
Dialogue: 0,0:05:40.13,0:05:42.00,Default,,0,0,0,,ki woh apne vazan se hi
Dialogue: 0,0:05:42.00,0:05:43.63,Default,,0,0,0,,aapas mein phans jaate the.
Dialogue: 0,0:05:44.08,0:05:45.14,Default,,0,0,0,,Ab socho,
Dialogue: 0,0:05:45.14,0:05:48.66,Default,,0,0,0,,mandap ke saare khambe aapas mein
Dialogue: 0,0:05:48.66,0:05:51.83,Default,,0,0,0,,jude jaal ki tarah kaam karte
Dialogue: 0,0:05:51.83,0:05:52.18,Default,,0,0,0,,hain.
Dialogue: 0,0:05:52.18,0:05:54.64,Default,,0,0,0,,Upar ki chhat in sab par
Dialogue: 0,0:05:54.64,0:05:56.40,Default,,0,0,0,,bojh baant deti hai.
Dialogue: 0,0:05:56.40,0:05:59.93,Default,,0,0,0,,Isliye kisi khambe ka thoda sa
Dialogue: 0,0:05:59.93,0:06:00.63,Default,,0,0,0,,hatna,
Dialogue: 0,0:06:00.63,0:06:03.80,Default,,0,0,0,,poori chhat ko nahi girata.
Dialogue: 0,0:06:03.80,0:06:05.21,Default,,0,0,0,,Jaal mazboot ho,
Dialogue: 0,0:06:05.21,0:06:08.73,Default,,0,0,0,,toh kamzor kadi bhi tiki rehti
Dialogue: 0,0:06:08.73,0:06:09.08,Default,,0,0,0,,hai.
Dialogue: 0,0:06:09.53,0:06:14.77,Default,,0,0,0,,Yahi Vijayanagara kaarigaron ki asli kamaal
Dialogue: 0,0:06:14.77,0:06:15.75,Default,,0,0,0,,ki baat hai.
Dialogue: 0,0:06:15.75,0:06:18.70,Default,,0,0,0,,Unke paas aaj ke computer ya
Dialogue: 0,0:06:18.70,0:06:20.66,Default,,0,0,0,,machine nahi the.
Dialogue: 0,0:06:20.66,0:06:24.26,Default,,0,0,0,,Phir bhi unhone aisa dhancha banaya
Dialogue: 0,0:06:24.26,0:06:26.88,Default,,0,0,0,,jo bojh ko barabar baant de.
Dialogue: 0,0:06:26.88,0:06:30.81,Default,,0,0,0,,Latakta khamba isi dhanche ki jhalak
Dialogue: 0,0:06:30.81,0:06:31.14,Default,,0,0,0,,hai,
Dialogue: 0,0:06:31.14,0:06:34.08,Default,,0,0,0,,jo aaj bhi humein hairan karti
Dialogue: 0,0:06:34.08,0:06:34.41,Default,,0,0,0,,hai.
Dialogue: 0,0:06:34.86,0:06:36.75,Default,,0,0,0,,Toh banaya kaise gaya hoga?
Dialogue: 0,0:06:36.75,0:06:39.11,Default,,0,0,0,,Sabse sambhavit tareeka yeh hai.
Dialogue: 0,0:06:39.11,0:06:41.24,Default,,0,0,0,,Shuru mein khambe khade kiye gaye,
Dialogue: 0,0:06:41.24,0:06:42.89,Default,,0,0,0,,phir upar beam aur chhat ke
Dialogue: 0,0:06:42.89,0:06:44.07,Default,,0,0,0,,patthar rakhe gaye.
Dialogue: 0,0:06:44.07,0:06:45.49,Default,,0,0,0,,Jab chhat poori judi,
Dialogue: 0,0:06:45.49,0:06:47.15,Default,,0,0,0,,toh bojh saare jaal mein bant
Dialogue: 0,0:06:47.15,0:06:47.38,Default,,0,0,0,,gaya.
Dialogue: 0,0:06:47.38,0:06:49.51,Default,,0,0,0,,Tab kisi khambe ka neeche se
Dialogue: 0,0:06:49.51,0:06:51.63,Default,,0,0,0,,thoda hatna bhi chhat ko girne
Dialogue: 0,0:06:51.63,0:06:52.58,Default,,0,0,0,,nahi deta.
Dialogue: 0,0:06:53.03,0:06:56.63,Default,,0,0,0,,Ab aata hai sabse dilchasp hissa.
Dialogue: 0,0:06:56.63,0:07:00.23,Default,,0,0,0,,Khamba zameen se thoda upar kyon
Dialogue: 0,0:07:00.23,0:07:00.59,Default,,0,0,0,,hai?
Dialogue: 0,0:07:00.59,0:07:03.83,Default,,0,0,0,,Is par jaankaron ki raay alag
Dialogue: 0,0:07:03.83,0:07:04.91,Default,,0,0,0,,alag hai.
Dialogue: 0,0:07:04.91,0:07:07.43,Default,,0,0,0,,Aur har paksh ke paas apna
Dialogue: 0,0:07:07.43,0:07:08.15,Default,,0,0,0,,tark hai.
Dialogue: 0,0:07:08.15,0:07:08.87,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:07:08.87,0:07:12.11,Default,,0,0,0,,sabut ke saath dono raayein suniye,
Dialogue: 0,0:07:12.11,0:07:14.63,Default,,0,0,0,,bina jaldi faisla kiye.
Dialogue: 0,0:07:15.08,0:07:16.87,Default,,0,0,0,,Kuch jaankar kehte hain,
Dialogue: 0,0:07:16.87,0:07:18.95,Default,,0,0,0,,yeh jaan boojh kar banaya gaya
Dialogue: 0,0:07:18.95,0:07:19.25,Default,,0,0,0,,tha.
Dialogue: 0,0:07:19.25,0:07:23.11,Default,,0,0,0,,Kaarigar apni kala dikhana chahte the.
Dialogue: 0,0:07:23.11,0:07:26.09,Default,,0,0,0,,Woh batana chahte the ki unki
Dialogue: 0,0:07:26.09,0:07:27.87,Default,,0,0,0,,chhat itni mazboot hai,
Dialogue: 0,0:07:27.87,0:07:31.14,Default,,0,0,0,,ki khamba bina poore sahare ke
Dialogue: 0,0:07:31.14,0:07:32.63,Default,,0,0,0,,bhi tika rahe.
Dialogue: 0,0:07:32.63,0:07:35.31,Default,,0,0,0,,Yaani soch samajh kar banaya gaya
Dialogue: 0,0:07:35.31,0:07:36.20,Default,,0,0,0,,ajooba.
Dialogue: 0,0:07:36.65,0:07:38.90,Default,,0,0,0,,Baaki jaankar alag baat kehte hain.
Dialogue: 0,0:07:38.90,0:07:41.16,Default,,0,0,0,,Unke hisaab se khamba shuru mein
Dialogue: 0,0:07:41.16,0:07:43.41,Default,,0,0,0,,poori tarah zameen par tika tha.
Dialogue: 0,0:07:43.41,0:07:45.22,Default,,0,0,0,,Phir samay ke saath neeche ki
Dialogue: 0,0:07:45.22,0:07:47.02,Default,,0,0,0,,zameen asmaan roop se baith gayi.
Dialogue: 0,0:07:47.02,0:07:49.05,Default,,0,0,0,,Ise neev ka baithna kehte hain,
Dialogue: 0,0:07:49.05,0:07:51.53,Default,,0,0,0,,yaani zameen ka dheere dheere dabna.
Dialogue: 0,0:07:51.98,0:07:53.44,Default,,0,0,0,,Is paksh ke paas aur bhi
Dialogue: 0,0:07:53.44,0:07:53.93,Default,,0,0,0,,tark hai.
Dialogue: 0,0:07:53.93,0:07:55.63,Default,,0,0,0,,Bhookamp ke halke jhatke,
Dialogue: 0,0:07:55.63,0:07:57.83,Default,,0,0,0,,jinhe seismic tremors kehte hain,
Dialogue: 0,0:07:57.83,0:07:59.78,Default,,0,0,0,,sadiyon mein kai baar aaye honge.
Dialogue: 0,0:07:59.78,0:08:02.94,Default,,0,0,0,,Aise jhatke dheere dheere bhaari pattharon
Dialogue: 0,0:08:02.94,0:08:04.65,Default,,0,0,0,,ko bhi hila sakte hain.
Dialogue: 0,0:08:04.65,0:08:07.08,Default,,0,0,0,,Shayad isi se khamba apni jagah
Dialogue: 0,0:08:07.08,0:08:08.06,Default,,0,0,0,,se sarak gaya.
Dialogue: 0,0:08:08.51,0:08:09.73,Default,,0,0,0,,Toh sabut wahi hai,
Dialogue: 0,0:08:09.73,0:08:11.77,Default,,0,0,0,,par padhne ke tareeke alag hain.
Dialogue: 0,0:08:11.77,0:08:14.21,Default,,0,0,0,,Kuch log ise kaarigaron ka iraada
Dialogue: 0,0:08:14.21,0:08:14.82,Default,,0,0,0,,maante hain.
Dialogue: 0,0:08:14.82,0:08:16.65,Default,,0,0,0,,Kuch ise samay aur zameen ka
Dialogue: 0,0:08:16.65,0:08:17.67,Default,,0,0,0,,asar maante hain.
Dialogue: 0,0:08:17.67,0:08:19.30,Default,,0,0,0,,Abhi tak koi paksh baaki ko
Dialogue: 0,0:08:19.30,0:08:21.54,Default,,0,0,0,,poori tarah galat saabit nahi kar
Dialogue: 0,0:08:21.54,0:08:21.95,Default,,0,0,0,,paaya hai.
Dialogue: 0,0:08:22.40,0:08:24.63,Default,,0,0,0,,Aur yahan hum koi faisla nahi
Dialogue: 0,0:08:24.63,0:08:25.37,Default,,0,0,0,,sunayenge.
Dialogue: 0,0:08:25.37,0:08:26.36,Default,,0,0,0,,Aap khud socho,
Dialogue: 0,0:08:26.36,0:08:29.09,Default,,0,0,0,,kya itne nipun kaarigar galti se
Dialogue: 0,0:08:29.09,0:08:30.08,Default,,0,0,0,,aisa chhodte?
Dialogue: 0,0:08:30.08,0:08:32.06,Default,,0,0,0,,Ya phir sadiyon ki zameen aur
Dialogue: 0,0:08:32.06,0:08:34.05,Default,,0,0,0,,jhatkon ne apna khel khela?
Dialogue: 0,0:08:34.05,0:08:36.28,Default,,0,0,0,,Har jawab apne aap mein dilchasp
Dialogue: 0,0:08:36.28,0:08:36.52,Default,,0,0,0,,hai,
Dialogue: 0,0:08:36.52,0:08:39.25,Default,,0,0,0,,aur har jawab kaarigaron ki mehnat
Dialogue: 0,0:08:39.25,0:08:40.24,Default,,0,0,0,,dikhata hai.
Dialogue: 0,0:08:40.69,0:08:41.78,Default,,0,0,0,,Ab woh kahani,
Dialogue: 0,0:08:41.78,0:08:43.97,Default,,0,0,0,,jo sabse zyada sunayi jaati hai.
Dialogue: 0,0:08:43.97,0:08:46.38,Default,,0,0,0,,Kehte hain angrezon ke zamane mein,
Dialogue: 0,0:08:46.38,0:08:48.35,Default,,0,0,0,,koi angrez engineer is raaz ko
Dialogue: 0,0:08:48.35,0:08:49.00,Default,,0,0,0,,kholne aaya.
Dialogue: 0,0:08:49.00,0:08:50.75,Default,,0,0,0,,Woh jaanna chahta tha ki chhat
Dialogue: 0,0:08:50.75,0:08:52.72,Default,,0,0,0,,ko asal mein kaun sambhaal raha
Dialogue: 0,0:08:52.72,0:08:52.94,Default,,0,0,0,,hai.
Dialogue: 0,0:08:52.94,0:08:54.91,Default,,0,0,0,,Aur usne khambe ko hi pakad
Dialogue: 0,0:08:54.91,0:08:55.13,Default,,0,0,0,,liya.
Dialogue: 0,0:08:55.58,0:08:57.42,Default,,0,0,0,,Lok katha ke mutabik,
Dialogue: 0,0:08:57.42,0:09:00.57,Default,,0,0,0,,usne khambe ko hatane ya hilane
Dialogue: 0,0:09:00.57,0:09:01.62,Default,,0,0,0,,ki koshish ki.
Dialogue: 0,0:09:01.62,0:09:04.24,Default,,0,0,0,,Khamba apni jagah se khisak gaya,
Dialogue: 0,0:09:04.24,0:09:06.60,Default,,0,0,0,,aur tab se thoda tirchha latak
Dialogue: 0,0:09:06.60,0:09:07.39,Default,,0,0,0,,raha hai.
Dialogue: 0,0:09:07.39,0:09:08.96,Default,,0,0,0,,Kahani kehti hai,
Dialogue: 0,0:09:08.96,0:09:11.59,Default,,0,0,0,,chhat hilne lagi aur engineer ne
Dialogue: 0,0:09:11.59,0:09:12.90,Default,,0,0,0,,darr kar kaam rok diya.
Dialogue: 0,0:09:13.35,0:09:14.61,Default,,0,0,0,,Lekin dhyan dijiye,
Dialogue: 0,0:09:14.61,0:09:17.12,Default,,0,0,0,,is kahani ka koi pukhta sabut
Dialogue: 0,0:09:17.12,0:09:18.38,Default,,0,0,0,,nahi mila hai.
Dialogue: 0,0:09:18.38,0:09:20.89,Default,,0,0,0,,Kisi engineer ne sach mein khambe
Dialogue: 0,0:09:20.89,0:09:22.40,Default,,0,0,0,,ko chheda ya nahi,
Dialogue: 0,0:09:22.40,0:09:24.41,Default,,0,0,0,,yeh aaj tak saabit nahi hua.
Dialogue: 0,0:09:24.41,0:09:26.92,Default,,0,0,0,,Isliye hum ise legend ke khaane
Dialogue: 0,0:09:26.92,0:09:27.93,Default,,0,0,0,,mein rakhte hain,
Dialogue: 0,0:09:27.93,0:09:30.19,Default,,0,0,0,,itihaas ke khaane mein nahi.
Dialogue: 0,0:09:30.64,0:09:32.63,Default,,0,0,0,,Ab baat karte hain un sawaalon
Dialogue: 0,0:09:32.63,0:09:32.85,Default,,0,0,0,,ki,
Dialogue: 0,0:09:32.85,0:09:35.28,Default,,0,0,0,,jinke jawab abhi bhi adhure hain.
Dialogue: 0,0:09:35.28,0:09:37.05,Default,,0,0,0,,Khamba jaan boojh kar latkaya gaya,
Dialogue: 0,0:09:37.05,0:09:38.37,Default,,0,0,0,,ya baad mein khisak gaya?
Dialogue: 0,0:09:38.37,0:09:40.58,Default,,0,0,0,,Is par aakhri faisla abhi baaki
Dialogue: 0,0:09:40.58,0:09:40.80,Default,,0,0,0,,hai.
Dialogue: 0,0:09:40.80,0:09:42.57,Default,,0,0,0,,Aur shayad naye sabut aane par
Dialogue: 0,0:09:42.57,0:09:44.12,Default,,0,0,0,,hi yeh gutthi suljhegi.
Dialogue: 0,0:09:44.57,0:09:45.71,Default,,0,0,0,,Aur bhi sawaal hai.
Dialogue: 0,0:09:45.71,0:09:47.54,Default,,0,0,0,,Is mandap ki chhat bagal ke
Dialogue: 0,0:09:47.54,0:09:49.60,Default,,0,0,0,,dhakke ko kitna jhel sakti hai,
Dialogue: 0,0:09:49.60,0:09:51.66,Default,,0,0,0,,iska poora hisaab nahi hua.
Dialogue: 0,0:09:51.66,0:09:54.17,Default,,0,0,0,,Bagal ka dhakka yaani lateral load,
Dialogue: 0,0:09:54.17,0:09:56.00,Default,,0,0,0,,jo bhookamp ya tez hawa se
Dialogue: 0,0:09:56.00,0:09:58.29,Default,,0,0,0,,patthar ko side mein dhakelta hai.
Dialogue: 0,0:09:58.74,0:09:59.16,Default,,0,0,0,,Matlab,
Dialogue: 0,0:09:59.16,0:10:02.50,Default,,0,0,0,,Vijayanagara ke kaarigaron ne kitni mazbooti
Dialogue: 0,0:10:02.50,0:10:03.13,Default,,0,0,0,,haasil ki,
Dialogue: 0,0:10:03.13,0:10:05.22,Default,,0,0,0,,yeh abhi tak poori tarah naapa
Dialogue: 0,0:10:05.22,0:10:05.84,Default,,0,0,0,,nahi gaya.
Dialogue: 0,0:10:05.84,0:10:08.14,Default,,0,0,0,,Shayad aage ki research ise kholegi.
Dialogue: 0,0:10:08.14,0:10:10.02,Default,,0,0,0,,Tab tak yeh khamba sawaal bankar
Dialogue: 0,0:10:10.02,0:10:10.65,Default,,0,0,0,,khada hai,
Dialogue: 0,0:10:10.65,0:10:11.28,Default,,0,0,0,,ya kahein,
Dialogue: 0,0:10:11.28,0:10:12.74,Default,,0,0,0,,sawaal bankar latka hai.
Dialogue: 0,0:10:13.19,0:10:14.64,Default,,0,0,0,,Ab aapke kaam ki baat.
Dialogue: 0,0:10:14.64,0:10:17.31,Default,,0,0,0,,Agar aap Lepakshi jaana chahte hain,
Dialogue: 0,0:10:17.31,0:10:18.52,Default,,0,0,0,,toh kya kya dekhein?
Dialogue: 0,0:10:18.52,0:10:20.46,Default,,0,0,0,,Yeh gaon Andhra Pradesh mein hai,
Dialogue: 0,0:10:20.46,0:10:22.40,Default,,0,0,0,,aur mandir aaj bhi poojit hai.
Dialogue: 0,0:10:22.40,0:10:22.64,Default,,0,0,0,,Jaayein,
Dialogue: 0,0:10:22.64,0:10:24.58,Default,,0,0,0,,toh shraddha aur mandir ke niyam
Dialogue: 0,0:10:24.58,0:10:26.03,Default,,0,0,0,,ka poora dhyan rakhein.
Dialogue: 0,0:10:26.48,0:10:29.07,Default,,0,0,0,,Mandap mein jaakar latakta khamba dekhiye.
Dialogue: 0,0:10:29.07,0:10:30.80,Default,,0,0,0,,Log aaj bhi uske neeche se
Dialogue: 0,0:10:30.80,0:10:32.10,Default,,0,0,0,,kapda nikaalte hain,
Dialogue: 0,0:10:32.10,0:10:33.61,Default,,0,0,0,,aur ise shubh maante hain.
Dialogue: 0,0:10:33.61,0:10:35.55,Default,,0,0,0,,Yeh aastha ki parampara hai.
Dialogue: 0,0:10:35.55,0:10:36.42,Default,,0,0,0,,Bas dhyan rahe,
Dialogue: 0,0:10:36.42,0:10:38.79,Default,,0,0,0,,purane patthar ko dhakka ya nuksaan
Dialogue: 0,0:10:38.79,0:10:39.66,Default,,0,0,0,,na pahunche,
Dialogue: 0,0:10:39.66,0:10:41.60,Default,,0,0,0,,kyunki yeh dharohar sabki hai.
Dialogue: 0,0:10:42.05,0:10:44.47,Default,,0,0,0,,Deewar par Virupanna ki aankhon wale
Dialogue: 0,0:10:44.47,0:10:45.28,Default,,0,0,0,,nishaan dhoondhiye.
Dialogue: 0,0:10:45.28,0:10:47.10,Default,,0,0,0,,Chhat aur khambon ki rang birangi
Dialogue: 0,0:10:47.10,0:10:48.31,Default,,0,0,0,,chitrakari dekhiye.
Dialogue: 0,0:10:48.31,0:10:50.13,Default,,0,0,0,,Aur mandir ke paas granite se
Dialogue: 0,0:10:50.13,0:10:52.35,Default,,0,0,0,,bani vishal Nandi ki moorti zaroor
Dialogue: 0,0:10:52.35,0:10:52.75,Default,,0,0,0,,dekhiye,
Dialogue: 0,0:10:52.75,0:10:54.37,Default,,0,0,0,,jo door se hi nazar aati
Dialogue: 0,0:10:54.37,0:10:54.57,Default,,0,0,0,,hai.
Dialogue: 0,0:10:55.02,0:10:57.24,Default,,0,0,0,,Toh aakhir mein sabut kya kehta
Dialogue: 0,0:10:57.24,0:10:57.49,Default,,0,0,0,,hai?
Dialogue: 0,0:10:57.49,0:10:59.22,Default,,0,0,0,,Khamba hawa mein nahi,
Dialogue: 0,0:10:59.22,0:11:00.95,Default,,0,0,0,,par lagbhag latakta hai.
Dialogue: 0,0:11:00.95,0:11:02.68,Default,,0,0,0,,Chhat ka bojh khambon ke jaal
Dialogue: 0,0:11:02.68,0:11:03.91,Default,,0,0,0,,par bant jaata hai.
Dialogue: 0,0:11:03.91,0:11:05.39,Default,,0,0,0,,Aur yeh jaan boojh kar tha
Dialogue: 0,0:11:05.39,0:11:06.88,Default,,0,0,0,,ya samay ka asar,
Dialogue: 0,0:11:06.88,0:11:09.10,Default,,0,0,0,,yeh abhi bhi khula sawaal hai.
Dialogue: 0,0:11:09.55,0:11:11.20,Default,,0,0,0,,Ab aapse seedha sawaal.
Dialogue: 0,0:11:11.20,0:11:12.61,Default,,0,0,0,,Aapko kya lagta hai,
Dialogue: 0,0:11:12.61,0:11:15.43,Default,,0,0,0,,yeh khamba kaarigaron ka iraada tha,
Dialogue: 0,0:11:15.43,0:11:17.54,Default,,0,0,0,,ya zameen ke baithne ka asar?
Dialogue: 0,0:11:17.54,0:11:18.72,Default,,0,0,0,,Comment mein bataiye.
Dialogue: 0,0:11:18.72,0:11:20.84,Default,,0,0,0,,Agli baar hum chalenge Hampi,
Dialogue: 0,0:11:20.84,0:11:22.95,Default,,0,0,0,,Vijayanagara ki rajdhani,
Dialogue: 0,0:11:22.95,0:11:25.07,Default,,0,0,0,,uske pattharon ke raaz dhoondhne.
