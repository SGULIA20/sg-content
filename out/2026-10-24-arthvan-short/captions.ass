Dialogue: 0,0:00:00.00,0:00:03.37,Default,,0,0,0,,Kya Kurukshetra ke pattharon par Chakravyuh
Dialogue: 0,0:00:03.37,0:00:05.71,Default,,0,0,0,,ka 5,000 saal purana naksha hai?
Dialogue: 0,0:00:05.71,0:00:06.22,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:00:06.22,0:00:07.52,Default,,0,0,0,,sabut dhoondte hain.
Dialogue: 0,0:00:07.97,0:00:10.15,Default,,0,0,0,,Drona Parva kehta hai,
Dialogue: 0,0:00:10.15,0:00:11.71,Default,,0,0,0,,yudh ka 13va din tha.
Dialogue: 0,0:00:11.71,0:00:15.15,Default,,0,0,0,,Dronacharya ne Kaurav sena ko gol
Dialogue: 0,0:00:15.15,0:00:16.71,Default,,0,0,0,,ghere mein sajaaya.
Dialogue: 0,0:00:16.71,0:00:18.58,Default,,0,0,0,,Yahi Chakravyuh tha,
Dialogue: 0,0:00:18.58,0:00:20.45,Default,,0,0,0,,ghoomta hua sainik jaal.
Dialogue: 0,0:00:20.90,0:00:23.60,Default,,0,0,0,,Abhimanyu andar ghusna jaante the,
Dialogue: 0,0:00:23.60,0:00:25.32,Default,,0,0,0,,bahar nikalna nahi.
Dialogue: 0,0:00:25.32,0:00:28.02,Default,,0,0,0,,Jayadratha ne peeche ka raasta roka,
Dialogue: 0,0:00:28.02,0:00:29.74,Default,,0,0,0,,aur woh akele ghir gaye.
Dialogue: 0,0:00:30.19,0:00:32.48,Default,,0,0,0,,Kurukshetra ke paas Amin gaon ka
Dialogue: 0,0:00:32.48,0:00:33.62,Default,,0,0,0,,purana teela.
Dialogue: 0,0:00:33.62,0:00:35.90,Default,,0,0,0,,Archaeological Survey of India,
Dialogue: 0,0:00:35.90,0:00:36.82,Default,,0,0,0,,yaani ASI,
Dialogue: 0,0:00:36.82,0:00:38.19,Default,,0,0,0,,ne yahan khudaai ki.
Dialogue: 0,0:00:38.64,0:00:41.87,Default,,0,0,0,,Nikle Painted Grey Ware ke tukde,
Dialogue: 0,0:00:41.87,0:00:45.42,Default,,0,0,0,,yaani loha yug ke saleti bartan,
Dialogue: 0,0:00:45.42,0:00:47.36,Default,,0,0,0,,kaale design wale.
Dialogue: 0,0:00:47.81,0:00:50.20,Default,,0,0,0,,Saath mein eenton ki deewarein,
Dialogue: 0,0:00:50.20,0:00:52.60,Default,,0,0,0,,aur baad ke Shunga rajvansh ke
Dialogue: 0,0:00:52.60,0:00:54.69,Default,,0,0,0,,patthar ke khambe mile.
Dialogue: 0,0:00:55.14,0:00:57.62,Default,,0,0,0,,Par patthar ka Chakravyuh naksha?
Dialogue: 0,0:00:57.62,0:00:58.73,Default,,0,0,0,,Nahi mila.
Dialogue: 0,0:00:58.73,0:01:03.14,Default,,0,0,0,,Viral tasveerein Karnataka ke Halebidu mandir
Dialogue: 0,0:01:03.14,0:01:04.52,Default,,0,0,0,,ki nakkashi hain,
Dialogue: 0,0:01:04.52,0:01:05.62,Default,,0,0,0,,ya naye park ki.
Dialogue: 0,0:01:06.07,0:01:07.36,Default,,0,0,0,,Kuch vidwaan kehte hain,
Dialogue: 0,0:01:07.36,0:01:09.08,Default,,0,0,0,,Painted Grey Ware ka daur hi
Dialogue: 0,0:01:09.08,0:01:10.59,Default,,0,0,0,,Mahabharat ka daur hai.
Dialogue: 0,0:01:11.04,0:01:13.79,Default,,0,0,0,,Zyada archaeologist kehte hain,
Dialogue: 0,0:01:13.79,0:01:16.84,Default,,0,0,0,,yahan rozmarra ki basti mili.
Dialogue: 0,0:01:16.84,0:01:19.90,Default,,0,0,0,,Yudh ka seedha sabut nahi mila.
Dialogue: 0,0:01:19.90,0:01:23.87,Default,,0,0,0,,Chakravyuh asli yudh-neeti tha ya kahani,
Dialogue: 0,0:01:23.87,0:01:25.40,Default,,0,0,0,,koi nahi jaanta.
Dialogue: 0,0:01:25.85,0:01:26.99,Default,,0,0,0,,Aur twist yeh hai,
Dialogue: 0,0:01:26.99,0:01:29.28,Default,,0,0,0,,kahani aaj bhi zinda hai.
Dialogue: 0,0:01:29.28,0:01:33.27,Default,,0,0,0,,Abhimanyupur ke bachche galiyon mein Chakravyuh
Dialogue: 0,0:01:33.27,0:01:36.12,Default,,0,0,0,,banane aur todne ka khel khelte
Dialogue: 0,0:01:36.12,0:01:36.41,Default,,0,0,0,,hain.
Dialogue: 0,0:01:36.86,0:01:40.07,Default,,0,0,0,,Jyotisar mein aaj patthar ka ghumavdaar
Dialogue: 0,0:01:40.07,0:01:41.82,Default,,0,0,0,,Chakravyuh dikhta hai.
Dialogue: 0,0:01:41.82,0:01:44.16,Default,,0,0,0,,Par yeh naya tourism design hai,
Dialogue: 0,0:01:44.16,0:01:45.62,Default,,0,0,0,,purana nahi.
Dialogue: 0,0:01:46.07,0:01:49.50,Default,,0,0,0,,Aapko Abhimanyu ki kahani pehli baar
Dialogue: 0,0:01:49.50,0:01:50.82,Default,,0,0,0,,kisne sunaayi thi,
Dialogue: 0,0:01:50.82,0:01:52.67,Default,,0,0,0,,Dadi ne ya Nani ne?
