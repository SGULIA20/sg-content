Dialogue: 0,0:00:00.00,0:00:02.44,Default,,0,0,0,,Kya Mahabharat ki tareekh taaron mein
Dialogue: 0,0:00:02.44,0:00:03.10,Default,,0,0,0,,likhi hai?
Dialogue: 0,0:00:03.10,0:00:04.65,Default,,0,0,0,,Bhishma Parva kehta hai,
Dialogue: 0,0:00:04.65,0:00:06.64,Default,,0,0,0,,yuddh se pehle aasmaan bechain tha.
Dialogue: 0,0:00:07.09,0:00:09.11,Default,,0,0,0,,Suraj aur chaand dono par grahan
Dialogue: 0,0:00:09.11,0:00:09.55,Default,,0,0,0,,laga,
Dialogue: 0,0:00:09.55,0:00:11.35,Default,,0,0,0,,kuch hi dinon ke faasle par.
Dialogue: 0,0:00:11.35,0:00:13.36,Default,,0,0,0,,Graha ajeeb jagah khade the,
Dialogue: 0,0:00:13.36,0:00:14.93,Default,,0,0,0,,jaise koi chetavani.
Dialogue: 0,0:00:15.38,0:00:17.94,Default,,0,0,0,,Pichhli sadi mein Archaeological Survey of
Dialogue: 0,0:00:17.94,0:00:20.10,Default,,0,0,0,,India ne Hastinapur mein khudai ki.
Dialogue: 0,0:00:20.55,0:00:22.16,Default,,0,0,0,,Mile Painted Grey Ware,
Dialogue: 0,0:00:22.16,0:00:24.46,Default,,0,0,0,,yaani sleti bartan jin par kaale
Dialogue: 0,0:00:24.46,0:00:26.07,Default,,0,0,0,,rang se design bane hain.
Dialogue: 0,0:00:26.52,0:00:29.54,Default,,0,0,0,,Basti ki parten lagbhag 1100 BCE
Dialogue: 0,0:00:29.54,0:00:30.55,Default,,0,0,0,,ki maani gayin,
Dialogue: 0,0:00:30.55,0:00:32.56,Default,,0,0,0,,BCE yaani Isa se pehle.
Dialogue: 0,0:00:33.01,0:00:35.23,Default,,0,0,0,,Kurukshetra ke paas Raja Karna Ka
Dialogue: 0,0:00:35.23,0:00:37.25,Default,,0,0,0,,Tila par bhi yahi bartan nikle.
Dialogue: 0,0:00:37.70,0:00:41.02,Default,,0,0,0,,Paramparik ganana yuddh ko Kali Yuga
Dialogue: 0,0:00:41.02,0:00:41.79,Default,,0,0,0,,ki shuruaat,
Dialogue: 0,0:00:41.79,0:00:44.34,Default,,0,0,0,,3102 BCE ke paas rakhti hai.
Dialogue: 0,0:00:44.79,0:00:46.16,Default,,0,0,0,,Archaeo-astronomer,
Dialogue: 0,0:00:46.16,0:00:48.88,Default,,0,0,0,,yaani taaron se itihaas naapne wale,
Dialogue: 0,0:00:48.88,0:00:51.16,Default,,0,0,0,,computer se bhi lagbhag wahi daur
Dialogue: 0,0:00:51.16,0:00:52.07,Default,,0,0,0,,nikaalte hain.
Dialogue: 0,0:00:52.52,0:00:54.88,Default,,0,0,0,,Lekin doosre astronomer kehte hain,
Dialogue: 0,0:00:54.88,0:00:57.68,Default,,0,0,0,,aise grahan jode Kurukshetra par sainkdon
Dialogue: 0,0:00:57.68,0:00:58.32,Default,,0,0,0,,baar dikhe.
Dialogue: 0,0:00:58.77,0:01:00.36,Default,,0,0,0,,Archaeologist kehte hain,
Dialogue: 0,0:01:00.36,0:01:02.62,Default,,0,0,0,,lohe wali parten kaafi baad ki
Dialogue: 0,0:01:02.62,0:01:02.85,Default,,0,0,0,,hain.
Dialogue: 0,0:01:02.85,0:01:04.66,Default,,0,0,0,,Yoddhaon ke naam wala koi lekh
Dialogue: 0,0:01:04.66,0:01:05.57,Default,,0,0,0,,nahi mila.
Dialogue: 0,0:01:06.02,0:01:06.72,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:01:06.72,0:01:09.78,Default,,0,0,0,,Aihole ke Meguti mandir ka shilalekh,
Dialogue: 0,0:01:09.78,0:01:11.66,Default,,0,0,0,,yaani pathar par khuda lekh,
Dialogue: 0,0:01:11.66,0:01:13.54,Default,,0,0,0,,yuddh se beete saal ginta hai.
Dialogue: 0,0:01:13.99,0:01:16.69,Default,,0,0,0,,Aaj Kurukshetra ke Jyotisar mein purana
Dialogue: 0,0:01:16.69,0:01:17.73,Default,,0,0,0,,bargad khada hai.
Dialogue: 0,0:01:17.73,0:01:18.57,Default,,0,0,0,,Log maante hain,
Dialogue: 0,0:01:18.57,0:01:20.23,Default,,0,0,0,,yahin Gita kahi gayi thi.
Dialogue: 0,0:01:20.68,0:01:23.41,Default,,0,0,0,,Aapke hisaab se jawab kahan chhupa
Dialogue: 0,0:01:23.41,0:01:23.66,Default,,0,0,0,,hai,
Dialogue: 0,0:01:23.66,0:01:25.40,Default,,0,0,0,,taaron mein ya mitti mein?
