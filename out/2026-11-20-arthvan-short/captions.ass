Dialogue: 0,0:00:00.00,0:00:01.91,Default,,0,0,0,,Kya Vishnu sach mein 4 mahine
Dialogue: 0,0:00:01.91,0:00:02.55,Default,,0,0,0,,sote hain?
Dialogue: 0,0:00:03.00,0:00:05.45,Default,,0,0,0,,Padma Purana kehta hai,
Dialogue: 0,0:00:05.45,0:00:09.45,Default,,0,0,0,,Devshayani Ekadashi par Vishnu so jaate
Dialogue: 0,0:00:09.45,0:00:09.75,Default,,0,0,0,,hain.
Dialogue: 0,0:00:09.75,0:00:10.98,Default,,0,0,0,,Ksheer Sagar mein,
Dialogue: 0,0:00:10.98,0:00:11.90,Default,,0,0,0,,Sheshnaag par.
Dialogue: 0,0:00:11.90,0:00:13.13,Default,,0,0,0,,Yoga Nidra,
Dialogue: 0,0:00:13.13,0:00:15.59,Default,,0,0,0,,yaani dhyaan jaisi gehri neend.
Dialogue: 0,0:00:16.04,0:00:19.01,Default,,0,0,0,,Bhavishya Purana ka mantra kehta hai,
Dialogue: 0,0:00:19.01,0:00:21.24,Default,,0,0,0,,jab jagat ke swami sote hain,
Dialogue: 0,0:00:21.24,0:00:22.48,Default,,0,0,0,,duniya soti hai.
Dialogue: 0,0:00:22.48,0:00:24.71,Default,,0,0,0,,Isliye shaadi aur grih pravesh band.
Dialogue: 0,0:00:25.16,0:00:26.05,Default,,0,0,0,,Lekin twist hai,
Dialogue: 0,0:00:26.05,0:00:27.40,Default,,0,0,0,,ek lok katha bhi hai.
Dialogue: 0,0:00:27.40,0:00:29.41,Default,,0,0,0,,Raja Bali ko diye vachan ke
Dialogue: 0,0:00:29.41,0:00:29.64,Default,,0,0,0,,liye,
Dialogue: 0,0:00:29.64,0:00:32.10,Default,,0,0,0,,Vishnu Patal mein uske dwarpal bante
Dialogue: 0,0:00:32.10,0:00:32.33,Default,,0,0,0,,hain.
Dialogue: 0,0:00:32.78,0:00:34.72,Default,,0,0,0,,Toh kya yeh vishwas sach mein
Dialogue: 0,0:00:34.72,0:00:35.83,Default,,0,0,0,,purana hai?
Dialogue: 0,0:00:35.83,0:00:39.15,Default,,0,0,0,,Vidisha ke paas Udayagiri gufa mein
Dialogue: 0,0:00:39.15,0:00:39.70,Default,,0,0,0,,ASI,
Dialogue: 0,0:00:39.70,0:00:42.75,Default,,0,0,0,,yaani sarkari puratatva vibhaag,
Dialogue: 0,0:00:42.75,0:00:45.80,Default,,0,0,0,,3.65 metre lambi murti sambhalta hai.
Dialogue: 0,0:00:46.25,0:00:48.07,Default,,0,0,0,,Chattan mein kaate gaye,
Dialogue: 0,0:00:48.07,0:00:50.19,Default,,0,0,0,,Sheshnaag par sote Vishnu.
Dialogue: 0,0:00:50.19,0:00:50.80,Default,,0,0,0,,Deogarh,
Dialogue: 0,0:00:50.80,0:00:52.32,Default,,0,0,0,,Mamallapuram,
Dialogue: 0,0:00:52.32,0:00:55.05,Default,,0,0,0,,Undavalli mein bhi wahi neend,
Dialogue: 0,0:00:55.05,0:00:55.96,Default,,0,0,0,,pathar mein.
Dialogue: 0,0:00:56.41,0:00:57.50,Default,,0,0,0,,Par shaadiyan band kyun?
Dialogue: 0,0:00:57.50,0:01:00.12,Default,,0,0,0,,Paramparik vidwan kehte hain Dakshinayan,
Dialogue: 0,0:01:00.12,0:01:02.08,Default,,0,0,0,,yaani suraj ka dakshin ki or
Dialogue: 0,0:01:02.08,0:01:02.52,Default,,0,0,0,,jaana.
Dialogue: 0,0:01:02.52,0:01:02.74,Default,,0,0,0,,P.
Dialogue: 0,0:01:02.74,0:01:02.96,Default,,0,0,0,,V.
Dialogue: 0,0:01:02.96,0:01:05.36,Default,,0,0,0,,Kane jaise itihaaskar kehte hain,
Dialogue: 0,0:01:05.36,0:01:06.89,Default,,0,0,0,,baarish mein raaste band the.
Dialogue: 0,0:01:07.34,0:01:08.44,Default,,0,0,0,,Ek aur bahas.
Dialogue: 0,0:01:08.44,0:01:10.10,Default,,0,0,0,,Kya yeh niyam Buddh aur Jain
Dialogue: 0,0:01:10.10,0:01:12.86,Default,,0,0,0,,saadhuon ke barsaati vishram se aaya?
Dialogue: 0,0:01:12.86,0:01:15.34,Default,,0,0,0,,Ya Vedic gharelu riti se?
Dialogue: 0,0:01:15.79,0:01:16.54,Default,,0,0,0,,Sach yeh hai,
Dialogue: 0,0:01:16.54,0:01:18.55,Default,,0,0,0,,koi nahi jaanta yeh rok aam
Dialogue: 0,0:01:18.55,0:01:20.31,Default,,0,0,0,,logon tak kab pahunchi.
Dialogue: 0,0:01:20.76,0:01:22.20,Default,,0,0,0,,Aur aaj Dev Uthani hai.
Dialogue: 0,0:01:22.20,0:01:23.65,Default,,0,0,0,,Tulsi Vivah hota hai,
Dialogue: 0,0:01:23.65,0:01:25.71,Default,,0,0,0,,tulsi ke paudhe ki shaadi Vishnu
Dialogue: 0,0:01:25.71,0:01:25.91,Default,,0,0,0,,se.
Dialogue: 0,0:01:25.91,0:01:27.56,Default,,0,0,0,,Usi din se shaadiyan shuru.
Dialogue: 0,0:01:28.01,0:01:30.92,Default,,0,0,0,,Udayagiri mein woh sote Vishnu aaj
Dialogue: 0,0:01:30.92,0:01:31.97,Default,,0,0,0,,bhi dikhte hain.
Dialogue: 0,0:01:31.97,0:01:34.09,Default,,0,0,0,,Toh kya bhagwan sach mein sote
Dialogue: 0,0:01:34.09,0:01:34.35,Default,,0,0,0,,hain?
Dialogue: 0,0:01:34.35,0:01:35.67,Default,,0,0,0,,Jawab aastha mein,
Dialogue: 0,0:01:35.67,0:01:36.99,Default,,0,0,0,,sabut pathar mein.
Dialogue: 0,0:01:37.44,0:01:38.58,Default,,0,0,0,,Us bua ko bhejo jo har
Dialogue: 0,0:01:38.58,0:01:40.05,Default,,0,0,0,,saal Tulsi Vivah karwati hain.
