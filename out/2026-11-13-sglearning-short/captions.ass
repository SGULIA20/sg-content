Dialogue: 0,0:00:00.00,0:00:01.95,Default,,0,0,0,,Gold loan ek saal mein 66.1
Dialogue: 0,0:00:01.95,0:00:03.25,Default,,0,0,0,,percent badha,
Dialogue: 0,0:00:03.25,0:00:04.88,Default,,0,0,0,,aapke ghar mein bhi?
Dialogue: 0,0:00:05.33,0:00:06.60,Default,,0,0,0,,Diwali se pehle,
Dialogue: 0,0:00:06.60,0:00:09.13,Default,,0,0,0,,Mummy ne almari se kangan nikaale.
Dialogue: 0,0:00:09.13,0:00:10.40,Default,,0,0,0,,Gold loan company gayi,
Dialogue: 0,0:00:10.40,0:00:11.03,Default,,0,0,0,,bank nahi,
Dialogue: 0,0:00:11.03,0:00:12.09,Default,,0,0,0,,par loan deti hai.
Dialogue: 0,0:00:12.54,0:00:13.45,Default,,0,0,0,,Soch simple thi,
Dialogue: 0,0:00:13.45,0:00:14.57,Default,,0,0,0,,sona pada hai,
Dialogue: 0,0:00:14.57,0:00:15.25,Default,,0,0,0,,kaam aa jaaye.
Dialogue: 0,0:00:15.25,0:00:16.84,Default,,0,0,0,,Aadhe ghante mein paisa,
Dialogue: 0,0:00:16.84,0:00:18.42,Default,,0,0,0,,koi salary slip nahi.
Dialogue: 0,0:00:18.87,0:00:19.95,Default,,0,0,0,,Naya fridge aaya,
Dialogue: 0,0:00:19.95,0:00:21.83,Default,,0,0,0,,shaadi ka kharcha nikla.
Dialogue: 0,0:00:22.28,0:00:24.42,Default,,0,0,0,,ET report ke mutabik,
Dialogue: 0,0:00:24.42,0:00:27.17,Default,,0,0,0,,aise loan 3.74 lakh crore pahunch
Dialogue: 0,0:00:27.17,0:00:27.48,Default,,0,0,0,,gaye.
Dialogue: 0,0:00:27.93,0:00:29.53,Default,,0,0,0,,Har mahine byaaj chadhta hai,
Dialogue: 0,0:00:29.53,0:00:31.33,Default,,0,0,0,,sona company ke locker mein.
Dialogue: 0,0:00:31.33,0:00:32.53,Default,,0,0,0,,Time pe na lautaya,
Dialogue: 0,0:00:32.53,0:00:33.93,Default,,0,0,0,,toh sona bik sakta hai.
Dialogue: 0,0:00:34.38,0:00:35.07,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:00:35.07,0:00:37.59,Default,,0,0,0,,girvi rakhte hi sona bachat nahi,
Dialogue: 0,0:00:37.59,0:00:38.97,Default,,0,0,0,,udhaar ban jaata hai.
Dialogue: 0,0:00:38.97,0:00:39.88,Default,,0,0,0,,Pehle poochho,
Dialogue: 0,0:00:39.88,0:00:40.57,Default,,0,0,0,,byaaj kitna,
Dialogue: 0,0:00:40.57,0:00:41.49,Default,,0,0,0,,mohlat kitni.
Dialogue: 0,0:00:41.49,0:00:43.78,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:44.23,0:00:45.51,Default,,0,0,0,,Yeh Mummy ko bhejo,
Dialogue: 0,0:00:45.51,0:00:47.42,Default,,0,0,0,,jo kehti hain sona mushkil mein
Dialogue: 0,0:00:47.42,0:00:48.27,Default,,0,0,0,,kaam aata hai.
