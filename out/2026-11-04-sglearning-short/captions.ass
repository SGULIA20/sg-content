Dialogue: 0,0:00:00.00,0:00:02.44,Default,,0,0,0,,America ne byaaj nahi badhaya,
Dialogue: 0,0:00:02.44,0:00:04.63,Default,,0,0,0,,phir aapki EMI kyun nahi ghat
Dialogue: 0,0:00:04.63,0:00:05.12,Default,,0,0,0,,rahi?
Dialogue: 0,0:00:05.57,0:00:08.07,Default,,0,0,0,,US Fed ne pichle hafte rate
Dialogue: 0,0:00:08.07,0:00:09.18,Default,,0,0,0,,wahi rakha,
Dialogue: 0,0:00:09.18,0:00:10.57,Default,,0,0,0,,lagbhag 4 percent.
Dialogue: 0,0:00:10.57,0:00:13.07,Default,,0,0,0,,Fed yaani America ka RBI,
Dialogue: 0,0:00:13.07,0:00:15.29,Default,,0,0,0,,jo wahan byaaj tay karta hai.
Dialogue: 0,0:00:15.74,0:00:17.40,Default,,0,0,0,,Yeh khabar TV pe aayi,
Dialogue: 0,0:00:17.40,0:00:19.62,Default,,0,0,0,,toh ghar mein sabne rahat ki
Dialogue: 0,0:00:19.62,0:00:20.17,Default,,0,0,0,,saans li.
Dialogue: 0,0:00:20.17,0:00:21.28,Default,,0,0,0,,Sabko laga,
Dialogue: 0,0:00:21.28,0:00:22.94,Default,,0,0,0,,ab loan sasta hoga.
Dialogue: 0,0:00:23.39,0:00:24.58,Default,,0,0,0,,Soch simple thi,
Dialogue: 0,0:00:24.58,0:00:27.85,Default,,0,0,0,,America ne rate nahi badhaya,
Dialogue: 0,0:00:27.85,0:00:29.63,Default,,0,0,0,,toh RBI ab ghatayega.
Dialogue: 0,0:00:29.63,0:00:30.82,Default,,0,0,0,,RBI ghatayega,
Dialogue: 0,0:00:30.82,0:00:32.90,Default,,0,0,0,,toh bank bhi home loan ka
Dialogue: 0,0:00:32.90,0:00:34.39,Default,,0,0,0,,byaaj kam karega.
Dialogue: 0,0:00:34.84,0:00:37.63,Default,,0,0,0,,Isliye loan ka prepayment roka,
Dialogue: 0,0:00:37.63,0:00:41.05,Default,,0,0,0,,yaani loan jaldi chukane ka paisa.
Dialogue: 0,0:00:41.05,0:00:42.91,Default,,0,0,0,,Aur ek naya car loan bhi
Dialogue: 0,0:00:42.91,0:00:43.84,Default,,0,0,0,,plan kar liya.
Dialogue: 0,0:00:44.29,0:00:45.05,Default,,0,0,0,,Par dhyaan do,
Dialogue: 0,0:00:45.05,0:00:47.31,Default,,0,0,0,,Fed ne rate ghataya bhi nahi.
Dialogue: 0,0:00:47.31,0:00:48.82,Default,,0,0,0,,Wahan byaaj ooncha hai,
Dialogue: 0,0:00:48.82,0:00:51.59,Default,,0,0,0,,toh videshi paisa wahan bhaagta hai,
Dialogue: 0,0:00:51.59,0:00:53.61,Default,,0,0,0,,aur rupee kamzor hota hai.
Dialogue: 0,0:00:54.06,0:00:55.37,Default,,0,0,0,,Upar se crude,
Dialogue: 0,0:00:55.37,0:00:56.67,Default,,0,0,0,,yaani kachcha tel,
Dialogue: 0,0:00:56.67,0:00:59.55,Default,,0,0,0,,lagbhag 115 dollar ek barrel chal
Dialogue: 0,0:00:59.55,0:01:00.34,Default,,0,0,0,,raha hai.
Dialogue: 0,0:01:00.34,0:01:02.95,Default,,0,0,0,,India apna zyada tar tel bahar
Dialogue: 0,0:01:02.95,0:01:04.26,Default,,0,0,0,,se kharidta hai.
Dialogue: 0,0:01:04.71,0:01:07.01,Default,,0,0,0,,Mehenga tel matlab mehengai.
Dialogue: 0,0:01:07.01,0:01:09.05,Default,,0,0,0,,Aur jab mehengai badhti hai,
Dialogue: 0,0:01:09.05,0:01:12.11,Default,,0,0,0,,RBI rate ghatane se hichkichata hai.
Dialogue: 0,0:01:12.56,0:01:13.34,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:01:13.34,0:01:15.95,Default,,0,0,0,,America ka kuch na karna bhi
Dialogue: 0,0:01:15.95,0:01:18.57,Default,,0,0,0,,aapki EMI ooncha rakh sakta hai.
Dialogue: 0,0:01:18.57,0:01:20.66,Default,,0,0,0,,Toh loan plan ek headline pe
Dialogue: 0,0:01:20.66,0:01:21.44,Default,,0,0,0,,mat badlo.
Dialogue: 0,0:01:21.89,0:01:23.93,Default,,0,0,0,,Pehle apna budget dekho,
Dialogue: 0,0:01:23.93,0:01:24.70,Default,,0,0,0,,phir faisla.
Dialogue: 0,0:01:24.70,0:01:27.25,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:27.70,0:01:29.75,Default,,0,0,0,,Us bhai ko bhejo jo soch
Dialogue: 0,0:01:29.75,0:01:32.38,Default,,0,0,0,,raha hai EMI ab ghategi.
