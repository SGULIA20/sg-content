Dialogue: 0,0:00:00.00,0:00:02.52,Default,,0,0,0,,50 lakh ka home loan,
Dialogue: 0,0:00:02.52,0:00:05.40,Default,,0,0,0,,aur bank ko wapas 95,93,875 rupaye?
Dialogue: 0,0:00:05.40,0:00:05.76,Default,,0,0,0,,Haan,
Dialogue: 0,0:00:05.76,0:00:09.00,Default,,0,0,0,,yeh Bank of Baroda ke apne
Dialogue: 0,0:00:09.00,0:00:11.88,Default,,0,0,0,,calculator ka hisaab hai.
Dialogue: 0,0:00:11.88,0:00:14.04,Default,,0,0,0,,Matlab lagbhag double.
Dialogue: 0,0:00:14.49,0:00:15.79,Default,,0,0,0,,Ghar ek khareeda,
Dialogue: 0,0:00:15.79,0:00:17.35,Default,,0,0,0,,par bill lagbhag dugna.
Dialogue: 0,0:00:17.35,0:00:20.21,Default,,0,0,0,,Aur sabse bada jhatka abhi baaki
Dialogue: 0,0:00:20.21,0:00:20.47,Default,,0,0,0,,hai.
Dialogue: 0,0:00:20.47,0:00:22.81,Default,,0,0,0,,Shuru ke saalon ki EMI ka
Dialogue: 0,0:00:22.81,0:00:25.41,Default,,0,0,0,,zyaadatar hissa ghar mein jaata hi
Dialogue: 0,0:00:25.41,0:00:25.93,Default,,0,0,0,,nahi.
Dialogue: 0,0:00:26.38,0:00:28.76,Default,,0,0,0,,Yeh kahani hai Bhai ki.
Dialogue: 0,0:00:28.76,0:00:30.12,Default,,0,0,0,,Naukri pakki,
Dialogue: 0,0:00:30.12,0:00:31.82,Default,,0,0,0,,shaadi ho chuki,
Dialogue: 0,0:00:31.82,0:00:33.18,Default,,0,0,0,,aur sapna ek,
Dialogue: 0,0:00:33.18,0:00:34.20,Default,,0,0,0,,apna flat.
Dialogue: 0,0:00:34.20,0:00:36.58,Default,,0,0,0,,Bank Uncle ne loan pass kiya,
Dialogue: 0,0:00:36.58,0:00:39.30,Default,,0,0,0,,aur ghar mein mithai baati gayi.
Dialogue: 0,0:00:39.75,0:00:42.02,Default,,0,0,0,,Papa ne kandhe par haath rakha
Dialogue: 0,0:00:42.02,0:00:42.77,Default,,0,0,0,,aur bole,
Dialogue: 0,0:00:42.77,0:00:45.29,Default,,0,0,0,,bas EMI time par bharte rehna,
Dialogue: 0,0:00:45.29,0:00:47.56,Default,,0,0,0,,baaki sab apne aap ho jaayega.
Dialogue: 0,0:00:47.56,0:00:48.57,Default,,0,0,0,,Sabne maan liya.
Dialogue: 0,0:00:48.57,0:00:49.83,Default,,0,0,0,,Lekin kya sach mein?
Dialogue: 0,0:00:50.28,0:00:51.79,Default,,0,0,0,,Kyunki kuch saal baad,
Dialogue: 0,0:00:51.79,0:00:54.19,Default,,0,0,0,,Bhai ne pehli baar apna loan
Dialogue: 0,0:00:54.19,0:00:56.30,Default,,0,0,0,,statement dhyaan se khola.
Dialogue: 0,0:00:56.30,0:00:57.51,Default,,0,0,0,,Aur jo dekha,
Dialogue: 0,0:00:57.51,0:00:59.92,Default,,0,0,0,,us raat use neend nahi aayi.
Dialogue: 0,0:00:59.92,0:01:01.12,Default,,0,0,0,,Kya tha usme?
Dialogue: 0,0:01:01.57,0:01:03.32,Default,,0,0,0,,Itni EMI bhar di,
Dialogue: 0,0:01:03.32,0:01:05.94,Default,,0,0,0,,phir bhi bacha hua udhaar lagbhag
Dialogue: 0,0:01:05.94,0:01:07.40,Default,,0,0,0,,utna ka utna.
Dialogue: 0,0:01:07.40,0:01:09.15,Default,,0,0,0,,Toh paisa gaya kahaan?
Dialogue: 0,0:01:09.15,0:01:10.90,Default,,0,0,0,,Seedha bank ki jeb mein,
Dialogue: 0,0:01:10.90,0:01:11.77,Default,,0,0,0,,byaaj ban kar.
Dialogue: 0,0:01:12.22,0:01:13.60,Default,,0,0,0,,Toh aaj teen sawaal.
Dialogue: 0,0:01:13.60,0:01:14.15,Default,,0,0,0,,Pehla,
Dialogue: 0,0:01:14.15,0:01:16.64,Default,,0,0,0,,50 lakh ka loan lagbhag double
Dialogue: 0,0:01:16.64,0:01:18.29,Default,,0,0,0,,kaise ban jaata hai?
Dialogue: 0,0:01:18.29,0:01:18.84,Default,,0,0,0,,Doosra,
Dialogue: 0,0:01:18.84,0:01:21.33,Default,,0,0,0,,pehle saalon mein ghar ka kitna
Dialogue: 0,0:01:21.33,0:01:23.26,Default,,0,0,0,,hissa sach mein aapka hua?
Dialogue: 0,0:01:23.71,0:01:24.66,Default,,0,0,0,,Aur teesra,
Dialogue: 0,0:01:24.66,0:01:27.18,Default,,0,0,0,,saal mein sirf ek extra EMI
Dialogue: 0,0:01:27.18,0:01:30.01,Default,,0,0,0,,bharne se kitna byaaj aur kitne
Dialogue: 0,0:01:30.01,0:01:31.27,Default,,0,0,0,,saal bachte hain?
Dialogue: 0,0:01:31.27,0:01:34.11,Default,,0,0,0,,Teesre jawaab ke liye aakhir tak
Dialogue: 0,0:01:34.11,0:01:34.74,Default,,0,0,0,,rukna,
Dialogue: 0,0:01:34.74,0:01:36.63,Default,,0,0,0,,woh sabse kaam ka hai.
Dialogue: 0,0:01:37.08,0:01:39.49,Default,,0,0,0,,Par pehle chalte hain wahan,
Dialogue: 0,0:01:39.49,0:01:42.50,Default,,0,0,0,,jahan yeh kahani shuru hui thi.
Dialogue: 0,0:01:42.50,0:01:44.00,Default,,0,0,0,,Bank ki counter par,
Dialogue: 0,0:01:44.00,0:01:46.71,Default,,0,0,0,,jahan Bhai ne khushi khushi har
Dialogue: 0,0:01:46.71,0:01:48.52,Default,,0,0,0,,kaagaz par sign kiya tha.
Dialogue: 0,0:01:48.97,0:01:50.78,Default,,0,0,0,,Bank Uncle ne file kholi.
Dialogue: 0,0:01:50.78,0:01:51.46,Default,,0,0,0,,Pehli baat,
Dialogue: 0,0:01:51.46,0:01:53.49,Default,,0,0,0,,ghar ki poori keemat bank nahi
Dialogue: 0,0:01:53.49,0:01:53.94,Default,,0,0,0,,deta.
Dialogue: 0,0:01:53.94,0:01:55.98,Default,,0,0,0,,Kam se kam 20 percent aapko
Dialogue: 0,0:01:55.98,0:01:58.01,Default,,0,0,0,,apni jeb se dena padta hai.
Dialogue: 0,0:01:58.46,0:02:00.23,Default,,0,0,0,,Isse margin kehte hain,
Dialogue: 0,0:02:00.23,0:02:02.76,Default,,0,0,0,,yaani ghar mein aapka apna hissa.
Dialogue: 0,0:02:02.76,0:02:04.53,Default,,0,0,0,,Baaki sab bank ka udhaar.
Dialogue: 0,0:02:04.53,0:02:07.31,Default,,0,0,0,,Aur asli kahani isi udhaar se
Dialogue: 0,0:02:07.31,0:02:08.58,Default,,0,0,0,,shuru hoti hai.
Dialogue: 0,0:02:09.03,0:02:11.33,Default,,0,0,0,,Bhai ke papers par likha tha,
Dialogue: 0,0:02:11.33,0:02:13.05,Default,,0,0,0,,loan 50 lakh rupaye.
Dialogue: 0,0:02:13.05,0:02:16.21,Default,,0,0,0,,Is asal udhaar ko principal kehte
Dialogue: 0,0:02:16.21,0:02:16.50,Default,,0,0,0,,hain.
Dialogue: 0,0:02:16.50,0:02:18.79,Default,,0,0,0,,Yaani woh paisa jo bank ne
Dialogue: 0,0:02:18.79,0:02:20.23,Default,,0,0,0,,sach mein aapko diya.
Dialogue: 0,0:02:20.68,0:02:22.54,Default,,0,0,0,,Ab bank yeh paisa muft mein
Dialogue: 0,0:02:22.54,0:02:23.87,Default,,0,0,0,,toh dega nahi.
Dialogue: 0,0:02:23.87,0:02:26.26,Default,,0,0,0,,Udhaar ka bhi kiraya hota hai.
Dialogue: 0,0:02:26.26,0:02:28.66,Default,,0,0,0,,Usi kiraye ko byaaj kehte hain,
Dialogue: 0,0:02:28.66,0:02:30.52,Default,,0,0,0,,angrezi mein interest.
Dialogue: 0,0:02:30.97,0:02:33.73,Default,,0,0,0,,In dono ko milaakar banti hai
Dialogue: 0,0:02:33.73,0:02:34.28,Default,,0,0,0,,EMI.
Dialogue: 0,0:02:34.28,0:02:37.31,Default,,0,0,0,,EMI yaani har mahine ki fixed
Dialogue: 0,0:02:37.31,0:02:37.58,Default,,0,0,0,,kisht.
Dialogue: 0,0:02:37.58,0:02:39.79,Default,,0,0,0,,Har mahine wahi raqam,
Dialogue: 0,0:02:39.79,0:02:40.89,Default,,0,0,0,,20 saal tak,
Dialogue: 0,0:02:40.89,0:02:43.37,Default,,0,0,0,,bina ek bhi mahina chooke.
Dialogue: 0,0:02:43.82,0:02:47.21,Default,,0,0,0,,Ab Bank of Baroda ke calculator
Dialogue: 0,0:02:47.21,0:02:49.67,Default,,0,0,0,,mein 50 lakh ka loan daalo.
Dialogue: 0,0:02:49.67,0:02:52.75,Default,,0,0,0,,Akela byaaj aata hai 45,93,875 rupaye.
Dialogue: 0,0:02:52.75,0:02:56.14,Default,,0,0,0,,Yaani lagbhag asal udhaar jitna hi.
Dialogue: 0,0:02:56.59,0:02:58.18,Default,,0,0,0,,Socho zara.
Dialogue: 0,0:02:58.18,0:03:01.36,Default,,0,0,0,,Aapne 50 lakh udhaar liye,
Dialogue: 0,0:03:01.36,0:03:04.94,Default,,0,0,0,,aur upar se lagbhag utne hi
Dialogue: 0,0:03:04.94,0:03:07.73,Default,,0,0,0,,bank ko kiraye mein de diye.
Dialogue: 0,0:03:07.73,0:03:10.91,Default,,0,0,0,,Total bill ho gaya 95,93,875 rupaye.
Dialogue: 0,0:03:11.36,0:03:13.46,Default,,0,0,0,,Par aisa hota kyun hai?
Dialogue: 0,0:03:13.46,0:03:15.85,Default,,0,0,0,,Byaaj sirf ek baar nahi lagta.
Dialogue: 0,0:03:15.85,0:03:17.05,Default,,0,0,0,,Har mahine,
Dialogue: 0,0:03:17.05,0:03:19.15,Default,,0,0,0,,jitna udhaar bacha hai,
Dialogue: 0,0:03:19.15,0:03:21.54,Default,,0,0,0,,us poore par naya byaaj judta
Dialogue: 0,0:03:21.54,0:03:21.84,Default,,0,0,0,,hai.
Dialogue: 0,0:03:22.29,0:03:24.79,Default,,0,0,0,,Ise kiraye ke ghar jaisa samjho.
Dialogue: 0,0:03:24.79,0:03:26.79,Default,,0,0,0,,Jab tak aap usme rehte ho,
Dialogue: 0,0:03:26.79,0:03:29.05,Default,,0,0,0,,har mahine kiraya dete ho.
Dialogue: 0,0:03:29.05,0:03:30.80,Default,,0,0,0,,Udhaar bhi waisa hi hai,
Dialogue: 0,0:03:30.80,0:03:32.05,Default,,0,0,0,,jitni der rakho,
Dialogue: 0,0:03:32.05,0:03:33.05,Default,,0,0,0,,utna kiraya.
Dialogue: 0,0:03:33.50,0:03:35.57,Default,,0,0,0,,Aur 20 saal bahut lambi der
Dialogue: 0,0:03:35.57,0:03:35.81,Default,,0,0,0,,hai.
Dialogue: 0,0:03:35.81,0:03:37.88,Default,,0,0,0,,Itne saal bank ka paisa aapke
Dialogue: 0,0:03:37.88,0:03:38.80,Default,,0,0,0,,paas rehta hai.
Dialogue: 0,0:03:38.80,0:03:41.11,Default,,0,0,0,,Isliye kiraya bhi itna bada ho
Dialogue: 0,0:03:41.11,0:03:41.80,Default,,0,0,0,,jaata hai,
Dialogue: 0,0:03:41.80,0:03:43.18,Default,,0,0,0,,lagbhag udhaar jitna.
Dialogue: 0,0:03:43.63,0:03:45.45,Default,,0,0,0,,Toh kya yeh poora byaaj bank
Dialogue: 0,0:03:45.45,0:03:46.76,Default,,0,0,0,,ka munafa hai?
Dialogue: 0,0:03:46.76,0:03:47.28,Default,,0,0,0,,Nahi.
Dialogue: 0,0:03:47.28,0:03:49.10,Default,,0,0,0,,Bank ko bhi FD waalon ko
Dialogue: 0,0:03:49.10,0:03:50.66,Default,,0,0,0,,byaaj dena hota hai,
Dialogue: 0,0:03:50.66,0:03:52.49,Default,,0,0,0,,aur staff aur branch ka kharcha
Dialogue: 0,0:03:52.49,0:03:54.31,Default,,0,0,0,,bhi uthana hota hai.
Dialogue: 0,0:03:54.76,0:03:57.23,Default,,0,0,0,,Lekin aapki jeb ke liye hisaab
Dialogue: 0,0:03:57.23,0:03:58.06,Default,,0,0,0,,seedha hai.
Dialogue: 0,0:03:58.06,0:03:59.71,Default,,0,0,0,,Ghar ka udhaar alag,
Dialogue: 0,0:03:59.71,0:04:02.18,Default,,0,0,0,,aur upar se lagbhag utna hi
Dialogue: 0,0:04:02.18,0:04:02.45,Default,,0,0,0,,byaaj.
Dialogue: 0,0:04:02.45,0:04:04.93,Default,,0,0,0,,Yahi hai aapke ghar ka asli
Dialogue: 0,0:04:04.93,0:04:05.20,Default,,0,0,0,,bill.
Dialogue: 0,0:04:05.65,0:04:08.13,Default,,0,0,0,,Behen ne yeh number dekha toh
Dialogue: 0,0:04:08.13,0:04:08.68,Default,,0,0,0,,boli,
Dialogue: 0,0:04:08.68,0:04:09.23,Default,,0,0,0,,theek hai,
Dialogue: 0,0:04:09.23,0:04:10.34,Default,,0,0,0,,byaaj zyada hai.
Dialogue: 0,0:04:10.34,0:04:12.27,Default,,0,0,0,,Par har EMI ke saath ghar
Dialogue: 0,0:04:12.27,0:04:15.30,Default,,0,0,0,,thoda thoda apna toh hota jaata
Dialogue: 0,0:04:15.30,0:04:15.85,Default,,0,0,0,,hai na?
Dialogue: 0,0:04:16.30,0:04:19.11,Default,,0,0,0,,Yahi sabse badi galatfehmi hai.
Dialogue: 0,0:04:19.11,0:04:21.42,Default,,0,0,0,,Shuru ke saalon mein ghar bahut
Dialogue: 0,0:04:21.42,0:04:23.46,Default,,0,0,0,,hi dheere apna hota hai.
Dialogue: 0,0:04:23.46,0:04:24.49,Default,,0,0,0,,Kitna dheere?
Dialogue: 0,0:04:24.49,0:04:27.04,Default,,0,0,0,,Par asli sawaal ab shuru hota
Dialogue: 0,0:04:27.04,0:04:27.30,Default,,0,0,0,,hai.
Dialogue: 0,0:04:27.75,0:04:29.13,Default,,0,0,0,,Doosra sawaal.
Dialogue: 0,0:04:29.13,0:04:32.59,Default,,0,0,0,,Pehle saalon mein aapki EMI ka
Dialogue: 0,0:04:32.59,0:04:35.01,Default,,0,0,0,,kitna hissa ghar mein gaya,
Dialogue: 0,0:04:35.01,0:04:37.44,Default,,0,0,0,,aur kitna bank ki jeb mein?
Dialogue: 0,0:04:37.44,0:04:40.55,Default,,0,0,0,,Jawaab ek table mein chhupa hai.
Dialogue: 0,0:04:41.00,0:04:44.53,Default,,0,0,0,,Is table ko amortisation schedule kehte
Dialogue: 0,0:04:44.53,0:04:44.78,Default,,0,0,0,,hain.
Dialogue: 0,0:04:44.78,0:04:45.54,Default,,0,0,0,,Naam mushkil,
Dialogue: 0,0:04:45.54,0:04:46.29,Default,,0,0,0,,kaam seedha.
Dialogue: 0,0:04:46.29,0:04:48.31,Default,,0,0,0,,Har EMI mein kitna byaaj gaya,
Dialogue: 0,0:04:48.31,0:04:50.33,Default,,0,0,0,,kitna asal udhaar kata,
Dialogue: 0,0:04:50.33,0:04:51.84,Default,,0,0,0,,sab likha hota hai.
Dialogue: 0,0:04:52.29,0:04:53.88,Default,,0,0,0,,Bank yeh table deta hai,
Dialogue: 0,0:04:53.88,0:04:55.69,Default,,0,0,0,,aksar app mein bhi mil jaata
Dialogue: 0,0:04:55.69,0:04:55.92,Default,,0,0,0,,hai.
Dialogue: 0,0:04:55.92,0:04:58.42,Default,,0,0,0,,Par zyaadatar log ise kabhi kholte
Dialogue: 0,0:04:58.42,0:04:59.10,Default,,0,0,0,,hi nahi.
Dialogue: 0,0:04:59.10,0:05:01.14,Default,,0,0,0,,Bhai ne bhi kabhi nahi khola
Dialogue: 0,0:05:01.14,0:05:01.37,Default,,0,0,0,,tha.
Dialogue: 0,0:05:01.82,0:05:04.32,Default,,0,0,0,,Ab Bank of Baroda ka ek
Dialogue: 0,0:05:04.32,0:05:07.14,Default,,0,0,0,,20 saal ka schedule dekho.
Dialogue: 0,0:05:07.14,0:05:09.95,Default,,0,0,0,,Pehle saal poore saal ki EMI
Dialogue: 0,0:05:09.95,0:05:10.89,Default,,0,0,0,,bhari gayi,
Dialogue: 0,0:05:10.89,0:05:12.14,Default,,0,0,0,,kul 2,28,000 rupaye.
Dialogue: 0,0:05:12.14,0:05:14.02,Default,,0,0,0,,Ab andaaza lagao,
Dialogue: 0,0:05:14.02,0:05:15.90,Default,,0,0,0,,isme byaaj kitna tha?
Dialogue: 0,0:05:16.35,0:05:18.63,Default,,0,0,0,,Jawaab hai 1,82,261 rupaye.
Dialogue: 0,0:05:18.63,0:05:21.66,Default,,0,0,0,,Yaani saal bhar ki EMI ka
Dialogue: 0,0:05:21.66,0:05:25.08,Default,,0,0,0,,zyaadatar paisa seedha byaaj mein.
Dialogue: 0,0:05:25.08,0:05:28.87,Default,,0,0,0,,Asal udhaar mein toh bahut thoda
Dialogue: 0,0:05:28.87,0:05:29.63,Default,,0,0,0,,hi gaya.
Dialogue: 0,0:05:30.08,0:05:32.85,Default,,0,0,0,,Matlab poore saal EMI bharne ke
Dialogue: 0,0:05:32.85,0:05:33.40,Default,,0,0,0,,baad bhi,
Dialogue: 0,0:05:33.40,0:05:35.89,Default,,0,0,0,,udhaar lagbhag utna ka utna.
Dialogue: 0,0:05:35.89,0:05:38.38,Default,,0,0,0,,Ghar ka bahut chhota sa hissa
Dialogue: 0,0:05:38.38,0:05:40.04,Default,,0,0,0,,hi sach mein aapka hua.
Dialogue: 0,0:05:40.49,0:05:41.13,Default,,0,0,0,,Aisa kyun?
Dialogue: 0,0:05:41.13,0:05:43.50,Default,,0,0,0,,Shuru mein udhaar sabse bada hota
Dialogue: 0,0:05:43.50,0:05:43.71,Default,,0,0,0,,hai.
Dialogue: 0,0:05:43.71,0:05:45.21,Default,,0,0,0,,Toh us par byaaj bhi sabse
Dialogue: 0,0:05:45.21,0:05:46.29,Default,,0,0,0,,bada banta hai.
Dialogue: 0,0:05:46.29,0:05:48.43,Default,,0,0,0,,Aur EMI ka bada hissa wahi
Dialogue: 0,0:05:48.43,0:05:49.29,Default,,0,0,0,,kha jaata hai.
Dialogue: 0,0:05:49.74,0:05:51.79,Default,,0,0,0,,Jaise jaise udhaar ghatta hai,
Dialogue: 0,0:05:51.79,0:05:52.93,Default,,0,0,0,,byaaj bhi ghatta hai.
Dialogue: 0,0:05:52.93,0:05:55.21,Default,,0,0,0,,Tab EMI ka zyada hissa asal
Dialogue: 0,0:05:55.21,0:05:57.03,Default,,0,0,0,,udhaar mein jaane lagta hai.
Dialogue: 0,0:05:57.03,0:05:59.31,Default,,0,0,0,,Lekin yeh bahut saalon baad hota
Dialogue: 0,0:05:59.31,0:05:59.54,Default,,0,0,0,,hai.
Dialogue: 0,0:05:59.99,0:06:02.63,Default,,0,0,0,,Isi ko front-loaded byaaj kehte hain.
Dialogue: 0,0:06:02.63,0:06:05.27,Default,,0,0,0,,Yaani bank apna kiraya shuru ke
Dialogue: 0,0:06:05.27,0:06:07.90,Default,,0,0,0,,saalon mein hi zyada vasool karta
Dialogue: 0,0:06:07.90,0:06:08.17,Default,,0,0,0,,hai.
Dialogue: 0,0:06:08.17,0:06:11.33,Default,,0,0,0,,Aakhri saalon ki EMI zyaadatar asal
Dialogue: 0,0:06:11.33,0:06:12.39,Default,,0,0,0,,chukaati hai.
Dialogue: 0,0:06:12.84,0:06:13.73,Default,,0,0,0,,Ab samjhe,
Dialogue: 0,0:06:13.73,0:06:15.80,Default,,0,0,0,,Bhai ko neend kyun nahi aayi?
Dialogue: 0,0:06:15.80,0:06:18.16,Default,,0,0,0,,Kuch saal EMI bharne ke baad
Dialogue: 0,0:06:18.16,0:06:18.46,Default,,0,0,0,,bhi,
Dialogue: 0,0:06:18.46,0:06:21.71,Default,,0,0,0,,statement mein bacha hua udhaar pahaad
Dialogue: 0,0:06:21.71,0:06:23.48,Default,,0,0,0,,jaisa dikh raha tha.
Dialogue: 0,0:06:23.93,0:06:25.44,Default,,0,0,0,,Aur ek khatra bhi tha.
Dialogue: 0,0:06:25.44,0:06:27.46,Default,,0,0,0,,Bhai ka loan floating rate par
Dialogue: 0,0:06:27.46,0:06:27.71,Default,,0,0,0,,tha.
Dialogue: 0,0:06:27.71,0:06:29.98,Default,,0,0,0,,Floating rate yaani byaaj RBI ke
Dialogue: 0,0:06:29.98,0:06:32.49,Default,,0,0,0,,faislon ke saath upar neeche hota
Dialogue: 0,0:06:32.49,0:06:33.25,Default,,0,0,0,,rehta hai.
Dialogue: 0,0:06:33.70,0:06:34.57,Default,,0,0,0,,Byaaj badhe,
Dialogue: 0,0:06:34.57,0:06:37.47,Default,,0,0,0,,toh bank aksar EMI nahi chhedta.
Dialogue: 0,0:06:37.47,0:06:40.07,Default,,0,0,0,,Chupchaap loan ke saal badha deta
Dialogue: 0,0:06:40.07,0:06:40.36,Default,,0,0,0,,hai.
Dialogue: 0,0:06:40.36,0:06:42.10,Default,,0,0,0,,Aur lambe saal matlab,
Dialogue: 0,0:06:42.10,0:06:44.42,Default,,0,0,0,,aur zyada mahine ka byaaj.
Dialogue: 0,0:06:44.87,0:06:46.95,Default,,0,0,0,,Toh sirf EMI time par bharna
Dialogue: 0,0:06:46.95,0:06:48.10,Default,,0,0,0,,kaafi nahi hai.
Dialogue: 0,0:06:48.10,0:06:50.18,Default,,0,0,0,,Papa ki baat aadhi hi sahi
Dialogue: 0,0:06:50.18,0:06:50.41,Default,,0,0,0,,thi.
Dialogue: 0,0:06:50.41,0:06:52.49,Default,,0,0,0,,Lekin is jaal se nikalne ka
Dialogue: 0,0:06:52.49,0:06:53.87,Default,,0,0,0,,ek seedha raasta hai.
Dialogue: 0,0:06:54.32,0:06:56.88,Default,,0,0,0,,Mummy ne chai rakhi aur poocha,
Dialogue: 0,0:06:56.88,0:06:58.88,Default,,0,0,0,,toh kya hum 20 saal tak
Dialogue: 0,0:06:58.88,0:07:01.73,Default,,0,0,0,,bas bank ka kiraya bharte rahenge?
Dialogue: 0,0:07:01.73,0:07:03.15,Default,,0,0,0,,Behen muskurayi.
Dialogue: 0,0:07:03.15,0:07:04.30,Default,,0,0,0,,Nahi Mummy,
Dialogue: 0,0:07:04.30,0:07:05.72,Default,,0,0,0,,ek tareeka hai.
Dialogue: 0,0:07:06.17,0:07:07.55,Default,,0,0,0,,Teesra sawaal,
Dialogue: 0,0:07:07.55,0:07:09.28,Default,,0,0,0,,aur sabse kaam ka.
Dialogue: 0,0:07:09.28,0:07:12.05,Default,,0,0,0,,Agar saal mein sirf ek extra
Dialogue: 0,0:07:12.05,0:07:13.43,Default,,0,0,0,,EMI bhar do,
Dialogue: 0,0:07:13.43,0:07:14.82,Default,,0,0,0,,toh kya hoga?
Dialogue: 0,0:07:14.82,0:07:17.93,Default,,0,0,0,,Jawaab sunkar aap shayad chaunk jaayenge.
Dialogue: 0,0:07:18.38,0:07:20.66,Default,,0,0,0,,Isse prepayment kehte hain.
Dialogue: 0,0:07:20.66,0:07:22.65,Default,,0,0,0,,Yaani time se pehle,
Dialogue: 0,0:07:22.65,0:07:24.07,Default,,0,0,0,,apni marzi se,
Dialogue: 0,0:07:24.07,0:07:26.92,Default,,0,0,0,,loan mein extra paisa jama karna.
Dialogue: 0,0:07:26.92,0:07:29.76,Default,,0,0,0,,Yeh paisa seedha asal udhaar ko
Dialogue: 0,0:07:29.76,0:07:30.90,Default,,0,0,0,,kam karta hai.
Dialogue: 0,0:07:31.35,0:07:33.70,Default,,0,0,0,,Aur yahi iska jaadu hai.
Dialogue: 0,0:07:33.70,0:07:35.47,Default,,0,0,0,,Asal udhaar kam hua,
Dialogue: 0,0:07:35.47,0:07:38.12,Default,,0,0,0,,toh agle mahine se us par
Dialogue: 0,0:07:38.12,0:07:39.89,Default,,0,0,0,,byaaj bhi kam lagega.
Dialogue: 0,0:07:39.89,0:07:41.06,Default,,0,0,0,,Har mahine,
Dialogue: 0,0:07:41.06,0:07:42.83,Default,,0,0,0,,loan ke aakhri din tak.
Dialogue: 0,0:07:43.28,0:07:46.51,Default,,0,0,0,,The Economic Times ne ek hisaab
Dialogue: 0,0:07:46.51,0:07:47.10,Default,,0,0,0,,chhapa.
Dialogue: 0,0:07:47.10,0:07:48.57,Default,,0,0,0,,50 lakh ka loan,
Dialogue: 0,0:07:48.57,0:07:50.92,Default,,0,0,0,,Bhai ke loan se thoda lamba.
Dialogue: 0,0:07:50.92,0:07:53.28,Default,,0,0,0,,Bas saal mein ek extra EMI,
Dialogue: 0,0:07:53.28,0:07:55.04,Default,,0,0,0,,aur kuch nahi badla.
Dialogue: 0,0:07:55.49,0:07:57.37,Default,,0,0,0,,Report ke mutabik,
Dialogue: 0,0:07:57.37,0:07:59.88,Default,,0,0,0,,byaaj mein lagbhag 18.31 lakh rupaye
Dialogue: 0,0:07:59.88,0:08:00.51,Default,,0,0,0,,bache.
Dialogue: 0,0:08:00.51,0:08:01.14,Default,,0,0,0,,Socho,
Dialogue: 0,0:08:01.14,0:08:03.34,Default,,0,0,0,,saal mein sirf ek extra kisht,
Dialogue: 0,0:08:03.34,0:08:05.85,Default,,0,0,0,,aur lakhon rupaye ki bachat.
Dialogue: 0,0:08:06.30,0:08:08.00,Default,,0,0,0,,Aur loan bhi 5 saal se
Dialogue: 0,0:08:08.00,0:08:09.71,Default,,0,0,0,,zyada pehle khatam.
Dialogue: 0,0:08:09.71,0:08:12.55,Default,,0,0,0,,Yaani saalon tak koi EMI nahi.
Dialogue: 0,0:08:12.55,0:08:15.10,Default,,0,0,0,,Woh paisa bachchon ki padhai ya
Dialogue: 0,0:08:15.10,0:08:17.66,Default,,0,0,0,,budhape ke kaam aa sakta hai.
Dialogue: 0,0:08:18.11,0:08:19.72,Default,,0,0,0,,Itna bada fark kyun?
Dialogue: 0,0:08:19.72,0:08:22.68,Default,,0,0,0,,Kyunki extra paisa shuru ke saalon
Dialogue: 0,0:08:22.68,0:08:23.75,Default,,0,0,0,,mein jaata hai,
Dialogue: 0,0:08:23.75,0:08:26.17,Default,,0,0,0,,jab udhaar sabse bada hai aur
Dialogue: 0,0:08:26.17,0:08:28.59,Default,,0,0,0,,byaaj sabse zyada kaat raha hai.
Dialogue: 0,0:08:29.04,0:08:31.34,Default,,0,0,0,,Wahi front-loading jo ab tak aapke
Dialogue: 0,0:08:31.34,0:08:32.03,Default,,0,0,0,,khilaaf thi,
Dialogue: 0,0:08:32.03,0:08:33.88,Default,,0,0,0,,ab aapke saath kaam karti hai.
Dialogue: 0,0:08:33.88,0:08:35.72,Default,,0,0,0,,Jitna jaldi prepay karo,
Dialogue: 0,0:08:35.72,0:08:37.56,Default,,0,0,0,,utna zyada byaaj bachta hai.
Dialogue: 0,0:08:38.01,0:08:39.70,Default,,0,0,0,,Bhai ne Behen se poocha,
Dialogue: 0,0:08:39.70,0:08:42.11,Default,,0,0,0,,par ek extra EMI aayegi kahaan
Dialogue: 0,0:08:42.11,0:08:42.35,Default,,0,0,0,,se?
Dialogue: 0,0:08:42.35,0:08:43.31,Default,,0,0,0,,Behen boli,
Dialogue: 0,0:08:43.31,0:08:44.75,Default,,0,0,0,,Diwali ka bonus.
Dialogue: 0,0:08:44.75,0:08:47.16,Default,,0,0,0,,Ya har mahine EMI ka thoda
Dialogue: 0,0:08:47.16,0:08:49.09,Default,,0,0,0,,thoda hissa alag rakho.
Dialogue: 0,0:08:49.54,0:08:52.03,Default,,0,0,0,,Saal ke aakhir tak ek EMI
Dialogue: 0,0:08:52.03,0:08:54.52,Default,,0,0,0,,jitna paisa jud jaata hai.
Dialogue: 0,0:08:54.52,0:08:56.07,Default,,0,0,0,,Woh seedha bank mein,
Dialogue: 0,0:08:56.07,0:08:57.94,Default,,0,0,0,,prepayment ke naam par.
Dialogue: 0,0:08:57.94,0:08:59.50,Default,,0,0,0,,Bas itna sa kaam,
Dialogue: 0,0:08:59.50,0:09:00.74,Default,,0,0,0,,saal mein ek baar.
Dialogue: 0,0:09:01.19,0:09:02.50,Default,,0,0,0,,Par Papa ko darr tha.
Dialogue: 0,0:09:02.50,0:09:05.11,Default,,0,0,0,,Bank waale penalty toh nahi lagayenge?
Dialogue: 0,0:09:05.11,0:09:06.64,Default,,0,0,0,,Pehle paisa lautaoge,
Dialogue: 0,0:09:06.64,0:09:08.60,Default,,0,0,0,,toh unka byaaj ka nuksaan hoga
Dialogue: 0,0:09:08.60,0:09:08.82,Default,,0,0,0,,na?
Dialogue: 0,0:09:08.82,0:09:09.91,Default,,0,0,0,,Sawaal sahi tha.
Dialogue: 0,0:09:10.36,0:09:12.12,Default,,0,0,0,,Yahan RBI ka ek saaf niyam
Dialogue: 0,0:09:12.12,0:09:13.63,Default,,0,0,0,,aapke kaam aata hai.
Dialogue: 0,0:09:13.63,0:09:15.65,Default,,0,0,0,,Floating rate home loan par,
Dialogue: 0,0:09:15.65,0:09:17.91,Default,,0,0,0,,banks prepayment ya loan jaldi band
Dialogue: 0,0:09:17.91,0:09:20.68,Default,,0,0,0,,karne ki penalty nahi le sakte.
Dialogue: 0,0:09:21.13,0:09:23.54,Default,,0,0,0,,Yaani aapka loan floating rate par
Dialogue: 0,0:09:23.54,0:09:23.78,Default,,0,0,0,,hai,
Dialogue: 0,0:09:23.78,0:09:26.19,Default,,0,0,0,,toh extra paisa jama karne par
Dialogue: 0,0:09:26.19,0:09:28.60,Default,,0,0,0,,bank koi penalty nahi maang sakta.
Dialogue: 0,0:09:28.60,0:09:29.80,Default,,0,0,0,,Yeh aapka haq hai,
Dialogue: 0,0:09:29.80,0:09:31.73,Default,,0,0,0,,bank ki meherbaani nahi.
Dialogue: 0,0:09:32.18,0:09:33.38,Default,,0,0,0,,Ek baat dhyaan rakho.
Dialogue: 0,0:09:33.38,0:09:35.55,Default,,0,0,0,,Prepay karte waqt bank ko likhkar
Dialogue: 0,0:09:35.55,0:09:36.04,Default,,0,0,0,,bolo,
Dialogue: 0,0:09:36.04,0:09:37.48,Default,,0,0,0,,EMI wahi rakho,
Dialogue: 0,0:09:37.48,0:09:38.93,Default,,0,0,0,,loan ke saal kam karo.
Dialogue: 0,0:09:38.93,0:09:41.34,Default,,0,0,0,,Byaaj ki zyaadatar bachat isi mein
Dialogue: 0,0:09:41.34,0:09:41.58,Default,,0,0,0,,hai.
Dialogue: 0,0:09:42.03,0:09:44.52,Default,,0,0,0,,Bhai ne usi hafte bank jaakar
Dialogue: 0,0:09:44.52,0:09:47.00,Default,,0,0,0,,pehli extra EMI jama ki.
Dialogue: 0,0:09:47.00,0:09:49.77,Default,,0,0,0,,Statement mein pehli baar udhaar sach
Dialogue: 0,0:09:49.77,0:09:50.87,Default,,0,0,0,,mein kam dikha.
Dialogue: 0,0:09:50.87,0:09:51.70,Default,,0,0,0,,Par ruko,
Dialogue: 0,0:09:51.70,0:09:53.91,Default,,0,0,0,,ek galti abhi baaki hai.
Dialogue: 0,0:09:54.36,0:09:56.23,Default,,0,0,0,,Ab woh galti jo bahut log
Dialogue: 0,0:09:56.23,0:09:56.92,Default,,0,0,0,,karte hain.
Dialogue: 0,0:09:56.92,0:09:57.86,Default,,0,0,0,,Woh sochte hain,
Dialogue: 0,0:09:57.86,0:09:59.72,Default,,0,0,0,,home loan par tax toh bachta
Dialogue: 0,0:09:59.72,0:09:59.96,Default,,0,0,0,,hai,
Dialogue: 0,0:09:59.96,0:10:02.52,Default,,0,0,0,,phir jaldi chukaane ki kya zaroorat?
Dialogue: 0,0:10:02.97,0:10:03.28,Default,,0,0,0,,Haan,
Dialogue: 0,0:10:03.28,0:10:04.80,Default,,0,0,0,,tax ka fayda hai.
Dialogue: 0,0:10:04.80,0:10:06.03,Default,,0,0,0,,Section 24(b) mein,
Dialogue: 0,0:10:06.03,0:10:08.78,Default,,0,0,0,,apne rehne waale ghar ke loan
Dialogue: 0,0:10:08.78,0:10:09.70,Default,,0,0,0,,ke byaaj par,
Dialogue: 0,0:10:09.70,0:10:12.45,Default,,0,0,0,,saal mein 2,00,000 rupaye tak deduction
Dialogue: 0,0:10:12.45,0:10:13.37,Default,,0,0,0,,milta hai.
Dialogue: 0,0:10:13.82,0:10:16.97,Default,,0,0,0,,Deduction yaani itni income par tax
Dialogue: 0,0:10:16.97,0:10:18.02,Default,,0,0,0,,nahi lagta.
Dialogue: 0,0:10:18.02,0:10:20.91,Default,,0,0,0,,Asal udhaar chukaane par Section 80C
Dialogue: 0,0:10:20.91,0:10:22.22,Default,,0,0,0,,mein bhi fayda hai,
Dialogue: 0,0:10:22.22,0:10:24.85,Default,,0,0,0,,PPF jaisi cheezon ke saath milaakar
Dialogue: 0,0:10:24.85,0:10:25.90,Default,,0,0,0,,1,50,000 rupaye tak.
Dialogue: 0,0:10:26.35,0:10:26.97,Default,,0,0,0,,Par dhyaan do,
Dialogue: 0,0:10:26.97,0:10:29.22,Default,,0,0,0,,yeh dono fayde purane tax system
Dialogue: 0,0:10:29.22,0:10:30.04,Default,,0,0,0,,mein milte hain.
Dialogue: 0,0:10:30.04,0:10:31.89,Default,,0,0,0,,Naye tax system mein apne rehne
Dialogue: 0,0:10:31.89,0:10:33.94,Default,,0,0,0,,waale ghar par yeh deduction nahi
Dialogue: 0,0:10:33.94,0:10:34.35,Default,,0,0,0,,milte.
Dialogue: 0,0:10:34.80,0:10:36.24,Default,,0,0,0,,Aur sabse badi baat.
Dialogue: 0,0:10:36.24,0:10:37.68,Default,,0,0,0,,Tax mein jo bachta hai,
Dialogue: 0,0:10:37.68,0:10:39.36,Default,,0,0,0,,woh byaaj ka sirf ek hissa
Dialogue: 0,0:10:39.36,0:10:39.60,Default,,0,0,0,,hai.
Dialogue: 0,0:10:39.60,0:10:41.04,Default,,0,0,0,,Bank ko diya baaki byaaj,
Dialogue: 0,0:10:41.04,0:10:42.72,Default,,0,0,0,,phir bhi aapki jeb se hi
Dialogue: 0,0:10:42.72,0:10:42.96,Default,,0,0,0,,gaya.
Dialogue: 0,0:10:43.41,0:10:45.55,Default,,0,0,0,,Toh aapke liye seedhi baat kya
Dialogue: 0,0:10:45.55,0:10:45.82,Default,,0,0,0,,hai?
Dialogue: 0,0:10:45.82,0:10:47.96,Default,,0,0,0,,Apna loan statement kholo.
Dialogue: 0,0:10:47.96,0:10:48.49,Default,,0,0,0,,Dekho,
Dialogue: 0,0:10:48.49,0:10:50.63,Default,,0,0,0,,is saal ki EMI mein kitna
Dialogue: 0,0:10:50.63,0:10:51.16,Default,,0,0,0,,byaaj gaya,
Dialogue: 0,0:10:51.16,0:10:53.57,Default,,0,0,0,,aur kitna asal udhaar kata.
Dialogue: 0,0:10:54.02,0:10:54.90,Default,,0,0,0,,Phir check karo,
Dialogue: 0,0:10:54.90,0:10:56.87,Default,,0,0,0,,aapka loan floating rate par hai
Dialogue: 0,0:10:56.87,0:10:57.53,Default,,0,0,0,,ya fixed.
Dialogue: 0,0:10:57.53,0:10:58.19,Default,,0,0,0,,Floating hai,
Dialogue: 0,0:10:58.19,0:11:00.61,Default,,0,0,0,,toh prepayment par penalty ka sawaal
Dialogue: 0,0:11:00.61,0:11:01.26,Default,,0,0,0,,hi nahi.
Dialogue: 0,0:11:01.26,0:11:01.70,Default,,0,0,0,,Shaq ho,
Dialogue: 0,0:11:01.70,0:11:03.46,Default,,0,0,0,,toh bank se likhit mein poocho.
Dialogue: 0,0:11:03.91,0:11:04.14,Default,,0,0,0,,Haan,
Dialogue: 0,0:11:04.14,0:11:06.88,Default,,0,0,0,,prepay karne se pehle emergency ke
Dialogue: 0,0:11:06.88,0:11:09.16,Default,,0,0,0,,liye kuch paisa alag zaroor rakho.
Dialogue: 0,0:11:09.16,0:11:10.76,Default,,0,0,0,,Aur apne CA se tax ka
Dialogue: 0,0:11:10.76,0:11:12.13,Default,,0,0,0,,hisaab bhi milaa lo,
Dialogue: 0,0:11:12.13,0:11:14.19,Default,,0,0,0,,khaaskar purana ya naya system.
Dialogue: 0,0:11:14.64,0:11:17.13,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:11:17.13,0:11:19.62,Default,,0,0,0,,Har ghar ki zaroorat alag hoti
Dialogue: 0,0:11:19.62,0:11:19.87,Default,,0,0,0,,hai.
Dialogue: 0,0:11:19.87,0:11:21.36,Default,,0,0,0,,Par ek baat har ghar par
Dialogue: 0,0:11:21.36,0:11:22.11,Default,,0,0,0,,lagti hai,
Dialogue: 0,0:11:22.11,0:11:24.60,Default,,0,0,0,,apni EMI ka table samajhna.
Dialogue: 0,0:11:25.05,0:11:27.21,Default,,0,0,0,,Bhai ki kahani yaad karo.
Dialogue: 0,0:11:27.21,0:11:28.57,Default,,0,0,0,,50 lakh ka loan,
Dialogue: 0,0:11:28.57,0:11:30.19,Default,,0,0,0,,aur bill lagbhag double.
Dialogue: 0,0:11:30.19,0:11:32.08,Default,,0,0,0,,Par ab use pata hai,
Dialogue: 0,0:11:32.08,0:11:34.52,Default,,0,0,0,,EMI sirf bharni nahi hoti,
Dialogue: 0,0:11:34.52,0:11:36.41,Default,,0,0,0,,samajhni bhi padti hai.
Dialogue: 0,0:11:36.86,0:11:39.02,Default,,0,0,0,,Agle video mein ek aur bada
Dialogue: 0,0:11:39.02,0:11:39.50,Default,,0,0,0,,sawaal.
Dialogue: 0,0:11:39.50,0:11:41.18,Default,,0,0,0,,Ghar khareedna behtar hai,
Dialogue: 0,0:11:41.18,0:11:43.82,Default,,0,0,0,,ya kiraye par rehkar paisa bachana?
Dialogue: 0,0:11:43.82,0:11:45.98,Default,,0,0,0,,Jawaab shayad aapki soch badal de.
Dialogue: 0,0:11:46.43,0:11:49.01,Default,,0,0,0,,Aur ab aapse ek aasaan sawaal.
Dialogue: 0,0:11:49.01,0:11:51.87,Default,,0,0,0,,Aapka home loan floating rate par
Dialogue: 0,0:11:51.87,0:11:53.02,Default,,0,0,0,,hai ya fixed?
Dialogue: 0,0:11:53.02,0:11:54.45,Default,,0,0,0,,Comments mein likho,
Dialogue: 0,0:11:54.45,0:11:55.88,Default,,0,0,0,,floating ya fixed.
Dialogue: 0,0:11:55.88,0:11:57.03,Default,,0,0,0,,Main padhunga.
