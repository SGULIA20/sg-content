Dialogue: 0,0:00:42.35,0:00:44.43,Default,,0,0,0,,Ek sector mein 20 se 25
Dialogue: 0,0:00:44.43,0:00:45.59,Default,,0,0,0,,percent se zyada,
Dialogue: 0,0:00:45.59,0:00:46.51,Default,,0,0,0,,toh risk zyada.
Dialogue: 0,0:00:46.96,0:00:49.39,Default,,0,0,0,,SIP mein girawat ka matlab,
Dialogue: 0,0:00:49.39,0:00:51.52,Default,,0,0,0,,kam daam par zyada units.
Dialogue: 0,0:00:51.97,0:00:53.94,Default,,0,0,0,,AI ka future bada hai,
Dialogue: 0,0:00:53.94,0:00:55.91,Default,,0,0,0,,par har AI share ka nahi.
Dialogue: 0,0:00:55.91,0:00:58.37,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:58.82,0:01:00.46,Default,,0,0,0,,Us bhai ko bhejo jo sirf
Dialogue: 0,0:01:00.46,0:01:01.86,Default,,0,0,0,,AI stocks khareedta hai.
