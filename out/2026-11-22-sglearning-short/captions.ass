Dialogue: 0,0:00:00.00,0:00:01.74,Default,,0,0,0,,Galat UPI ID par paisa gaya,
Dialogue: 0,0:00:01.74,0:00:03.48,Default,,0,0,0,,bank khud wapas kyun nahi karta?
Dialogue: 0,0:00:03.93,0:00:04.62,Default,,0,0,0,,Rent bhejna tha,
Dialogue: 0,0:00:04.62,0:00:05.83,Default,,0,0,0,,ek digit galat dab gaya.
Dialogue: 0,0:00:05.83,0:00:07.55,Default,,0,0,0,,Paisa kisi anjaan ke khate mein
Dialogue: 0,0:00:07.55,0:00:08.07,Default,,0,0,0,,chala gaya.
Dialogue: 0,0:00:08.52,0:00:09.58,Default,,0,0,0,,Log kya karte hain?
Dialogue: 0,0:00:09.58,0:00:10.43,Default,,0,0,0,,Bas intezaar,
Dialogue: 0,0:00:10.43,0:00:11.50,Default,,0,0,0,,ya branch ka chakkar.
Dialogue: 0,0:00:11.95,0:00:12.82,Default,,0,0,0,,Soch seedhi hai:
Dialogue: 0,0:00:12.82,0:00:13.69,Default,,0,0,0,,galti meri,
Dialogue: 0,0:00:13.69,0:00:14.56,Default,,0,0,0,,paisa mera,
Dialogue: 0,0:00:14.56,0:00:15.65,Default,,0,0,0,,bank palat dega.
Dialogue: 0,0:00:16.10,0:00:16.84,Default,,0,0,0,,Par twist yeh hai.
Dialogue: 0,0:00:16.84,0:00:18.70,Default,,0,0,0,,Paane wale ki marzi ke bina
Dialogue: 0,0:00:18.70,0:00:20.18,Default,,0,0,0,,bank paisa nahi kaat sakta.
Dialogue: 0,0:00:20.63,0:00:22.49,Default,,0,0,0,,Isliye turant UPI app mein complaint
Dialogue: 0,0:00:22.49,0:00:22.86,Default,,0,0,0,,daalo,
Dialogue: 0,0:00:22.86,0:00:24.16,Default,,0,0,0,,phir bank ko likh kar batao.
Dialogue: 0,0:00:24.61,0:00:26.45,Default,,0,0,0,,Bank 30 din mein na suljhaye,
Dialogue: 0,0:00:26.45,0:00:27.82,Default,,0,0,0,,to RBI Ombudsman jao,
Dialogue: 0,0:00:27.82,0:00:29.43,Default,,0,0,0,,yaani free shikayat daftar.
Dialogue: 0,0:00:29.88,0:00:30.98,Default,,0,0,0,,Lekin der mat karo.
Dialogue: 0,0:00:30.98,0:00:32.63,Default,,0,0,0,,Uske baad sirf 90 din milte
Dialogue: 0,0:00:32.63,0:00:32.81,Default,,0,0,0,,hain.
Dialogue: 0,0:00:32.81,0:00:34.65,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:35.10,0:00:36.20,Default,,0,0,0,,Yeh Mummy ko bhejo,
Dialogue: 0,0:00:36.20,0:00:37.68,Default,,0,0,0,,jo roz UPI se sabzi ka
Dialogue: 0,0:00:37.68,0:00:38.61,Default,,0,0,0,,paisa bhejti hain.
