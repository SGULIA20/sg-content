Dialogue: 0,0:00:00.00,0:00:01.09,Default,,0,0,0,,Results ka din hai,
Dialogue: 0,0:00:01.09,0:00:03.50,Default,,0,0,0,,aur Bhai ke phone par notification
Dialogue: 0,0:00:03.50,0:00:04.16,Default,,0,0,0,,bajta hai.
Dialogue: 0,0:00:04.61,0:00:05.13,Default,,0,0,0,,Swiggy,
Dialogue: 0,0:00:05.13,0:00:05.40,Default,,0,0,0,,HPCL,
Dialogue: 0,0:00:05.40,0:00:06.18,Default,,0,0,0,,Colgate,
Dialogue: 0,0:00:06.18,0:00:09.33,Default,,0,0,0,,sab aaj apna quarterly profit batayenge.
Dialogue: 0,0:00:09.78,0:00:10.63,Default,,0,0,0,,Bhai kehta hai,
Dialogue: 0,0:00:10.63,0:00:11.92,Default,,0,0,0,,yeh traders ka khel hai.
Dialogue: 0,0:00:11.92,0:00:13.63,Default,,0,0,0,,Main share nahi kharidta,
Dialogue: 0,0:00:13.63,0:00:15.34,Default,,0,0,0,,main toh bas har mahine SIP
Dialogue: 0,0:00:15.34,0:00:15.98,Default,,0,0,0,,karta hoon.
Dialogue: 0,0:00:16.43,0:00:19.01,Default,,0,0,0,,SIP yaani har mahine fixed paisa
Dialogue: 0,0:00:19.01,0:00:19.95,Default,,0,0,0,,mutual fund mein.
Dialogue: 0,0:00:19.95,0:00:21.82,Default,,0,0,0,,Fund manager sambhalega,
Dialogue: 0,0:00:21.82,0:00:23.23,Default,,0,0,0,,mujhe results se kya.
Dialogue: 0,0:00:23.68,0:00:25.83,Default,,0,0,0,,Lekin usi list mein ek naam
Dialogue: 0,0:00:25.83,0:00:26.36,Default,,0,0,0,,aur tha,
Dialogue: 0,0:00:26.36,0:00:28.24,Default,,0,0,0,,Nippon Life India AMC.
Dialogue: 0,0:00:28.69,0:00:31.37,Default,,0,0,0,,AMC yaani asset management company,
Dialogue: 0,0:00:31.37,0:00:33.39,Default,,0,0,0,,woh company jo aapke SIP ka
Dialogue: 0,0:00:33.39,0:00:34.73,Default,,0,0,0,,paisa chalati hai.
Dialogue: 0,0:00:35.18,0:00:36.95,Default,,0,0,0,,Analysts ka andaaza hai,
Dialogue: 0,0:00:36.95,0:00:39.17,Default,,0,0,0,,is quarter uska net profit lagbhag
Dialogue: 0,0:00:39.17,0:00:40.94,Default,,0,0,0,,4.22 billion rupaye rahega.
Dialogue: 0,0:00:41.39,0:00:43.66,Default,,0,0,0,,Yeh paisa aata kahan se hai?
Dialogue: 0,0:00:43.66,0:00:46.19,Default,,0,0,0,,Aapke jaise lakhon SIP walon se.
Dialogue: 0,0:00:46.64,0:00:48.26,Default,,0,0,0,,Har fund har saal ek chhoti
Dialogue: 0,0:00:48.26,0:00:49.19,Default,,0,0,0,,fees kaat-ta hai,
Dialogue: 0,0:00:49.19,0:00:51.51,Default,,0,0,0,,jise expense ratio kehte hain.
Dialogue: 0,0:00:51.51,0:00:53.14,Default,,0,0,0,,Yeh fees fund ki value se
Dialogue: 0,0:00:53.14,0:00:54.53,Default,,0,0,0,,chupchap kat jaati hai,
Dialogue: 0,0:00:54.53,0:00:55.92,Default,,0,0,0,,koi bill nahi aata.
Dialogue: 0,0:00:56.37,0:00:57.58,Default,,0,0,0,,Ab twist suniye.
Dialogue: 0,0:00:57.58,0:00:59.99,Default,,0,0,0,,Market upar jaaye ya neeche,
Dialogue: 0,0:00:59.99,0:01:02.11,Default,,0,0,0,,yeh fees har haal mein kat-ti
Dialogue: 0,0:01:02.11,0:01:02.41,Default,,0,0,0,,hai.
Dialogue: 0,0:01:02.86,0:01:05.19,Default,,0,0,0,,Matlab fund house ki kamai zyadatar
Dialogue: 0,0:01:05.19,0:01:07.31,Default,,0,0,0,,aapke paise ke size se aati
Dialogue: 0,0:01:07.31,0:01:07.52,Default,,0,0,0,,hai,
Dialogue: 0,0:01:07.52,0:01:08.58,Default,,0,0,0,,return se nahi.
Dialogue: 0,0:01:09.03,0:01:10.69,Default,,0,0,0,,Toh aaj apne fund ka expense
Dialogue: 0,0:01:10.69,0:01:11.43,Default,,0,0,0,,ratio dekhiye.
Dialogue: 0,0:01:11.43,0:01:13.27,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:13.72,0:01:15.92,Default,,0,0,0,,Aapko apne fund ka expense ratio
Dialogue: 0,0:01:15.92,0:01:16.52,Default,,0,0,0,,pata hai?
Dialogue: 0,0:01:16.52,0:01:17.32,Default,,0,0,0,,Haan ya nahi,
Dialogue: 0,0:01:17.32,0:01:18.12,Default,,0,0,0,,comment kariye.
