Dialogue: 0,0:00:00.00,0:00:01.23,Default,,0,0,0,,Results ka din hai,
Dialogue: 0,0:00:01.23,0:00:03.94,Default,,0,0,0,,aur Bhai ke phone par notification
Dialogue: 0,0:00:03.94,0:00:04.68,Default,,0,0,0,,bajta hai.
Dialogue: 0,0:00:05.13,0:00:05.84,Default,,0,0,0,,Swiggy,
Dialogue: 0,0:00:05.84,0:00:06.19,Default,,0,0,0,,HPCL,
Dialogue: 0,0:00:06.19,0:00:07.25,Default,,0,0,0,,Colgate,
Dialogue: 0,0:00:07.25,0:00:11.49,Default,,0,0,0,,sab aaj apna quarterly profit batayenge.
Dialogue: 0,0:00:11.94,0:00:12.84,Default,,0,0,0,,Bhai kehta hai,
Dialogue: 0,0:00:12.84,0:00:14.19,Default,,0,0,0,,yeh traders ka khel hai.
Dialogue: 0,0:00:14.19,0:00:15.99,Default,,0,0,0,,Main share nahi kharidta,
Dialogue: 0,0:00:15.99,0:00:17.79,Default,,0,0,0,,main toh bas har mahine SIP
Dialogue: 0,0:00:17.79,0:00:18.46,Default,,0,0,0,,karta hoon.
Dialogue: 0,0:00:18.91,0:00:21.55,Default,,0,0,0,,SIP yaani har mahine fixed paisa
Dialogue: 0,0:00:21.55,0:00:22.51,Default,,0,0,0,,mutual fund mein.
Dialogue: 0,0:00:22.51,0:00:24.43,Default,,0,0,0,,Fund manager sambhalega,
Dialogue: 0,0:00:24.43,0:00:25.87,Default,,0,0,0,,mujhe results se kya.
Dialogue: 0,0:00:26.32,0:00:28.62,Default,,0,0,0,,Lekin usi list mein ek naam
Dialogue: 0,0:00:28.62,0:00:29.19,Default,,0,0,0,,aur tha,
Dialogue: 0,0:00:29.19,0:00:31.20,Default,,0,0,0,,Nippon Life India AMC.
Dialogue: 0,0:00:31.65,0:00:34.64,Default,,0,0,0,,AMC yaani asset management company,
Dialogue: 0,0:00:34.64,0:00:36.88,Default,,0,0,0,,woh company jo aapke SIP ka
Dialogue: 0,0:00:36.88,0:00:38.37,Default,,0,0,0,,paisa chalati hai.
Dialogue: 0,0:00:38.82,0:00:40.73,Default,,0,0,0,,Analysts ka andaaza hai,
Dialogue: 0,0:00:40.73,0:00:43.11,Default,,0,0,0,,is quarter uska net profit lagbhag
Dialogue: 0,0:00:43.11,0:00:45.02,Default,,0,0,0,,4.22 billion rupaye rahega.
Dialogue: 0,0:00:45.47,0:00:48.03,Default,,0,0,0,,Yeh paisa aata kahan se hai?
Dialogue: 0,0:00:48.03,0:00:50.87,Default,,0,0,0,,Aapke jaise lakhon SIP walon se.
Dialogue: 0,0:00:51.32,0:00:52.91,Default,,0,0,0,,Har fund har saal ek chhoti
Dialogue: 0,0:00:52.91,0:00:53.82,Default,,0,0,0,,fees kaat-ta hai,
Dialogue: 0,0:00:53.82,0:00:56.09,Default,,0,0,0,,jise expense ratio kehte hain.
Dialogue: 0,0:00:56.09,0:00:57.68,Default,,0,0,0,,Yeh fees fund ki value se
Dialogue: 0,0:00:57.68,0:00:59.04,Default,,0,0,0,,chupchap kat jaati hai,
Dialogue: 0,0:00:59.04,0:01:00.40,Default,,0,0,0,,koi bill nahi aata.
Dialogue: 0,0:01:00.85,0:01:02.10,Default,,0,0,0,,Ab twist suniye.
Dialogue: 0,0:01:02.10,0:01:04.59,Default,,0,0,0,,Market upar jaaye ya neeche,
Dialogue: 0,0:01:04.59,0:01:06.78,Default,,0,0,0,,yeh fees har haal mein kat-ti
Dialogue: 0,0:01:06.78,0:01:07.09,Default,,0,0,0,,hai.
Dialogue: 0,0:01:07.54,0:01:09.90,Default,,0,0,0,,Matlab fund house ki kamai zyadatar
Dialogue: 0,0:01:09.90,0:01:12.05,Default,,0,0,0,,aapke paise ke size se aati
Dialogue: 0,0:01:12.05,0:01:12.27,Default,,0,0,0,,hai,
Dialogue: 0,0:01:12.27,0:01:13.34,Default,,0,0,0,,return se nahi.
Dialogue: 0,0:01:13.79,0:01:17.47,Default,,0,0,0,,Toh aaj apne fund ka expense
Dialogue: 0,0:01:17.47,0:01:19.10,Default,,0,0,0,,ratio dekhiye.
Dialogue: 0,0:01:19.10,0:01:23.19,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:23.64,0:01:26.10,Default,,0,0,0,,Aapko apne fund ka expense ratio
Dialogue: 0,0:01:26.10,0:01:26.77,Default,,0,0,0,,pata hai?
Dialogue: 0,0:01:26.77,0:01:27.67,Default,,0,0,0,,Haan ya nahi,
Dialogue: 0,0:01:27.67,0:01:28.56,Default,,0,0,0,,comment kariye.
