Dialogue: 0,0:04:30.10,0:04:31.41,Default,,0,0,0,,wahi uthate hain.
Dialogue: 0,0:04:31.41,0:04:34.46,Default,,0,0,0,,Asli number hamesha company ki official
Dialogue: 0,0:04:34.46,0:04:36.21,Default,,0,0,0,,app ya website se lijiye.
Dialogue: 0,0:04:36.66,0:04:38.54,Default,,0,0,0,,In sab mein ek cheez common
Dialogue: 0,0:04:38.54,0:04:38.81,Default,,0,0,0,,hai,
Dialogue: 0,0:04:38.81,0:04:39.35,Default,,0,0,0,,jaldi.
Dialogue: 0,0:04:39.35,0:04:40.96,Default,,0,0,0,,Ma'am abhi kariye,
Dialogue: 0,0:04:40.96,0:04:42.58,Default,,0,0,0,,warna refund cancel.
Dialogue: 0,0:04:42.58,0:04:42.85,Default,,0,0,0,,Sir,
Dialogue: 0,0:04:42.85,0:04:45.00,Default,,0,0,0,,aapka khaata band ho jayega.
Dialogue: 0,0:04:45.00,0:04:46.07,Default,,0,0,0,,Jaldi isliye,
Dialogue: 0,0:04:46.07,0:04:48.50,Default,,0,0,0,,kyunki sochne ka waqt mila toh
Dialogue: 0,0:04:48.50,0:04:49.84,Default,,0,0,0,,aap pakad loge.
Dialogue: 0,0:04:49.84,0:04:51.99,Default,,0,0,0,,Jahan bhi koi aapko daudaaye,
Dialogue: 0,0:04:51.99,0:04:55.22,Default,,0,0,0,,wahin ruk jaana sabse samajhdari hai.
Dialogue: 0,0:04:55.67,0:04:58.88,Default,,0,0,0,,Aur yeh akeli Mummy ki kahani
Dialogue: 0,0:04:58.88,0:04:59.75,Default,,0,0,0,,nahi hai.
Dialogue: 0,0:04:59.75,0:05:02.08,Default,,0,0,0,,Pichhle saal desh ki cyber fraud
