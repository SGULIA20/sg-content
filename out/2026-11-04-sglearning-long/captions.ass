Dialogue: 0,0:05:41.68,0:05:42.45,Default,,0,0,0,,jaata hai.
Dialogue: 0,0:05:42.45,0:05:45.02,Default,,0,0,0,,Mule account yaani kisi aur ke
Dialogue: 0,0:05:45.02,0:05:46.05,Default,,0,0,0,,naam ka khaata,
Dialogue: 0,0:05:46.05,0:05:47.60,Default,,0,0,0,,jo kiraye par liya gaya.
Dialogue: 0,0:05:47.60,0:05:49.91,Default,,0,0,0,,Wahan se kuch hi minute mein
Dialogue: 0,0:05:49.91,0:05:50.94,Default,,0,0,0,,paisa aage,
Dialogue: 0,0:05:50.94,0:05:51.71,Default,,0,0,0,,aur aage,
Dialogue: 0,0:05:51.71,0:05:53.77,Default,,0,0,0,,kai khaaton mein bant jaata hai.
Dialogue: 0,0:05:54.22,0:05:56.91,Default,,0,0,0,,Socho jaise paani ki balti zameen
Dialogue: 0,0:05:56.91,0:05:57.64,Default,,0,0,0,,par gir gayi.
Dialogue: 0,0:05:57.64,0:05:59.84,Default,,0,0,0,,Shuru mein paani ek jagah hai,
Dialogue: 0,0:05:59.84,0:06:01.31,Default,,0,0,0,,sametna aasaan hai.
Dialogue: 0,0:06:01.31,0:06:03.26,Default,,0,0,0,,Thodi der mein woh har taraf
Dialogue: 0,0:06:03.26,0:06:04.24,Default,,0,0,0,,phail jaata hai.
Dialogue: 0,0:06:04.24,0:06:06.44,Default,,0,0,0,,Fraud ka paisa bhi bilkul aisa
Dialogue: 0,0:06:06.44,0:06:06.92,Default,,0,0,0,,hi hai.
Dialogue: 0,0:06:06.92,0:06:08.39,Default,,0,0,0,,Jitni jaldi pakdo,
Dialogue: 0,0:06:08.39,0:06:10.10,Default,,0,0,0,,utna zyada bachta hai.
Dialogue: 0,0:06:10.55,0:06:14.11,Default,,0,0,0,,Isliye Behen turant 1930 milaati hai.
Dialogue: 0,0:06:14.11,0:06:17.15,Default,,0,0,0,,1930 desh ki cyber fraud helpline
Dialogue: 0,0:06:17.15,0:06:17.41,Default,,0,0,0,,hai.
Dialogue: 0,0:06:17.41,0:06:19.44,Default,,0,0,0,,Aap yahan call karke fraud ki
Dialogue: 0,0:06:19.44,0:06:20.96,Default,,0,0,0,,shikayat darj karte ho.
Dialogue: 0,0:06:20.96,0:06:24.77,Default,,0,0,0,,Shikayat sarkari cybercrime portal par online
Dialogue: 0,0:06:24.77,0:06:26.05,Default,,0,0,0,,bhi ho sakti hai.
Dialogue: 0,0:06:26.05,0:06:28.33,Default,,0,0,0,,Call par woh aapse transaction ki
Dialogue: 0,0:06:28.33,0:06:30.11,Default,,0,0,0,,poori details maangte hain.
Dialogue: 0,0:06:30.56,0:06:31.94,Default,,0,0,0,,Details kya chahiye?
Dialogue: 0,0:06:31.94,0:06:34.68,Default,,0,0,0,,Transaction ka reference number,
Dialogue: 0,0:06:34.68,0:06:36.88,Default,,0,0,0,,kis UPI ID par paisa gaya,
Dialogue: 0,0:06:36.88,0:06:37.43,Default,,0,0,0,,kab gaya,
Dialogue: 0,0:06:37.43,0:06:38.26,Default,,0,0,0,,kitna gaya.
Dialogue: 0,0:06:38.26,0:06:40.46,Default,,0,0,0,,Mummy ke phone mein sab tha,
Dialogue: 0,0:06:40.46,0:06:43.76,Default,,0,0,0,,kyunki unhone kuch delete nahi kiya.
Dialogue: 0,0:06:43.76,0:06:45.41,Default,,0,0,0,,Isliye screenshot lijiye,
Dialogue: 0,0:06:45.41,0:06:47.06,Default,,0,0,0,,SMS sambhaal kar rakhiye.
Dialogue: 0,0:06:47.06,0:06:50.08,Default,,0,0,0,,Yahi aapka sabse bada saboot hai.
Dialogue: 0,0:06:50.53,0:06:51.86,Default,,0,0,0,,Phir hota kya hai?
Dialogue: 0,0:06:51.86,0:06:54.26,Default,,0,0,0,,Shikayat ek system mein jaati hai,
Dialogue: 0,0:06:54.26,0:06:56.65,Default,,0,0,0,,jo banks aur payment companies se
Dialogue: 0,0:06:56.65,0:06:57.45,Default,,0,0,0,,juda hai.
Dialogue: 0,0:06:57.45,0:06:59.32,Default,,0,0,0,,Jis khaate mein paisa gaya,
Dialogue: 0,0:06:59.32,0:07:01.45,Default,,0,0,0,,wahan alert pahunchta hai.
Dialogue: 0,0:07:01.45,0:07:04.38,Default,,0,0,0,,Agar paisa abhi wahin pada hai,
Dialogue: 0,0:07:04.38,0:07:06.51,Default,,0,0,0,,toh use rok diya jaata hai.
Dialogue: 0,0:07:06.51,0:07:08.37,Default,,0,0,0,,Ise freeze kehte hain,
Dialogue: 0,0:07:08.37,0:07:09.97,Default,,0,0,0,,yaani khaata ruk gaya.
Dialogue: 0,0:07:10.42,0:07:12.89,Default,,0,0,0,,Yeh system tab kaam karta hai,
Dialogue: 0,0:07:12.89,0:07:15.05,Default,,0,0,0,,jab log jaldi aate hain.
Dialogue: 0,0:07:15.05,0:07:17.83,Default,,0,0,0,,Sarkari aankdon ke mutabik,
Dialogue: 0,0:07:17.83,0:07:20.60,Default,,0,0,0,,is system ne 7,130 crore rupaye
Dialogue: 0,0:07:20.60,0:07:23.69,Default,,0,0,0,,se zyada ko fraudsters tak pahunchne
Dialogue: 0,0:07:23.69,0:07:24.61,Default,,0,0,0,,se bachaya.
Dialogue: 0,0:07:24.61,0:07:25.23,Default,,0,0,0,,Socho,
Dialogue: 0,0:07:25.23,0:07:27.39,Default,,0,0,0,,yeh paisa kisi Mummy,
Dialogue: 0,0:07:27.39,0:07:29.86,Default,,0,0,0,,kisi Papa ki bachat thi,
Dialogue: 0,0:07:29.86,0:07:31.71,Default,,0,0,0,,jo waqt par call se bach
Dialogue: 0,0:07:31.71,0:07:32.02,Default,,0,0,0,,gayi.
Dialogue: 0,0:07:32.47,0:07:33.42,Default,,0,0,0,,Par dhyan rahe,
Dialogue: 0,0:07:33.42,0:07:36.02,Default,,0,0,0,,freeze ka matlab paisa turant wapas
Dialogue: 0,0:07:36.02,0:07:36.50,Default,,0,0,0,,nahi.
Dialogue: 0,0:07:36.50,0:07:38.87,Default,,0,0,0,,Ruka hua paisa wapas aane mein
Dialogue: 0,0:07:38.87,0:07:40.05,Default,,0,0,0,,process lagta hai,
Dialogue: 0,0:07:40.05,0:07:41.95,Default,,0,0,0,,kabhi police ke zariye,
Dialogue: 0,0:07:41.95,0:07:43.61,Default,,0,0,0,,kabhi court ke order se.
Dialogue: 0,0:07:43.61,0:07:45.98,Default,,0,0,0,,Shikayat ka number sambhaal kar rakhiye.
Dialogue: 0,0:07:45.98,0:07:47.87,Default,,0,0,0,,Aur apne bank ko bhi alag
Dialogue: 0,0:07:47.87,0:07:49.53,Default,,0,0,0,,se batana mat bhooliye.
Dialogue: 0,0:07:49.53,0:07:51.19,Default,,0,0,0,,Wahi agla sawaal hai.
Dialogue: 0,0:07:51.64,0:07:52.75,Default,,0,0,0,,Teesra sawaal.
Dialogue: 0,0:07:52.75,0:07:55.24,Default,,0,0,0,,Bank kab paisa wapas deta hai?
Dialogue: 0,0:07:55.24,0:07:58.01,Default,,0,0,0,,Usi raat Behen bank ki official
Dialogue: 0,0:07:58.01,0:08:00.22,Default,,0,0,0,,app se fraud report karti hai.
Dialogue: 0,0:08:00.22,0:08:02.71,Default,,0,0,0,,Agle din dono bank jaati hain.
Dialogue: 0,0:08:02.71,0:08:05.48,Default,,0,0,0,,Bank Uncle counter ke peeche baithe
Dialogue: 0,0:08:05.48,0:08:05.76,Default,,0,0,0,,hain.
Dialogue: 0,0:08:05.76,0:08:07.97,Default,,0,0,0,,Mummy dheere se kehti hain,
Dialogue: 0,0:08:07.97,0:08:09.36,Default,,0,0,0,,galti meri thi.
Dialogue: 0,0:08:09.36,0:08:11.02,Default,,0,0,0,,Par yahan ek niyam hai,
Dialogue: 0,0:08:11.02,0:08:12.68,Default,,0,0,0,,jo kam log jaante hain.
Dialogue: 0,0:08:13.13,0:08:14.73,Default,,0,0,0,,RBI ke niyam batate hain,
Dialogue: 0,0:08:14.73,0:08:18.61,Default,,0,0,0,,unauthorised electronic transaction mein customer ki
Dialogue: 0,0:08:18.61,0:08:20.44,Default,,0,0,0,,zimmedari kitni hogi.
Dialogue: 0,0:08:20.44,0:08:23.86,Default,,0,0,0,,Unauthorised yaani aisa transaction jo aapne
Dialogue: 0,0:08:23.86,0:08:25.00,Default,,0,0,0,,khud nahi chaha.
Dialogue: 0,0:08:25.00,0:08:26.60,Default,,0,0,0,,Agar galti bank ki hai,
Dialogue: 0,0:08:26.60,0:08:29.11,Default,,0,0,0,,toh customer ki zimmedari zero.
Dialogue: 0,0:08:29.11,0:08:31.39,Default,,0,0,0,,Agar galti kahin aur system mein
Dialogue: 0,0:08:31.39,0:08:31.62,Default,,0,0,0,,hai,
Dialogue: 0,0:08:31.62,0:08:32.54,Default,,0,0,0,,toh bhi zero,
Dialogue: 0,0:08:32.54,0:08:33.45,Default,,0,0,0,,par ek shart par.
Dialogue: 0,0:08:33.90,0:08:34.70,Default,,0,0,0,,Shart yeh hai,
Dialogue: 0,0:08:34.70,0:08:36.83,Default,,0,0,0,,bank ka alert milne ke 3
Dialogue: 0,0:08:36.83,0:08:38.95,Default,,0,0,0,,kaam ke din ke andar aapne
Dialogue: 0,0:08:38.95,0:08:40.28,Default,,0,0,0,,bank ko bata diya.
Dialogue: 0,0:08:40.28,0:08:42.41,Default,,0,0,0,,Kaam ke din yaani working days,
Dialogue: 0,0:08:42.41,0:08:45.07,Default,,0,0,0,,chhutti ke din nahi gine jaate.
Dialogue: 0,0:08:45.07,0:08:47.99,Default,,0,0,0,,Isko zero liability kehte hain,
Dialogue: 0,0:08:47.99,0:08:50.92,Default,,0,0,0,,yaani nuksaan ki zimmedari aap par
Dialogue: 0,0:08:50.92,0:08:51.98,Default,,0,0,0,,nahi aati.
Dialogue: 0,0:08:52.43,0:08:53.74,Default,,0,0,0,,Ab ek imaandar baat.
Dialogue: 0,0:08:53.74,0:08:55.50,Default,,0,0,0,,Agar aapne khud PIN daala,
Dialogue: 0,0:08:55.50,0:08:56.15,Default,,0,0,0,,ya OTP diya,
Dialogue: 0,0:08:56.15,0:08:57.90,Default,,0,0,0,,toh bank keh sakta hai galti
Dialogue: 0,0:08:57.90,0:08:58.56,Default,,0,0,0,,aapki thi.
Dialogue: 0,0:08:58.56,0:09:01.19,Default,,0,0,0,,Aise mein zero liability ka fayda
Dialogue: 0,0:09:01.19,0:09:02.28,Default,,0,0,0,,milna mushkil hai.
Dialogue: 0,0:09:02.28,0:09:04.47,Default,,0,0,0,,Report karne tak ka nuksaan aksar
Dialogue: 0,0:09:04.47,0:09:06.88,Default,,0,0,0,,customer ko hi uthana padta hai.
Dialogue: 0,0:09:06.88,0:09:09.51,Default,,0,0,0,,Isliye report jaldi karna zaroori hai.
Dialogue: 0,0:09:09.96,0:09:11.68,Default,,0,0,0,,Toh report se fayda kya?
Dialogue: 0,0:09:11.68,0:09:12.91,Default,,0,0,0,,Report karte hi,
Dialogue: 0,0:09:12.91,0:09:14.88,Default,,0,0,0,,us waqt ke baad hone wala
Dialogue: 0,0:09:14.88,0:09:17.34,Default,,0,0,0,,har nuksaan bank ki zimmedari ban
Dialogue: 0,0:09:17.34,0:09:18.08,Default,,0,0,0,,jaata hai.
Dialogue: 0,0:09:18.08,0:09:20.29,Default,,0,0,0,,Matlab agar fraudster ne baad mein
Dialogue: 0,0:09:20.29,0:09:21.77,Default,,0,0,0,,aur paisa nikala,
Dialogue: 0,0:09:21.77,0:09:23.24,Default,,0,0,0,,toh woh bank bharega.
Dialogue: 0,0:09:23.24,0:09:25.21,Default,,0,0,0,,Isliye pehle bank ko batao,
Dialogue: 0,0:09:25.21,0:09:26.44,Default,,0,0,0,,phir baaki sochna.
Dialogue: 0,0:09:26.89,0:09:29.09,Default,,0,0,0,,Aur jab galti aapki nahi hai,
Dialogue: 0,0:09:29.09,0:09:30.30,Default,,0,0,0,,toh ek aur niyam hai.
Dialogue: 0,0:09:30.30,0:09:32.50,Default,,0,0,0,,Bank ko shikayat milne ke 10
Dialogue: 0,0:09:32.50,0:09:34.45,Default,,0,0,0,,kaam ke din ke andar paisa
Dialogue: 0,0:09:34.45,0:09:37.13,Default,,0,0,0,,aapke khaate mein credit karna hota
Dialogue: 0,0:09:37.13,0:09:37.38,Default,,0,0,0,,hai.
Dialogue: 0,0:09:37.38,0:09:39.82,Default,,0,0,0,,Ise shadow reversal kehte hain,
Dialogue: 0,0:09:39.82,0:09:42.25,Default,,0,0,0,,yaani paisa khaate mein dikhta hai,
Dialogue: 0,0:09:42.25,0:09:44.45,Default,,0,0,0,,jab tak jaanch poori nahi hoti.
Dialogue: 0,0:09:44.90,0:09:47.21,Default,,0,0,0,,Bank Uncle Mummy ko complaint ki
Dialogue: 0,0:09:47.21,0:09:48.50,Default,,0,0,0,,receipt dete hain,
Dialogue: 0,0:09:48.50,0:09:50.55,Default,,0,0,0,,reference number ke saath.
Dialogue: 0,0:09:50.55,0:09:52.61,Default,,0,0,0,,Yeh kaagaz bahut kaam ka hai.
Dialogue: 0,0:09:52.61,0:09:54.92,Default,,0,0,0,,Agar bank time par jawab na
Dialogue: 0,0:09:54.92,0:09:55.17,Default,,0,0,0,,de,
Dialogue: 0,0:09:55.17,0:09:57.23,Default,,0,0,0,,toh aap bank ke grievance desk
Dialogue: 0,0:09:57.23,0:09:59.28,Default,,0,0,0,,aur phir RBI ombudsman tak ja
Dialogue: 0,0:09:59.28,0:10:00.05,Default,,0,0,0,,sakte ho.
Dialogue: 0,0:10:00.05,0:10:02.88,Default,,0,0,0,,Ombudsman yaani RBI ka shikayat sunne
Dialogue: 0,0:10:02.88,0:10:04.42,Default,,0,0,0,,wala adhikari.
Dialogue: 0,0:10:04.87,0:10:07.18,Default,,0,0,0,,Ab woh galti jo sabse zyada
Dialogue: 0,0:10:07.18,0:10:08.21,Default,,0,0,0,,log karte hain.
Dialogue: 0,0:10:08.21,0:10:09.49,Default,,0,0,0,,Fraud ke baad sharam.
Dialogue: 0,0:10:09.49,0:10:11.29,Default,,0,0,0,,Mummy ka pehla khayal tha,
Dialogue: 0,0:10:11.29,0:10:13.34,Default,,0,0,0,,kisi ko batana nahi,
Dialogue: 0,0:10:13.34,0:10:14.62,Default,,0,0,0,,log kya kahenge.
Dialogue: 0,0:10:14.62,0:10:16.94,Default,,0,0,0,,Bahut log isi sharam mein din
Dialogue: 0,0:10:16.94,0:10:18.22,Default,,0,0,0,,nikaal dete hain.
Dialogue: 0,0:10:18.22,0:10:19.76,Default,,0,0,0,,Aur har guzarta din,
Dialogue: 0,0:10:19.76,0:10:22.07,Default,,0,0,0,,paisa aur door chala jaata hai.
Dialogue: 0,0:10:22.52,0:10:24.85,Default,,0,0,0,,Der ka nuksaan kitna bada hai?
Dialogue: 0,0:10:24.85,0:10:27.43,Default,,0,0,0,,Ek policing study ke mutabik,
Dialogue: 0,0:10:27.43,0:10:30.27,Default,,0,0,0,,digital fraud ke 72 percent shikaar
Dialogue: 0,0:10:30.27,0:10:32.60,Default,,0,0,0,,logon ko apna koi bhi paisa
Dialogue: 0,0:10:32.60,0:10:34.15,Default,,0,0,0,,wapas nahi mila.
Dialogue: 0,0:10:34.15,0:10:35.70,Default,,0,0,0,,Wajah kai hoti hain.
Dialogue: 0,0:10:35.70,0:10:37.76,Default,,0,0,0,,Par der se shikayat ka seedha
Dialogue: 0,0:10:37.76,0:10:38.54,Default,,0,0,0,,matlab hai,
Dialogue: 0,0:10:38.54,0:10:41.38,Default,,0,0,0,,paisa pakadne se pehle hi bikhar
Dialogue: 0,0:10:41.38,0:10:41.64,Default,,0,0,0,,gaya.
Dialogue: 0,0:10:42.09,0:10:43.77,Default,,0,0,0,,Bank ke niyam mein bhi der
Dialogue: 0,0:10:43.77,0:10:44.90,Default,,0,0,0,,ki keemat hai.
Dialogue: 0,0:10:44.90,0:10:47.70,Default,,0,0,0,,Agar galti kahin aur system mein
Dialogue: 0,0:10:47.70,0:10:47.98,Default,,0,0,0,,thi,
Dialogue: 0,0:10:47.98,0:10:50.51,Default,,0,0,0,,par aapne report mein thodi der
Dialogue: 0,0:10:50.51,0:10:51.07,Default,,0,0,0,,kar di,
Dialogue: 0,0:10:51.07,0:10:54.44,Default,,0,0,0,,toh savings account par aapki zimmedari
Dialogue: 0,0:10:54.44,0:10:56.68,Default,,0,0,0,,10,000 rupaye tak ho sakti hai.
Dialogue: 0,0:10:56.68,0:10:58.64,Default,,0,0,0,,Usse bhi zyada der hui,
Dialogue: 0,0:10:58.64,0:11:01.17,Default,,0,0,0,,toh faisla bank ki policy par.
Dialogue: 0,0:11:01.62,0:11:04.40,Default,,0,0,0,,Toh pehle ghante mein kya karna
Dialogue: 0,0:11:04.40,0:11:04.71,Default,,0,0,0,,hai?
Dialogue: 0,0:11:04.71,0:11:05.33,Default,,0,0,0,,Pehla,
Dialogue: 0,0:11:05.33,0:11:08.41,Default,,0,0,0,,turant cyber fraud helpline par call
Dialogue: 0,0:11:08.41,0:11:09.03,Default,,0,0,0,,karo,
Dialogue: 0,0:11:09.03,0:11:12.12,Default,,0,0,0,,ya cybercrime portal par shikayat.
Dialogue: 0,0:11:12.12,0:11:12.73,Default,,0,0,0,,Doosra,
Dialogue: 0,0:11:12.73,0:11:15.51,Default,,0,0,0,,apne bank ko official app ya
Dialogue: 0,0:11:15.51,0:11:17.37,Default,,0,0,0,,helpline se batao,
Dialogue: 0,0:11:17.37,0:11:19.22,Default,,0,0,0,,aur UPI band karwao.
Dialogue: 0,0:11:19.22,0:11:19.84,Default,,0,0,0,,Teesra,
Dialogue: 0,0:11:19.84,0:11:20.45,Default,,0,0,0,,screenshot,
Dialogue: 0,0:11:20.45,0:11:20.76,Default,,0,0,0,,SMS,
Dialogue: 0,0:11:20.76,0:11:21.69,Default,,0,0,0,,UPI ID,
Dialogue: 0,0:11:21.69,0:11:23.54,Default,,0,0,0,,sab sambhaal ke rakho.
Dialogue: 0,0:11:23.99,0:11:25.91,Default,,0,0,0,,Aur aage ke liye chhote niyam.
Dialogue: 0,0:11:25.91,0:11:28.07,Default,,0,0,0,,Paisa lene ke liye kabhi PIN
Dialogue: 0,0:11:28.07,0:11:28.55,Default,,0,0,0,,nahi.
Dialogue: 0,0:11:28.55,0:11:31.43,Default,,0,0,0,,Customer care ka number sirf official
Dialogue: 0,0:11:31.43,0:11:32.87,Default,,0,0,0,,app ya website se.
Dialogue: 0,0:11:32.87,0:11:35.03,Default,,0,0,0,,Koi app download karne ko kahe,
Dialogue: 0,0:11:35.03,0:11:35.99,Default,,0,0,0,,toh call kaat do.
Dialogue: 0,0:11:35.99,0:11:37.43,Default,,0,0,0,,Aur jo jaldi machaaye,
Dialogue: 0,0:11:37.43,0:11:39.11,Default,,0,0,0,,uske liye ek hi jawab,
Dialogue: 0,0:11:39.11,0:11:40.55,Default,,0,0,0,,main khud bank aa jaungi.
Dialogue: 0,0:11:41.00,0:11:43.24,Default,,0,0,0,,Mummy ki kahani ka ant?
Dialogue: 0,0:11:43.24,0:11:44.64,Default,,0,0,0,,Shikayat jaldi hui,
Dialogue: 0,0:11:44.64,0:11:46.04,Default,,0,0,0,,receipt haath mein hai,
Dialogue: 0,0:11:46.04,0:11:47.44,Default,,0,0,0,,jaanch chal rahi hai.
Dialogue: 0,0:11:47.44,0:11:49.96,Default,,0,0,0,,Paisa wapas aayega ya nahi,
Dialogue: 0,0:11:49.96,0:11:51.64,Default,,0,0,0,,abhi pata nahi.
Dialogue: 0,0:11:51.64,0:11:53.88,Default,,0,0,0,,Par Mummy ab ghar ki sabse
Dialogue: 0,0:11:53.88,0:11:55.00,Default,,0,0,0,,badi guard hain.
Dialogue: 0,0:11:55.00,0:11:57.80,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:11:57.80,0:12:00.60,Default,,0,0,0,,Bas apne paise ki hifaazat ki
Dialogue: 0,0:12:00.60,0:12:01.72,Default,,0,0,0,,seedhi baat hai.
Dialogue: 0,0:12:02.17,0:12:03.73,Default,,0,0,0,,Ab aapse ek sawaal.
Dialogue: 0,0:12:03.73,0:12:06.58,Default,,0,0,0,,Aapke paas kabhi aisa refund wala
Dialogue: 0,0:12:06.58,0:12:07.36,Default,,0,0,0,,call aaya hai?
