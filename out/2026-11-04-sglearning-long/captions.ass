Dialogue: 0,0:00:00.00,0:00:02.63,Default,,0,0,0,,Refund lene ke liye kabhi PIN
Dialogue: 0,0:00:02.63,0:00:03.80,Default,,0,0,0,,nahi lagta.
Dialogue: 0,0:00:03.80,0:00:05.55,Default,,0,0,0,,Phir bhi log roz PIN daal
Dialogue: 0,0:00:05.55,0:00:06.43,Default,,0,0,0,,dete hain.
Dialogue: 0,0:00:06.43,0:00:08.47,Default,,0,0,0,,Aur kuch hi pal mein khaata
Dialogue: 0,0:00:08.47,0:00:10.22,Default,,0,0,0,,khaali ho jaata hai.
Dialogue: 0,0:00:10.22,0:00:12.27,Default,,0,0,0,,Aaj ek aisi hi shaam ki
Dialogue: 0,0:00:12.27,0:00:13.14,Default,,0,0,0,,kahani,
Dialogue: 0,0:00:13.14,0:00:14.02,Default,,0,0,0,,step by step.
Dialogue: 0,0:00:14.02,0:00:16.65,Default,,0,0,0,,Taaki agli baar yeh call aapke
Dialogue: 0,0:00:16.65,0:00:17.23,Default,,0,0,0,,ghar aaye,
Dialogue: 0,0:00:17.23,0:00:19.28,Default,,0,0,0,,toh aap usse pehchaan lo.
Dialogue: 0,0:00:19.73,0:00:20.65,Default,,0,0,0,,Shaam ka waqt hai.
Dialogue: 0,0:00:20.65,0:00:23.41,Default,,0,0,0,,Mummy ne online mixer grinder lauta
Dialogue: 0,0:00:23.41,0:00:23.88,Default,,0,0,0,,diya tha.
Dialogue: 0,0:00:23.88,0:00:25.72,Default,,0,0,0,,Refund abhi tak nahi aaya.
Dialogue: 0,0:00:25.72,0:00:27.56,Default,,0,0,0,,Woh phone par search karti hain,
Dialogue: 0,0:00:27.56,0:00:30.09,Default,,0,0,0,,company ka customer care number.
Dialogue: 0,0:00:30.09,0:00:32.40,Default,,0,0,0,,Sabse upar ek number dikhta hai.
Dialogue: 0,0:00:32.40,0:00:33.78,Default,,0,0,0,,Mummy bina soche,
Dialogue: 0,0:00:33.78,0:00:36.08,Default,,0,0,0,,turant usi number par call laga
Dialogue: 0,0:00:36.08,0:00:36.77,Default,,0,0,0,,deti hain.
Dialogue: 0,0:00:37.22,0:00:39.70,Default,,0,0,0,,Udhar se ek bahut tameez wala
Dialogue: 0,0:00:39.70,0:00:40.94,Default,,0,0,0,,aadmi bolta hai.
Dialogue: 0,0:00:40.94,0:00:41.44,Default,,0,0,0,,Ma'am,
Dialogue: 0,0:00:41.44,0:00:43.42,Default,,0,0,0,,aapka refund atka hua hai,
Dialogue: 0,0:00:43.42,0:00:45.16,Default,,0,0,0,,hum abhi bhej dete hain.
Dialogue: 0,0:00:45.16,0:00:46.65,Default,,0,0,0,,Aawaz mein jaldi hai,
Dialogue: 0,0:00:46.65,0:00:47.89,Default,,0,0,0,,par izzat bhi hai.
Dialogue: 0,0:00:47.89,0:00:49.38,Default,,0,0,0,,Mummy ko lagta hai,
Dialogue: 0,0:00:49.38,0:00:49.87,Default,,0,0,0,,chalo,
Dialogue: 0,0:00:49.87,0:00:51.86,Default,,0,0,0,,aakhir koi toh sun raha hai.
Dialogue: 0,0:00:51.86,0:00:54.09,Default,,0,0,0,,Aur yahin se jaal shuru hota
Dialogue: 0,0:00:54.09,0:00:54.34,Default,,0,0,0,,hai.
Dialogue: 0,0:00:54.79,0:00:55.75,Default,,0,0,0,,Woh kehta hai,
Dialogue: 0,0:00:55.75,0:00:57.92,Default,,0,0,0,,aapke UPI app par ek request
Dialogue: 0,0:00:57.92,0:00:58.40,Default,,0,0,0,,aayegi.
Dialogue: 0,0:00:58.40,0:01:00.32,Default,,0,0,0,,Usko approve kar dijiye,
Dialogue: 0,0:01:00.32,0:01:01.53,Default,,0,0,0,,aur PIN daal dijiye.
Dialogue: 0,0:01:01.53,0:01:03.93,Default,,0,0,0,,Refund seedha khaate mein aa jayega.
Dialogue: 0,0:01:03.93,0:01:06.34,Default,,0,0,0,,Mummy ko thoda ajeeb lagta hai.
Dialogue: 0,0:01:06.34,0:01:08.26,Default,,0,0,0,,Par aadmi baar baar bolta hai,
Dialogue: 0,0:01:08.26,0:01:09.70,Default,,0,0,0,,ma'am jaldi kariye,
Dialogue: 0,0:01:09.70,0:01:11.87,Default,,0,0,0,,warna refund cancel ho jayega.
Dialogue: 0,0:01:12.32,0:01:14.45,Default,,0,0,0,,Mummy PIN daal deti hain.
Dialogue: 0,0:01:14.45,0:01:16.89,Default,,0,0,0,,Screen par hara tick aata hai.
Dialogue: 0,0:01:16.89,0:01:18.41,Default,,0,0,0,,Woh khush hoti hain,
Dialogue: 0,0:01:18.41,0:01:19.63,Default,,0,0,0,,chalo ho gaya.
Dialogue: 0,0:01:19.63,0:01:21.45,Default,,0,0,0,,Phir phone bajta hai,
Dialogue: 0,0:01:21.45,0:01:22.98,Default,,0,0,0,,ek SMS aata hai.
Dialogue: 0,0:01:22.98,0:01:25.11,Default,,0,0,0,,Khaate se paisa gaya hai,
Dialogue: 0,0:01:25.11,0:01:26.02,Default,,0,0,0,,aaya nahi.
Dialogue: 0,0:01:26.02,0:01:29.07,Default,,0,0,0,,Mummy ka chehra safed pad jaata
Dialogue: 0,0:01:29.07,0:01:29.37,Default,,0,0,0,,hai.
Dialogue: 0,0:01:29.37,0:01:31.20,Default,,0,0,0,,Haath kaanpne lagte hain.
Dialogue: 0,0:01:31.65,0:01:33.77,Default,,0,0,0,,Aadmi ab bhi line par hai.
Dialogue: 0,0:01:33.77,0:01:34.57,Default,,0,0,0,,Kehta hai,
Dialogue: 0,0:01:34.57,0:01:36.95,Default,,0,0,0,,ma'am galti se debit ho gaya,
Dialogue: 0,0:01:36.95,0:01:38.81,Default,,0,0,0,,main nayi request bhejta hoon,
Dialogue: 0,0:01:38.81,0:01:40.67,Default,,0,0,0,,paisa wapas aa jayega.
Dialogue: 0,0:01:40.67,0:01:42.26,Default,,0,0,0,,Yeh doosra hamla hai.
Dialogue: 0,0:01:42.26,0:01:45.17,Default,,0,0,0,,Ghabrahat mein insaan wahi karta hai
Dialogue: 0,0:01:45.17,0:01:46.77,Default,,0,0,0,,jo usse kaha jaye.
Dialogue: 0,0:01:46.77,0:01:49.68,Default,,0,0,0,,Tabhi Beta kamre mein aakar poochta
Dialogue: 0,0:01:49.68,0:01:49.95,Default,,0,0,0,,hai,
Dialogue: 0,0:01:49.95,0:01:50.48,Default,,0,0,0,,Mummy,
Dialogue: 0,0:01:50.48,0:01:51.01,Default,,0,0,0,,kya hua?
Dialogue: 0,0:01:51.46,0:01:54.74,Default,,0,0,0,,Aisi kahaniyan chhoti nahi hoti.
Dialogue: 0,0:01:54.74,0:01:56.83,Default,,0,0,0,,Ek survey ke mutabik,
Dialogue: 0,0:01:56.83,0:02:00.41,Default,,0,0,0,,online fraud mein logon ka average
Dialogue: 0,0:02:00.41,0:02:03.10,Default,,0,0,0,,nuksaan lagbhag 93,195 rupaye raha.
Dialogue: 0,0:02:03.10,0:02:05.78,Default,,0,0,0,,Yaani kai mahine ka ghar ka
Dialogue: 0,0:02:05.78,0:02:06.38,Default,,0,0,0,,kharcha,
Dialogue: 0,0:02:06.38,0:02:07.58,Default,,0,0,0,,sirf ek call mein.
Dialogue: 0,0:02:07.58,0:02:09.37,Default,,0,0,0,,Aur sabse dukh ki baat,
Dialogue: 0,0:02:09.37,0:02:12.35,Default,,0,0,0,,yeh paisa aksar saalon ki mehnat
Dialogue: 0,0:02:12.35,0:02:14.14,Default,,0,0,0,,ki bachat hota hai.
Dialogue: 0,0:02:14.59,0:02:16.62,Default,,0,0,0,,Toh aaj ke sawaal yeh hain.
Dialogue: 0,0:02:16.62,0:02:17.20,Default,,0,0,0,,Pehla,
Dialogue: 0,0:02:17.20,0:02:19.52,Default,,0,0,0,,refund lene ke liye PIN kyun
Dialogue: 0,0:02:19.52,0:02:20.39,Default,,0,0,0,,maanga gaya?
Dialogue: 0,0:02:20.39,0:02:20.97,Default,,0,0,0,,Doosra,
Dialogue: 0,0:02:20.97,0:02:23.87,Default,,0,0,0,,paisa jaane ke baad helpline par
Dialogue: 0,0:02:23.87,0:02:25.03,Default,,0,0,0,,kya hota hai?
Dialogue: 0,0:02:25.03,0:02:25.61,Default,,0,0,0,,Teesra,
Dialogue: 0,0:02:25.61,0:02:28.22,Default,,0,0,0,,bank kab paisa wapas deta hai?
Dialogue: 0,0:02:28.22,0:02:29.38,Default,,0,0,0,,Aur aakhir mein,
Dialogue: 0,0:02:29.38,0:02:32.28,Default,,0,0,0,,pehle ghante mein aapko kya karna
Dialogue: 0,0:02:32.28,0:02:32.57,Default,,0,0,0,,hai,
Dialogue: 0,0:02:32.57,0:02:34.31,Default,,0,0,0,,taaki nuksaan kam ho.
Dialogue: 0,0:02:34.76,0:02:37.18,Default,,0,0,0,,Pehle ek seedhi baat samajh lijiye.
Dialogue: 0,0:02:37.18,0:02:39.35,Default,,0,0,0,,UPI PIN sirf paisa bhejne ke
Dialogue: 0,0:02:39.35,0:02:40.32,Default,,0,0,0,,liye hota hai.
Dialogue: 0,0:02:40.32,0:02:42.49,Default,,0,0,0,,Paisa lene ke liye kabhi PIN
Dialogue: 0,0:02:42.49,0:02:43.46,Default,,0,0,0,,nahi lagta.
Dialogue: 0,0:02:43.46,0:02:45.64,Default,,0,0,0,,Jab koi aapko paisa bhejta hai,
Dialogue: 0,0:02:45.64,0:02:47.81,Default,,0,0,0,,aapko kuch nahi karna padta.
Dialogue: 0,0:02:47.81,0:02:49.50,Default,,0,0,0,,Paisa bas aa jaata hai,
Dialogue: 0,0:02:49.50,0:02:51.68,Default,,0,0,0,,jaise dost bhejta hai toh aata
Dialogue: 0,0:02:51.68,0:02:51.92,Default,,0,0,0,,hai.
Dialogue: 0,0:02:52.37,0:02:54.11,Default,,0,0,0,,Ab woh request kya thi?
Dialogue: 0,0:02:54.11,0:02:56.71,Default,,0,0,0,,Usse collect request kehte hain.
Dialogue: 0,0:02:56.71,0:03:00.18,Default,,0,0,0,,Collect request yaani saamne wala aapse
Dialogue: 0,0:03:00.18,0:03:01.92,Default,,0,0,0,,paisa maang raha hai.
Dialogue: 0,0:03:01.92,0:03:04.23,Default,,0,0,0,,Screen par pay likha hota hai,
Dialogue: 0,0:03:04.23,0:03:05.39,Default,,0,0,0,,saath mein amount.
Dialogue: 0,0:03:05.39,0:03:08.28,Default,,0,0,0,,Fraudster ise refund bol kar bhejta
Dialogue: 0,0:03:08.28,0:03:08.57,Default,,0,0,0,,hai.
Dialogue: 0,0:03:08.57,0:03:10.60,Default,,0,0,0,,Aap approve karte ho,
Dialogue: 0,0:03:10.60,0:03:11.76,Default,,0,0,0,,PIN daalte ho,
Dialogue: 0,0:03:11.76,0:03:14.65,Default,,0,0,0,,aur paisa aapka chala jaata hai.
Dialogue: 0,0:03:15.10,0:03:17.04,Default,,0,0,0,,Toh Mummy ne galti kyun ki?
Dialogue: 0,0:03:17.04,0:03:19.46,Default,,0,0,0,,Kyunki unke dimaag mein pehle se
Dialogue: 0,0:03:19.46,0:03:21.16,Default,,0,0,0,,refund ka intezaar tha.
Dialogue: 0,0:03:21.16,0:03:22.85,Default,,0,0,0,,Jo aap sunna chahte ho,
Dialogue: 0,0:03:22.85,0:03:24.54,Default,,0,0,0,,fraudster wahi bolta hai.
Dialogue: 0,0:03:24.54,0:03:26.48,Default,,0,0,0,,Mummy ne khud order ki baat
Dialogue: 0,0:03:26.48,0:03:26.97,Default,,0,0,0,,batayi,
Dialogue: 0,0:03:26.97,0:03:28.66,Default,,0,0,0,,usne bas usko dohraaya.
Dialogue: 0,0:03:28.66,0:03:30.36,Default,,0,0,0,,Sab kuch sach jaisa laga.
Dialogue: 0,0:03:30.36,0:03:32.78,Default,,0,0,0,,Isliye shak ki jagah bharosa aaya.
Dialogue: 0,0:03:33.23,0:03:36.65,Default,,0,0,0,,Doosra tareeka hai screen share wala
Dialogue: 0,0:03:36.65,0:03:36.96,Default,,0,0,0,,app.
Dialogue: 0,0:03:36.96,0:03:38.51,Default,,0,0,0,,Fraudster kehta hai,
Dialogue: 0,0:03:38.51,0:03:41.31,Default,,0,0,0,,ma'am ek app download kar lijiye,
Dialogue: 0,0:03:41.31,0:03:42.87,Default,,0,0,0,,main help karunga.
Dialogue: 0,0:03:42.87,0:03:45.66,Default,,0,0,0,,Woh app aapki poori screen usko
Dialogue: 0,0:03:45.66,0:03:47.22,Default,,0,0,0,,dikha deta hai.
Dialogue: 0,0:03:47.22,0:03:49.39,Default,,0,0,0,,Aap jo bhi type karo,
Dialogue: 0,0:03:49.39,0:03:49.70,Default,,0,0,0,,OTP,
Dialogue: 0,0:03:49.70,0:03:50.01,Default,,0,0,0,,PIN,
Dialogue: 0,0:03:50.01,0:03:50.63,Default,,0,0,0,,password,
Dialogue: 0,0:03:50.63,0:03:52.19,Default,,0,0,0,,sab woh dekhta hai.
Dialogue: 0,0:03:52.19,0:03:54.05,Default,,0,0,0,,Bina taala tode,
Dialogue: 0,0:03:54.05,0:03:56.23,Default,,0,0,0,,chaabi aapne khud de di.
Dialogue: 0,0:03:56.68,0:03:59.16,Default,,0,0,0,,OTP yaani woh chhota code jo
Dialogue: 0,0:03:59.16,0:04:00.82,Default,,0,0,0,,bank SMS par bhejta hai,
Dialogue: 0,0:04:00.82,0:04:01.93,Default,,0,0,0,,sirf aapke liye.
Dialogue: 0,0:04:01.93,0:04:04.41,Default,,0,0,0,,Bank kabhi phone par OTP nahi
Dialogue: 0,0:04:04.41,0:04:04.96,Default,,0,0,0,,maangta.
Dialogue: 0,0:04:04.96,0:04:08.00,Default,,0,0,0,,Koi asli customer care aapse app
Dialogue: 0,0:04:08.00,0:04:09.93,Default,,0,0,0,,download nahi karwata.
Dialogue: 0,0:04:09.93,0:04:11.31,Default,,0,0,0,,Agar koi kahe,
Dialogue: 0,0:04:11.31,0:04:12.42,Default,,0,0,0,,toh samajh lo,
Dialogue: 0,0:04:12.42,0:04:15.18,Default,,0,0,0,,line ke us paar customer care
Dialogue: 0,0:04:15.18,0:04:16.56,Default,,0,0,0,,nahi baitha hai.
Dialogue: 0,0:04:17.01,0:04:19.85,Default,,0,0,0,,Teesra tareeka hai fake customer care
Dialogue: 0,0:04:19.85,0:04:20.28,Default,,0,0,0,,number.
Dialogue: 0,0:04:20.28,0:04:22.68,Default,,0,0,0,,Fraudster internet par apne number daal
Dialogue: 0,0:04:22.68,0:04:23.34,Default,,0,0,0,,dete hain,
Dialogue: 0,0:04:23.34,0:04:25.08,Default,,0,0,0,,badi companies ke naam se.
Dialogue: 0,0:04:25.08,0:04:26.17,Default,,0,0,0,,Kabhi review mein,
Dialogue: 0,0:04:26.17,0:04:27.70,Default,,0,0,0,,kabhi kisi page par.
Dialogue: 0,0:04:27.70,0:04:29.67,Default,,0,0,0,,Log jaldi mein jo pehla number
