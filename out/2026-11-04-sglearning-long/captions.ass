Dialogue: 0,0:05:15.64,0:05:17.21,Default,,0,0,0,,Ab doosra sawaal.
Dialogue: 0,0:05:17.21,0:05:19.41,Default,,0,0,0,,Paisa gaya toh gaya kahan?
Dialogue: 0,0:05:19.41,0:05:21.92,Default,,0,0,0,,Yahin Behen ghar aati hai.
Dialogue: 0,0:05:21.92,0:05:24.75,Default,,0,0,0,,Woh Mummy ka phone dekhti hai,
Dialogue: 0,0:05:24.75,0:05:26.00,Default,,0,0,0,,SMS padhti hai.
Dialogue: 0,0:05:26.00,0:05:28.83,Default,,0,0,0,,Aur sabse pehle ek baat kehti
Dialogue: 0,0:05:28.83,0:05:29.15,Default,,0,0,0,,hai.
Dialogue: 0,0:05:29.15,0:05:30.40,Default,,0,0,0,,Rona baad mein,
Dialogue: 0,0:05:30.40,0:05:31.97,Default,,0,0,0,,abhi call karo.
Dialogue: 0,0:05:31.97,0:05:34.80,Default,,0,0,0,,Is waqt har minute keemti hai.
Dialogue: 0,0:05:35.25,0:05:36.28,Default,,0,0,0,,Pehle samjho,
Dialogue: 0,0:05:36.28,0:05:38.59,Default,,0,0,0,,paisa ek jagah ruk kar nahi
Dialogue: 0,0:05:38.59,0:05:39.11,Default,,0,0,0,,baithta.
