Dialogue: 0,0:00:00.00,0:00:02.03,Default,,0,0,0,,Chakravyuh ka viral naksha,
Dialogue: 0,0:00:02.03,0:00:03.80,Default,,0,0,0,,Kurukshetra ka nahi,
Dialogue: 0,0:00:03.80,0:00:05.32,Default,,0,0,0,,Karnataka ka hai?
Dialogue: 0,0:00:05.77,0:00:08.31,Default,,0,0,0,,Mahabharat ke Drona Parva mein,
Dialogue: 0,0:00:08.31,0:00:09.32,Default,,0,0,0,,yuddh ka 13va din.
Dialogue: 0,0:00:09.32,0:00:12.37,Default,,0,0,0,,Dronacharya ne sena ko ghoomte ghere
Dialogue: 0,0:00:12.37,0:00:13.13,Default,,0,0,0,,mein sajaya.
Dialogue: 0,0:00:13.58,0:00:16.36,Default,,0,0,0,,Abhimanyu andar ghusna jaanta tha,
Dialogue: 0,0:00:16.36,0:00:18.13,Default,,0,0,0,,bahar nikalna nahi.
Dialogue: 0,0:00:18.13,0:00:20.66,Default,,0,0,0,,Jayadratha ne peeche raasta rok diya.
Dialogue: 0,0:00:20.66,0:00:22.18,Default,,0,0,0,,Woh akela ghir gaya.
Dialogue: 0,0:00:22.63,0:00:25.32,Default,,0,0,0,,Toh Kurukshetra ki mitti mein kya
Dialogue: 0,0:00:25.32,0:00:25.85,Default,,0,0,0,,mila?
Dialogue: 0,0:00:25.85,0:00:26.39,Default,,0,0,0,,ASI,
Dialogue: 0,0:00:26.39,0:00:30.15,Default,,0,0,0,,yaani purani cheezein khojne wala sarkari
Dialogue: 0,0:00:30.15,0:00:30.69,Default,,0,0,0,,vibhag.
Dialogue: 0,0:00:30.69,0:00:34.18,Default,,0,0,0,,Usne Mahabharat se judi jagahon par
Dialogue: 0,0:00:34.18,0:00:34.99,Default,,0,0,0,,khudai ki.
Dialogue: 0,0:00:35.44,0:00:38.04,Default,,0,0,0,,Mile ghar ke nishaan aur Painted
Dialogue: 0,0:00:38.04,0:00:38.90,Default,,0,0,0,,Grey Ware,
Dialogue: 0,0:00:38.90,0:00:42.08,Default,,0,0,0,,yaani bhoore rang ke purane bartan.
Dialogue: 0,0:00:42.53,0:00:44.72,Default,,0,0,0,,Par kisi khaas yuddh ka seedha
Dialogue: 0,0:00:44.72,0:00:46.35,Default,,0,0,0,,sabut nahi mila.
Dialogue: 0,0:00:46.35,0:00:49.08,Default,,0,0,0,,Aur viral naksha bhi kisi khudai
Dialogue: 0,0:00:49.08,0:00:50.45,Default,,0,0,0,,se nahi nikla.
Dialogue: 0,0:00:50.90,0:00:52.98,Default,,0,0,0,,Toh viral tasveer kahan ki hai?
Dialogue: 0,0:00:52.98,0:00:54.59,Default,,0,0,0,,Archaeologist kehte hain,
Dialogue: 0,0:00:54.59,0:00:57.82,Default,,0,0,0,,Karnataka ke Halebidu mandir ki deewar.
Dialogue: 0,0:00:58.27,0:01:01.61,Default,,0,0,0,,Hoysaleswara mandir ke pathhar par Abhimanyu
Dialogue: 0,0:01:01.61,0:01:03.39,Default,,0,0,0,,ghere mein ghuste dikhte hain.
Dialogue: 0,0:01:03.39,0:01:05.17,Default,,0,0,0,,Yeh mandir ki nakkashi hai,
Dialogue: 0,0:01:05.17,0:01:06.51,Default,,0,0,0,,yuddh ka naksha nahi.
Dialogue: 0,0:01:06.96,0:01:08.52,Default,,0,0,0,,Kuch log kehte hain,
Dialogue: 0,0:01:08.52,0:01:11.95,Default,,0,0,0,,bartan wala daur hi Mahabharat ka
Dialogue: 0,0:01:11.95,0:01:12.58,Default,,0,0,0,,daur hai.
Dialogue: 0,0:01:12.58,0:01:15.07,Default,,0,0,0,,Kai archaeologist kehte hain,
Dialogue: 0,0:01:15.07,0:01:17.88,Default,,0,0,0,,isse yuddh saabit nahi hota.
Dialogue: 0,0:01:18.33,0:01:21.72,Default,,0,0,0,,Twist Haryana ke Abhimanyupur gaon mein
Dialogue: 0,0:01:21.72,0:01:22.01,Default,,0,0,0,,hai.
Dialogue: 0,0:01:22.01,0:01:23.70,Default,,0,0,0,,Lok-katha kehti hai,
Dialogue: 0,0:01:23.70,0:01:27.10,Default,,0,0,0,,wahan bachche galiyon mein Chakravyuh khelte
Dialogue: 0,0:01:27.10,0:01:27.38,Default,,0,0,0,,hain.
Dialogue: 0,0:01:27.38,0:01:28.23,Default,,0,0,0,,7 ghere,
Dialogue: 0,0:01:28.23,0:01:30.21,Default,,0,0,0,,bina kisi ke sikhaye.
Dialogue: 0,0:01:30.66,0:01:32.95,Default,,0,0,0,,Kurukshetra ke kai naye naksho ko
Dialogue: 0,0:01:32.95,0:01:35.25,Default,,0,0,0,,experts park ka design batate hain.
Dialogue: 0,0:01:35.25,0:01:37.08,Default,,0,0,0,,Asli nakkashi dekhni ho,
Dialogue: 0,0:01:37.08,0:01:38.46,Default,,0,0,0,,toh Halebidu jaaiye.
Dialogue: 0,0:01:38.91,0:01:40.91,Default,,0,0,0,,Us dost ko bhejo jisne yeh
Dialogue: 0,0:01:40.91,0:01:42.91,Default,,0,0,0,,viral naksha forward kiya tha.
