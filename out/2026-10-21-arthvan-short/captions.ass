Dialogue: 0,0:00:00.00,0:00:03.30,Default,,0,0,0,,Samundar ke beech ek pul,
Dialogue: 0,0:00:03.30,0:00:06.60,Default,,0,0,0,,kya woh aaj bhi dikhta hai?
Dialogue: 0,0:00:06.60,0:00:10.84,Default,,0,0,0,,Valmiki Ramayana kehti hai,
Dialogue: 0,0:00:10.84,0:00:16.50,Default,,0,0,0,,vanar architect Nala ne samundar par
Dialogue: 0,0:00:16.50,0:00:18.39,Default,,0,0,0,,setu banaya.
Dialogue: 0,0:00:18.84,0:00:19.11,Default,,0,0,0,,Ped,
Dialogue: 0,0:00:19.11,0:00:19.67,Default,,0,0,0,,patthar,
Dialogue: 0,0:00:19.67,0:00:21.61,Default,,0,0,0,,pahadon ki chattanen,
Dialogue: 0,0:00:21.61,0:00:23.56,Default,,0,0,0,,aur setu sirf 5 din mein
Dialogue: 0,0:00:23.56,0:00:23.84,Default,,0,0,0,,taiyaar.
Dialogue: 0,0:00:24.29,0:00:26.29,Default,,0,0,0,,Aaj Rameswaram se Mannar tak,
Dialogue: 0,0:00:26.29,0:00:28.96,Default,,0,0,0,,satellite tasveer mein ek lambi line
Dialogue: 0,0:00:28.96,0:00:29.63,Default,,0,0,0,,dikhti hai.
Dialogue: 0,0:00:30.08,0:00:32.85,Default,,0,0,0,,2003 mein ISRO ne ise remote
Dialogue: 0,0:00:32.85,0:00:33.91,Default,,0,0,0,,sensing se jaancha.
Dialogue: 0,0:00:33.91,0:00:35.82,Default,,0,0,0,,Yaani space se zameen ki jaanch.
Dialogue: 0,0:00:36.27,0:00:37.12,Default,,0,0,0,,Nateeja,
Dialogue: 0,0:00:37.12,0:00:39.10,Default,,0,0,0,,103 chhote patch reefs,
Dialogue: 0,0:00:39.10,0:00:41.64,Default,,0,0,0,,yaani coral ke chhote teele,
Dialogue: 0,0:00:41.64,0:00:42.77,Default,,0,0,0,,ek line mein.
Dialogue: 0,0:00:43.22,0:00:45.77,Default,,0,0,0,,Geological Survey of India ne drilling
Dialogue: 0,0:00:45.77,0:00:45.98,Default,,0,0,0,,ki.
Dialogue: 0,0:00:45.98,0:00:48.32,Default,,0,0,0,,Neeche mila chune wala sandstone,
Dialogue: 0,0:00:48.32,0:00:49.17,Default,,0,0,0,,coral aur ret.
Dialogue: 0,0:00:49.17,0:00:50.02,Default,,0,0,0,,Carbon dating,
Dialogue: 0,0:00:50.02,0:00:52.14,Default,,0,0,0,,yaani umar ka vaigyanik hisaab,
Dialogue: 0,0:00:52.14,0:00:54.90,Default,,0,0,0,,coral ko hazaron saal purana batata
Dialogue: 0,0:00:54.90,0:00:55.12,Default,,0,0,0,,hai.
Dialogue: 0,0:00:55.57,0:00:58.41,Default,,0,0,0,,2007 mein Archaeological Survey of India
Dialogue: 0,0:00:58.41,0:00:58.98,Default,,0,0,0,,ne kaha.
Dialogue: 0,0:00:58.98,0:01:00.68,Default,,0,0,0,,Yeh ret aur coral ki kudrati
Dialogue: 0,0:01:00.68,0:01:01.44,Default,,0,0,0,,banawat hai.
Dialogue: 0,0:01:01.89,0:01:04.43,Default,,0,0,0,,Zyadatar scientists ise tombolo kehte hain,
Dialogue: 0,0:01:04.43,0:01:06.19,Default,,0,0,0,,yaani lehron se bani ret ki
Dialogue: 0,0:01:06.19,0:01:06.58,Default,,0,0,0,,patti.
Dialogue: 0,0:01:07.03,0:01:08.53,Default,,0,0,0,,Par kuch researchers kehte hain,
Dialogue: 0,0:01:08.53,0:01:10.22,Default,,0,0,0,,coral ke patthar dheeli ret ke
Dialogue: 0,0:01:10.22,0:01:11.16,Default,,0,0,0,,upar rakhe hain.
Dialogue: 0,0:01:11.16,0:01:12.67,Default,,0,0,0,,Jaise kisi ne jamaye hon.
Dialogue: 0,0:01:13.11,0:01:15.29,Default,,0,0,0,,Yeh rasta kab aur kaise paani
Dialogue: 0,0:01:15.29,0:01:16.01,Default,,0,0,0,,mein dooba,
Dialogue: 0,0:01:16.01,0:01:17.94,Default,,0,0,0,,yeh aaj bhi koi nahi jaanta.
Dialogue: 0,0:01:18.39,0:01:20.08,Default,,0,0,0,,Tairte pattharon ki kahani?
Dialogue: 0,0:01:20.08,0:01:22.51,Default,,0,0,0,,Vigyan aise pattharon ko pumice kehta
Dialogue: 0,0:01:22.51,0:01:22.70,Default,,0,0,0,,hai,
Dialogue: 0,0:01:22.70,0:01:24.57,Default,,0,0,0,,yaani chhedon wala halka patthar.
Dialogue: 0,0:01:25.02,0:01:27.22,Default,,0,0,0,,Aaj Dhanushkodi ke kinare se yeh
Dialogue: 0,0:01:27.22,0:01:29.42,Default,,0,0,0,,line samundar mein jaati dikhti hai.
Dialogue: 0,0:01:29.87,0:01:31.30,Default,,0,0,0,,Aapko kya lagta hai,
Dialogue: 0,0:01:31.30,0:01:33.46,Default,,0,0,0,,Ram Setu kudrat ka kamaal hai
Dialogue: 0,0:01:33.46,0:01:34.17,Default,,0,0,0,,ya kuch aur?
