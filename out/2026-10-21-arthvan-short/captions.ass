Dialogue: 0,0:00:00.00,0:00:01.64,Default,,0,0,0,,Samundar ke beech ek pul,
Dialogue: 0,0:00:01.64,0:00:03.27,Default,,0,0,0,,kya woh aaj bhi dikhta hai?
Dialogue: 0,0:00:03.27,0:00:05.38,Default,,0,0,0,,Valmiki Ramayana kehti hai,
Dialogue: 0,0:00:05.38,0:00:08.19,Default,,0,0,0,,vanar architect Nala ne samundar par
Dialogue: 0,0:00:08.19,0:00:09.12,Default,,0,0,0,,setu banaya.
Dialogue: 0,0:00:09.57,0:00:09.89,Default,,0,0,0,,Ped,
Dialogue: 0,0:00:09.89,0:00:10.52,Default,,0,0,0,,patthar,
Dialogue: 0,0:00:10.52,0:00:12.75,Default,,0,0,0,,pahadon ki chattanen,
Dialogue: 0,0:00:12.75,0:00:14.97,Default,,0,0,0,,aur setu sirf 5 din mein
Dialogue: 0,0:00:14.97,0:00:15.29,Default,,0,0,0,,taiyaar.
Dialogue: 0,0:00:15.74,0:00:17.68,Default,,0,0,0,,Aaj Rameswaram se Mannar tak,
Dialogue: 0,0:00:17.68,0:00:20.25,Default,,0,0,0,,satellite tasveer mein ek lambi line
Dialogue: 0,0:00:20.25,0:00:20.90,Default,,0,0,0,,dikhti hai.
Dialogue: 0,0:00:21.35,0:00:24.74,Default,,0,0,0,,2003 mein ISRO ne ise remote
Dialogue: 0,0:00:24.74,0:00:26.04,Default,,0,0,0,,sensing se jaancha.
Dialogue: 0,0:00:26.04,0:00:28.39,Default,,0,0,0,,Yaani space se zameen ki jaanch.
Dialogue: 0,0:00:28.84,0:00:29.77,Default,,0,0,0,,Nateeja,
Dialogue: 0,0:00:29.77,0:00:31.94,Default,,0,0,0,,103 chhote patch reefs,
Dialogue: 0,0:00:31.94,0:00:34.72,Default,,0,0,0,,yaani coral ke chhote teele,
Dialogue: 0,0:00:34.72,0:00:35.96,Default,,0,0,0,,ek line mein.
Dialogue: 0,0:00:36.41,0:00:38.99,Default,,0,0,0,,Geological Survey of India ne drilling
Dialogue: 0,0:00:38.99,0:00:39.20,Default,,0,0,0,,ki.
Dialogue: 0,0:00:39.20,0:00:41.57,Default,,0,0,0,,Neeche mila chune wala sandstone,
Dialogue: 0,0:00:41.57,0:00:42.43,Default,,0,0,0,,coral aur ret.
Dialogue: 0,0:00:42.43,0:00:43.29,Default,,0,0,0,,Carbon dating,
Dialogue: 0,0:00:43.29,0:00:45.44,Default,,0,0,0,,yaani umar ka vaigyanik hisaab,
Dialogue: 0,0:00:45.44,0:00:48.23,Default,,0,0,0,,coral ko hazaron saal purana batata
Dialogue: 0,0:00:48.23,0:00:48.45,Default,,0,0,0,,hai.
Dialogue: 0,0:00:48.90,0:00:52.15,Default,,0,0,0,,2007 mein Archaeological Survey of India
Dialogue: 0,0:00:52.15,0:00:52.80,Default,,0,0,0,,ne kaha.
Dialogue: 0,0:00:52.80,0:00:54.75,Default,,0,0,0,,Yeh ret aur coral ki kudrati
Dialogue: 0,0:00:54.75,0:00:55.62,Default,,0,0,0,,banawat hai.
Dialogue: 0,0:00:56.07,0:00:58.73,Default,,0,0,0,,Zyadatar scientists ise tombolo kehte hain,
Dialogue: 0,0:00:58.73,0:01:00.58,Default,,0,0,0,,yaani lehron se bani ret ki
Dialogue: 0,0:01:00.58,0:01:00.99,Default,,0,0,0,,patti.
Dialogue: 0,0:01:01.44,0:01:03.02,Default,,0,0,0,,Par kuch researchers kehte hain,
Dialogue: 0,0:01:03.02,0:01:04.80,Default,,0,0,0,,coral ke patthar dheeli ret ke
Dialogue: 0,0:01:04.80,0:01:05.78,Default,,0,0,0,,upar rakhe hain.
Dialogue: 0,0:01:05.78,0:01:07.36,Default,,0,0,0,,Jaise kisi ne jamaye hon.
Dialogue: 0,0:01:07.81,0:01:10.26,Default,,0,0,0,,Yeh rasta kab aur kaise paani
Dialogue: 0,0:01:10.26,0:01:11.07,Default,,0,0,0,,mein dooba,
Dialogue: 0,0:01:11.07,0:01:13.25,Default,,0,0,0,,yeh aaj bhi koi nahi jaanta.
Dialogue: 0,0:01:13.70,0:01:15.63,Default,,0,0,0,,Tairte pattharon ki kahani?
Dialogue: 0,0:01:15.63,0:01:18.42,Default,,0,0,0,,Vigyan aise pattharon ko pumice kehta
Dialogue: 0,0:01:18.42,0:01:18.64,Default,,0,0,0,,hai,
Dialogue: 0,0:01:18.64,0:01:20.78,Default,,0,0,0,,yaani chhedon wala halka patthar.
Dialogue: 0,0:01:21.23,0:01:23.35,Default,,0,0,0,,Aaj Dhanushkodi ke kinare se yeh
Dialogue: 0,0:01:23.35,0:01:25.47,Default,,0,0,0,,line samundar mein jaati dikhti hai.
Dialogue: 0,0:01:25.92,0:01:27.55,Default,,0,0,0,,Aapko kya lagta hai,
Dialogue: 0,0:01:27.55,0:01:29.99,Default,,0,0,0,,Ram Setu kudrat ka kamaal hai
Dialogue: 0,0:01:29.99,0:01:30.80,Default,,0,0,0,,ya kuch aur?
