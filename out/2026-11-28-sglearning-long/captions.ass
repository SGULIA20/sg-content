Dialogue: 0,0:00:00.00,0:00:02.10,Default,,0,0,0,,Sona 60 din mein 24.6 percent
Dialogue: 0,0:00:02.10,0:00:02.56,Default,,0,0,0,,gira.
Dialogue: 0,0:00:02.56,0:00:05.13,Default,,0,0,0,,1982 ke baad sabse bura daur.
Dialogue: 0,0:00:05.58,0:00:06.92,Default,,0,0,0,,Lekin sona toh safe tha?
Dialogue: 0,0:00:06.92,0:00:08.09,Default,,0,0,0,,Chandi aur buri giri.
Dialogue: 0,0:00:08.09,0:00:09.60,Default,,0,0,0,,Hafte bhar mein 15 percent se
Dialogue: 0,0:00:09.60,0:00:09.94,Default,,0,0,0,,zyada.
Dialogue: 0,0:00:10.39,0:00:11.39,Default,,0,0,0,,Aapke gehne.
Dialogue: 0,0:00:11.39,0:00:12.39,Default,,0,0,0,,Aapka gold loan.
Dialogue: 0,0:00:12.39,0:00:13.39,Default,,0,0,0,,Aapka gold fund.
Dialogue: 0,0:00:13.39,0:00:14.89,Default,,0,0,0,,Sab ki keemat hili.
Dialogue: 0,0:00:14.89,0:00:16.64,Default,,0,0,0,,Galti kahan hoti hai,
Dialogue: 0,0:00:16.64,0:00:17.39,Default,,0,0,0,,aaj samjhiye.
Dialogue: 0,0:00:17.84,0:00:19.94,Default,,0,0,0,,Sabse safe cheez pehle kyun bikti?
Dialogue: 0,0:00:19.94,0:00:20.99,Default,,0,0,0,,Jawab aakhir mein.
Dialogue: 0,0:00:20.99,0:00:21.83,Default,,0,0,0,,Aur woh wajah,
Dialogue: 0,0:00:21.83,0:00:23.30,Default,,0,0,0,,jo koi nahi batata.
Dialogue: 0,0:00:23.75,0:00:24.69,Default,,0,0,0,,Aaj 3 sawaal.
Dialogue: 0,0:00:24.69,0:00:25.17,Default,,0,0,0,,Pehla,
Dialogue: 0,0:00:25.17,0:00:27.30,Default,,0,0,0,,sona aur chandi kitna gire?
Dialogue: 0,0:00:27.30,0:00:27.77,Default,,0,0,0,,Doosra,
Dialogue: 0,0:00:27.77,0:00:29.19,Default,,0,0,0,,achanak kyun gire?
Dialogue: 0,0:00:29.19,0:00:29.67,Default,,0,0,0,,Teesra,
Dialogue: 0,0:00:29.67,0:00:30.61,Default,,0,0,0,,aapke gehne,
Dialogue: 0,0:00:30.61,0:00:32.04,Default,,0,0,0,,gold loan aur gold fund ka
Dialogue: 0,0:00:32.04,0:00:32.98,Default,,0,0,0,,ab kya hoga?
Dialogue: 0,0:00:33.43,0:00:34.25,Default,,0,0,0,,Pehle bhaav ki baat.
Dialogue: 0,0:00:34.25,0:00:35.71,Default,,0,0,0,,Duniya mein sone ka bhaav dollar
Dialogue: 0,0:00:35.71,0:00:36.36,Default,,0,0,0,,mein lagta hai,
Dialogue: 0,0:00:36.36,0:00:37.50,Default,,0,0,0,,har ounce ke hisaab se.
Dialogue: 0,0:00:37.50,0:00:39.77,Default,,0,0,0,,Ounce yaani sona tolne ka international
Dialogue: 0,0:00:39.77,0:00:40.26,Default,,0,0,0,,paimana,
Dialogue: 0,0:00:40.26,0:00:41.40,Default,,0,0,0,,hamare tole jaisa.
Dialogue: 0,0:00:41.85,0:00:43.49,Default,,0,0,0,,Mahinon tak yeh bhaav 3,500 dollar
Dialogue: 0,0:00:43.49,0:00:44.77,Default,,0,0,0,,ke upar tika raha.
Dialogue: 0,0:00:44.77,0:00:46.59,Default,,0,0,0,,Log ise mazboot deewar maante the.
Dialogue: 0,0:00:46.59,0:00:46.95,Default,,0,0,0,,Socha,
Dialogue: 0,0:00:46.95,0:00:48.41,Default,,0,0,0,,ab isse neeche kya jaayega.
Dialogue: 0,0:00:48.41,0:00:50.24,Default,,0,0,0,,Phir isi November woh deewar toot
Dialogue: 0,0:00:50.24,0:00:50.42,Default,,0,0,0,,gayi.
Dialogue: 0,0:00:50.87,0:00:52.43,Default,,0,0,0,,Ek din ke andar sona tezi
Dialogue: 0,0:00:52.43,0:00:52.95,Default,,0,0,0,,se phisla.
Dialogue: 0,0:00:52.95,0:00:53.64,Default,,0,0,0,,Itna neeche,
Dialogue: 0,0:00:53.64,0:00:55.72,Default,,0,0,0,,jitna pichhle 15 mahine mein kabhi
Dialogue: 0,0:00:55.72,0:00:56.41,Default,,0,0,0,,nahi gaya tha.
Dialogue: 0,0:00:56.41,0:00:57.45,Default,,0,0,0,,Bazaar bechain ho gaya.
Dialogue: 0,0:00:57.45,0:00:59.53,Default,,0,0,0,,Lekin yeh girawat achanak nahi thi.
Dialogue: 0,0:00:59.98,0:01:01.22,Default,,0,0,0,,India mein bhi jhatka pahuncha.
Dialogue: 0,0:01:01.22,0:01:02.74,Default,,0,0,0,,Hamare yahan sone ka daam isi
Dialogue: 0,0:01:02.74,0:01:03.85,Default,,0,0,0,,duniya ke bhaav se judta hai.
Dialogue: 0,0:01:03.85,0:01:04.54,Default,,0,0,0,,Wahan bhaav gira,
Dialogue: 0,0:01:04.54,0:01:06.06,Default,,0,0,0,,to Zaveri Bazaar ki dukaanon tak
Dialogue: 0,0:01:06.06,0:01:06.75,Default,,0,0,0,,asar aata hai.
Dialogue: 0,0:01:07.20,0:01:08.46,Default,,0,0,0,,Ab ek parivaar socho.
Dialogue: 0,0:01:08.46,0:01:09.89,Default,,0,0,0,,Beti ki shaadi ke liye kuch
Dialogue: 0,0:01:09.89,0:01:11.51,Default,,0,0,0,,hafte pehle gehne khareede.
Dialogue: 0,0:01:11.51,0:01:12.41,Default,,0,0,0,,Unchi keemat par.
Dialogue: 0,0:01:12.41,0:01:13.85,Default,,0,0,0,,Aaj wahi gehne tole jaayein,
Dialogue: 0,0:01:13.85,0:01:15.29,Default,,0,0,0,,to unka mol pehle se kam
Dialogue: 0,0:01:15.29,0:01:15.83,Default,,0,0,0,,niklega.
Dialogue: 0,0:01:16.28,0:01:17.97,Default,,0,0,0,,Par unhone kuch anokha nahi kiya.
Dialogue: 0,0:01:17.97,0:01:19.81,Default,,0,0,0,,Mahinon se sona lagaataar chadh raha
Dialogue: 0,0:01:19.81,0:01:19.97,Default,,0,0,0,,tha.
Dialogue: 0,0:01:19.97,0:01:20.43,Default,,0,0,0,,Ek lambi,
Dialogue: 0,0:01:20.43,0:01:21.66,Default,,0,0,0,,zordaar tezi chal rahi thi.
Dialogue: 0,0:01:21.66,0:01:22.73,Default,,0,0,0,,Har taraf yahi baat thi,
Dialogue: 0,0:01:22.73,0:01:23.81,Default,,0,0,0,,sona aur upar jaayega.
Dialogue: 0,0:01:24.26,0:01:26.34,Default,,0,0,0,,Yahin sabse badi galatfehmi chhupi hai.
Dialogue: 0,0:01:26.34,0:01:27.95,Default,,0,0,0,,Log 'safe' ka matlab samajhte hain,
Dialogue: 0,0:01:27.95,0:01:29.08,Default,,0,0,0,,'kabhi nahi girega'.
Dialogue: 0,0:01:29.08,0:01:30.04,Default,,0,0,0,,Par bazaar ne dikhaya,
Dialogue: 0,0:01:30.04,0:01:31.33,Default,,0,0,0,,safe cheez bhi tezi se gir
Dialogue: 0,0:01:31.33,0:01:31.81,Default,,0,0,0,,sakti hai.
Dialogue: 0,0:01:32.26,0:01:33.87,Default,,0,0,0,,Toh itni bikri aayi kahan se?
Dialogue: 0,0:01:33.87,0:01:35.84,Default,,0,0,0,,Gali ke chhote khareedar se nahi.
Dialogue: 0,0:01:35.84,0:01:37.45,Default,,0,0,0,,Duniya ke bade bazaaron se,
Dialogue: 0,0:01:37.45,0:01:39.06,Default,,0,0,0,,jahan ek din mein bahut bada
Dialogue: 0,0:01:39.06,0:01:39.78,Default,,0,0,0,,maal bikta hai.
Dialogue: 0,0:01:40.23,0:01:41.35,Default,,0,0,0,,Aur asli sawaal yeh hai.
Dialogue: 0,0:01:41.35,0:01:43.27,Default,,0,0,0,,Itni lambi tezi ko achanak brake
Dialogue: 0,0:01:43.27,0:01:43.90,Default,,0,0,0,,kisne lagaya?
Dialogue: 0,0:01:43.90,0:01:44.86,Default,,0,0,0,,Jawab samundar paar,
Dialogue: 0,0:01:44.86,0:01:46.62,Default,,0,0,0,,America ke kuch aankdon mein chhupa
Dialogue: 0,0:01:46.62,0:01:46.78,Default,,0,0,0,,hai.
Dialogue: 0,0:01:47.23,0:01:48.09,Default,,0,0,0,,Doosra sawaal:
Dialogue: 0,0:01:48.09,0:01:49.81,Default,,0,0,0,,sona achanak kyun gira?
Dialogue: 0,0:01:49.81,0:01:51.32,Default,,0,0,0,,Is baar 3 dhakke ek saath
Dialogue: 0,0:01:51.32,0:01:51.75,Default,,0,0,0,,lage.
Dialogue: 0,0:01:51.75,0:01:52.19,Default,,0,0,0,,Mehngai,
Dialogue: 0,0:01:52.19,0:01:53.05,Default,,0,0,0,,byaaj aur dollar.
Dialogue: 0,0:01:53.05,0:01:54.34,Default,,0,0,0,,Ek ek karke samjhiye,
Dialogue: 0,0:01:54.34,0:01:56.28,Default,,0,0,0,,kyunki yeh aapas mein jude hain.
Dialogue: 0,0:01:56.73,0:01:57.47,Default,,0,0,0,,Pehla dhakka,
Dialogue: 0,0:01:57.47,0:01:57.83,Default,,0,0,0,,mehngai.
Dialogue: 0,0:01:57.83,0:01:59.85,Default,,0,0,0,,America mein mehngai ke naye aankde
Dialogue: 0,0:01:59.85,0:02:00.95,Default,,0,0,0,,umeed se garam aaye.
Dialogue: 0,0:02:00.95,0:02:02.97,Default,,0,0,0,,Matlab wahan roz ki cheezein andaaze
Dialogue: 0,0:02:02.97,0:02:04.62,Default,,0,0,0,,se zyada tezi se mehngi ho
Dialogue: 0,0:02:04.62,0:02:05.17,Default,,0,0,0,,rahi thi.
Dialogue: 0,0:02:05.62,0:02:07.37,Default,,0,0,0,,Ab America ka central bank,
Dialogue: 0,0:02:07.37,0:02:08.93,Default,,0,0,0,,jo wahan byaaj tay karta hai,
Dialogue: 0,0:02:08.93,0:02:10.10,Default,,0,0,0,,mehngai se ladta hai.
Dialogue: 0,0:02:10.10,0:02:10.50,Default,,0,0,0,,Kaise?
Dialogue: 0,0:02:10.50,0:02:11.47,Default,,0,0,0,,Byaaj ooncha rakh kar.
Dialogue: 0,0:02:11.47,0:02:12.45,Default,,0,0,0,,Bazaar ko laga,
Dialogue: 0,0:02:12.45,0:02:14.20,Default,,0,0,0,,byaaj ab jaldi kam nahi hoga.
Dialogue: 0,0:02:14.66,0:02:15.52,Default,,0,0,0,,Doosra dhakka,
Dialogue: 0,0:02:15.52,0:02:15.73,Default,,0,0,0,,byaaj.
Dialogue: 0,0:02:15.73,0:02:17.46,Default,,0,0,0,,Yahan ek seedhi baat samjho.
Dialogue: 0,0:02:17.46,0:02:19.19,Default,,0,0,0,,Sona koi byaaj nahi deta.
Dialogue: 0,0:02:19.19,0:02:21.56,Default,,0,0,0,,Woh tijori mein chupchaap pada rehta
Dialogue: 0,0:02:21.56,0:02:21.77,Default,,0,0,0,,hai.
Dialogue: 0,0:02:21.77,0:02:22.42,Default,,0,0,0,,Na kiraya,
Dialogue: 0,0:02:22.42,0:02:23.28,Default,,0,0,0,,na munafa,
Dialogue: 0,0:02:23.28,0:02:24.15,Default,,0,0,0,,bas bhaav ka khel.
Dialogue: 0,0:02:24.60,0:02:25.53,Default,,0,0,0,,Ek misaal lijiye.
Dialogue: 0,0:02:25.53,0:02:27.59,Default,,0,0,0,,Ek dukaan har mahine kiraya deti
Dialogue: 0,0:02:27.59,0:02:27.78,Default,,0,0,0,,hai.
Dialogue: 0,0:02:27.78,0:02:29.09,Default,,0,0,0,,Doosri khaali padi hai,
Dialogue: 0,0:02:29.09,0:02:30.03,Default,,0,0,0,,koi kiraya nahi.
Dialogue: 0,0:02:30.03,0:02:30.59,Default,,0,0,0,,Byaaj badhe,
Dialogue: 0,0:02:30.59,0:02:32.46,Default,,0,0,0,,to log kiraye wali dukaan pasand
Dialogue: 0,0:02:32.46,0:02:33.02,Default,,0,0,0,,karte hain.
Dialogue: 0,0:02:33.02,0:02:34.52,Default,,0,0,0,,Sona woh khaali dukaan hai.
Dialogue: 0,0:02:34.97,0:02:36.24,Default,,0,0,0,,Jab bank ki FD aur sarkari
Dialogue: 0,0:02:36.24,0:02:37.68,Default,,0,0,0,,bond achha byaaj dene lagte hain,
Dialogue: 0,0:02:37.68,0:02:39.27,Default,,0,0,0,,tab sona rakhna mehnga lagta hai.
Dialogue: 0,0:02:39.27,0:02:40.55,Default,,0,0,0,,Bade fund sona bech kar byaaj
Dialogue: 0,0:02:40.55,0:02:42.14,Default,,0,0,0,,wali cheezon mein paisa daalte hain.
Dialogue: 0,0:02:42.59,0:02:43.41,Default,,0,0,0,,Teesra dhakka,
Dialogue: 0,0:02:43.41,0:02:43.81,Default,,0,0,0,,dollar.
Dialogue: 0,0:02:43.81,0:02:45.65,Default,,0,0,0,,Mehngai aur oonche byaaj ki umeed
Dialogue: 0,0:02:45.65,0:02:47.28,Default,,0,0,0,,ne dollar ko phir mazboot kiya.
Dialogue: 0,0:02:47.28,0:02:48.09,Default,,0,0,0,,Aur yaad rakhiye,
Dialogue: 0,0:02:48.09,0:02:49.72,Default,,0,0,0,,sone ka bhaav dollar mein hi
Dialogue: 0,0:02:49.72,0:02:50.33,Default,,0,0,0,,lagta hai.
Dialogue: 0,0:02:50.78,0:02:51.74,Default,,0,0,0,,Dollar mehnga hua,
Dialogue: 0,0:02:51.74,0:02:53.46,Default,,0,0,0,,to baaki deshon ke liye sona
Dialogue: 0,0:02:53.46,0:02:54.22,Default,,0,0,0,,mehnga ho gaya.
Dialogue: 0,0:02:54.22,0:02:54.79,Default,,0,0,0,,Europe,
Dialogue: 0,0:02:54.79,0:02:55.18,Default,,0,0,0,,Japan,
Dialogue: 0,0:02:55.18,0:02:57.08,Default,,0,0,0,,India ka khareedar thoda ruk gaya.
Dialogue: 0,0:02:57.08,0:02:58.04,Default,,0,0,0,,Maang dheeli padi,
Dialogue: 0,0:02:58.04,0:02:58.99,Default,,0,0,0,,aur bhaav neeche aaya.
Dialogue: 0,0:02:59.44,0:03:00.81,Default,,0,0,0,,Ise jhoole ki tarah samjho.
Dialogue: 0,0:03:00.81,0:03:02.02,Default,,0,0,0,,Ek taraf dollar baitha hai,
Dialogue: 0,0:03:02.02,0:03:02.93,Default,,0,0,0,,doosri taraf sona.
Dialogue: 0,0:03:02.93,0:03:03.99,Default,,0,0,0,,Dollar upar jaata hai,
Dialogue: 0,0:03:03.99,0:03:05.50,Default,,0,0,0,,to sona aksar neeche aata hai.
Dialogue: 0,0:03:05.50,0:03:06.41,Default,,0,0,0,,Is baar bhi yahi hua.
Dialogue: 0,0:03:06.86,0:03:08.02,Default,,0,0,0,,Aur ek aakhri kaaran,
Dialogue: 0,0:03:08.02,0:03:08.98,Default,,0,0,0,,sabse insaani.
Dialogue: 0,0:03:08.98,0:03:11.30,Default,,0,0,0,,Mahinon ki tezi mein jinhone pehle
Dialogue: 0,0:03:11.30,0:03:12.07,Default,,0,0,0,,khareeda tha,
Dialogue: 0,0:03:12.07,0:03:14.19,Default,,0,0,0,,unke paas bada munafa jama tha.
Dialogue: 0,0:03:14.19,0:03:14.77,Default,,0,0,0,,Kaagaz par.
Dialogue: 0,0:03:14.77,0:03:15.92,Default,,0,0,0,,Abhi jeb mein nahi.
Dialogue: 0,0:03:16.37,0:03:17.52,Default,,0,0,0,,Jaise hi hawa badli,
Dialogue: 0,0:03:17.52,0:03:19.32,Default,,0,0,0,,unhone munafa jeb mein daalne ke
Dialogue: 0,0:03:19.32,0:03:19.81,Default,,0,0,0,,liye becha.
Dialogue: 0,0:03:19.81,0:03:21.28,Default,,0,0,0,,Ise profit-booking kehte hain.
Dialogue: 0,0:03:21.28,0:03:22.76,Default,,0,0,0,,Yaani kamaai bachaane ke liye,
Dialogue: 0,0:03:22.76,0:03:23.90,Default,,0,0,0,,tezi ke baad bech dena.
Dialogue: 0,0:03:24.35,0:03:25.52,Default,,0,0,0,,Phir domino chala.
Dialogue: 0,0:03:25.52,0:03:26.31,Default,,0,0,0,,Ek ne becha,
Dialogue: 0,0:03:26.31,0:03:26.89,Default,,0,0,0,,bhaav gira.
Dialogue: 0,0:03:26.89,0:03:27.48,Default,,0,0,0,,Bhaav gira,
Dialogue: 0,0:03:27.48,0:03:28.46,Default,,0,0,0,,to doosre ghabraaye.
Dialogue: 0,0:03:28.46,0:03:29.63,Default,,0,0,0,,Unhone bhi becha.
Dialogue: 0,0:03:29.63,0:03:31.39,Default,,0,0,0,,Bikri se aur bikri paida hui,
Dialogue: 0,0:03:31.39,0:03:32.76,Default,,0,0,0,,aur girawat tez ho gayi.
Dialogue: 0,0:03:33.21,0:03:34.91,Default,,0,0,0,,Par ek baat ajeeb lagti hai.
Dialogue: 0,0:03:34.91,0:03:35.98,Default,,0,0,0,,Kitaab kehti hai,
Dialogue: 0,0:03:35.98,0:03:38.11,Default,,0,0,0,,mehngai badhe to sona chadhta hai.
Dialogue: 0,0:03:38.11,0:03:39.60,Default,,0,0,0,,Phir is baar mehngai badhi,
Dialogue: 0,0:03:39.60,0:03:40.66,Default,,0,0,0,,aur sona gira.
Dialogue: 0,0:03:40.66,0:03:41.73,Default,,0,0,0,,Yeh ulta kyun hua?
Dialogue: 0,0:03:42.18,0:03:44.10,Default,,0,0,0,,Kyunki is baar bazaar mehngai se
Dialogue: 0,0:03:44.10,0:03:44.32,Default,,0,0,0,,kam,
Dialogue: 0,0:03:44.32,0:03:45.60,Default,,0,0,0,,byaaj se zyada dara.
Dialogue: 0,0:03:45.60,0:03:47.53,Default,,0,0,0,,Garam mehngai matlab ooncha byaaj.
Dialogue: 0,0:03:47.53,0:03:49.24,Default,,0,0,0,,Aur ooncha byaaj sone ke liye
Dialogue: 0,0:03:49.24,0:03:49.66,Default,,0,0,0,,bhaari.
Dialogue: 0,0:03:49.66,0:03:50.95,Default,,0,0,0,,Wahi asli khel tha.
Dialogue: 0,0:03:51.40,0:03:51.94,Default,,0,0,0,,Ab chandi.
Dialogue: 0,0:03:51.94,0:03:53.22,Default,,0,0,0,,Kitco News ke mutabik,
Dialogue: 0,0:03:53.22,0:03:55.04,Default,,0,0,0,,chandi hafte bhar mein 15 percent
Dialogue: 0,0:03:55.04,0:03:55.95,Default,,0,0,0,,se zyada giri.
Dialogue: 0,0:03:55.95,0:03:57.41,Default,,0,0,0,,Yeh is saal ka uska sabse
Dialogue: 0,0:03:57.41,0:03:58.32,Default,,0,0,0,,bura hafta tha.
Dialogue: 0,0:03:58.32,0:03:59.42,Default,,0,0,0,,Sone se kaafi tez.
Dialogue: 0,0:03:59.87,0:04:00.05,Default,,0,0,0,,Kyun?
Dialogue: 0,0:04:00.05,0:04:00.78,Default,,0,0,0,,Pehli wajah,
Dialogue: 0,0:04:00.78,0:04:02.60,Default,,0,0,0,,chandi ka bazaar sone se kaafi
Dialogue: 0,0:04:02.60,0:04:03.15,Default,,0,0,0,,chhota hai.
Dialogue: 0,0:04:03.15,0:04:04.79,Default,,0,0,0,,Chhote talaab mein ek pathar bhi
Dialogue: 0,0:04:04.79,0:04:06.24,Default,,0,0,0,,badi lehar uthata hai.
Dialogue: 0,0:04:06.24,0:04:06.97,Default,,0,0,0,,Thodi bikri,
Dialogue: 0,0:04:06.97,0:04:07.88,Default,,0,0,0,,aur bada jhatka.
Dialogue: 0,0:04:08.33,0:04:09.06,Default,,0,0,0,,Doosri wajah,
Dialogue: 0,0:04:09.06,0:04:10.33,Default,,0,0,0,,chandi sirf gehna nahi.
Dialogue: 0,0:04:10.33,0:04:11.05,Default,,0,0,0,,Solar panel,
Dialogue: 0,0:04:11.05,0:04:13.05,Default,,0,0,0,,electronics aur factory ke kaam mein
Dialogue: 0,0:04:13.05,0:04:13.77,Default,,0,0,0,,bhi lagti hai.
Dialogue: 0,0:04:13.77,0:04:15.40,Default,,0,0,0,,Isliye uska bhaav kai taraf se
Dialogue: 0,0:04:15.40,0:04:15.95,Default,,0,0,0,,hilta hai.
Dialogue: 0,0:04:16.40,0:04:18.44,Default,,0,0,0,,Matlab chandi sone ki chhoti behen
Dialogue: 0,0:04:18.44,0:04:19.00,Default,,0,0,0,,jaisi hai.
Dialogue: 0,0:04:19.00,0:04:19.75,Default,,0,0,0,,Saath chalti hai,
Dialogue: 0,0:04:19.75,0:04:20.68,Default,,0,0,0,,par zyada chanchal.
Dialogue: 0,0:04:20.68,0:04:22.36,Default,,0,0,0,,Tezi mein sone se tez bhaagti
Dialogue: 0,0:04:22.36,0:04:22.54,Default,,0,0,0,,hai.
Dialogue: 0,0:04:22.54,0:04:23.47,Default,,0,0,0,,Aur girawat mein,
Dialogue: 0,0:04:23.47,0:04:24.78,Default,,0,0,0,,usse bhi tez girti hai.
Dialogue: 0,0:04:25.23,0:04:26.81,Default,,0,0,0,,Kai gharon mein chandi ke sikke,
Dialogue: 0,0:04:26.81,0:04:28.40,Default,,0,0,0,,payal aur bartan jama karne ka
Dialogue: 0,0:04:28.40,0:04:28.93,Default,,0,0,0,,riwaaz hai.
Dialogue: 0,0:04:28.93,0:04:30.69,Default,,0,0,0,,Jinhone tezi ke top par 'sasta
Dialogue: 0,0:04:30.69,0:04:32.10,Default,,0,0,0,,sona' samajh kar chandi li,
Dialogue: 0,0:04:32.10,0:04:33.69,Default,,0,0,0,,unhe sabse tez jhatka laga.
Dialogue: 0,0:04:34.14,0:04:35.12,Default,,0,0,0,,Ab bada sawaal.
Dialogue: 0,0:04:35.12,0:04:37.07,Default,,0,0,0,,Kya aisi girawat pehle bhi aayi
Dialogue: 0,0:04:37.07,0:04:37.27,Default,,0,0,0,,hai?
Dialogue: 0,0:04:37.27,0:04:38.44,Default,,0,0,0,,Ya yeh pehli baar hai?
Dialogue: 0,0:04:38.44,0:04:40.20,Default,,0,0,0,,Itihaas ka jawab seedha hai.
Dialogue: 0,0:04:40.20,0:04:40.39,Default,,0,0,0,,Haan,
Dialogue: 0,0:04:40.39,0:04:40.78,Default,,0,0,0,,aayi hai.
Dialogue: 0,0:04:40.78,0:04:41.95,Default,,0,0,0,,Aur lambi bhi chali.
Dialogue: 0,0:04:42.40,0:04:43.98,Default,,0,0,0,,2013 ko yaad kijiye.
Dialogue: 0,0:04:43.98,0:04:45.36,Default,,0,0,0,,BullionVault ke mutabik,
Dialogue: 0,0:04:45.36,0:04:47.14,Default,,0,0,0,,us poore saal mein sona dollar
Dialogue: 0,0:04:47.14,0:04:48.52,Default,,0,0,0,,mein 30 percent gira.
Dialogue: 0,0:04:48.52,0:04:50.30,Default,,0,0,0,,Yaani lagbhag ek tihaai keemat,
Dialogue: 0,0:04:50.30,0:04:51.08,Default,,0,0,0,,saal bhar mein saaf.
Dialogue: 0,0:04:51.53,0:04:53.28,Default,,0,0,0,,Tab bhi kahani milti-julti thi.
Dialogue: 0,0:04:53.28,0:04:55.21,Default,,0,0,0,,America ke central bank ne paise
Dialogue: 0,0:04:55.21,0:04:56.78,Default,,0,0,0,,ki neeti modne ke sanket diye.
Dialogue: 0,0:04:56.78,0:04:58.36,Default,,0,0,0,,Sasta paisa band hone ki baat
Dialogue: 0,0:04:58.36,0:04:58.53,Default,,0,0,0,,aayi,
Dialogue: 0,0:04:58.53,0:04:59.76,Default,,0,0,0,,aur sona bikne laga.
Dialogue: 0,0:05:00.21,0:05:01.88,Default,,0,0,0,,2013 ka sabak saaf tha.
Dialogue: 0,0:05:01.88,0:05:03.56,Default,,0,0,0,,Jise duniya 'safe' kehti hai,
Dialogue: 0,0:05:03.56,0:05:05.42,Default,,0,0,0,,woh bhi lambi girawat dekh sakta
Dialogue: 0,0:05:05.42,0:05:05.61,Default,,0,0,0,,hai.
Dialogue: 0,0:05:05.61,0:05:06.36,Default,,0,0,0,,Hafton nahi,
Dialogue: 0,0:05:06.36,0:05:07.10,Default,,0,0,0,,mahinon tak.
Dialogue: 0,0:05:07.10,0:05:08.78,Default,,0,0,0,,Jab paise ki neeti mudti hai.
Dialogue: 0,0:05:09.23,0:05:10.83,Default,,0,0,0,,Us waqt jinhone ghabra kar neeche
Dialogue: 0,0:05:10.83,0:05:11.15,Default,,0,0,0,,becha,
Dialogue: 0,0:05:11.15,0:05:13.24,Default,,0,0,0,,unhone kaagazi nuksaan ko asli bana
Dialogue: 0,0:05:13.24,0:05:13.40,Default,,0,0,0,,diya.
Dialogue: 0,0:05:13.40,0:05:13.88,Default,,0,0,0,,Jo ruke,
Dialogue: 0,0:05:13.88,0:05:15.33,Default,,0,0,0,,unhe intezaar karna pada.
Dialogue: 0,0:05:15.33,0:05:16.94,Default,,0,0,0,,Aur woh intezaar chhota nahi tha.
Dialogue: 0,0:05:17.39,0:05:18.65,Default,,0,0,0,,Yaani sona tootta nahi,
Dialogue: 0,0:05:18.65,0:05:20.06,Default,,0,0,0,,par kabhi kabhi lambi neend so
Dialogue: 0,0:05:20.06,0:05:20.54,Default,,0,0,0,,jaata hai.
Dialogue: 0,0:05:20.54,0:05:22.11,Default,,0,0,0,,Yeh baat jewellery ki dukaan par
Dialogue: 0,0:05:22.11,0:05:23.05,Default,,0,0,0,,koi nahi batata.
Dialogue: 0,0:05:23.05,0:05:24.79,Default,,0,0,0,,Wahan sirf tezi ki kahaniyan sunaai
Dialogue: 0,0:05:24.79,0:05:25.26,Default,,0,0,0,,jaati hain.
Dialogue: 0,0:05:25.71,0:05:27.22,Default,,0,0,0,,Par ek paheli ab bhi baaki
Dialogue: 0,0:05:27.22,0:05:27.39,Default,,0,0,0,,hai.
Dialogue: 0,0:05:27.39,0:05:28.91,Default,,0,0,0,,Dar ke waqt sona chadhna chahiye.
Dialogue: 0,0:05:28.91,0:05:30.42,Default,,0,0,0,,Phir bade jhatke ke pehle din,
Dialogue: 0,0:05:30.42,0:05:32.11,Default,,0,0,0,,sabse pehle sona hi kyun bikta
Dialogue: 0,0:05:32.11,0:05:32.27,Default,,0,0,0,,hai?
Dialogue: 0,0:05:32.27,0:05:33.62,Default,,0,0,0,,Jawab chaunkaane wala hai.
Dialogue: 0,0:05:34.07,0:05:35.72,Default,,0,0,0,,Sona 'safe' kaha jaata hai.
Dialogue: 0,0:05:35.72,0:05:37.18,Default,,0,0,0,,Phir sona sirf 60 din mein
Dialogue: 0,0:05:37.18,0:05:38.28,Default,,0,0,0,,24.6 percent kyun gira?
Dialogue: 0,0:05:38.28,0:05:40.11,Default,,0,0,0,,Yeh sawaal aaj sona rakhne wale
Dialogue: 0,0:05:40.11,0:05:41.57,Default,,0,0,0,,har parivaar ke mann mein hai.
Dialogue: 0,0:05:42.02,0:05:44.48,Default,,0,0,0,,Commodity analyst Lukas Kuemmerle ke mutabik,
Dialogue: 0,0:05:44.48,0:05:46.16,Default,,0,0,0,,60 din mein itni badi girawat
Dialogue: 0,0:05:46.16,0:05:47.70,Default,,0,0,0,,1982 ke baad nahi aayi thi.
Dialogue: 0,0:05:47.70,0:05:49.39,Default,,0,0,0,,Matlab aapke Papa ki jawani ke
Dialogue: 0,0:05:49.39,0:05:49.54,Default,,0,0,0,,baad,
Dialogue: 0,0:05:49.54,0:05:50.77,Default,,0,0,0,,aisa daur nahi dekha gaya.
Dialogue: 0,0:05:51.22,0:05:52.48,Default,,0,0,0,,Toh asli wajah kya hai?
Dialogue: 0,0:05:52.48,0:05:53.38,Default,,0,0,0,,Ek kadwi sachchai.
Dialogue: 0,0:05:53.38,0:05:55.17,Default,,0,0,0,,Duniya ke bade fund aksar udhaar
Dialogue: 0,0:05:55.17,0:05:56.97,Default,,0,0,0,,ka paisa lekar shares aur doosri
Dialogue: 0,0:05:56.97,0:05:58.95,Default,,0,0,0,,cheezon par bahut bada daav lagaate
Dialogue: 0,0:05:58.95,0:05:59.13,Default,,0,0,0,,hain.
Dialogue: 0,0:05:59.58,0:06:01.48,Default,,0,0,0,,Jab bazaar mein achanak jhatka lagta
Dialogue: 0,0:06:01.48,0:06:01.66,Default,,0,0,0,,hai,
Dialogue: 0,0:06:01.66,0:06:03.56,Default,,0,0,0,,to udhaar dene wala turant paisa
Dialogue: 0,0:06:03.56,0:06:04.08,Default,,0,0,0,,maangta hai.
Dialogue: 0,0:06:04.08,0:06:05.47,Default,,0,0,0,,Ise margin call kehte hain.
Dialogue: 0,0:06:05.47,0:06:07.20,Default,,0,0,0,,Yaani 'abhi paisa jama karo,
Dialogue: 0,0:06:07.20,0:06:08.07,Default,,0,0,0,,warna saude band'.
Dialogue: 0,0:06:08.52,0:06:09.48,Default,,0,0,0,,Ab fund kya beche?
Dialogue: 0,0:06:09.48,0:06:10.82,Default,,0,0,0,,Gire hue share beche,
Dialogue: 0,0:06:10.82,0:06:11.78,Default,,0,0,0,,to bada nuksaan.
Dialogue: 0,0:06:11.78,0:06:13.70,Default,,0,0,0,,Kuch cheezein turant bikti hi nahi.
Dialogue: 0,0:06:13.70,0:06:15.05,Default,,0,0,0,,Toh woh woh cheez bechta hai
Dialogue: 0,0:06:15.05,0:06:15.62,Default,,0,0,0,,jo foran,
Dialogue: 0,0:06:15.62,0:06:16.77,Default,,0,0,0,,achhe daam par bik jaaye.
Dialogue: 0,0:06:17.22,0:06:18.19,Default,,0,0,0,,Woh cheez hai sona.
Dialogue: 0,0:06:18.19,0:06:20.32,Default,,0,0,0,,Duniya ka sabse aasaani se bikne
Dialogue: 0,0:06:20.32,0:06:20.90,Default,,0,0,0,,wala maal.
Dialogue: 0,0:06:20.90,0:06:22.84,Default,,0,0,0,,Isliye bade dar ke pehle jhatke
Dialogue: 0,0:06:22.84,0:06:23.03,Default,,0,0,0,,mein,
Dialogue: 0,0:06:23.03,0:06:25.16,Default,,0,0,0,,sona aksar sabse pehle bikta hai.
Dialogue: 0,0:06:25.16,0:06:25.94,Default,,0,0,0,,Majboori mein.
Dialogue: 0,0:06:26.39,0:06:27.95,Default,,0,0,0,,Matlab sona is liye nahi gira
Dialogue: 0,0:06:27.95,0:06:28.88,Default,,0,0,0,,ki woh bekaar ho gaya.
Dialogue: 0,0:06:28.88,0:06:30.13,Default,,0,0,0,,Woh is liye bika kyunki woh
Dialogue: 0,0:06:30.13,0:06:30.91,Default,,0,0,0,,sabse kaam ka tha.
Dialogue: 0,0:06:30.91,0:06:31.85,Default,,0,0,0,,Sabse bharosemand,
Dialogue: 0,0:06:31.85,0:06:33.57,Default,,0,0,0,,aur sabse jaldi paisa dene wala.
Dialogue: 0,0:06:34.02,0:06:35.71,Default,,0,0,0,,Toh agli baar sona achanak gire,
Dialogue: 0,0:06:35.71,0:06:36.48,Default,,0,0,0,,to yeh yaad rakhna.
Dialogue: 0,0:06:36.48,0:06:38.33,Default,,0,0,0,,Har girawat kamzori ka sabut nahi.
Dialogue: 0,0:06:38.33,0:06:39.71,Default,,0,0,0,,Kabhi kabhi yeh bas kisi aur
Dialogue: 0,0:06:39.71,0:06:41.25,Default,,0,0,0,,ka nuksaan bharne ki bikri hoti
Dialogue: 0,0:06:41.25,0:06:41.41,Default,,0,0,0,,hai.
Dialogue: 0,0:06:41.86,0:06:42.73,Default,,0,0,0,,Teesra sawaal,
Dialogue: 0,0:06:42.73,0:06:44.02,Default,,0,0,0,,aur sabse zaroori.
Dialogue: 0,0:06:44.02,0:06:45.54,Default,,0,0,0,,Aapke paise ka ab kya?
Dialogue: 0,0:06:45.54,0:06:47.49,Default,,0,0,0,,Har tarah ke sone wale par
Dialogue: 0,0:06:47.49,0:06:48.58,Default,,0,0,0,,asar alag hai.
Dialogue: 0,0:06:48.58,0:06:49.01,Default,,0,0,0,,Gehne,
Dialogue: 0,0:06:49.01,0:06:49.44,Default,,0,0,0,,gold loan,
Dialogue: 0,0:06:49.44,0:06:51.18,Default,,0,0,0,,gold fund aur sarkari gold bond.
Dialogue: 0,0:06:51.63,0:06:52.68,Default,,0,0,0,,Pehle gehne wale.
Dialogue: 0,0:06:52.68,0:06:54.26,Default,,0,0,0,,Agar tezi ke waqt gehne liye,
Dialogue: 0,0:06:54.26,0:06:55.84,Default,,0,0,0,,to aaj unka mol kam dikhega.
Dialogue: 0,0:06:55.84,0:06:57.41,Default,,0,0,0,,Par gehne aksar bechne ke liye
Dialogue: 0,0:06:57.41,0:06:57.76,Default,,0,0,0,,nahi,
Dialogue: 0,0:06:57.76,0:06:59.69,Default,,0,0,0,,pehenne aur sambhaalne ke liye hote
Dialogue: 0,0:06:59.69,0:06:59.87,Default,,0,0,0,,hain.
Dialogue: 0,0:07:00.32,0:07:01.28,Default,,0,0,0,,Ek baat yaad rakhiye.
Dialogue: 0,0:07:01.28,0:07:03.20,Default,,0,0,0,,Gehne par making charge lagta hai,
Dialogue: 0,0:07:03.20,0:07:04.55,Default,,0,0,0,,yaani banwaai ka kharcha.
Dialogue: 0,0:07:04.55,0:07:06.47,Default,,0,0,0,,Bechte waqt yeh aksar wapas nahi
Dialogue: 0,0:07:06.47,0:07:06.85,Default,,0,0,0,,milta.
Dialogue: 0,0:07:06.85,0:07:08.39,Default,,0,0,0,,Isliye gehna investment kam,
Dialogue: 0,0:07:08.39,0:07:09.16,Default,,0,0,0,,shauk zyada hai.
Dialogue: 0,0:07:09.61,0:07:09.98,Default,,0,0,0,,Doosre,
Dialogue: 0,0:07:09.98,0:07:10.73,Default,,0,0,0,,gold loan wale.
Dialogue: 0,0:07:10.73,0:07:12.42,Default,,0,0,0,,Aapne sona girvi rakh kar bank
Dialogue: 0,0:07:12.42,0:07:12.98,Default,,0,0,0,,se loan liya.
Dialogue: 0,0:07:12.98,0:07:14.85,Default,,0,0,0,,Girvi yaani loan ke badle sona
Dialogue: 0,0:07:14.85,0:07:16.16,Default,,0,0,0,,bank ke paas jama rakhna.
Dialogue: 0,0:07:16.16,0:07:17.66,Default,,0,0,0,,Bank sone ke bhaav ke hisaab
Dialogue: 0,0:07:17.66,0:07:18.79,Default,,0,0,0,,se hi loan deta hai.
Dialogue: 0,0:07:19.24,0:07:19.93,Default,,0,0,0,,Ab bhaav gira,
Dialogue: 0,0:07:19.93,0:07:21.31,Default,,0,0,0,,to bank ki nazar mein aapka
Dialogue: 0,0:07:21.31,0:07:22.86,Default,,0,0,0,,girvi sona kam keemat ka ho
Dialogue: 0,0:07:22.86,0:07:23.03,Default,,0,0,0,,gaya.
Dialogue: 0,0:07:23.03,0:07:24.93,Default,,0,0,0,,Aise mein bank thoda paisa lautane
Dialogue: 0,0:07:24.93,0:07:26.31,Default,,0,0,0,,ya aur sona rakhne ko keh
Dialogue: 0,0:07:26.31,0:07:26.83,Default,,0,0,0,,sakta hai.
Dialogue: 0,0:07:27.28,0:07:28.90,Default,,0,0,0,,Isliye gold loan wale apne bank
Dialogue: 0,0:07:28.90,0:07:30.52,Default,,0,0,0,,ke message aur shartein dhyaan se
Dialogue: 0,0:07:30.52,0:07:30.88,Default,,0,0,0,,padhein.
Dialogue: 0,0:07:30.88,0:07:31.96,Default,,0,0,0,,Ghabraahat mein nahi,
Dialogue: 0,0:07:31.96,0:07:33.76,Default,,0,0,0,,poori baat samajh kar kadam uthayein.
Dialogue: 0,0:07:33.76,0:07:35.38,Default,,0,0,0,,Yahi sabse sasta bachaav hai.
Dialogue: 0,0:07:35.83,0:07:36.20,Default,,0,0,0,,Teesre,
Dialogue: 0,0:07:36.20,0:07:36.92,Default,,0,0,0,,gold ETF wale.
Dialogue: 0,0:07:36.92,0:07:38.74,Default,,0,0,0,,ETF yaani share bazaar ke raaste
Dialogue: 0,0:07:38.74,0:07:39.83,Default,,0,0,0,,khareeda gaya sona,
Dialogue: 0,0:07:39.83,0:07:41.83,Default,,0,0,0,,bina tijori aur bina chori ke
Dialogue: 0,0:07:41.83,0:07:42.19,Default,,0,0,0,,darr ke.
Dialogue: 0,0:07:42.19,0:07:43.65,Default,,0,0,0,,Iska bhaav roz sone ke saath
Dialogue: 0,0:07:43.65,0:07:44.19,Default,,0,0,0,,chalta hai.
Dialogue: 0,0:07:44.64,0:07:45.48,Default,,0,0,0,,Toh sona gira,
Dialogue: 0,0:07:45.48,0:07:46.65,Default,,0,0,0,,to aapka ETF bhi gira.
Dialogue: 0,0:07:46.65,0:07:47.99,Default,,0,0,0,,Yeh fund ki galti nahi hai.
Dialogue: 0,0:07:47.99,0:07:49.33,Default,,0,0,0,,Fund wahi kar raha hai jo
Dialogue: 0,0:07:49.33,0:07:50.17,Default,,0,0,0,,usse karna tha.
Dialogue: 0,0:07:50.17,0:07:51.84,Default,,0,0,0,,Sone ki parchhai ki tarah chalna.
Dialogue: 0,0:07:52.29,0:07:52.70,Default,,0,0,0,,Chauthe,
Dialogue: 0,0:07:52.70,0:07:53.32,Default,,0,0,0,,SGB wale.
Dialogue: 0,0:07:53.32,0:07:54.97,Default,,0,0,0,,SGB yaani Sovereign Gold Bond,
Dialogue: 0,0:07:54.97,0:07:56.00,Default,,0,0,0,,sarkar ka gold bond.
Dialogue: 0,0:07:56.00,0:07:57.86,Default,,0,0,0,,Iski keemat bhi sone ke saath
Dialogue: 0,0:07:57.86,0:07:59.31,Default,,0,0,0,,upar neeche hoti hai.
Dialogue: 0,0:07:59.31,0:08:00.75,Default,,0,0,0,,Lekin isme ek fark hai.
Dialogue: 0,0:08:01.21,0:08:02.65,Default,,0,0,0,,SGB sone ke bhaav ke upar
Dialogue: 0,0:08:02.65,0:08:03.92,Default,,0,0,0,,har saal 2.5 percent byaaj bhi
Dialogue: 0,0:08:03.92,0:08:04.46,Default,,0,0,0,,deta hai.
Dialogue: 0,0:08:04.46,0:08:05.00,Default,,0,0,0,,Bhaav gire,
Dialogue: 0,0:08:05.00,0:08:06.45,Default,,0,0,0,,tab bhi yeh chhota byaaj aata
Dialogue: 0,0:08:06.45,0:08:07.00,Default,,0,0,0,,rehta hai.
Dialogue: 0,0:08:07.00,0:08:08.99,Default,,0,0,0,,Girawat mein yeh thoda sahara hai.
Dialogue: 0,0:08:09.44,0:08:11.10,Default,,0,0,0,,Ab sabse badi galti,
Dialogue: 0,0:08:11.10,0:08:11.57,Default,,0,0,0,,top par.
Dialogue: 0,0:08:11.57,0:08:13.70,Default,,0,0,0,,Jab har jagah 'sona record par'
Dialogue: 0,0:08:13.70,0:08:14.42,Default,,0,0,0,,ki baat ho,
Dialogue: 0,0:08:14.42,0:08:16.55,Default,,0,0,0,,tabhi zyadatar log daudte hain.
Dialogue: 0,0:08:16.55,0:08:17.26,Default,,0,0,0,,Bheed ke saath,
Dialogue: 0,0:08:17.26,0:08:18.92,Default,,0,0,0,,sabse unchi keemat par.
Dialogue: 0,0:08:19.37,0:08:20.53,Default,,0,0,0,,Aur neeche ki galti.
Dialogue: 0,0:08:20.53,0:08:22.27,Default,,0,0,0,,Jab bhaav gire aur khabrein daraayein,
Dialogue: 0,0:08:22.27,0:08:24.01,Default,,0,0,0,,wahi log ghabra kar bech dete
Dialogue: 0,0:08:24.01,0:08:24.21,Default,,0,0,0,,hain.
Dialogue: 0,0:08:24.21,0:08:24.98,Default,,0,0,0,,Unche mein liya,
Dialogue: 0,0:08:24.98,0:08:25.95,Default,,0,0,0,,neeche mein becha.
Dialogue: 0,0:08:25.95,0:08:27.69,Default,,0,0,0,,Kaagazi nuksaan asli ban gaya.
Dialogue: 0,0:08:28.14,0:08:28.81,Default,,0,0,0,,Teesri galti,
Dialogue: 0,0:08:28.81,0:08:29.97,Default,,0,0,0,,'safe' ka galat matlab.
Dialogue: 0,0:08:29.97,0:08:31.47,Default,,0,0,0,,Safe ka matlab hai lambe waqt
Dialogue: 0,0:08:31.47,0:08:32.13,Default,,0,0,0,,ka sahara.
Dialogue: 0,0:08:32.13,0:08:33.63,Default,,0,0,0,,Iska matlab yeh nahi ki bhaav
Dialogue: 0,0:08:33.63,0:08:34.79,Default,,0,0,0,,kabhi nahi girega.
Dialogue: 0,0:08:34.79,0:08:36.46,Default,,0,0,0,,2013 ne yahi sikhaya tha.
Dialogue: 0,0:08:36.91,0:08:38.16,Default,,0,0,0,,Toh samajhdaari kya hai?
Dialogue: 0,0:08:38.16,0:08:39.23,Default,,0,0,0,,Pehle khud se poochhiye,
Dialogue: 0,0:08:39.23,0:08:40.30,Default,,0,0,0,,sona kyun rakha hai?
Dialogue: 0,0:08:40.30,0:08:41.01,Default,,0,0,0,,Shaadi ke liye,
Dialogue: 0,0:08:41.01,0:08:41.91,Default,,0,0,0,,mushkil waqt ke liye,
Dialogue: 0,0:08:41.91,0:08:43.34,Default,,0,0,0,,ya jaldi munafe ke liye?
Dialogue: 0,0:08:43.34,0:08:44.94,Default,,0,0,0,,Jawab se hi soch badalti hai.
Dialogue: 0,0:08:45.39,0:08:46.76,Default,,0,0,0,,Jo log sona thoda thoda,
Dialogue: 0,0:08:46.76,0:08:48.30,Default,,0,0,0,,alag alag waqt par lete hain,
Dialogue: 0,0:08:48.30,0:08:49.67,Default,,0,0,0,,unhe top ka dar kam rehta
Dialogue: 0,0:08:49.67,0:08:49.84,Default,,0,0,0,,hai.
Dialogue: 0,0:08:49.84,0:08:51.55,Default,,0,0,0,,Aur khabar ki garmi mein jaldbaazi
Dialogue: 0,0:08:51.55,0:08:52.40,Default,,0,0,0,,bhaari padti hai.
Dialogue: 0,0:08:52.40,0:08:54.11,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:08:54.56,0:08:55.77,Default,,0,0,0,,Ab shuru ka sawaal.
Dialogue: 0,0:08:55.77,0:08:57.80,Default,,0,0,0,,Sabse safe cheez sabse pehle kyun
Dialogue: 0,0:08:57.80,0:08:58.20,Default,,0,0,0,,biki?
Dialogue: 0,0:08:58.20,0:08:59.82,Default,,0,0,0,,Kyunki dar ke waqt duniya ko
Dialogue: 0,0:08:59.82,0:09:01.24,Default,,0,0,0,,turant paisa chahiye tha.
Dialogue: 0,0:09:01.24,0:09:03.26,Default,,0,0,0,,Aur sona sabse turant bikta hai.
Dialogue: 0,0:09:03.71,0:09:04.53,Default,,0,0,0,,Agle video mein,
Dialogue: 0,0:09:04.53,0:09:05.35,Default,,0,0,0,,gold loan ki shartein,
Dialogue: 0,0:09:05.35,0:09:06.17,Default,,0,0,0,,aasaan bhasha mein.
Dialogue: 0,0:09:06.17,0:09:07.32,Default,,0,0,0,,Aur yeh video us dost ko
Dialogue: 0,0:09:07.32,0:09:07.65,Default,,0,0,0,,bhejo,
Dialogue: 0,0:09:07.65,0:09:09.29,Default,,0,0,0,,jo kehta hai sona kabhi nahi
Dialogue: 0,0:09:09.29,0:09:09.62,Default,,0,0,0,,girta.
Dialogue: 0,0:09:10.07,0:09:11.68,Default,,0,0,0,,Ab aapse ek aasaan sawaal.
Dialogue: 0,0:09:11.68,0:09:13.28,Default,,0,0,0,,Aapke ghar mein sona kis liye
Dialogue: 0,0:09:13.28,0:09:13.49,Default,,0,0,0,,hai:
Dialogue: 0,0:09:13.49,0:09:13.89,Default,,0,0,0,,shaadi,
Dialogue: 0,0:09:13.89,0:09:14.49,Default,,0,0,0,,mushkil waqt,
Dialogue: 0,0:09:14.49,0:09:15.29,Default,,0,0,0,,ya munafa?
Dialogue: 0,0:09:15.29,0:09:16.90,Default,,0,0,0,,Comment mein bas ek shabd likhiye.
