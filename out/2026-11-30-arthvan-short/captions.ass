Dialogue: 0,0:00:00.00,0:00:01.40,Default,,0,0,0,,Kya Shani sach mein Ravan ki
Dialogue: 0,0:00:01.40,0:00:02.27,Default,,0,0,0,,seedhi bane the?
Dialogue: 0,0:00:02.72,0:00:03.70,Default,,0,0,0,,Katha kehti hai,
Dialogue: 0,0:00:03.70,0:00:05.07,Default,,0,0,0,,Ravan ne 9 grah jeet liye.
Dialogue: 0,0:00:05.07,0:00:07.61,Default,,0,0,0,,Unhe sinhasan ke neeche ulta litakar
Dialogue: 0,0:00:07.61,0:00:08.59,Default,,0,0,0,,seedhi bana diya.
Dialogue: 0,0:00:09.04,0:00:10.33,Default,,0,0,0,,Phir Narad muni bole,
Dialogue: 0,0:00:10.33,0:00:11.44,Default,,0,0,0,,chhaati par pair rakho.
Dialogue: 0,0:00:11.44,0:00:11.99,Default,,0,0,0,,Grah palte,
Dialogue: 0,0:00:11.99,0:00:13.65,Default,,0,0,0,,aur Shani ki nazar Ravan par
Dialogue: 0,0:00:13.65,0:00:14.02,Default,,0,0,0,,padi.
Dialogue: 0,0:00:14.47,0:00:15.69,Default,,0,0,0,,Lekin likha kahan hai?
Dialogue: 0,0:00:15.69,0:00:17.43,Default,,0,0,0,,Valmiki ka critical edition,
Dialogue: 0,0:00:17.43,0:00:19.35,Default,,0,0,0,,Oriental Institute Baroda ka.
Dialogue: 0,0:00:19.35,0:00:21.61,Default,,0,0,0,,Yaani purani pothiyon se nikala asli
Dialogue: 0,0:00:21.61,0:00:21.79,Default,,0,0,0,,paath.
Dialogue: 0,0:00:21.79,0:00:23.36,Default,,0,0,0,,Usme yeh katha hai hi nahi.
Dialogue: 0,0:00:23.80,0:00:25.97,Default,,0,0,0,,Tulsidas ki Ramcharitmanas,
Dialogue: 0,0:00:25.97,0:00:26.69,Default,,0,0,0,,lagbhag 1576.
Dialogue: 0,0:00:26.69,0:00:27.42,Default,,0,0,0,,Likha hai,
Dialogue: 0,0:00:27.42,0:00:29.10,Default,,0,0,0,,sab grah Ravan ke vash mein
Dialogue: 0,0:00:29.10,0:00:29.34,Default,,0,0,0,,the.
Dialogue: 0,0:00:29.34,0:00:30.06,Default,,0,0,0,,Par seedhi?
Dialogue: 0,0:00:30.06,0:00:31.03,Default,,0,0,0,,Koi zikr nahi.
Dialogue: 0,0:00:31.48,0:00:32.82,Default,,0,0,0,,Toh katha mili kahan?
Dialogue: 0,0:00:32.82,0:00:34.16,Default,,0,0,0,,Ananda Ramayana mein,
Dialogue: 0,0:00:34.16,0:00:35.89,Default,,0,0,0,,jo Valmiki se bahut baad ka
Dialogue: 0,0:00:35.89,0:00:36.27,Default,,0,0,0,,granth hai.
Dialogue: 0,0:00:36.73,0:00:37.24,Default,,0,0,0,,Aur khudai?
Dialogue: 0,0:00:37.24,0:00:37.93,Default,,0,0,0,,ASI ne B.
Dialogue: 0,0:00:37.93,0:00:38.10,Default,,0,0,0,,B.
Dialogue: 0,0:00:38.10,0:00:39.30,Default,,0,0,0,,Lal ke saath Ramayan ke sthal
Dialogue: 0,0:00:39.30,0:00:39.64,Default,,0,0,0,,khode.
Dialogue: 0,0:00:39.64,0:00:41.87,Default,,0,0,0,,Sringaverapura mein bada talaab mila,
Dialogue: 0,0:00:41.87,0:00:43.07,Default,,0,0,0,,seedhi ka nishaan nahi.
Dialogue: 0,0:00:43.52,0:00:45.19,Default,,0,0,0,,Deogarh ke Gupta-kaal mandir mein grah
Dialogue: 0,0:00:45.19,0:00:46.53,Default,,0,0,0,,devta pathar par khude hain.
Dialogue: 0,0:00:46.53,0:00:47.53,Default,,0,0,0,,Pooja purani hai,
Dialogue: 0,0:00:47.53,0:00:49.20,Default,,0,0,0,,par Ravan wali katha wahan bhi
Dialogue: 0,0:00:49.20,0:00:49.53,Default,,0,0,0,,nahi.
Dialogue: 0,0:00:49.98,0:00:51.04,Default,,0,0,0,,Vidwan bhi bante hain.
Dialogue: 0,0:00:51.04,0:00:51.92,Default,,0,0,0,,Uttara Kanda,
Dialogue: 0,0:00:51.92,0:00:53.50,Default,,0,0,0,,yaani Ramayan ka aakhri hissa,
Dialogue: 0,0:00:53.50,0:00:54.91,Default,,0,0,0,,kuch kehte baad mein joda gaya.
Dialogue: 0,0:00:54.91,0:00:56.32,Default,,0,0,0,,Doosre kehte shuru se tha.
Dialogue: 0,0:00:56.77,0:00:56.95,Default,,0,0,0,,H.
Dialogue: 0,0:00:56.95,0:00:57.12,Default,,0,0,0,,D.
Dialogue: 0,0:00:57.12,0:00:58.83,Default,,0,0,0,,Sankalia ne Lanka ko Vindhya ke
Dialogue: 0,0:00:58.83,0:00:59.34,Default,,0,0,0,,paas bataya.
Dialogue: 0,0:00:59.34,0:01:01.06,Default,,0,0,0,,Baaki ise Sri Lanka maante hain.
Dialogue: 0,0:01:01.51,0:01:03.67,Default,,0,0,0,,Seedhi wali katha pehli baar kahan
Dialogue: 0,0:01:03.67,0:01:04.26,Default,,0,0,0,,suni gayi?
Dialogue: 0,0:01:04.26,0:01:05.24,Default,,0,0,0,,Koi nahi jaanta.
Dialogue: 0,0:01:05.24,0:01:06.62,Default,,0,0,0,,Phir bhi har ghar mein zinda
Dialogue: 0,0:01:06.62,0:01:06.82,Default,,0,0,0,,hai.
Dialogue: 0,0:01:07.27,0:01:08.85,Default,,0,0,0,,Deogarh mein woh grah aap aaj
Dialogue: 0,0:01:08.85,0:01:09.75,Default,,0,0,0,,dekh sakte hain.
Dialogue: 0,0:01:09.75,0:01:10.21,Default,,0,0,0,,Jawab:
Dialogue: 0,0:01:10.21,0:01:11.34,Default,,0,0,0,,yeh lok katha hai,
Dialogue: 0,0:01:11.34,0:01:12.70,Default,,0,0,0,,Valmiki ki nahi.
Dialogue: 0,0:01:13.15,0:01:14.11,Default,,0,0,0,,Nani ko bhejo,
Dialogue: 0,0:01:14.11,0:01:16.61,Default,,0,0,0,,jinhone Shani-Ravan ki yeh katha sunayi
Dialogue: 0,0:01:16.61,0:01:16.81,Default,,0,0,0,,thi.
