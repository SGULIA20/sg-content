Dialogue: 0,0:00:00.00,0:00:00.71,Default,,0,0,0,,Shani Dev,
Dialogue: 0,0:00:00.71,0:00:03.31,Default,,0,0,0,,Ravan ke singhasan ki seedhi bane
Dialogue: 0,0:00:03.31,0:00:03.55,Default,,0,0,0,,the?
Dialogue: 0,0:00:03.55,0:00:04.49,Default,,0,0,0,,Munh zameen par.
Dialogue: 0,0:00:04.49,0:00:05.91,Default,,0,0,0,,Peeth par Ravan ka pair.
Dialogue: 0,0:00:05.91,0:00:07.57,Default,,0,0,0,,Yeh katha aayi kahan se?
Dialogue: 0,0:00:08.02,0:00:09.86,Default,,0,0,0,,Meghnad ka janm hone wala hai.
Dialogue: 0,0:00:09.86,0:00:10.89,Default,,0,0,0,,Ravan ki zid hai,
Dialogue: 0,0:00:10.89,0:00:11.91,Default,,0,0,0,,beta ajay ho.
Dialogue: 0,0:00:11.91,0:00:13.76,Default,,0,0,0,,Woh saare graha kaid kar leta
Dialogue: 0,0:00:13.76,0:00:13.96,Default,,0,0,0,,hai.
Dialogue: 0,0:00:13.96,0:00:15.60,Default,,0,0,0,,Par ek graha jhukta nahi.
Dialogue: 0,0:00:16.05,0:00:17.12,Default,,0,0,0,,Ravan kehta hai,
Dialogue: 0,0:00:17.12,0:00:18.39,Default,,0,0,0,,sab shubh ghar mein baitho.
Dialogue: 0,0:00:18.39,0:00:20.10,Default,,0,0,0,,Ghar yaani kundli ka khana.
Dialogue: 0,0:00:20.10,0:00:21.37,Default,,0,0,0,,Shani nahi maante.
Dialogue: 0,0:00:21.37,0:00:23.29,Default,,0,0,0,,Ravan unka pair tod deta hai.
Dialogue: 0,0:00:23.74,0:00:25.39,Default,,0,0,0,,Par Ravan ko Shani ki nazar
Dialogue: 0,0:00:25.39,0:00:25.95,Default,,0,0,0,,se darr hai.
Dialogue: 0,0:00:25.95,0:00:26.50,Default,,0,0,0,,Woh nazar,
Dialogue: 0,0:00:26.50,0:00:27.79,Default,,0,0,0,,jo bura waqt laati hai.
Dialogue: 0,0:00:27.79,0:00:28.52,Default,,0,0,0,,Hukm aata hai,
Dialogue: 0,0:00:28.52,0:00:29.81,Default,,0,0,0,,munh neeche karke leto.
Dialogue: 0,0:00:30.26,0:00:32.42,Default,,0,0,0,,Shani singhasan ke aage ulte lete
Dialogue: 0,0:00:32.42,0:00:32.60,Default,,0,0,0,,hain.
Dialogue: 0,0:00:32.60,0:00:34.23,Default,,0,0,0,,Ravan unki peeth par chadhta hai.
Dialogue: 0,0:00:34.23,0:00:35.67,Default,,0,0,0,,Nazar kabhi nahi milti.
Dialogue: 0,0:00:35.67,0:00:37.11,Default,,0,0,0,,Phir Lanka mein aag lagti hai.
Dialogue: 0,0:00:37.56,0:00:39.30,Default,,0,0,0,,Hanuman ki poonch se Lanka jal
Dialogue: 0,0:00:39.30,0:00:39.88,Default,,0,0,0,,rahi hai.
Dialogue: 0,0:00:39.88,0:00:41.62,Default,,0,0,0,,Dhuen mein ek karaah sunai deti
Dialogue: 0,0:00:41.62,0:00:41.81,Default,,0,0,0,,hai.
Dialogue: 0,0:00:41.81,0:00:43.16,Default,,0,0,0,,Hanuman ruk jaate hain.
Dialogue: 0,0:00:43.61,0:00:45.33,Default,,0,0,0,,Woh Shani ko kaid se chhuda
Dialogue: 0,0:00:45.33,0:00:45.97,Default,,0,0,0,,dete hain.
Dialogue: 0,0:00:45.97,0:00:48.33,Default,,0,0,0,,Isiliye Shani ke kasht mein Hanuman
Dialogue: 0,0:00:48.33,0:00:49.40,Default,,0,0,0,,pooje jaate hain.
Dialogue: 0,0:00:49.40,0:00:50.26,Default,,0,0,0,,Ab asli twist.
Dialogue: 0,0:00:50.71,0:00:52.61,Default,,0,0,0,,Valmiki ki Ramayan kholo.
Dialogue: 0,0:00:52.61,0:00:53.09,Default,,0,0,0,,24,000 shlok.
Dialogue: 0,0:00:53.09,0:00:54.04,Default,,0,0,0,,Ravan Yama,
Dialogue: 0,0:00:54.04,0:00:54.52,Default,,0,0,0,,Kuber,
Dialogue: 0,0:00:54.52,0:00:56.18,Default,,0,0,0,,Indra ko harata hai.
Dialogue: 0,0:00:56.18,0:00:57.60,Default,,0,0,0,,Par Shani ki seedhi?
Dialogue: 0,0:00:57.60,0:00:58.79,Default,,0,0,0,,Ek line nahi.
Dialogue: 0,0:00:59.24,0:01:01.64,Default,,0,0,0,,Tulsidas ki Ramcharitmanas mein bhi nahi.
Dialogue: 0,0:01:01.64,0:01:03.11,Default,,0,0,0,,Yeh katha milti hai baad ki
Dialogue: 0,0:01:03.11,0:01:03.85,Default,,0,0,0,,Ramayanon mein,
Dialogue: 0,0:01:03.85,0:01:04.95,Default,,0,0,0,,lagbhag 15vi sadi mein.
Dialogue: 0,0:01:05.40,0:01:05.98,Default,,0,0,0,,Aur patthar?
Dialogue: 0,0:01:05.98,0:01:07.70,Default,,0,0,0,,Ellora ke Kailash mandir jaiye.
Dialogue: 0,0:01:07.70,0:01:09.04,Default,,0,0,0,,Wahan ulta drishya hai.
Dialogue: 0,0:01:09.04,0:01:10.95,Default,,0,0,0,,Shiv ke angoothe tale Ravan khud
Dialogue: 0,0:01:10.95,0:01:11.52,Default,,0,0,0,,daba hai.
Dialogue: 0,0:01:11.97,0:01:12.75,Default,,0,0,0,,Seedha jawab,
Dialogue: 0,0:01:12.75,0:01:13.72,Default,,0,0,0,,yeh lok katha hai,
Dialogue: 0,0:01:13.72,0:01:14.89,Default,,0,0,0,,Valmiki ki nahi.
Dialogue: 0,0:01:14.89,0:01:16.05,Default,,0,0,0,,Par sawaal baaki hai,
Dialogue: 0,0:01:16.05,0:01:17.41,Default,,0,0,0,,pehli baar kisne sunayi?
Dialogue: 0,0:01:17.86,0:01:18.68,Default,,0,0,0,,Dadi ko bhejo,
Dialogue: 0,0:01:18.68,0:01:20.31,Default,,0,0,0,,jo Shanivar ko Hanuman ji ko
Dialogue: 0,0:01:20.31,0:01:20.80,Default,,0,0,0,,poojti hain.
