Dialogue: 0,0:00:00.00,0:00:03.37,Default,,0,0,0,,4 November ka dividend chakkar kya
Dialogue: 0,0:00:03.37,0:00:03.68,Default,,0,0,0,,hai?
Dialogue: 0,0:00:03.68,0:00:05.52,Default,,0,0,0,,Saath mein 9 aur khabrein.
Dialogue: 0,0:00:05.97,0:00:06.36,Default,,0,0,0,,Ek:
Dialogue: 0,0:00:06.36,0:00:07.54,Default,,0,0,0,,Coal India,
Dialogue: 0,0:00:07.54,0:00:11.46,Default,,0,0,0,,Asian Paints dividend de rahe hain,
Dialogue: 0,0:00:11.46,0:00:13.81,Default,,0,0,0,,taareekh 4 November.
Dialogue: 0,0:00:14.26,0:00:14.61,Default,,0,0,0,,Do:
Dialogue: 0,0:00:14.61,0:00:17.73,Default,,0,0,0,,EAAA India share bazaar mein aayi,
Dialogue: 0,0:00:17.73,0:00:21.54,Default,,0,0,0,,bade funds ne kaafi hissa khareeda.
Dialogue: 0,0:00:21.99,0:00:22.25,Default,,0,0,0,,Teen:
Dialogue: 0,0:00:22.25,0:00:24.91,Default,,0,0,0,,Sri Lotus ke malik apne shares
Dialogue: 0,0:00:24.91,0:00:25.71,Default,,0,0,0,,bechenge,
Dialogue: 0,0:00:25.71,0:00:27.83,Default,,0,0,0,,Sebi ke niyam ki wajah se.
Dialogue: 0,0:00:28.28,0:00:28.57,Default,,0,0,0,,Chaar:
Dialogue: 0,0:00:28.57,0:00:30.03,Default,,0,0,0,,Sebi ka naya niyam,
Dialogue: 0,0:00:30.03,0:00:33.83,Default,,0,0,0,,videshi paisa ab kiraye wali property
Dialogue: 0,0:00:33.83,0:00:35.00,Default,,0,0,0,,funds mein aayega.
Dialogue: 0,0:00:35.45,0:00:35.71,Default,,0,0,0,,Paanch:
Dialogue: 0,0:00:35.71,0:00:39.38,Default,,0,0,0,,America ki kuch companies bhari dividend
Dialogue: 0,0:00:39.38,0:00:40.16,Default,,0,0,0,,deti hain,
Dialogue: 0,0:00:40.16,0:00:41.73,Default,,0,0,0,,jokhim bhi bada hai.
Dialogue: 0,0:00:42.18,0:00:42.43,Default,,0,0,0,,Chhe:
Dialogue: 0,0:00:42.43,0:00:44.91,Default,,0,0,0,,Reliance ki tezi aur tax raahat
Dialogue: 0,0:00:44.91,0:00:46.90,Default,,0,0,0,,ke prastav se bazaar uchhla.
Dialogue: 0,0:00:47.35,0:00:47.66,Default,,0,0,0,,Saat:
Dialogue: 0,0:00:47.66,0:00:51.07,Default,,0,0,0,,Gold-silver October mein kaafi gire,
Dialogue: 0,0:00:51.07,0:00:54.48,Default,,0,0,0,,Dhanteras ki planning sasti ho sakti
Dialogue: 0,0:00:54.48,0:00:54.79,Default,,0,0,0,,hai.
Dialogue: 0,0:00:55.24,0:00:55.53,Default,,0,0,0,,Aath:
Dialogue: 0,0:00:55.53,0:00:58.16,Default,,0,0,0,,Goldman Sachs ke hisaab se England
Dialogue: 0,0:00:58.16,0:01:00.20,Default,,0,0,0,,mein byaaj phir badh sakta hai.
Dialogue: 0,0:01:00.65,0:01:00.99,Default,,0,0,0,,Nau:
Dialogue: 0,0:01:00.99,0:01:03.75,Default,,0,0,0,,AI ke kharche se bade tech
Dialogue: 0,0:01:03.75,0:01:07.53,Default,,0,0,0,,ne share buyback 83 percent ghataye.
Dialogue: 0,0:01:07.98,0:01:08.22,Default,,0,0,0,,Das:
Dialogue: 0,0:01:08.22,0:01:10.38,Default,,0,0,0,,Gold record se 30 percent se
Dialogue: 0,0:01:10.38,0:01:11.34,Default,,0,0,0,,zyada gira,
Dialogue: 0,0:01:11.34,0:01:13.74,Default,,0,0,0,,analyst kam umeed bata rahe.
Dialogue: 0,0:01:14.19,0:01:16.43,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:16.43,0:01:18.00,Default,,0,0,0,,Us dost ko bhejo jo har
Dialogue: 0,0:01:18.00,0:01:19.79,Default,,0,0,0,,tip par share le leta hai.
