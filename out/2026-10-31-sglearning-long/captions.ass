Dialogue: 0,0:00:00.00,0:00:02.61,Default,,0,0,0,,Mummy ne apne shaadi ke kangan
Dialogue: 0,0:00:02.61,0:00:04.96,Default,,0,0,0,,jeweller ke counter par rakhe.
Dialogue: 0,0:00:04.96,0:00:06.00,Default,,0,0,0,,Unhe laga,
Dialogue: 0,0:00:06.00,0:00:08.61,Default,,0,0,0,,itne saal mein sona kitna mehnga
Dialogue: 0,0:00:08.61,0:00:09.13,Default,,0,0,0,,ho gaya.
Dialogue: 0,0:00:09.13,0:00:11.47,Default,,0,0,0,,Aaj toh achha paisa milega.
Dialogue: 0,0:00:11.47,0:00:13.56,Default,,0,0,0,,Jeweller ne kangan tole,
Dialogue: 0,0:00:13.56,0:00:15.13,Default,,0,0,0,,calculator chalaya,
Dialogue: 0,0:00:15.13,0:00:17.47,Default,,0,0,0,,aur muskura kar rakam batayi.
Dialogue: 0,0:00:17.47,0:00:19.56,Default,,0,0,0,,Mummy ka chehra utar gaya.
Dialogue: 0,0:00:20.01,0:00:21.60,Default,,0,0,0,,Rakam kam nahi thi,
Dialogue: 0,0:00:21.60,0:00:23.71,Default,,0,0,0,,par umeed se bahut kam thi.
Dialogue: 0,0:00:23.71,0:00:25.30,Default,,0,0,0,,Jeweller ne kaha,
Dialogue: 0,0:00:25.30,0:00:26.09,Default,,0,0,0,,behenji,
Dialogue: 0,0:00:26.09,0:00:29.00,Default,,0,0,0,,design ka paisa wapas nahi milta.
Dialogue: 0,0:00:29.00,0:00:30.85,Default,,0,0,0,,Main sirf sona tolta hoon,
Dialogue: 0,0:00:30.85,0:00:32.96,Default,,0,0,0,,woh bhi purity check karke.
Dialogue: 0,0:00:32.96,0:00:34.02,Default,,0,0,0,,Mummy boli,
Dialogue: 0,0:00:34.02,0:00:36.40,Default,,0,0,0,,kharidte waqt toh design ka bhi
Dialogue: 0,0:00:36.40,0:00:37.98,Default,,0,0,0,,poora paisa diya tha.
Dialogue: 0,0:00:37.98,0:00:39.57,Default,,0,0,0,,Jeweller chup raha.
Dialogue: 0,0:00:40.02,0:00:42.15,Default,,0,0,0,,Ghar aakar Mummy ne Papa ko
Dialogue: 0,0:00:42.15,0:00:42.86,Default,,0,0,0,,sab bataya.
Dialogue: 0,0:00:42.86,0:00:43.80,Default,,0,0,0,,Papa bole,
Dialogue: 0,0:00:43.80,0:00:46.17,Default,,0,0,0,,sona kabhi dhokha nahi deta,
Dialogue: 0,0:00:46.17,0:00:47.35,Default,,0,0,0,,yeh toh safe hai.
Dialogue: 0,0:00:47.35,0:00:49.72,Default,,0,0,0,,Behen ne phone se nazar uthayi
Dialogue: 0,0:00:49.72,0:00:50.43,Default,,0,0,0,,aur poocha,
Dialogue: 0,0:00:50.43,0:00:50.90,Default,,0,0,0,,Papa,
Dialogue: 0,0:00:50.90,0:00:52.08,Default,,0,0,0,,safe aur kamaai,
Dialogue: 0,0:00:52.08,0:00:53.74,Default,,0,0,0,,kya dono same baat hain?
Dialogue: 0,0:00:53.74,0:00:56.10,Default,,0,0,0,,Kamre mein thodi der sannata chha
Dialogue: 0,0:00:56.10,0:00:56.34,Default,,0,0,0,,gaya.
Dialogue: 0,0:00:56.79,0:00:59.60,Default,,0,0,0,,Yeh kahani lagbhag har Indian ghar
Dialogue: 0,0:00:59.60,0:01:00.16,Default,,0,0,0,,ki hai.
Dialogue: 0,0:01:00.16,0:01:02.98,Default,,0,0,0,,Hum sone ko suraksha maante hain,
Dialogue: 0,0:01:02.98,0:01:04.38,Default,,0,0,0,,aur sahi bhi hai,
Dialogue: 0,0:01:04.38,0:01:06.63,Default,,0,0,0,,mushkil waqt mein kaam aata hai.
Dialogue: 0,0:01:06.63,0:01:08.89,Default,,0,0,0,,Par asli sawaal yeh hai ki
Dialogue: 0,0:01:08.89,0:01:11.42,Default,,0,0,0,,kaun sa sona sach mein kamata
Dialogue: 0,0:01:11.42,0:01:11.70,Default,,0,0,0,,hai.
Dialogue: 0,0:01:11.70,0:01:12.26,Default,,0,0,0,,Gehna,
Dialogue: 0,0:01:12.26,0:01:12.82,Default,,0,0,0,,gold ETF,
Dialogue: 0,0:01:12.82,0:01:14.51,Default,,0,0,0,,ya sovereign gold bond?
Dialogue: 0,0:01:14.96,0:01:17.31,Default,,0,0,0,,Aaj ke sawaal seedhe hain.
Dialogue: 0,0:01:17.31,0:01:17.98,Default,,0,0,0,,Pehla,
Dialogue: 0,0:01:17.98,0:01:21.67,Default,,0,0,0,,gehne par making charge kahan chala
Dialogue: 0,0:01:21.67,0:01:22.68,Default,,0,0,0,,jaata hai?
Dialogue: 0,0:01:22.68,0:01:23.35,Default,,0,0,0,,Doosra,
Dialogue: 0,0:01:23.35,0:01:26.38,Default,,0,0,0,,locker ka kharcha kaun ginta hai?
Dialogue: 0,0:01:26.38,0:01:27.05,Default,,0,0,0,,Teesra,
Dialogue: 0,0:01:27.05,0:01:29.73,Default,,0,0,0,,gold bond par 2.5 percent extra
Dialogue: 0,0:01:29.73,0:01:31.41,Default,,0,0,0,,kaise milta hai?
Dialogue: 0,0:01:31.41,0:01:32.75,Default,,0,0,0,,Aur aakhir mein,
Dialogue: 0,0:01:32.75,0:01:35.44,Default,,0,0,0,,gehna kab kharidari hai,
Dialogue: 0,0:01:35.44,0:01:37.12,Default,,0,0,0,,aur kab investment.
Dialogue: 0,0:01:37.57,0:01:39.58,Default,,0,0,0,,Chalo peeche chalte hain,
Dialogue: 0,0:01:39.58,0:01:42.17,Default,,0,0,0,,us din jab kangan khareede gaye
Dialogue: 0,0:01:42.17,0:01:42.46,Default,,0,0,0,,the.
Dialogue: 0,0:01:42.46,0:01:44.18,Default,,0,0,0,,Shaadi ki taiyaari thi,
Dialogue: 0,0:01:44.18,0:01:45.62,Default,,0,0,0,,ghar mein raunak thi.
Dialogue: 0,0:01:45.62,0:01:48.78,Default,,0,0,0,,Papa aur Mummy jeweller ki dukaan
Dialogue: 0,0:01:48.78,0:01:49.93,Default,,0,0,0,,par baithe the.
Dialogue: 0,0:01:49.93,0:01:52.51,Default,,0,0,0,,Saamne trays mein chamakte kangan,
Dialogue: 0,0:01:52.51,0:01:53.66,Default,,0,0,0,,haar aur jhumke.
Dialogue: 0,0:01:53.66,0:01:55.96,Default,,0,0,0,,Har cheez par price tag laga
Dialogue: 0,0:01:55.96,0:01:56.25,Default,,0,0,0,,tha.
Dialogue: 0,0:01:56.70,0:01:59.00,Default,,0,0,0,,Jeweller ne bill banaya,
Dialogue: 0,0:01:59.00,0:02:01.29,Default,,0,0,0,,toh usme kai line thi.
Dialogue: 0,0:02:01.29,0:02:01.95,Default,,0,0,0,,Pehli,
Dialogue: 0,0:02:01.95,0:02:04.58,Default,,0,0,0,,sone ka wazan aur us din
Dialogue: 0,0:02:04.58,0:02:05.23,Default,,0,0,0,,ka bhaav.
Dialogue: 0,0:02:05.23,0:02:05.89,Default,,0,0,0,,Doosri,
Dialogue: 0,0:02:05.89,0:02:07.20,Default,,0,0,0,,making charge.
Dialogue: 0,0:02:07.20,0:02:08.84,Default,,0,0,0,,Phir upar se GST.
Dialogue: 0,0:02:08.84,0:02:12.12,Default,,0,0,0,,Papa ne sirf neeche likha total
Dialogue: 0,0:02:12.12,0:02:12.78,Default,,0,0,0,,dekha,
Dialogue: 0,0:02:12.78,0:02:15.73,Default,,0,0,0,,aur bina sawaal kiye paise de
Dialogue: 0,0:02:15.73,0:02:16.06,Default,,0,0,0,,diye.
Dialogue: 0,0:02:16.51,0:02:20.03,Default,,0,0,0,,Making charge yaani gehna banane ki
Dialogue: 0,0:02:20.03,0:02:20.91,Default,,0,0,0,,mazdoori,
Dialogue: 0,0:02:20.91,0:02:23.55,Default,,0,0,0,,karigar ki mehnat ka paisa.
Dialogue: 0,0:02:23.55,0:02:25.31,Default,,0,0,0,,Sona toh sona hai,
Dialogue: 0,0:02:25.31,0:02:27.37,Default,,0,0,0,,par kangan ki nakkashi,
Dialogue: 0,0:02:27.37,0:02:28.54,Default,,0,0,0,,haar ki jaali,
Dialogue: 0,0:02:28.54,0:02:30.31,Default,,0,0,0,,yeh sab haath ka kaam hai.
Dialogue: 0,0:02:30.31,0:02:32.07,Default,,0,0,0,,Jitna baareek design,
Dialogue: 0,0:02:32.07,0:02:34.41,Default,,0,0,0,,utna zyada making charge.
Dialogue: 0,0:02:34.41,0:02:37.06,Default,,0,0,0,,Aur yeh paisa sone mein nahi,
Dialogue: 0,0:02:37.06,0:02:38.23,Default,,0,0,0,,design mein gaya.
Dialogue: 0,0:02:38.68,0:02:40.60,Default,,0,0,0,,Ab yahan woh baat aati hai
Dialogue: 0,0:02:40.60,0:02:42.27,Default,,0,0,0,,jo koi nahi batata.
Dialogue: 0,0:02:42.27,0:02:44.43,Default,,0,0,0,,Jab aap gehna bechne jaate ho,
Dialogue: 0,0:02:44.43,0:02:47.06,Default,,0,0,0,,jeweller sirf sone ka wazan dekhta
Dialogue: 0,0:02:47.06,0:02:47.30,Default,,0,0,0,,hai.
Dialogue: 0,0:02:47.30,0:02:49.93,Default,,0,0,0,,Making charge ka paisa wapas nahi
Dialogue: 0,0:02:49.93,0:02:50.41,Default,,0,0,0,,aata.
Dialogue: 0,0:02:50.41,0:02:52.81,Default,,0,0,0,,Upar se purane gehne par kuch
Dialogue: 0,0:02:52.81,0:02:54.72,Default,,0,0,0,,katauti bhi ho sakti hai,
Dialogue: 0,0:02:54.72,0:02:56.16,Default,,0,0,0,,purity ke naam par.
Dialogue: 0,0:02:56.61,0:02:57.63,Default,,0,0,0,,Matlab samjho.
Dialogue: 0,0:02:57.63,0:02:59.94,Default,,0,0,0,,Jis din aapne gehna khareeda,
Dialogue: 0,0:02:59.94,0:03:02.76,Default,,0,0,0,,usi din aapka kuch paisa hamesha
Dialogue: 0,0:03:02.76,0:03:04.04,Default,,0,0,0,,ke liye chala gaya.
Dialogue: 0,0:03:04.04,0:03:05.83,Default,,0,0,0,,Sone ka bhaav badhega,
Dialogue: 0,0:03:05.83,0:03:08.65,Default,,0,0,0,,tab jaakar pehle woh nuksaan bharega.
Dialogue: 0,0:03:08.65,0:03:11.21,Default,,0,0,0,,Uske baad hi asli kamaai shuru
Dialogue: 0,0:03:11.21,0:03:11.73,Default,,0,0,0,,hogi.
Dialogue: 0,0:03:11.73,0:03:14.29,Default,,0,0,0,,Yaani gehne ki race peeche se
Dialogue: 0,0:03:14.29,0:03:15.57,Default,,0,0,0,,shuru hoti hai.
Dialogue: 0,0:03:16.02,0:03:17.79,Default,,0,0,0,,GST ka bhi yahi haal hai.
Dialogue: 0,0:03:17.79,0:03:20.58,Default,,0,0,0,,Kharidte waqt aapne sone aur making
Dialogue: 0,0:03:20.58,0:03:21.08,Default,,0,0,0,,charge,
Dialogue: 0,0:03:21.08,0:03:22.35,Default,,0,0,0,,dono par GST diya.
Dialogue: 0,0:03:22.35,0:03:24.88,Default,,0,0,0,,Bechte waqt jeweller woh GST aapko
Dialogue: 0,0:03:24.88,0:03:26.40,Default,,0,0,0,,wapas nahi deta.
Dialogue: 0,0:03:26.40,0:03:28.17,Default,,0,0,0,,Woh bhi seedha kharcha hai.
Dialogue: 0,0:03:28.17,0:03:29.94,Default,,0,0,0,,Bill mein chhota dikhta hai,
Dialogue: 0,0:03:29.94,0:03:32.22,Default,,0,0,0,,par saalon baad hisaab mein bada
Dialogue: 0,0:03:32.22,0:03:32.98,Default,,0,0,0,,lagta hai.
Dialogue: 0,0:03:33.43,0:03:36.21,Default,,0,0,0,,Toh kya gehna khareedna galat hai?
Dialogue: 0,0:03:36.21,0:03:37.32,Default,,0,0,0,,Bilkul nahi.
Dialogue: 0,0:03:37.32,0:03:39.82,Default,,0,0,0,,Beti ki shaadi mein Mummy ke
Dialogue: 0,0:03:39.82,0:03:42.05,Default,,0,0,0,,kangan ki jo chamak hogi,
Dialogue: 0,0:03:42.05,0:03:45.94,Default,,0,0,0,,uski keemat calculator se nahi nikalti.
Dialogue: 0,0:03:45.94,0:03:47.05,Default,,0,0,0,,Woh khushi hai,
Dialogue: 0,0:03:47.05,0:03:47.60,Default,,0,0,0,,yaad hai,
Dialogue: 0,0:03:47.60,0:03:48.99,Default,,0,0,0,,parampara hai.
Dialogue: 0,0:03:48.99,0:03:51.50,Default,,0,0,0,,Bas use investment mat bolo.
Dialogue: 0,0:03:51.50,0:03:53.16,Default,,0,0,0,,Woh kharidari hai,
Dialogue: 0,0:03:53.16,0:03:54.83,Default,,0,0,0,,nayi saree ki tarah.
Dialogue: 0,0:03:55.28,0:03:56.50,Default,,0,0,0,,Ab doosra sawaal.
Dialogue: 0,0:03:56.50,0:03:58.45,Default,,0,0,0,,Shaadi ke baad gehna ghar mein
Dialogue: 0,0:03:58.45,0:04:00.90,Default,,0,0,0,,rakhna Papa ko theek nahi laga.
Dialogue: 0,0:04:00.90,0:04:02.12,Default,,0,0,0,,Chori ka darr tha,
Dialogue: 0,0:04:02.12,0:04:04.31,Default,,0,0,0,,mehmaan aate jaate rehte the.
Dialogue: 0,0:04:04.31,0:04:06.02,Default,,0,0,0,,Toh Papa bank pahunche,
Dialogue: 0,0:04:06.02,0:04:08.22,Default,,0,0,0,,aur Bank Uncle se locker maanga.
Dialogue: 0,0:04:08.22,0:04:09.93,Default,,0,0,0,,Bank Uncle ne form diya aur
Dialogue: 0,0:04:09.93,0:04:11.64,Default,,0,0,0,,saalana kiraya bataya.
Dialogue: 0,0:04:12.09,0:04:14.54,Default,,0,0,0,,Bade shehar ki SBI branch mein
Dialogue: 0,0:04:14.54,0:04:17.61,Default,,0,0,0,,chhote locker ka kiraya lagbhag 2,000
Dialogue: 0,0:04:17.61,0:04:19.15,Default,,0,0,0,,rupaye saal ka hai.
Dialogue: 0,0:04:19.15,0:04:21.60,Default,,0,0,0,,Aur yeh 2,000 bhi poora nahi,
Dialogue: 0,0:04:21.60,0:04:23.44,Default,,0,0,0,,upar se GST alag.
Dialogue: 0,0:04:23.44,0:04:24.67,Default,,0,0,0,,Papa bole,
Dialogue: 0,0:04:24.67,0:04:25.90,Default,,0,0,0,,bas itna sa?
Dialogue: 0,0:04:25.90,0:04:27.13,Default,,0,0,0,,Chalo theek hai.
Dialogue: 0,0:04:27.13,0:04:29.58,Default,,0,0,0,,Aur woh kiraya har saal chupchaap
Dialogue: 0,0:04:29.58,0:04:31.73,Default,,0,0,0,,account se katne laga.
Dialogue: 0,0:04:32.18,0:04:34.67,Default,,0,0,0,,Locker par GST 18 percent lagta
Dialogue: 0,0:04:34.67,0:04:34.92,Default,,0,0,0,,hai,
Dialogue: 0,0:04:34.92,0:04:37.17,Default,,0,0,0,,kyunki yeh bank ki service hai.
Dialogue: 0,0:04:37.17,0:04:39.41,Default,,0,0,0,,Yaani 2,000 ka kiraya asal mein
Dialogue: 0,0:04:39.41,0:04:40.91,Default,,0,0,0,,usse zyada pada.
Dialogue: 0,0:04:40.91,0:04:43.40,Default,,0,0,0,,Papa ne kabhi socha nahi ki
Dialogue: 0,0:04:43.40,0:04:45.65,Default,,0,0,0,,yeh kharcha bhi sone ke hisaab
Dialogue: 0,0:04:45.65,0:04:46.89,Default,,0,0,0,,mein judna chahiye.
Dialogue: 0,0:04:46.89,0:04:47.89,Default,,0,0,0,,Sach kahun toh,
Dialogue: 0,0:04:47.89,0:04:49.14,Default,,0,0,0,,koi nahi sochta.
Dialogue: 0,0:04:49.59,0:04:51.77,Default,,0,0,0,,Yeh kharcha chhota lagta hai,
Dialogue: 0,0:04:51.77,0:04:53.41,Default,,0,0,0,,isliye chhup jaata hai.
Dialogue: 0,0:04:53.41,0:04:55.32,Default,,0,0,0,,Par yeh har saal aata hai,
Dialogue: 0,0:04:55.32,0:04:57.77,Default,,0,0,0,,chahe sone ka bhaav badhe ya
Dialogue: 0,0:04:57.77,0:04:58.32,Default,,0,0,0,,gire.
Dialogue: 0,0:04:58.32,0:05:00.50,Default,,0,0,0,,Jitne saal gehna locker mein,
Dialogue: 0,0:05:00.50,0:05:01.86,Default,,0,0,0,,utne saal kiraya.
Dialogue: 0,0:05:01.86,0:05:04.05,Default,,0,0,0,,Aur locker ki chaabi ke saath
Dialogue: 0,0:05:04.05,0:05:06.50,Default,,0,0,0,,aata hai bank jaane ka time,
Dialogue: 0,0:05:06.50,0:05:07.59,Default,,0,0,0,,line aur form.
Dialogue: 0,0:05:08.04,0:05:09.08,Default,,0,0,0,,Ab socho,
Dialogue: 0,0:05:09.08,0:05:12.20,Default,,0,0,0,,kai saal baad Mummy kangan bechti
Dialogue: 0,0:05:12.20,0:05:12.55,Default,,0,0,0,,hain.
Dialogue: 0,0:05:12.55,0:05:15.68,Default,,0,0,0,,Unhe sone ka bhaav dikhta hai,
Dialogue: 0,0:05:15.68,0:05:16.72,Default,,0,0,0,,badha hua.
Dialogue: 0,0:05:16.72,0:05:18.45,Default,,0,0,0,,Par making charge,
Dialogue: 0,0:05:18.45,0:05:18.80,Default,,0,0,0,,GST,
Dialogue: 0,0:05:18.80,0:05:20.54,Default,,0,0,0,,locker ka kiraya,
Dialogue: 0,0:05:20.54,0:05:23.31,Default,,0,0,0,,aur bechte waqt ki katauti,
Dialogue: 0,0:05:23.31,0:05:24.70,Default,,0,0,0,,yeh sab ghatao.
Dialogue: 0,0:05:24.70,0:05:27.82,Default,,0,0,0,,Tab pata chalta hai ki gehne
Dialogue: 0,0:05:27.82,0:05:30.60,Default,,0,0,0,,ne asal mein kitna kamaya.
Dialogue: 0,0:05:31.05,0:05:33.60,Default,,0,0,0,,Bhai ne phone nikala aur bola,
Dialogue: 0,0:05:33.60,0:05:35.64,Default,,0,0,0,,sona toh har saal badhta hai,
Dialogue: 0,0:05:35.64,0:05:36.66,Default,,0,0,0,,problem kya hai?
Dialogue: 0,0:05:36.66,0:05:38.44,Default,,0,0,0,,Behen ne turant kaha,
Dialogue: 0,0:05:38.44,0:05:39.97,Default,,0,0,0,,har saal nahi badhta,
Dialogue: 0,0:05:39.97,0:05:41.50,Default,,0,0,0,,kabhi girta bhi hai.
Dialogue: 0,0:05:41.50,0:05:42.52,Default,,0,0,0,,Aur bhaav badhe,
Dialogue: 0,0:05:42.52,0:05:44.56,Default,,0,0,0,,toh bhi kamaai alag cheez hai.
Dialogue: 0,0:05:44.56,0:05:46.86,Default,,0,0,0,,Kamaai woh hai jo saare kharche
Dialogue: 0,0:05:46.86,0:05:48.13,Default,,0,0,0,,ke baad haath mein aaye.
Dialogue: 0,0:05:48.58,0:05:49.94,Default,,0,0,0,,Ab teesra sawaal,
Dialogue: 0,0:05:49.94,0:05:52.12,Default,,0,0,0,,jahan kahani mein twist hai.
Dialogue: 0,0:05:52.12,0:05:54.57,Default,,0,0,0,,Kya aisa sona ho sakta hai
Dialogue: 0,0:05:54.57,0:05:56.75,Default,,0,0,0,,jisme making charge na ho,
Dialogue: 0,0:05:56.75,0:05:57.84,Default,,0,0,0,,locker na ho,
Dialogue: 0,0:05:57.84,0:06:00.02,Default,,0,0,0,,aur upar se byaaj bhi mile?
Dialogue: 0,0:06:00.02,0:06:00.29,Default,,0,0,0,,Haan,
Dialogue: 0,0:06:00.29,0:06:02.47,Default,,0,0,0,,isko kehte hain paper gold.
Dialogue: 0,0:06:02.47,0:06:04.92,Default,,0,0,0,,Yaani sona jo kaagaz ya screen
Dialogue: 0,0:06:04.92,0:06:05.47,Default,,0,0,0,,par hai,
Dialogue: 0,0:06:05.47,0:06:07.10,Default,,0,0,0,,almari mein nahi.
Dialogue: 0,0:06:07.55,0:06:09.79,Default,,0,0,0,,Pehla roop hai sovereign gold bond,
Dialogue: 0,0:06:09.79,0:06:10.78,Default,,0,0,0,,chhota naam SGB.
Dialogue: 0,0:06:10.78,0:06:12.77,Default,,0,0,0,,Yeh sarkar ki taraf se RBI
Dialogue: 0,0:06:12.77,0:06:14.01,Default,,0,0,0,,jaari karta hai.
Dialogue: 0,0:06:14.01,0:06:16.00,Default,,0,0,0,,RBI yaani desh ka central bank,
Dialogue: 0,0:06:16.00,0:06:17.49,Default,,0,0,0,,jo banks ka bhi bank hai.
Dialogue: 0,0:06:17.49,0:06:19.48,Default,,0,0,0,,Aap sona nahi khareedte,
Dialogue: 0,0:06:19.48,0:06:21.72,Default,,0,0,0,,sone ke grams ke barabar bond
Dialogue: 0,0:06:21.72,0:06:22.71,Default,,0,0,0,,khareedte ho.
Dialogue: 0,0:06:23.16,0:06:25.34,Default,,0,0,0,,Is bond ki keemat sone ke
Dialogue: 0,0:06:25.34,0:06:26.98,Default,,0,0,0,,bhaav ke saath chalti hai.
Dialogue: 0,0:06:26.98,0:06:28.34,Default,,0,0,0,,Sona mehnga hua,
Dialogue: 0,0:06:28.34,0:06:29.70,Default,,0,0,0,,toh bond bhi mehnga.
Dialogue: 0,0:06:29.70,0:06:31.06,Default,,0,0,0,,Sona sasta hua,
Dialogue: 0,0:06:31.06,0:06:32.43,Default,,0,0,0,,toh bond bhi sasta.
Dialogue: 0,0:06:32.43,0:06:34.88,Default,,0,0,0,,Yaani sone ka risk wahi hai
Dialogue: 0,0:06:34.88,0:06:36.24,Default,,0,0,0,,jo gehne mein hai.
Dialogue: 0,0:06:36.24,0:06:37.60,Default,,0,0,0,,Bas making charge,
Dialogue: 0,0:06:37.60,0:06:40.60,Default,,0,0,0,,locker aur purity ki tension nahi.
Dialogue: 0,0:06:41.05,0:06:42.21,Default,,0,0,0,,Ab asli twist.
Dialogue: 0,0:06:42.21,0:06:44.24,Default,,0,0,0,,Sone ke bhaav ke upar,
Dialogue: 0,0:06:44.24,0:06:46.56,Default,,0,0,0,,SGB har saal 2.5 percent fixed
Dialogue: 0,0:06:46.56,0:06:47.72,Default,,0,0,0,,byaaj deta hai.
Dialogue: 0,0:06:47.72,0:06:50.62,Default,,0,0,0,,Yeh byaaj aapki shuruaati rakam par
Dialogue: 0,0:06:50.62,0:06:51.50,Default,,0,0,0,,milta hai,
Dialogue: 0,0:06:51.50,0:06:54.40,Default,,0,0,0,,yaani jitne ka bond khareeda tha,
Dialogue: 0,0:06:54.40,0:06:54.98,Default,,0,0,0,,us par.
Dialogue: 0,0:06:54.98,0:06:57.59,Default,,0,0,0,,Gehna aapko byaaj nahi deta.
Dialogue: 0,0:06:57.59,0:07:00.20,Default,,0,0,0,,Woh sirf locker mein baitha rehta
Dialogue: 0,0:07:00.20,0:07:00.49,Default,,0,0,0,,hai.
Dialogue: 0,0:07:00.94,0:07:02.34,Default,,0,0,0,,Is tarah samjho.
Dialogue: 0,0:07:02.34,0:07:04.86,Default,,0,0,0,,Mummy ke kangan locker mein so
Dialogue: 0,0:07:04.86,0:07:05.70,Default,,0,0,0,,rahe hain,
Dialogue: 0,0:07:05.70,0:07:07.66,Default,,0,0,0,,aur kiraya maang rahe hain.
Dialogue: 0,0:07:07.66,0:07:10.46,Default,,0,0,0,,Bond wala sona bhi chupchaap baitha
Dialogue: 0,0:07:10.46,0:07:10.74,Default,,0,0,0,,hai,
Dialogue: 0,0:07:10.74,0:07:12.70,Default,,0,0,0,,par har saal 2.5 percent byaaj
Dialogue: 0,0:07:12.70,0:07:13.82,Default,,0,0,0,,de raha hai.
Dialogue: 0,0:07:13.82,0:07:16.34,Default,,0,0,0,,Sona dono jagah same hai.
Dialogue: 0,0:07:16.34,0:07:18.86,Default,,0,0,0,,Par gehna kharcha karwata hai,
Dialogue: 0,0:07:18.86,0:07:20.26,Default,,0,0,0,,bond kamata hai.
Dialogue: 0,0:07:20.71,0:07:21.98,Default,,0,0,0,,Par shart bhi hai,
Dialogue: 0,0:07:21.98,0:07:23.88,Default,,0,0,0,,aur woh dhyaan se suno.
Dialogue: 0,0:07:23.88,0:07:26.41,Default,,0,0,0,,Yeh bond lambe samay ke liye
Dialogue: 0,0:07:26.41,0:07:26.73,Default,,0,0,0,,hai.
Dialogue: 0,0:07:26.73,0:07:29.26,Default,,0,0,0,,RBI ke through bond jaldi todna,
Dialogue: 0,0:07:29.26,0:07:32.11,Default,,0,0,0,,yaani premature redemption,
Dialogue: 0,0:07:32.11,0:07:34.64,Default,,0,0,0,,5 saal poore hone ke baad
Dialogue: 0,0:07:34.64,0:07:35.91,Default,,0,0,0,,hi hota hai.
Dialogue: 0,0:07:35.91,0:07:38.13,Default,,0,0,0,,Aur woh bhi sirf byaaj milne
Dialogue: 0,0:07:38.13,0:07:39.71,Default,,0,0,0,,wali tareekh par.
Dialogue: 0,0:07:40.16,0:07:41.24,Default,,0,0,0,,Iska matlab,
Dialogue: 0,0:07:41.24,0:07:43.92,Default,,0,0,0,,jo paisa aapko agle saal shaadi
Dialogue: 0,0:07:43.92,0:07:45.54,Default,,0,0,0,,ya ghar ke liye chahiye,
Dialogue: 0,0:07:45.54,0:07:47.42,Default,,0,0,0,,woh SGB ke liye nahi hai.
Dialogue: 0,0:07:47.42,0:07:49.30,Default,,0,0,0,,Yeh bond un paison ke liye
Dialogue: 0,0:07:49.30,0:07:51.18,Default,,0,0,0,,hai jo aap saalon tak bhool
Dialogue: 0,0:07:51.18,0:07:51.98,Default,,0,0,0,,sakte ho.
Dialogue: 0,0:07:51.98,0:07:54.67,Default,,0,0,0,,Stock exchange par bechne ka raasta
Dialogue: 0,0:07:54.67,0:07:55.21,Default,,0,0,0,,bhi hai,
Dialogue: 0,0:07:55.21,0:07:58.70,Default,,0,0,0,,par wahan sahi khareedar milna zaroori
Dialogue: 0,0:07:58.70,0:07:59.24,Default,,0,0,0,,nahi.
Dialogue: 0,0:07:59.69,0:08:00.16,Default,,0,0,0,,Aur tax?
Dialogue: 0,0:08:00.16,0:08:02.51,Default,,0,0,0,,Yeh byaaj aapki income mein judta
Dialogue: 0,0:08:02.51,0:08:02.75,Default,,0,0,0,,hai,
Dialogue: 0,0:08:02.75,0:08:04.39,Default,,0,0,0,,aur us par aapke slab ke
Dialogue: 0,0:08:04.39,0:08:06.04,Default,,0,0,0,,hisaab se tax lagta hai.
Dialogue: 0,0:08:06.04,0:08:07.69,Default,,0,0,0,,Lekin maturity par,
Dialogue: 0,0:08:07.69,0:08:10.27,Default,,0,0,0,,yaani bond ki poori avadhi khatam
Dialogue: 0,0:08:10.27,0:08:10.98,Default,,0,0,0,,hone par,
Dialogue: 0,0:08:10.98,0:08:14.27,Default,,0,0,0,,original khareedne wale ko capital gains
Dialogue: 0,0:08:14.27,0:08:16.15,Default,,0,0,0,,par tax nahi dena padta.
Dialogue: 0,0:08:16.15,0:08:18.50,Default,,0,0,0,,Capital gains yaani bechne par hua
Dialogue: 0,0:08:18.50,0:08:19.21,Default,,0,0,0,,munafa.
Dialogue: 0,0:08:19.66,0:08:20.47,Default,,0,0,0,,Bhai bola,
Dialogue: 0,0:08:20.47,0:08:22.35,Default,,0,0,0,,toh kal hi le leta hoon.
Dialogue: 0,0:08:22.35,0:08:23.70,Default,,0,0,0,,Behen ne roka.
Dialogue: 0,0:08:23.70,0:08:25.86,Default,,0,0,0,,Naye SGB issue har waqt nahi
Dialogue: 0,0:08:25.86,0:08:26.39,Default,,0,0,0,,aate,
Dialogue: 0,0:08:26.39,0:08:28.55,Default,,0,0,0,,pehle RBI ki site par check
Dialogue: 0,0:08:28.55,0:08:29.09,Default,,0,0,0,,karo.
Dialogue: 0,0:08:29.09,0:08:32.32,Default,,0,0,0,,Aur exchange se purana bond khareeda,
Dialogue: 0,0:08:32.32,0:08:34.48,Default,,0,0,0,,toh tax chhoot ke rules alag
Dialogue: 0,0:08:34.48,0:08:35.55,Default,,0,0,0,,ho sakte hain.
Dialogue: 0,0:08:35.55,0:08:37.98,Default,,0,0,0,,Bina samjhe tip par mat kudo.
Dialogue: 0,0:08:38.43,0:08:40.03,Default,,0,0,0,,Doosra roop hai gold ETF.
Dialogue: 0,0:08:40.03,0:08:42.42,Default,,0,0,0,,ETF yaani exchange traded fund,
Dialogue: 0,0:08:42.42,0:08:44.82,Default,,0,0,0,,jo stock exchange par share ki
Dialogue: 0,0:08:44.82,0:08:47.48,Default,,0,0,0,,tarah khareeda becha jaata hai.
Dialogue: 0,0:08:47.48,0:08:50.15,Default,,0,0,0,,Har unit ke peeche asli sona
Dialogue: 0,0:08:50.15,0:08:51.48,Default,,0,0,0,,rakha hota hai.
Dialogue: 0,0:08:51.48,0:08:53.88,Default,,0,0,0,,Iske liye demat account chahiye,
Dialogue: 0,0:08:53.88,0:08:57.07,Default,,0,0,0,,yaani shares rakhne ka digital khata.
Dialogue: 0,0:08:57.52,0:08:59.64,Default,,0,0,0,,Gold ETF mein bhi making charge
Dialogue: 0,0:08:59.64,0:09:00.17,Default,,0,0,0,,nahi,
Dialogue: 0,0:09:00.17,0:09:01.24,Default,,0,0,0,,locker nahi,
Dialogue: 0,0:09:01.24,0:09:03.36,Default,,0,0,0,,purity ki fikar nahi.
Dialogue: 0,0:09:03.36,0:09:04.42,Default,,0,0,0,,Aur bechna ho,
Dialogue: 0,0:09:04.42,0:09:06.54,Default,,0,0,0,,toh market khula ho tab bech
Dialogue: 0,0:09:06.54,0:09:07.34,Default,,0,0,0,,sakte ho.
Dialogue: 0,0:09:07.34,0:09:08.93,Default,,0,0,0,,Par byaaj nahi milta,
Dialogue: 0,0:09:08.93,0:09:11.59,Default,,0,0,0,,aur fund ka chhota saalana kharcha
Dialogue: 0,0:09:11.59,0:09:12.38,Default,,0,0,0,,katta hai.
Dialogue: 0,0:09:12.38,0:09:15.04,Default,,0,0,0,,Isko expense ratio kehte hain,
Dialogue: 0,0:09:15.04,0:09:17.16,Default,,0,0,0,,yaani fund chalane ki fees.
Dialogue: 0,0:09:17.61,0:09:19.50,Default,,0,0,0,,Ab sab ko saath rakh kar
Dialogue: 0,0:09:19.50,0:09:20.13,Default,,0,0,0,,dekho.
Dialogue: 0,0:09:20.13,0:09:20.76,Default,,0,0,0,,Gehna:
Dialogue: 0,0:09:20.76,0:09:22.65,Default,,0,0,0,,pehenne ki khushi,
Dialogue: 0,0:09:22.65,0:09:24.22,Default,,0,0,0,,par making charge,
Dialogue: 0,0:09:24.22,0:09:26.42,Default,,0,0,0,,GST aur locker ka kharcha.
Dialogue: 0,0:09:26.42,0:09:27.05,Default,,0,0,0,,Gold ETF:
Dialogue: 0,0:09:27.05,0:09:28.32,Default,,0,0,0,,aasaan bechna,
Dialogue: 0,0:09:28.32,0:09:29.26,Default,,0,0,0,,chhoti fees,
Dialogue: 0,0:09:29.26,0:09:30.52,Default,,0,0,0,,koi byaaj nahi.
Dialogue: 0,0:09:30.52,0:09:30.83,Default,,0,0,0,,SGB:
Dialogue: 0,0:09:30.83,0:09:32.09,Default,,0,0,0,,byaaj milta hai,
Dialogue: 0,0:09:32.09,0:09:34.30,Default,,0,0,0,,maturity par tax chhoot,
Dialogue: 0,0:09:34.30,0:09:37.13,Default,,0,0,0,,par paisa lamba atakta hai.
Dialogue: 0,0:09:37.58,0:09:40.03,Default,,0,0,0,,Ab woh galti jo lagbhag har
Dialogue: 0,0:09:40.03,0:09:41.26,Default,,0,0,0,,ghar karta hai.
Dialogue: 0,0:09:41.26,0:09:42.49,Default,,0,0,0,,Hum kehte hain,
Dialogue: 0,0:09:42.49,0:09:44.63,Default,,0,0,0,,sone ne bahut kamaya,
Dialogue: 0,0:09:44.63,0:09:47.09,Default,,0,0,0,,bhaav dekho kahan pahunch gaya.
Dialogue: 0,0:09:47.09,0:09:49.23,Default,,0,0,0,,Par hum sirf bhaav ginte hain.
Dialogue: 0,0:09:49.23,0:09:50.46,Default,,0,0,0,,Making charge,
Dialogue: 0,0:09:50.46,0:09:50.77,Default,,0,0,0,,GST,
Dialogue: 0,0:09:50.77,0:09:51.38,Default,,0,0,0,,locker,
Dialogue: 0,0:09:51.38,0:09:54.14,Default,,0,0,0,,aur bechte waqt ki katauti koi
Dialogue: 0,0:09:54.14,0:09:55.37,Default,,0,0,0,,nahi ginta.
Dialogue: 0,0:09:55.37,0:09:56.59,Default,,0,0,0,,Aadha hisaab,
Dialogue: 0,0:09:56.59,0:09:57.82,Default,,0,0,0,,poori khushi.
Dialogue: 0,0:09:58.27,0:09:59.34,Default,,0,0,0,,Doosri galti,
Dialogue: 0,0:09:59.34,0:10:02.28,Default,,0,0,0,,gehne ko emergency fund samajhna.
Dialogue: 0,0:10:02.28,0:10:04.69,Default,,0,0,0,,Mushkil waqt mein Mummy ka kangan
Dialogue: 0,0:10:04.69,0:10:05.23,Default,,0,0,0,,bechna,
Dialogue: 0,0:10:05.23,0:10:07.37,Default,,0,0,0,,mann par bhi bhaari padta hai.
Dialogue: 0,0:10:07.37,0:10:09.51,Default,,0,0,0,,Aur tab jeweller ki shart par
Dialogue: 0,0:10:09.51,0:10:10.85,Default,,0,0,0,,bechna padta hai.
Dialogue: 0,0:10:10.85,0:10:13.79,Default,,0,0,0,,Emergency ke liye woh paisa chahiye
Dialogue: 0,0:10:13.79,0:10:15.13,Default,,0,0,0,,jo turant mile,
Dialogue: 0,0:10:15.13,0:10:16.47,Default,,0,0,0,,bina nuksaan ke.
Dialogue: 0,0:10:16.92,0:10:17.98,Default,,0,0,0,,Toh karein kya?
Dialogue: 0,0:10:17.98,0:10:18.76,Default,,0,0,0,,Pehli baat,
Dialogue: 0,0:10:18.76,0:10:20.61,Default,,0,0,0,,gehne ko gehna samjho.
Dialogue: 0,0:10:20.61,0:10:22.19,Default,,0,0,0,,Pehenne ke liye lo,
Dialogue: 0,0:10:22.19,0:10:23.51,Default,,0,0,0,,khushi ke liye lo.
Dialogue: 0,0:10:23.51,0:10:25.36,Default,,0,0,0,,Hallmark wala gehna lo,
Dialogue: 0,0:10:25.36,0:10:27.20,Default,,0,0,0,,aur bill sambhal kar rakho.
Dialogue: 0,0:10:27.20,0:10:29.31,Default,,0,0,0,,Making charge par mol bhaav bhi
Dialogue: 0,0:10:29.31,0:10:30.10,Default,,0,0,0,,hota hai.
Dialogue: 0,0:10:30.10,0:10:33.26,Default,,0,0,0,,Bechne se pehle alag alag jewellers
Dialogue: 0,0:10:33.26,0:10:34.32,Default,,0,0,0,,se bhaav poochho.
Dialogue: 0,0:10:34.77,0:10:35.55,Default,,0,0,0,,Doosri baat,
Dialogue: 0,0:10:35.55,0:10:38.13,Default,,0,0,0,,agar sona bachat ke liye chahiye,
Dialogue: 0,0:10:38.13,0:10:40.20,Default,,0,0,0,,toh paper gold ke baare mein
Dialogue: 0,0:10:40.20,0:10:40.72,Default,,0,0,0,,padho.
Dialogue: 0,0:10:40.72,0:10:42.53,Default,,0,0,0,,Lambe samay ke liye SGB,
Dialogue: 0,0:10:42.53,0:10:45.11,Default,,0,0,0,,aur jaldi zaroorat ho sakti hai
Dialogue: 0,0:10:45.11,0:10:45.89,Default,,0,0,0,,toh gold ETF.
Dialogue: 0,0:10:45.89,0:10:47.18,Default,,0,0,0,,Dono ke rules,
Dialogue: 0,0:10:47.18,0:10:48.99,Default,,0,0,0,,tax aur kharche khud samjho.
Dialogue: 0,0:10:48.99,0:10:51.32,Default,,0,0,0,,Zaroorat ho toh apne CA ya
Dialogue: 0,0:10:51.32,0:10:53.13,Default,,0,0,0,,adviser se baat karo.
Dialogue: 0,0:10:53.58,0:10:54.42,Default,,0,0,0,,Teesri baat,
Dialogue: 0,0:10:54.42,0:10:57.24,Default,,0,0,0,,saari bachat sone mein mat daalo.
Dialogue: 0,0:10:57.24,0:10:59.78,Default,,0,0,0,,Sona mushkil waqt ka saathi hai,
Dialogue: 0,0:10:59.78,0:11:02.03,Default,,0,0,0,,par uska bhaav girta bhi hai,
Dialogue: 0,0:11:02.03,0:11:04.57,Default,,0,0,0,,saalon tak ruka bhi reh sakta
Dialogue: 0,0:11:04.57,0:11:04.85,Default,,0,0,0,,hai.
Dialogue: 0,0:11:04.85,0:11:05.98,Default,,0,0,0,,Thoda sona,
Dialogue: 0,0:11:05.98,0:11:08.23,Default,,0,0,0,,baaki alag alag jagah.
Dialogue: 0,0:11:08.23,0:11:11.05,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:11:11.05,0:11:12.74,Default,,0,0,0,,Sirf samajh ki baat hai.
Dialogue: 0,0:11:13.19,0:11:15.38,Default,,0,0,0,,Kahani ke aakhir mein,
Dialogue: 0,0:11:15.38,0:11:18.20,Default,,0,0,0,,Mummy ne kangan nahi beche.
Dialogue: 0,0:11:18.20,0:11:19.76,Default,,0,0,0,,Unhone kaha,
Dialogue: 0,0:11:19.76,0:11:22.26,Default,,0,0,0,,yeh toh Beti ki shaadi mein
Dialogue: 0,0:11:22.26,0:11:22.89,Default,,0,0,0,,jaayenge.
Dialogue: 0,0:11:22.89,0:11:25.39,Default,,0,0,0,,Par agli baar bachat ke liye
Dialogue: 0,0:11:25.39,0:11:26.96,Default,,0,0,0,,sona lena hua,
Dialogue: 0,0:11:26.96,0:11:29.14,Default,,0,0,0,,toh Behen ke saath baith kar
Dialogue: 0,0:11:29.14,0:11:31.02,Default,,0,0,0,,paper gold samjhengi.
Dialogue: 0,0:11:31.02,0:11:32.59,Default,,0,0,0,,Kangan pyaar ke liye,
Dialogue: 0,0:11:32.59,0:11:34.15,Default,,0,0,0,,bond kamaai ke liye.
Dialogue: 0,0:11:34.60,0:11:36.16,Default,,0,0,0,,Ab aapse sawaal.
Dialogue: 0,0:11:36.16,0:11:38.66,Default,,0,0,0,,Aapke ghar mein sona kis roop
Dialogue: 0,0:11:38.66,0:11:39.28,Default,,0,0,0,,mein hai:
Dialogue: 0,0:11:39.28,0:11:39.91,Default,,0,0,0,,gehna,
Dialogue: 0,0:11:39.91,0:11:40.22,Default,,0,0,0,,coin,
Dialogue: 0,0:11:40.22,0:11:41.16,Default,,0,0,0,,ETF ya bond?
Dialogue: 0,0:11:41.16,0:11:43.66,Default,,0,0,0,,Comment mein bas woh shabd likho.
Dialogue: 0,0:11:43.66,0:11:45.22,Default,,0,0,0,,Aur yeh bhi batao,
Dialogue: 0,0:11:45.22,0:11:48.03,Default,,0,0,0,,kya kabhi kisi ne aapke ghar
Dialogue: 0,0:11:48.03,0:11:50.84,Default,,0,0,0,,mein locker ka kiraya gina hai?
Dialogue: 0,0:11:51.29,0:11:53.63,Default,,0,0,0,,Agle video mein Papa ki FD
Dialogue: 0,0:11:53.63,0:11:54.67,Default,,0,0,0,,ki baari hai.
Dialogue: 0,0:11:54.67,0:11:56.24,Default,,0,0,0,,FD safe lagti hai,
Dialogue: 0,0:11:56.24,0:11:58.32,Default,,0,0,0,,par mehngai kaat kar asal mein
Dialogue: 0,0:11:58.32,0:11:59.62,Default,,0,0,0,,kitna bachta hai?
Dialogue: 0,0:11:59.62,0:12:01.96,Default,,0,0,0,,Woh kahani bhi isi tarah,
