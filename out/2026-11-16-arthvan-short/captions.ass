Dialogue: 0,0:00:00.00,0:00:00.48,Default,,0,0,0,,Socho,
Dialogue: 0,0:00:00.48,0:00:03.33,Default,,0,0,0,,Hanuman ji ki likhi Ramayan samundar
Dialogue: 0,0:00:03.33,0:00:04.28,Default,,0,0,0,,ki tah mein ho.
Dialogue: 0,0:00:04.73,0:00:05.60,Default,,0,0,0,,Kahani hai,
Dialogue: 0,0:00:05.60,0:00:08.01,Default,,0,0,0,,Hanuman ji ne chattanon par Ramayan
Dialogue: 0,0:00:08.01,0:00:08.44,Default,,0,0,0,,likhi.
Dialogue: 0,0:00:08.44,0:00:10.63,Default,,0,0,0,,Valmiki ji ki katha pheeki na
Dialogue: 0,0:00:10.63,0:00:11.06,Default,,0,0,0,,pade,
Dialogue: 0,0:00:11.06,0:00:13.25,Default,,0,0,0,,isliye patthar samundar mein daal diye.
Dialogue: 0,0:00:13.70,0:00:15.86,Default,,0,0,0,,Toh kya yeh sirf kahani hai?
Dialogue: 0,0:00:16.31,0:00:17.00,Default,,0,0,0,,Kehte hain,
Dialogue: 0,0:00:17.00,0:00:18.85,Default,,0,0,0,,11vi sadi mein Raja Bhoj ke
Dialogue: 0,0:00:18.85,0:00:19.54,Default,,0,0,0,,zamane,
Dialogue: 0,0:00:19.54,0:00:21.84,Default,,0,0,0,,samundar kinare patthar mile.
Dialogue: 0,0:00:21.84,0:00:23.92,Default,,0,0,0,,Un par Hanuman ke shlok khude
Dialogue: 0,0:00:23.92,0:00:24.15,Default,,0,0,0,,the.
Dialogue: 0,0:00:24.60,0:00:26.11,Default,,0,0,0,,Par ek kitaab asli hai:
Dialogue: 0,0:00:26.11,0:00:27.84,Default,,0,0,0,,natak Hanumannataka.
Dialogue: 0,0:00:27.84,0:00:30.22,Default,,0,0,0,,Bhoj ke kavi Damodara Mishra ne
Dialogue: 0,0:00:30.22,0:00:31.08,Default,,0,0,0,,ise joda.
Dialogue: 0,0:00:31.53,0:00:33.31,Default,,0,0,0,,Lekin kuch historians kehte hain,
Dialogue: 0,0:00:33.31,0:00:34.89,Default,,0,0,0,,isme baad ke kaviyon ke shlok
Dialogue: 0,0:00:34.89,0:00:35.09,Default,,0,0,0,,hain.
Dialogue: 0,0:00:35.09,0:00:36.07,Default,,0,0,0,,Baaki maante hain,
Dialogue: 0,0:00:36.07,0:00:38.05,Default,,0,0,0,,andar purana natak chhupa hai.
Dialogue: 0,0:00:38.50,0:00:39.22,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:00:39.22,0:00:41.40,Default,,0,0,0,,aisa koi patthar aaj tak nahi
Dialogue: 0,0:00:41.40,0:00:41.88,Default,,0,0,0,,mila.
Dialogue: 0,0:00:41.88,0:00:44.05,Default,,0,0,0,,Par 14 hisson ka yeh natak
Dialogue: 0,0:00:44.05,0:00:45.74,Default,,0,0,0,,aaj bhi padha jaata hai.
Dialogue: 0,0:00:46.19,0:00:48.55,Default,,0,0,0,,Hanuman bhakt Dadi ko bhejo,
Dialogue: 0,0:00:48.55,0:00:49.34,Default,,0,0,0,,aur kaho,
Dialogue: 0,0:00:49.34,0:00:50.39,Default,,0,0,0,,zara socho.
