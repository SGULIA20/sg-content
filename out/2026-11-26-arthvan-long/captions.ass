Dialogue: 0,0:00:00.00,0:00:02.20,Default,,0,0,0,,Valmiki Ramayan mein Lakshman Rekha hai
Dialogue: 0,0:00:02.20,0:00:02.80,Default,,0,0,0,,hi nahi.
Dialogue: 0,0:00:02.80,0:00:03.79,Default,,0,0,0,,Toh aayi kahan se?
Dialogue: 0,0:00:03.79,0:00:03.99,Default,,0,0,0,,Haan,
Dialogue: 0,0:00:03.99,0:00:05.99,Default,,0,0,0,,wahi rekha jise aap bachpan se
Dialogue: 0,0:00:05.99,0:00:06.79,Default,,0,0,0,,sunte aaye hain.
Dialogue: 0,0:00:06.79,0:00:07.59,Default,,0,0,0,,Sabut ke saath,
Dialogue: 0,0:00:07.59,0:00:09.39,Default,,0,0,0,,aaj poori kahani kholte hain.
Dialogue: 0,0:00:09.84,0:00:11.49,Default,,0,0,0,,Dadi ki kahani ho ya TV
Dialogue: 0,0:00:11.49,0:00:11.85,Default,,0,0,0,,serial,
Dialogue: 0,0:00:11.85,0:00:13.69,Default,,0,0,0,,scene hamesha wahi hota hai.
Dialogue: 0,0:00:13.69,0:00:15.15,Default,,0,0,0,,Lakshman teer ki nok se zameen
Dialogue: 0,0:00:15.15,0:00:16.25,Default,,0,0,0,,par rekha kheenchte hain.
Dialogue: 0,0:00:16.25,0:00:17.54,Default,,0,0,0,,Sita andar surakshit,
Dialogue: 0,0:00:17.54,0:00:18.82,Default,,0,0,0,,Ravan bahar atka hua.
Dialogue: 0,0:00:19.27,0:00:21.30,Default,,0,0,0,,Aaj yeh shabd hamari boli mein
Dialogue: 0,0:00:21.30,0:00:22.20,Default,,0,0,0,,ghus chuka hai.
Dialogue: 0,0:00:22.20,0:00:23.11,Default,,0,0,0,,Maa kehti hai,
Dialogue: 0,0:00:23.11,0:00:24.92,Default,,0,0,0,,yeh Lakshman Rekha mat todna.
Dialogue: 0,0:00:24.92,0:00:25.82,Default,,0,0,0,,Matlab woh had,
Dialogue: 0,0:00:25.82,0:00:27.63,Default,,0,0,0,,jo kabhi paar nahi karni.
Dialogue: 0,0:00:28.08,0:00:30.87,Default,,0,0,0,,Lekin ab sabse purani Ramayan kholiye,
Dialogue: 0,0:00:30.87,0:00:31.80,Default,,0,0,0,,Valmiki ki.
Dialogue: 0,0:00:31.80,0:00:33.20,Default,,0,0,0,,Wahan kya milta hai?
Dialogue: 0,0:00:33.20,0:00:34.36,Default,,0,0,0,,Aranya Kanda,
Dialogue: 0,0:00:34.36,0:00:36.22,Default,,0,0,0,,yaani jungle wala hissa.
Dialogue: 0,0:00:36.22,0:00:38.78,Default,,0,0,0,,Wahan koi rekha nahi kheenchi jaati.
Dialogue: 0,0:00:39.23,0:00:41.52,Default,,0,0,0,,Toh Lakshman ne kutiya kyun chhodi?
Dialogue: 0,0:00:41.52,0:00:43.30,Default,,0,0,0,,Valmiki ke hisaab se,
Dialogue: 0,0:00:43.30,0:00:45.33,Default,,0,0,0,,Sita ke kuch shabd unke dil
Dialogue: 0,0:00:45.33,0:00:47.11,Default,,0,0,0,,mein teer ki tarah lage.
Dialogue: 0,0:00:47.11,0:00:48.13,Default,,0,0,0,,Itne kadve,
Dialogue: 0,0:00:48.13,0:00:49.40,Default,,0,0,0,,ki wo chal pade.
Dialogue: 0,0:00:49.85,0:00:50.68,Default,,0,0,0,,Aur Ravan?
Dialogue: 0,0:00:50.68,0:00:53.44,Default,,0,0,0,,Use rokne wali koi rekha thi
Dialogue: 0,0:00:53.44,0:00:54.27,Default,,0,0,0,,hi nahi.
Dialogue: 0,0:00:54.27,0:00:55.92,Default,,0,0,0,,Usne bas bhes badla,
Dialogue: 0,0:00:55.92,0:00:58.69,Default,,0,0,0,,aur seedha kutiya ke darwaze tak
Dialogue: 0,0:00:58.69,0:00:59.24,Default,,0,0,0,,aa gaya.
Dialogue: 0,0:00:59.69,0:01:01.76,Default,,0,0,0,,Toh yeh rekha aayi kahan se?
Dialogue: 0,0:01:01.76,0:01:03.56,Default,,0,0,0,,Kisne pehli baar likhi?
Dialogue: 0,0:01:03.56,0:01:05.63,Default,,0,0,0,,Aur kya Ramayan ki dharti aaj
Dialogue: 0,0:01:05.63,0:01:07.18,Default,,0,0,0,,bhi kuch bataati hai?
Dialogue: 0,0:01:07.18,0:01:07.96,Default,,0,0,0,,Par pehle,
Dialogue: 0,0:01:07.96,0:01:10.03,Default,,0,0,0,,Valmiki ki asli katha.
Dialogue: 0,0:01:10.48,0:01:12.33,Default,,0,0,0,,Ab chaliye Panchavati.
Dialogue: 0,0:01:12.33,0:01:14.46,Default,,0,0,0,,Godavari ke kinare,
Dialogue: 0,0:01:14.46,0:01:16.84,Default,,0,0,0,,ghane jungle ke beech chhoti si
Dialogue: 0,0:01:16.84,0:01:17.38,Default,,0,0,0,,kutiya.
Dialogue: 0,0:01:17.38,0:01:17.64,Default,,0,0,0,,Ram,
Dialogue: 0,0:01:17.64,0:01:20.30,Default,,0,0,0,,Sita aur Lakshman yahan vanvaas ke
Dialogue: 0,0:01:20.30,0:01:21.62,Default,,0,0,0,,din kaat rahe hain.
Dialogue: 0,0:01:22.07,0:01:24.37,Default,,0,0,0,,Lekin door Lanka mein chaal ban
Dialogue: 0,0:01:24.37,0:01:25.23,Default,,0,0,0,,chuki hai.
Dialogue: 0,0:01:25.23,0:01:28.09,Default,,0,0,0,,Ravan Maricha naam ke rakshas ke
Dialogue: 0,0:01:28.09,0:01:29.24,Default,,0,0,0,,paas jaata hai.
Dialogue: 0,0:01:29.24,0:01:30.10,Default,,0,0,0,,Maricha,
Dialogue: 0,0:01:30.10,0:01:32.68,Default,,0,0,0,,yaani roop badalne mein maahir.
Dialogue: 0,0:01:33.13,0:01:34.45,Default,,0,0,0,,Valmiki likhte hain,
Dialogue: 0,0:01:34.45,0:01:36.65,Default,,0,0,0,,Maricha pehle mana karta hai.
Dialogue: 0,0:01:36.65,0:01:38.41,Default,,0,0,0,,Wo Ram ki taaqat dekh chuka
Dialogue: 0,0:01:38.41,0:01:38.63,Default,,0,0,0,,hai.
Dialogue: 0,0:01:38.63,0:01:40.83,Default,,0,0,0,,Lekin Ravan ki dhamki ke aage,
Dialogue: 0,0:01:40.83,0:01:42.37,Default,,0,0,0,,aakhir wo jhuk jaata hai.
Dialogue: 0,0:01:42.82,0:01:45.69,Default,,0,0,0,,Ab Maricha ban jaata hai sone
Dialogue: 0,0:01:45.69,0:01:46.54,Default,,0,0,0,,ka hiran.
Dialogue: 0,0:01:46.54,0:01:47.69,Default,,0,0,0,,Chamakti khaal,
Dialogue: 0,0:01:47.69,0:01:49.40,Default,,0,0,0,,chaandi jaise dhabbe,
Dialogue: 0,0:01:49.40,0:01:50.83,Default,,0,0,0,,ratnon jaise seeng.
Dialogue: 0,0:01:50.83,0:01:51.98,Default,,0,0,0,,Aisa hiran,
Dialogue: 0,0:01:51.98,0:01:54.55,Default,,0,0,0,,jo jungle mein kisi ne nahi
Dialogue: 0,0:01:54.55,0:01:55.13,Default,,0,0,0,,dekha.
Dialogue: 0,0:01:55.58,0:01:57.82,Default,,0,0,0,,Sita ki nazar us par padti
Dialogue: 0,0:01:57.82,0:01:58.07,Default,,0,0,0,,hai.
Dialogue: 0,0:01:58.07,0:01:59.56,Default,,0,0,0,,Wo Ram se kehti hain,
Dialogue: 0,0:01:59.56,0:02:01.31,Default,,0,0,0,,mujhe yeh hiran chahiye.
Dialogue: 0,0:02:01.31,0:02:03.05,Default,,0,0,0,,Zinda mile toh achha,
Dialogue: 0,0:02:03.05,0:02:05.05,Default,,0,0,0,,warna iski khaal hi le aaiye.
Dialogue: 0,0:02:05.50,0:02:07.81,Default,,0,0,0,,Par Lakshman ko shak hota hai.
Dialogue: 0,0:02:07.81,0:02:09.53,Default,,0,0,0,,Wo Ram se kehte hain,
Dialogue: 0,0:02:09.53,0:02:09.82,Default,,0,0,0,,bhaiya,
Dialogue: 0,0:02:09.82,0:02:11.84,Default,,0,0,0,,yeh asli hiran nahi.
Dialogue: 0,0:02:11.84,0:02:14.44,Default,,0,0,0,,Yeh Maricha ki maaya lagti hai,
Dialogue: 0,0:02:14.44,0:02:16.17,Default,,0,0,0,,yaani dhokhe ka jaal.
Dialogue: 0,0:02:16.62,0:02:18.64,Default,,0,0,0,,Ram hiran ke peeche jaane ka
Dialogue: 0,0:02:18.64,0:02:19.76,Default,,0,0,0,,faisla karte hain.
Dialogue: 0,0:02:19.76,0:02:22.01,Default,,0,0,0,,Jaate jaate wo Lakshman ko badi
Dialogue: 0,0:02:22.01,0:02:23.58,Default,,0,0,0,,zimmedari dete hain.
Dialogue: 0,0:02:23.58,0:02:25.15,Default,,0,0,0,,Sita ki raksha karna,
Dialogue: 0,0:02:25.15,0:02:26.28,Default,,0,0,0,,kutiya mat chhodna.
Dialogue: 0,0:02:26.72,0:02:28.31,Default,,0,0,0,,Hiran Ram ko door,
Dialogue: 0,0:02:28.31,0:02:30.22,Default,,0,0,0,,aur door le jaata hai.
Dialogue: 0,0:02:30.22,0:02:31.80,Default,,0,0,0,,Kabhi dikhta hai,
Dialogue: 0,0:02:31.80,0:02:32.75,Default,,0,0,0,,kabhi gayab.
Dialogue: 0,0:02:32.75,0:02:35.61,Default,,0,0,0,,Aakhir Ram ka baan use lagta
Dialogue: 0,0:02:35.61,0:02:35.93,Default,,0,0,0,,hai.
Dialogue: 0,0:02:35.93,0:02:38.47,Default,,0,0,0,,Lekin yahan asli twist hai.
Dialogue: 0,0:02:38.92,0:02:42.13,Default,,0,0,0,,Marte marte Maricha apni asli shakal
Dialogue: 0,0:02:42.13,0:02:43.12,Default,,0,0,0,,mein aata hai.
Dialogue: 0,0:02:43.12,0:02:44.85,Default,,0,0,0,,Aur Ram ki hi awaaz mein
Dialogue: 0,0:02:44.85,0:02:45.60,Default,,0,0,0,,cheekhta hai.
Dialogue: 0,0:02:45.60,0:02:46.34,Default,,0,0,0,,Haa Sita,
Dialogue: 0,0:02:46.34,0:02:47.08,Default,,0,0,0,,haa Lakshman!
Dialogue: 0,0:02:47.08,0:02:49.56,Default,,0,0,0,,Yeh awaaz jungle cheerti hui kutiya
Dialogue: 0,0:02:49.56,0:02:50.79,Default,,0,0,0,,tak pahunchti hai.
Dialogue: 0,0:02:51.25,0:02:53.16,Default,,0,0,0,,Sita ghabra jaati hain.
Dialogue: 0,0:02:53.16,0:02:55.89,Default,,0,0,0,,Unhe lagta hai Ram musibat mein
Dialogue: 0,0:02:55.89,0:02:56.17,Default,,0,0,0,,hain.
Dialogue: 0,0:02:56.17,0:02:58.08,Default,,0,0,0,,Wo Lakshman se kehti hain,
Dialogue: 0,0:02:58.08,0:02:58.35,Default,,0,0,0,,jaao,
Dialogue: 0,0:02:58.35,0:02:59.99,Default,,0,0,0,,apne bhai ko bachao.
Dialogue: 0,0:02:59.99,0:03:01.09,Default,,0,0,0,,Der mat karo.
Dialogue: 0,0:03:01.54,0:03:03.07,Default,,0,0,0,,Lakshman shaant rehte hain.
Dialogue: 0,0:03:03.07,0:03:05.38,Default,,0,0,0,,Valmiki ke Lakshman kehte hain,
Dialogue: 0,0:03:05.38,0:03:07.68,Default,,0,0,0,,Ram ko koi nahi hara sakta.
Dialogue: 0,0:03:07.68,0:03:09.99,Default,,0,0,0,,Yeh awaaz rakshas ka dhokha hai.
Dialogue: 0,0:03:10.44,0:03:12.69,Default,,0,0,0,,Aur yahin aata hai woh hissa,
Dialogue: 0,0:03:12.69,0:03:14.70,Default,,0,0,0,,jo TV mein aksar chhoot jaata
Dialogue: 0,0:03:14.70,0:03:14.95,Default,,0,0,0,,hai.
Dialogue: 0,0:03:14.95,0:03:16.45,Default,,0,0,0,,Sita ke kadve shabd.
Dialogue: 0,0:03:16.45,0:03:19.46,Default,,0,0,0,,Valmiki ne unhe bina chhupaaye likha
Dialogue: 0,0:03:19.46,0:03:19.71,Default,,0,0,0,,hai.
Dialogue: 0,0:03:20.16,0:03:22.63,Default,,0,0,0,,Sita Lakshman par ilzaam lagati hain.
Dialogue: 0,0:03:22.63,0:03:24.21,Default,,0,0,0,,Tum chahte ho Ram mar jaayein,
Dialogue: 0,0:03:24.21,0:03:26.01,Default,,0,0,0,,taaki tum mujhe paa sako.
Dialogue: 0,0:03:26.01,0:03:27.81,Default,,0,0,0,,Ya tum Bharat ke kehne par
Dialogue: 0,0:03:27.81,0:03:28.71,Default,,0,0,0,,yahan aaye ho.
Dialogue: 0,0:03:29.16,0:03:29.65,Default,,0,0,0,,Socho,
Dialogue: 0,0:03:29.65,0:03:31.59,Default,,0,0,0,,Lakshman par kya beeti hogi.
Dialogue: 0,0:03:31.59,0:03:33.29,Default,,0,0,0,,Jis bhabhi ko wo maa ki
Dialogue: 0,0:03:33.29,0:03:34.51,Default,,0,0,0,,tarah maante the.
Dialogue: 0,0:03:34.51,0:03:36.94,Default,,0,0,0,,Unhi se aisi baat sunni pade.
Dialogue: 0,0:03:37.39,0:03:39.70,Default,,0,0,0,,Valmiki ke Lakshman ko gehri chot
Dialogue: 0,0:03:39.70,0:03:40.39,Default,,0,0,0,,lagti hai.
Dialogue: 0,0:03:40.39,0:03:42.01,Default,,0,0,0,,Wo haath jod kar kehte hain,
Dialogue: 0,0:03:42.01,0:03:44.31,Default,,0,0,0,,aapke yeh shabd mujhe sahan nahi.
Dialogue: 0,0:03:44.31,0:03:45.23,Default,,0,0,0,,Main jaata hoon.
Dialogue: 0,0:03:45.68,0:03:47.75,Default,,0,0,0,,Jaane se pehle wo kya karte
Dialogue: 0,0:03:47.75,0:03:47.98,Default,,0,0,0,,hain?
Dialogue: 0,0:03:47.98,0:03:49.59,Default,,0,0,0,,Koi rekha nahi kheenchte.
Dialogue: 0,0:03:49.59,0:03:51.88,Default,,0,0,0,,Wo jungle ke devtaon se prarthana
Dialogue: 0,0:03:51.88,0:03:52.57,Default,,0,0,0,,karte hain,
Dialogue: 0,0:03:52.57,0:03:54.41,Default,,0,0,0,,ki Sita ki raksha karna.
Dialogue: 0,0:03:54.86,0:03:58.42,Default,,0,0,0,,Yaani Valmiki mein suraksha sirf prarthana
Dialogue: 0,0:03:58.42,0:03:58.70,Default,,0,0,0,,hai,
Dialogue: 0,0:03:58.70,0:04:00.07,Default,,0,0,0,,koi rekha nahi.
Dialogue: 0,0:04:00.07,0:04:01.99,Default,,0,0,0,,Aur Lakshman bhaari mann se,
Dialogue: 0,0:04:01.99,0:04:04.18,Default,,0,0,0,,kutiya chhod kar Ram ko dhoondhne
Dialogue: 0,0:04:04.18,0:04:05.55,Default,,0,0,0,,nikal padte hain.
Dialogue: 0,0:04:06.00,0:04:08.57,Default,,0,0,0,,Ab kutiya mein Sita akeli hain.
Dialogue: 0,0:04:08.57,0:04:10.62,Default,,0,0,0,,Aur isi pal ka intezaar,
Dialogue: 0,0:04:10.62,0:04:12.93,Default,,0,0,0,,jhaadiyon ke peeche koi kar raha
Dialogue: 0,0:04:12.93,0:04:13.19,Default,,0,0,0,,tha.
Dialogue: 0,0:04:13.19,0:04:14.22,Default,,0,0,0,,Woh tha Ravan,
Dialogue: 0,0:04:14.22,0:04:15.25,Default,,0,0,0,,roop badal kar.
Dialogue: 0,0:04:15.69,0:04:19.05,Default,,0,0,0,,Valmiki ke Ravan sanyasi ke bhes
Dialogue: 0,0:04:19.05,0:04:20.28,Default,,0,0,0,,mein aate hain.
Dialogue: 0,0:04:20.28,0:04:21.50,Default,,0,0,0,,Gerua kapde,
Dialogue: 0,0:04:21.50,0:04:23.02,Default,,0,0,0,,haath mein kamandal,
Dialogue: 0,0:04:23.02,0:04:25.16,Default,,0,0,0,,yaani paani ka bartan.
Dialogue: 0,0:04:25.16,0:04:26.38,Default,,0,0,0,,Mooh se mantra,
Dialogue: 0,0:04:26.38,0:04:27.61,Default,,0,0,0,,aankhon mein chaal.
Dialogue: 0,0:04:28.06,0:04:29.71,Default,,0,0,0,,Aur Sita kya karti hain?
Dialogue: 0,0:04:29.71,0:04:30.89,Default,,0,0,0,,Wo darti nahi.
Dialogue: 0,0:04:30.89,0:04:33.02,Default,,0,0,0,,Ghar aaye mehmaan ka satkaar karti
Dialogue: 0,0:04:33.02,0:04:33.25,Default,,0,0,0,,hain.
Dialogue: 0,0:04:33.25,0:04:34.43,Default,,0,0,0,,Aasan deti hain,
Dialogue: 0,0:04:34.43,0:04:35.61,Default,,0,0,0,,paani deti hain,
Dialogue: 0,0:04:35.61,0:04:37.50,Default,,0,0,0,,bhojan ka nyota deti hain.
Dialogue: 0,0:04:37.95,0:04:39.56,Default,,0,0,0,,Yeh baat dhyan se suniye.
Dialogue: 0,0:04:39.56,0:04:42.24,Default,,0,0,0,,Valmiki mein Ravan ko koi rekha
Dialogue: 0,0:04:42.24,0:04:44.92,Default,,0,0,0,,paar karwane ki chaal nahi chalni
Dialogue: 0,0:04:44.92,0:04:45.46,Default,,0,0,0,,padi.
Dialogue: 0,0:04:45.46,0:04:47.61,Default,,0,0,0,,Sita ne mehmaan dharm nibhaya,
Dialogue: 0,0:04:47.61,0:04:47.87,Default,,0,0,0,,bas.
Dialogue: 0,0:04:48.32,0:04:50.84,Default,,0,0,0,,Phir Ravan apna asli roop dikhata
Dialogue: 0,0:04:50.84,0:04:51.07,Default,,0,0,0,,hai.
Dialogue: 0,0:04:51.07,0:04:53.13,Default,,0,0,0,,Wo Sita ke saamne Lanka ki
Dialogue: 0,0:04:53.13,0:04:55.43,Default,,0,0,0,,daulat aur apni taaqat ka bakhaan
Dialogue: 0,0:04:55.43,0:04:56.12,Default,,0,0,0,,karta hai.
Dialogue: 0,0:04:56.12,0:04:57.03,Default,,0,0,0,,Aur kehta hai,
Dialogue: 0,0:04:57.03,0:04:58.41,Default,,0,0,0,,meri rani bano.
Dialogue: 0,0:04:58.86,0:05:01.06,Default,,0,0,0,,Sita ka jawab aag jaisa hai.
Dialogue: 0,0:05:01.06,0:05:02.04,Default,,0,0,0,,Wo kehti hain,
Dialogue: 0,0:05:02.04,0:05:03.76,Default,,0,0,0,,Ram sher hain aur tum geedad.
Dialogue: 0,0:05:03.76,0:05:06.45,Default,,0,0,0,,Tum Ram ki barabari kabhi nahi
Dialogue: 0,0:05:06.45,0:05:07.19,Default,,0,0,0,,kar sakte.
Dialogue: 0,0:05:07.64,0:05:10.49,Default,,0,0,0,,Ab Ravan zabardasti par utar aata
Dialogue: 0,0:05:10.49,0:05:10.73,Default,,0,0,0,,hai.
Dialogue: 0,0:05:10.73,0:05:12.86,Default,,0,0,0,,Wo Sita ko utha kar apne
Dialogue: 0,0:05:12.86,0:05:15.00,Default,,0,0,0,,udte rath mein bitha leta hai.
Dialogue: 0,0:05:15.00,0:05:17.14,Default,,0,0,0,,Aur aasmaan ki taraf chal padta
Dialogue: 0,0:05:17.14,0:05:17.38,Default,,0,0,0,,hai.
Dialogue: 0,0:05:17.82,0:05:19.73,Default,,0,0,0,,Sita pukaarti hain,
Dialogue: 0,0:05:19.73,0:05:20.04,Default,,0,0,0,,ped,
Dialogue: 0,0:05:20.04,0:05:20.68,Default,,0,0,0,,nadi,
Dialogue: 0,0:05:20.68,0:05:22.26,Default,,0,0,0,,jungle ke jaanwar,
Dialogue: 0,0:05:22.26,0:05:22.89,Default,,0,0,0,,sab se.
Dialogue: 0,0:05:22.89,0:05:24.48,Default,,0,0,0,,Ram ko batana,
Dialogue: 0,0:05:24.48,0:05:26.38,Default,,0,0,0,,Ravan mujhe le gaya.
Dialogue: 0,0:05:26.38,0:05:30.81,Default,,0,0,0,,Godavari ke kinare unki aawaaz goonjti
Dialogue: 0,0:05:30.81,0:05:31.13,Default,,0,0,0,,hai.
Dialogue: 0,0:05:31.58,0:05:33.96,Default,,0,0,0,,Tabhi boodhe giddh raja ki neend
Dialogue: 0,0:05:33.96,0:05:34.76,Default,,0,0,0,,tootti hai.
Dialogue: 0,0:05:34.76,0:05:35.29,Default,,0,0,0,,Jatayu.
Dialogue: 0,0:05:35.29,0:05:37.14,Default,,0,0,0,,Wo Ravan se ladta hai,
Dialogue: 0,0:05:37.14,0:05:39.00,Default,,0,0,0,,uska rath tod deta hai.
Dialogue: 0,0:05:39.00,0:05:41.38,Default,,0,0,0,,Par Ravan ki talwar uske pankh
Dialogue: 0,0:05:41.38,0:05:42.44,Default,,0,0,0,,kaat deti hai.
Dialogue: 0,0:05:42.89,0:05:45.60,Default,,0,0,0,,Yahi hai Valmiki ka Sita haran.
Dialogue: 0,0:05:45.60,0:05:46.83,Default,,0,0,0,,Koi rekha nahi,
Dialogue: 0,0:05:46.83,0:05:49.05,Default,,0,0,0,,koi rekha paar karwane ka jaal
Dialogue: 0,0:05:49.05,0:05:49.54,Default,,0,0,0,,nahi.
Dialogue: 0,0:05:49.54,0:05:51.76,Default,,0,0,0,,Toh sawaal aur gehra ho jaata
Dialogue: 0,0:05:51.76,0:05:52.01,Default,,0,0,0,,hai,
Dialogue: 0,0:05:52.01,0:05:53.48,Default,,0,0,0,,rekha aayi kahan se?
Dialogue: 0,0:05:53.93,0:05:56.38,Default,,0,0,0,,Ab shuru hoti hai asli jasoosi.
Dialogue: 0,0:05:56.38,0:05:58.84,Default,,0,0,0,,Hum Ramayan ki alag alag kitaabein
Dialogue: 0,0:05:58.84,0:05:59.50,Default,,0,0,0,,kholte hain,
Dialogue: 0,0:05:59.50,0:06:00.84,Default,,0,0,0,,sadiyon ke hisaab se.
Dialogue: 0,0:06:00.84,0:06:01.73,Default,,0,0,0,,Aur dhoondhte hain,
Dialogue: 0,0:06:01.73,0:06:03.96,Default,,0,0,0,,rekha kahan pehli baar dikhti hai.
Dialogue: 0,0:06:04.41,0:06:05.98,Default,,0,0,0,,Pehle yeh samajh lijiye.
Dialogue: 0,0:06:05.98,0:06:07.99,Default,,0,0,0,,Ramayan sirf Valmiki ki nahi.
Dialogue: 0,0:06:07.99,0:06:10.00,Default,,0,0,0,,Bharat ki har bhasha mein kaviyon
Dialogue: 0,0:06:10.00,0:06:12.46,Default,,0,0,0,,ne ise apne shabdon mein dobara
Dialogue: 0,0:06:12.46,0:06:12.91,Default,,0,0,0,,kaha.
Dialogue: 0,0:06:13.36,0:06:15.86,Default,,0,0,0,,Scholars ki nazar Sanskrit ke Mahanataka
Dialogue: 0,0:06:15.86,0:06:16.63,Default,,0,0,0,,par jaati hai.
Dialogue: 0,0:06:16.63,0:06:19.13,Default,,0,0,0,,Mahanataka yaani Ramayan par likha gaya
Dialogue: 0,0:06:19.13,0:06:19.89,Default,,0,0,0,,bada natak.
Dialogue: 0,0:06:19.89,0:06:22.01,Default,,0,0,0,,Madhyakaal ki in kitaabon mein rekha
Dialogue: 0,0:06:22.01,0:06:23.16,Default,,0,0,0,,ka khayal ubharta hai.
Dialogue: 0,0:06:23.61,0:06:25.76,Default,,0,0,0,,Aur phir milti hai saaf gawahi,
Dialogue: 0,0:06:25.76,0:06:26.72,Default,,0,0,0,,Telugu mein.
Dialogue: 0,0:06:26.72,0:06:28.15,Default,,0,0,0,,Ranganatha Ramayan,
Dialogue: 0,0:06:28.15,0:06:30.78,Default,,0,0,0,,jise kavi Gona Budda Reddy ne
Dialogue: 0,0:06:30.78,0:06:31.25,Default,,0,0,0,,likha.
Dialogue: 0,0:06:31.25,0:06:31.49,Default,,0,0,0,,Kab?
Dialogue: 0,0:06:31.49,0:06:34.12,Default,,0,0,0,,1300 aur 1310 ke beech.
Dialogue: 0,0:06:34.57,0:06:36.60,Default,,0,0,0,,Yaani Valmiki ke kaafi baad,
Dialogue: 0,0:06:36.60,0:06:38.18,Default,,0,0,0,,madhyakaal ke Andhra mein.
Dialogue: 0,0:06:38.18,0:06:40.67,Default,,0,0,0,,Is Telugu Ramayan mein Lakshman dhanush
Dialogue: 0,0:06:40.67,0:06:41.57,Default,,0,0,0,,uthate hain.
Dialogue: 0,0:06:41.57,0:06:43.38,Default,,0,0,0,,Aur uski nok se kutiya ke
Dialogue: 0,0:06:43.38,0:06:44.95,Default,,0,0,0,,ird-gird rekhayein kheenchte hain.
Dialogue: 0,0:06:45.41,0:06:46.64,Default,,0,0,0,,Ab chaliye Bengal.
Dialogue: 0,0:06:46.64,0:06:49.10,Default,,0,0,0,,Wahan Krittivas naam ke kavi ne
Dialogue: 0,0:06:49.10,0:06:50.83,Default,,0,0,0,,Bangla mein Ramayan likhi.
Dialogue: 0,0:06:50.83,0:06:52.30,Default,,0,0,0,,Krittivasi Ramayan,
Dialogue: 0,0:06:52.30,0:06:54.03,Default,,0,0,0,,jo Bengal ke gaon gaon mein
Dialogue: 0,0:06:54.03,0:06:54.52,Default,,0,0,0,,gaayi gayi.
Dialogue: 0,0:06:54.97,0:06:57.18,Default,,0,0,0,,Krittivas ke yahan rekha aur bhi
Dialogue: 0,0:06:57.18,0:06:58.06,Default,,0,0,0,,taaqatwar hai.
Dialogue: 0,0:06:58.06,0:06:58.94,Default,,0,0,0,,Aisi seema,
Dialogue: 0,0:06:58.94,0:07:00.93,Default,,0,0,0,,jise Ravan paar hi nahi kar
Dialogue: 0,0:07:00.93,0:07:01.37,Default,,0,0,0,,sakta.
Dialogue: 0,0:07:01.37,0:07:04.02,Default,,0,0,0,,Isliye use dhokhe ka sahara lena
Dialogue: 0,0:07:04.02,0:07:04.69,Default,,0,0,0,,padta hai.
Dialogue: 0,0:07:05.13,0:07:06.90,Default,,0,0,0,,Yahi wo mod hai jo hum
Dialogue: 0,0:07:06.90,0:07:07.92,Default,,0,0,0,,sab jaante hain.
Dialogue: 0,0:07:07.92,0:07:10.19,Default,,0,0,0,,Ravan rekha ke bahar khada,
Dialogue: 0,0:07:10.19,0:07:11.46,Default,,0,0,0,,bhiksha maangta hai.
Dialogue: 0,0:07:11.46,0:07:13.73,Default,,0,0,0,,Aur Sita ko bahar aane par
Dialogue: 0,0:07:13.73,0:07:15.00,Default,,0,0,0,,majboor karta hai.
Dialogue: 0,0:07:15.45,0:07:18.04,Default,,0,0,0,,Ab sabse dilchasp gawahi aati hai.
Dialogue: 0,0:07:18.04,0:07:20.16,Default,,0,0,0,,Tulsidas ki Ramcharitmanas,
Dialogue: 0,0:07:20.16,0:07:22.75,Default,,0,0,0,,yaani Awadhi mein likhi Ram katha.
Dialogue: 0,0:07:22.75,0:07:24.87,Default,,0,0,0,,Uttar Bharat mein yahi ghar ghar
Dialogue: 0,0:07:24.87,0:07:26.05,Default,,0,0,0,,padhi jaati hai.
Dialogue: 0,0:07:26.50,0:07:27.37,Default,,0,0,0,,Aap sochenge,
Dialogue: 0,0:07:27.37,0:07:29.55,Default,,0,0,0,,Manas mein toh rekha zaroor hogi.
Dialogue: 0,0:07:29.55,0:07:32.38,Default,,0,0,0,,Lekin Aranya Kanda mein Tulsidas rekha
Dialogue: 0,0:07:32.38,0:07:34.56,Default,,0,0,0,,kheenchne ka scene likhte hi nahi.
Dialogue: 0,0:07:34.56,0:07:35.64,Default,,0,0,0,,Haran ki katha,
Dialogue: 0,0:07:35.64,0:07:36.73,Default,,0,0,0,,bina rekha ke.
Dialogue: 0,0:07:37.18,0:07:38.65,Default,,0,0,0,,Par yahan twist hai.
Dialogue: 0,0:07:38.65,0:07:40.42,Default,,0,0,0,,Rekha gayab nahi hui.
Dialogue: 0,0:07:40.42,0:07:42.18,Default,,0,0,0,,Wo chupchaap aati hai,
Dialogue: 0,0:07:42.18,0:07:43.35,Default,,0,0,0,,bahut baad mein,
Dialogue: 0,0:07:43.35,0:07:44.82,Default,,0,0,0,,Lanka Kanda mein.
Dialogue: 0,0:07:44.82,0:07:46.29,Default,,0,0,0,,Aur bolta kaun hai?
Dialogue: 0,0:07:46.29,0:07:48.35,Default,,0,0,0,,Ravan ki apni patni,
Dialogue: 0,0:07:48.35,0:07:49.52,Default,,0,0,0,,Mandodari.
Dialogue: 0,0:07:49.97,0:07:53.07,Default,,0,0,0,,Mandodari Ravan ko taana maarti hai.
Dialogue: 0,0:07:53.07,0:07:54.63,Default,,0,0,0,,Tulsidas likhte hain,
Dialogue: 0,0:07:54.63,0:07:56.70,Default,,0,0,0,,Ramanuj laghu rekh khachai,
Dialogue: 0,0:07:56.70,0:07:59.54,Default,,0,0,0,,sou nahin naghehu asi manusai.
Dialogue: 0,0:07:59.54,0:08:00.32,Default,,0,0,0,,Yeh chaupai,
Dialogue: 0,0:08:00.32,0:08:02.38,Default,,0,0,0,,yaani Manas ka chhota chhand,
Dialogue: 0,0:08:02.38,0:08:03.94,Default,,0,0,0,,sab badal deti hai.
Dialogue: 0,0:08:04.39,0:08:04.89,Default,,0,0,0,,Matlab?
Dialogue: 0,0:08:04.89,0:08:07.38,Default,,0,0,0,,Lakshman ne chhoti si rekha kheenchi
Dialogue: 0,0:08:07.38,0:08:07.63,Default,,0,0,0,,thi.
Dialogue: 0,0:08:07.63,0:08:08.13,Default,,0,0,0,,Aur tum,
Dialogue: 0,0:08:08.13,0:08:09.62,Default,,0,0,0,,itne bade Ravan,
Dialogue: 0,0:08:09.62,0:08:11.37,Default,,0,0,0,,use bhi laangh na sake.
Dialogue: 0,0:08:11.37,0:08:13.87,Default,,0,0,0,,Yahi tumhari bahaduri hai?
Dialogue: 0,0:08:14.32,0:08:15.50,Default,,0,0,0,,Toh dekhiye kaisa khel hai.
Dialogue: 0,0:08:15.50,0:08:17.20,Default,,0,0,0,,Tulsidas scene nahi dikhate,
Dialogue: 0,0:08:17.20,0:08:18.90,Default,,0,0,0,,lekin rekha ka zikr karwa dete
Dialogue: 0,0:08:18.90,0:08:19.07,Default,,0,0,0,,hain.
Dialogue: 0,0:08:19.07,0:08:20.77,Default,,0,0,0,,Lagta hai unke zamaane tak yeh
Dialogue: 0,0:08:20.77,0:08:22.13,Default,,0,0,0,,baat logon mein phail chuki thi.
Dialogue: 0,0:08:22.58,0:08:25.15,Default,,0,0,0,,Lekin asli sawaal ab shuru hota
Dialogue: 0,0:08:25.15,0:08:25.39,Default,,0,0,0,,hai.
Dialogue: 0,0:08:25.39,0:08:27.26,Default,,0,0,0,,Agar katha itni badli,
Dialogue: 0,0:08:27.26,0:08:29.14,Default,,0,0,0,,toh kya zameen par koi nishaan
Dialogue: 0,0:08:29.14,0:08:29.37,Default,,0,0,0,,hai?
Dialogue: 0,0:08:29.37,0:08:31.71,Default,,0,0,0,,Kya kisi ne Ramayan ki jagahein
Dialogue: 0,0:08:31.71,0:08:32.18,Default,,0,0,0,,khodi?
Dialogue: 0,0:08:32.63,0:08:33.21,Default,,0,0,0,,Saal 1975.
Dialogue: 0,0:08:33.21,0:08:36.13,Default,,0,0,0,,Archaeological Survey of India,
Dialogue: 0,0:08:36.13,0:08:37.30,Default,,0,0,0,,yaani ASI,
Dialogue: 0,0:08:37.30,0:08:39.92,Default,,0,0,0,,desh ki sarkari khudai sanstha.
Dialogue: 0,0:08:39.92,0:08:42.55,Default,,0,0,0,,Bada project shuru hota hai,
Dialogue: 0,0:08:42.55,0:08:46.05,Default,,0,0,0,,naam hai Archaeology of Ramayana Sites.
Dialogue: 0,0:08:46.50,0:08:47.62,Default,,0,0,0,,Iski kaman B.B.
Dialogue: 0,0:08:47.62,0:08:48.75,Default,,0,0,0,,Lal ke haath mein thi,
Dialogue: 0,0:08:48.75,0:08:51.47,Default,,0,0,0,,jo ASI ke director general rahe.
Dialogue: 0,0:08:51.47,0:08:52.59,Default,,0,0,0,,Maqsad seedha tha.
Dialogue: 0,0:08:52.59,0:08:54.40,Default,,0,0,0,,Ramayan mein jin bastiyon ka naam
Dialogue: 0,0:08:54.40,0:08:55.08,Default,,0,0,0,,aata hai,
Dialogue: 0,0:08:55.08,0:08:56.43,Default,,0,0,0,,unhe khod kar dekho.
Dialogue: 0,0:08:56.88,0:08:58.70,Default,,0,0,0,,Team pahunchti hai Ayodhya,
Dialogue: 0,0:08:58.70,0:08:60.00,Default,,0,0,0,,Bharadwaj ashram,
Dialogue: 0,0:08:60.00,0:09:00.77,Default,,0,0,0,,Nandigram,
Dialogue: 0,0:09:00.77,0:09:03.11,Default,,0,0,0,,Chitrakoot aur Shringaverapur.
Dialogue: 0,0:09:03.11,0:09:04.92,Default,,0,0,0,,Yaani wahi jagahein,
Dialogue: 0,0:09:04.92,0:09:07.26,Default,,0,0,0,,jo katha mein vanvaas ke raaste
Dialogue: 0,0:09:07.26,0:09:08.29,Default,,0,0,0,,par aati hain.
Dialogue: 0,0:09:08.74,0:09:10.15,Default,,0,0,0,,Shringaverapur,
Dialogue: 0,0:09:10.15,0:09:12.68,Default,,0,0,0,,Prayagraj ke paas Ganga kinare.
Dialogue: 0,0:09:12.68,0:09:14.08,Default,,0,0,0,,Katha kehti hai,
Dialogue: 0,0:09:14.08,0:09:16.61,Default,,0,0,0,,yahin nishad raja Guh ne Ram
Dialogue: 0,0:09:16.61,0:09:18.58,Default,,0,0,0,,ko Ganga paar karwayi thi.
Dialogue: 0,0:09:18.58,0:09:20.83,Default,,0,0,0,,Toh ASI ki team ne yahan
Dialogue: 0,0:09:20.83,0:09:21.39,Default,,0,0,0,,kya paaya?
Dialogue: 0,0:09:21.84,0:09:24.55,Default,,0,0,0,,Zameen ke neeche lagbhag 9 metre
Dialogue: 0,0:09:24.55,0:09:27.52,Default,,0,0,0,,tak insaani basti ki parten mili.
Dialogue: 0,0:09:27.52,0:09:29.96,Default,,0,0,0,,Parten yaani mitti ki tahein,
Dialogue: 0,0:09:29.96,0:09:31.86,Default,,0,0,0,,jaise kitaab ke panne.
Dialogue: 0,0:09:31.86,0:09:32.67,Default,,0,0,0,,Har panna,
Dialogue: 0,0:09:32.67,0:09:34.02,Default,,0,0,0,,alag zamana.
Dialogue: 0,0:09:34.47,0:09:36.18,Default,,0,0,0,,ASI ne in parton mein kai
Dialogue: 0,0:09:36.18,0:09:38.10,Default,,0,0,0,,alag sanskritiyon ke daur gine.
Dialogue: 0,0:09:38.10,0:09:40.44,Default,,0,0,0,,Yaani yahan log bahut lambe samay
Dialogue: 0,0:09:40.44,0:09:40.66,Default,,0,0,0,,tak,
Dialogue: 0,0:09:40.66,0:09:41.94,Default,,0,0,0,,baar baar baste rahe.
Dialogue: 0,0:09:41.94,0:09:44.50,Default,,0,0,0,,Ganga kinare yeh jagah kabhi soni
Dialogue: 0,0:09:44.50,0:09:45.35,Default,,0,0,0,,nahi rahi.
Dialogue: 0,0:09:45.80,0:09:48.36,Default,,0,0,0,,Lekin yahan imaandaari zaroori hai.
Dialogue: 0,0:09:48.36,0:09:50.49,Default,,0,0,0,,Khudai yeh batati hai ki yahan
Dialogue: 0,0:09:50.49,0:09:52.41,Default,,0,0,0,,bahut purane log rehte the.
Dialogue: 0,0:09:52.41,0:09:54.75,Default,,0,0,0,,Yeh nahi batati ki kaunsi katha
Dialogue: 0,0:09:54.75,0:09:55.18,Default,,0,0,0,,kab hui.
Dialogue: 0,0:09:55.63,0:09:56.45,Default,,0,0,0,,Aur rekha?
Dialogue: 0,0:09:56.45,0:09:58.91,Default,,0,0,0,,Uska nishaan mitti mein nahi,
Dialogue: 0,0:09:58.91,0:10:00.28,Default,,0,0,0,,kitaabon mein hai.
Dialogue: 0,0:10:00.28,0:10:03.01,Default,,0,0,0,,Rekha kaviyon ki kalam se nikli
Dialogue: 0,0:10:03.01,0:10:03.28,Default,,0,0,0,,thi.
Dialogue: 0,0:10:03.28,0:10:06.02,Default,,0,0,0,,Toh khoj ab chalti hai Panchavati
Dialogue: 0,0:10:06.02,0:10:06.84,Default,,0,0,0,,ki taraf.
Dialogue: 0,0:10:07.29,0:10:08.86,Default,,0,0,0,,Parampara ka jawab saaf hai.
Dialogue: 0,0:10:08.86,0:10:10.61,Default,,0,0,0,,Panchavati yaani aaj ka Nashik,
Dialogue: 0,0:10:10.61,0:10:12.88,Default,,0,0,0,,Maharashtra mein Godavari ke kinare.
Dialogue: 0,0:10:12.88,0:10:14.97,Default,,0,0,0,,Shraddhalu ise Sita haran ki dharti
Dialogue: 0,0:10:14.97,0:10:15.50,Default,,0,0,0,,maante hain.
Dialogue: 0,0:10:15.95,0:10:16.43,Default,,0,0,0,,Saal 1950.
Dialogue: 0,0:10:16.43,0:10:19.86,Default,,0,0,0,,Nashik mein Godavari kinare khudai shuru
Dialogue: 0,0:10:19.86,0:10:20.60,Default,,0,0,0,,hoti hai.
Dialogue: 0,0:10:20.60,0:10:22.80,Default,,0,0,0,,Team mein the Deccan College ke
Dialogue: 0,0:10:22.80,0:10:23.04,Default,,0,0,0,,H.D.
Dialogue: 0,0:10:23.04,0:10:24.27,Default,,0,0,0,,Sankalia aur S.B.
Dialogue: 0,0:10:24.27,0:10:24.51,Default,,0,0,0,,Deo.
Dialogue: 0,0:10:24.51,0:10:25.49,Default,,0,0,0,,Kya milta hai?
Dialogue: 0,0:10:25.94,0:10:27.71,Default,,0,0,0,,Taamba patthar yug ki parten,
Dialogue: 0,0:10:27.71,0:10:29.03,Default,,0,0,0,,yaani chalcolithic.
Dialogue: 0,0:10:29.03,0:10:30.80,Default,,0,0,0,,Woh daur jab insaan patthar ke
Dialogue: 0,0:10:30.80,0:10:33.23,Default,,0,0,0,,auzaaron ke saath taamba bhi istemaal
Dialogue: 0,0:10:33.23,0:10:34.11,Default,,0,0,0,,karne laga.
Dialogue: 0,0:10:34.11,0:10:36.98,Default,,0,0,0,,Uske upar shuruaati itihaas ke nishaan.
Dialogue: 0,0:10:37.43,0:10:40.38,Default,,0,0,0,,Matlab Nashik mein Godavari kinare bahut
Dialogue: 0,0:10:40.38,0:10:42.70,Default,,0,0,0,,purane zamane se log baste the.
Dialogue: 0,0:10:42.70,0:10:44.59,Default,,0,0,0,,Lekin ab ulta mod aata hai.
Dialogue: 0,0:10:44.59,0:10:45.64,Default,,0,0,0,,Wahi Sankalia,
Dialogue: 0,0:10:45.64,0:10:47.12,Default,,0,0,0,,jo Nashik khod chuke the.
Dialogue: 0,0:10:47.57,0:10:50.48,Default,,0,0,0,,Apni kitaab Ramayana in Historical Perspective
Dialogue: 0,0:10:50.48,0:10:52.48,Default,,0,0,0,,mein Sankalia bilkul alag baat kehte
Dialogue: 0,0:10:52.48,0:10:52.66,Default,,0,0,0,,hain.
Dialogue: 0,0:10:52.66,0:10:55.39,Default,,0,0,0,,Unke hisaab se Dandakaranya aur Panchavati
Dialogue: 0,0:10:55.39,0:10:57.03,Default,,0,0,0,,asal mein Madhya Bharat mein the.
Dialogue: 0,0:10:57.48,0:11:01.21,Default,,0,0,0,,Dandakaranya yaani Ramayan ka bada ghana
Dialogue: 0,0:11:01.21,0:11:01.75,Default,,0,0,0,,jungle.
Dialogue: 0,0:11:01.75,0:11:04.42,Default,,0,0,0,,Sankalia ne katha ke ped paudhe,
Dialogue: 0,0:11:04.42,0:11:06.29,Default,,0,0,0,,nadiyan aur bhoogol padha.
Dialogue: 0,0:11:06.29,0:11:07.09,Default,,0,0,0,,Aur kaha,
Dialogue: 0,0:11:07.09,0:11:09.49,Default,,0,0,0,,asli katha Vindhya ke aas paas
Dialogue: 0,0:11:09.49,0:11:10.29,Default,,0,0,0,,simti thi.
Dialogue: 0,0:11:10.74,0:11:12.90,Default,,0,0,0,,Unhone Ravan ki Lanka tak ko
Dialogue: 0,0:11:12.90,0:11:14.42,Default,,0,0,0,,Madhya Bharat mein rakha.
Dialogue: 0,0:11:14.42,0:11:16.15,Default,,0,0,0,,Aaj ke Sri Lanka mein nahi.
Dialogue: 0,0:11:16.15,0:11:18.53,Default,,0,0,0,,Lekin parampara aur kai scholars yeh
Dialogue: 0,0:11:18.53,0:11:19.62,Default,,0,0,0,,baat nahi maante.
Dialogue: 0,0:11:20.07,0:11:21.25,Default,,0,0,0,,Toh tasveer yeh bani.
Dialogue: 0,0:11:21.25,0:11:23.03,Default,,0,0,0,,Parampara kehti hai Nashik,
Dialogue: 0,0:11:23.03,0:11:23.83,Default,,0,0,0,,Godavari,
Dialogue: 0,0:11:23.83,0:11:24.62,Default,,0,0,0,,Panchavati.
Dialogue: 0,0:11:24.62,0:11:26.60,Default,,0,0,0,,Sankalia kehte hain Madhya Bharat,
Dialogue: 0,0:11:26.60,0:11:27.00,Default,,0,0,0,,Vindhya.
Dialogue: 0,0:11:27.00,0:11:27.59,Default,,0,0,0,,Aur faisla?
Dialogue: 0,0:11:27.59,0:11:29.37,Default,,0,0,0,,Abhi tak kisi ke paas nahi.
Dialogue: 0,0:11:29.82,0:11:31.50,Default,,0,0,0,,Ab baat un sawaalon ki,
Dialogue: 0,0:11:31.50,0:11:33.89,Default,,0,0,0,,jinka jawab abhi kisi ke paas
Dialogue: 0,0:11:33.89,0:11:34.37,Default,,0,0,0,,nahi.
Dialogue: 0,0:11:34.37,0:11:35.80,Default,,0,0,0,,Sabse bada sawaal.
Dialogue: 0,0:11:35.80,0:11:37.71,Default,,0,0,0,,Rekha ka khayal pehli baar kis
Dialogue: 0,0:11:37.71,0:11:38.67,Default,,0,0,0,,kavi ne diya?
Dialogue: 0,0:11:39.12,0:11:41.26,Default,,0,0,0,,Ho sakta hai kisi kathavachak ne
Dialogue: 0,0:11:41.26,0:11:42.62,Default,,0,0,0,,ise pehle bola ho.
Dialogue: 0,0:11:42.62,0:11:45.15,Default,,0,0,0,,Kathavachak yaani gaon gaon katha sunane
Dialogue: 0,0:11:45.15,0:11:45.54,Default,,0,0,0,,wala.
Dialogue: 0,0:11:45.54,0:11:46.91,Default,,0,0,0,,Likhne se bahut pehle.
Dialogue: 0,0:11:46.91,0:11:48.66,Default,,0,0,0,,Par uska naam kahin darj nahi.
Dialogue: 0,0:11:49.11,0:11:50.09,Default,,0,0,0,,Agla sawaal,
Dialogue: 0,0:11:50.09,0:11:52.52,Default,,0,0,0,,kya jungle ki yeh jagahein kisi
Dialogue: 0,0:11:52.52,0:11:54.48,Default,,0,0,0,,asli basti se judti hain?
Dialogue: 0,0:11:54.48,0:11:55.45,Default,,0,0,0,,Panchavati,
Dialogue: 0,0:11:55.45,0:11:56.67,Default,,0,0,0,,Sita ki kutiya,
Dialogue: 0,0:11:56.67,0:11:57.89,Default,,0,0,0,,Jatayu ka maidan.
Dialogue: 0,0:11:57.89,0:12:00.09,Default,,0,0,0,,Khudai abhi tak yeh jod nahi
Dialogue: 0,0:12:00.09,0:12:00.33,Default,,0,0,0,,paayi.
Dialogue: 0,0:12:00.78,0:12:01.76,Default,,0,0,0,,Aur yeh bhi samjhiye.
Dialogue: 0,0:12:01.76,0:12:03.34,Default,,0,0,0,,Valmiki mein rekha nahi,
Dialogue: 0,0:12:03.34,0:12:05.11,Default,,0,0,0,,iska matlab yeh nahi ki baad
Dialogue: 0,0:12:05.11,0:12:06.48,Default,,0,0,0,,ki katha kam keemti hai.
Dialogue: 0,0:12:06.48,0:12:08.45,Default,,0,0,0,,Har kavi ne apne zamane ke
Dialogue: 0,0:12:08.45,0:12:10.02,Default,,0,0,0,,logon ke liye katha kahi.
Dialogue: 0,0:12:10.47,0:12:13.31,Default,,0,0,0,,Ranganatha ne Telugu ghar ke liye
Dialogue: 0,0:12:13.31,0:12:13.83,Default,,0,0,0,,likha.
Dialogue: 0,0:12:13.83,0:12:15.90,Default,,0,0,0,,Krittivas ne Bengal ke liye,
Dialogue: 0,0:12:15.90,0:12:17.96,Default,,0,0,0,,Tulsidas ne Awadh ke liye.
Dialogue: 0,0:12:17.96,0:12:20.03,Default,,0,0,0,,Rekha har baar thodi badli,
Dialogue: 0,0:12:20.03,0:12:21.58,Default,,0,0,0,,par bhaav wahi raha.
Dialogue: 0,0:12:22.03,0:12:25.52,Default,,0,0,0,,Valmiki ke yahan suraksha prarthana thi,
Dialogue: 0,0:12:25.52,0:12:26.32,Default,,0,0,0,,devtaon se.
Dialogue: 0,0:12:26.32,0:12:28.74,Default,,0,0,0,,Baad ki kathaon mein wo prarthana
Dialogue: 0,0:12:28.74,0:12:31.15,Default,,0,0,0,,mitti par kheenchi lakeer ban gayi.
Dialogue: 0,0:12:31.15,0:12:31.95,Default,,0,0,0,,Shayad isliye,
Dialogue: 0,0:12:31.95,0:12:34.64,Default,,0,0,0,,kyunki lakeer aankhon se dikhti hai.
Dialogue: 0,0:12:35.09,0:12:36.62,Default,,0,0,0,,Toh aaj aap Nashik jaayein,
Dialogue: 0,0:12:36.62,0:12:37.90,Default,,0,0,0,,toh kya dekhenge?
Dialogue: 0,0:12:37.90,0:12:39.43,Default,,0,0,0,,Godavari ka ghaat,
Dialogue: 0,0:12:39.43,0:12:40.96,Default,,0,0,0,,mandiron ki ghantiyan,
Dialogue: 0,0:12:40.96,0:12:44.03,Default,,0,0,0,,aur Panchavati ke purane bargad ke
Dialogue: 0,0:12:44.03,0:12:44.28,Default,,0,0,0,,ped.
Dialogue: 0,0:12:44.28,0:12:46.07,Default,,0,0,0,,Subah ki aarti ke saath.
Dialogue: 0,0:12:46.52,0:12:48.47,Default,,0,0,0,,Bargad ke pedon ke paas hai
Dialogue: 0,0:12:48.47,0:12:49.45,Default,,0,0,0,,Sita Gufa.
Dialogue: 0,0:12:49.45,0:12:52.13,Default,,0,0,0,,Yaani zameen ke neeche bane chhote
Dialogue: 0,0:12:52.13,0:12:52.62,Default,,0,0,0,,kamre.
Dialogue: 0,0:12:52.62,0:12:54.57,Default,,0,0,0,,Andar jaane ke liye jhuk kar
Dialogue: 0,0:12:54.57,0:12:56.03,Default,,0,0,0,,utarna padta hai.
Dialogue: 0,0:12:56.49,0:12:58.64,Default,,0,0,0,,Sthaniya parampara kehti hai,
Dialogue: 0,0:12:58.64,0:13:01.04,Default,,0,0,0,,yahi woh jagah hai jahan Sita
Dialogue: 0,0:13:01.04,0:13:02.95,Default,,0,0,0,,haran se pehle rehti thin.
Dialogue: 0,0:13:02.95,0:13:04.15,Default,,0,0,0,,Yeh lok vishwas hai,
Dialogue: 0,0:13:04.15,0:13:05.83,Default,,0,0,0,,khudai ka saboot nahi.
Dialogue: 0,0:13:05.83,0:13:07.26,Default,,0,0,0,,Par shraddha gehri hai.
Dialogue: 0,0:13:07.71,0:13:10.00,Default,,0,0,0,,Aur jab aap wahan khade honge,
Dialogue: 0,0:13:10.00,0:13:11.52,Default,,0,0,0,,toh zara sochiyega.
Dialogue: 0,0:13:11.52,0:13:14.05,Default,,0,0,0,,Yahi Godavari ka kinara,
Dialogue: 0,0:13:14.05,0:13:17.61,Default,,0,0,0,,jiske paas 1950 mein archaeologist mitti
Dialogue: 0,0:13:17.61,0:13:18.62,Default,,0,0,0,,khod rahe the.
Dialogue: 0,0:13:18.62,0:13:19.89,Default,,0,0,0,,Aastha aur khudai,
Dialogue: 0,0:13:19.89,0:13:20.40,Default,,0,0,0,,saath saath,
Dialogue: 0,0:13:20.40,0:13:22.43,Default,,0,0,0,,isi nadi ke kinare.
Dialogue: 0,0:13:22.88,0:13:25.32,Default,,0,0,0,,Aur agar Sankalia sahi the,
Dialogue: 0,0:13:25.32,0:13:28.30,Default,,0,0,0,,toh asli Panchavati shayad Vindhya ke
Dialogue: 0,0:13:28.30,0:13:29.39,Default,,0,0,0,,jungle mein hai.
Dialogue: 0,0:13:29.39,0:13:32.10,Default,,0,0,0,,Jise abhi tak koi pehchaan nahi
Dialogue: 0,0:13:32.10,0:13:32.37,Default,,0,0,0,,paaya.
Dialogue: 0,0:13:32.37,0:13:32.91,Default,,0,0,0,,Socho,
Dialogue: 0,0:13:32.91,0:13:34.81,Default,,0,0,0,,kitna bada rahasya.
Dialogue: 0,0:13:35.26,0:13:37.08,Default,,0,0,0,,Toh shuru ka sawaal yaad hai?
Dialogue: 0,0:13:37.08,0:13:38.90,Default,,0,0,0,,Lakshman Rekha aayi kahan se?
Dialogue: 0,0:13:38.90,0:13:40.27,Default,,0,0,0,,Valmiki se nahi.
Dialogue: 0,0:13:40.27,0:13:41.87,Default,,0,0,0,,Madhyakaal ke kaviyon se,
Dialogue: 0,0:13:41.87,0:13:42.55,Default,,0,0,0,,Telugu,
Dialogue: 0,0:13:42.55,0:13:44.83,Default,,0,0,0,,Bangla aur Awadhi ke panno se.
Dialogue: 0,0:13:45.28,0:13:48.33,Default,,0,0,0,,Aur Valmiki ka asli scene isse
Dialogue: 0,0:13:48.33,0:13:49.44,Default,,0,0,0,,bhi gehra hai.
Dialogue: 0,0:13:49.44,0:13:49.71,Default,,0,0,0,,Darr,
Dialogue: 0,0:13:49.71,0:13:49.99,Default,,0,0,0,,shak,
Dialogue: 0,0:13:49.99,0:13:50.82,Default,,0,0,0,,kadve shabd,
Dialogue: 0,0:13:50.82,0:13:52.49,Default,,0,0,0,,aur bhai ka toota dil.
Dialogue: 0,0:13:52.49,0:13:54.43,Default,,0,0,0,,Koi jaadui deewar nahi,
Dialogue: 0,0:13:54.43,0:13:56.09,Default,,0,0,0,,sirf insaani rishte.
Dialogue: 0,0:13:56.54,0:13:59.39,Default,,0,0,0,,Agli video mein hum chalenge Sankalia
Dialogue: 0,0:13:59.39,0:14:01.29,Default,,0,0,0,,ke sabse bade sawaal par.
Dialogue: 0,0:14:01.29,0:14:02.48,Default,,0,0,0,,Ravan ki Lanka,
Dialogue: 0,0:14:02.48,0:14:03.90,Default,,0,0,0,,kya sach mein aaj ka Sri
Dialogue: 0,0:14:03.90,0:14:04.61,Default,,0,0,0,,Lanka thi?
Dialogue: 0,0:14:04.61,0:14:05.56,Default,,0,0,0,,Sabut ke saath.
Dialogue: 0,0:14:06.01,0:14:07.46,Default,,0,0,0,,Aur ab aapki baari,
Dialogue: 0,0:14:07.46,0:14:08.66,Default,,0,0,0,,comment mein bataiye.
Dialogue: 0,0:14:08.66,0:14:11.55,Default,,0,0,0,,Lakshman Rekha ki kahani aapne pehli
Dialogue: 0,0:14:11.55,0:14:12.75,Default,,0,0,0,,baar kisse suni?
Dialogue: 0,0:14:12.75,0:14:13.48,Default,,0,0,0,,Dadi se,
Dialogue: 0,0:14:13.48,0:14:14.20,Default,,0,0,0,,ya TV se?
Dialogue: 0,0:14:14.20,0:14:15.88,Default,,0,0,0,,Main har jawab padhunga.
