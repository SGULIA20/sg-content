Dialogue: 0,0:00:00.00,0:00:02.73,Default,,0,0,0,,Kailash par aaj tak koi kyon
Dialogue: 0,0:00:02.73,0:00:04.28,Default,,0,0,0,,nahi chadha,
Dialogue: 0,0:00:04.28,0:00:05.84,Default,,0,0,0,,rokta kaun hai?
Dialogue: 0,0:00:06.29,0:00:08.90,Default,,0,0,0,,Shiva Purana kehta hai,
Dialogue: 0,0:00:08.90,0:00:10.86,Default,,0,0,0,,Kailash Shiv ka ghar hai.
Dialogue: 0,0:00:10.86,0:00:11.84,Default,,0,0,0,,Wahan Shiv,
Dialogue: 0,0:00:11.84,0:00:14.45,Default,,0,0,0,,Parvati ke saath dhyan mein hain.
Dialogue: 0,0:00:14.90,0:00:16.97,Default,,0,0,0,,Skanda Purana mein,
Dialogue: 0,0:00:16.97,0:00:20.09,Default,,0,0,0,,darshan se paap aise sookhte hain,
Dialogue: 0,0:00:20.09,0:00:21.81,Default,,0,0,0,,jaise dhoop mein os.
Dialogue: 0,0:00:21.81,0:00:23.54,Default,,0,0,0,,Aur parikrama,
Dialogue: 0,0:00:23.54,0:00:27.00,Default,,0,0,0,,yaani pahad ke gird paidal chakkar,
Dialogue: 0,0:00:27.00,0:00:29.42,Default,,0,0,0,,sabse bada punya hai.
Dialogue: 0,0:00:29.87,0:00:32.44,Default,,0,0,0,,Tibet ki ek katha kehti hai,
Dialogue: 0,0:00:32.44,0:00:35.86,Default,,0,0,0,,sirf yogi Milarepa upar pahunche.
Dialogue: 0,0:00:35.86,0:00:38.71,Default,,0,0,0,,Suraj ki pehli kiran pakadkar.
Dialogue: 0,0:00:39.16,0:00:40.59,Default,,0,0,0,,Phir khoj shuru hui.
Dialogue: 0,0:00:40.59,0:00:44.61,Default,,0,0,0,,Sichuan University aur Tibet ke Cultural
Dialogue: 0,0:00:44.61,0:00:47.47,Default,,0,0,0,,Relics Bureau ne Ngari mein khudai
Dialogue: 0,0:00:47.47,0:00:47.76,Default,,0,0,0,,ki.
Dialogue: 0,0:00:48.21,0:00:52.00,Default,,0,0,0,,2001 tak Piyang-Donggar mein gufaon ka
Dialogue: 0,0:00:52.00,0:00:54.21,Default,,0,0,0,,poora basera mila.
Dialogue: 0,0:00:54.21,0:00:57.06,Default,,0,0,0,,Saath mein Buddh chitra aur purani
Dialogue: 0,0:00:57.06,0:00:57.69,Default,,0,0,0,,kabrein.
Dialogue: 0,0:00:58.14,0:00:59.70,Default,,0,0,0,,Kuch log kehte hain,
Dialogue: 0,0:00:59.70,0:01:02.51,Default,,0,0,0,,koi adrishya shakti rokti hai.
Dialogue: 0,0:01:02.51,0:01:06.88,Default,,0,0,0,,Par Reinhold Messner jaise parvatarohi kehte
Dialogue: 0,0:01:06.88,0:01:07.19,Default,,0,0,0,,hain,
Dialogue: 0,0:01:07.19,0:01:10.00,Default,,0,0,0,,6,638 metre ka pahad chadha ja
Dialogue: 0,0:01:10.00,0:01:10.94,Default,,0,0,0,,sakta hai.
Dialogue: 0,0:01:11.39,0:01:13.16,Default,,0,0,0,,Parampara kehti hai,
Dialogue: 0,0:01:13.16,0:01:13.66,Default,,0,0,0,,Sindhu,
Dialogue: 0,0:01:13.66,0:01:14.17,Default,,0,0,0,,Sutlej,
Dialogue: 0,0:01:14.17,0:01:17.70,Default,,0,0,0,,Brahmaputra aur Karnali Kailash se nikalti
Dialogue: 0,0:01:17.70,0:01:17.96,Default,,0,0,0,,hain.
Dialogue: 0,0:01:17.96,0:01:18.97,Default,,0,0,0,,Hydrologist,
Dialogue: 0,0:01:18.97,0:01:21.75,Default,,0,0,0,,yaani paani ke raaston ke vaigyanik,
Dialogue: 0,0:01:21.75,0:01:24.27,Default,,0,0,0,,srot alag ghatiyon mein batate hain.
Dialogue: 0,0:01:24.72,0:01:27.38,Default,,0,0,0,,Kuch lekhak ise kisi sabhyata ka
Dialogue: 0,0:01:27.38,0:01:29.31,Default,,0,0,0,,banaya pyramid kehte hain.
Dialogue: 0,0:01:29.31,0:01:30.04,Default,,0,0,0,,Geologist,
Dialogue: 0,0:01:30.04,0:01:32.21,Default,,0,0,0,,yaani chattanon ke vaigyanik,
Dialogue: 0,0:01:32.21,0:01:32.94,Default,,0,0,0,,kehte hain,
Dialogue: 0,0:01:32.94,0:01:34.87,Default,,0,0,0,,yeh qudrati chattanein hain,
Dialogue: 0,0:01:34.87,0:01:36.56,Default,,0,0,0,,barf ne inhe tarasha.
Dialogue: 0,0:01:37.01,0:01:38.42,Default,,0,0,0,,Toh rokta kaun hai?
Dialogue: 0,0:01:38.42,0:01:39.82,Default,,0,0,0,,Koi deewar nahi,
Dialogue: 0,0:01:39.82,0:01:40.39,Default,,0,0,0,,shraddha.
Dialogue: 0,0:01:40.39,0:01:43.20,Default,,0,0,0,,Pavitrata ke samman mein permit,
Dialogue: 0,0:01:43.20,0:01:45.45,Default,,0,0,0,,yaani sarkari ijazat,
Dialogue: 0,0:01:45.45,0:01:46.29,Default,,0,0,0,,hi band hai.
Dialogue: 0,0:01:46.74,0:01:48.82,Default,,0,0,0,,Aaj aap shikhar par nahi,
Dialogue: 0,0:01:48.82,0:01:50.30,Default,,0,0,0,,gird chal sakte hain.
Dialogue: 0,0:01:50.30,0:01:54.75,Default,,0,0,0,,Kailash Mansarovar Yatra mein wahi parikrama
Dialogue: 0,0:01:54.75,0:01:55.64,Default,,0,0,0,,hoti hai,
Dialogue: 0,0:01:55.64,0:01:58.02,Default,,0,0,0,,jo Skanda Purana mein hai.
Dialogue: 0,0:01:58.47,0:02:00.46,Default,,0,0,0,,Us dost ko bhejo jo kehta
Dialogue: 0,0:02:00.46,0:02:02.20,Default,,0,0,0,,hai Kailash par koi chadh hi
Dialogue: 0,0:02:02.20,0:02:03.19,Default,,0,0,0,,nahi sakta.
