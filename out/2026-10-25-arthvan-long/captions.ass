Dialogue: 0,0:00:00.00,0:00:02.29,Default,,0,0,0,,Rigveda ki sabse pavitra nadi aaj
Dialogue: 0,0:00:02.29,0:00:02.87,Default,,0,0,0,,kahan hai?
Dialogue: 0,0:00:02.87,0:00:04.58,Default,,0,0,0,,Registaan ke upar se dekho,
Dialogue: 0,0:00:04.58,0:00:05.73,Default,,0,0,0,,toh sirf ret dikhti hai.
Dialogue: 0,0:00:05.73,0:00:08.22,Default,,0,0,0,,Lekin ISRO ki satellite tasveeron mein,
Dialogue: 0,0:00:08.22,0:00:10.13,Default,,0,0,0,,ret ke neeche lakeerein dikhti hain.
Dialogue: 0,0:00:10.13,0:00:12.42,Default,,0,0,0,,Yeh lakeerein kisi purani nadi ke
Dialogue: 0,0:00:12.42,0:00:13.76,Default,,0,0,0,,raaste jaisi lagti hain.
Dialogue: 0,0:00:13.76,0:00:14.14,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:00:14.14,0:00:16.05,Default,,0,0,0,,sabut ke saath yeh kahani kholte
Dialogue: 0,0:00:16.05,0:00:16.24,Default,,0,0,0,,hain.
Dialogue: 0,0:00:16.69,0:00:17.16,Default,,0,0,0,,Socho,
Dialogue: 0,0:00:17.16,0:00:18.35,Default,,0,0,0,,aap aasmaan mein ho,
Dialogue: 0,0:00:18.35,0:00:21.20,Default,,0,0,0,,Haryana se Rajasthan aur Gujarat ki
Dialogue: 0,0:00:21.20,0:00:22.63,Default,,0,0,0,,taraf dekh rahe ho.
Dialogue: 0,0:00:22.63,0:00:23.58,Default,,0,0,0,,Neeche khet hain,
Dialogue: 0,0:00:23.58,0:00:24.05,Default,,0,0,0,,gaon hain,
Dialogue: 0,0:00:24.05,0:00:25.00,Default,,0,0,0,,registaan hai.
Dialogue: 0,0:00:25.00,0:00:27.14,Default,,0,0,0,,Par satellite ki aankh kuch aur
Dialogue: 0,0:00:27.14,0:00:28.09,Default,,0,0,0,,pakadti hai.
Dialogue: 0,0:00:28.09,0:00:30.23,Default,,0,0,0,,Zameen ke neeche dabi nami,
Dialogue: 0,0:00:30.23,0:00:32.60,Default,,0,0,0,,aur purani ret ki patli patteeyan,
Dialogue: 0,0:00:32.60,0:00:34.98,Default,,0,0,0,,jaise kisi ne pencil se nadi
Dialogue: 0,0:00:34.98,0:00:35.69,Default,,0,0,0,,kheench di ho.
Dialogue: 0,0:00:36.14,0:00:37.96,Default,,0,0,0,,Bahut purane granth kehte hain,
Dialogue: 0,0:00:37.96,0:00:40.18,Default,,0,0,0,,yahan kabhi badi nadi behti thi.
Dialogue: 0,0:00:40.18,0:00:41.80,Default,,0,0,0,,Uska naam tha Saraswati.
Dialogue: 0,0:00:41.80,0:00:44.83,Default,,0,0,0,,Rigveda use pavitra aur shaktishaali kehta
Dialogue: 0,0:00:44.83,0:00:45.03,Default,,0,0,0,,hai.
Dialogue: 0,0:00:45.03,0:00:46.85,Default,,0,0,0,,Aur Mahabharata kehta hai,
Dialogue: 0,0:00:46.85,0:00:48.67,Default,,0,0,0,,woh nadi registaan mein gayab ho
Dialogue: 0,0:00:48.67,0:00:48.87,Default,,0,0,0,,gayi.
Dialogue: 0,0:00:48.87,0:00:50.69,Default,,0,0,0,,Toh kya satellite ki lakeer,
Dialogue: 0,0:00:50.69,0:00:52.10,Default,,0,0,0,,wahi khoyi hui nadi hai?
Dialogue: 0,0:00:52.55,0:00:54.48,Default,,0,0,0,,Jawab itna seedha nahi hai.
Dialogue: 0,0:00:54.48,0:00:56.20,Default,,0,0,0,,Vaigyanik bhi bante hue hain,
Dialogue: 0,0:00:56.20,0:00:57.48,Default,,0,0,0,,aur itihaaskar bhi.
Dialogue: 0,0:00:57.48,0:00:58.56,Default,,0,0,0,,Kuch kehte hain haan,
Dialogue: 0,0:00:58.56,0:01:00.06,Default,,0,0,0,,yahi Saraswati hai.
Dialogue: 0,0:01:00.06,0:01:00.92,Default,,0,0,0,,Kuch kehte hain,
Dialogue: 0,0:01:00.92,0:01:02.20,Default,,0,0,0,,naam kahin aur se aaya.
Dialogue: 0,0:01:02.20,0:01:03.28,Default,,0,0,0,,Is video mein granth,
Dialogue: 0,0:01:03.28,0:01:04.14,Default,,0,0,0,,satellite,
Dialogue: 0,0:01:04.14,0:01:05.21,Default,,0,0,0,,khudai aur behas,
Dialogue: 0,0:01:05.21,0:01:06.92,Default,,0,0,0,,sab baari baari dekhenge.
Dialogue: 0,0:01:06.92,0:01:08.64,Default,,0,0,0,,Har baat ke saath uska label
Dialogue: 0,0:01:08.64,0:01:09.07,Default,,0,0,0,,hoga.
Dialogue: 0,0:01:09.52,0:01:11.07,Default,,0,0,0,,Pehle chaliye granth ke paas,
Dialogue: 0,0:01:11.07,0:01:13.73,Default,,0,0,0,,kyunki kahani wahin se shuru hoti
Dialogue: 0,0:01:13.73,0:01:13.95,Default,,0,0,0,,hai.
Dialogue: 0,0:01:13.95,0:01:16.83,Default,,0,0,0,,Rigveda duniya ke sabse purane granthon
Dialogue: 0,0:01:16.83,0:01:18.16,Default,,0,0,0,,mein gina jata hai.
Dialogue: 0,0:01:18.16,0:01:20.16,Default,,0,0,0,,Isme nadiyon ki tareef mein kai
Dialogue: 0,0:01:20.16,0:01:20.82,Default,,0,0,0,,mantra hain.
Dialogue: 0,0:01:20.82,0:01:22.37,Default,,0,0,0,,Aur isme ek sukta hai,
Dialogue: 0,0:01:22.37,0:01:24.37,Default,,0,0,0,,jo nadiyon ko naqshe ki tarah
Dialogue: 0,0:01:24.37,0:01:25.92,Default,,0,0,0,,line mein ginata hai.
Dialogue: 0,0:01:26.37,0:01:28.54,Default,,0,0,0,,Is sukta ka naam hai Nadistuti
Dialogue: 0,0:01:28.54,0:01:28.97,Default,,0,0,0,,sukta,
Dialogue: 0,0:01:28.97,0:01:30.49,Default,,0,0,0,,yaani nadiyon ki stuti,
Dialogue: 0,0:01:30.49,0:01:31.79,Default,,0,0,0,,unki tareef ka geet.
Dialogue: 0,0:01:31.79,0:01:33.95,Default,,0,0,0,,Isme nadiyan poorab se paschim ki
Dialogue: 0,0:01:33.95,0:01:35.25,Default,,0,0,0,,taraf ginayi gayi hain.
Dialogue: 0,0:01:35.25,0:01:36.12,Default,,0,0,0,,Pehle Ganga,
Dialogue: 0,0:01:36.12,0:01:36.99,Default,,0,0,0,,phir Yamuna,
Dialogue: 0,0:01:36.99,0:01:38.07,Default,,0,0,0,,phir Saraswati,
Dialogue: 0,0:01:38.07,0:01:38.94,Default,,0,0,0,,phir Shutudri,
Dialogue: 0,0:01:38.94,0:01:40.89,Default,,0,0,0,,jise aaj hum Sutlej kehte hain.
Dialogue: 0,0:01:40.89,0:01:42.19,Default,,0,0,0,,Matlab Saraswati,
Dialogue: 0,0:01:42.19,0:01:44.35,Default,,0,0,0,,Yamuna aur Sutlej ke beech kahin
Dialogue: 0,0:01:44.35,0:01:44.57,Default,,0,0,0,,thi.
Dialogue: 0,0:01:45.02,0:01:46.39,Default,,0,0,0,,Yeh chhoti baat nahi hai.
Dialogue: 0,0:01:46.39,0:01:47.96,Default,,0,0,0,,Granth sirf naam nahi le raha,
Dialogue: 0,0:01:47.96,0:01:49.53,Default,,0,0,0,,jagah bhi bata raha hai.
Dialogue: 0,0:01:49.53,0:01:50.91,Default,,0,0,0,,Aaj ke naqshe par dekho,
Dialogue: 0,0:01:50.91,0:01:52.67,Default,,0,0,0,,toh Yamuna aur Sutlej ke beech
Dialogue: 0,0:01:52.67,0:01:54.64,Default,,0,0,0,,Haryana ka ilaaka aata hai.
Dialogue: 0,0:01:54.64,0:01:56.01,Default,,0,0,0,,Aur wahi ilaaka hai,
Dialogue: 0,0:01:56.01,0:01:58.56,Default,,0,0,0,,jahan satellite ko purani nadi ki
Dialogue: 0,0:01:58.56,0:01:59.74,Default,,0,0,0,,lakeerein dikhti hain.
Dialogue: 0,0:01:59.74,0:02:01.90,Default,,0,0,0,,Yahin se kahani dilchasp hoti hai.
Dialogue: 0,0:02:02.35,0:02:05.06,Default,,0,0,0,,Rigveda ka ek aur mantra Saraswati
Dialogue: 0,0:02:05.06,0:02:07.55,Default,,0,0,0,,ko bahut badi nadi batata hai.
Dialogue: 0,0:02:07.55,0:02:08.45,Default,,0,0,0,,Woh kehta hai,
Dialogue: 0,0:02:08.45,0:02:11.16,Default,,0,0,0,,Saraswati pahadon se nikalti hai,
Dialogue: 0,0:02:11.16,0:02:13.42,Default,,0,0,0,,aur seedhe samundar tak jaati hai.
Dialogue: 0,0:02:13.42,0:02:15.45,Default,,0,0,0,,Raaste mein woh jeevon ko apne
Dialogue: 0,0:02:15.45,0:02:17.48,Default,,0,0,0,,doodh jaise paani se paalti hai.
Dialogue: 0,0:02:17.48,0:02:19.97,Default,,0,0,0,,Yaani yeh koi barsaati naala nahi,
Dialogue: 0,0:02:19.97,0:02:21.55,Default,,0,0,0,,poori behti nadi thi.
Dialogue: 0,0:02:22.00,0:02:24.85,Default,,0,0,0,,Ab aate hain Mahabharata par,
Dialogue: 0,0:02:24.85,0:02:27.13,Default,,0,0,0,,jo baad ka granth maana jata
Dialogue: 0,0:02:27.13,0:02:27.42,Default,,0,0,0,,hai.
Dialogue: 0,0:02:27.42,0:02:30.84,Default,,0,0,0,,Iske Shalya Parva mein Saraswati ki
Dialogue: 0,0:02:30.84,0:02:33.12,Default,,0,0,0,,kahani badal jaati hai.
Dialogue: 0,0:02:33.12,0:02:36.54,Default,,0,0,0,,Yahan nadi registaan mein pahunchkar sookh
Dialogue: 0,0:02:36.54,0:02:37.39,Default,,0,0,0,,jaati hai.
Dialogue: 0,0:02:37.39,0:02:40.24,Default,,0,0,0,,Zameen ke andar samaa jaati hai.
Dialogue: 0,0:02:40.24,0:02:41.95,Default,,0,0,0,,Jis jagah woh gayab hui,
Dialogue: 0,0:02:41.95,0:02:44.52,Default,,0,0,0,,us teerth ka naam hai Vinasana.
Dialogue: 0,0:02:44.97,0:02:46.92,Default,,0,0,0,,Vinasana ka matlab hi hai,
Dialogue: 0,0:02:46.92,0:02:48.22,Default,,0,0,0,,jahan kuch nasht ho jaye,
Dialogue: 0,0:02:48.22,0:02:48.87,Default,,0,0,0,,gayab ho jaye.
Dialogue: 0,0:02:48.87,0:02:51.03,Default,,0,0,0,,Granth mein iski wajah bhi kahani
Dialogue: 0,0:02:51.03,0:02:52.33,Default,,0,0,0,,ki tarah di gayi hai.
Dialogue: 0,0:02:52.33,0:02:52.98,Default,,0,0,0,,Toh socho,
Dialogue: 0,0:02:52.98,0:02:56.01,Default,,0,0,0,,Rigveda mein Saraswati pahad se samundar
Dialogue: 0,0:02:56.01,0:02:56.87,Default,,0,0,0,,tak behti hai.
Dialogue: 0,0:02:56.87,0:02:59.04,Default,,0,0,0,,Mahabharata tak aate aate,
Dialogue: 0,0:02:59.04,0:03:00.98,Default,,0,0,0,,woh registaan mein kho jaati hai.
Dialogue: 0,0:03:00.98,0:03:01.85,Default,,0,0,0,,Beech mein kya hua?
Dialogue: 0,0:03:02.30,0:03:03.68,Default,,0,0,0,,Granth ne sawaal diya,
Dialogue: 0,0:03:03.68,0:03:05.33,Default,,0,0,0,,ab vigyan ki baari.
Dialogue: 0,0:03:05.33,0:03:07.80,Default,,0,0,0,,Agar sach mein yahan nadi thi,
Dialogue: 0,0:03:07.80,0:03:10.55,Default,,0,0,0,,toh uske nishaan zameen mein bache
Dialogue: 0,0:03:10.55,0:03:11.10,Default,,0,0,0,,honge.
Dialogue: 0,0:03:11.10,0:03:12.75,Default,,0,0,0,,Nadi jab sookhti hai,
Dialogue: 0,0:03:12.75,0:03:15.23,Default,,0,0,0,,toh apna raasta chhod jaati hai.
Dialogue: 0,0:03:15.23,0:03:15.51,Default,,0,0,0,,Ret,
Dialogue: 0,0:03:15.51,0:03:16.06,Default,,0,0,0,,kankad,
Dialogue: 0,0:03:16.06,0:03:17.98,Default,,0,0,0,,aur neeche dabi nami.
Dialogue: 0,0:03:17.98,0:03:21.01,Default,,0,0,0,,Inhe dhoondhne ke liye vaigyanikon ne
Dialogue: 0,0:03:21.01,0:03:22.66,Default,,0,0,0,,aasmaan ki madad li.
Dialogue: 0,0:03:23.11,0:03:25.56,Default,,0,0,0,,Is tareeke ko remote sensing kehte
Dialogue: 0,0:03:25.56,0:03:25.77,Default,,0,0,0,,hain,
Dialogue: 0,0:03:25.77,0:03:26.59,Default,,0,0,0,,yaani door se,
Dialogue: 0,0:03:26.59,0:03:28.63,Default,,0,0,0,,satellite ki aankh se zameen ko
Dialogue: 0,0:03:28.63,0:03:29.04,Default,,0,0,0,,padhna.
Dialogue: 0,0:03:29.04,0:03:31.29,Default,,0,0,0,,Satellite sirf photo nahi kheenchta.
Dialogue: 0,0:03:31.29,0:03:31.91,Default,,0,0,0,,Woh nami,
Dialogue: 0,0:03:31.91,0:03:33.54,Default,,0,0,0,,mitti ka rang aur garmi bhi
Dialogue: 0,0:03:33.54,0:03:34.36,Default,,0,0,0,,pakadta hai.
Dialogue: 0,0:03:34.36,0:03:36.41,Default,,0,0,0,,Sookhi nadi ka purana raasta,
Dialogue: 0,0:03:36.41,0:03:38.05,Default,,0,0,0,,aas paas ki zameen se thoda
Dialogue: 0,0:03:38.05,0:03:39.07,Default,,0,0,0,,alag dikhta hai.
Dialogue: 0,0:03:39.52,0:03:42.27,Default,,0,0,0,,ISRO ke Regional Remote Sensing Service
Dialogue: 0,0:03:42.27,0:03:44.44,Default,,0,0,0,,Centre ke vaigyanikon ne yahi kiya.
Dialogue: 0,0:03:44.44,0:03:47.38,Default,,0,0,0,,Unhone Indian Remote Sensing satellite ke
Dialogue: 0,0:03:47.38,0:03:49.15,Default,,0,0,0,,Wide Field Sensor ka data liya.
Dialogue: 0,0:03:49.15,0:03:50.73,Default,,0,0,0,,Aur uttar-paschim Bharat mein,
Dialogue: 0,0:03:50.73,0:03:53.09,Default,,0,0,0,,zameen ke neeche dabe palaeochannels ka
Dialogue: 0,0:03:53.09,0:03:53.87,Default,,0,0,0,,naksha banaya.
Dialogue: 0,0:03:53.87,0:03:56.43,Default,,0,0,0,,Palaeochannel yaani purani nadi ka woh
Dialogue: 0,0:03:56.43,0:03:56.82,Default,,0,0,0,,raasta,
Dialogue: 0,0:03:56.82,0:03:58.00,Default,,0,0,0,,jo ab dab chuka hai.
Dialogue: 0,0:03:58.45,0:04:01.10,Default,,0,0,0,,Is sensor ki resolution thi 188
Dialogue: 0,0:04:01.10,0:04:01.54,Default,,0,0,0,,metre.
Dialogue: 0,0:04:01.54,0:04:04.41,Default,,0,0,0,,Resolution yaani tasveer ka sabse chhota
Dialogue: 0,0:04:04.41,0:04:04.85,Default,,0,0,0,,hissa,
Dialogue: 0,0:04:04.85,0:04:06.62,Default,,0,0,0,,zameen par kitna bada hai.
Dialogue: 0,0:04:06.62,0:04:09.04,Default,,0,0,0,,Matlab 188 metre se chhoti cheez
Dialogue: 0,0:04:09.04,0:04:10.37,Default,,0,0,0,,alag nahi dikhti.
Dialogue: 0,0:04:10.37,0:04:12.79,Default,,0,0,0,,Lekin nadi ke lambe raaste dekhne
Dialogue: 0,0:04:12.79,0:04:13.24,Default,,0,0,0,,ke liye,
Dialogue: 0,0:04:13.24,0:04:14.12,Default,,0,0,0,,yeh kaafi tha.
Dialogue: 0,0:04:14.12,0:04:15.66,Default,,0,0,0,,Aur tasveeron mein lambi,
Dialogue: 0,0:04:15.66,0:04:17.65,Default,,0,0,0,,chaudi lakeerein saaf ubhar aayi.
Dialogue: 0,0:04:18.10,0:04:20.06,Default,,0,0,0,,Par sirf aasmaan se dekhna kaafi
Dialogue: 0,0:04:20.06,0:04:20.50,Default,,0,0,0,,nahi.
Dialogue: 0,0:04:20.50,0:04:22.89,Default,,0,0,0,,Zameen par jaakar milana bhi padta
Dialogue: 0,0:04:22.89,0:04:23.11,Default,,0,0,0,,hai.
Dialogue: 0,0:04:23.11,0:04:25.29,Default,,0,0,0,,Haryana mein aaj bhi Sarsuti naam
Dialogue: 0,0:04:25.29,0:04:27.24,Default,,0,0,0,,ki ek chhoti dhaara behti hai.
Dialogue: 0,0:04:27.24,0:04:28.33,Default,,0,0,0,,Yeh mausami hai,
Dialogue: 0,0:04:28.33,0:04:30.29,Default,,0,0,0,,yaani sirf baarish ke mausam mein
Dialogue: 0,0:04:30.29,0:04:31.38,Default,,0,0,0,,paani laati hai.
Dialogue: 0,0:04:31.38,0:04:32.03,Default,,0,0,0,,Naam suniye,
Dialogue: 0,0:04:32.03,0:04:32.69,Default,,0,0,0,,Sarsuti,
Dialogue: 0,0:04:32.69,0:04:35.30,Default,,0,0,0,,Saraswati se kitna milta julta hai.
Dialogue: 0,0:04:35.75,0:04:37.08,Default,,0,0,0,,Saal 2009 mein,
Dialogue: 0,0:04:37.08,0:04:39.73,Default,,0,0,0,,ISRO ke vaigyanikon ka adhyayan Journal
Dialogue: 0,0:04:39.73,0:04:42.39,Default,,0,0,0,,of the Geological Society of India
Dialogue: 0,0:04:42.39,0:04:43.05,Default,,0,0,0,,mein chhapa.
Dialogue: 0,0:04:43.05,0:04:46.15,Default,,0,0,0,,Isme satellite tasveerein aur zameeni jaanch,
Dialogue: 0,0:04:46.15,0:04:47.48,Default,,0,0,0,,dono saath rakhi gayi.
Dialogue: 0,0:04:47.48,0:04:49.25,Default,,0,0,0,,Nateeja yeh tha ki aaj ki
Dialogue: 0,0:04:49.25,0:04:50.35,Default,,0,0,0,,Sarsuti dhaara,
Dialogue: 0,0:04:50.35,0:04:52.56,Default,,0,0,0,,us bade dabe hue nadi network
Dialogue: 0,0:04:52.56,0:04:53.45,Default,,0,0,0,,se judti hai.
Dialogue: 0,0:04:53.45,0:04:56.55,Default,,0,0,0,,Usi network ko unhone Vedic Saraswati
Dialogue: 0,0:04:56.55,0:04:56.99,Default,,0,0,0,,kaha.
Dialogue: 0,0:04:57.44,0:04:59.15,Default,,0,0,0,,Phir aaya Central Ground Water Board,
Dialogue: 0,0:04:59.15,0:05:01.07,Default,,0,0,0,,jo desh ke zameeni paani ka
Dialogue: 0,0:05:01.07,0:05:02.13,Default,,0,0,0,,hisaab rakhta hai.
Dialogue: 0,0:05:02.13,0:05:04.27,Default,,0,0,0,,Unhone in raaston par drilling ki,
Dialogue: 0,0:05:04.27,0:05:06.40,Default,,0,0,0,,yaani zameen mein gehre ched karke
Dialogue: 0,0:05:06.40,0:05:06.83,Default,,0,0,0,,jaancha.
Dialogue: 0,0:05:06.83,0:05:09.17,Default,,0,0,0,,Neeche gehre meethe paani ke bhandaar
Dialogue: 0,0:05:09.17,0:05:09.60,Default,,0,0,0,,mile.
Dialogue: 0,0:05:09.60,0:05:11.31,Default,,0,0,0,,Inhe aquifer kehte hain,
Dialogue: 0,0:05:11.31,0:05:13.44,Default,,0,0,0,,yaani zameen ke andar paani se
Dialogue: 0,0:05:13.44,0:05:15.36,Default,,0,0,0,,bhari ret aur patthar ki parat.
Dialogue: 0,0:05:15.81,0:05:17.09,Default,,0,0,0,,Aur sabse dilchasp baat.
Dialogue: 0,0:05:17.09,0:05:19.86,Default,,0,0,0,,Is purani nadi ke kinare kinare,
Dialogue: 0,0:05:19.86,0:05:22.42,Default,,0,0,0,,kai Harappan bastiyon ke khandahar milte
Dialogue: 0,0:05:22.42,0:05:22.63,Default,,0,0,0,,hain.
Dialogue: 0,0:05:22.63,0:05:25.19,Default,,0,0,0,,Harappan yaani Sindhu ghaati sabhyata,
Dialogue: 0,0:05:25.19,0:05:27.96,Default,,0,0,0,,Bharat ki sabse purani shehri sabhyata.
Dialogue: 0,0:05:27.96,0:05:29.88,Default,,0,0,0,,Log hamesha nadi ke paas hi
Dialogue: 0,0:05:29.88,0:05:30.73,Default,,0,0,0,,basate hain.
Dialogue: 0,0:05:30.73,0:05:32.65,Default,,0,0,0,,Toh yeh khandahar batate hain,
Dialogue: 0,0:05:32.65,0:05:34.57,Default,,0,0,0,,kabhi yahan bharpoor paani tha.
Dialogue: 0,0:05:35.02,0:05:36.54,Default,,0,0,0,,Toh ab tak ki tasveer kuch
Dialogue: 0,0:05:36.54,0:05:37.20,Default,,0,0,0,,aisi hai.
Dialogue: 0,0:05:37.20,0:05:38.07,Default,,0,0,0,,Granth kehte hain,
Dialogue: 0,0:05:38.07,0:05:40.68,Default,,0,0,0,,Yamuna aur Sutlej ke beech Saraswati
Dialogue: 0,0:05:40.68,0:05:40.90,Default,,0,0,0,,thi.
Dialogue: 0,0:05:40.90,0:05:43.73,Default,,0,0,0,,Satellite wahan dabi nadi ke raaste
Dialogue: 0,0:05:43.73,0:05:44.60,Default,,0,0,0,,dikhata hai.
Dialogue: 0,0:05:44.60,0:05:47.22,Default,,0,0,0,,Drilling neeche meetha paani dikhati hai.
Dialogue: 0,0:05:47.22,0:05:49.83,Default,,0,0,0,,Aur kinare par purani bastiyan milti
Dialogue: 0,0:05:49.83,0:05:50.05,Default,,0,0,0,,hain.
Dialogue: 0,0:05:50.05,0:05:51.79,Default,,0,0,0,,Lagta hai kahani khatam.
Dialogue: 0,0:05:51.79,0:05:53.97,Default,,0,0,0,,Par asli behas yahin se shuru
Dialogue: 0,0:05:53.97,0:05:54.62,Default,,0,0,0,,hoti hai.
Dialogue: 0,0:05:55.07,0:05:57.65,Default,,0,0,0,,Vigyan mein akela sabut kaafi nahi
Dialogue: 0,0:05:57.65,0:05:58.08,Default,,0,0,0,,hota.
Dialogue: 0,0:05:58.08,0:05:59.80,Default,,0,0,0,,Yahan purani nadi thi,
Dialogue: 0,0:05:59.80,0:06:01.52,Default,,0,0,0,,yeh toh zyaadatar maante hain.
Dialogue: 0,0:06:01.52,0:06:04.31,Default,,0,0,0,,Par kya yahi Rigveda wali Saraswati
Dialogue: 0,0:06:04.31,0:06:04.53,Default,,0,0,0,,thi?
Dialogue: 0,0:06:04.53,0:06:05.39,Default,,0,0,0,,Aur agar thi,
Dialogue: 0,0:06:05.39,0:06:06.89,Default,,0,0,0,,toh kya woh sach mein pahad
Dialogue: 0,0:06:06.89,0:06:09.26,Default,,0,0,0,,se samundar tak behti mahaan nadi
Dialogue: 0,0:06:09.26,0:06:09.47,Default,,0,0,0,,thi?
Dialogue: 0,0:06:09.47,0:06:11.19,Default,,0,0,0,,Yahan experts bant jaate hain.
Dialogue: 0,0:06:11.64,0:06:13.45,Default,,0,0,0,,Pehli behas paani ke srot ki
Dialogue: 0,0:06:13.45,0:06:13.65,Default,,0,0,0,,hai.
Dialogue: 0,0:06:13.65,0:06:15.06,Default,,0,0,0,,Kuch vaigyanik kehte hain,
Dialogue: 0,0:06:15.06,0:06:17.07,Default,,0,0,0,,is nadi mein Himalaya ke glacier
Dialogue: 0,0:06:17.07,0:06:18.27,Default,,0,0,0,,ka paani aata tha.
Dialogue: 0,0:06:18.27,0:06:20.48,Default,,0,0,0,,Glacier yaani pahadon par jami barf
Dialogue: 0,0:06:20.48,0:06:21.08,Default,,0,0,0,,ki nadi,
Dialogue: 0,0:06:21.08,0:06:22.89,Default,,0,0,0,,jo dheere dheere pighalti hai.
Dialogue: 0,0:06:22.89,0:06:23.90,Default,,0,0,0,,Doosre kehte hain,
Dialogue: 0,0:06:23.90,0:06:25.91,Default,,0,0,0,,Bronze Age yaani Kaanse ke yug
Dialogue: 0,0:06:25.91,0:06:26.11,Default,,0,0,0,,mein,
Dialogue: 0,0:06:26.11,0:06:27.72,Default,,0,0,0,,yeh sirf monsoon ki baarish se
Dialogue: 0,0:06:27.72,0:06:28.32,Default,,0,0,0,,bharti thi.
Dialogue: 0,0:06:28.77,0:06:29.38,Default,,0,0,0,,Fark samjhiye.
Dialogue: 0,0:06:29.38,0:06:31.42,Default,,0,0,0,,Glacier wali nadi garmi mein bhi
Dialogue: 0,0:06:31.42,0:06:32.03,Default,,0,0,0,,behti hai,
Dialogue: 0,0:06:32.03,0:06:33.67,Default,,0,0,0,,aasaani se nahi sookhti.
Dialogue: 0,0:06:33.67,0:06:35.91,Default,,0,0,0,,Baarish wali nadi monsoon mein bharti
Dialogue: 0,0:06:35.91,0:06:36.11,Default,,0,0,0,,hai,
Dialogue: 0,0:06:36.11,0:06:37.95,Default,,0,0,0,,aur baaki mausam mein patli ho
Dialogue: 0,0:06:37.95,0:06:38.56,Default,,0,0,0,,jaati hai.
Dialogue: 0,0:06:38.56,0:06:39.79,Default,,0,0,0,,Toh sawaal yeh bana,
Dialogue: 0,0:06:39.79,0:06:41.83,Default,,0,0,0,,Harappan log kis tarah ki nadi
Dialogue: 0,0:06:41.83,0:06:43.25,Default,,0,0,0,,ke kinare rehte the?
Dialogue: 0,0:06:43.25,0:06:45.09,Default,,0,0,0,,Iska jawab ek research ne diya.
Dialogue: 0,0:06:45.54,0:06:48.20,Default,,0,0,0,,Yeh research Nature Communications naam ke
Dialogue: 0,0:06:48.20,0:06:49.85,Default,,0,0,0,,vaigyanik journal mein chhapi.
Dialogue: 0,0:06:49.85,0:06:52.51,Default,,0,0,0,,Isme geomorphology ka sahara liya gaya,
Dialogue: 0,0:06:52.51,0:06:54.97,Default,,0,0,0,,yaani zameen ki banawat padhkar uska
Dialogue: 0,0:06:54.97,0:06:56.20,Default,,0,0,0,,itihaas samajhna.
Dialogue: 0,0:06:56.20,0:06:57.43,Default,,0,0,0,,Saath mein dating bhi hui,
Dialogue: 0,0:06:57.43,0:06:59.27,Default,,0,0,0,,yaani ret kitni purani hai,
Dialogue: 0,0:06:59.27,0:07:00.71,Default,,0,0,0,,uska vigyan se hisaab.
Dialogue: 0,0:07:00.71,0:07:02.35,Default,,0,0,0,,Aur pata kiya ki Sutlej is
Dialogue: 0,0:07:02.35,0:07:03.58,Default,,0,0,0,,raaste se kab hati.
Dialogue: 0,0:07:04.03,0:07:06.75,Default,,0,0,0,,Nateeja chaunkane wala tha.
Dialogue: 0,0:07:06.75,0:07:09.46,Default,,0,0,0,,Sutlej lagbhag 8,000 saal pehle tak,
Dialogue: 0,0:07:09.46,0:07:12.18,Default,,0,0,0,,Ghaggar ke raaste se hat chuki
Dialogue: 0,0:07:12.18,0:07:12.48,Default,,0,0,0,,thi.
Dialogue: 0,0:07:12.48,0:07:16.10,Default,,0,0,0,,Yaani Harappan shehar basne se kaafi
Dialogue: 0,0:07:16.10,0:07:16.70,Default,,0,0,0,,pehle.
Dialogue: 0,0:07:16.70,0:07:18.82,Default,,0,0,0,,Matlab jab shehar bane,
Dialogue: 0,0:07:18.82,0:07:21.53,Default,,0,0,0,,tab is raaste mein badi Sutlej
Dialogue: 0,0:07:21.53,0:07:23.04,Default,,0,0,0,,nahi behti thi.
Dialogue: 0,0:07:23.04,0:07:26.66,Default,,0,0,0,,Shehar uske chhode hue purane raaste
Dialogue: 0,0:07:26.66,0:07:27.87,Default,,0,0,0,,par base the.
Dialogue: 0,0:07:28.32,0:07:29.89,Default,,0,0,0,,Doosri behas naam ki hai.
Dialogue: 0,0:07:29.89,0:07:30.79,Default,,0,0,0,,Ghaggar-Hakra,
Dialogue: 0,0:07:30.79,0:07:33.48,Default,,0,0,0,,yaani Haryana se Rajasthan ki taraf
Dialogue: 0,0:07:33.48,0:07:35.49,Default,,0,0,0,,jaane wali yeh sookhi nadi.
Dialogue: 0,0:07:35.49,0:07:38.18,Default,,0,0,0,,Kya isi ko Rigveda ne Saraswati
Dialogue: 0,0:07:38.18,0:07:38.63,Default,,0,0,0,,kaha?
Dialogue: 0,0:07:38.63,0:07:41.32,Default,,0,0,0,,Itihaaskar Romila Thapar kehti hain,
Dialogue: 0,0:07:41.32,0:07:42.89,Default,,0,0,0,,yeh pehchaan vivaadit hai,
Dialogue: 0,0:07:42.89,0:07:45.36,Default,,0,0,0,,yaani pakki nahi maani ja sakti.
Dialogue: 0,0:07:45.36,0:07:47.38,Default,,0,0,0,,Unke hisaab se is par abhi
Dialogue: 0,0:07:47.38,0:07:48.72,Default,,0,0,0,,kai sawaal baaki hain.
Dialogue: 0,0:07:49.17,0:07:51.58,Default,,0,0,0,,Vaigyanik aur lekhak Rajesh Kochhar alag
Dialogue: 0,0:07:51.58,0:07:52.38,Default,,0,0,0,,baat kehte hain.
Dialogue: 0,0:07:52.38,0:07:54.39,Default,,0,0,0,,Unki kitaab The Vedic People mein
Dialogue: 0,0:07:54.39,0:07:54.80,Default,,0,0,0,,tark hai,
Dialogue: 0,0:07:54.80,0:07:57.61,Default,,0,0,0,,ki shuruaati Saraswati shayad Afghanistan ki
Dialogue: 0,0:07:57.61,0:07:58.61,Default,,0,0,0,,Helmand nadi thi.
Dialogue: 0,0:07:58.61,0:08:00.82,Default,,0,0,0,,Wahan ke ilaake ka purana naam
Dialogue: 0,0:08:00.82,0:08:01.83,Default,,0,0,0,,Haraxvati tha.
Dialogue: 0,0:08:01.83,0:08:03.64,Default,,0,0,0,,Haraxvati aur Saraswati,
Dialogue: 0,0:08:03.64,0:08:05.85,Default,,0,0,0,,dono shabd kaafi milte julte sunai
Dialogue: 0,0:08:05.85,0:08:06.45,Default,,0,0,0,,dete hain.
Dialogue: 0,0:08:06.90,0:08:08.94,Default,,0,0,0,,Is soch mein ek shabd aata
Dialogue: 0,0:08:08.94,0:08:09.23,Default,,0,0,0,,hai,
Dialogue: 0,0:08:09.23,0:08:10.10,Default,,0,0,0,,toponym,
Dialogue: 0,0:08:10.10,0:08:13.02,Default,,0,0,0,,yaani kisi jagah ya nadi ka
Dialogue: 0,0:08:13.02,0:08:13.31,Default,,0,0,0,,naam.
Dialogue: 0,0:08:13.31,0:08:15.64,Default,,0,0,0,,Kochhar ke tark ke hisaab se
Dialogue: 0,0:08:15.64,0:08:17.38,Default,,0,0,0,,log jab aage badhe,
Dialogue: 0,0:08:17.38,0:08:19.13,Default,,0,0,0,,toh naam bhi saath le aaye.
Dialogue: 0,0:08:19.13,0:08:21.46,Default,,0,0,0,,Jaise aaj log naye shehar mein
Dialogue: 0,0:08:21.46,0:08:24.67,Default,,0,0,0,,purane mohalle ka naam rakh dete
Dialogue: 0,0:08:24.67,0:08:24.96,Default,,0,0,0,,hain.
Dialogue: 0,0:08:24.96,0:08:28.16,Default,,0,0,0,,Doosri taraf ISRO ke adhyayan wale
Dialogue: 0,0:08:28.16,0:08:29.03,Default,,0,0,0,,vaigyanik,
Dialogue: 0,0:08:29.03,0:08:32.82,Default,,0,0,0,,Ghaggar-Hakra ko hi Saraswati jodte hain.
Dialogue: 0,0:08:33.27,0:08:34.44,Default,,0,0,0,,Toh kya pata hai,
Dialogue: 0,0:08:34.44,0:08:35.38,Default,,0,0,0,,aur kya nahi?
Dialogue: 0,0:08:35.38,0:08:37.95,Default,,0,0,0,,Pata hai ki yahan purani nadi
Dialogue: 0,0:08:37.95,0:08:38.88,Default,,0,0,0,,ke raaste hain.
Dialogue: 0,0:08:38.88,0:08:41.23,Default,,0,0,0,,Pata hai ki neeche meetha paani
Dialogue: 0,0:08:41.23,0:08:41.46,Default,,0,0,0,,hai.
Dialogue: 0,0:08:41.46,0:08:43.33,Default,,0,0,0,,Lekin yeh nadi theek kab aur
Dialogue: 0,0:08:43.33,0:08:44.03,Default,,0,0,0,,kyun sookhi,
Dialogue: 0,0:08:44.03,0:08:47.07,Default,,0,0,0,,iska pakka timeline abhi kisi ke
Dialogue: 0,0:08:47.07,0:08:47.78,Default,,0,0,0,,paas nahi.
Dialogue: 0,0:08:47.78,0:08:50.12,Default,,0,0,0,,Kuch bade sawaal abhi bhi khule
Dialogue: 0,0:08:50.12,0:08:50.35,Default,,0,0,0,,hain.
Dialogue: 0,0:08:50.80,0:08:52.04,Default,,0,0,0,,Shuruaat tectonics se.
Dialogue: 0,0:08:52.04,0:08:54.31,Default,,0,0,0,,Tectonics yaani zameen ke neeche ki
Dialogue: 0,0:08:54.31,0:08:56.37,Default,,0,0,0,,plates ka dheere dheere khisakna.
Dialogue: 0,0:08:56.37,0:08:58.64,Default,,0,0,0,,Jab zameen thodi upar neeche hoti
Dialogue: 0,0:08:58.64,0:08:58.85,Default,,0,0,0,,hai,
Dialogue: 0,0:08:58.85,0:09:01.12,Default,,0,0,0,,toh nadiyan apna raasta badal leti
Dialogue: 0,0:09:01.12,0:09:01.32,Default,,0,0,0,,hain.
Dialogue: 0,0:09:01.32,0:09:03.18,Default,,0,0,0,,Kya kisi aisi halchal ne is
Dialogue: 0,0:09:03.18,0:09:05.04,Default,,0,0,0,,nadi ke paani ko kahin aur
Dialogue: 0,0:09:05.04,0:09:05.45,Default,,0,0,0,,mod diya?
Dialogue: 0,0:09:05.45,0:09:07.72,Default,,0,0,0,,Iska theek samay abhi pakka nahi.
Dialogue: 0,0:09:08.17,0:09:10.86,Default,,0,0,0,,Phir sawaal nadiyon ke mudne ka.
Dialogue: 0,0:09:10.86,0:09:13.55,Default,,0,0,0,,Sutlej ke hatne par research aa
Dialogue: 0,0:09:13.55,0:09:14.44,Default,,0,0,0,,chuki hai.
Dialogue: 0,0:09:14.44,0:09:17.43,Default,,0,0,0,,Lekin Yamuna ka raasta kab aur
Dialogue: 0,0:09:17.43,0:09:18.63,Default,,0,0,0,,kaise badla,
Dialogue: 0,0:09:18.63,0:09:21.61,Default,,0,0,0,,yeh abhi poori tarah saaf nahi.
Dialogue: 0,0:09:21.61,0:09:22.21,Default,,0,0,0,,Socho,
Dialogue: 0,0:09:22.21,0:09:25.79,Default,,0,0,0,,agar kabhi Sutlej aur Yamuna dono
Dialogue: 0,0:09:25.79,0:09:28.18,Default,,0,0,0,,is taraf paani deti thi,
Dialogue: 0,0:09:28.18,0:09:30.58,Default,,0,0,0,,toh yeh sach mein badi nadi
Dialogue: 0,0:09:30.58,0:09:31.77,Default,,0,0,0,,rahi hogi.
Dialogue: 0,0:09:32.22,0:09:33.12,Default,,0,0,0,,Aur aakhir mein,
Dialogue: 0,0:09:33.12,0:09:34.23,Default,,0,0,0,,mausam ka sawaal.
Dialogue: 0,0:09:34.23,0:09:37.82,Default,,0,0,0,,Aridification yaani kisi ilaake ka dheere
Dialogue: 0,0:09:37.82,0:09:40.28,Default,,0,0,0,,dheere sookha aur registaan jaisa ho
Dialogue: 0,0:09:40.28,0:09:40.73,Default,,0,0,0,,jaana.
Dialogue: 0,0:09:40.73,0:09:41.84,Default,,0,0,0,,Monsoon kamzor hua,
Dialogue: 0,0:09:41.84,0:09:44.31,Default,,0,0,0,,toh baarish wali nadiyan patli padti
Dialogue: 0,0:09:44.31,0:09:44.53,Default,,0,0,0,,gayi.
Dialogue: 0,0:09:44.53,0:09:46.54,Default,,0,0,0,,Kya yahi is nadi ke sookhne
Dialogue: 0,0:09:46.54,0:09:47.89,Default,,0,0,0,,ki asli wajah thi?
Dialogue: 0,0:09:47.89,0:09:49.45,Default,,0,0,0,,Ya tectonics aur mausam,
Dialogue: 0,0:09:49.45,0:09:51.02,Default,,0,0,0,,dono ne milkar yeh kiya?
Dialogue: 0,0:09:51.47,0:09:53.12,Default,,0,0,0,,Ab sabse practical baat.
Dialogue: 0,0:09:53.12,0:09:55.48,Default,,0,0,0,,Agar aap yeh kahani khud dekhna
Dialogue: 0,0:09:55.48,0:09:56.19,Default,,0,0,0,,chahte ho,
Dialogue: 0,0:09:56.19,0:09:57.37,Default,,0,0,0,,toh kahan jaaoge?
Dialogue: 0,0:09:57.37,0:09:59.50,Default,,0,0,0,,Achhi khabar yeh hai ki iske
Dialogue: 0,0:09:59.50,0:10:01.38,Default,,0,0,0,,nishaan aaj bhi zameen par hain.
Dialogue: 0,0:10:01.38,0:10:03.27,Default,,0,0,0,,Bas aankh thodi dhyaan se kholni
Dialogue: 0,0:10:03.27,0:10:03.98,Default,,0,0,0,,padegi.
Dialogue: 0,0:10:03.98,0:10:04.45,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:10:04.45,0:10:05.87,Default,,0,0,0,,naqshe par chalte hain.
Dialogue: 0,0:10:06.32,0:10:08.68,Default,,0,0,0,,Haryana mein Sarsuti dhaara ke kinare
Dialogue: 0,0:10:08.68,0:10:09.05,Default,,0,0,0,,chaliye.
Dialogue: 0,0:10:09.05,0:10:10.87,Default,,0,0,0,,Monsoon ke baad isme paani dikhta
Dialogue: 0,0:10:10.87,0:10:11.05,Default,,0,0,0,,hai,
Dialogue: 0,0:10:11.05,0:10:11.78,Default,,0,0,0,,garmi mein ret.
Dialogue: 0,0:10:11.78,0:10:13.05,Default,,0,0,0,,Gaon ke log ise aaj bhi
Dialogue: 0,0:10:13.05,0:10:14.51,Default,,0,0,0,,Saraswati se jodte hain.
Dialogue: 0,0:10:14.51,0:10:15.60,Default,,0,0,0,,Yahi woh dhaara hai,
Dialogue: 0,0:10:15.60,0:10:17.60,Default,,0,0,0,,jise ISRO ke adhyayan ne purane
Dialogue: 0,0:10:17.60,0:10:19.06,Default,,0,0,0,,dabe network se joda tha.
Dialogue: 0,0:10:19.06,0:10:19.97,Default,,0,0,0,,Chhoti si dhaara,
Dialogue: 0,0:10:19.97,0:10:21.24,Default,,0,0,0,,lekin kahani badi.
Dialogue: 0,0:10:21.69,0:10:23.78,Default,,0,0,0,,Phir Rajasthan ki taraf Ghaggar ka
Dialogue: 0,0:10:23.78,0:10:24.20,Default,,0,0,0,,chauda,
Dialogue: 0,0:10:24.20,0:10:25.24,Default,,0,0,0,,sookha paat dekhiye.
Dialogue: 0,0:10:25.24,0:10:27.12,Default,,0,0,0,,Paat yaani nadi ka woh tala,
Dialogue: 0,0:10:27.12,0:10:29.00,Default,,0,0,0,,jisme kabhi paani behta tha.
Dialogue: 0,0:10:29.00,0:10:30.88,Default,,0,0,0,,Kai jagah yeh itna chauda hai,
Dialogue: 0,0:10:30.88,0:10:32.97,Default,,0,0,0,,ki chhoti nadi ka nahi lagta.
Dialogue: 0,0:10:32.97,0:10:35.06,Default,,0,0,0,,Aas paas Harappan bastiyon ke tile
Dialogue: 0,0:10:35.06,0:10:35.69,Default,,0,0,0,,milte hain,
Dialogue: 0,0:10:35.69,0:10:37.36,Default,,0,0,0,,yaani mitti ke unche dher,
Dialogue: 0,0:10:37.36,0:10:38.61,Default,,0,0,0,,jahan khudai hui hai.
Dialogue: 0,0:10:39.06,0:10:40.54,Default,,0,0,0,,Aur ab aastha ki jagah,
Dialogue: 0,0:10:40.54,0:10:42.23,Default,,0,0,0,,Prayagraj ka Triveni Sangam.
Dialogue: 0,0:10:42.23,0:10:44.55,Default,,0,0,0,,Yahan Ganga aur Yamuna milti hain,
Dialogue: 0,0:10:44.55,0:10:46.03,Default,,0,0,0,,yeh aankhon se dikhta hai.
Dialogue: 0,0:10:46.03,0:10:47.72,Default,,0,0,0,,Lok parampara kehti hai,
Dialogue: 0,0:10:47.72,0:10:49.83,Default,,0,0,0,,Saraswati bhi yahin milti hai,
Dialogue: 0,0:10:49.83,0:10:51.31,Default,,0,0,0,,lekin zameen ke neeche,
Dialogue: 0,0:10:51.31,0:10:52.36,Default,,0,0,0,,adrishya roop mein.
Dialogue: 0,0:10:52.36,0:10:53.21,Default,,0,0,0,,Yeh legend hai,
Dialogue: 0,0:10:53.21,0:10:54.90,Default,,0,0,0,,iska koi lekhit srot nahi,
Dialogue: 0,0:10:54.90,0:10:57.01,Default,,0,0,0,,par bahut logon ki gehri aastha
Dialogue: 0,0:10:57.01,0:10:57.22,Default,,0,0,0,,hai.
Dialogue: 0,0:10:57.67,0:10:58.36,Default,,0,0,0,,Dhyaan dijiye,
Dialogue: 0,0:10:58.36,0:11:01.09,Default,,0,0,0,,yeh lok kahani Mahabharata ki baat
Dialogue: 0,0:11:01.09,0:11:02.01,Default,,0,0,0,,se judti hai.
Dialogue: 0,0:11:02.01,0:11:02.92,Default,,0,0,0,,Granth kehta hai,
Dialogue: 0,0:11:02.92,0:11:06.12,Default,,0,0,0,,Saraswati Vinasana mein zameen ke andar
Dialogue: 0,0:11:06.12,0:11:06.34,Default,,0,0,0,,gayi.
Dialogue: 0,0:11:06.34,0:11:08.17,Default,,0,0,0,,Lok parampara kehti hai,
Dialogue: 0,0:11:08.17,0:11:10.45,Default,,0,0,0,,andar hi andar behkar woh Prayagraj
Dialogue: 0,0:11:10.45,0:11:11.14,Default,,0,0,0,,pahunchi.
Dialogue: 0,0:11:11.14,0:11:13.19,Default,,0,0,0,,Is baat ka koi vaigyanik sabut
Dialogue: 0,0:11:13.19,0:11:15.02,Default,,0,0,0,,abhi hamare paas nahi.
Dialogue: 0,0:11:15.02,0:11:16.84,Default,,0,0,0,,Par sangam par khade hokar,
Dialogue: 0,0:11:16.84,0:11:18.67,Default,,0,0,0,,log use mehsoos karte hain.
Dialogue: 0,0:11:19.12,0:11:21.46,Default,,0,0,0,,Toh poori kahani ko saath rakhiye.
Dialogue: 0,0:11:21.46,0:11:23.57,Default,,0,0,0,,Granth mahaan nadi ki baat karte
Dialogue: 0,0:11:23.57,0:11:23.81,Default,,0,0,0,,hain.
Dialogue: 0,0:11:23.81,0:11:27.09,Default,,0,0,0,,Satellite aur drilling dabi purani nadi
Dialogue: 0,0:11:27.09,0:11:28.02,Default,,0,0,0,,dikhate hain.
Dialogue: 0,0:11:28.02,0:11:29.19,Default,,0,0,0,,Research kehti hai,
Dialogue: 0,0:11:29.19,0:11:31.54,Default,,0,0,0,,badi Sutlej shehron se pehle hat
Dialogue: 0,0:11:31.54,0:11:32.24,Default,,0,0,0,,chuki thi.
Dialogue: 0,0:11:32.24,0:11:34.11,Default,,0,0,0,,Aur vidvaan naam par bante hain.
Dialogue: 0,0:11:34.11,0:11:34.82,Default,,0,0,0,,Sabut hain,
Dialogue: 0,0:11:34.82,0:11:37.16,Default,,0,0,0,,par aakhri jawab abhi baaki hai.
Dialogue: 0,0:11:37.61,0:11:40.10,Default,,0,0,0,,Agli baar hum chalenge samundar ki
Dialogue: 0,0:11:40.10,0:11:40.55,Default,,0,0,0,,taraf,
Dialogue: 0,0:11:40.55,0:11:41.91,Default,,0,0,0,,Gujarat ke tat par.
Dialogue: 0,0:11:41.91,0:11:43.95,Default,,0,0,0,,Wahan paani ke neeche ek aur
Dialogue: 0,0:11:43.95,0:11:45.31,Default,,0,0,0,,kahani dabi hai,
Dialogue: 0,0:11:45.31,0:11:45.99,Default,,0,0,0,,Dwarka ki.
Dialogue: 0,0:11:45.99,0:11:47.12,Default,,0,0,0,,Granth kya kehte hain,
Dialogue: 0,0:11:47.12,0:11:48.25,Default,,0,0,0,,gotakhor kya laaye,
Dialogue: 0,0:11:48.25,0:11:49.84,Default,,0,0,0,,aur experts kya maante hain.
Dialogue: 0,0:11:49.84,0:11:50.29,Default,,0,0,0,,Sab kuch,
Dialogue: 0,0:11:50.29,0:11:51.20,Default,,0,0,0,,sabut ke saath,
Dialogue: 0,0:11:51.20,0:11:53.01,Default,,0,0,0,,aur har baat par uska label.
Dialogue: 0,0:11:53.46,0:11:54.55,Default,,0,0,0,,Ab sawaal aapse.
Dialogue: 0,0:11:54.55,0:11:57.16,Default,,0,0,0,,Aapke hisaab se Saraswati ka paani
Dialogue: 0,0:11:57.16,0:11:58.47,Default,,0,0,0,,kahan se aata tha,
Dialogue: 0,0:11:58.47,0:12:00.64,Default,,0,0,0,,Himalaya ke glacier se ya monsoon
Dialogue: 0,0:12:00.64,0:12:01.51,Default,,0,0,0,,ki baarish se?
Dialogue: 0,0:12:01.51,0:12:02.82,Default,,0,0,0,,Comment mein bas likhiye,
Dialogue: 0,0:12:02.82,0:12:03.91,Default,,0,0,0,,glacier ya baarish.
Dialogue: 0,0:12:03.91,0:12:05.65,Default,,0,0,0,,Aur agar aapke gaon ke paas
Dialogue: 0,0:12:05.65,0:12:06.95,Default,,0,0,0,,koi sookhi nadi hai,
Dialogue: 0,0:12:06.95,0:12:08.26,Default,,0,0,0,,uska naam bhi batayiye.
