Dialogue: 0,0:00:00.00,0:00:02.14,Default,,0,0,0,,Asirgarh ke mandir mein roz phool
Dialogue: 0,0:00:02.14,0:00:03.33,Default,,0,0,0,,kaun chadhata hai?
Dialogue: 0,0:00:03.33,0:00:04.99,Default,,0,0,0,,Darwaza band rehta hai.
Dialogue: 0,0:00:04.99,0:00:06.89,Default,,0,0,0,,Phir bhi subah taaze laal phool
Dialogue: 0,0:00:06.89,0:00:07.60,Default,,0,0,0,,milte hain.
Dialogue: 0,0:00:08.05,0:00:09.59,Default,,0,0,0,,Mahabharat yuddh ke baad,
Dialogue: 0,0:00:09.59,0:00:12.22,Default,,0,0,0,,Drona ke bete Ashwatthama ne divya
Dialogue: 0,0:00:12.22,0:00:13.10,Default,,0,0,0,,astra chalaya.
Dialogue: 0,0:00:13.10,0:00:15.29,Default,,0,0,0,,Nishana tha Uttara ke garbh ka
Dialogue: 0,0:00:15.29,0:00:15.73,Default,,0,0,0,,bachcha.
Dialogue: 0,0:00:16.18,0:00:17.58,Default,,0,0,0,,Tab Krishna ne shraap diya.
Dialogue: 0,0:00:17.58,0:00:19.68,Default,,0,0,0,,3,000 saal akele bhatakoge,
Dialogue: 0,0:00:19.68,0:00:21.31,Default,,0,0,0,,koi baat nahi karega.
Dialogue: 0,0:00:21.31,0:00:23.17,Default,,0,0,0,,Ghaav kabhi nahi bharenge.
Dialogue: 0,0:00:23.17,0:00:25.50,Default,,0,0,0,,Rishi Vyasa ne bhi haami bhari.
Dialogue: 0,0:00:25.95,0:00:28.15,Default,,0,0,0,,Maathe ki divya mani Pandavon ko
Dialogue: 0,0:00:28.15,0:00:28.55,Default,,0,0,0,,dekar,
Dialogue: 0,0:00:28.55,0:00:30.35,Default,,0,0,0,,woh udaas mann se jungle chala
Dialogue: 0,0:00:30.35,0:00:30.55,Default,,0,0,0,,gaya.
Dialogue: 0,0:00:31.00,0:00:33.09,Default,,0,0,0,,Ab chaliye Asirgarh ke kile,
Dialogue: 0,0:00:33.09,0:00:36.12,Default,,0,0,0,,Burhanpur se lagbhag 20 kilometre door.
Dialogue: 0,0:00:36.12,0:00:38.67,Default,,0,0,0,,Ise dakkhan ka darwaza kehte the,
Dialogue: 0,0:00:38.67,0:00:41.00,Default,,0,0,0,,yaani uttar se dakshin ka raasta.
Dialogue: 0,0:00:41.45,0:00:41.87,Default,,0,0,0,,ASI,
Dialogue: 0,0:00:41.87,0:00:45.22,Default,,0,0,0,,yaani purani imaaraton ki sarkari rakhwali
Dialogue: 0,0:00:45.22,0:00:46.48,Default,,0,0,0,,karne wali sanstha.
Dialogue: 0,0:00:46.48,0:00:48.99,Default,,0,0,0,,Usne poora kila surakshit ghoshit kiya
Dialogue: 0,0:00:48.99,0:00:49.20,Default,,0,0,0,,hai.
Dialogue: 0,0:00:49.20,0:00:51.09,Default,,0,0,0,,Andar ka Mahadeo mandir bhi.
Dialogue: 0,0:00:51.54,0:00:54.03,Default,,0,0,0,,Madhya Pradesh ke kisi doctor ki
Dialogue: 0,0:00:54.03,0:00:55.77,Default,,0,0,0,,kahani bhi mashhoor hai.
Dialogue: 0,0:00:55.77,0:00:57.02,Default,,0,0,0,,Lamba sa mareez,
Dialogue: 0,0:00:57.02,0:00:58.51,Default,,0,0,0,,maathe par gehra ghaav.
Dialogue: 0,0:00:58.51,0:01:00.50,Default,,0,0,0,,Doctor ne mazaak mein poocha,
Dialogue: 0,0:01:00.50,0:01:02.00,Default,,0,0,0,,aap Ashwatthama ho?
Dialogue: 0,0:01:02.00,0:01:02.99,Default,,0,0,0,,Mudkar dekha,
Dialogue: 0,0:01:02.99,0:01:03.74,Default,,0,0,0,,mareez gayab.
Dialogue: 0,0:01:04.19,0:01:06.56,Default,,0,0,0,,Narmada ke jungle mein bhi aisi
Dialogue: 0,0:01:06.56,0:01:07.26,Default,,0,0,0,,baatein hain.
Dialogue: 0,0:01:07.26,0:01:09.86,Default,,0,0,0,,Lamba musafir saadhuon se sarson ka
Dialogue: 0,0:01:09.86,0:01:10.81,Default,,0,0,0,,tel maangta hai,
Dialogue: 0,0:01:10.81,0:01:12.23,Default,,0,0,0,,maathe ke dard ke liye.
Dialogue: 0,0:01:12.68,0:01:14.23,Default,,0,0,0,,Par granth mein shraap 3,000 saal
Dialogue: 0,0:01:14.23,0:01:14.74,Default,,0,0,0,,ka hai,
Dialogue: 0,0:01:14.74,0:01:16.29,Default,,0,0,0,,hamesha ka nahi.
Dialogue: 0,0:01:16.29,0:01:17.84,Default,,0,0,0,,Lok-kathayein kehti hain,
Dialogue: 0,0:01:17.84,0:01:19.39,Default,,0,0,0,,woh is yug ke ant tak
Dialogue: 0,0:01:19.39,0:01:20.16,Default,,0,0,0,,rahega.
Dialogue: 0,0:01:20.61,0:01:22.00,Default,,0,0,0,,Kile par bhi bahas hai.
Dialogue: 0,0:01:22.00,0:01:24.38,Default,,0,0,0,,Farsi itihaaskar Ferishta kehte hain,
Dialogue: 0,0:01:24.38,0:01:26.16,Default,,0,0,0,,ise Asa Ahir ne banwaya.
Dialogue: 0,0:01:26.16,0:01:27.15,Default,,0,0,0,,Doosre kehte hain,
Dialogue: 0,0:01:27.15,0:01:29.13,Default,,0,0,0,,usse pehle bhi yahan basti thi.
Dialogue: 0,0:01:29.58,0:01:31.19,Default,,0,0,0,,Toh phool kaun chadhata hai?
Dialogue: 0,0:01:31.19,0:01:33.50,Default,,0,0,0,,Iska sabut kisi ke paas nahi.
Dialogue: 0,0:01:33.50,0:01:35.34,Default,,0,0,0,,Par kila aur mandir aaj bhi
Dialogue: 0,0:01:35.34,0:01:36.04,Default,,0,0,0,,khade hain,
Dialogue: 0,0:01:36.04,0:01:37.42,Default,,0,0,0,,aap khud dekh sakte ho.
Dialogue: 0,0:01:37.87,0:01:39.52,Default,,0,0,0,,Us dost ko bhejo jo kehta
Dialogue: 0,0:01:39.52,0:01:41.59,Default,,0,0,0,,hai Ashwatthama aaj bhi zinda hai.
