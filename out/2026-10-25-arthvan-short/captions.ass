Dialogue: 0,0:00:00.00,0:00:02.01,Default,,0,0,0,,Haryana ke ek gaon ke neeche,
Dialogue: 0,0:00:02.01,0:00:04.02,Default,,0,0,0,,kya poora shehar so raha hai?
Dialogue: 0,0:00:04.02,0:00:07.14,Default,,0,0,0,,Sanskrit parampara is jagah ko Sarasvati
Dialogue: 0,0:00:07.14,0:00:09.60,Default,,0,0,0,,aur Drishadvati nadiyon se jodti hai.
Dialogue: 0,0:00:10.05,0:00:11.38,Default,,0,0,0,,Gaon ke buzurg kehte the,
Dialogue: 0,0:00:11.38,0:00:13.68,Default,,0,0,0,,in teelon mein Mahabharat ke zamane
Dialogue: 0,0:00:13.68,0:00:15.01,Default,,0,0,0,,ka khazana chhupa hai.
Dialogue: 0,0:00:15.46,0:00:16.75,Default,,0,0,0,,Phir archaeologist aaye,
Dialogue: 0,0:00:16.75,0:00:19.55,Default,,0,0,0,,yaani mitti khodkar itihaas padhne wale.
Dialogue: 0,0:00:19.55,0:00:21.70,Default,,0,0,0,,Neeche Harappa ka shehar nikla,
Dialogue: 0,0:00:21.70,0:00:24.50,Default,,0,0,0,,Sindhu ghati ki purani shehri sabhyata.
Dialogue: 0,0:00:24.95,0:00:26.73,Default,,0,0,0,,Vasant Shinde ki team ne kaha,
Dialogue: 0,0:00:26.73,0:00:29.09,Default,,0,0,0,,Rakhigarhi 350 hectare ka hai,
Dialogue: 0,0:00:29.09,0:00:30.87,Default,,0,0,0,,Mohenjo-daro se bhi bada.
Dialogue: 0,0:00:31.32,0:00:33.39,Default,,0,0,0,,Kabristan mein ek aurat ka kankaal
Dialogue: 0,0:00:33.39,0:00:33.80,Default,,0,0,0,,mila.
Dialogue: 0,0:00:33.80,0:00:35.67,Default,,0,0,0,,Scientists ne uska DNA nikala,
Dialogue: 0,0:00:35.67,0:00:37.94,Default,,0,0,0,,yaani sharir ka code jo purvajon
Dialogue: 0,0:00:37.94,0:00:39.60,Default,,0,0,0,,ki kahani batata hai.
Dialogue: 0,0:00:40.05,0:00:41.89,Default,,0,0,0,,Cell journal ki report kehti hai,
Dialogue: 0,0:00:41.89,0:00:44.34,Default,,0,0,0,,usmein purane Irani aur South Asian
Dialogue: 0,0:00:44.34,0:00:45.57,Default,,0,0,0,,shikariyon ka mel tha.
Dialogue: 0,0:00:46.02,0:00:47.97,Default,,0,0,0,,Steppe ka nishaan nahi mila,
Dialogue: 0,0:00:47.97,0:00:49.92,Default,,0,0,0,,yaani Central Asia ke ghaas ke
Dialogue: 0,0:00:49.92,0:00:51.66,Default,,0,0,0,,maidan wale pashupalak.
Dialogue: 0,0:00:52.11,0:00:53.26,Default,,0,0,0,,Kuch experts kehte hain,
Dialogue: 0,0:00:53.26,0:00:55.75,Default,,0,0,0,,isse Steppe migration theory kamzor hoti
Dialogue: 0,0:00:55.75,0:00:55.94,Default,,0,0,0,,hai.
Dialogue: 0,0:00:55.94,0:00:56.90,Default,,0,0,0,,Doosre kehte hain,
Dialogue: 0,0:00:56.90,0:00:58.43,Default,,0,0,0,,woh log Harappa ke baad aaye.
Dialogue: 0,0:00:58.88,0:01:00.64,Default,,0,0,0,,Size par bhi sawaal hai.
Dialogue: 0,0:01:00.64,0:01:02.90,Default,,0,0,0,,Kya saare teele ek shehar the,
Dialogue: 0,0:01:02.90,0:01:04.40,Default,,0,0,0,,ya alag alag gaon?
Dialogue: 0,0:01:04.85,0:01:05.50,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:01:05.50,0:01:07.45,Default,,0,0,0,,poori bahas sirf ek kankaal par
Dialogue: 0,0:01:07.45,0:01:08.09,Default,,0,0,0,,khadi hai.
Dialogue: 0,0:01:08.09,0:01:09.61,Default,,0,0,0,,Baaki aabadi kaun thi,
Dialogue: 0,0:01:09.61,0:01:10.69,Default,,0,0,0,,koi nahi jaanta.
Dialogue: 0,0:01:11.14,0:01:13.40,Default,,0,0,0,,Aaj bhi aap Rakhigarhi jaakar woh
Dialogue: 0,0:01:13.40,0:01:14.98,Default,,0,0,0,,teele khet ke beech khud dekh
Dialogue: 0,0:01:14.98,0:01:15.66,Default,,0,0,0,,sakte hain.
Dialogue: 0,0:01:16.11,0:01:17.44,Default,,0,0,0,,Aapko kya lagta hai,
Dialogue: 0,0:01:17.44,0:01:19.45,Default,,0,0,0,,teelon ke neeche aur kya chhupa
Dialogue: 0,0:01:19.45,0:01:19.67,Default,,0,0,0,,hai?
