Dialogue: 0,0:00:00.00,0:00:01.41,Default,,0,0,0,,PAN-Aadhaar link nahi kiya,
Dialogue: 0,0:00:01.41,0:00:03.01,Default,,0,0,0,,to refund atak sakta hai?
Dialogue: 0,0:00:03.46,0:00:05.21,Default,,0,0,0,,Salary wale ghar ka refund,
Dialogue: 0,0:00:05.21,0:00:06.58,Default,,0,0,0,,bachchon ki fees ka plan tha.
Dialogue: 0,0:00:06.58,0:00:07.74,Default,,0,0,0,,Paisa aaya hi nahi.
Dialogue: 0,0:00:08.19,0:00:08.76,Default,,0,0,0,,Socha tha,
Dialogue: 0,0:00:08.76,0:00:10.09,Default,,0,0,0,,PAN card to chal raha hai.
Dialogue: 0,0:00:10.09,0:00:11.04,Default,,0,0,0,,Link ki kya jaldi?
Dialogue: 0,0:00:11.49,0:00:12.43,Default,,0,0,0,,Lekin twist yeh hai.
Dialogue: 0,0:00:12.43,0:00:14.49,Default,,0,0,0,,PAN inoperative ho jaata hai,
Dialogue: 0,0:00:14.49,0:00:15.80,Default,,0,0,0,,yaani card hai par tax ke
Dialogue: 0,0:00:15.80,0:00:16.55,Default,,0,0,0,,kaam ka nahi.
Dialogue: 0,0:00:17.00,0:00:18.32,Default,,0,0,0,,Refund ruk jaata hai,
Dialogue: 0,0:00:18.32,0:00:19.42,Default,,0,0,0,,uska byaaj bhi gaya.
Dialogue: 0,0:00:19.42,0:00:20.96,Default,,0,0,0,,Upar se FD ke byaaj par
Dialogue: 0,0:00:20.96,0:00:21.62,Default,,0,0,0,,zyada TDS,
Dialogue: 0,0:00:21.62,0:00:23.38,Default,,0,0,0,,yaani pehle hi kata tax.
Dialogue: 0,0:00:23.83,0:00:24.68,Default,,0,0,0,,Theek kaise ho?
Dialogue: 0,0:00:24.68,0:00:25.94,Default,,0,0,0,,1,000 rupaye fee bharo,
Dialogue: 0,0:00:25.94,0:00:27.00,Default,,0,0,0,,Aadhaar link karo.
Dialogue: 0,0:00:27.00,0:00:28.68,Default,,0,0,0,,Lagbhag 30 din mein PAN phir
Dialogue: 0,0:00:28.68,0:00:29.10,Default,,0,0,0,,chalu.
Dialogue: 0,0:00:29.55,0:00:30.83,Default,,0,0,0,,Asli nuksaan fee nahi,
Dialogue: 0,0:00:30.83,0:00:31.92,Default,,0,0,0,,ruka hua paisa hai.
Dialogue: 0,0:00:31.92,0:00:33.74,Default,,0,0,0,,Aaj hi income tax website par
Dialogue: 0,0:00:33.74,0:00:34.47,Default,,0,0,0,,status dekho.
Dialogue: 0,0:00:34.47,0:00:36.30,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:36.75,0:00:38.43,Default,,0,0,0,,Us dost ko bhejo jiska refund
Dialogue: 0,0:00:38.43,0:00:39.55,Default,,0,0,0,,abhi tak nahi aaya.
