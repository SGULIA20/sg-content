Dialogue: 0,0:00:00.00,0:00:01.79,Default,,0,0,0,,Hanuman ji ka janm kis pahad
Dialogue: 0,0:00:01.79,0:00:02.39,Default,,0,0,0,,par hua tha,
Dialogue: 0,0:00:02.39,0:00:02.99,Default,,0,0,0,,sach kya hai?
Dialogue: 0,0:00:03.44,0:00:05.87,Default,,0,0,0,,Valmiki Ramayana ke Kishkindha Kanda mein
Dialogue: 0,0:00:05.87,0:00:07.55,Default,,0,0,0,,Jambavan katha sunate hain.
Dialogue: 0,0:00:07.55,0:00:08.29,Default,,0,0,0,,Maa Anjana,
Dialogue: 0,0:00:08.29,0:00:09.41,Default,,0,0,0,,Vayu dev ka aashirvaad.
Dialogue: 0,0:00:09.87,0:00:11.67,Default,,0,0,0,,Baal Hanuman suraj ko phal samajh
Dialogue: 0,0:00:11.67,0:00:12.39,Default,,0,0,0,,uchhal pade.
Dialogue: 0,0:00:12.39,0:00:14.19,Default,,0,0,0,,Par katha pahad ka pata nahi
Dialogue: 0,0:00:14.19,0:00:14.55,Default,,0,0,0,,deti!
Dialogue: 0,0:00:15.00,0:00:15.80,Default,,0,0,0,,Pehla dawa,
Dialogue: 0,0:00:15.80,0:00:17.82,Default,,0,0,0,,Hampi ke paas Anjeyanadri pahad.
Dialogue: 0,0:00:17.82,0:00:19.22,Default,,0,0,0,,Parampara kehti hai,
Dialogue: 0,0:00:19.22,0:00:20.03,Default,,0,0,0,,janm yahin hua.
Dialogue: 0,0:00:20.03,0:00:22.04,Default,,0,0,0,,Upar mandir tak 575 seedhiyan.
Dialogue: 0,0:00:22.49,0:00:22.86,Default,,0,0,0,,ASI,
Dialogue: 0,0:00:22.86,0:00:25.45,Default,,0,0,0,,yaani purani imaaraton ki sarkari jaanch
Dialogue: 0,0:00:25.45,0:00:25.82,Default,,0,0,0,,sanstha.
Dialogue: 0,0:00:25.82,0:00:28.04,Default,,0,0,0,,Uske mutabik Hampi ko Kishkindha ka
Dialogue: 0,0:00:28.04,0:00:29.70,Default,,0,0,0,,Pampa Kshetra maana jaata hai.
Dialogue: 0,0:00:30.15,0:00:32.50,Default,,0,0,0,,Lekin 2021 mein naya dawa aaya.
Dialogue: 0,0:00:32.50,0:00:32.71,Default,,0,0,0,,TTD,
Dialogue: 0,0:00:32.71,0:00:34.85,Default,,0,0,0,,yaani Tirumala mandir ka trust,
Dialogue: 0,0:00:34.85,0:00:35.27,Default,,0,0,0,,bola,
Dialogue: 0,0:00:35.27,0:00:36.77,Default,,0,0,0,,janm Tirumala mein hua!
Dialogue: 0,0:00:37.22,0:00:38.44,Default,,0,0,0,,Sabut Skanda Purana,
Dialogue: 0,0:00:38.44,0:00:39.31,Default,,0,0,0,,ek purana granth.
Dialogue: 0,0:00:39.31,0:00:41.40,Default,,0,0,0,,Usmein Anjana ka tap Venkatachalam,
Dialogue: 0,0:00:41.40,0:00:43.49,Default,,0,0,0,,yaani Tirumala ke pahad par likha
Dialogue: 0,0:00:43.49,0:00:43.67,Default,,0,0,0,,hai.
Dialogue: 0,0:00:44.12,0:00:46.24,Default,,0,0,0,,Par Maharashtra ki apni kahani hai.
Dialogue: 0,0:00:46.24,0:00:48.01,Default,,0,0,0,,Nashik ke paas Anjaneri pahad,
Dialogue: 0,0:00:48.01,0:00:49.78,Default,,0,0,0,,lok katha kehti hai Anjana ne
Dialogue: 0,0:00:49.78,0:00:50.49,Default,,0,0,0,,yahin tap kiya.
Dialogue: 0,0:00:50.94,0:00:53.20,Default,,0,0,0,,ASI ne Anjaneri par Yadava rajaon
Dialogue: 0,0:00:53.20,0:00:54.59,Default,,0,0,0,,ke daur ke patthar ke mandir
Dialogue: 0,0:00:54.59,0:00:54.94,Default,,0,0,0,,darj kiye.
Dialogue: 0,0:00:54.94,0:00:56.15,Default,,0,0,0,,Ek shilalekh bhi mila.
Dialogue: 0,0:00:56.60,0:00:57.19,Default,,0,0,0,,Ab takraar.
Dialogue: 0,0:00:57.19,0:00:59.75,Default,,0,0,0,,Karnataka ke itihaaskaar TTD se sahmat
Dialogue: 0,0:00:59.75,0:01:00.15,Default,,0,0,0,,nahi.
Dialogue: 0,0:01:00.15,0:01:00.94,Default,,0,0,0,,Unka kehna,
Dialogue: 0,0:01:00.94,0:01:02.91,Default,,0,0,0,,Kishkindha Hampi ke aaspaas hi hai.
Dialogue: 0,0:01:03.36,0:01:04.72,Default,,0,0,0,,Kuch itihaaskaar kehte hain,
Dialogue: 0,0:01:04.72,0:01:06.43,Default,,0,0,0,,Kishkindha kavita ki zameen hai.
Dialogue: 0,0:01:06.43,0:01:07.79,Default,,0,0,0,,Use aaj ke naqshe par pin
Dialogue: 0,0:01:07.79,0:01:08.47,Default,,0,0,0,,karna mushkil.
Dialogue: 0,0:01:08.92,0:01:09.55,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:01:09.55,0:01:11.84,Default,,0,0,0,,patthar bhakti ki umar batate hain,
Dialogue: 0,0:01:11.84,0:01:13.09,Default,,0,0,0,,janm ki jagah nahi.
Dialogue: 0,0:01:13.09,0:01:13.51,Default,,0,0,0,,Hampi,
Dialogue: 0,0:01:13.51,0:01:15.38,Default,,0,0,0,,Tirumala ya Anjaneri,
Dialogue: 0,0:01:15.38,0:01:17.05,Default,,0,0,0,,aaj aap khud chadhkar dekh sakte
Dialogue: 0,0:01:17.05,0:01:17.26,Default,,0,0,0,,ho.
Dialogue: 0,0:01:17.71,0:01:18.52,Default,,0,0,0,,Nani ko bhejo,
Dialogue: 0,0:01:18.52,0:01:20.29,Default,,0,0,0,,jinse aapne bachpan mein Hanuman ji
Dialogue: 0,0:01:20.29,0:01:21.10,Default,,0,0,0,,ki katha suni.
