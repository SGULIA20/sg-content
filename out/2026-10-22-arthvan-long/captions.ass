Dialogue: 0,0:00:00.00,0:00:02.28,Default,,0,0,0,,Puri ke mandir ka jhanda hawa
Dialogue: 0,0:00:02.28,0:00:03.64,Default,,0,0,0,,ke ulte udta hai,
Dialogue: 0,0:00:03.64,0:00:05.01,Default,,0,0,0,,aisa log kehte hain.
Dialogue: 0,0:00:05.01,0:00:06.61,Default,,0,0,0,,Samundar se hawa aaye,
Dialogue: 0,0:00:06.61,0:00:08.88,Default,,0,0,0,,phir bhi jhanda samundar ki taraf
Dialogue: 0,0:00:08.88,0:00:09.79,Default,,0,0,0,,lehraata hai.
Dialogue: 0,0:00:09.79,0:00:11.62,Default,,0,0,0,,Sadiyon se pilgrims yeh dekh kar
Dialogue: 0,0:00:11.62,0:00:12.53,Default,,0,0,0,,haath jodte hain.
Dialogue: 0,0:00:12.53,0:00:14.58,Default,,0,0,0,,Aur aaj mausam vigyani bhi is
Dialogue: 0,0:00:14.58,0:00:16.40,Default,,0,0,0,,jhande ko dhyan se dekhte hain.
Dialogue: 0,0:00:16.85,0:00:18.91,Default,,0,0,0,,Yeh akela rahasya nahi hai.
Dialogue: 0,0:00:18.91,0:00:20.98,Default,,0,0,0,,Kehte hain mandir ki parchhai zameen
Dialogue: 0,0:00:20.98,0:00:22.01,Default,,0,0,0,,par nahi dikhti.
Dialogue: 0,0:00:22.01,0:00:23.87,Default,,0,0,0,,Shikhar ka chakra har disha se
Dialogue: 0,0:00:23.87,0:00:25.11,Default,,0,0,0,,aapko hi dekhta hai.
Dialogue: 0,0:00:25.11,0:00:27.17,Default,,0,0,0,,Rasoi mein sabse upar ka matka
Dialogue: 0,0:00:27.17,0:00:28.21,Default,,0,0,0,,pehle pakta hai.
Dialogue: 0,0:00:28.21,0:00:30.68,Default,,0,0,0,,Singhadwara paar karte hi samundar ki
Dialogue: 0,0:00:30.68,0:00:32.13,Default,,0,0,0,,awaaz chup ho jaati hai.
Dialogue: 0,0:00:32.58,0:00:34.51,Default,,0,0,0,,Is video mein har rahasya ke
Dialogue: 0,0:00:34.51,0:00:36.23,Default,,0,0,0,,saath dono pehlu milenge.
Dialogue: 0,0:00:36.23,0:00:37.73,Default,,0,0,0,,Ek taraf bhakt ki shraddha,
Dialogue: 0,0:00:37.73,0:00:39.67,Default,,0,0,0,,doosri taraf vigyan ka hisaab.
Dialogue: 0,0:00:39.67,0:00:42.03,Default,,0,0,0,,Hum kisi ko galat nahi kahenge.
Dialogue: 0,0:00:42.03,0:00:43.53,Default,,0,0,0,,Hum bas sabut rakhenge,
Dialogue: 0,0:00:43.53,0:00:45.04,Default,,0,0,0,,aur faisla aapka hoga.
Dialogue: 0,0:00:45.04,0:00:45.47,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:00:45.47,0:00:48.26,Default,,0,0,0,,Odisha ke samundar kinare chalte hain.
Dialogue: 0,0:00:48.71,0:00:50.39,Default,,0,0,0,,Pehle dekhte hain ki granth kya
Dialogue: 0,0:00:50.39,0:00:51.01,Default,,0,0,0,,kehte hain.
Dialogue: 0,0:00:51.01,0:00:53.11,Default,,0,0,0,,Skanda Purana ka ek hissa hai,
Dialogue: 0,0:00:53.11,0:00:54.16,Default,,0,0,0,,Utkala Khanda.
Dialogue: 0,0:00:54.16,0:00:56.46,Default,,0,0,0,,Utkala yaani purana Odisha.
Dialogue: 0,0:00:56.46,0:00:58.55,Default,,0,0,0,,Is hisse mein Puri ki mahima
Dialogue: 0,0:00:58.55,0:01:00.02,Default,,0,0,0,,vistaar se likhi gayi hai.
Dialogue: 0,0:01:00.02,0:01:01.70,Default,,0,0,0,,Aur yahan ek baat bahut khaas
Dialogue: 0,0:01:01.70,0:01:01.91,Default,,0,0,0,,hai,
Dialogue: 0,0:01:01.91,0:01:03.79,Default,,0,0,0,,jo poori kahani ki neev hai.
Dialogue: 0,0:01:04.24,0:01:07.76,Default,,0,0,0,,Skanda Purana Puri ko Purushottama Kshetra
Dialogue: 0,0:01:07.76,0:01:08.46,Default,,0,0,0,,kehta hai.
Dialogue: 0,0:01:08.46,0:01:10.81,Default,,0,0,0,,Kshetra yaani ek pavitra bhoomi,
Dialogue: 0,0:01:10.81,0:01:11.27,Default,,0,0,0,,ek tirth.
Dialogue: 0,0:01:11.27,0:01:13.62,Default,,0,0,0,,Granth ke anusaar Bhagwan har jagah
Dialogue: 0,0:01:13.62,0:01:13.85,Default,,0,0,0,,hain.
Dialogue: 0,0:01:13.85,0:01:15.73,Default,,0,0,0,,Phir bhi yeh kshetra sabse shreshth
Dialogue: 0,0:01:15.73,0:01:15.96,Default,,0,0,0,,hai.
Dialogue: 0,0:01:15.96,0:01:18.31,Default,,0,0,0,,Kyunki yeh jagah khud Parmeshwar ka
Dialogue: 0,0:01:18.31,0:01:19.48,Default,,0,0,0,,sharir ban gayi hai.
Dialogue: 0,0:01:19.93,0:01:21.96,Default,,0,0,0,,Zara is baat ko mehsoos kijiye.
Dialogue: 0,0:01:21.96,0:01:23.76,Default,,0,0,0,,Granth ke liye Puri sirf mandir
Dialogue: 0,0:01:23.76,0:01:25.33,Default,,0,0,0,,wala shehar nahi hai.
Dialogue: 0,0:01:25.33,0:01:26.23,Default,,0,0,0,,Yahan ki ret,
Dialogue: 0,0:01:26.23,0:01:27.81,Default,,0,0,0,,samundar ka kinara,
Dialogue: 0,0:01:27.81,0:01:29.61,Default,,0,0,0,,sab us divya roop ka hissa
Dialogue: 0,0:01:29.61,0:01:29.84,Default,,0,0,0,,hai.
Dialogue: 0,0:01:29.84,0:01:32.09,Default,,0,0,0,,Isliye pilgrims yahan zameen ko chhoo
Dialogue: 0,0:01:32.09,0:01:33.89,Default,,0,0,0,,kar maathe se lagaate hain.
Dialogue: 0,0:01:34.34,0:01:35.82,Default,,0,0,0,,Ab ek lokpriya kahani,
Dialogue: 0,0:01:35.82,0:01:37.73,Default,,0,0,0,,jo dadi-nani sunati hain.
Dialogue: 0,0:01:37.73,0:01:39.64,Default,,0,0,0,,Ek raja ko sapne mein Bhagwan
Dialogue: 0,0:01:39.64,0:01:40.49,Default,,0,0,0,,ka darshan hua.
Dialogue: 0,0:01:40.49,0:01:42.82,Default,,0,0,0,,Samundar mein ek divya lakdi tairti
Dialogue: 0,0:01:42.82,0:01:43.24,Default,,0,0,0,,hui aayi.
Dialogue: 0,0:01:43.24,0:01:45.36,Default,,0,0,0,,Usi lakdi se moortiyan banaayi gayin.
Dialogue: 0,0:01:45.36,0:01:47.91,Default,,0,0,0,,Yeh kahani pidhi dar pidhi zubaani
Dialogue: 0,0:01:47.91,0:01:49.18,Default,,0,0,0,,chali aa rahi hai.
Dialogue: 0,0:01:49.63,0:01:51.35,Default,,0,0,0,,Isi wajah se Jagannath,
Dialogue: 0,0:01:51.35,0:01:54.14,Default,,0,0,0,,Balabhadra aur Subhadra ki moortiyan lakdi
Dialogue: 0,0:01:54.14,0:01:54.57,Default,,0,0,0,,ki hain.
Dialogue: 0,0:01:54.57,0:01:56.29,Default,,0,0,0,,Pathar ya dhatu ki nahi.
Dialogue: 0,0:01:56.29,0:01:57.14,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:01:57.14,0:01:59.29,Default,,0,0,0,,yeh mandir apne niyam khud chalata
Dialogue: 0,0:01:59.29,0:01:59.51,Default,,0,0,0,,hai.
Dialogue: 0,0:01:59.51,0:02:01.44,Default,,0,0,0,,Aur yahin se shuru hote hain
Dialogue: 0,0:02:01.44,0:02:02.30,Default,,0,0,0,,woh rahasya,
Dialogue: 0,0:02:02.30,0:02:04.23,Default,,0,0,0,,jinke peeche hum aaj chalenge.
Dialogue: 0,0:02:04.68,0:02:06.26,Default,,0,0,0,,Ab granth se nikal kar napne
Dialogue: 0,0:02:06.26,0:02:08.04,Default,,0,0,0,,aur jaanchne ki duniya mein chalte
Dialogue: 0,0:02:08.04,0:02:08.24,Default,,0,0,0,,hain.
Dialogue: 0,0:02:08.24,0:02:10.21,Default,,0,0,0,,Archaeological Survey of India,
Dialogue: 0,0:02:10.21,0:02:11.00,Default,,0,0,0,,yaani ASI,
Dialogue: 0,0:02:11.00,0:02:13.38,Default,,0,0,0,,desh ki purani imaaraton ki dekhbhaal
Dialogue: 0,0:02:13.38,0:02:13.97,Default,,0,0,0,,karta hai.
Dialogue: 0,0:02:13.97,0:02:15.55,Default,,0,0,0,,ASI ne is mandir ko kab
Dialogue: 0,0:02:15.55,0:02:16.54,Default,,0,0,0,,apne haath mein liya?
Dialogue: 0,0:02:16.54,0:02:18.12,Default,,0,0,0,,Jawab ek saal mein chhupa hai.
Dialogue: 0,0:02:18.57,0:02:19.19,Default,,0,0,0,,Saal tha 1975.
Dialogue: 0,0:02:19.19,0:02:21.44,Default,,0,0,0,,ASI ne Jagannath mandir ko rashtriya
Dialogue: 0,0:02:21.44,0:02:22.67,Default,,0,0,0,,sanrakshan mein le liya.
Dialogue: 0,0:02:22.67,0:02:25.13,Default,,0,0,0,,Sanrakshan yaani imaarat ko tootne se
Dialogue: 0,0:02:25.13,0:02:25.74,Default,,0,0,0,,bachana,
Dialogue: 0,0:02:25.74,0:02:27.17,Default,,0,0,0,,uski marammat karna.
Dialogue: 0,0:02:27.17,0:02:29.84,Default,,0,0,0,,Ek sarkari notification ke zariye yeh
Dialogue: 0,0:02:29.84,0:02:30.45,Default,,0,0,0,,faisla hua.
Dialogue: 0,0:02:30.45,0:02:32.71,Default,,0,0,0,,Tab se iski deewaron ki baakayda
Dialogue: 0,0:02:32.71,0:02:33.73,Default,,0,0,0,,dekhbhaal hoti hai.
Dialogue: 0,0:02:34.18,0:02:36.33,Default,,0,0,0,,ASI ke records ise sadiyon purana
Dialogue: 0,0:02:36.33,0:02:37.23,Default,,0,0,0,,mandir maante hain.
Dialogue: 0,0:02:37.23,0:02:39.20,Default,,0,0,0,,Iska dhancha Kalinga shaili ka hai.
Dialogue: 0,0:02:39.20,0:02:41.71,Default,,0,0,0,,Kalinga shaili yaani purane Odisha ki
Dialogue: 0,0:02:41.71,0:02:42.96,Default,,0,0,0,,apni khaas vaastukala.
Dialogue: 0,0:02:42.96,0:02:45.11,Default,,0,0,0,,Ismein shikhar upar jaate jaate patla
Dialogue: 0,0:02:45.11,0:02:45.65,Default,,0,0,0,,hota hai,
Dialogue: 0,0:02:45.65,0:02:47.26,Default,,0,0,0,,jaise kisi pahaad ki choti.
Dialogue: 0,0:02:47.71,0:02:49.76,Default,,0,0,0,,Is tarah ke oonche shikhar ko
Dialogue: 0,0:02:49.76,0:02:51.36,Default,,0,0,0,,Rekha Deula kehte hain.
Dialogue: 0,0:02:51.36,0:02:53.88,Default,,0,0,0,,Deula yaani mandir ka garbhgriha aur
Dialogue: 0,0:02:53.88,0:02:54.79,Default,,0,0,0,,uska shikhar.
Dialogue: 0,0:02:54.79,0:02:55.70,Default,,0,0,0,,Rekha isliye,
Dialogue: 0,0:02:55.70,0:02:58.67,Default,,0,0,0,,kyunki iski deewarein ek ghumaavdaar rekha
Dialogue: 0,0:02:58.67,0:03:00.04,Default,,0,0,0,,mein upar uthti hain.
Dialogue: 0,0:03:00.04,0:03:02.32,Default,,0,0,0,,Yahi ghumaav aage chal kar parchhai
Dialogue: 0,0:03:02.32,0:03:04.15,Default,,0,0,0,,ke rahasya mein kaam aayega.
Dialogue: 0,0:03:04.60,0:03:06.50,Default,,0,0,0,,Aur is shikhar ke sabse upar
Dialogue: 0,0:03:06.50,0:03:07.97,Default,,0,0,0,,baitha hai Neela Chakra.
Dialogue: 0,0:03:07.97,0:03:10.28,Default,,0,0,0,,Yeh Bhagwan Vishnu ke Sudarshan chakra
Dialogue: 0,0:03:10.28,0:03:11.97,Default,,0,0,0,,ka prateek maana jaata hai.
Dialogue: 0,0:03:11.97,0:03:14.07,Default,,0,0,0,,ASI ke records ke mutabik yeh
Dialogue: 0,0:03:14.07,0:03:15.76,Default,,0,0,0,,ashtadhatu se bana hai.
Dialogue: 0,0:03:15.76,0:03:18.29,Default,,0,0,0,,Ashtadhatu yaani kai dhatuon ko mila
Dialogue: 0,0:03:18.29,0:03:19.76,Default,,0,0,0,,kar banaya gaya ek mishran.
Dialogue: 0,0:03:20.21,0:03:21.40,Default,,0,0,0,,Aur iska aakaar?
Dialogue: 0,0:03:21.40,0:03:22.58,Default,,0,0,0,,Lagbhag 3.5 metre.
Dialogue: 0,0:03:22.58,0:03:24.72,Default,,0,0,0,,Yaani ek lambe aadmi se bhi
Dialogue: 0,0:03:24.72,0:03:25.67,Default,,0,0,0,,kaafi bada.
Dialogue: 0,0:03:25.67,0:03:27.80,Default,,0,0,0,,Itna bhaari dhatu ka pahiya,
Dialogue: 0,0:03:27.80,0:03:29.46,Default,,0,0,0,,itne oonche shikhar par.
Dialogue: 0,0:03:29.46,0:03:29.94,Default,,0,0,0,,Sochiye,
Dialogue: 0,0:03:29.94,0:03:32.31,Default,,0,0,0,,aaj ki machinon ke bina ise
Dialogue: 0,0:03:32.31,0:03:34.68,Default,,0,0,0,,upar kaise pahunchaya gaya hoga.
Dialogue: 0,0:03:34.68,0:03:37.29,Default,,0,0,0,,Yahi sawaal hum aage phir uthayenge.
Dialogue: 0,0:03:37.74,0:03:38.94,Default,,0,0,0,,Log batate hain,
Dialogue: 0,0:03:38.94,0:03:40.86,Default,,0,0,0,,har roz ek sevak is shikhar
Dialogue: 0,0:03:40.86,0:03:41.82,Default,,0,0,0,,par chadhta hai.
Dialogue: 0,0:03:41.82,0:03:44.22,Default,,0,0,0,,Woh chakra ke paas purana jhanda
Dialogue: 0,0:03:44.22,0:03:45.18,Default,,0,0,0,,utaarta hai,
Dialogue: 0,0:03:45.18,0:03:46.14,Default,,0,0,0,,naya baandhta hai.
Dialogue: 0,0:03:46.14,0:03:48.54,Default,,0,0,0,,Sirf haathon aur pairon ke sahaare.
Dialogue: 0,0:03:48.54,0:03:50.46,Default,,0,0,0,,Neeche khade bhakt saans rok kar
Dialogue: 0,0:03:50.46,0:03:52.14,Default,,0,0,0,,yeh nazaara dekhte hain.
Dialogue: 0,0:03:52.59,0:03:54.09,Default,,0,0,0,,Ab pehla bada sawaal,
Dialogue: 0,0:03:54.09,0:03:55.59,Default,,0,0,0,,jo har pilgrim poochta hai.
Dialogue: 0,0:03:55.59,0:03:57.72,Default,,0,0,0,,Jhanda hawa ke ulte kyon udta
Dialogue: 0,0:03:57.72,0:03:57.94,Default,,0,0,0,,hai?
Dialogue: 0,0:03:57.94,0:03:59.87,Default,,0,0,0,,Is par bhakt aur vaigyanik alag
Dialogue: 0,0:03:59.87,0:04:01.15,Default,,0,0,0,,alag baat kehte hain.
Dialogue: 0,0:04:01.15,0:04:02.86,Default,,0,0,0,,Dono ki baat dhyan se suniye.
Dialogue: 0,0:04:02.86,0:04:04.36,Default,,0,0,0,,Pehle shraddha ka pehlu,
Dialogue: 0,0:04:04.36,0:04:06.07,Default,,0,0,0,,phir mausam vigyan ka hisaab.
Dialogue: 0,0:04:06.52,0:04:08.37,Default,,0,0,0,,Bhakton ke liye jawab seedha hai.
Dialogue: 0,0:04:08.37,0:04:09.81,Default,,0,0,0,,Yeh Bhagwan ki leela hai.
Dialogue: 0,0:04:09.81,0:04:11.67,Default,,0,0,0,,Jo jhanda prakriti ke niyam se
Dialogue: 0,0:04:11.67,0:04:12.49,Default,,0,0,0,,alag chale,
Dialogue: 0,0:04:12.49,0:04:13.72,Default,,0,0,0,,woh divya sanket hai.
Dialogue: 0,0:04:13.72,0:04:14.96,Default,,0,0,0,,Kai pilgrims kehte hain,
Dialogue: 0,0:04:14.96,0:04:17.23,Default,,0,0,0,,unhone apni aankhon se dekha hai.
Dialogue: 0,0:04:17.23,0:04:18.46,Default,,0,0,0,,Ret par khade ho kar,
Dialogue: 0,0:04:18.46,0:04:20.31,Default,,0,0,0,,chehre par samundar ki hawa,
Dialogue: 0,0:04:20.31,0:04:21.96,Default,,0,0,0,,aur jhanda ulti disha mein.
Dialogue: 0,0:04:22.41,0:04:24.82,Default,,0,0,0,,Ab India Meteorological Department,
Dialogue: 0,0:04:24.82,0:04:25.43,Default,,0,0,0,,yaani IMD,
Dialogue: 0,0:04:25.43,0:04:25.83,Default,,0,0,0,,ki baat.
Dialogue: 0,0:04:25.83,0:04:27.84,Default,,0,0,0,,IMD desh ka sarkari mausam vibhag
Dialogue: 0,0:04:27.84,0:04:28.04,Default,,0,0,0,,hai.
Dialogue: 0,0:04:28.04,0:04:30.25,Default,,0,0,0,,Uska kehna hai ki poorvi samundar
Dialogue: 0,0:04:30.25,0:04:32.46,Default,,0,0,0,,kinare par hawa ke chhote local
Dialogue: 0,0:04:32.46,0:04:33.47,Default,,0,0,0,,ghere bante hain.
Dialogue: 0,0:04:33.47,0:04:35.28,Default,,0,0,0,,Bade mausam ke saath sea breeze
Dialogue: 0,0:04:35.28,0:04:37.49,Default,,0,0,0,,aur garmi milkar yeh ghere banaate
Dialogue: 0,0:04:37.49,0:04:37.69,Default,,0,0,0,,hain.
Dialogue: 0,0:04:38.14,0:04:40.03,Default,,0,0,0,,Sea breeze yaani din mein samundar
Dialogue: 0,0:04:40.03,0:04:41.92,Default,,0,0,0,,se zameen ki taraf chalne wali
Dialogue: 0,0:04:41.92,0:04:42.67,Default,,0,0,0,,thandi hawa.
Dialogue: 0,0:04:42.67,0:04:44.37,Default,,0,0,0,,Shaam ko yeh aksar palat jaati
Dialogue: 0,0:04:44.37,0:04:44.56,Default,,0,0,0,,hai,
Dialogue: 0,0:04:44.56,0:04:46.26,Default,,0,0,0,,zameen se samundar ki taraf.
Dialogue: 0,0:04:46.26,0:04:48.15,Default,,0,0,0,,Toh kinare par hawa ki disha
Dialogue: 0,0:04:48.15,0:04:49.28,Default,,0,0,0,,badalti rehti hai.
Dialogue: 0,0:04:49.28,0:04:51.17,Default,,0,0,0,,Neeche jo hawa aap mehsoos karte
Dialogue: 0,0:04:51.17,0:04:51.36,Default,,0,0,0,,hain,
Dialogue: 0,0:04:51.36,0:04:53.06,Default,,0,0,0,,upar woh alag ho sakti hai.
Dialogue: 0,0:04:53.51,0:04:54.49,Default,,0,0,0,,Ek aur wajah hai,
Dialogue: 0,0:04:54.49,0:04:55.27,Default,,0,0,0,,thermal eddy.
Dialogue: 0,0:04:55.27,0:04:57.43,Default,,0,0,0,,Thermal eddy yaani garam satah ke
Dialogue: 0,0:04:57.43,0:04:59.20,Default,,0,0,0,,paas ghoomti hui hawa ki bhanwar.
Dialogue: 0,0:04:59.20,0:05:01.16,Default,,0,0,0,,Mandir ka ghumaavdaar shikhar dhoop mein
Dialogue: 0,0:05:01.16,0:05:02.14,Default,,0,0,0,,garam hota hai.
Dialogue: 0,0:05:02.14,0:05:03.90,Default,,0,0,0,,Uske aas paas hawa mudti hai,
Dialogue: 0,0:05:03.90,0:05:04.49,Default,,0,0,0,,ghoomti hai.
Dialogue: 0,0:05:04.49,0:05:06.65,Default,,0,0,0,,Upar jhanda isi ghoomti hawa ke
Dialogue: 0,0:05:06.65,0:05:07.63,Default,,0,0,0,,saath lehraata hai.
Dialogue: 0,0:05:08.08,0:05:09.51,Default,,0,0,0,,Toh vaigyanik kehte hain,
Dialogue: 0,0:05:09.51,0:05:11.54,Default,,0,0,0,,jhanda asal mein upar ki hawa
Dialogue: 0,0:05:11.54,0:05:12.97,Default,,0,0,0,,ke saath hi ud raha hai.
Dialogue: 0,0:05:12.97,0:05:15.01,Default,,0,0,0,,Bas woh hawa zameen wali hawa
Dialogue: 0,0:05:15.01,0:05:15.82,Default,,0,0,0,,se ulti hai.
Dialogue: 0,0:05:15.82,0:05:16.63,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:05:16.63,0:05:18.47,Default,,0,0,0,,yeh vyakhya bhi usi leela ka
Dialogue: 0,0:05:18.47,0:05:19.08,Default,,0,0,0,,hissa hai.
Dialogue: 0,0:05:19.08,0:05:20.71,Default,,0,0,0,,Dono baatein aaj bhi saath saath
Dialogue: 0,0:05:20.71,0:05:21.32,Default,,0,0,0,,chalti hain.
Dialogue: 0,0:05:21.77,0:05:22.94,Default,,0,0,0,,Agla rahasya,
Dialogue: 0,0:05:22.94,0:05:23.64,Default,,0,0,0,,parchhai ka.
Dialogue: 0,0:05:23.64,0:05:24.58,Default,,0,0,0,,Log kehte hain,
Dialogue: 0,0:05:24.58,0:05:26.69,Default,,0,0,0,,din ke kisi bhi samay mandir
Dialogue: 0,0:05:26.69,0:05:29.02,Default,,0,0,0,,ki parchhai zameen par nahi dikhti.
Dialogue: 0,0:05:29.02,0:05:30.43,Default,,0,0,0,,Dopahar ho ya shaam,
Dialogue: 0,0:05:30.43,0:05:32.30,Default,,0,0,0,,shikhar ki chhaya ret par nahi
Dialogue: 0,0:05:32.30,0:05:32.77,Default,,0,0,0,,girti.
Dialogue: 0,0:05:32.77,0:05:34.64,Default,,0,0,0,,Yeh baat Puri ke har guide
Dialogue: 0,0:05:34.64,0:05:35.81,Default,,0,0,0,,ki zubaan par hai.
Dialogue: 0,0:05:35.81,0:05:37.45,Default,,0,0,0,,Par kya sach mein aisa hai?
Dialogue: 0,0:05:37.90,0:05:40.51,Default,,0,0,0,,Kalinga vaastukala par kaam karne wale
Dialogue: 0,0:05:40.51,0:05:41.72,Default,,0,0,0,,vishleshak kehte hain,
Dialogue: 0,0:05:41.72,0:05:43.13,Default,,0,0,0,,mandir parchhai daalta hai.
Dialogue: 0,0:05:43.13,0:05:45.14,Default,,0,0,0,,Bas woh parchhai wahan nahi girti
Dialogue: 0,0:05:45.14,0:05:46.35,Default,,0,0,0,,jahan hum dhoondhte hain.
Dialogue: 0,0:05:46.35,0:05:48.56,Default,,0,0,0,,Rekha Deula ka shikhar upar jaate
Dialogue: 0,0:05:48.56,0:05:49.97,Default,,0,0,0,,jaate patla hota hai.
Dialogue: 0,0:05:49.97,0:05:51.78,Default,,0,0,0,,Iski deewarein seedhi nahi,
Dialogue: 0,0:05:51.78,0:05:52.58,Default,,0,0,0,,ghumaavdaar hain.
Dialogue: 0,0:05:53.03,0:05:54.12,Default,,0,0,0,,Mandir ek chaudi,
Dialogue: 0,0:05:54.12,0:05:55.63,Default,,0,0,0,,oonchi neev par khada hai.
Dialogue: 0,0:05:55.63,0:05:57.15,Default,,0,0,0,,Isko podium kehte hain,
Dialogue: 0,0:05:57.15,0:05:59.54,Default,,0,0,0,,yaani imaarat ke neeche ka ooncha
Dialogue: 0,0:05:59.54,0:06:00.19,Default,,0,0,0,,chabutra.
Dialogue: 0,0:06:00.19,0:06:02.36,Default,,0,0,0,,Shikhar ki parchhai pehle apne hi
Dialogue: 0,0:06:02.36,0:06:03.45,Default,,0,0,0,,tiers par girti hai.
Dialogue: 0,0:06:03.45,0:06:05.62,Default,,0,0,0,,Tiers yaani deewar ki seedhiyon jaisi
Dialogue: 0,0:06:05.62,0:06:06.05,Default,,0,0,0,,parten.
Dialogue: 0,0:06:06.05,0:06:08.23,Default,,0,0,0,,Phir chabutre ki deewaron aur aas
Dialogue: 0,0:06:08.23,0:06:09.31,Default,,0,0,0,,paas ki chhaton par.
Dialogue: 0,0:06:09.76,0:06:11.69,Default,,0,0,0,,Mandir har mukhya disha ki seedh
Dialogue: 0,0:06:11.69,0:06:12.54,Default,,0,0,0,,mein bana hai.
Dialogue: 0,0:06:12.54,0:06:14.68,Default,,0,0,0,,Isliye suraj ke bade konon par
Dialogue: 0,0:06:14.68,0:06:16.82,Default,,0,0,0,,chhaya andar ki taraf simat jaati
Dialogue: 0,0:06:16.82,0:06:17.04,Default,,0,0,0,,hai.
Dialogue: 0,0:06:17.04,0:06:19.39,Default,,0,0,0,,Bahar khule maidaan mein lambi parchhai
Dialogue: 0,0:06:19.39,0:06:20.25,Default,,0,0,0,,nahi bichhti.
Dialogue: 0,0:06:20.25,0:06:21.54,Default,,0,0,0,,Toh aankh ko lagta hai,
Dialogue: 0,0:06:21.54,0:06:22.39,Default,,0,0,0,,parchhai gayab hai.
Dialogue: 0,0:06:22.39,0:06:23.68,Default,,0,0,0,,Vishleshak kehte hain,
Dialogue: 0,0:06:23.68,0:06:24.96,Default,,0,0,0,,woh bas chhupi hui hai.
Dialogue: 0,0:06:25.41,0:06:27.10,Default,,0,0,0,,Bhakton ka jawab bhi suniye.
Dialogue: 0,0:06:27.10,0:06:27.94,Default,,0,0,0,,Woh kehte hain,
Dialogue: 0,0:06:27.94,0:06:29.84,Default,,0,0,0,,sadiyon pehle aisi naap tol khud
Dialogue: 0,0:06:29.84,0:06:30.89,Default,,0,0,0,,ek chamatkar hai.
Dialogue: 0,0:06:30.89,0:06:33.21,Default,,0,0,0,,Kisi ne itna sochkar shikhar banaya
Dialogue: 0,0:06:33.21,0:06:34.89,Default,,0,0,0,,ki chhaya bhi andar hi rahe.
Dialogue: 0,0:06:34.89,0:06:37.00,Default,,0,0,0,,Yahan vigyan aur shraddha jaise ek
Dialogue: 0,0:06:37.00,0:06:38.69,Default,,0,0,0,,hi baat ko alag shabdon mein
Dialogue: 0,0:06:38.69,0:06:39.53,Default,,0,0,0,,keh rahe hain.
Dialogue: 0,0:06:39.98,0:06:41.96,Default,,0,0,0,,Ab Neela Chakra ka rahasya.
Dialogue: 0,0:06:41.96,0:06:42.62,Default,,0,0,0,,Kehte hain,
Dialogue: 0,0:06:42.62,0:06:44.60,Default,,0,0,0,,Puri mein kahin se bhi dekho,
Dialogue: 0,0:06:44.60,0:06:46.58,Default,,0,0,0,,chakra aapki taraf hi mukh kiye
Dialogue: 0,0:06:46.58,0:06:47.24,Default,,0,0,0,,dikhta hai.
Dialogue: 0,0:06:47.24,0:06:47.90,Default,,0,0,0,,Purab se,
Dialogue: 0,0:06:47.90,0:06:48.56,Default,,0,0,0,,paschim se,
Dialogue: 0,0:06:48.56,0:06:49.88,Default,,0,0,0,,kisi bhi gali se.
Dialogue: 0,0:06:49.88,0:06:51.64,Default,,0,0,0,,Jaise woh har bhakt ko seedha
Dialogue: 0,0:06:51.64,0:06:52.52,Default,,0,0,0,,dekh raha ho.
Dialogue: 0,0:06:52.52,0:06:54.06,Default,,0,0,0,,Bachche bhi ghoom ghoom kar yeh
Dialogue: 0,0:06:54.06,0:06:54.94,Default,,0,0,0,,khel khelte hain.
Dialogue: 0,0:06:55.39,0:06:57.19,Default,,0,0,0,,ASI ke records ek dilchasp baat
Dialogue: 0,0:06:57.19,0:06:57.99,Default,,0,0,0,,batate hain.
Dialogue: 0,0:06:57.99,0:07:00.19,Default,,0,0,0,,Chakra ka bahari ghera har mukhya
Dialogue: 0,0:07:00.19,0:07:01.79,Default,,0,0,0,,disha ki taraf khula hai.
Dialogue: 0,0:07:01.79,0:07:03.59,Default,,0,0,0,,Iska dhancha aisa hai ki har
Dialogue: 0,0:07:03.59,0:07:05.39,Default,,0,0,0,,taraf se woh lagbhag ek jaisa
Dialogue: 0,0:07:05.39,0:07:05.79,Default,,0,0,0,,dikhe.
Dialogue: 0,0:07:05.79,0:07:07.99,Default,,0,0,0,,Toh geometry yaani aakaar ka ganit,
Dialogue: 0,0:07:07.99,0:07:10.39,Default,,0,0,0,,is ehsaas mein badi bhoomika nibhaata
Dialogue: 0,0:07:10.39,0:07:10.59,Default,,0,0,0,,hai.
Dialogue: 0,0:07:11.04,0:07:12.22,Default,,0,0,0,,Phir bhi bhakt ke liye yeh
Dialogue: 0,0:07:12.22,0:07:13.79,Default,,0,0,0,,sirf dhatu ka pahiya nahi.
Dialogue: 0,0:07:13.79,0:07:15.75,Default,,0,0,0,,Neela Chakra par jhanda bandhta hai,
Dialogue: 0,0:07:15.75,0:07:17.13,Default,,0,0,0,,aur door se hi log pranaam
Dialogue: 0,0:07:17.13,0:07:17.71,Default,,0,0,0,,karte hain.
Dialogue: 0,0:07:17.71,0:07:19.68,Default,,0,0,0,,Kai pilgrims mandir ke andar nahi
Dialogue: 0,0:07:19.68,0:07:20.27,Default,,0,0,0,,ja paate.
Dialogue: 0,0:07:20.27,0:07:22.03,Default,,0,0,0,,Unke liye chakra ka darshan hi
Dialogue: 0,0:07:22.03,0:07:23.80,Default,,0,0,0,,poora darshan maana jaata hai.
Dialogue: 0,0:07:24.25,0:07:26.30,Default,,0,0,0,,Ab chaliye mandir ki rasoi mein,
Dialogue: 0,0:07:26.30,0:07:28.36,Default,,0,0,0,,jahan Mahaprasad banta hai.
Dialogue: 0,0:07:28.36,0:07:31.10,Default,,0,0,0,,Mahaprasad yaani Bhagwan ko chadhaya gaya
Dialogue: 0,0:07:31.10,0:07:32.24,Default,,0,0,0,,pavitra bhojan.
Dialogue: 0,0:07:32.24,0:07:34.29,Default,,0,0,0,,Yahan mitti ke matke ek ke
Dialogue: 0,0:07:34.29,0:07:36.12,Default,,0,0,0,,upar ek rakh kar lakdi ki
Dialogue: 0,0:07:36.12,0:07:37.72,Default,,0,0,0,,aanch par pakaye jaate hain.
Dialogue: 0,0:07:37.72,0:07:39.77,Default,,0,0,0,,Aur yahin hai ek aur rahasya.
Dialogue: 0,0:07:40.22,0:07:41.84,Default,,0,0,0,,Rasoi ke sevak kehte hain,
Dialogue: 0,0:07:41.84,0:07:44.28,Default,,0,0,0,,sabse upar wala matka sabse pehle
Dialogue: 0,0:07:44.28,0:07:44.89,Default,,0,0,0,,pakta hai.
Dialogue: 0,0:07:44.89,0:07:46.51,Default,,0,0,0,,Jabki aag sabse neeche hai.
Dialogue: 0,0:07:46.51,0:07:47.73,Default,,0,0,0,,Ulta lagta hai na?
Dialogue: 0,0:07:47.73,0:07:51.18,Default,,0,0,0,,Centre for Culinary Heritage Documentation ne
Dialogue: 0,0:07:51.18,0:07:52.61,Default,,0,0,0,,is par bahas darj ki hai.
Dialogue: 0,0:07:52.61,0:07:54.43,Default,,0,0,0,,Ek taraf rasoiye ka anubhav,
Dialogue: 0,0:07:54.43,0:07:56.26,Default,,0,0,0,,doosri taraf physics ke sawaal.
Dialogue: 0,0:07:56.71,0:07:57.94,Default,,0,0,0,,Physicists kehte hain,
Dialogue: 0,0:07:57.94,0:07:59.38,Default,,0,0,0,,yeh convection ka khel hai.
Dialogue: 0,0:07:59.38,0:08:01.65,Default,,0,0,0,,Convection yaani garam bhaap ka upar
Dialogue: 0,0:08:01.65,0:08:03.50,Default,,0,0,0,,uthna aur garmi saath le jaana.
Dialogue: 0,0:08:03.50,0:08:05.76,Default,,0,0,0,,Mitti ke matke chhidradaar hote hain,
Dialogue: 0,0:08:05.76,0:08:07.82,Default,,0,0,0,,yaani unmein bareek chhed hote hain.
Dialogue: 0,0:08:07.82,0:08:09.67,Default,,0,0,0,,Bhaap in chhedon se upar uthti
Dialogue: 0,0:08:09.67,0:08:09.88,Default,,0,0,0,,hai,
Dialogue: 0,0:08:09.88,0:08:11.73,Default,,0,0,0,,aur poora dher ek bhatti jaisa
Dialogue: 0,0:08:11.73,0:08:12.55,Default,,0,0,0,,ban jaata hai.
Dialogue: 0,0:08:13.00,0:08:14.74,Default,,0,0,0,,Is bhatti mein garmi kis kram
Dialogue: 0,0:08:14.74,0:08:15.83,Default,,0,0,0,,mein pahunchti hai,
Dialogue: 0,0:08:15.83,0:08:17.56,Default,,0,0,0,,is par abhi bhi bahas hai.
Dialogue: 0,0:08:17.56,0:08:19.52,Default,,0,0,0,,Rasoiye apni baat par atal hain.
Dialogue: 0,0:08:19.52,0:08:20.82,Default,,0,0,0,,Vaigyanik kehte hain,
Dialogue: 0,0:08:20.82,0:08:23.00,Default,,0,0,0,,naap ke bina nishchit kehna mushkil
Dialogue: 0,0:08:23.00,0:08:23.22,Default,,0,0,0,,hai.
Dialogue: 0,0:08:23.22,0:08:25.82,Default,,0,0,0,,Aur Singhadwara par samundar ki awaaz
Dialogue: 0,0:08:25.82,0:08:26.69,Default,,0,0,0,,ka chup hona?
Dialogue: 0,0:08:26.69,0:08:29.08,Default,,0,0,0,,Uska koi naap abhi hamare saamne
Dialogue: 0,0:08:29.08,0:08:29.52,Default,,0,0,0,,nahi.
Dialogue: 0,0:08:29.97,0:08:31.65,Default,,0,0,0,,Ab woh baatein jo aaj bhi
Dialogue: 0,0:08:31.65,0:08:32.86,Default,,0,0,0,,koi nahi jaanta.
Dialogue: 0,0:08:32.86,0:08:35.74,Default,,0,0,0,,Itna bhaari chakra itne oonche shikhar
Dialogue: 0,0:08:35.74,0:08:37.19,Default,,0,0,0,,par kaise chadhaya gaya?
Dialogue: 0,0:08:37.19,0:08:40.31,Default,,0,0,0,,Madhyakaal ke us engineering tareeke ka
Dialogue: 0,0:08:40.31,0:08:42.48,Default,,0,0,0,,koi poora record nahi milta.
Dialogue: 0,0:08:42.48,0:08:43.44,Default,,0,0,0,,Na koi naksha,
Dialogue: 0,0:08:43.44,0:08:45.12,Default,,0,0,0,,na koi likha hua hisaab.
Dialogue: 0,0:08:45.12,0:08:47.05,Default,,0,0,0,,Yeh sawaal abhi khula hai.
Dialogue: 0,0:08:47.50,0:08:48.69,Default,,0,0,0,,Aur ek khula sawaal,
Dialogue: 0,0:08:48.69,0:08:50.28,Default,,0,0,0,,shikhar ke upar ki hawa.
Dialogue: 0,0:08:50.28,0:08:52.06,Default,,0,0,0,,Wahan hawa kaise ghoomti hai,
Dialogue: 0,0:08:52.06,0:08:54.44,Default,,0,0,0,,iska poora vaigyanik model abhi tak
Dialogue: 0,0:08:54.44,0:08:55.24,Default,,0,0,0,,nahi bana.
Dialogue: 0,0:08:55.24,0:08:57.42,Default,,0,0,0,,Model yaani computer par hawa ki
Dialogue: 0,0:08:57.42,0:08:58.21,Default,,0,0,0,,chaal ka hisaab.
Dialogue: 0,0:08:58.21,0:08:59.60,Default,,0,0,0,,Jab tak woh nahi banta,
Dialogue: 0,0:08:59.60,0:09:01.98,Default,,0,0,0,,jhande ki poori kahani adhoori hai.
Dialogue: 0,0:09:02.43,0:09:03.89,Default,,0,0,0,,Aaj aap Puri jaayein toh kya
Dialogue: 0,0:09:03.89,0:09:04.73,Default,,0,0,0,,dekh sakte hain?
Dialogue: 0,0:09:04.73,0:09:07.23,Default,,0,0,0,,Samundar kinare khade ho kar jhande
Dialogue: 0,0:09:07.23,0:09:08.28,Default,,0,0,0,,ki disha dekhiye.
Dialogue: 0,0:09:08.28,0:09:10.37,Default,,0,0,0,,Phir chehre par hawa mehsoos kijiye.
Dialogue: 0,0:09:10.37,0:09:12.66,Default,,0,0,0,,Dopahar ko mandir ki parchhai dhoondhiye.
Dialogue: 0,0:09:12.66,0:09:14.75,Default,,0,0,0,,Aur Neela Chakra ko alag alag
Dialogue: 0,0:09:14.75,0:09:15.79,Default,,0,0,0,,galiyon se dekhiye,
Dialogue: 0,0:09:15.79,0:09:16.63,Default,,0,0,0,,khud parakhiye.
Dialogue: 0,0:09:17.08,0:09:19.35,Default,,0,0,0,,Mandir ki mazboot pathar ki deewarein
Dialogue: 0,0:09:19.35,0:09:20.38,Default,,0,0,0,,aaj bhi khadi hain.
Dialogue: 0,0:09:20.38,0:09:22.85,Default,,0,0,0,,Inki dekhbhaal 1975 se ASI kar
Dialogue: 0,0:09:22.85,0:09:23.46,Default,,0,0,0,,raha hai.
Dialogue: 0,0:09:23.46,0:09:26.14,Default,,0,0,0,,Singhadwara ki taraf badhte hue samundar
Dialogue: 0,0:09:26.14,0:09:27.17,Default,,0,0,0,,ki awaaz suniye.
Dialogue: 0,0:09:27.17,0:09:28.82,Default,,0,0,0,,Khud tay kijiye ki aapko kya
Dialogue: 0,0:09:28.82,0:09:29.85,Default,,0,0,0,,mehsoos hota hai.
Dialogue: 0,0:09:29.85,0:09:31.50,Default,,0,0,0,,Sabut aapke saamne hoga,
Dialogue: 0,0:09:31.50,0:09:32.32,Default,,0,0,0,,faisla aapka.
Dialogue: 0,0:09:32.77,0:09:35.33,Default,,0,0,0,,Toh aapko kaunsa rahasya sabse zyada
Dialogue: 0,0:09:35.33,0:09:35.97,Default,,0,0,0,,khinchta hai?
Dialogue: 0,0:09:35.97,0:09:36.82,Default,,0,0,0,,Ulta jhanda,
Dialogue: 0,0:09:36.82,0:09:37.68,Default,,0,0,0,,chhupi parchhai,
Dialogue: 0,0:09:37.68,0:09:39.38,Default,,0,0,0,,ya har taraf dekhta chakra?
Dialogue: 0,0:09:39.38,0:09:41.09,Default,,0,0,0,,Comment mein bas ek shabd likhiye.
Dialogue: 0,0:09:41.09,0:09:42.80,Default,,0,0,0,,Aur agar aap Puri gaye hain,
Dialogue: 0,0:09:42.80,0:09:44.93,Default,,0,0,0,,toh zaroor bataiye ki aapne apni
Dialogue: 0,0:09:44.93,0:09:46.21,Default,,0,0,0,,aankhon se kya dekha.
Dialogue: 0,0:09:46.66,0:09:48.87,Default,,0,0,0,,Agli baar hum chalenge Gujarat ke
Dialogue: 0,0:09:48.87,0:09:50.07,Default,,0,0,0,,samundar kinare,
Dialogue: 0,0:09:50.07,0:09:50.47,Default,,0,0,0,,Dwarka.
Dialogue: 0,0:09:50.47,0:09:52.48,Default,,0,0,0,,Kehte hain wahan ek poora nagar
Dialogue: 0,0:09:52.48,0:09:53.68,Default,,0,0,0,,paani mein samaa gaya.
Dialogue: 0,0:09:53.68,0:09:54.28,Default,,0,0,0,,Gotakhor,
Dialogue: 0,0:09:54.28,0:09:55.08,Default,,0,0,0,,yaani divers,
Dialogue: 0,0:09:55.08,0:09:56.29,Default,,0,0,0,,wahan kya dhoondh kar laaye?
Dialogue: 0,0:09:56.29,0:09:58.09,Default,,0,0,0,,Aur us par vaigyanik kya kehte
Dialogue: 0,0:09:58.09,0:09:58.29,Default,,0,0,0,,hain?
Dialogue: 0,0:09:58.29,0:09:59.10,Default,,0,0,0,,Sabut ke saath,
Dialogue: 0,0:09:59.10,0:10:00.90,Default,,0,0,0,,agli kahani mein milte hain.
