Dialogue: 0,0:00:00.00,0:00:02.43,Default,,0,0,0,,Puri ke mandir ka jhanda hawa
Dialogue: 0,0:00:02.43,0:00:03.89,Default,,0,0,0,,ke ulte udta hai,
Dialogue: 0,0:00:03.89,0:00:05.35,Default,,0,0,0,,aisa log kehte hain.
Dialogue: 0,0:00:05.35,0:00:07.06,Default,,0,0,0,,Samundar se hawa aaye,
Dialogue: 0,0:00:07.06,0:00:09.49,Default,,0,0,0,,phir bhi jhanda samundar ki taraf
Dialogue: 0,0:00:09.49,0:00:10.46,Default,,0,0,0,,lehraata hai.
Dialogue: 0,0:00:10.46,0:00:12.41,Default,,0,0,0,,Sadiyon se pilgrims yeh dekh kar
Dialogue: 0,0:00:12.41,0:00:13.38,Default,,0,0,0,,haath jodte hain.
Dialogue: 0,0:00:13.38,0:00:15.57,Default,,0,0,0,,Aur aaj mausam vigyani bhi is
Dialogue: 0,0:00:15.57,0:00:17.52,Default,,0,0,0,,jhande ko dhyan se dekhte hain.
Dialogue: 0,0:00:17.97,0:00:20.12,Default,,0,0,0,,Yeh akela rahasya nahi hai.
Dialogue: 0,0:00:20.12,0:00:22.27,Default,,0,0,0,,Kehte hain mandir ki parchhai zameen
Dialogue: 0,0:00:22.27,0:00:23.35,Default,,0,0,0,,par nahi dikhti.
Dialogue: 0,0:00:23.35,0:00:25.29,Default,,0,0,0,,Shikhar ka chakra har disha se
Dialogue: 0,0:00:25.29,0:00:26.57,Default,,0,0,0,,aapko hi dekhta hai.
Dialogue: 0,0:00:26.57,0:00:28.73,Default,,0,0,0,,Rasoi mein sabse upar ka matka
Dialogue: 0,0:00:28.73,0:00:29.80,Default,,0,0,0,,pehle pakta hai.
Dialogue: 0,0:00:29.80,0:00:32.38,Default,,0,0,0,,Singhadwara paar karte hi samundar ki
Dialogue: 0,0:00:32.38,0:00:33.89,Default,,0,0,0,,awaaz chup ho jaati hai.
Dialogue: 0,0:00:34.34,0:00:36.41,Default,,0,0,0,,Is video mein har rahasya ke
Dialogue: 0,0:00:36.41,0:00:38.24,Default,,0,0,0,,saath dono pehlu milenge.
Dialogue: 0,0:00:38.24,0:00:39.85,Default,,0,0,0,,Ek taraf bhakt ki shraddha,
Dialogue: 0,0:00:39.85,0:00:41.92,Default,,0,0,0,,doosri taraf vigyan ka hisaab.
Dialogue: 0,0:00:41.92,0:00:44.44,Default,,0,0,0,,Hum kisi ko galat nahi kahenge.
Dialogue: 0,0:00:44.44,0:00:46.05,Default,,0,0,0,,Hum bas sabut rakhenge,
Dialogue: 0,0:00:46.05,0:00:47.66,Default,,0,0,0,,aur faisla aapka hoga.
Dialogue: 0,0:00:47.66,0:00:48.12,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:00:48.12,0:00:51.10,Default,,0,0,0,,Odisha ke samundar kinare chalte hain.
Dialogue: 0,0:00:51.55,0:00:53.26,Default,,0,0,0,,Pehle dekhte hain ki granth kya
Dialogue: 0,0:00:53.26,0:00:53.90,Default,,0,0,0,,kehte hain.
Dialogue: 0,0:00:53.90,0:00:56.04,Default,,0,0,0,,Skanda Purana ka ek hissa hai,
Dialogue: 0,0:00:56.04,0:00:57.11,Default,,0,0,0,,Utkala Khanda.
Dialogue: 0,0:00:57.11,0:00:59.46,Default,,0,0,0,,Utkala yaani purana Odisha.
Dialogue: 0,0:00:59.46,0:01:01.60,Default,,0,0,0,,Is hisse mein Puri ki mahima
Dialogue: 0,0:01:01.60,0:01:03.10,Default,,0,0,0,,vistaar se likhi gayi hai.
Dialogue: 0,0:01:03.10,0:01:04.81,Default,,0,0,0,,Aur yahan ek baat bahut khaas
Dialogue: 0,0:01:04.81,0:01:05.03,Default,,0,0,0,,hai,
Dialogue: 0,0:01:05.03,0:01:06.95,Default,,0,0,0,,jo poori kahani ki neev hai.
Dialogue: 0,0:01:07.40,0:01:11.38,Default,,0,0,0,,Skanda Purana Puri ko Purushottama Kshetra
Dialogue: 0,0:01:11.38,0:01:12.17,Default,,0,0,0,,kehta hai.
Dialogue: 0,0:01:12.17,0:01:14.83,Default,,0,0,0,,Kshetra yaani ek pavitra bhoomi,
Dialogue: 0,0:01:14.83,0:01:15.36,Default,,0,0,0,,ek tirth.
Dialogue: 0,0:01:15.36,0:01:18.01,Default,,0,0,0,,Granth ke anusaar Bhagwan har jagah
Dialogue: 0,0:01:18.01,0:01:18.27,Default,,0,0,0,,hain.
Dialogue: 0,0:01:18.27,0:01:20.40,Default,,0,0,0,,Phir bhi yeh kshetra sabse shreshth
Dialogue: 0,0:01:20.40,0:01:20.66,Default,,0,0,0,,hai.
Dialogue: 0,0:01:20.66,0:01:23.31,Default,,0,0,0,,Kyunki yeh jagah khud Parmeshwar ka
Dialogue: 0,0:01:23.31,0:01:24.64,Default,,0,0,0,,sharir ban gayi hai.
Dialogue: 0,0:01:25.09,0:01:27.12,Default,,0,0,0,,Zara is baat ko mehsoos kijiye.
Dialogue: 0,0:01:27.12,0:01:28.92,Default,,0,0,0,,Granth ke liye Puri sirf mandir
Dialogue: 0,0:01:28.92,0:01:30.49,Default,,0,0,0,,wala shehar nahi hai.
Dialogue: 0,0:01:30.49,0:01:31.39,Default,,0,0,0,,Yahan ki ret,
Dialogue: 0,0:01:31.39,0:01:32.97,Default,,0,0,0,,samundar ka kinara,
Dialogue: 0,0:01:32.97,0:01:34.77,Default,,0,0,0,,sab us divya roop ka hissa
Dialogue: 0,0:01:34.77,0:01:35.00,Default,,0,0,0,,hai.
Dialogue: 0,0:01:35.00,0:01:37.25,Default,,0,0,0,,Isliye pilgrims yahan zameen ko chhoo
Dialogue: 0,0:01:37.25,0:01:39.05,Default,,0,0,0,,kar maathe se lagaate hain.
Dialogue: 0,0:01:39.50,0:01:41.24,Default,,0,0,0,,Ab ek lokpriya kahani,
Dialogue: 0,0:01:41.24,0:01:43.48,Default,,0,0,0,,jo dadi-nani sunati hain.
Dialogue: 0,0:01:43.48,0:01:45.71,Default,,0,0,0,,Ek raja ko sapne mein Bhagwan
Dialogue: 0,0:01:45.71,0:01:46.71,Default,,0,0,0,,ka darshan hua.
Dialogue: 0,0:01:46.71,0:01:49.44,Default,,0,0,0,,Samundar mein ek divya lakdi tairti
Dialogue: 0,0:01:49.44,0:01:49.94,Default,,0,0,0,,hui aayi.
Dialogue: 0,0:01:49.94,0:01:52.43,Default,,0,0,0,,Usi lakdi se moortiyan banaayi gayin.
Dialogue: 0,0:01:52.43,0:01:55.41,Default,,0,0,0,,Yeh kahani pidhi dar pidhi zubaani
Dialogue: 0,0:01:55.41,0:01:56.90,Default,,0,0,0,,chali aa rahi hai.
Dialogue: 0,0:01:57.35,0:01:59.12,Default,,0,0,0,,Isi wajah se Jagannath,
Dialogue: 0,0:01:59.12,0:02:02.00,Default,,0,0,0,,Balabhadra aur Subhadra ki moortiyan lakdi
Dialogue: 0,0:02:02.00,0:02:02.44,Default,,0,0,0,,ki hain.
Dialogue: 0,0:02:02.44,0:02:04.21,Default,,0,0,0,,Pathar ya dhatu ki nahi.
Dialogue: 0,0:02:04.21,0:02:05.09,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:02:05.09,0:02:07.30,Default,,0,0,0,,yeh mandir apne niyam khud chalata
Dialogue: 0,0:02:07.30,0:02:07.52,Default,,0,0,0,,hai.
Dialogue: 0,0:02:07.52,0:02:09.51,Default,,0,0,0,,Aur yahin se shuru hote hain
Dialogue: 0,0:02:09.51,0:02:10.40,Default,,0,0,0,,woh rahasya,
Dialogue: 0,0:02:10.40,0:02:12.39,Default,,0,0,0,,jinke peeche hum aaj chalenge.
Dialogue: 0,0:02:12.84,0:02:14.83,Default,,0,0,0,,Ab granth se nikal kar napne
Dialogue: 0,0:02:14.83,0:02:17.07,Default,,0,0,0,,aur jaanchne ki duniya mein chalte
Dialogue: 0,0:02:17.07,0:02:17.32,Default,,0,0,0,,hain.
Dialogue: 0,0:02:17.32,0:02:19.81,Default,,0,0,0,,Archaeological Survey of India,
Dialogue: 0,0:02:19.81,0:02:20.80,Default,,0,0,0,,yaani ASI,
Dialogue: 0,0:02:20.80,0:02:23.79,Default,,0,0,0,,desh ki purani imaaraton ki dekhbhaal
Dialogue: 0,0:02:23.79,0:02:24.53,Default,,0,0,0,,karta hai.
Dialogue: 0,0:02:24.53,0:02:26.53,Default,,0,0,0,,ASI ne is mandir ko kab
Dialogue: 0,0:02:26.53,0:02:27.77,Default,,0,0,0,,apne haath mein liya?
Dialogue: 0,0:02:27.77,0:02:29.76,Default,,0,0,0,,Jawab ek saal mein chhupa hai.
Dialogue: 0,0:02:30.21,0:02:30.91,Default,,0,0,0,,Saal tha 1975.
Dialogue: 0,0:02:30.91,0:02:33.49,Default,,0,0,0,,ASI ne Jagannath mandir ko rashtriya
Dialogue: 0,0:02:33.49,0:02:34.90,Default,,0,0,0,,sanrakshan mein le liya.
Dialogue: 0,0:02:34.90,0:02:37.72,Default,,0,0,0,,Sanrakshan yaani imaarat ko tootne se
Dialogue: 0,0:02:37.72,0:02:38.42,Default,,0,0,0,,bachana,
Dialogue: 0,0:02:38.42,0:02:40.06,Default,,0,0,0,,uski marammat karna.
Dialogue: 0,0:02:40.06,0:02:43.11,Default,,0,0,0,,Ek sarkari notification ke zariye yeh
Dialogue: 0,0:02:43.11,0:02:43.82,Default,,0,0,0,,faisla hua.
Dialogue: 0,0:02:43.82,0:02:46.40,Default,,0,0,0,,Tab se iski deewaron ki baakayda
Dialogue: 0,0:02:46.40,0:02:47.57,Default,,0,0,0,,dekhbhaal hoti hai.
Dialogue: 0,0:02:48.02,0:02:50.41,Default,,0,0,0,,ASI ke records ise sadiyon purana
Dialogue: 0,0:02:50.41,0:02:51.41,Default,,0,0,0,,mandir maante hain.
Dialogue: 0,0:02:51.41,0:02:53.60,Default,,0,0,0,,Iska dhancha Kalinga shaili ka hai.
Dialogue: 0,0:02:53.60,0:02:56.40,Default,,0,0,0,,Kalinga shaili yaani purane Odisha ki
Dialogue: 0,0:02:56.40,0:02:57.79,Default,,0,0,0,,apni khaas vaastukala.
Dialogue: 0,0:02:57.79,0:03:00.19,Default,,0,0,0,,Ismein shikhar upar jaate jaate patla
Dialogue: 0,0:03:00.19,0:03:00.78,Default,,0,0,0,,hota hai,
Dialogue: 0,0:03:00.78,0:03:02.58,Default,,0,0,0,,jaise kisi pahaad ki choti.
Dialogue: 0,0:03:03.03,0:03:05.10,Default,,0,0,0,,Is tarah ke oonche shikhar ko
Dialogue: 0,0:03:05.10,0:03:06.72,Default,,0,0,0,,Rekha Deula kehte hain.
Dialogue: 0,0:03:06.72,0:03:09.25,Default,,0,0,0,,Deula yaani mandir ka garbhgriha aur
Dialogue: 0,0:03:09.25,0:03:10.18,Default,,0,0,0,,uska shikhar.
Dialogue: 0,0:03:10.18,0:03:11.10,Default,,0,0,0,,Rekha isliye,
Dialogue: 0,0:03:11.10,0:03:14.10,Default,,0,0,0,,kyunki iski deewarein ek ghumaavdaar rekha
Dialogue: 0,0:03:14.10,0:03:15.48,Default,,0,0,0,,mein upar uthti hain.
Dialogue: 0,0:03:15.48,0:03:17.79,Default,,0,0,0,,Yahi ghumaav aage chal kar parchhai
Dialogue: 0,0:03:17.79,0:03:19.63,Default,,0,0,0,,ke rahasya mein kaam aayega.
Dialogue: 0,0:03:20.08,0:03:22.13,Default,,0,0,0,,Aur is shikhar ke sabse upar
Dialogue: 0,0:03:22.13,0:03:23.73,Default,,0,0,0,,baitha hai Neela Chakra.
Dialogue: 0,0:03:23.73,0:03:26.25,Default,,0,0,0,,Yeh Bhagwan Vishnu ke Sudarshan chakra
Dialogue: 0,0:03:26.25,0:03:28.07,Default,,0,0,0,,ka prateek maana jaata hai.
Dialogue: 0,0:03:28.07,0:03:30.35,Default,,0,0,0,,ASI ke records ke mutabik yeh
Dialogue: 0,0:03:30.35,0:03:32.18,Default,,0,0,0,,ashtadhatu se bana hai.
Dialogue: 0,0:03:32.18,0:03:34.92,Default,,0,0,0,,Ashtadhatu yaani kai dhatuon ko mila
Dialogue: 0,0:03:34.92,0:03:36.52,Default,,0,0,0,,kar banaya gaya ek mishran.
Dialogue: 0,0:03:36.97,0:03:38.32,Default,,0,0,0,,Aur iska aakaar?
Dialogue: 0,0:03:38.32,0:03:39.67,Default,,0,0,0,,Lagbhag 3.5 metre.
Dialogue: 0,0:03:39.67,0:03:42.10,Default,,0,0,0,,Yaani ek lambe aadmi se bhi
Dialogue: 0,0:03:42.10,0:03:43.18,Default,,0,0,0,,kaafi bada.
Dialogue: 0,0:03:43.18,0:03:45.61,Default,,0,0,0,,Itna bhaari dhatu ka pahiya,
Dialogue: 0,0:03:45.61,0:03:47.50,Default,,0,0,0,,itne oonche shikhar par.
Dialogue: 0,0:03:47.50,0:03:48.04,Default,,0,0,0,,Sochiye,
Dialogue: 0,0:03:48.04,0:03:50.74,Default,,0,0,0,,aaj ki machinon ke bina ise
Dialogue: 0,0:03:50.74,0:03:53.44,Default,,0,0,0,,upar kaise pahunchaya gaya hoga.
Dialogue: 0,0:03:53.44,0:03:56.41,Default,,0,0,0,,Yahi sawaal hum aage phir uthayenge.
Dialogue: 0,0:03:56.86,0:03:58.13,Default,,0,0,0,,Log batate hain,
Dialogue: 0,0:03:58.13,0:04:00.15,Default,,0,0,0,,har roz ek sevak is shikhar
Dialogue: 0,0:04:00.15,0:04:01.17,Default,,0,0,0,,par chadhta hai.
Dialogue: 0,0:04:01.17,0:04:03.70,Default,,0,0,0,,Woh chakra ke paas purana jhanda
Dialogue: 0,0:04:03.70,0:04:04.71,Default,,0,0,0,,utaarta hai,
Dialogue: 0,0:04:04.71,0:04:05.73,Default,,0,0,0,,naya baandhta hai.
Dialogue: 0,0:04:05.73,0:04:08.26,Default,,0,0,0,,Sirf haathon aur pairon ke sahaare.
Dialogue: 0,0:04:08.26,0:04:10.29,Default,,0,0,0,,Neeche khade bhakt saans rok kar
Dialogue: 0,0:04:10.29,0:04:12.06,Default,,0,0,0,,yeh nazaara dekhte hain.
Dialogue: 0,0:04:12.51,0:04:14.30,Default,,0,0,0,,Ab pehla bada sawaal,
Dialogue: 0,0:04:14.30,0:04:16.09,Default,,0,0,0,,jo har pilgrim poochta hai.
Dialogue: 0,0:04:16.09,0:04:18.65,Default,,0,0,0,,Jhanda hawa ke ulte kyon udta
Dialogue: 0,0:04:18.65,0:04:18.91,Default,,0,0,0,,hai?
Dialogue: 0,0:04:18.91,0:04:21.21,Default,,0,0,0,,Is par bhakt aur vaigyanik alag
Dialogue: 0,0:04:21.21,0:04:22.75,Default,,0,0,0,,alag baat kehte hain.
Dialogue: 0,0:04:22.75,0:04:24.79,Default,,0,0,0,,Dono ki baat dhyan se suniye.
Dialogue: 0,0:04:24.79,0:04:26.58,Default,,0,0,0,,Pehle shraddha ka pehlu,
Dialogue: 0,0:04:26.58,0:04:28.63,Default,,0,0,0,,phir mausam vigyan ka hisaab.
Dialogue: 0,0:04:29.08,0:04:31.07,Default,,0,0,0,,Bhakton ke liye jawab seedha hai.
Dialogue: 0,0:04:31.07,0:04:32.62,Default,,0,0,0,,Yeh Bhagwan ki leela hai.
Dialogue: 0,0:04:32.62,0:04:34.61,Default,,0,0,0,,Jo jhanda prakriti ke niyam se
Dialogue: 0,0:04:34.61,0:04:35.50,Default,,0,0,0,,alag chale,
Dialogue: 0,0:04:35.50,0:04:36.83,Default,,0,0,0,,woh divya sanket hai.
Dialogue: 0,0:04:36.83,0:04:38.15,Default,,0,0,0,,Kai pilgrims kehte hain,
Dialogue: 0,0:04:38.15,0:04:40.59,Default,,0,0,0,,unhone apni aankhon se dekha hai.
Dialogue: 0,0:04:40.59,0:04:41.92,Default,,0,0,0,,Ret par khade ho kar,
Dialogue: 0,0:04:41.92,0:04:43.91,Default,,0,0,0,,chehre par samundar ki hawa,
Dialogue: 0,0:04:43.91,0:04:45.68,Default,,0,0,0,,aur jhanda ulti disha mein.
Dialogue: 0,0:04:46.13,0:04:48.68,Default,,0,0,0,,Ab India Meteorological Department,
Dialogue: 0,0:04:48.68,0:04:49.31,Default,,0,0,0,,yaani IMD,
Dialogue: 0,0:04:49.31,0:04:49.74,Default,,0,0,0,,ki baat.
Dialogue: 0,0:04:49.74,0:04:51.86,Default,,0,0,0,,IMD desh ka sarkari mausam vibhag
Dialogue: 0,0:04:51.86,0:04:52.07,Default,,0,0,0,,hai.
Dialogue: 0,0:04:52.07,0:04:54.40,Default,,0,0,0,,Uska kehna hai ki poorvi samundar
Dialogue: 0,0:04:54.40,0:04:56.74,Default,,0,0,0,,kinare par hawa ke chhote local
Dialogue: 0,0:04:56.74,0:04:57.80,Default,,0,0,0,,ghere bante hain.
Dialogue: 0,0:04:57.80,0:04:59.70,Default,,0,0,0,,Bade mausam ke saath sea breeze
Dialogue: 0,0:04:59.70,0:05:02.04,Default,,0,0,0,,aur garmi milkar yeh ghere banaate
Dialogue: 0,0:05:02.04,0:05:02.25,Default,,0,0,0,,hain.
Dialogue: 0,0:05:02.70,0:05:04.56,Default,,0,0,0,,Sea breeze yaani din mein samundar
Dialogue: 0,0:05:04.56,0:05:06.42,Default,,0,0,0,,se zameen ki taraf chalne wali
Dialogue: 0,0:05:06.42,0:05:07.16,Default,,0,0,0,,thandi hawa.
Dialogue: 0,0:05:07.16,0:05:08.83,Default,,0,0,0,,Shaam ko yeh aksar palat jaati
Dialogue: 0,0:05:08.83,0:05:09.02,Default,,0,0,0,,hai,
Dialogue: 0,0:05:09.02,0:05:10.69,Default,,0,0,0,,zameen se samundar ki taraf.
Dialogue: 0,0:05:10.69,0:05:12.55,Default,,0,0,0,,Toh kinare par hawa ki disha
Dialogue: 0,0:05:12.55,0:05:13.66,Default,,0,0,0,,badalti rehti hai.
Dialogue: 0,0:05:13.66,0:05:15.52,Default,,0,0,0,,Neeche jo hawa aap mehsoos karte
Dialogue: 0,0:05:15.52,0:05:15.71,Default,,0,0,0,,hain,
Dialogue: 0,0:05:15.71,0:05:17.38,Default,,0,0,0,,upar woh alag ho sakti hai.
Dialogue: 0,0:05:17.83,0:05:19.10,Default,,0,0,0,,Ek aur wajah hai,
Dialogue: 0,0:05:19.10,0:05:20.11,Default,,0,0,0,,thermal eddy.
Dialogue: 0,0:05:20.11,0:05:22.90,Default,,0,0,0,,Thermal eddy yaani garam satah ke
Dialogue: 0,0:05:22.90,0:05:25.18,Default,,0,0,0,,paas ghoomti hui hawa ki bhanwar.
Dialogue: 0,0:05:25.18,0:05:27.71,Default,,0,0,0,,Mandir ka ghumaavdaar shikhar dhoop mein
Dialogue: 0,0:05:27.71,0:05:28.98,Default,,0,0,0,,garam hota hai.
Dialogue: 0,0:05:28.98,0:05:31.26,Default,,0,0,0,,Uske aas paas hawa mudti hai,
Dialogue: 0,0:05:31.26,0:05:32.02,Default,,0,0,0,,ghoomti hai.
Dialogue: 0,0:05:32.02,0:05:34.80,Default,,0,0,0,,Upar jhanda isi ghoomti hawa ke
Dialogue: 0,0:05:34.80,0:05:36.07,Default,,0,0,0,,saath lehraata hai.
Dialogue: 0,0:05:36.52,0:05:38.22,Default,,0,0,0,,Toh vaigyanik kehte hain,
Dialogue: 0,0:05:38.22,0:05:40.65,Default,,0,0,0,,jhanda asal mein upar ki hawa
Dialogue: 0,0:05:40.65,0:05:42.35,Default,,0,0,0,,ke saath hi ud raha hai.
Dialogue: 0,0:05:42.35,0:05:44.79,Default,,0,0,0,,Bas woh hawa zameen wali hawa
Dialogue: 0,0:05:44.79,0:05:45.76,Default,,0,0,0,,se ulti hai.
Dialogue: 0,0:05:45.76,0:05:46.73,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:05:46.73,0:05:48.92,Default,,0,0,0,,yeh vyakhya bhi usi leela ka
Dialogue: 0,0:05:48.92,0:05:49.65,Default,,0,0,0,,hissa hai.
Dialogue: 0,0:05:49.65,0:05:51.59,Default,,0,0,0,,Dono baatein aaj bhi saath saath
Dialogue: 0,0:05:51.59,0:05:52.32,Default,,0,0,0,,chalti hain.
Dialogue: 0,0:05:52.77,0:05:54.02,Default,,0,0,0,,Agla rahasya,
Dialogue: 0,0:05:54.02,0:05:54.78,Default,,0,0,0,,parchhai ka.
Dialogue: 0,0:05:54.78,0:05:55.78,Default,,0,0,0,,Log kehte hain,
Dialogue: 0,0:05:55.78,0:05:58.04,Default,,0,0,0,,din ke kisi bhi samay mandir
Dialogue: 0,0:05:58.04,0:06:00.54,Default,,0,0,0,,ki parchhai zameen par nahi dikhti.
Dialogue: 0,0:06:00.54,0:06:02.05,Default,,0,0,0,,Dopahar ho ya shaam,
Dialogue: 0,0:06:02.05,0:06:04.05,Default,,0,0,0,,shikhar ki chhaya ret par nahi
Dialogue: 0,0:06:04.05,0:06:04.56,Default,,0,0,0,,girti.
Dialogue: 0,0:06:04.56,0:06:06.56,Default,,0,0,0,,Yeh baat Puri ke har guide
Dialogue: 0,0:06:06.56,0:06:07.81,Default,,0,0,0,,ki zubaan par hai.
Dialogue: 0,0:06:07.81,0:06:09.57,Default,,0,0,0,,Par kya sach mein aisa hai?
Dialogue: 0,0:06:10.02,0:06:13.04,Default,,0,0,0,,Kalinga vaastukala par kaam karne wale
Dialogue: 0,0:06:13.04,0:06:14.43,Default,,0,0,0,,vishleshak kehte hain,
Dialogue: 0,0:06:14.43,0:06:16.06,Default,,0,0,0,,mandir parchhai daalta hai.
Dialogue: 0,0:06:16.06,0:06:18.38,Default,,0,0,0,,Bas woh parchhai wahan nahi girti
Dialogue: 0,0:06:18.38,0:06:19.78,Default,,0,0,0,,jahan hum dhoondhte hain.
Dialogue: 0,0:06:19.78,0:06:22.33,Default,,0,0,0,,Rekha Deula ka shikhar upar jaate
Dialogue: 0,0:06:22.33,0:06:23.96,Default,,0,0,0,,jaate patla hota hai.
Dialogue: 0,0:06:23.96,0:06:26.05,Default,,0,0,0,,Iski deewarein seedhi nahi,
Dialogue: 0,0:06:26.05,0:06:26.98,Default,,0,0,0,,ghumaavdaar hain.
Dialogue: 0,0:06:27.43,0:06:28.63,Default,,0,0,0,,Mandir ek chaudi,
Dialogue: 0,0:06:28.63,0:06:30.31,Default,,0,0,0,,oonchi neev par khada hai.
Dialogue: 0,0:06:30.31,0:06:31.99,Default,,0,0,0,,Isko podium kehte hain,
Dialogue: 0,0:06:31.99,0:06:34.63,Default,,0,0,0,,yaani imaarat ke neeche ka ooncha
Dialogue: 0,0:06:34.63,0:06:35.35,Default,,0,0,0,,chabutra.
Dialogue: 0,0:06:35.35,0:06:37.75,Default,,0,0,0,,Shikhar ki parchhai pehle apne hi
Dialogue: 0,0:06:37.75,0:06:38.95,Default,,0,0,0,,tiers par girti hai.
Dialogue: 0,0:06:38.95,0:06:41.35,Default,,0,0,0,,Tiers yaani deewar ki seedhiyon jaisi
Dialogue: 0,0:06:41.35,0:06:41.83,Default,,0,0,0,,parten.
Dialogue: 0,0:06:41.83,0:06:44.23,Default,,0,0,0,,Phir chabutre ki deewaron aur aas
Dialogue: 0,0:06:44.23,0:06:45.43,Default,,0,0,0,,paas ki chhaton par.
Dialogue: 0,0:06:45.88,0:06:47.88,Default,,0,0,0,,Mandir har mukhya disha ki seedh
Dialogue: 0,0:06:47.88,0:06:48.77,Default,,0,0,0,,mein bana hai.
Dialogue: 0,0:06:48.77,0:06:51.00,Default,,0,0,0,,Isliye suraj ke bade konon par
Dialogue: 0,0:06:51.00,0:06:53.22,Default,,0,0,0,,chhaya andar ki taraf simat jaati
Dialogue: 0,0:06:53.22,0:06:53.45,Default,,0,0,0,,hai.
Dialogue: 0,0:06:53.45,0:06:55.89,Default,,0,0,0,,Bahar khule maidaan mein lambi parchhai
Dialogue: 0,0:06:55.89,0:06:56.78,Default,,0,0,0,,nahi bichhti.
Dialogue: 0,0:06:56.78,0:06:58.12,Default,,0,0,0,,Toh aankh ko lagta hai,
Dialogue: 0,0:06:58.12,0:06:59.01,Default,,0,0,0,,parchhai gayab hai.
Dialogue: 0,0:06:59.01,0:07:00.35,Default,,0,0,0,,Vishleshak kehte hain,
Dialogue: 0,0:07:00.35,0:07:01.68,Default,,0,0,0,,woh bas chhupi hui hai.
Dialogue: 0,0:07:02.13,0:07:04.11,Default,,0,0,0,,Bhakton ka jawab bhi suniye.
Dialogue: 0,0:07:04.11,0:07:05.10,Default,,0,0,0,,Woh kehte hain,
Dialogue: 0,0:07:05.10,0:07:07.32,Default,,0,0,0,,sadiyon pehle aisi naap tol khud
Dialogue: 0,0:07:07.32,0:07:08.56,Default,,0,0,0,,ek chamatkar hai.
Dialogue: 0,0:07:08.56,0:07:11.27,Default,,0,0,0,,Kisi ne itna sochkar shikhar banaya
Dialogue: 0,0:07:11.27,0:07:13.25,Default,,0,0,0,,ki chhaya bhi andar hi rahe.
Dialogue: 0,0:07:13.25,0:07:15.72,Default,,0,0,0,,Yahan vigyan aur shraddha jaise ek
Dialogue: 0,0:07:15.72,0:07:17.70,Default,,0,0,0,,hi baat ko alag shabdon mein
Dialogue: 0,0:07:17.70,0:07:18.69,Default,,0,0,0,,keh rahe hain.
Dialogue: 0,0:07:19.14,0:07:21.42,Default,,0,0,0,,Ab Neela Chakra ka rahasya.
Dialogue: 0,0:07:21.42,0:07:22.18,Default,,0,0,0,,Kehte hain,
Dialogue: 0,0:07:22.18,0:07:24.45,Default,,0,0,0,,Puri mein kahin se bhi dekho,
Dialogue: 0,0:07:24.45,0:07:26.73,Default,,0,0,0,,chakra aapki taraf hi mukh kiye
Dialogue: 0,0:07:26.73,0:07:27.49,Default,,0,0,0,,dikhta hai.
Dialogue: 0,0:07:27.49,0:07:28.25,Default,,0,0,0,,Purab se,
Dialogue: 0,0:07:28.25,0:07:29.00,Default,,0,0,0,,paschim se,
Dialogue: 0,0:07:29.00,0:07:30.52,Default,,0,0,0,,kisi bhi gali se.
Dialogue: 0,0:07:30.52,0:07:32.55,Default,,0,0,0,,Jaise woh har bhakt ko seedha
Dialogue: 0,0:07:32.55,0:07:33.56,Default,,0,0,0,,dekh raha ho.
Dialogue: 0,0:07:33.56,0:07:35.33,Default,,0,0,0,,Bachche bhi ghoom ghoom kar yeh
Dialogue: 0,0:07:35.33,0:07:36.34,Default,,0,0,0,,khel khelte hain.
Dialogue: 0,0:07:36.79,0:07:38.90,Default,,0,0,0,,ASI ke records ek dilchasp baat
Dialogue: 0,0:07:38.90,0:07:39.83,Default,,0,0,0,,batate hain.
Dialogue: 0,0:07:39.83,0:07:42.41,Default,,0,0,0,,Chakra ka bahari ghera har mukhya
Dialogue: 0,0:07:42.41,0:07:44.29,Default,,0,0,0,,disha ki taraf khula hai.
Dialogue: 0,0:07:44.29,0:07:46.39,Default,,0,0,0,,Iska dhancha aisa hai ki har
Dialogue: 0,0:07:46.39,0:07:48.50,Default,,0,0,0,,taraf se woh lagbhag ek jaisa
Dialogue: 0,0:07:48.50,0:07:48.97,Default,,0,0,0,,dikhe.
Dialogue: 0,0:07:48.97,0:07:51.55,Default,,0,0,0,,Toh geometry yaani aakaar ka ganit,
Dialogue: 0,0:07:51.55,0:07:54.36,Default,,0,0,0,,is ehsaas mein badi bhoomika nibhaata
Dialogue: 0,0:07:54.36,0:07:54.59,Default,,0,0,0,,hai.
Dialogue: 0,0:07:55.04,0:07:56.41,Default,,0,0,0,,Phir bhi bhakt ke liye yeh
Dialogue: 0,0:07:56.41,0:07:58.24,Default,,0,0,0,,sirf dhatu ka pahiya nahi.
Dialogue: 0,0:07:58.24,0:08:00.52,Default,,0,0,0,,Neela Chakra par jhanda bandhta hai,
Dialogue: 0,0:08:00.52,0:08:02.12,Default,,0,0,0,,aur door se hi log pranaam
Dialogue: 0,0:08:02.12,0:08:02.80,Default,,0,0,0,,karte hain.
Dialogue: 0,0:08:02.80,0:08:05.09,Default,,0,0,0,,Kai pilgrims mandir ke andar nahi
Dialogue: 0,0:08:05.09,0:08:05.77,Default,,0,0,0,,ja paate.
Dialogue: 0,0:08:05.77,0:08:07.82,Default,,0,0,0,,Unke liye chakra ka darshan hi
Dialogue: 0,0:08:07.82,0:08:09.88,Default,,0,0,0,,poora darshan maana jaata hai.
Dialogue: 0,0:08:10.33,0:08:12.61,Default,,0,0,0,,Ab chaliye mandir ki rasoi mein,
Dialogue: 0,0:08:12.61,0:08:14.89,Default,,0,0,0,,jahan Mahaprasad banta hai.
Dialogue: 0,0:08:14.89,0:08:17.94,Default,,0,0,0,,Mahaprasad yaani Bhagwan ko chadhaya gaya
Dialogue: 0,0:08:17.94,0:08:19.20,Default,,0,0,0,,pavitra bhojan.
Dialogue: 0,0:08:19.20,0:08:21.49,Default,,0,0,0,,Yahan mitti ke matke ek ke
Dialogue: 0,0:08:21.49,0:08:23.51,Default,,0,0,0,,upar ek rakh kar lakdi ki
Dialogue: 0,0:08:23.51,0:08:25.29,Default,,0,0,0,,aanch par pakaye jaate hain.
Dialogue: 0,0:08:25.29,0:08:27.57,Default,,0,0,0,,Aur yahin hai ek aur rahasya.
Dialogue: 0,0:08:28.02,0:08:29.76,Default,,0,0,0,,Rasoi ke sevak kehte hain,
Dialogue: 0,0:08:29.76,0:08:32.36,Default,,0,0,0,,sabse upar wala matka sabse pehle
Dialogue: 0,0:08:32.36,0:08:33.02,Default,,0,0,0,,pakta hai.
Dialogue: 0,0:08:33.02,0:08:34.75,Default,,0,0,0,,Jabki aag sabse neeche hai.
Dialogue: 0,0:08:34.75,0:08:36.06,Default,,0,0,0,,Ulta lagta hai na?
Dialogue: 0,0:08:36.06,0:08:39.75,Default,,0,0,0,,Centre for Culinary Heritage Documentation ne
Dialogue: 0,0:08:39.75,0:08:41.27,Default,,0,0,0,,is par bahas darj ki hai.
Dialogue: 0,0:08:41.27,0:08:43.23,Default,,0,0,0,,Ek taraf rasoiye ka anubhav,
Dialogue: 0,0:08:43.23,0:08:45.18,Default,,0,0,0,,doosri taraf physics ke sawaal.
Dialogue: 0,0:08:45.63,0:08:46.96,Default,,0,0,0,,Physicists kehte hain,
Dialogue: 0,0:08:46.96,0:08:48.50,Default,,0,0,0,,yeh convection ka khel hai.
Dialogue: 0,0:08:48.50,0:08:50.93,Default,,0,0,0,,Convection yaani garam bhaap ka upar
Dialogue: 0,0:08:50.93,0:08:52.92,Default,,0,0,0,,uthna aur garmi saath le jaana.
Dialogue: 0,0:08:52.92,0:08:55.34,Default,,0,0,0,,Mitti ke matke chhidradaar hote hain,
Dialogue: 0,0:08:55.34,0:08:57.55,Default,,0,0,0,,yaani unmein bareek chhed hote hain.
Dialogue: 0,0:08:57.55,0:08:59.54,Default,,0,0,0,,Bhaap in chhedon se upar uthti
Dialogue: 0,0:08:59.54,0:08:59.76,Default,,0,0,0,,hai,
Dialogue: 0,0:08:59.76,0:09:01.75,Default,,0,0,0,,aur poora dher ek bhatti jaisa
Dialogue: 0,0:09:01.75,0:09:02.63,Default,,0,0,0,,ban jaata hai.
Dialogue: 0,0:09:03.08,0:09:04.92,Default,,0,0,0,,Is bhatti mein garmi kis kram
Dialogue: 0,0:09:04.92,0:09:06.07,Default,,0,0,0,,mein pahunchti hai,
Dialogue: 0,0:09:06.07,0:09:07.91,Default,,0,0,0,,is par abhi bhi bahas hai.
Dialogue: 0,0:09:07.91,0:09:09.98,Default,,0,0,0,,Rasoiye apni baat par atal hain.
Dialogue: 0,0:09:09.98,0:09:11.36,Default,,0,0,0,,Vaigyanik kehte hain,
Dialogue: 0,0:09:11.36,0:09:13.66,Default,,0,0,0,,naap ke bina nishchit kehna mushkil
Dialogue: 0,0:09:13.66,0:09:13.89,Default,,0,0,0,,hai.
Dialogue: 0,0:09:13.89,0:09:16.65,Default,,0,0,0,,Aur Singhadwara par samundar ki awaaz
Dialogue: 0,0:09:16.65,0:09:17.57,Default,,0,0,0,,ka chup hona?
Dialogue: 0,0:09:17.57,0:09:20.10,Default,,0,0,0,,Uska koi naap abhi hamare saamne
Dialogue: 0,0:09:20.10,0:09:20.56,Default,,0,0,0,,nahi.
Dialogue: 0,0:09:21.01,0:09:22.75,Default,,0,0,0,,Ab woh baatein jo aaj bhi
Dialogue: 0,0:09:22.75,0:09:24.00,Default,,0,0,0,,koi nahi jaanta.
Dialogue: 0,0:09:24.00,0:09:26.99,Default,,0,0,0,,Itna bhaari chakra itne oonche shikhar
Dialogue: 0,0:09:26.99,0:09:28.48,Default,,0,0,0,,par kaise chadhaya gaya?
Dialogue: 0,0:09:28.48,0:09:31.72,Default,,0,0,0,,Madhyakaal ke us engineering tareeke ka
Dialogue: 0,0:09:31.72,0:09:33.96,Default,,0,0,0,,koi poora record nahi milta.
Dialogue: 0,0:09:33.96,0:09:34.96,Default,,0,0,0,,Na koi naksha,
Dialogue: 0,0:09:34.96,0:09:36.70,Default,,0,0,0,,na koi likha hua hisaab.
Dialogue: 0,0:09:36.70,0:09:38.69,Default,,0,0,0,,Yeh sawaal abhi khula hai.
Dialogue: 0,0:09:39.14,0:09:40.62,Default,,0,0,0,,Aur ek khula sawaal,
Dialogue: 0,0:09:40.62,0:09:42.58,Default,,0,0,0,,shikhar ke upar ki hawa.
Dialogue: 0,0:09:42.58,0:09:44.80,Default,,0,0,0,,Wahan hawa kaise ghoomti hai,
Dialogue: 0,0:09:44.80,0:09:47.75,Default,,0,0,0,,iska poora vaigyanik model abhi tak
Dialogue: 0,0:09:47.75,0:09:48.74,Default,,0,0,0,,nahi bana.
Dialogue: 0,0:09:48.74,0:09:51.44,Default,,0,0,0,,Model yaani computer par hawa ki
Dialogue: 0,0:09:51.44,0:09:52.42,Default,,0,0,0,,chaal ka hisaab.
Dialogue: 0,0:09:52.42,0:09:54.15,Default,,0,0,0,,Jab tak woh nahi banta,
Dialogue: 0,0:09:54.15,0:09:57.10,Default,,0,0,0,,jhande ki poori kahani adhoori hai.
Dialogue: 0,0:09:57.55,0:09:59.16,Default,,0,0,0,,Aaj aap Puri jaayein toh kya
Dialogue: 0,0:09:59.16,0:10:00.09,Default,,0,0,0,,dekh sakte hain?
Dialogue: 0,0:10:00.09,0:10:02.85,Default,,0,0,0,,Samundar kinare khade ho kar jhande
Dialogue: 0,0:10:02.85,0:10:04.01,Default,,0,0,0,,ki disha dekhiye.
Dialogue: 0,0:10:04.01,0:10:06.31,Default,,0,0,0,,Phir chehre par hawa mehsoos kijiye.
Dialogue: 0,0:10:06.31,0:10:08.85,Default,,0,0,0,,Dopahar ko mandir ki parchhai dhoondhiye.
Dialogue: 0,0:10:08.85,0:10:11.15,Default,,0,0,0,,Aur Neela Chakra ko alag alag
Dialogue: 0,0:10:11.15,0:10:12.31,Default,,0,0,0,,galiyon se dekhiye,
Dialogue: 0,0:10:12.31,0:10:13.23,Default,,0,0,0,,khud parakhiye.
Dialogue: 0,0:10:13.68,0:10:16.43,Default,,0,0,0,,Mandir ki mazboot pathar ki deewarein
Dialogue: 0,0:10:16.43,0:10:17.68,Default,,0,0,0,,aaj bhi khadi hain.
Dialogue: 0,0:10:17.68,0:10:20.67,Default,,0,0,0,,Inki dekhbhaal 1975 se ASI kar
Dialogue: 0,0:10:20.67,0:10:21.42,Default,,0,0,0,,raha hai.
Dialogue: 0,0:10:21.42,0:10:24.67,Default,,0,0,0,,Singhadwara ki taraf badhte hue samundar
Dialogue: 0,0:10:24.67,0:10:25.92,Default,,0,0,0,,ki awaaz suniye.
Dialogue: 0,0:10:25.92,0:10:27.91,Default,,0,0,0,,Khud tay kijiye ki aapko kya
Dialogue: 0,0:10:27.91,0:10:29.16,Default,,0,0,0,,mehsoos hota hai.
Dialogue: 0,0:10:29.16,0:10:31.16,Default,,0,0,0,,Sabut aapke saamne hoga,
Dialogue: 0,0:10:31.16,0:10:32.16,Default,,0,0,0,,faisla aapka.
Dialogue: 0,0:10:32.61,0:10:35.62,Default,,0,0,0,,Toh aapko kaunsa rahasya sabse zyada
Dialogue: 0,0:10:35.62,0:10:36.37,Default,,0,0,0,,khinchta hai?
Dialogue: 0,0:10:36.37,0:10:37.38,Default,,0,0,0,,Ulta jhanda,
Dialogue: 0,0:10:37.38,0:10:38.38,Default,,0,0,0,,chhupi parchhai,
Dialogue: 0,0:10:38.38,0:10:40.38,Default,,0,0,0,,ya har taraf dekhta chakra?
Dialogue: 0,0:10:40.38,0:10:42.39,Default,,0,0,0,,Comment mein bas ek shabd likhiye.
Dialogue: 0,0:10:42.39,0:10:44.40,Default,,0,0,0,,Aur agar aap Puri gaye hain,
Dialogue: 0,0:10:44.40,0:10:46.90,Default,,0,0,0,,toh zaroor bataiye ki aapne apni
Dialogue: 0,0:10:46.90,0:10:48.41,Default,,0,0,0,,aankhon se kya dekha.
Dialogue: 0,0:10:48.86,0:10:51.73,Default,,0,0,0,,Agli baar hum chalenge Gujarat ke
Dialogue: 0,0:10:51.73,0:10:53.29,Default,,0,0,0,,samundar kinare,
Dialogue: 0,0:10:53.29,0:10:53.82,Default,,0,0,0,,Dwarka.
Dialogue: 0,0:10:53.82,0:10:56.42,Default,,0,0,0,,Kehte hain wahan ek poora nagar
Dialogue: 0,0:10:56.42,0:10:57.99,Default,,0,0,0,,paani mein samaa gaya.
Dialogue: 0,0:10:57.99,0:10:58.77,Default,,0,0,0,,Gotakhor,
Dialogue: 0,0:10:58.77,0:10:59.82,Default,,0,0,0,,yaani divers,
Dialogue: 0,0:10:59.82,0:11:01.38,Default,,0,0,0,,wahan kya dhoondh kar laaye?
Dialogue: 0,0:11:01.38,0:11:03.73,Default,,0,0,0,,Aur us par vaigyanik kya kehte
Dialogue: 0,0:11:03.73,0:11:03.99,Default,,0,0,0,,hain?
Dialogue: 0,0:11:03.99,0:11:05.03,Default,,0,0,0,,Sabut ke saath,
Dialogue: 0,0:11:05.03,0:11:07.38,Default,,0,0,0,,agli kahani mein milte hain.
