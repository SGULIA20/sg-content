Dialogue: 0,0:00:00.00,0:00:02.30,Default,,0,0,0,,Puri ke mandir ka jhanda hawa
Dialogue: 0,0:00:02.30,0:00:03.68,Default,,0,0,0,,ke ulte udta hai,
Dialogue: 0,0:00:03.68,0:00:05.06,Default,,0,0,0,,aisa log kehte hain.
Dialogue: 0,0:00:05.06,0:00:06.67,Default,,0,0,0,,Samundar se hawa aaye,
Dialogue: 0,0:00:06.67,0:00:08.97,Default,,0,0,0,,phir bhi jhanda samundar ki taraf
Dialogue: 0,0:00:08.97,0:00:09.89,Default,,0,0,0,,lehraata hai.
Dialogue: 0,0:00:09.89,0:00:11.73,Default,,0,0,0,,Sadiyon se pilgrims yeh dekh kar
Dialogue: 0,0:00:11.73,0:00:12.65,Default,,0,0,0,,haath jodte hain.
Dialogue: 0,0:00:12.65,0:00:14.72,Default,,0,0,0,,Aur aaj mausam vigyani bhi is
Dialogue: 0,0:00:14.72,0:00:16.56,Default,,0,0,0,,jhande ko dhyan se dekhte hain.
Dialogue: 0,0:00:17.01,0:00:19.19,Default,,0,0,0,,Yeh akela rahasya nahi hai.
Dialogue: 0,0:00:19.19,0:00:21.37,Default,,0,0,0,,Kehte hain mandir ki parchhai zameen
Dialogue: 0,0:00:21.37,0:00:22.46,Default,,0,0,0,,par nahi dikhti.
Dialogue: 0,0:00:22.46,0:00:24.42,Default,,0,0,0,,Shikhar ka chakra har disha se
Dialogue: 0,0:00:24.42,0:00:25.72,Default,,0,0,0,,aapko hi dekhta hai.
Dialogue: 0,0:00:25.72,0:00:27.90,Default,,0,0,0,,Rasoi mein sabse upar ka matka
Dialogue: 0,0:00:27.90,0:00:28.99,Default,,0,0,0,,pehle pakta hai.
Dialogue: 0,0:00:28.99,0:00:31.61,Default,,0,0,0,,Singhadwara paar karte hi samundar ki
Dialogue: 0,0:00:31.61,0:00:33.13,Default,,0,0,0,,awaaz chup ho jaati hai.
Dialogue: 0,0:00:33.58,0:00:35.53,Default,,0,0,0,,Is video mein har rahasya ke
Dialogue: 0,0:00:35.53,0:00:37.26,Default,,0,0,0,,saath dono pehlu milenge.
Dialogue: 0,0:00:37.26,0:00:38.77,Default,,0,0,0,,Ek taraf bhakt ki shraddha,
Dialogue: 0,0:00:38.77,0:00:40.72,Default,,0,0,0,,doosri taraf vigyan ka hisaab.
Dialogue: 0,0:00:40.72,0:00:43.10,Default,,0,0,0,,Hum kisi ko galat nahi kahenge.
Dialogue: 0,0:00:43.10,0:00:44.62,Default,,0,0,0,,Hum bas sabut rakhenge,
Dialogue: 0,0:00:44.62,0:00:46.13,Default,,0,0,0,,aur faisla aapka hoga.
Dialogue: 0,0:00:46.13,0:00:46.57,Default,,0,0,0,,Chaliye,
Dialogue: 0,0:00:46.57,0:00:49.38,Default,,0,0,0,,Odisha ke samundar kinare chalte hain.
Dialogue: 0,0:00:49.83,0:00:51.50,Default,,0,0,0,,Pehle dekhte hain ki granth kya
Dialogue: 0,0:00:51.50,0:00:52.13,Default,,0,0,0,,kehte hain.
Dialogue: 0,0:00:52.13,0:00:54.22,Default,,0,0,0,,Skanda Purana ka ek hissa hai,
Dialogue: 0,0:00:54.22,0:00:55.26,Default,,0,0,0,,Utkala Khanda.
Dialogue: 0,0:00:55.26,0:00:57.56,Default,,0,0,0,,Utkala yaani purana Odisha.
Dialogue: 0,0:00:57.56,0:00:59.65,Default,,0,0,0,,Is hisse mein Puri ki mahima
Dialogue: 0,0:00:59.65,0:01:01.11,Default,,0,0,0,,vistaar se likhi gayi hai.
Dialogue: 0,0:01:01.11,0:01:02.78,Default,,0,0,0,,Aur yahan ek baat bahut khaas
Dialogue: 0,0:01:02.78,0:01:02.99,Default,,0,0,0,,hai,
Dialogue: 0,0:01:02.99,0:01:04.87,Default,,0,0,0,,jo poori kahani ki neev hai.
Dialogue: 0,0:01:05.32,0:01:09.24,Default,,0,0,0,,Skanda Purana Puri ko Purushottama Kshetra
Dialogue: 0,0:01:09.24,0:01:10.03,Default,,0,0,0,,kehta hai.
Dialogue: 0,0:01:10.03,0:01:12.64,Default,,0,0,0,,Kshetra yaani ek pavitra bhoomi,
Dialogue: 0,0:01:12.64,0:01:13.17,Default,,0,0,0,,ek tirth.
Dialogue: 0,0:01:13.17,0:01:15.78,Default,,0,0,0,,Granth ke anusaar Bhagwan har jagah
Dialogue: 0,0:01:15.78,0:01:16.04,Default,,0,0,0,,hain.
Dialogue: 0,0:01:16.04,0:01:18.14,Default,,0,0,0,,Phir bhi yeh kshetra sabse shreshth
Dialogue: 0,0:01:18.14,0:01:18.40,Default,,0,0,0,,hai.
Dialogue: 0,0:01:18.40,0:01:21.01,Default,,0,0,0,,Kyunki yeh jagah khud Parmeshwar ka
Dialogue: 0,0:01:21.01,0:01:22.32,Default,,0,0,0,,sharir ban gayi hai.
Dialogue: 0,0:01:22.77,0:01:24.74,Default,,0,0,0,,Zara is baat ko mehsoos kijiye.
Dialogue: 0,0:01:24.74,0:01:26.50,Default,,0,0,0,,Granth ke liye Puri sirf mandir
Dialogue: 0,0:01:26.50,0:01:28.03,Default,,0,0,0,,wala shehar nahi hai.
Dialogue: 0,0:01:28.03,0:01:28.91,Default,,0,0,0,,Yahan ki ret,
Dialogue: 0,0:01:28.91,0:01:30.45,Default,,0,0,0,,samundar ka kinara,
Dialogue: 0,0:01:30.45,0:01:32.20,Default,,0,0,0,,sab us divya roop ka hissa
Dialogue: 0,0:01:32.20,0:01:32.42,Default,,0,0,0,,hai.
Dialogue: 0,0:01:32.42,0:01:34.61,Default,,0,0,0,,Isliye pilgrims yahan zameen ko chhoo
Dialogue: 0,0:01:34.61,0:01:36.37,Default,,0,0,0,,kar maathe se lagaate hain.
Dialogue: 0,0:01:36.82,0:01:38.47,Default,,0,0,0,,Ab ek lokpriya kahani,
Dialogue: 0,0:01:38.47,0:01:40.60,Default,,0,0,0,,jo dadi-nani sunati hain.
Dialogue: 0,0:01:40.60,0:01:42.72,Default,,0,0,0,,Ek raja ko sapne mein Bhagwan
Dialogue: 0,0:01:42.72,0:01:43.66,Default,,0,0,0,,ka darshan hua.
Dialogue: 0,0:01:43.66,0:01:46.26,Default,,0,0,0,,Samundar mein ek divya lakdi tairti
Dialogue: 0,0:01:46.26,0:01:46.73,Default,,0,0,0,,hui aayi.
Dialogue: 0,0:01:46.73,0:01:49.09,Default,,0,0,0,,Usi lakdi se moortiyan banaayi gayin.
Dialogue: 0,0:01:49.09,0:01:51.92,Default,,0,0,0,,Yeh kahani pidhi dar pidhi zubaani
Dialogue: 0,0:01:51.92,0:01:53.34,Default,,0,0,0,,chali aa rahi hai.
Dialogue: 0,0:01:53.79,0:01:55.49,Default,,0,0,0,,Isi wajah se Jagannath,
Dialogue: 0,0:01:55.49,0:01:58.26,Default,,0,0,0,,Balabhadra aur Subhadra ki moortiyan lakdi
Dialogue: 0,0:01:58.26,0:01:58.69,Default,,0,0,0,,ki hain.
Dialogue: 0,0:01:58.69,0:02:00.39,Default,,0,0,0,,Pathar ya dhatu ki nahi.
Dialogue: 0,0:02:00.39,0:02:01.24,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:02:01.24,0:02:03.37,Default,,0,0,0,,yeh mandir apne niyam khud chalata
Dialogue: 0,0:02:03.37,0:02:03.58,Default,,0,0,0,,hai.
Dialogue: 0,0:02:03.58,0:02:05.50,Default,,0,0,0,,Aur yahin se shuru hote hain
Dialogue: 0,0:02:05.50,0:02:06.35,Default,,0,0,0,,woh rahasya,
Dialogue: 0,0:02:06.35,0:02:08.27,Default,,0,0,0,,jinke peeche hum aaj chalenge.
Dialogue: 0,0:02:08.72,0:02:10.63,Default,,0,0,0,,Ab granth se nikal kar napne
Dialogue: 0,0:02:10.63,0:02:12.78,Default,,0,0,0,,aur jaanchne ki duniya mein chalte
Dialogue: 0,0:02:12.78,0:02:13.02,Default,,0,0,0,,hain.
Dialogue: 0,0:02:13.02,0:02:15.41,Default,,0,0,0,,Archaeological Survey of India,
Dialogue: 0,0:02:15.41,0:02:16.36,Default,,0,0,0,,yaani ASI,
Dialogue: 0,0:02:16.36,0:02:19.23,Default,,0,0,0,,desh ki purani imaaraton ki dekhbhaal
Dialogue: 0,0:02:19.23,0:02:19.94,Default,,0,0,0,,karta hai.
Dialogue: 0,0:02:19.94,0:02:21.85,Default,,0,0,0,,ASI ne is mandir ko kab
Dialogue: 0,0:02:21.85,0:02:23.05,Default,,0,0,0,,apne haath mein liya?
Dialogue: 0,0:02:23.05,0:02:24.96,Default,,0,0,0,,Jawab ek saal mein chhupa hai.
Dialogue: 0,0:02:25.41,0:02:26.06,Default,,0,0,0,,Saal tha 1975.
Dialogue: 0,0:02:26.06,0:02:28.46,Default,,0,0,0,,ASI ne Jagannath mandir ko rashtriya
Dialogue: 0,0:02:28.46,0:02:29.77,Default,,0,0,0,,sanrakshan mein le liya.
Dialogue: 0,0:02:29.77,0:02:32.38,Default,,0,0,0,,Sanrakshan yaani imaarat ko tootne se
Dialogue: 0,0:02:32.38,0:02:33.03,Default,,0,0,0,,bachana,
Dialogue: 0,0:02:33.03,0:02:34.56,Default,,0,0,0,,uski marammat karna.
Dialogue: 0,0:02:34.56,0:02:37.39,Default,,0,0,0,,Ek sarkari notification ke zariye yeh
Dialogue: 0,0:02:37.39,0:02:38.04,Default,,0,0,0,,faisla hua.
Dialogue: 0,0:02:38.04,0:02:40.44,Default,,0,0,0,,Tab se iski deewaron ki baakayda
Dialogue: 0,0:02:40.44,0:02:41.53,Default,,0,0,0,,dekhbhaal hoti hai.
Dialogue: 0,0:02:41.98,0:02:44.47,Default,,0,0,0,,ASI ke records ise sadiyon purana
Dialogue: 0,0:02:44.47,0:02:45.51,Default,,0,0,0,,mandir maante hain.
Dialogue: 0,0:02:45.51,0:02:47.79,Default,,0,0,0,,Iska dhancha Kalinga shaili ka hai.
Dialogue: 0,0:02:47.79,0:02:50.70,Default,,0,0,0,,Kalinga shaili yaani purane Odisha ki
Dialogue: 0,0:02:50.70,0:02:52.16,Default,,0,0,0,,apni khaas vaastukala.
Dialogue: 0,0:02:52.16,0:02:54.65,Default,,0,0,0,,Ismein shikhar upar jaate jaate patla
Dialogue: 0,0:02:54.65,0:02:55.27,Default,,0,0,0,,hota hai,
Dialogue: 0,0:02:55.27,0:02:57.14,Default,,0,0,0,,jaise kisi pahaad ki choti.
Dialogue: 0,0:02:57.59,0:02:59.34,Default,,0,0,0,,Is tarah ke oonche shikhar ko
Dialogue: 0,0:02:59.34,0:03:00.69,Default,,0,0,0,,Rekha Deula kehte hain.
Dialogue: 0,0:03:00.69,0:03:02.82,Default,,0,0,0,,Deula yaani mandir ka garbhgriha aur
Dialogue: 0,0:03:02.82,0:03:03.60,Default,,0,0,0,,uska shikhar.
Dialogue: 0,0:03:03.60,0:03:04.38,Default,,0,0,0,,Rekha isliye,
Dialogue: 0,0:03:04.38,0:03:06.90,Default,,0,0,0,,kyunki iski deewarein ek ghumaavdaar rekha
Dialogue: 0,0:03:06.90,0:03:08.06,Default,,0,0,0,,mein upar uthti hain.
Dialogue: 0,0:03:08.06,0:03:10.00,Default,,0,0,0,,Yahi ghumaav aage chal kar parchhai
Dialogue: 0,0:03:10.00,0:03:11.55,Default,,0,0,0,,ke rahasya mein kaam aayega.
Dialogue: 0,0:03:12.00,0:03:13.91,Default,,0,0,0,,Aur is shikhar ke sabse upar
Dialogue: 0,0:03:13.91,0:03:15.40,Default,,0,0,0,,baitha hai Neela Chakra.
Dialogue: 0,0:03:15.40,0:03:17.73,Default,,0,0,0,,Yeh Bhagwan Vishnu ke Sudarshan chakra
Dialogue: 0,0:03:17.73,0:03:19.43,Default,,0,0,0,,ka prateek maana jaata hai.
Dialogue: 0,0:03:19.43,0:03:21.55,Default,,0,0,0,,ASI ke records ke mutabik yeh
Dialogue: 0,0:03:21.55,0:03:23.25,Default,,0,0,0,,ashtadhatu se bana hai.
Dialogue: 0,0:03:23.25,0:03:25.79,Default,,0,0,0,,Ashtadhatu yaani kai dhatuon ko mila
Dialogue: 0,0:03:25.79,0:03:27.28,Default,,0,0,0,,kar banaya gaya ek mishran.
Dialogue: 0,0:03:27.73,0:03:28.94,Default,,0,0,0,,Aur iska aakaar?
Dialogue: 0,0:03:28.94,0:03:30.15,Default,,0,0,0,,Lagbhag 3.5 metre.
Dialogue: 0,0:03:30.15,0:03:32.32,Default,,0,0,0,,Yaani ek lambe aadmi se bhi
Dialogue: 0,0:03:32.32,0:03:33.29,Default,,0,0,0,,kaafi bada.
Dialogue: 0,0:03:33.29,0:03:35.46,Default,,0,0,0,,Itna bhaari dhatu ka pahiya,
Dialogue: 0,0:03:35.46,0:03:37.16,Default,,0,0,0,,itne oonche shikhar par.
Dialogue: 0,0:03:37.16,0:03:37.64,Default,,0,0,0,,Sochiye,
Dialogue: 0,0:03:37.64,0:03:40.06,Default,,0,0,0,,aaj ki machinon ke bina ise
Dialogue: 0,0:03:40.06,0:03:42.47,Default,,0,0,0,,upar kaise pahunchaya gaya hoga.
Dialogue: 0,0:03:42.47,0:03:45.13,Default,,0,0,0,,Yahi sawaal hum aage phir uthayenge.
Dialogue: 0,0:03:45.58,0:03:46.88,Default,,0,0,0,,Log batate hain,
Dialogue: 0,0:03:46.88,0:03:48.96,Default,,0,0,0,,har roz ek sevak is shikhar
Dialogue: 0,0:03:48.96,0:03:50.00,Default,,0,0,0,,par chadhta hai.
Dialogue: 0,0:03:50.00,0:03:52.60,Default,,0,0,0,,Woh chakra ke paas purana jhanda
Dialogue: 0,0:03:52.60,0:03:53.64,Default,,0,0,0,,utaarta hai,
Dialogue: 0,0:03:53.64,0:03:54.68,Default,,0,0,0,,naya baandhta hai.
Dialogue: 0,0:03:54.68,0:03:57.28,Default,,0,0,0,,Sirf haathon aur pairon ke sahaare.
Dialogue: 0,0:03:57.28,0:03:59.36,Default,,0,0,0,,Neeche khade bhakt saans rok kar
Dialogue: 0,0:03:59.36,0:04:01.18,Default,,0,0,0,,yeh nazaara dekhte hain.
Dialogue: 0,0:04:01.63,0:04:03.22,Default,,0,0,0,,Ab pehla bada sawaal,
Dialogue: 0,0:04:03.22,0:04:04.80,Default,,0,0,0,,jo har pilgrim poochta hai.
Dialogue: 0,0:04:04.80,0:04:07.07,Default,,0,0,0,,Jhanda hawa ke ulte kyon udta
Dialogue: 0,0:04:07.07,0:04:07.30,Default,,0,0,0,,hai?
Dialogue: 0,0:04:07.30,0:04:09.34,Default,,0,0,0,,Is par bhakt aur vaigyanik alag
Dialogue: 0,0:04:09.34,0:04:10.70,Default,,0,0,0,,alag baat kehte hain.
Dialogue: 0,0:04:10.70,0:04:12.51,Default,,0,0,0,,Dono ki baat dhyan se suniye.
Dialogue: 0,0:04:12.51,0:04:14.10,Default,,0,0,0,,Pehle shraddha ka pehlu,
Dialogue: 0,0:04:14.10,0:04:15.91,Default,,0,0,0,,phir mausam vigyan ka hisaab.
Dialogue: 0,0:04:16.36,0:04:18.39,Default,,0,0,0,,Bhakton ke liye jawab seedha hai.
Dialogue: 0,0:04:18.39,0:04:19.96,Default,,0,0,0,,Yeh Bhagwan ki leela hai.
Dialogue: 0,0:04:19.96,0:04:21.99,Default,,0,0,0,,Jo jhanda prakriti ke niyam se
Dialogue: 0,0:04:21.99,0:04:22.89,Default,,0,0,0,,alag chale,
Dialogue: 0,0:04:22.89,0:04:24.24,Default,,0,0,0,,woh divya sanket hai.
Dialogue: 0,0:04:24.24,0:04:25.59,Default,,0,0,0,,Kai pilgrims kehte hain,
Dialogue: 0,0:04:25.59,0:04:28.06,Default,,0,0,0,,unhone apni aankhon se dekha hai.
Dialogue: 0,0:04:28.06,0:04:29.41,Default,,0,0,0,,Ret par khade ho kar,
Dialogue: 0,0:04:29.41,0:04:31.44,Default,,0,0,0,,chehre par samundar ki hawa,
Dialogue: 0,0:04:31.44,0:04:33.24,Default,,0,0,0,,aur jhanda ulti disha mein.
Dialogue: 0,0:04:33.69,0:04:37.09,Default,,0,0,0,,Ab India Meteorological Department,
Dialogue: 0,0:04:37.09,0:04:37.94,Default,,0,0,0,,yaani IMD,
Dialogue: 0,0:04:37.94,0:04:38.51,Default,,0,0,0,,ki baat.
Dialogue: 0,0:04:38.51,0:04:41.35,Default,,0,0,0,,IMD desh ka sarkari mausam vibhag
Dialogue: 0,0:04:41.35,0:04:41.63,Default,,0,0,0,,hai.
Dialogue: 0,0:04:41.63,0:04:44.75,Default,,0,0,0,,Uska kehna hai ki poorvi samundar
Dialogue: 0,0:04:44.75,0:04:47.87,Default,,0,0,0,,kinare par hawa ke chhote local
Dialogue: 0,0:04:47.87,0:04:49.29,Default,,0,0,0,,ghere bante hain.
Dialogue: 0,0:04:49.29,0:04:51.85,Default,,0,0,0,,Bade mausam ke saath sea breeze
Dialogue: 0,0:04:51.85,0:04:54.97,Default,,0,0,0,,aur garmi milkar yeh ghere banaate
Dialogue: 0,0:04:54.97,0:04:55.25,Default,,0,0,0,,hain.
Dialogue: 0,0:04:55.70,0:04:58.22,Default,,0,0,0,,Sea breeze yaani din mein samundar
Dialogue: 0,0:04:58.22,0:05:00.73,Default,,0,0,0,,se zameen ki taraf chalne wali
Dialogue: 0,0:05:00.73,0:05:01.74,Default,,0,0,0,,thandi hawa.
Dialogue: 0,0:05:01.74,0:05:04.00,Default,,0,0,0,,Shaam ko yeh aksar palat jaati
Dialogue: 0,0:05:04.00,0:05:04.26,Default,,0,0,0,,hai,
Dialogue: 0,0:05:04.26,0:05:06.52,Default,,0,0,0,,zameen se samundar ki taraf.
Dialogue: 0,0:05:06.52,0:05:09.04,Default,,0,0,0,,Toh kinare par hawa ki disha
Dialogue: 0,0:05:09.04,0:05:10.55,Default,,0,0,0,,badalti rehti hai.
Dialogue: 0,0:05:10.55,0:05:13.06,Default,,0,0,0,,Neeche jo hawa aap mehsoos karte
Dialogue: 0,0:05:13.06,0:05:13.31,Default,,0,0,0,,hain,
Dialogue: 0,0:05:13.31,0:05:15.58,Default,,0,0,0,,upar woh alag ho sakti hai.
Dialogue: 0,0:05:16.03,0:05:17.13,Default,,0,0,0,,Ek aur wajah hai,
Dialogue: 0,0:05:17.13,0:05:18.00,Default,,0,0,0,,thermal eddy.
Dialogue: 0,0:05:18.00,0:05:20.42,Default,,0,0,0,,Thermal eddy yaani garam satah ke
Dialogue: 0,0:05:20.42,0:05:22.39,Default,,0,0,0,,paas ghoomti hui hawa ki bhanwar.
Dialogue: 0,0:05:22.39,0:05:24.59,Default,,0,0,0,,Mandir ka ghumaavdaar shikhar dhoop mein
Dialogue: 0,0:05:24.59,0:05:25.69,Default,,0,0,0,,garam hota hai.
Dialogue: 0,0:05:25.69,0:05:27.66,Default,,0,0,0,,Uske aas paas hawa mudti hai,
Dialogue: 0,0:05:27.66,0:05:28.32,Default,,0,0,0,,ghoomti hai.
Dialogue: 0,0:05:28.32,0:05:30.73,Default,,0,0,0,,Upar jhanda isi ghoomti hawa ke
Dialogue: 0,0:05:30.73,0:05:31.83,Default,,0,0,0,,saath lehraata hai.
Dialogue: 0,0:05:32.28,0:05:33.80,Default,,0,0,0,,Toh vaigyanik kehte hain,
Dialogue: 0,0:05:33.80,0:05:35.96,Default,,0,0,0,,jhanda asal mein upar ki hawa
Dialogue: 0,0:05:35.96,0:05:37.48,Default,,0,0,0,,ke saath hi ud raha hai.
Dialogue: 0,0:05:37.48,0:05:39.64,Default,,0,0,0,,Bas woh hawa zameen wali hawa
Dialogue: 0,0:05:39.64,0:05:40.51,Default,,0,0,0,,se ulti hai.
Dialogue: 0,0:05:40.51,0:05:41.38,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:05:41.38,0:05:43.33,Default,,0,0,0,,yeh vyakhya bhi usi leela ka
Dialogue: 0,0:05:43.33,0:05:43.98,Default,,0,0,0,,hissa hai.
Dialogue: 0,0:05:43.98,0:05:45.71,Default,,0,0,0,,Dono baatein aaj bhi saath saath
Dialogue: 0,0:05:45.71,0:05:46.36,Default,,0,0,0,,chalti hain.
Dialogue: 0,0:05:46.81,0:05:47.88,Default,,0,0,0,,Agla rahasya,
Dialogue: 0,0:05:47.88,0:05:48.51,Default,,0,0,0,,parchhai ka.
Dialogue: 0,0:05:48.51,0:05:49.37,Default,,0,0,0,,Log kehte hain,
Dialogue: 0,0:05:49.37,0:05:51.29,Default,,0,0,0,,din ke kisi bhi samay mandir
Dialogue: 0,0:05:51.29,0:05:53.42,Default,,0,0,0,,ki parchhai zameen par nahi dikhti.
Dialogue: 0,0:05:53.42,0:05:54.70,Default,,0,0,0,,Dopahar ho ya shaam,
Dialogue: 0,0:05:54.70,0:05:56.40,Default,,0,0,0,,shikhar ki chhaya ret par nahi
Dialogue: 0,0:05:56.40,0:05:56.83,Default,,0,0,0,,girti.
Dialogue: 0,0:05:56.83,0:05:58.53,Default,,0,0,0,,Yeh baat Puri ke har guide
Dialogue: 0,0:05:58.53,0:05:59.60,Default,,0,0,0,,ki zubaan par hai.
Dialogue: 0,0:05:59.60,0:06:01.09,Default,,0,0,0,,Par kya sach mein aisa hai?
Dialogue: 0,0:06:01.54,0:06:04.27,Default,,0,0,0,,Kalinga vaastukala par kaam karne wale
Dialogue: 0,0:06:04.27,0:06:05.54,Default,,0,0,0,,vishleshak kehte hain,
Dialogue: 0,0:06:05.54,0:06:07.01,Default,,0,0,0,,mandir parchhai daalta hai.
Dialogue: 0,0:06:07.01,0:06:09.12,Default,,0,0,0,,Bas woh parchhai wahan nahi girti
Dialogue: 0,0:06:09.12,0:06:10.38,Default,,0,0,0,,jahan hum dhoondhte hain.
Dialogue: 0,0:06:10.38,0:06:12.69,Default,,0,0,0,,Rekha Deula ka shikhar upar jaate
Dialogue: 0,0:06:12.69,0:06:14.17,Default,,0,0,0,,jaate patla hota hai.
Dialogue: 0,0:06:14.17,0:06:16.06,Default,,0,0,0,,Iski deewarein seedhi nahi,
Dialogue: 0,0:06:16.06,0:06:16.90,Default,,0,0,0,,ghumaavdaar hain.
Dialogue: 0,0:06:17.35,0:06:19.01,Default,,0,0,0,,Mandir ek chaudi,
Dialogue: 0,0:06:19.01,0:06:21.32,Default,,0,0,0,,oonchi neev par khada hai.
Dialogue: 0,0:06:21.32,0:06:23.64,Default,,0,0,0,,Isko podium kehte hain,
Dialogue: 0,0:06:23.64,0:06:27.29,Default,,0,0,0,,yaani imaarat ke neeche ka ooncha
Dialogue: 0,0:06:27.29,0:06:28.28,Default,,0,0,0,,chabutra.
Dialogue: 0,0:06:28.28,0:06:31.59,Default,,0,0,0,,Shikhar ki parchhai pehle apne hi
Dialogue: 0,0:06:31.59,0:06:33.25,Default,,0,0,0,,tiers par girti hai.
Dialogue: 0,0:06:33.25,0:06:36.56,Default,,0,0,0,,Tiers yaani deewar ki seedhiyon jaisi
Dialogue: 0,0:06:36.56,0:06:37.22,Default,,0,0,0,,parten.
Dialogue: 0,0:06:37.22,0:06:40.53,Default,,0,0,0,,Phir chabutre ki deewaron aur aas
Dialogue: 0,0:06:40.53,0:06:42.19,Default,,0,0,0,,paas ki chhaton par.
Dialogue: 0,0:06:42.64,0:06:44.69,Default,,0,0,0,,Mandir har mukhya disha ki seedh
Dialogue: 0,0:06:44.69,0:06:45.61,Default,,0,0,0,,mein bana hai.
Dialogue: 0,0:06:45.61,0:06:47.89,Default,,0,0,0,,Isliye suraj ke bade konon par
Dialogue: 0,0:06:47.89,0:06:50.17,Default,,0,0,0,,chhaya andar ki taraf simat jaati
Dialogue: 0,0:06:50.17,0:06:50.40,Default,,0,0,0,,hai.
Dialogue: 0,0:06:50.40,0:06:52.91,Default,,0,0,0,,Bahar khule maidaan mein lambi parchhai
Dialogue: 0,0:06:52.91,0:06:53.82,Default,,0,0,0,,nahi bichhti.
Dialogue: 0,0:06:53.82,0:06:55.19,Default,,0,0,0,,Toh aankh ko lagta hai,
Dialogue: 0,0:06:55.19,0:06:56.10,Default,,0,0,0,,parchhai gayab hai.
Dialogue: 0,0:06:56.10,0:06:57.47,Default,,0,0,0,,Vishleshak kehte hain,
Dialogue: 0,0:06:57.47,0:06:58.84,Default,,0,0,0,,woh bas chhupi hui hai.
Dialogue: 0,0:06:59.29,0:07:01.23,Default,,0,0,0,,Bhakton ka jawab bhi suniye.
Dialogue: 0,0:07:01.23,0:07:02.21,Default,,0,0,0,,Woh kehte hain,
Dialogue: 0,0:07:02.21,0:07:04.39,Default,,0,0,0,,sadiyon pehle aisi naap tol khud
Dialogue: 0,0:07:04.39,0:07:05.61,Default,,0,0,0,,ek chamatkar hai.
Dialogue: 0,0:07:05.61,0:07:08.28,Default,,0,0,0,,Kisi ne itna sochkar shikhar banaya
Dialogue: 0,0:07:08.28,0:07:10.22,Default,,0,0,0,,ki chhaya bhi andar hi rahe.
Dialogue: 0,0:07:10.22,0:07:12.65,Default,,0,0,0,,Yahan vigyan aur shraddha jaise ek
Dialogue: 0,0:07:12.65,0:07:14.60,Default,,0,0,0,,hi baat ko alag shabdon mein
Dialogue: 0,0:07:14.60,0:07:15.57,Default,,0,0,0,,keh rahe hain.
Dialogue: 0,0:07:16.02,0:07:17.94,Default,,0,0,0,,Ab Neela Chakra ka rahasya.
Dialogue: 0,0:07:17.94,0:07:18.58,Default,,0,0,0,,Kehte hain,
Dialogue: 0,0:07:18.58,0:07:20.50,Default,,0,0,0,,Puri mein kahin se bhi dekho,
Dialogue: 0,0:07:20.50,0:07:22.43,Default,,0,0,0,,chakra aapki taraf hi mukh kiye
Dialogue: 0,0:07:22.43,0:07:23.07,Default,,0,0,0,,dikhta hai.
Dialogue: 0,0:07:23.07,0:07:23.71,Default,,0,0,0,,Purab se,
Dialogue: 0,0:07:23.71,0:07:24.35,Default,,0,0,0,,paschim se,
Dialogue: 0,0:07:24.35,0:07:25.63,Default,,0,0,0,,kisi bhi gali se.
Dialogue: 0,0:07:25.63,0:07:27.34,Default,,0,0,0,,Jaise woh har bhakt ko seedha
Dialogue: 0,0:07:27.34,0:07:28.19,Default,,0,0,0,,dekh raha ho.
Dialogue: 0,0:07:28.19,0:07:29.69,Default,,0,0,0,,Bachche bhi ghoom ghoom kar yeh
Dialogue: 0,0:07:29.69,0:07:30.54,Default,,0,0,0,,khel khelte hain.
Dialogue: 0,0:07:30.99,0:07:33.58,Default,,0,0,0,,ASI ke records ek dilchasp baat
Dialogue: 0,0:07:33.58,0:07:34.73,Default,,0,0,0,,batate hain.
Dialogue: 0,0:07:34.73,0:07:37.90,Default,,0,0,0,,Chakra ka bahari ghera har mukhya
Dialogue: 0,0:07:37.90,0:07:40.20,Default,,0,0,0,,disha ki taraf khula hai.
Dialogue: 0,0:07:40.20,0:07:42.79,Default,,0,0,0,,Iska dhancha aisa hai ki har
Dialogue: 0,0:07:42.79,0:07:45.38,Default,,0,0,0,,taraf se woh lagbhag ek jaisa
Dialogue: 0,0:07:45.38,0:07:45.96,Default,,0,0,0,,dikhe.
Dialogue: 0,0:07:45.96,0:07:49.13,Default,,0,0,0,,Toh geometry yaani aakaar ka ganit,
Dialogue: 0,0:07:49.13,0:07:52.58,Default,,0,0,0,,is ehsaas mein badi bhoomika nibhaata
Dialogue: 0,0:07:52.58,0:07:52.87,Default,,0,0,0,,hai.
Dialogue: 0,0:07:53.32,0:07:54.64,Default,,0,0,0,,Phir bhi bhakt ke liye yeh
Dialogue: 0,0:07:54.64,0:07:56.40,Default,,0,0,0,,sirf dhatu ka pahiya nahi.
Dialogue: 0,0:07:56.40,0:07:58.61,Default,,0,0,0,,Neela Chakra par jhanda bandhta hai,
Dialogue: 0,0:07:58.61,0:08:00.15,Default,,0,0,0,,aur door se hi log pranaam
Dialogue: 0,0:08:00.15,0:08:00.81,Default,,0,0,0,,karte hain.
Dialogue: 0,0:08:00.81,0:08:03.01,Default,,0,0,0,,Kai pilgrims mandir ke andar nahi
Dialogue: 0,0:08:03.01,0:08:03.67,Default,,0,0,0,,ja paate.
Dialogue: 0,0:08:03.67,0:08:05.66,Default,,0,0,0,,Unke liye chakra ka darshan hi
Dialogue: 0,0:08:05.66,0:08:07.64,Default,,0,0,0,,poora darshan maana jaata hai.
Dialogue: 0,0:08:08.09,0:08:10.88,Default,,0,0,0,,Ab chaliye mandir ki rasoi mein,
Dialogue: 0,0:08:10.88,0:08:13.67,Default,,0,0,0,,jahan Mahaprasad banta hai.
Dialogue: 0,0:08:13.67,0:08:17.39,Default,,0,0,0,,Mahaprasad yaani Bhagwan ko chadhaya gaya
Dialogue: 0,0:08:17.39,0:08:18.94,Default,,0,0,0,,pavitra bhojan.
Dialogue: 0,0:08:18.94,0:08:21.73,Default,,0,0,0,,Yahan mitti ke matke ek ke
Dialogue: 0,0:08:21.73,0:08:24.21,Default,,0,0,0,,upar ek rakh kar lakdi ki
Dialogue: 0,0:08:24.21,0:08:26.38,Default,,0,0,0,,aanch par pakaye jaate hain.
Dialogue: 0,0:08:26.38,0:08:29.17,Default,,0,0,0,,Aur yahin hai ek aur rahasya.
Dialogue: 0,0:08:29.62,0:08:31.40,Default,,0,0,0,,Rasoi ke sevak kehte hain,
Dialogue: 0,0:08:31.40,0:08:34.07,Default,,0,0,0,,sabse upar wala matka sabse pehle
Dialogue: 0,0:08:34.07,0:08:34.73,Default,,0,0,0,,pakta hai.
Dialogue: 0,0:08:34.73,0:08:36.51,Default,,0,0,0,,Jabki aag sabse neeche hai.
Dialogue: 0,0:08:36.51,0:08:37.84,Default,,0,0,0,,Ulta lagta hai na?
Dialogue: 0,0:08:37.84,0:08:41.62,Default,,0,0,0,,Centre for Culinary Heritage Documentation ne
Dialogue: 0,0:08:41.62,0:08:43.18,Default,,0,0,0,,is par bahas darj ki hai.
Dialogue: 0,0:08:43.18,0:08:45.18,Default,,0,0,0,,Ek taraf rasoiye ka anubhav,
Dialogue: 0,0:08:45.18,0:08:47.18,Default,,0,0,0,,doosri taraf physics ke sawaal.
Dialogue: 0,0:08:47.63,0:08:48.87,Default,,0,0,0,,Physicists kehte hain,
Dialogue: 0,0:08:48.87,0:08:50.32,Default,,0,0,0,,yeh convection ka khel hai.
Dialogue: 0,0:08:50.32,0:08:52.59,Default,,0,0,0,,Convection yaani garam bhaap ka upar
Dialogue: 0,0:08:52.59,0:08:54.45,Default,,0,0,0,,uthna aur garmi saath le jaana.
Dialogue: 0,0:08:54.45,0:08:56.73,Default,,0,0,0,,Mitti ke matke chhidradaar hote hain,
Dialogue: 0,0:08:56.73,0:08:58.79,Default,,0,0,0,,yaani unmein bareek chhed hote hain.
Dialogue: 0,0:08:58.79,0:09:00.65,Default,,0,0,0,,Bhaap in chhedon se upar uthti
Dialogue: 0,0:09:00.65,0:09:00.86,Default,,0,0,0,,hai,
Dialogue: 0,0:09:00.86,0:09:02.72,Default,,0,0,0,,aur poora dher ek bhatti jaisa
Dialogue: 0,0:09:02.72,0:09:03.55,Default,,0,0,0,,ban jaata hai.
Dialogue: 0,0:09:04.00,0:09:05.67,Default,,0,0,0,,Is bhatti mein garmi kis kram
Dialogue: 0,0:09:05.67,0:09:06.72,Default,,0,0,0,,mein pahunchti hai,
Dialogue: 0,0:09:06.72,0:09:08.39,Default,,0,0,0,,is par abhi bhi bahas hai.
Dialogue: 0,0:09:08.39,0:09:10.27,Default,,0,0,0,,Rasoiye apni baat par atal hain.
Dialogue: 0,0:09:10.27,0:09:11.52,Default,,0,0,0,,Vaigyanik kehte hain,
Dialogue: 0,0:09:11.52,0:09:13.61,Default,,0,0,0,,naap ke bina nishchit kehna mushkil
Dialogue: 0,0:09:13.61,0:09:13.82,Default,,0,0,0,,hai.
Dialogue: 0,0:09:13.82,0:09:16.33,Default,,0,0,0,,Aur Singhadwara par samundar ki awaaz
Dialogue: 0,0:09:16.33,0:09:17.16,Default,,0,0,0,,ka chup hona?
Dialogue: 0,0:09:17.16,0:09:19.46,Default,,0,0,0,,Uska koi naap abhi hamare saamne
Dialogue: 0,0:09:19.46,0:09:19.88,Default,,0,0,0,,nahi.
Dialogue: 0,0:09:20.33,0:09:22.06,Default,,0,0,0,,Ab woh baatein jo aaj bhi
Dialogue: 0,0:09:22.06,0:09:23.29,Default,,0,0,0,,koi nahi jaanta.
Dialogue: 0,0:09:23.29,0:09:26.25,Default,,0,0,0,,Itna bhaari chakra itne oonche shikhar
Dialogue: 0,0:09:26.25,0:09:27.73,Default,,0,0,0,,par kaise chadhaya gaya?
Dialogue: 0,0:09:27.73,0:09:30.94,Default,,0,0,0,,Madhyakaal ke us engineering tareeke ka
Dialogue: 0,0:09:30.94,0:09:33.16,Default,,0,0,0,,koi poora record nahi milta.
Dialogue: 0,0:09:33.16,0:09:34.15,Default,,0,0,0,,Na koi naksha,
Dialogue: 0,0:09:34.15,0:09:35.88,Default,,0,0,0,,na koi likha hua hisaab.
Dialogue: 0,0:09:35.88,0:09:37.85,Default,,0,0,0,,Yeh sawaal abhi khula hai.
Dialogue: 0,0:09:38.30,0:09:39.52,Default,,0,0,0,,Aur ek khula sawaal,
Dialogue: 0,0:09:39.52,0:09:41.15,Default,,0,0,0,,shikhar ke upar ki hawa.
Dialogue: 0,0:09:41.15,0:09:42.98,Default,,0,0,0,,Wahan hawa kaise ghoomti hai,
Dialogue: 0,0:09:42.98,0:09:45.41,Default,,0,0,0,,iska poora vaigyanik model abhi tak
Dialogue: 0,0:09:45.41,0:09:46.23,Default,,0,0,0,,nahi bana.
Dialogue: 0,0:09:46.23,0:09:48.46,Default,,0,0,0,,Model yaani computer par hawa ki
Dialogue: 0,0:09:48.46,0:09:49.28,Default,,0,0,0,,chaal ka hisaab.
Dialogue: 0,0:09:49.28,0:09:50.70,Default,,0,0,0,,Jab tak woh nahi banta,
Dialogue: 0,0:09:50.70,0:09:53.14,Default,,0,0,0,,jhande ki poori kahani adhoori hai.
Dialogue: 0,0:09:53.59,0:09:55.12,Default,,0,0,0,,Aaj aap Puri jaayein toh kya
Dialogue: 0,0:09:55.12,0:09:55.99,Default,,0,0,0,,dekh sakte hain?
Dialogue: 0,0:09:55.99,0:09:58.61,Default,,0,0,0,,Samundar kinare khade ho kar jhande
Dialogue: 0,0:09:58.61,0:09:59.70,Default,,0,0,0,,ki disha dekhiye.
Dialogue: 0,0:09:59.70,0:10:01.88,Default,,0,0,0,,Phir chehre par hawa mehsoos kijiye.
Dialogue: 0,0:10:01.88,0:10:04.28,Default,,0,0,0,,Dopahar ko mandir ki parchhai dhoondhiye.
Dialogue: 0,0:10:04.28,0:10:06.47,Default,,0,0,0,,Aur Neela Chakra ko alag alag
Dialogue: 0,0:10:06.47,0:10:07.56,Default,,0,0,0,,galiyon se dekhiye,
Dialogue: 0,0:10:07.56,0:10:08.43,Default,,0,0,0,,khud parakhiye.
Dialogue: 0,0:10:08.88,0:10:11.37,Default,,0,0,0,,Mandir ki mazboot pathar ki deewarein
Dialogue: 0,0:10:11.37,0:10:12.50,Default,,0,0,0,,aaj bhi khadi hain.
Dialogue: 0,0:10:12.50,0:10:15.21,Default,,0,0,0,,Inki dekhbhaal 1975 se ASI kar
Dialogue: 0,0:10:15.21,0:10:15.88,Default,,0,0,0,,raha hai.
Dialogue: 0,0:10:15.88,0:10:18.82,Default,,0,0,0,,Singhadwara ki taraf badhte hue samundar
Dialogue: 0,0:10:18.82,0:10:19.95,Default,,0,0,0,,ki awaaz suniye.
Dialogue: 0,0:10:19.95,0:10:21.76,Default,,0,0,0,,Khud tay kijiye ki aapko kya
Dialogue: 0,0:10:21.76,0:10:22.89,Default,,0,0,0,,mehsoos hota hai.
Dialogue: 0,0:10:22.89,0:10:24.70,Default,,0,0,0,,Sabut aapke saamne hoga,
Dialogue: 0,0:10:24.70,0:10:25.60,Default,,0,0,0,,faisla aapka.
Dialogue: 0,0:10:26.05,0:10:28.85,Default,,0,0,0,,Toh aapko kaunsa rahasya sabse zyada
Dialogue: 0,0:10:28.85,0:10:29.54,Default,,0,0,0,,khinchta hai?
Dialogue: 0,0:10:29.54,0:10:30.48,Default,,0,0,0,,Ulta jhanda,
Dialogue: 0,0:10:30.48,0:10:31.41,Default,,0,0,0,,chhupi parchhai,
Dialogue: 0,0:10:31.41,0:10:33.27,Default,,0,0,0,,ya har taraf dekhta chakra?
Dialogue: 0,0:10:33.27,0:10:35.14,Default,,0,0,0,,Comment mein bas ek shabd likhiye.
Dialogue: 0,0:10:35.14,0:10:37.00,Default,,0,0,0,,Aur agar aap Puri gaye hain,
Dialogue: 0,0:10:37.00,0:10:39.33,Default,,0,0,0,,toh zaroor bataiye ki aapne apni
Dialogue: 0,0:10:39.33,0:10:40.73,Default,,0,0,0,,aankhon se kya dekha.
Dialogue: 0,0:10:41.18,0:10:43.48,Default,,0,0,0,,Agli baar hum chalenge Gujarat ke
Dialogue: 0,0:10:43.48,0:10:44.73,Default,,0,0,0,,samundar kinare,
Dialogue: 0,0:10:44.73,0:10:45.15,Default,,0,0,0,,Dwarka.
Dialogue: 0,0:10:45.15,0:10:47.24,Default,,0,0,0,,Kehte hain wahan ek poora nagar
Dialogue: 0,0:10:47.24,0:10:48.50,Default,,0,0,0,,paani mein samaa gaya.
Dialogue: 0,0:10:48.50,0:10:49.12,Default,,0,0,0,,Gotakhor,
Dialogue: 0,0:10:49.12,0:10:49.96,Default,,0,0,0,,yaani divers,
Dialogue: 0,0:10:49.96,0:10:51.21,Default,,0,0,0,,wahan kya dhoondh kar laaye?
Dialogue: 0,0:10:51.21,0:10:53.09,Default,,0,0,0,,Aur us par vaigyanik kya kehte
Dialogue: 0,0:10:53.09,0:10:53.30,Default,,0,0,0,,hain?
Dialogue: 0,0:10:53.30,0:10:54.14,Default,,0,0,0,,Sabut ke saath,
Dialogue: 0,0:10:54.14,0:10:56.02,Default,,0,0,0,,agli kahani mein milte hain.
