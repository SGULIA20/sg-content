Dialogue: 0,0:00:00.00,0:00:01.75,Default,,0,0,0,,Valmiki ki Ramayan kholo,
Dialogue: 0,0:00:01.75,0:00:04.16,Default,,0,0,0,,Surpanakha ke pati ko Ravan ne
Dialogue: 0,0:00:04.16,0:00:04.60,Default,,0,0,0,,maara.
Dialogue: 0,0:00:05.05,0:00:09.13,Default,,0,0,0,,Uttara Kanda mein naam hai Vidyutjihva.
Dialogue: 0,0:00:09.13,0:00:12.53,Default,,0,0,0,,Ravan ne vidhwa behen ko Dandak
Dialogue: 0,0:00:12.53,0:00:13.21,Default,,0,0,0,,bheja.
Dialogue: 0,0:00:13.66,0:00:15.97,Default,,0,0,0,,Toh kya Surpanakha villain thi,
Dialogue: 0,0:00:15.97,0:00:17.26,Default,,0,0,0,,ya dukhi vidhwa?
Dialogue: 0,0:00:17.71,0:00:20.22,Default,,0,0,0,,Panchavati mein woh Ram se shaadi
Dialogue: 0,0:00:20.22,0:00:20.98,Default,,0,0,0,,maangti hai.
Dialogue: 0,0:00:20.98,0:00:22.99,Default,,0,0,0,,Dono bhai mazaak karte hain.
Dialogue: 0,0:00:23.44,0:00:25.66,Default,,0,0,0,,Phir woh Sita par jhapatti.
Dialogue: 0,0:00:25.66,0:00:27.88,Default,,0,0,0,,Lakshman naak-kaan kaat dete hain.
Dialogue: 0,0:00:28.33,0:00:30.71,Default,,0,0,0,,Deogarh ke Gupta-kaal mandir mein,
Dialogue: 0,0:00:30.71,0:00:33.36,Default,,0,0,0,,ASI ko yahi drishya patthar par
Dialogue: 0,0:00:33.36,0:00:33.89,Default,,0,0,0,,mila.
Dialogue: 0,0:00:34.34,0:00:35.99,Default,,0,0,0,,Scholar bante hain:
Dialogue: 0,0:00:35.99,0:00:36.66,Default,,0,0,0,,badla,
Dialogue: 0,0:00:36.66,0:00:37.98,Default,,0,0,0,,ya sirf hamla?
Dialogue: 0,0:00:38.43,0:00:41.20,Default,,0,0,0,,Nashik ka naam 'naak' se jodte
Dialogue: 0,0:00:41.20,0:00:41.54,Default,,0,0,0,,hain,
Dialogue: 0,0:00:41.54,0:00:43.27,Default,,0,0,0,,yeh lok-katha hai.
Dialogue: 0,0:00:43.72,0:00:45.93,Default,,0,0,0,,Us dost ko bhejo jo Surpanakha
Dialogue: 0,0:00:45.93,0:00:47.25,Default,,0,0,0,,ko villain kehta hai.
Dialogue: 0,0:00:47.25,0:00:48.80,Default,,0,0,0,,Pehle padhe Valmiki.
