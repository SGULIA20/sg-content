Dialogue: 0,0:00:00.00,0:00:01.97,Default,,0,0,0,,Annabelle gudiya raat mein khud kamra
Dialogue: 0,0:00:01.97,0:00:02.68,Default,,0,0,0,,badalti thi?
Dialogue: 0,0:00:02.68,0:00:03.57,Default,,0,0,0,,Bistar par chhodo,
Dialogue: 0,0:00:03.57,0:00:04.82,Default,,0,0,0,,subah sofe par milti.
Dialogue: 0,0:00:05.27,0:00:05.67,Default,,0,0,0,,Saal 1970,
Dialogue: 0,0:00:05.67,0:00:06.48,Default,,0,0,0,,Connecticut.
Dialogue: 0,0:00:06.48,0:00:08.48,Default,,0,0,0,,Nursing student ko kapde ki gudiya
Dialogue: 0,0:00:08.48,0:00:09.09,Default,,0,0,0,,milti hai.
Dialogue: 0,0:00:09.09,0:00:10.89,Default,,0,0,0,,Phir ghar mein parche milne lagte
Dialogue: 0,0:00:10.89,0:00:11.10,Default,,0,0,0,,hain.
Dialogue: 0,0:00:11.55,0:00:13.24,Default,,0,0,0,,Haath se likhe parche.
Dialogue: 0,0:00:13.24,0:00:14.09,Default,,0,0,0,,Likha hai:
Dialogue: 0,0:00:14.09,0:00:15.21,Default,,0,0,0,,madad karo.
Dialogue: 0,0:00:15.21,0:00:16.34,Default,,0,0,0,,Likha kisne?
Dialogue: 0,0:00:16.79,0:00:18.05,Default,,0,0,0,,Medium bulaya jaata hai,
Dialogue: 0,0:00:18.05,0:00:19.84,Default,,0,0,0,,yaani aatmaon se baat ka daawedaar.
Dialogue: 0,0:00:19.84,0:00:20.56,Default,,0,0,0,,Woh kehta hai,
Dialogue: 0,0:00:20.56,0:00:22.36,Default,,0,0,0,,isme 7 saal ki Annabelle hai.
Dialogue: 0,0:00:22.81,0:00:24.83,Default,,0,0,0,,Phir aate hain bhoot-shikari Ed aur
Dialogue: 0,0:00:24.83,0:00:25.84,Default,,0,0,0,,Lorraine Warren.
Dialogue: 0,0:00:25.84,0:00:26.65,Default,,0,0,0,,Unka daawa:
Dialogue: 0,0:00:26.65,0:00:27.66,Default,,0,0,0,,yeh bachchi nahi,
Dialogue: 0,0:00:27.66,0:00:28.27,Default,,0,0,0,,shaitaan hai.
Dialogue: 0,0:00:28.72,0:00:29.69,Default,,0,0,0,,Warren kehte hain,
Dialogue: 0,0:00:29.69,0:00:31.24,Default,,0,0,0,,gudiya kharonche maarti hai.
Dialogue: 0,0:00:31.24,0:00:32.41,Default,,0,0,0,,Pavitra jal bekaar.
Dialogue: 0,0:00:32.41,0:00:34.16,Default,,0,0,0,,Ed banate hain sheeshe ka band
Dialogue: 0,0:00:34.16,0:00:34.55,Default,,0,0,0,,case.
Dialogue: 0,0:00:34.55,0:00:35.32,Default,,0,0,0,,Upar likha:
Dialogue: 0,0:00:35.32,0:00:36.30,Default,,0,0,0,,kabhi mat kholna.
Dialogue: 0,0:00:36.75,0:00:37.35,Default,,0,0,0,,Kehte hain,
Dialogue: 0,0:00:37.35,0:00:39.37,Default,,0,0,0,,museum mein kisi ne mazaak udaya.
Dialogue: 0,0:00:39.37,0:00:40.18,Default,,0,0,0,,Kuch ghanton baad,
Dialogue: 0,0:00:40.18,0:00:42.40,Default,,0,0,0,,motorcycle accident mein uski maut.
Dialogue: 0,0:00:42.40,0:00:44.42,Default,,0,0,0,,Par asli gudiya dikhti kaisi hai?
Dialogue: 0,0:00:44.87,0:00:46.87,Default,,0,0,0,,Film wali darawni chini ki gudiya
Dialogue: 0,0:00:46.87,0:00:47.23,Default,,0,0,0,,yaad hai?
Dialogue: 0,0:00:47.23,0:00:48.69,Default,,0,0,0,,Asli waisi hai hi nahi.
Dialogue: 0,0:00:48.69,0:00:49.96,Default,,0,0,0,,Smithsonian ke mutabik,
Dialogue: 0,0:00:49.96,0:00:51.96,Default,,0,0,0,,yeh factory wali Raggedy Ann hai.
Dialogue: 0,0:00:51.96,0:00:53.05,Default,,0,0,0,,Kapde ki aam gudiya.
Dialogue: 0,0:00:53.50,0:00:54.06,Default,,0,0,0,,Aur bachchi?
Dialogue: 0,0:00:54.06,0:00:56.28,Default,,0,0,0,,Connecticut ke maut ke records khangale
Dialogue: 0,0:00:56.28,0:00:56.47,Default,,0,0,0,,gaye.
Dialogue: 0,0:00:56.47,0:00:58.32,Default,,0,0,0,,7 saal ki Annabelle Higgins ka
Dialogue: 0,0:00:58.32,0:00:59.25,Default,,0,0,0,,koi record nahi.
Dialogue: 0,0:00:59.70,0:01:00.50,Default,,0,0,0,,Warren kehte,
Dialogue: 0,0:01:00.50,0:01:01.90,Default,,0,0,0,,gudiya hamla karti hai.
Dialogue: 0,0:01:01.90,0:01:03.31,Default,,0,0,0,,Dimaag ke doctor kehte,
Dialogue: 0,0:01:03.31,0:01:04.31,Default,,0,0,0,,sleep paralysis.
Dialogue: 0,0:01:04.31,0:01:05.51,Default,,0,0,0,,Yaani dimaag jaagta,
Dialogue: 0,0:01:05.51,0:01:06.92,Default,,0,0,0,,par jism hil nahi pata.
Dialogue: 0,0:01:07.37,0:01:08.10,Default,,0,0,0,,Upar se darr,
Dialogue: 0,0:01:08.10,0:01:09.74,Default,,0,0,0,,jo suna wahi dikhne lagta.
Dialogue: 0,0:01:09.74,0:01:11.02,Default,,0,0,0,,Jaanch karne wale bole:
Dialogue: 0,0:01:11.02,0:01:11.57,Default,,0,0,0,,kisse hain,
Dialogue: 0,0:01:11.57,0:01:12.30,Default,,0,0,0,,sabut nahi.
Dialogue: 0,0:01:12.75,0:01:13.41,Default,,0,0,0,,Toh sach kya?
Dialogue: 0,0:01:13.41,0:01:14.50,Default,,0,0,0,,Gudiya asli hai,
Dialogue: 0,0:01:14.50,0:01:16.02,Default,,0,0,0,,shaitaan ka sabut nahi.
Dialogue: 0,0:01:16.02,0:01:17.77,Default,,0,0,0,,Par roommates ne us raat kya
Dialogue: 0,0:01:17.77,0:01:18.20,Default,,0,0,0,,dekha?
Dialogue: 0,0:01:18.20,0:01:19.29,Default,,0,0,0,,Koi nahi jaanta.
Dialogue: 0,0:01:19.74,0:01:21.65,Default,,0,0,0,,Us dost ko bhejo jo Annabelle
Dialogue: 0,0:01:21.65,0:01:22.98,Default,,0,0,0,,dekhkar raat bhar soya nahi.
