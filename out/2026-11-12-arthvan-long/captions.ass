Dialogue: 0,0:00:00.00,0:00:01.87,Default,,0,0,0,,Mehrauli ka 6 ton loha,
Dialogue: 0,0:00:01.87,0:00:03.97,Default,,0,0,0,,sadiyon se zang kyun nahi khata?
Dialogue: 0,0:00:03.97,0:00:06.08,Default,,0,0,0,,Aapke ghar ka lohe ka gate
Dialogue: 0,0:00:06.08,0:00:07.95,Default,,0,0,0,,kuch saal mein bhura pad jaata
Dialogue: 0,0:00:07.95,0:00:08.18,Default,,0,0,0,,hai.
Dialogue: 0,0:00:08.18,0:00:10.05,Default,,0,0,0,,Barsaat mein cycle ki chain bhi
Dialogue: 0,0:00:10.05,0:00:11.22,Default,,0,0,0,,zang kha jaati hai.
Dialogue: 0,0:00:11.22,0:00:13.09,Default,,0,0,0,,Par Delhi mein ek khamba hai,
Dialogue: 0,0:00:13.09,0:00:15.43,Default,,0,0,0,,jo khule aasmaan ke neeche sadiyon
Dialogue: 0,0:00:15.43,0:00:16.36,Default,,0,0,0,,se khada hai.
Dialogue: 0,0:00:16.81,0:00:19.00,Default,,0,0,0,,IIT Kanpur ke vaigyanikon ne iska
Dialogue: 0,0:00:19.00,0:00:20.79,Default,,0,0,0,,wazan lagbhag 6 ton aanka hai.
Dialogue: 0,0:00:20.79,0:00:21.78,Default,,0,0,0,,Yaani ek bade,
Dialogue: 0,0:00:21.78,0:00:23.77,Default,,0,0,0,,poore jawaan haathi jitna loha.
Dialogue: 0,0:00:23.77,0:00:25.56,Default,,0,0,0,,Aur yeh loha saanche mein dhaala
Dialogue: 0,0:00:25.56,0:00:26.16,Default,,0,0,0,,nahi gaya.
Dialogue: 0,0:00:26.16,0:00:27.75,Default,,0,0,0,,Ise wrought iron kehte hain,
Dialogue: 0,0:00:27.75,0:00:30.13,Default,,0,0,0,,yaani garam karke hathode se peeta
Dialogue: 0,0:00:30.13,0:00:30.73,Default,,0,0,0,,gaya loha.
Dialogue: 0,0:00:31.18,0:00:33.09,Default,,0,0,0,,ASI ke naap ke hisaab se
Dialogue: 0,0:00:33.09,0:00:35.25,Default,,0,0,0,,khambe ki kul oonchai 7.21 metre
Dialogue: 0,0:00:35.25,0:00:35.49,Default,,0,0,0,,hai.
Dialogue: 0,0:00:35.49,0:00:37.64,Default,,0,0,0,,Iska ek hissa aaj ke patthar
Dialogue: 0,0:00:37.64,0:00:39.56,Default,,0,0,0,,ke farsh ke neeche daba hai.
Dialogue: 0,0:00:39.56,0:00:41.95,Default,,0,0,0,,Sabse upar ghanti jaisa ek sir
Dialogue: 0,0:00:41.95,0:00:42.19,Default,,0,0,0,,hai,
Dialogue: 0,0:00:42.19,0:00:44.35,Default,,0,0,0,,jise bell capital kehte hain.
Dialogue: 0,0:00:44.35,0:00:45.78,Default,,0,0,0,,Door se yeh ek seedha,
Dialogue: 0,0:00:45.78,0:00:46.02,Default,,0,0,0,,shaant,
Dialogue: 0,0:00:46.02,0:00:47.46,Default,,0,0,0,,kaala stambh dikhta hai.
Dialogue: 0,0:00:47.91,0:00:49.35,Default,,0,0,0,,Toh sawaal seedhe hain.
Dialogue: 0,0:00:49.35,0:00:51.03,Default,,0,0,0,,Yeh khamba kisne banwaya,
Dialogue: 0,0:00:51.03,0:00:52.95,Default,,0,0,0,,yeh pehle kahan khada tha?
Dialogue: 0,0:00:52.95,0:00:54.15,Default,,0,0,0,,Aur sabse bada,
Dialogue: 0,0:00:54.15,0:00:56.07,Default,,0,0,0,,is par zang kyun nahi chadhi?
Dialogue: 0,0:00:56.07,0:00:59.19,Default,,0,0,0,,Khambe par khuda shilalekh hamara pehla
Dialogue: 0,0:00:59.19,0:00:59.91,Default,,0,0,0,,gawah hai.
Dialogue: 0,0:00:59.91,0:01:01.83,Default,,0,0,0,,Aaj hum har jawab sabut ke
Dialogue: 0,0:01:01.83,0:01:02.07,Default,,0,0,0,,saath,
Dialogue: 0,0:01:02.07,0:01:03.75,Default,,0,0,0,,ek ek karke dekhenge.
Dialogue: 0,0:01:04.20,0:01:06.49,Default,,0,0,0,,Chaliye pehle khambe ki apni zubaan
Dialogue: 0,0:01:06.49,0:01:07.11,Default,,0,0,0,,sunte hain.
Dialogue: 0,0:01:07.11,0:01:08.98,Default,,0,0,0,,Is par Sanskrit mein ek purana
Dialogue: 0,0:01:08.98,0:01:10.23,Default,,0,0,0,,shilalekh khuda hai.
Dialogue: 0,0:01:10.23,0:01:12.52,Default,,0,0,0,,Shilalekh yaani patthar ya dhaatu par
Dialogue: 0,0:01:12.52,0:01:13.56,Default,,0,0,0,,khoda gaya sandesh.
Dialogue: 0,0:01:13.56,0:01:15.22,Default,,0,0,0,,Yeh kavita ki shakl mein ek
Dialogue: 0,0:01:15.22,0:01:16.68,Default,,0,0,0,,raja ki prashansa hai.
Dialogue: 0,0:01:16.68,0:01:19.18,Default,,0,0,0,,Is kahani ka sabse purana sabut
Dialogue: 0,0:01:19.18,0:01:19.80,Default,,0,0,0,,yahi hai.
Dialogue: 0,0:01:20.25,0:01:21.67,Default,,0,0,0,,Shilalekh kehta hai,
Dialogue: 0,0:01:21.67,0:01:23.58,Default,,0,0,0,,Chandra naam ke ek raja ne
Dialogue: 0,0:01:23.58,0:01:25.47,Default,,0,0,0,,Vishnu mein apna mann lagaya.
Dialogue: 0,0:01:25.47,0:01:27.61,Default,,0,0,0,,Phir Bhagwan Vishnu ka yeh ooncha
Dialogue: 0,0:01:27.61,0:01:27.85,Default,,0,0,0,,dhwaj,
Dialogue: 0,0:01:27.85,0:01:30.70,Default,,0,0,0,,Vishnupada naam ki pahadi par sthapit
Dialogue: 0,0:01:30.70,0:01:30.94,Default,,0,0,0,,kiya.
Dialogue: 0,0:01:30.94,0:01:32.12,Default,,0,0,0,,Dhwaj yaani jhanda,
Dialogue: 0,0:01:32.12,0:01:34.26,Default,,0,0,0,,yahan matlab devta ke naam ka
Dialogue: 0,0:01:34.26,0:01:35.45,Default,,0,0,0,,ek pavitra stambh.
Dialogue: 0,0:01:35.90,0:01:37.64,Default,,0,0,0,,Ab us din ka drishya sochiye.
Dialogue: 0,0:01:37.64,0:01:38.52,Default,,0,0,0,,Ek pahadi,
Dialogue: 0,0:01:38.52,0:01:39.61,Default,,0,0,0,,subah ki narm dhoop,
Dialogue: 0,0:01:39.61,0:01:40.70,Default,,0,0,0,,neeche jama log.
Dialogue: 0,0:01:40.70,0:01:42.66,Default,,0,0,0,,Pujari mantra padh rahe hain,
Dialogue: 0,0:01:42.66,0:01:44.84,Default,,0,0,0,,raja thodi door khade dekh rahe
Dialogue: 0,0:01:44.84,0:01:45.06,Default,,0,0,0,,hain.
Dialogue: 0,0:01:45.06,0:01:47.24,Default,,0,0,0,,Chamakta hua lohe ka stambh dheere
Dialogue: 0,0:01:47.24,0:01:48.77,Default,,0,0,0,,dheere khada hota hai.
Dialogue: 0,0:01:48.77,0:01:50.73,Default,,0,0,0,,Tasveer hamari kalpana hai,
Dialogue: 0,0:01:50.73,0:01:52.26,Default,,0,0,0,,par baat shilalekh ki hai.
Dialogue: 0,0:01:52.71,0:01:54.99,Default,,0,0,0,,Shilalekh raja ki jeet bhi ginata
Dialogue: 0,0:01:54.99,0:01:55.19,Default,,0,0,0,,hai.
Dialogue: 0,0:01:55.19,0:01:56.02,Default,,0,0,0,,Vanga desh mein,
Dialogue: 0,0:01:56.02,0:01:57.47,Default,,0,0,0,,yaani aaj ke Bengal mein,
Dialogue: 0,0:01:57.47,0:01:58.92,Default,,0,0,0,,dushman ekjut hokar aaye.
Dialogue: 0,0:01:58.92,0:02:00.99,Default,,0,0,0,,Raja ne unhe apni chhaati se
Dialogue: 0,0:02:00.99,0:02:02.03,Default,,0,0,0,,peeche dhakel diya.
Dialogue: 0,0:02:02.03,0:02:03.68,Default,,0,0,0,,Yeh kavita ki bhasha hai,
Dialogue: 0,0:02:03.68,0:02:05.13,Default,,0,0,0,,seedha itihaas nahi.
Dialogue: 0,0:02:05.13,0:02:06.79,Default,,0,0,0,,Par isse raja ki shaan ka
Dialogue: 0,0:02:06.79,0:02:08.03,Default,,0,0,0,,andaaza milta hai.
Dialogue: 0,0:02:08.48,0:02:10.38,Default,,0,0,0,,Aage likha hai ki raja ne
Dialogue: 0,0:02:10.38,0:02:12.07,Default,,0,0,0,,yuddh mein Sindhu nadi ke saat
Dialogue: 0,0:02:12.07,0:02:13.13,Default,,0,0,0,,muhane paar kiye.
Dialogue: 0,0:02:13.13,0:02:15.03,Default,,0,0,0,,Aur Vahlika naam ke logon ko
Dialogue: 0,0:02:15.03,0:02:15.46,Default,,0,0,0,,jeet liya.
Dialogue: 0,0:02:15.46,0:02:18.63,Default,,0,0,0,,Is shilalekh ka angrezi anuvaad epigraphist
Dialogue: 0,0:02:18.63,0:02:18.84,Default,,0,0,0,,J.
Dialogue: 0,0:02:18.84,0:02:19.05,Default,,0,0,0,,F.
Dialogue: 0,0:02:19.05,0:02:20.11,Default,,0,0,0,,Fleet ne chhapa tha.
Dialogue: 0,0:02:20.11,0:02:22.65,Default,,0,0,0,,Aaj bhi zyadatar vidwan wahi anuvaad
Dialogue: 0,0:02:22.65,0:02:23.28,Default,,0,0,0,,padhte hain.
Dialogue: 0,0:02:23.73,0:02:25.15,Default,,0,0,0,,Ab shilalekh se hatkar,
Dialogue: 0,0:02:25.15,0:02:26.98,Default,,0,0,0,,logon ki zubaan par chalte hain.
Dialogue: 0,0:02:26.98,0:02:29.00,Default,,0,0,0,,Delhi mein ek kahani peedhiyon se
Dialogue: 0,0:02:29.00,0:02:30.43,Default,,0,0,0,,sunai jaati rahi hai.
Dialogue: 0,0:02:30.43,0:02:32.46,Default,,0,0,0,,ASI ki purani reports mein bhi
Dialogue: 0,0:02:32.46,0:02:33.67,Default,,0,0,0,,yeh kahani darj hai.
Dialogue: 0,0:02:33.67,0:02:34.48,Default,,0,0,0,,Par dhyan rakhiye,
Dialogue: 0,0:02:34.48,0:02:35.50,Default,,0,0,0,,yeh lok katha hai.
Dialogue: 0,0:02:35.50,0:02:37.53,Default,,0,0,0,,Iske ghatne ka koi sabut nahi
Dialogue: 0,0:02:37.53,0:02:37.73,Default,,0,0,0,,hai.
Dialogue: 0,0:02:38.18,0:02:40.22,Default,,0,0,0,,Kahani mein Raja Anangpal hain.
Dialogue: 0,0:02:40.22,0:02:41.84,Default,,0,0,0,,Ek Brahmin unse kehte hain,
Dialogue: 0,0:02:41.84,0:02:43.88,Default,,0,0,0,,yeh khamba naagraj Vasuki ke sir
Dialogue: 0,0:02:43.88,0:02:44.69,Default,,0,0,0,,mein gada hai.
Dialogue: 0,0:02:44.69,0:02:47.13,Default,,0,0,0,,Vasuki yaani puranon mein naagon ke
Dialogue: 0,0:02:47.13,0:02:47.54,Default,,0,0,0,,raja.
Dialogue: 0,0:02:47.54,0:02:48.56,Default,,0,0,0,,Brahmin ne kaha,
Dialogue: 0,0:02:48.56,0:02:49.99,Default,,0,0,0,,jab tak khamba khada hai,
Dialogue: 0,0:02:49.99,0:02:52.02,Default,,0,0,0,,raaj aapke parivaar mein rahega.
Dialogue: 0,0:02:52.47,0:02:54.06,Default,,0,0,0,,Raja ke mann mein shak jaag
Dialogue: 0,0:02:54.06,0:02:54.51,Default,,0,0,0,,utha.
Dialogue: 0,0:02:54.51,0:02:56.55,Default,,0,0,0,,Kya sach mein khamba itna gehra
Dialogue: 0,0:02:56.55,0:02:57.22,Default,,0,0,0,,gada hai?
Dialogue: 0,0:02:57.22,0:02:59.26,Default,,0,0,0,,Unhone khamba ukhadwa diya.
Dialogue: 0,0:02:59.26,0:03:00.62,Default,,0,0,0,,Kahani kehti hai,
Dialogue: 0,0:03:00.62,0:03:02.66,Default,,0,0,0,,khambe ka pair Vasuki ke khoon
Dialogue: 0,0:03:02.66,0:03:03.79,Default,,0,0,0,,se geela nikla.
Dialogue: 0,0:03:03.79,0:03:05.38,Default,,0,0,0,,Brahmin ki baat sach nikli,
Dialogue: 0,0:03:05.38,0:03:06.51,Default,,0,0,0,,aur raja pachhtaye.
Dialogue: 0,0:03:06.96,0:03:08.61,Default,,0,0,0,,Khamba wapas gaada gaya,
Dialogue: 0,0:03:08.61,0:03:10.25,Default,,0,0,0,,par ab woh dheela reh gaya.
Dialogue: 0,0:03:10.25,0:03:11.19,Default,,0,0,0,,Dheeli killi,
Dialogue: 0,0:03:11.19,0:03:12.60,Default,,0,0,0,,yaani dheela khoonta,
Dialogue: 0,0:03:12.60,0:03:14.72,Default,,0,0,0,,ise Dhili Killi kaha gaya.
Dialogue: 0,0:03:14.72,0:03:17.07,Default,,0,0,0,,Kahani ke hisaab se isi se
Dialogue: 0,0:03:17.07,0:03:18.48,Default,,0,0,0,,shahar ka naam pada,
Dialogue: 0,0:03:18.48,0:03:18.95,Default,,0,0,0,,Dilli.
Dialogue: 0,0:03:18.95,0:03:20.60,Default,,0,0,0,,Sunne mein mazedaar hai,
Dialogue: 0,0:03:20.60,0:03:22.01,Default,,0,0,0,,par yeh naam ki ek lok
Dialogue: 0,0:03:22.01,0:03:22.71,Default,,0,0,0,,vyakhya hai,
Dialogue: 0,0:03:22.71,0:03:24.36,Default,,0,0,0,,pakka itihaas nahi.
Dialogue: 0,0:03:24.81,0:03:27.11,Default,,0,0,0,,Ek aur parampara bahut mashhoor thi.
Dialogue: 0,0:03:27.11,0:03:28.78,Default,,0,0,0,,Log khambe se peeth laga kar
Dialogue: 0,0:03:28.78,0:03:29.83,Default,,0,0,0,,khade hote the.
Dialogue: 0,0:03:29.83,0:03:31.71,Default,,0,0,0,,Phir dono haath peeche le jaakar
Dialogue: 0,0:03:31.71,0:03:33.38,Default,,0,0,0,,milane ki koshish karte.
Dialogue: 0,0:03:33.38,0:03:34.43,Default,,0,0,0,,Maana jaata tha,
Dialogue: 0,0:03:34.43,0:03:36.31,Default,,0,0,0,,haath mil gaye toh kismat khulegi,
Dialogue: 0,0:03:36.31,0:03:37.57,Default,,0,0,0,,mannat poori hogi.
Dialogue: 0,0:03:37.57,0:03:39.66,Default,,0,0,0,,Is maanyata ki keemat khambe ne
Dialogue: 0,0:03:39.66,0:03:40.07,Default,,0,0,0,,chukayi,
Dialogue: 0,0:03:40.07,0:03:41.33,Default,,0,0,0,,woh aage dekhenge.
Dialogue: 0,0:03:41.78,0:03:43.29,Default,,0,0,0,,Ab sabse bada sawaal,
Dialogue: 0,0:03:43.29,0:03:44.59,Default,,0,0,0,,zang kyun nahi lagi?
Dialogue: 0,0:03:44.59,0:03:46.53,Default,,0,0,0,,Pehle samjhiye ki zang hoti kya
Dialogue: 0,0:03:46.53,0:03:46.75,Default,,0,0,0,,hai.
Dialogue: 0,0:03:46.75,0:03:48.90,Default,,0,0,0,,Loha jab hawa ki oxygen aur
Dialogue: 0,0:03:48.90,0:03:50.20,Default,,0,0,0,,nami se milta hai,
Dialogue: 0,0:03:50.20,0:03:51.71,Default,,0,0,0,,bhuri parat banti hai.
Dialogue: 0,0:03:51.71,0:03:53.44,Default,,0,0,0,,Woh parat jhadti rehti hai,
Dialogue: 0,0:03:53.44,0:03:55.60,Default,,0,0,0,,aur andar ka loha khata jaata
Dialogue: 0,0:03:55.60,0:03:55.81,Default,,0,0,0,,hai.
Dialogue: 0,0:03:55.81,0:03:57.54,Default,,0,0,0,,Isi ko hum zang kehte hain.
Dialogue: 0,0:03:57.99,0:03:59.70,Default,,0,0,0,,Is sawaal par saalon kaam kiya
Dialogue: 0,0:03:59.70,0:04:01.63,Default,,0,0,0,,IIT Kanpur ke metallurgist R.
Dialogue: 0,0:04:01.63,0:04:03.13,Default,,0,0,0,,Balasubramaniam ne.
Dialogue: 0,0:04:03.13,0:04:05.48,Default,,0,0,0,,Metallurgist yaani dhaatu vaigyanik,
Dialogue: 0,0:04:05.48,0:04:07.62,Default,,0,0,0,,jo dhaatuon ki banawat padhta hai.
Dialogue: 0,0:04:07.62,0:04:10.19,Default,,0,0,0,,Unhone khambe ki sateh ke namoone
Dialogue: 0,0:04:10.19,0:04:10.40,Default,,0,0,0,,liye.
Dialogue: 0,0:04:10.40,0:04:12.33,Default,,0,0,0,,Phir microscope aur lab ki jaanch
Dialogue: 0,0:04:12.33,0:04:14.04,Default,,0,0,0,,se unki ek ek parat ko
Dialogue: 0,0:04:14.04,0:04:14.47,Default,,0,0,0,,padha.
Dialogue: 0,0:04:14.92,0:04:17.82,Default,,0,0,0,,2002 mein unhone apna nateeja saamne
Dialogue: 0,0:04:17.82,0:04:18.21,Default,,0,0,0,,rakha.
Dialogue: 0,0:04:18.21,0:04:19.95,Default,,0,0,0,,Khambe ki sateh par ek bahut
Dialogue: 0,0:04:19.95,0:04:21.50,Default,,0,0,0,,patli suraksha parat hai.
Dialogue: 0,0:04:21.50,0:04:23.04,Default,,0,0,0,,Iska naam hai misawite,
Dialogue: 0,0:04:23.04,0:04:24.98,Default,,0,0,0,,yaani lohe ka ek khaas oxide
Dialogue: 0,0:04:24.98,0:04:26.72,Default,,0,0,0,,jo ghana aur chipka rehta hai.
Dialogue: 0,0:04:26.72,0:04:28.27,Default,,0,0,0,,Yeh parat aam zang ki tarah
Dialogue: 0,0:04:28.27,0:04:29.04,Default,,0,0,0,,jhadti nahi.
Dialogue: 0,0:04:29.49,0:04:30.98,Default,,0,0,0,,Is parat mein ek aur cheez
Dialogue: 0,0:04:30.98,0:04:31.41,Default,,0,0,0,,mili,
Dialogue: 0,0:04:31.41,0:04:33.76,Default,,0,0,0,,iron hydrogen phosphate hydrate.
Dialogue: 0,0:04:33.76,0:04:34.61,Default,,0,0,0,,Naam bhaari hai,
Dialogue: 0,0:04:34.61,0:04:35.68,Default,,0,0,0,,matlab seedha hai.
Dialogue: 0,0:04:35.68,0:04:37.81,Default,,0,0,0,,Yeh phosphorus aur lohe se bana
Dialogue: 0,0:04:37.81,0:04:39.52,Default,,0,0,0,,ek crystal jaisa padarth hai.
Dialogue: 0,0:04:39.52,0:04:42.29,Default,,0,0,0,,Misawite aur yeh phosphate milkar kawach
Dialogue: 0,0:04:42.29,0:04:43.14,Default,,0,0,0,,banate hain.
Dialogue: 0,0:04:43.14,0:04:45.06,Default,,0,0,0,,Yeh kawach hawa aur paani ko
Dialogue: 0,0:04:45.06,0:04:46.77,Default,,0,0,0,,andar jaane se rokta hai.
Dialogue: 0,0:04:47.22,0:04:49.23,Default,,0,0,0,,Matlab khamba zang se bacha nahi,
Dialogue: 0,0:04:49.23,0:04:50.63,Default,,0,0,0,,balki ek khaas zang ne hi
Dialogue: 0,0:04:50.63,0:04:51.43,Default,,0,0,0,,use bachaya.
Dialogue: 0,0:04:51.43,0:04:53.44,Default,,0,0,0,,Shuru mein jo patli parat bani,
Dialogue: 0,0:04:53.44,0:04:55.44,Default,,0,0,0,,wahi dheere dheere kawach ban gayi.
Dialogue: 0,0:04:55.44,0:04:56.85,Default,,0,0,0,,Yeh koi chamatkar nahi,
Dialogue: 0,0:04:56.85,0:04:57.85,Default,,0,0,0,,seedha vigyan hai.
Dialogue: 0,0:04:57.85,0:04:58.65,Default,,0,0,0,,Aur sach kahun,
Dialogue: 0,0:04:58.65,0:05:00.26,Default,,0,0,0,,yahi baat is khambe ko aur
Dialogue: 0,0:05:00.26,0:05:01.86,Default,,0,0,0,,bhi kamaal ka banati hai.
Dialogue: 0,0:05:02.31,0:05:04.24,Default,,0,0,0,,Ab is kawach ki jad dekhte
Dialogue: 0,0:05:04.24,0:05:04.48,Default,,0,0,0,,hain.
Dialogue: 0,0:05:04.48,0:05:06.41,Default,,0,0,0,,IIT Kanpur ki jaanch mein khambe
Dialogue: 0,0:05:06.41,0:05:09.06,Default,,0,0,0,,ke lohe mein phosphorus ausatan 0.25
Dialogue: 0,0:05:09.06,0:05:10.03,Default,,0,0,0,,percent mila.
Dialogue: 0,0:05:10.03,0:05:11.72,Default,,0,0,0,,Phosphorus ek tatva hai,
Dialogue: 0,0:05:11.72,0:05:13.65,Default,,0,0,0,,jise aam taur par lohe mein
Dialogue: 0,0:05:13.65,0:05:15.58,Default,,0,0,0,,ashuddhi maana jaata hai.
Dialogue: 0,0:05:15.58,0:05:18.23,Default,,0,0,0,,Par yahan yahi ashuddhi hero ban
Dialogue: 0,0:05:18.23,0:05:18.47,Default,,0,0,0,,gayi.
Dialogue: 0,0:05:18.92,0:05:20.05,Default,,0,0,0,,Ab tulna kijiye.
Dialogue: 0,0:05:20.05,0:05:22.08,Default,,0,0,0,,Aaj ke wrought iron mein phosphorus
Dialogue: 0,0:05:22.08,0:05:23.89,Default,,0,0,0,,shayad hi kabhi 0.05 percent se
Dialogue: 0,0:05:23.89,0:05:25.02,Default,,0,0,0,,upar jaata hai.
Dialogue: 0,0:05:25.02,0:05:27.28,Default,,0,0,0,,Yaani is khambe mein phosphorus kai
Dialogue: 0,0:05:27.28,0:05:28.41,Default,,0,0,0,,guna zyada hai.
Dialogue: 0,0:05:28.41,0:05:31.35,Default,,0,0,0,,Yahi zyada phosphorus suraksha parat ko
Dialogue: 0,0:05:31.35,0:05:33.15,Default,,0,0,0,,banne mein madad karta hai.
Dialogue: 0,0:05:33.15,0:05:35.41,Default,,0,0,0,,Raaz ka pehla taala yahin khulta
Dialogue: 0,0:05:35.41,0:05:35.64,Default,,0,0,0,,hai.
Dialogue: 0,0:05:36.09,0:05:38.04,Default,,0,0,0,,Toh itna phosphorus aaya kahan se?
Dialogue: 0,0:05:38.04,0:05:40.78,Default,,0,0,0,,Jawab praacheen Bharatiya karigaron ki bhatti
Dialogue: 0,0:05:40.78,0:05:41.56,Default,,0,0,0,,mein chhupa hai.
Dialogue: 0,0:05:41.56,0:05:43.90,Default,,0,0,0,,Woh bloomery bhatti mein loha banate
Dialogue: 0,0:05:43.90,0:05:44.10,Default,,0,0,0,,the.
Dialogue: 0,0:05:44.10,0:05:46.25,Default,,0,0,0,,Bloomery yaani chhoti khuli bhatti,
Dialogue: 0,0:05:46.25,0:05:48.20,Default,,0,0,0,,jismein kachcha loha koyle ke saath
Dialogue: 0,0:05:48.20,0:05:49.18,Default,,0,0,0,,tapaya jaata tha.
Dialogue: 0,0:05:49.18,0:05:51.13,Default,,0,0,0,,Isse seedha loha mil jaata tha.
Dialogue: 0,0:05:51.58,0:05:53.50,Default,,0,0,0,,Aaj ki factory mein bhatti mein
Dialogue: 0,0:05:53.50,0:05:55.00,Default,,0,0,0,,choona milaya jaata hai,
Dialogue: 0,0:05:55.00,0:05:56.29,Default,,0,0,0,,ise flux kehte hain.
Dialogue: 0,0:05:56.29,0:05:58.21,Default,,0,0,0,,Flux yaani woh cheez jo ashuddhiyan
Dialogue: 0,0:05:58.21,0:05:59.49,Default,,0,0,0,,kheench kar bahar le jaaye.
Dialogue: 0,0:05:59.49,0:06:01.42,Default,,0,0,0,,Choona phosphorus ko bhi saath le
Dialogue: 0,0:06:01.42,0:06:02.06,Default,,0,0,0,,jaata hai.
Dialogue: 0,0:06:02.06,0:06:04.84,Default,,0,0,0,,Praacheen karigar choona nahi milate the.
Dialogue: 0,0:06:04.84,0:06:07.19,Default,,0,0,0,,Isliye phosphorus lohe ke andar hi
Dialogue: 0,0:06:07.19,0:06:07.62,Default,,0,0,0,,reh gaya.
Dialogue: 0,0:06:08.07,0:06:09.96,Default,,0,0,0,,Phir garam lohe ke tukdon ko
Dialogue: 0,0:06:09.96,0:06:11.85,Default,,0,0,0,,hathode se peet peet kar joda
Dialogue: 0,0:06:11.85,0:06:12.06,Default,,0,0,0,,gaya.
Dialogue: 0,0:06:12.06,0:06:13.94,Default,,0,0,0,,Ise forge welding kehte hain,
Dialogue: 0,0:06:13.94,0:06:16.04,Default,,0,0,0,,yaani garam karke peet kar dhaatu
Dialogue: 0,0:06:16.04,0:06:16.46,Default,,0,0,0,,jodna.
Dialogue: 0,0:06:16.46,0:06:17.93,Default,,0,0,0,,Sochiye kitne karigar,
Dialogue: 0,0:06:17.93,0:06:18.77,Default,,0,0,0,,kitni bhattiyan,
Dialogue: 0,0:06:18.77,0:06:20.23,Default,,0,0,0,,kitne din lage honge.
Dialogue: 0,0:06:20.23,0:06:22.54,Default,,0,0,0,,Un karigaron ke naam shilalekh mein
Dialogue: 0,0:06:22.54,0:06:23.59,Default,,0,0,0,,kahin nahi hain.
Dialogue: 0,0:06:24.04,0:06:26.10,Default,,0,0,0,,Ab us hisse par chalte hain
Dialogue: 0,0:06:26.10,0:06:28.42,Default,,0,0,0,,jahan vidwan ek mat nahi hain.
Dialogue: 0,0:06:28.42,0:06:29.45,Default,,0,0,0,,Pehla sawaal,
Dialogue: 0,0:06:29.45,0:06:32.28,Default,,0,0,0,,shilalekh ka Raja Chandra aakhir kaun
Dialogue: 0,0:06:32.28,0:06:32.54,Default,,0,0,0,,tha?
Dialogue: 0,0:06:32.54,0:06:34.34,Default,,0,0,0,,Shilalekh mein sirf naam hai,
Dialogue: 0,0:06:34.34,0:06:34.85,Default,,0,0,0,,Chandra.
Dialogue: 0,0:06:34.85,0:06:36.40,Default,,0,0,0,,Na vansh ka naam saaf hai,
Dialogue: 0,0:06:36.40,0:06:37.17,Default,,0,0,0,,na koi saal.
Dialogue: 0,0:06:37.17,0:06:39.74,Default,,0,0,0,,Isliye yeh paheli aaj tak khuli
Dialogue: 0,0:06:39.74,0:06:40.00,Default,,0,0,0,,hai.
Dialogue: 0,0:06:40.45,0:06:41.63,Default,,0,0,0,,Ek paksh kehta hai,
Dialogue: 0,0:06:41.63,0:06:44.45,Default,,0,0,0,,yeh Gupta samrat Chandragupta Dwitiya the.
Dialogue: 0,0:06:44.45,0:06:45.86,Default,,0,0,0,,Dwitiya yaani doosre,
Dialogue: 0,0:06:45.86,0:06:47.98,Default,,0,0,0,,is naam ke doosre Gupta raja.
Dialogue: 0,0:06:47.98,0:06:50.10,Default,,0,0,0,,Gupta vansh praacheen Bharat ka ek
Dialogue: 0,0:06:50.10,0:06:51.27,Default,,0,0,0,,bada rajvansh tha.
Dialogue: 0,0:06:51.27,0:06:53.63,Default,,0,0,0,,Chandra naam ka mel Chandragupta se
Dialogue: 0,0:06:53.63,0:06:54.33,Default,,0,0,0,,baithta hai,
Dialogue: 0,0:06:54.33,0:06:56.21,Default,,0,0,0,,yahi is paksh ka seedha tark
Dialogue: 0,0:06:56.21,0:06:56.45,Default,,0,0,0,,hai.
Dialogue: 0,0:06:56.90,0:06:58.13,Default,,0,0,0,,Doosra paksh kehta hai,
Dialogue: 0,0:06:58.13,0:07:00.59,Default,,0,0,0,,yeh Rajasthan ke Pushkarana ke Raja
Dialogue: 0,0:07:00.59,0:07:02.23,Default,,0,0,0,,Chandravarman ho sakte hain.
Dialogue: 0,0:07:02.23,0:07:04.49,Default,,0,0,0,,ASI se jude adhyayanon mein Chandra
Dialogue: 0,0:07:04.49,0:07:06.54,Default,,0,0,0,,ki pehchaan par yeh sawaal gambhirta
Dialogue: 0,0:07:06.54,0:07:07.36,Default,,0,0,0,,se uthaya gaya.
Dialogue: 0,0:07:07.36,0:07:09.00,Default,,0,0,0,,Dono taraf apne tark hain.
Dialogue: 0,0:07:09.00,0:07:10.84,Default,,0,0,0,,Aur abhi tak koi aakhri faisla
Dialogue: 0,0:07:10.84,0:07:11.66,Default,,0,0,0,,nahi hua hai.
Dialogue: 0,0:07:12.11,0:07:13.97,Default,,0,0,0,,Toh hamare haath mein kya hai?
Dialogue: 0,0:07:13.97,0:07:14.89,Default,,0,0,0,,Naam pakka hai,
Dialogue: 0,0:07:14.89,0:07:15.36,Default,,0,0,0,,Chandra.
Dialogue: 0,0:07:15.36,0:07:16.75,Default,,0,0,0,,Bhakti bhi pakki hai,
Dialogue: 0,0:07:16.75,0:07:17.45,Default,,0,0,0,,Vishnu ki.
Dialogue: 0,0:07:17.45,0:07:19.31,Default,,0,0,0,,Par raja ka chehra ab bhi
Dialogue: 0,0:07:19.31,0:07:20.00,Default,,0,0,0,,dhundhla hai.
Dialogue: 0,0:07:20.00,0:07:22.56,Default,,0,0,0,,Itihaas mein aisa aksar hota hai,
Dialogue: 0,0:07:22.56,0:07:25.11,Default,,0,0,0,,jab ek shilalekh hi akela gawah
Dialogue: 0,0:07:25.11,0:07:25.34,Default,,0,0,0,,ho.
Dialogue: 0,0:07:25.34,0:07:27.43,Default,,0,0,0,,Aur gawah sirf utna bolta hai
Dialogue: 0,0:07:27.43,0:07:28.59,Default,,0,0,0,,jitna likha hai.
Dialogue: 0,0:07:29.04,0:07:30.20,Default,,0,0,0,,Doosri paheli,
Dialogue: 0,0:07:30.20,0:07:31.84,Default,,0,0,0,,khamba pehle kahan tha?
Dialogue: 0,0:07:31.84,0:07:33.23,Default,,0,0,0,,Shilalekh kehta hai,
Dialogue: 0,0:07:33.23,0:07:35.10,Default,,0,0,0,,Vishnupada pahadi par.
Dialogue: 0,0:07:35.10,0:07:36.73,Default,,0,0,0,,Par aaj woh Delhi mein hai.
Dialogue: 0,0:07:36.73,0:07:39.99,Default,,0,0,0,,Shilalekh padhne wale vidwan ko epigraphist
Dialogue: 0,0:07:39.99,0:07:40.69,Default,,0,0,0,,kehte hain.
Dialogue: 0,0:07:40.69,0:07:41.85,Default,,0,0,0,,Epigraphist J.
Dialogue: 0,0:07:41.85,0:07:42.09,Default,,0,0,0,,F.
Dialogue: 0,0:07:42.09,0:07:44.18,Default,,0,0,0,,Fleet ne 1898 mein kaha,
Dialogue: 0,0:07:44.18,0:07:46.28,Default,,0,0,0,,yeh pahadi Mathura mein thi.
Dialogue: 0,0:07:46.73,0:07:48.01,Default,,0,0,0,,Phir IIT Kanpur ke R.
Dialogue: 0,0:07:48.01,0:07:50.99,Default,,0,0,0,,Balasubramaniam aur shodhkarta Meera Dass ne
Dialogue: 0,0:07:50.99,0:07:51.84,Default,,0,0,0,,alag raay di.
Dialogue: 0,0:07:51.84,0:07:54.19,Default,,0,0,0,,Unke hisaab se Vishnupada aaj ka
Dialogue: 0,0:07:54.19,0:07:55.25,Default,,0,0,0,,Udayagiri hai,
Dialogue: 0,0:07:55.25,0:07:56.31,Default,,0,0,0,,Vidisha ke paas.
Dialogue: 0,0:07:56.31,0:07:58.23,Default,,0,0,0,,Unhone puratatv aur aasmaan,
Dialogue: 0,0:07:58.23,0:07:59.94,Default,,0,0,0,,dono ke sabut saath rakhe.
Dialogue: 0,0:07:59.94,0:08:02.70,Default,,0,0,0,,Puratatv yaani zameen se mili purani
Dialogue: 0,0:08:02.70,0:08:03.77,Default,,0,0,0,,cheezon ka adhyayan.
Dialogue: 0,0:08:04.22,0:08:05.97,Default,,0,0,0,,Unka tark suraj se juda hai.
Dialogue: 0,0:08:05.97,0:08:08.11,Default,,0,0,0,,Summer solstice yaani saal ka sabse
Dialogue: 0,0:08:08.11,0:08:08.69,Default,,0,0,0,,lamba din.
Dialogue: 0,0:08:08.69,0:08:10.05,Default,,0,0,0,,Us din suraj ki seedh ko
Dialogue: 0,0:08:10.05,0:08:12.39,Default,,0,0,0,,unhone pahadi ki jagah se joda.
Dialogue: 0,0:08:12.39,0:08:14.33,Default,,0,0,0,,Meera Dass ka yeh kaam 2004
Dialogue: 0,0:08:14.33,0:08:15.11,Default,,0,0,0,,mein saamne aaya.
Dialogue: 0,0:08:15.11,0:08:16.66,Default,,0,0,0,,Mathura ya Udayagiri,
Dialogue: 0,0:08:16.66,0:08:18.22,Default,,0,0,0,,yeh bahas aaj bhi jaari hai.
Dialogue: 0,0:08:18.67,0:08:20.78,Default,,0,0,0,,Teesra sabut bhi khambe par hi
Dialogue: 0,0:08:20.78,0:08:21.48,Default,,0,0,0,,khuda hai.
Dialogue: 0,0:08:21.48,0:08:22.65,Default,,0,0,0,,Ek chhota sa lekh,
Dialogue: 0,0:08:22.65,0:08:24.29,Default,,0,0,0,,Samvat 1109 ka.
Dialogue: 0,0:08:24.29,0:08:26.16,Default,,0,0,0,,Samvat yaani Vikram Samvat,
Dialogue: 0,0:08:26.16,0:08:28.50,Default,,0,0,0,,Bharat ka ek purana calendar.
Dialogue: 0,0:08:28.50,0:08:30.85,Default,,0,0,0,,Aaj ke angrezi calendar mein yeh
Dialogue: 0,0:08:30.85,0:08:33.42,Default,,0,0,0,,1052 isvi ke aas paas baithta
Dialogue: 0,0:08:33.42,0:08:33.65,Default,,0,0,0,,hai.
Dialogue: 0,0:08:33.65,0:08:34.83,Default,,0,0,0,,Isvi yaani CE,
Dialogue: 0,0:08:34.83,0:08:36.23,Default,,0,0,0,,jo hum roz likhte hain.
Dialogue: 0,0:08:36.68,0:08:39.77,Default,,0,0,0,,Puratatvavid Alexander Cunningham ne is lekh
Dialogue: 0,0:08:39.77,0:08:40.38,Default,,0,0,0,,ko padha.
Dialogue: 0,0:08:40.38,0:08:42.65,Default,,0,0,0,,Puratatvavid yaani archaeologist,
Dialogue: 0,0:08:42.65,0:08:44.91,Default,,0,0,0,,jo khudai aur purane sabut padhta
Dialogue: 0,0:08:44.91,0:08:45.11,Default,,0,0,0,,hai.
Dialogue: 0,0:08:45.11,0:08:46.97,Default,,0,0,0,,Unke hisaab se likha hai ki
Dialogue: 0,0:08:46.97,0:08:49.43,Default,,0,0,0,,Tomar Raja Anangpal ne Dilli basayi.
Dialogue: 0,0:08:49.43,0:08:51.08,Default,,0,0,0,,Yaani yeh lekh ek shahar ke
Dialogue: 0,0:08:51.08,0:08:52.52,Default,,0,0,0,,basne ki baat karta hai.
Dialogue: 0,0:08:52.97,0:08:54.83,Default,,0,0,0,,Baad mein puratatvavid B.
Dialogue: 0,0:08:54.83,0:08:55.06,Default,,0,0,0,,R.
Dialogue: 0,0:08:55.06,0:08:57.15,Default,,0,0,0,,Mani ne isi lekh ko alag
Dialogue: 0,0:08:57.15,0:08:57.61,Default,,0,0,0,,padha.
Dialogue: 0,0:08:57.61,0:09:00.16,Default,,0,0,0,,Unke hisaab se Anangpal ne khamba
Dialogue: 0,0:09:00.16,0:09:00.63,Default,,0,0,0,,kas diya,
Dialogue: 0,0:09:00.63,0:09:03.18,Default,,0,0,0,,yaani dobara mazbooti se gaada.
Dialogue: 0,0:09:03.18,0:09:05.27,Default,,0,0,0,,Ek padhaai mein shahar basta hai,
Dialogue: 0,0:09:05.27,0:09:07.12,Default,,0,0,0,,doosri mein khamba thehrta hai.
Dialogue: 0,0:09:07.12,0:09:08.05,Default,,0,0,0,,Aur yaad kijiye,
Dialogue: 0,0:09:08.05,0:09:10.37,Default,,0,0,0,,Vasuki wali lok katha mein bhi
Dialogue: 0,0:09:10.37,0:09:12.69,Default,,0,0,0,,yahi raja aur yahi khamba tha.
Dialogue: 0,0:09:13.14,0:09:14.68,Default,,0,0,0,,Ab woh baat jo koi pakke
Dialogue: 0,0:09:14.68,0:09:15.77,Default,,0,0,0,,se nahi jaanta.
Dialogue: 0,0:09:15.77,0:09:18.85,Default,,0,0,0,,Agar khamba pehle Mathura ya Udayagiri
Dialogue: 0,0:09:18.85,0:09:19.28,Default,,0,0,0,,mein tha,
Dialogue: 0,0:09:19.28,0:09:20.60,Default,,0,0,0,,toh Delhi kaise aaya?
Dialogue: 0,0:09:20.60,0:09:22.14,Default,,0,0,0,,Lagbhag 6 ton ka loha,
Dialogue: 0,0:09:22.14,0:09:22.79,Default,,0,0,0,,bina truck,
Dialogue: 0,0:09:22.79,0:09:23.67,Default,,0,0,0,,bina crane.
Dialogue: 0,0:09:23.67,0:09:25.65,Default,,0,0,0,,Itni door ise kaise dhoya gaya,
Dialogue: 0,0:09:25.65,0:09:28.06,Default,,0,0,0,,iska koi likhit hisaab nahi milta.
Dialogue: 0,0:09:28.51,0:09:30.11,Default,,0,0,0,,Kya haathiyon se khinchwaya gaya?
Dialogue: 0,0:09:30.11,0:09:31.94,Default,,0,0,0,,Kya nadi ke raaste naav par
Dialogue: 0,0:09:31.94,0:09:32.40,Default,,0,0,0,,laaya gaya?
Dialogue: 0,0:09:32.40,0:09:34.69,Default,,0,0,0,,Kya lakdi ke belan par sarakaaya
Dialogue: 0,0:09:34.69,0:09:34.92,Default,,0,0,0,,gaya?
Dialogue: 0,0:09:34.92,0:09:36.52,Default,,0,0,0,,Yeh sab sirf andaaze hain,
Dialogue: 0,0:09:36.52,0:09:37.43,Default,,0,0,0,,sabut nahi.
Dialogue: 0,0:09:37.43,0:09:40.18,Default,,0,0,0,,Shayad kisi din kisi purane dastavez
Dialogue: 0,0:09:40.18,0:09:42.47,Default,,0,0,0,,ya khudai se iska jawab mile.
Dialogue: 0,0:09:42.92,0:09:44.31,Default,,0,0,0,,Ek sawaal aur bhi hai,
Dialogue: 0,0:09:44.31,0:09:46.40,Default,,0,0,0,,jo seedha zameen se juda hai.
Dialogue: 0,0:09:46.40,0:09:48.48,Default,,0,0,0,,Khambe ka 1.12 metre hissa aaj
Dialogue: 0,0:09:48.48,0:09:49.64,Default,,0,0,0,,farsh ke neeche hai.
Dialogue: 0,0:09:49.64,0:09:50.57,Default,,0,0,0,,Neeche kya hai,
Dialogue: 0,0:09:50.57,0:09:52.42,Default,,0,0,0,,woh aam aankh se nahi dikhta.
Dialogue: 0,0:09:52.42,0:09:55.20,Default,,0,0,0,,Itna bhaari khamba seedha kaise khada
Dialogue: 0,0:09:55.20,0:09:55.67,Default,,0,0,0,,kiya gaya,
Dialogue: 0,0:09:55.67,0:09:57.52,Default,,0,0,0,,yeh aaj bhi hairaan karta hai.
Dialogue: 0,0:09:57.97,0:09:58.88,Default,,0,0,0,,Ab baat aapki.
Dialogue: 0,0:09:58.88,0:10:01.14,Default,,0,0,0,,Aaj aap Mehrauli jaakar yeh khamba
Dialogue: 0,0:10:01.14,0:10:03.18,Default,,0,0,0,,apni aankhon se dekh sakte hain.
Dialogue: 0,0:10:03.18,0:10:05.22,Default,,0,0,0,,Par ab aap use gale nahi
Dialogue: 0,0:10:05.22,0:10:06.13,Default,,0,0,0,,laga sakte.
Dialogue: 0,0:10:06.13,0:10:08.62,Default,,0,0,0,,1997 mein ASI ne khambe ke
Dialogue: 0,0:10:08.62,0:10:10.89,Default,,0,0,0,,chaaron taraf lohe ki baad laga
Dialogue: 0,0:10:10.89,0:10:11.12,Default,,0,0,0,,di.
Dialogue: 0,0:10:11.12,0:10:12.25,Default,,0,0,0,,Baad yaani fence,
Dialogue: 0,0:10:12.25,0:10:13.61,Default,,0,0,0,,ek suraksha ghera.
Dialogue: 0,0:10:14.06,0:10:16.57,Default,,0,0,0,,Wajah wahi purani parampara thi.
Dialogue: 0,0:10:16.57,0:10:19.09,Default,,0,0,0,,Anginat haathon ki ragad aur paseene
Dialogue: 0,0:10:19.09,0:10:21.39,Default,,0,0,0,,se neeche ki misawite parat ghis
Dialogue: 0,0:10:21.39,0:10:22.02,Default,,0,0,0,,rahi thi.
Dialogue: 0,0:10:22.02,0:10:23.90,Default,,0,0,0,,Jo kawach sadiyon mein bana tha,
Dialogue: 0,0:10:23.90,0:10:25.37,Default,,0,0,0,,woh logon ke pyaar se ghis
Dialogue: 0,0:10:25.37,0:10:26.00,Default,,0,0,0,,raha tha.
Dialogue: 0,0:10:26.00,0:10:27.88,Default,,0,0,0,,Isliye ASI ne beech mein thodi
Dialogue: 0,0:10:27.88,0:10:28.93,Default,,0,0,0,,doori bana di.
Dialogue: 0,0:10:28.93,0:10:30.81,Default,,0,0,0,,Mannat ab door se maangi jaati
Dialogue: 0,0:10:30.81,0:10:31.02,Default,,0,0,0,,hai.
Dialogue: 0,0:10:31.47,0:10:32.12,Default,,0,0,0,,Jab aap jaayein,
Dialogue: 0,0:10:32.12,0:10:34.08,Default,,0,0,0,,toh khambe ke neeche ke hisse
Dialogue: 0,0:10:34.08,0:10:35.16,Default,,0,0,0,,ko dhyan se dekhiye.
Dialogue: 0,0:10:35.16,0:10:37.34,Default,,0,0,0,,Upar ka ghanti jaisa sir dekhiye,
Dialogue: 0,0:10:37.34,0:10:39.29,Default,,0,0,0,,aur shilalekh ki panktiyan dhoondhiye.
Dialogue: 0,0:10:39.29,0:10:41.25,Default,,0,0,0,,Aap ek aise sabut ke saamne
Dialogue: 0,0:10:41.25,0:10:42.12,Default,,0,0,0,,khade honge,
Dialogue: 0,0:10:42.12,0:10:44.29,Default,,0,0,0,,jo vigyan aur itihaas dono ka
Dialogue: 0,0:10:44.29,0:10:44.51,Default,,0,0,0,,hai.
Dialogue: 0,0:10:44.51,0:10:46.25,Default,,0,0,0,,Aur jo aaj bhi khule aasmaan
Dialogue: 0,0:10:46.25,0:10:47.55,Default,,0,0,0,,ke neeche khada hai.
Dialogue: 0,0:10:48.00,0:10:50.26,Default,,0,0,0,,Agli kadi mein hum chalenge Vidisha
Dialogue: 0,0:10:50.26,0:10:51.40,Default,,0,0,0,,ke paas Udayagiri.
Dialogue: 0,0:10:51.40,0:10:52.34,Default,,0,0,0,,Wahi pahadi,
Dialogue: 0,0:10:52.34,0:10:54.79,Default,,0,0,0,,jise kuch vidwan asli Vishnupada maante
Dialogue: 0,0:10:54.79,0:10:54.98,Default,,0,0,0,,hain.
Dialogue: 0,0:10:54.98,0:10:57.06,Default,,0,0,0,,Dekhenge ki wahan suraj aur patthar
Dialogue: 0,0:10:57.06,0:10:58.00,Default,,0,0,0,,ka kya rishta hai.
Dialogue: 0,0:10:58.00,0:10:59.51,Default,,0,0,0,,Aur kya wahan khambe ki koi
Dialogue: 0,0:10:59.51,0:11:00.64,Default,,0,0,0,,nishaani bachi hai.
Dialogue: 0,0:11:01.09,0:11:02.11,Default,,0,0,0,,Ab aapki baari.
Dialogue: 0,0:11:02.11,0:11:04.15,Default,,0,0,0,,Aapke hisaab se yeh khamba pehle
Dialogue: 0,0:11:04.15,0:11:05.17,Default,,0,0,0,,kahan khada tha,
Dialogue: 0,0:11:05.17,0:11:06.80,Default,,0,0,0,,Mathura ya Udayagiri?
Dialogue: 0,0:11:06.80,0:11:08.43,Default,,0,0,0,,Comment mein bas ek shabd likhiye.
Dialogue: 0,0:11:08.43,0:11:10.47,Default,,0,0,0,,Aur agar aapne kabhi ise peeth
Dialogue: 0,0:11:10.47,0:11:12.10,Default,,0,0,0,,laga kar gale lagaya tha,
Dialogue: 0,0:11:12.10,0:11:13.93,Default,,0,0,0,,toh woh kissa bhi zaroor bataiye.
