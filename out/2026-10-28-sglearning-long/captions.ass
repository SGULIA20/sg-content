Dialogue: 0,0:00:00.00,0:00:02.92,Default,,0,0,0,,Papa ki FD har saal badh
Dialogue: 0,0:00:02.92,0:00:04.17,Default,,0,0,0,,rahi thi,
Dialogue: 0,0:00:04.17,0:00:07.91,Default,,0,0,0,,phir bhi Papa gareeb ho rahe
Dialogue: 0,0:00:07.91,0:00:08.33,Default,,0,0,0,,the.
Dialogue: 0,0:00:08.33,0:00:12.49,Default,,0,0,0,,Almirah mein receipts ki ek moti
Dialogue: 0,0:00:12.49,0:00:13.74,Default,,0,0,0,,file hai.
Dialogue: 0,0:00:13.74,0:00:17.08,Default,,0,0,0,,Har receipt par byaaj likha hai.
Dialogue: 0,0:00:17.08,0:00:20.41,Default,,0,0,0,,Papa use pyaar se chhoo kar
Dialogue: 0,0:00:20.41,0:00:21.66,Default,,0,0,0,,kehte hain,
Dialogue: 0,0:00:21.66,0:00:22.49,Default,,0,0,0,,beta,
Dialogue: 0,0:00:22.49,0:00:23.74,Default,,0,0,0,,safe hai,
Dialogue: 0,0:00:23.74,0:00:26.24,Default,,0,0,0,,kahin nahi jaayega.
Dialogue: 0,0:00:26.69,0:00:29.19,Default,,0,0,0,,Ek shaam Mummy sabzi ka thaila
Dialogue: 0,0:00:29.19,0:00:30.30,Default,,0,0,0,,lekar ghar aayi.
Dialogue: 0,0:00:30.30,0:00:31.69,Default,,0,0,0,,Thaila halka tha,
Dialogue: 0,0:00:31.69,0:00:33.07,Default,,0,0,0,,par bill bhaari tha.
Dialogue: 0,0:00:33.07,0:00:34.46,Default,,0,0,0,,Mummy ne kaha,
Dialogue: 0,0:00:34.46,0:00:37.51,Default,,0,0,0,,pehle isi paise mein poora hafta
Dialogue: 0,0:00:37.51,0:00:39.18,Default,,0,0,0,,aaraam se chalta tha.
Dialogue: 0,0:00:39.18,0:00:41.40,Default,,0,0,0,,Ab beech hafte mein hi khatam.
Dialogue: 0,0:00:41.40,0:00:43.62,Default,,0,0,0,,Papa ne chashma utaara,
Dialogue: 0,0:00:43.62,0:00:44.73,Default,,0,0,0,,aur chup ho gaye.
Dialogue: 0,0:00:45.18,0:00:49.77,Default,,0,0,0,,Papa ka hisaab bilkul seedha tha.
Dialogue: 0,0:00:49.77,0:00:52.07,Default,,0,0,0,,Paisa bank mein hai,
Dialogue: 0,0:00:52.07,0:00:54.83,Default,,0,0,0,,har saal byaaj judta hai,
Dialogue: 0,0:00:54.83,0:00:58.04,Default,,0,0,0,,toh total badh raha hai.
Dialogue: 0,0:00:58.04,0:01:02.63,Default,,0,0,0,,Receipt par number bada hota gaya.
Dialogue: 0,0:01:02.63,0:01:07.23,Default,,0,0,0,,Par dukaan par wahi number chhota
Dialogue: 0,0:01:07.23,0:01:08.61,Default,,0,0,0,,padta gaya.
Dialogue: 0,0:01:08.61,0:01:13.20,Default,,0,0,0,,Yahi is kahani ka chhupa chor
Dialogue: 0,0:01:13.20,0:01:13.66,Default,,0,0,0,,hai.
Dialogue: 0,0:01:14.11,0:01:16.47,Default,,0,0,0,,Toh aaj teen sawaal.
Dialogue: 0,0:01:16.47,0:01:17.41,Default,,0,0,0,,Pehla,
Dialogue: 0,0:01:17.41,0:01:20.24,Default,,0,0,0,,FD par byaaj milta hai,
Dialogue: 0,0:01:20.24,0:01:24.01,Default,,0,0,0,,phir bhi paisa kam kaise hua?
Dialogue: 0,0:01:24.01,0:01:24.96,Default,,0,0,0,,Doosra,
Dialogue: 0,0:01:24.96,0:01:27.79,Default,,0,0,0,,FD ke byaaj par tax kab
Dialogue: 0,0:01:27.79,0:01:30.62,Default,,0,0,0,,aur kitna kat-ta hai?
Dialogue: 0,0:01:30.62,0:01:31.56,Default,,0,0,0,,Teesra,
Dialogue: 0,0:01:31.56,0:01:36.75,Default,,0,0,0,,emergency ka paisa kahan rakhein?
Dialogue: 0,0:01:36.75,0:01:40.99,Default,,0,0,0,,Teeno ka jawaab isi ghar ki
Dialogue: 0,0:01:40.99,0:01:43.35,Default,,0,0,0,,kahani mein hai.
Dialogue: 0,0:01:43.80,0:01:45.50,Default,,0,0,0,,Pehla sawaal.
Dialogue: 0,0:01:45.50,0:01:46.77,Default,,0,0,0,,Byaaj mila,
Dialogue: 0,0:01:46.77,0:01:50.16,Default,,0,0,0,,phir bhi paisa kam kaise hua?
Dialogue: 0,0:01:50.16,0:01:54.82,Default,,0,0,0,,Iske liye ek shabd samajhna zaroori
Dialogue: 0,0:01:54.82,0:01:55.25,Default,,0,0,0,,hai,
Dialogue: 0,0:01:55.25,0:01:56.10,Default,,0,0,0,,mehngai.
Dialogue: 0,0:01:56.10,0:01:59.91,Default,,0,0,0,,Mehngai yaani cheezon ke daam ka
Dialogue: 0,0:01:59.91,0:02:02.46,Default,,0,0,0,,dheere dheere badhna.
Dialogue: 0,0:02:02.46,0:02:06.27,Default,,0,0,0,,Aaj jo thali aap khareedte ho,
Dialogue: 0,0:02:06.27,0:02:11.36,Default,,0,0,0,,agle saal wahi thali mehngi milegi.
Dialogue: 0,0:02:11.81,0:02:14.41,Default,,0,0,0,,Ab FD ka byaaj dekhiye.
Dialogue: 0,0:02:14.41,0:02:18.74,Default,,0,0,0,,July 2026 mein banks ne naye
Dialogue: 0,0:02:18.74,0:02:23.51,Default,,0,0,0,,FD par average lagbhag 5.9 percent
Dialogue: 0,0:02:23.51,0:02:24.37,Default,,0,0,0,,byaaj diya.
Dialogue: 0,0:02:24.37,0:02:27.84,Default,,0,0,0,,Yeh baat Grip Invest ki report
Dialogue: 0,0:02:27.84,0:02:28.71,Default,,0,0,0,,mein hai.
Dialogue: 0,0:02:28.71,0:02:32.17,Default,,0,0,0,,Sunne mein achha lagta hai.
Dialogue: 0,0:02:32.17,0:02:34.77,Default,,0,0,0,,Paisa badh raha hai,
Dialogue: 0,0:02:34.77,0:02:36.50,Default,,0,0,0,,toh sab theek hai,
Dialogue: 0,0:02:36.50,0:02:37.37,Default,,0,0,0,,hai na?
Dialogue: 0,0:02:37.82,0:02:39.81,Default,,0,0,0,,Par asli sawaal yeh hai.
Dialogue: 0,0:02:39.81,0:02:42.08,Default,,0,0,0,,Aapka paisa kitna badha,
Dialogue: 0,0:02:42.08,0:02:44.63,Default,,0,0,0,,aur aapke kharche kitne badhe?
Dialogue: 0,0:02:44.63,0:02:45.49,Default,,0,0,0,,Agar doodh,
Dialogue: 0,0:02:45.49,0:02:47.75,Default,,0,0,0,,dawai aur school fees ka kharcha
Dialogue: 0,0:02:47.75,0:02:49.18,Default,,0,0,0,,byaaj se tez badhe,
Dialogue: 0,0:02:49.18,0:02:51.73,Default,,0,0,0,,toh receipt par number bada hai,
Dialogue: 0,0:02:51.73,0:02:54.85,Default,,0,0,0,,par aapki khareedne ki taakat chhoti
Dialogue: 0,0:02:54.85,0:02:55.42,Default,,0,0,0,,ho gayi.
Dialogue: 0,0:02:55.87,0:02:58.22,Default,,0,0,0,,Isi ko kehte hain real return.
Dialogue: 0,0:02:58.22,0:03:00.31,Default,,0,0,0,,Real return yaani byaaj mein se
Dialogue: 0,0:03:00.31,0:03:02.14,Default,,0,0,0,,mehngai kaat kar jo sach mein
Dialogue: 0,0:03:02.14,0:03:02.67,Default,,0,0,0,,bacha.
Dialogue: 0,0:03:02.67,0:03:05.02,Default,,0,0,0,,Agar mehngai 5.9 percent se kam
Dialogue: 0,0:03:05.02,0:03:05.28,Default,,0,0,0,,hai,
Dialogue: 0,0:03:05.28,0:03:07.11,Default,,0,0,0,,toh aap thoda aage ho.
Dialogue: 0,0:03:07.11,0:03:08.42,Default,,0,0,0,,Agar zyada hai,
Dialogue: 0,0:03:08.42,0:03:10.77,Default,,0,0,0,,toh aap chupchaap peeche ja rahe
Dialogue: 0,0:03:10.77,0:03:11.03,Default,,0,0,0,,ho.
Dialogue: 0,0:03:11.48,0:03:14.75,Default,,0,0,0,,Ek din Beta ne apni gullak
Dialogue: 0,0:03:14.75,0:03:16.56,Default,,0,0,0,,ke sikke gine.
Dialogue: 0,0:03:16.56,0:03:20.19,Default,,0,0,0,,Dadaji yaani Papa ne kaha,
Dialogue: 0,0:03:20.19,0:03:22.00,Default,,0,0,0,,inhe mat kharcho,
Dialogue: 0,0:03:22.00,0:03:22.73,Default,,0,0,0,,bachao.
Dialogue: 0,0:03:22.73,0:03:24.54,Default,,0,0,0,,Beta ne poocha,
Dialogue: 0,0:03:24.54,0:03:25.63,Default,,0,0,0,,Dadaji,
Dialogue: 0,0:03:25.63,0:03:28.90,Default,,0,0,0,,jo toffee pichle saal in sikkon
Dialogue: 0,0:03:28.90,0:03:30.35,Default,,0,0,0,,mein aati thi,
Dialogue: 0,0:03:30.35,0:03:32.53,Default,,0,0,0,,ab kyun nahi aati?
Dialogue: 0,0:03:32.53,0:03:33.98,Default,,0,0,0,,Papa has diye,
Dialogue: 0,0:03:33.98,0:03:36.88,Default,,0,0,0,,par sawaal bilkul sahi tha.
Dialogue: 0,0:03:37.33,0:03:40.06,Default,,0,0,0,,Mehngai ek chhupa tax hai.
Dialogue: 0,0:03:40.06,0:03:42.41,Default,,0,0,0,,Koi form nahi bharta,
Dialogue: 0,0:03:42.41,0:03:45.53,Default,,0,0,0,,koi notice nahi aata.
Dialogue: 0,0:03:45.53,0:03:48.66,Default,,0,0,0,,Bas har saal aapke rupaye ki
Dialogue: 0,0:03:48.66,0:03:51.78,Default,,0,0,0,,keemat thodi ghat jaati hai.
Dialogue: 0,0:03:51.78,0:03:54.52,Default,,0,0,0,,FD ka byaaj agar is chor
Dialogue: 0,0:03:54.52,0:03:56.86,Default,,0,0,0,,se tez nahi bhaagta,
Dialogue: 0,0:03:56.86,0:03:59.99,Default,,0,0,0,,toh paisa safe dikhta hai,
Dialogue: 0,0:03:59.99,0:04:02.33,Default,,0,0,0,,par ghat-ta rehta hai.
Dialogue: 0,0:04:02.78,0:04:05.59,Default,,0,0,0,,Papa ki file mein yeh baat
Dialogue: 0,0:04:05.59,0:04:08.40,Default,,0,0,0,,kabhi likhi hi nahi thi.
Dialogue: 0,0:04:08.40,0:04:11.21,Default,,0,0,0,,Receipt sirf byaaj batati hai,
Dialogue: 0,0:04:11.21,0:04:13.67,Default,,0,0,0,,mehngai nahi batati.
Dialogue: 0,0:04:13.67,0:04:16.83,Default,,0,0,0,,Isliye Papa ko laga sab badh
Dialogue: 0,0:04:16.83,0:04:17.88,Default,,0,0,0,,raha hai.
Dialogue: 0,0:04:17.88,0:04:21.05,Default,,0,0,0,,Asal mein unki FD bas apni
Dialogue: 0,0:04:21.05,0:04:24.21,Default,,0,0,0,,jagah khadi rehne ke liye daud
Dialogue: 0,0:04:24.21,0:04:25.26,Default,,0,0,0,,rahi thi.
Dialogue: 0,0:04:25.71,0:04:27.20,Default,,0,0,0,,Doosra sawaal,
Dialogue: 0,0:04:27.20,0:04:30.56,Default,,0,0,0,,aur yahan ek aur chhupa kharcha
Dialogue: 0,0:04:30.56,0:04:30.94,Default,,0,0,0,,hai.
Dialogue: 0,0:04:30.94,0:04:33.92,Default,,0,0,0,,FD ka byaaj free nahi hota.
Dialogue: 0,0:04:33.92,0:04:37.66,Default,,0,0,0,,Woh aapki income mein judta hai.
Dialogue: 0,0:04:37.66,0:04:41.02,Default,,0,0,0,,Aur income par tax lagta hai,
Dialogue: 0,0:04:41.02,0:04:43.63,Default,,0,0,0,,aapke slab ke hisaab se.
Dialogue: 0,0:04:43.63,0:04:46.99,Default,,0,0,0,,Slab yaani income ki seedhi,
Dialogue: 0,0:04:46.99,0:04:48.48,Default,,0,0,0,,jitni oonchi,
Dialogue: 0,0:04:48.48,0:04:50.35,Default,,0,0,0,,utna zyada tax.
Dialogue: 0,0:04:50.80,0:04:53.93,Default,,0,0,0,,Behen office se aayi aur phone
Dialogue: 0,0:04:53.93,0:04:56.43,Default,,0,0,0,,par FD ki statement kholi.
Dialogue: 0,0:04:56.43,0:04:58.00,Default,,0,0,0,,Byaaj credit hua tha,
Dialogue: 0,0:04:58.00,0:04:59.56,Default,,0,0,0,,par poora nahi.
Dialogue: 0,0:04:59.56,0:05:00.81,Default,,0,0,0,,Usne poocha,
Dialogue: 0,0:05:00.81,0:05:02.07,Default,,0,0,0,,yeh kam kyun aaya?
Dialogue: 0,0:05:02.07,0:05:03.32,Default,,0,0,0,,Jawaab tha TDS.
Dialogue: 0,0:05:03.32,0:05:05.82,Default,,0,0,0,,TDS yaani bank khud aapka tax
Dialogue: 0,0:05:05.82,0:05:08.33,Default,,0,0,0,,kaat kar sarkar ko bhej deta
Dialogue: 0,0:05:08.33,0:05:08.64,Default,,0,0,0,,hai.
Dialogue: 0,0:05:09.09,0:05:11.71,Default,,0,0,0,,Behen ko laga yahi poora tax
Dialogue: 0,0:05:11.71,0:05:11.97,Default,,0,0,0,,hai.
Dialogue: 0,0:05:11.97,0:05:14.07,Default,,0,0,0,,Par aisa zaroori nahi.
Dialogue: 0,0:05:14.07,0:05:16.69,Default,,0,0,0,,TDS sirf ek advance katauti hai.
Dialogue: 0,0:05:16.69,0:05:19.58,Default,,0,0,0,,Aakhri hisaab income tax return mein
Dialogue: 0,0:05:19.58,0:05:20.36,Default,,0,0,0,,hota hai.
Dialogue: 0,0:05:20.36,0:05:22.46,Default,,0,0,0,,Agar aapka slab ooncha hai,
Dialogue: 0,0:05:22.46,0:05:24.56,Default,,0,0,0,,toh return bharte waqt aur tax
Dialogue: 0,0:05:24.56,0:05:26.13,Default,,0,0,0,,dena pad sakta hai.
Dialogue: 0,0:05:26.58,0:05:30.91,Default,,0,0,0,,Ab sabse oonche slab ki sochiye.
Dialogue: 0,0:05:30.91,0:05:35.73,Default,,0,0,0,,New regime mein sabse oonche slab
Dialogue: 0,0:05:35.73,0:05:39.10,Default,,0,0,0,,par 30 percent tax hai.
Dialogue: 0,0:05:39.10,0:05:42.95,Default,,0,0,0,,Matlab FD ke byaaj ka 30
Dialogue: 0,0:05:42.95,0:05:45.83,Default,,0,0,0,,percent sarkar ke paas.
Dialogue: 0,0:05:45.83,0:05:49.69,Default,,0,0,0,,Jo byaaj pehle hi mehngai se
Dialogue: 0,0:05:49.69,0:05:51.61,Default,,0,0,0,,lad raha tha,
Dialogue: 0,0:05:51.61,0:05:54.50,Default,,0,0,0,,woh aur patla ho gaya.
Dialogue: 0,0:05:54.95,0:05:57.24,Default,,0,0,0,,Toh FD ka asli hisaab yeh
Dialogue: 0,0:05:57.24,0:05:57.81,Default,,0,0,0,,bana.
Dialogue: 0,0:05:57.81,0:05:59.53,Default,,0,0,0,,Pehle tax katega,
Dialogue: 0,0:05:59.53,0:06:00.96,Default,,0,0,0,,phir mehngai khaayegi.
Dialogue: 0,0:06:00.96,0:06:02.10,Default,,0,0,0,,Jo bachega,
Dialogue: 0,0:06:02.10,0:06:04.68,Default,,0,0,0,,wahi aapka sach mein kamaya hua
Dialogue: 0,0:06:04.68,0:06:05.54,Default,,0,0,0,,paisa hai.
Dialogue: 0,0:06:05.54,0:06:07.82,Default,,0,0,0,,Kai logon ke liye yeh bacha
Dialogue: 0,0:06:07.82,0:06:10.69,Default,,0,0,0,,hua hissa umeed se kaafi chhota
Dialogue: 0,0:06:10.69,0:06:11.83,Default,,0,0,0,,nikalta hai.
Dialogue: 0,0:06:12.28,0:06:15.17,Default,,0,0,0,,Par har kisi par itna tax
Dialogue: 0,0:06:15.17,0:06:16.62,Default,,0,0,0,,nahi lagta.
Dialogue: 0,0:06:16.62,0:06:18.78,Default,,0,0,0,,Papa retired hain,
Dialogue: 0,0:06:18.78,0:06:21.31,Default,,0,0,0,,unki income kam hai.
Dialogue: 0,0:06:21.31,0:06:24.56,Default,,0,0,0,,New regime mein 12 lakh tak
Dialogue: 0,0:06:24.56,0:06:26.37,Default,,0,0,0,,ki income par,
Dialogue: 0,0:06:26.37,0:06:28.18,Default,,0,0,0,,rebate ke baad,
Dialogue: 0,0:06:28.18,0:06:30.35,Default,,0,0,0,,tax zero banta hai.
Dialogue: 0,0:06:30.35,0:06:33.96,Default,,0,0,0,,Rebate yaani sarkar ki di hui
Dialogue: 0,0:06:33.96,0:06:34.32,Default,,0,0,0,,chhoot.
Dialogue: 0,0:06:34.77,0:06:37.47,Default,,0,0,0,,Matlab Papa jaise logon ke liye
Dialogue: 0,0:06:37.47,0:06:39.63,Default,,0,0,0,,tax ka bojh halka ho sakta
Dialogue: 0,0:06:39.63,0:06:39.90,Default,,0,0,0,,hai.
Dialogue: 0,0:06:39.90,0:06:41.79,Default,,0,0,0,,Par mehngai ka chor phir bhi
Dialogue: 0,0:06:41.79,0:06:43.14,Default,,0,0,0,,wahin khada hai.
Dialogue: 0,0:06:43.14,0:06:44.22,Default,,0,0,0,,Tax na lage,
Dialogue: 0,0:06:44.22,0:06:46.38,Default,,0,0,0,,toh bhi kharche toh badhte hi
Dialogue: 0,0:06:46.38,0:06:46.65,Default,,0,0,0,,hain.
Dialogue: 0,0:06:46.65,0:06:48.54,Default,,0,0,0,,Isliye sirf tax mat dekhiye,
Dialogue: 0,0:06:48.54,0:06:49.89,Default,,0,0,0,,real return dekhiye.
Dialogue: 0,0:06:50.34,0:06:52.09,Default,,0,0,0,,Aur ek kaam ki baat.
Dialogue: 0,0:06:52.09,0:06:55.93,Default,,0,0,0,,Agar aapki income chhoot ke andar
Dialogue: 0,0:06:55.93,0:06:56.28,Default,,0,0,0,,hai,
Dialogue: 0,0:06:56.28,0:06:58.37,Default,,0,0,0,,par bank ne TDS kaat liya,
Dialogue: 0,0:06:58.37,0:07:01.51,Default,,0,0,0,,toh woh paisa return bharne par
Dialogue: 0,0:07:01.51,0:07:03.61,Default,,0,0,0,,wapas mil sakta hai.
Dialogue: 0,0:07:03.61,0:07:06.40,Default,,0,0,0,,Bahut log yeh claim karte hi
Dialogue: 0,0:07:06.40,0:07:07.10,Default,,0,0,0,,nahi.
Dialogue: 0,0:07:07.10,0:07:10.94,Default,,0,0,0,,Unka paisa yunhi pada rehta hai.
Dialogue: 0,0:07:11.39,0:07:13.15,Default,,0,0,0,,Teesra sawaal.
Dialogue: 0,0:07:13.15,0:07:15.78,Default,,0,0,0,,Toh kya FD bekaar hai?
Dialogue: 0,0:07:15.78,0:07:17.54,Default,,0,0,0,,Bilkul nahi.
Dialogue: 0,0:07:17.54,0:07:20.62,Default,,0,0,0,,Har cheez ka ek kaam hota
Dialogue: 0,0:07:20.62,0:07:21.05,Default,,0,0,0,,hai.
Dialogue: 0,0:07:21.05,0:07:25.01,Default,,0,0,0,,FD ka kaam paisa badhana kam,
Dialogue: 0,0:07:25.01,0:07:29.40,Default,,0,0,0,,paisa sambhaal kar rakhna zyada hai.
Dialogue: 0,0:07:29.40,0:07:32.48,Default,,0,0,0,,Aur ek jagah yeh kaam FD
Dialogue: 0,0:07:32.48,0:07:35.99,Default,,0,0,0,,bahut achhe se karti hai.
Dialogue: 0,0:07:36.44,0:07:39.71,Default,,0,0,0,,Ek raat Papa ko seene mein
Dialogue: 0,0:07:39.71,0:07:40.53,Default,,0,0,0,,dard hua.
Dialogue: 0,0:07:40.53,0:07:44.21,Default,,0,0,0,,Hospital mein pehla sawaal tha,
Dialogue: 0,0:07:44.21,0:07:48.30,Default,,0,0,0,,deposit kitna jama karoge?
Dialogue: 0,0:07:48.30,0:07:51.98,Default,,0,0,0,,Us waqt kisi lambi scheme ka
Dialogue: 0,0:07:51.98,0:07:55.67,Default,,0,0,0,,intezaar nahi ho sakta tha.
Dialogue: 0,0:07:55.67,0:07:58.94,Default,,0,0,0,,Paisa usi raat chahiye tha,
Dialogue: 0,0:07:58.94,0:08:01.80,Default,,0,0,0,,bina kisi deri ke.
Dialogue: 0,0:08:02.25,0:08:06.62,Default,,0,0,0,,Isi ko kehte hain emergency fund.
Dialogue: 0,0:08:06.62,0:08:10.98,Default,,0,0,0,,Emergency fund yaani woh paisa jo
Dialogue: 0,0:08:10.98,0:08:14.16,Default,,0,0,0,,sirf mushkil waqt ke liye rakha
Dialogue: 0,0:08:14.16,0:08:14.55,Default,,0,0,0,,ho.
Dialogue: 0,0:08:14.55,0:08:16.14,Default,,0,0,0,,Naukri chhoot jaaye,
Dialogue: 0,0:08:16.14,0:08:17.73,Default,,0,0,0,,beemari aaye,
Dialogue: 0,0:08:17.73,0:08:21.30,Default,,0,0,0,,ya ghar mein achanak kharcha aa
Dialogue: 0,0:08:21.30,0:08:21.70,Default,,0,0,0,,jaaye.
Dialogue: 0,0:08:21.70,0:08:25.67,Default,,0,0,0,,Is paise ka kaam kamaana nahi,
Dialogue: 0,0:08:25.67,0:08:27.65,Default,,0,0,0,,waqt par milna hai.
Dialogue: 0,0:08:28.10,0:08:30.36,Default,,0,0,0,,Yahan FD ya savings account kaam
Dialogue: 0,0:08:30.36,0:08:31.11,Default,,0,0,0,,aata hai.
Dialogue: 0,0:08:31.11,0:08:33.12,Default,,0,0,0,,Paisa jaldi nikalta hai,
Dialogue: 0,0:08:33.12,0:08:35.38,Default,,0,0,0,,daam upar neeche nahi hote.
Dialogue: 0,0:08:35.38,0:08:36.88,Default,,0,0,0,,Mehngai thoda khaayegi,
Dialogue: 0,0:08:36.88,0:08:37.38,Default,,0,0,0,,maana.
Dialogue: 0,0:08:37.38,0:08:40.39,Default,,0,0,0,,Par emergency mein turant paisa milne
Dialogue: 0,0:08:40.39,0:08:42.65,Default,,0,0,0,,ki keemat us thode nuksaan se
Dialogue: 0,0:08:42.65,0:08:43.90,Default,,0,0,0,,kahin zyada hai.
Dialogue: 0,0:08:43.90,0:08:45.66,Default,,0,0,0,,Raat ko neend bhi aati hai.
Dialogue: 0,0:08:46.11,0:08:48.16,Default,,0,0,0,,Aur agar bank hi doob jaaye
Dialogue: 0,0:08:48.16,0:08:48.46,Default,,0,0,0,,toh?
Dialogue: 0,0:08:48.46,0:08:50.80,Default,,0,0,0,,Yahan DICGC ka naam aata hai.
Dialogue: 0,0:08:50.80,0:08:54.32,Default,,0,0,0,,DICGC yaani bank deposits ka insurance
Dialogue: 0,0:08:54.32,0:08:56.08,Default,,0,0,0,,dene wali sanstha.
Dialogue: 0,0:08:56.08,0:08:58.13,Default,,0,0,0,,Har depositor ke liye,
Dialogue: 0,0:08:58.13,0:08:59.01,Default,,0,0,0,,har bank mein,
Dialogue: 0,0:08:59.01,0:09:01.35,Default,,0,0,0,,5 lakh rupaye tak ka cover
Dialogue: 0,0:09:01.35,0:09:02.23,Default,,0,0,0,,milta hai.
Dialogue: 0,0:09:02.68,0:09:04.55,Default,,0,0,0,,Isliye Wife ne ghar ka ek
Dialogue: 0,0:09:04.55,0:09:05.73,Default,,0,0,0,,simple niyam banaya.
Dialogue: 0,0:09:05.73,0:09:08.30,Default,,0,0,0,,Poora emergency paisa ek hi bank
Dialogue: 0,0:09:08.30,0:09:09.01,Default,,0,0,0,,mein nahi,
Dialogue: 0,0:09:09.01,0:09:11.35,Default,,0,0,0,,zaroorat ho toh alag alag banks
Dialogue: 0,0:09:11.35,0:09:11.58,Default,,0,0,0,,mein.
Dialogue: 0,0:09:11.58,0:09:13.93,Default,,0,0,0,,Taaki har jagah paisa cover ke
Dialogue: 0,0:09:13.93,0:09:14.86,Default,,0,0,0,,andar rahe.
Dialogue: 0,0:09:14.86,0:09:16.03,Default,,0,0,0,,Yeh dar nahi hai,
Dialogue: 0,0:09:16.03,0:09:17.44,Default,,0,0,0,,bas samajhdaari hai.
Dialogue: 0,0:09:17.89,0:09:19.64,Default,,0,0,0,,FD chhote goals ke liye bhi
Dialogue: 0,0:09:19.64,0:09:20.64,Default,,0,0,0,,theek baithti hai.
Dialogue: 0,0:09:20.64,0:09:22.40,Default,,0,0,0,,Agle saal bachche ki fees,
Dialogue: 0,0:09:22.40,0:09:24.65,Default,,0,0,0,,ya kuch mahine baad shaadi ka
Dialogue: 0,0:09:24.65,0:09:25.15,Default,,0,0,0,,kharcha.
Dialogue: 0,0:09:25.15,0:09:26.90,Default,,0,0,0,,Jab paisa jaldi chahiye,
Dialogue: 0,0:09:26.90,0:09:29.66,Default,,0,0,0,,toh upar neeche hone wali jagah
Dialogue: 0,0:09:29.66,0:09:32.41,Default,,0,0,0,,ka risk lena samajhdaari nahi hai.
Dialogue: 0,0:09:32.86,0:09:35.05,Default,,0,0,0,,Ab woh galti jo Papa ne
Dialogue: 0,0:09:35.05,0:09:35.33,Default,,0,0,0,,ki,
Dialogue: 0,0:09:35.33,0:09:37.25,Default,,0,0,0,,aur bahut log karte hain.
Dialogue: 0,0:09:37.25,0:09:39.44,Default,,0,0,0,,Galti FD lena nahi thi.
Dialogue: 0,0:09:39.44,0:09:40.26,Default,,0,0,0,,Galti thi,
Dialogue: 0,0:09:40.26,0:09:43.28,Default,,0,0,0,,saari zindagi ki bachat saalon saal
Dialogue: 0,0:09:43.28,0:09:44.65,Default,,0,0,0,,sirf FD mein rakhna.
Dialogue: 0,0:09:44.65,0:09:47.11,Default,,0,0,0,,Lambe samay ke paise ko bhi
Dialogue: 0,0:09:47.11,0:09:49.58,Default,,0,0,0,,emergency jaisa treat karna.
Dialogue: 0,0:09:50.03,0:09:54.23,Default,,0,0,0,,Lambe samay mein mehngai har saal
Dialogue: 0,0:09:54.23,0:09:56.56,Default,,0,0,0,,thoda kaatti hai.
Dialogue: 0,0:09:56.56,0:09:58.89,Default,,0,0,0,,Upar se tax bhi.
Dialogue: 0,0:09:58.89,0:10:03.08,Default,,0,0,0,,Saal dar saal yeh chhoti katauti
Dialogue: 0,0:10:03.08,0:10:05.41,Default,,0,0,0,,judti jaati hai.
Dialogue: 0,0:10:05.41,0:10:09.14,Default,,0,0,0,,Aur ek din Mummy poochti hain,
Dialogue: 0,0:10:09.14,0:10:11.47,Default,,0,0,0,,paisa kahan gaya?
Dialogue: 0,0:10:11.47,0:10:12.87,Default,,0,0,0,,Jawaab hai,
Dialogue: 0,0:10:12.87,0:10:13.80,Default,,0,0,0,,chupchaap,
Dialogue: 0,0:10:13.80,0:10:15.67,Default,,0,0,0,,dheere dheere.
Dialogue: 0,0:10:16.12,0:10:17.11,Default,,0,0,0,,Toh kya karein?
Dialogue: 0,0:10:17.11,0:10:18.09,Default,,0,0,0,,Pehla kadam,
Dialogue: 0,0:10:18.09,0:10:20.31,Default,,0,0,0,,apni bachat ko kaam ke hisaab
Dialogue: 0,0:10:20.31,0:10:21.05,Default,,0,0,0,,se baantiye.
Dialogue: 0,0:10:21.05,0:10:22.78,Default,,0,0,0,,Kuch paisa turant chahiye,
Dialogue: 0,0:10:22.78,0:10:24.26,Default,,0,0,0,,kuch paisa saalon baad.
Dialogue: 0,0:10:24.26,0:10:26.48,Default,,0,0,0,,Dono ko ek hi jagah rakhna,
Dialogue: 0,0:10:26.48,0:10:28.45,Default,,0,0,0,,ek hi chaabi se har taala
Dialogue: 0,0:10:28.45,0:10:29.68,Default,,0,0,0,,kholne jaisa hai.
Dialogue: 0,0:10:30.13,0:10:31.77,Default,,0,0,0,,Doosra kadam,
Dialogue: 0,0:10:31.77,0:10:35.05,Default,,0,0,0,,har saal apna real return khud
Dialogue: 0,0:10:35.05,0:10:36.28,Default,,0,0,0,,nikaaliye.
Dialogue: 0,0:10:36.28,0:10:37.51,Default,,0,0,0,,Byaaj dekhiye,
Dialogue: 0,0:10:37.51,0:10:38.74,Default,,0,0,0,,tax ghataiye,
Dialogue: 0,0:10:38.74,0:10:42.43,Default,,0,0,0,,aur ghar ke kharche kitne badhe,
Dialogue: 0,0:10:42.43,0:10:43.67,Default,,0,0,0,,yeh sochiye.
Dialogue: 0,0:10:43.67,0:10:48.18,Default,,0,0,0,,Agar bacha hua hissa bahut chhota
Dialogue: 0,0:10:48.18,0:10:48.59,Default,,0,0,0,,hai,
Dialogue: 0,0:10:48.59,0:10:51.87,Default,,0,0,0,,toh kam se kam sawaal zaroor
Dialogue: 0,0:10:51.87,0:10:52.69,Default,,0,0,0,,poochiye.
Dialogue: 0,0:10:53.14,0:10:54.29,Default,,0,0,0,,Teesra kadam,
Dialogue: 0,0:10:54.29,0:10:56.89,Default,,0,0,0,,lambe goals ke liye doosre raaste
Dialogue: 0,0:10:56.89,0:10:57.76,Default,,0,0,0,,samajhiye.
Dialogue: 0,0:10:57.76,0:10:58.62,Default,,0,0,0,,Jaise PPF,
Dialogue: 0,0:10:58.62,0:11:01.51,Default,,0,0,0,,jo sarkari scheme hai aur abhi
Dialogue: 0,0:11:01.51,0:11:04.40,Default,,0,0,0,,7.1 percent saalana byaaj deti hai.
Dialogue: 0,0:11:04.40,0:11:06.13,Default,,0,0,0,,Har option ka lock-in,
Dialogue: 0,0:11:06.13,0:11:08.44,Default,,0,0,0,,risk aur tax alag hota hai.
Dialogue: 0,0:11:08.44,0:11:09.59,Default,,0,0,0,,Pehle samjho,
Dialogue: 0,0:11:09.59,0:11:10.46,Default,,0,0,0,,phir socho.
Dialogue: 0,0:11:10.91,0:11:13.36,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:11:13.36,0:11:16.05,Default,,0,0,0,,Kahin bhi paisa lagane se pehle
Dialogue: 0,0:11:16.05,0:11:17.27,Default,,0,0,0,,apni zaroorat,
Dialogue: 0,0:11:17.27,0:11:18.74,Default,,0,0,0,,umar aur risk dekhiye.
Dialogue: 0,0:11:18.74,0:11:21.92,Default,,0,0,0,,Zaroorat ho toh kisi qualified advisor
Dialogue: 0,0:11:21.92,0:11:22.89,Default,,0,0,0,,se baat kariye.
Dialogue: 0,0:11:22.89,0:11:24.85,Default,,0,0,0,,Maqsad sirf itna hai ki aap
Dialogue: 0,0:11:24.85,0:11:27.05,Default,,0,0,0,,receipt ke number ke peeche ka
Dialogue: 0,0:11:27.05,0:11:28.03,Default,,0,0,0,,sach dekh sako.
Dialogue: 0,0:11:28.48,0:11:31.27,Default,,0,0,0,,Us raat Papa ne file kholi,
Dialogue: 0,0:11:31.27,0:11:33.74,Default,,0,0,0,,aur pehli baar receipt ke saath
Dialogue: 0,0:11:33.74,0:11:35.60,Default,,0,0,0,,sabzi ka bill rakha.
Dialogue: 0,0:11:35.60,0:11:37.15,Default,,0,0,0,,Dono ko dekha,
Dialogue: 0,0:11:37.15,0:11:39.01,Default,,0,0,0,,aur dheere se bole,
Dialogue: 0,0:11:39.01,0:11:41.18,Default,,0,0,0,,safe hona aur badhna,
Dialogue: 0,0:11:41.18,0:11:42.72,Default,,0,0,0,,alag cheezein hain.
Dialogue: 0,0:11:42.72,0:11:45.82,Default,,0,0,0,,Mujhe yeh pehle kisi ne nahi
Dialogue: 0,0:11:45.82,0:11:46.44,Default,,0,0,0,,bataya.
Dialogue: 0,0:11:46.89,0:11:49.25,Default,,0,0,0,,Ab aapse ek aasaan sawaal.
Dialogue: 0,0:11:49.25,0:11:52.19,Default,,0,0,0,,Aapke ghar ki sabse zyada bachat
Dialogue: 0,0:11:52.19,0:11:53.66,Default,,0,0,0,,kahan rakhi hai,
Dialogue: 0,0:11:53.66,0:11:55.43,Default,,0,0,0,,FD mein ya kahin aur?
Dialogue: 0,0:11:55.43,0:11:57.79,Default,,0,0,0,,Ek shabd mein comment mein likhiye.
Dialogue: 0,0:11:57.79,0:11:59.85,Default,,0,0,0,,Main har jawaab padhta hoon.
Dialogue: 0,0:12:00.30,0:12:03.65,Default,,0,0,0,,Agli video mein ek aur ghar
Dialogue: 0,0:12:03.65,0:12:05.32,Default,,0,0,0,,ki kahani.
Dialogue: 0,0:12:05.32,0:12:06.16,Default,,0,0,0,,Sona,
Dialogue: 0,0:12:06.16,0:12:09.50,Default,,0,0,0,,jo har maa ki almirah mein
Dialogue: 0,0:12:09.50,0:12:13.69,Default,,0,0,0,,kahin na kahin rakha hota hai.
Dialogue: 0,0:12:13.69,0:12:16.62,Default,,0,0,0,,Kya woh sach mein mehngai se
Dialogue: 0,0:12:16.62,0:12:18.29,Default,,0,0,0,,bachata hai,
Dialogue: 0,0:12:18.29,0:12:22.48,Default,,0,0,0,,ya woh bhi ek meethi galatfehmi
Dialogue: 0,0:12:22.48,0:12:22.89,Default,,0,0,0,,hai?
Dialogue: 0,0:12:22.89,0:12:26.66,Default,,0,0,0,,Milte hain agli kahani mein.
