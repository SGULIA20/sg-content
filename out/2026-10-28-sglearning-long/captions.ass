Dialogue: 0,0:00:00.00,0:00:04.15,Default,,0,0,0,,Papa ki FD poori tarah safe
Dialogue: 0,0:00:04.15,0:00:04.57,Default,,0,0,0,,thi,
Dialogue: 0,0:00:04.57,0:00:07.89,Default,,0,0,0,,phir bhi chupchaap chhoti ho gayi.
Dialogue: 0,0:00:07.89,0:00:09.55,Default,,0,0,0,,Na bank doobi,
Dialogue: 0,0:00:09.55,0:00:12.46,Default,,0,0,0,,na kisi ne chori ki.
Dialogue: 0,0:00:12.46,0:00:16.19,Default,,0,0,0,,Passbook mein rakam har saal badhti
Dialogue: 0,0:00:16.19,0:00:17.02,Default,,0,0,0,,rahi.
Dialogue: 0,0:00:17.02,0:00:19.93,Default,,0,0,0,,Phir bhi jis din FD todi,
Dialogue: 0,0:00:19.93,0:00:23.25,Default,,0,0,0,,us paise se woh kaam nahi
Dialogue: 0,0:00:23.25,0:00:23.67,Default,,0,0,0,,hua,
Dialogue: 0,0:00:23.67,0:00:26.16,Default,,0,0,0,,jiske liye jodi thi.
Dialogue: 0,0:00:26.61,0:00:29.26,Default,,0,0,0,,Kahani shuru hoti hai bank ki
Dialogue: 0,0:00:29.26,0:00:30.85,Default,,0,0,0,,ek purani branch se.
Dialogue: 0,0:00:30.85,0:00:33.50,Default,,0,0,0,,Papa ne beta hone ki khushi
Dialogue: 0,0:00:33.50,0:00:34.83,Default,,0,0,0,,mein ek FD banwayi.
Dialogue: 0,0:00:34.83,0:00:37.48,Default,,0,0,0,,Bank Uncle ne muskura kar receipt
Dialogue: 0,0:00:37.48,0:00:37.75,Default,,0,0,0,,di.
Dialogue: 0,0:00:37.75,0:00:40.40,Default,,0,0,0,,Papa ne woh receipt almari ke
Dialogue: 0,0:00:40.40,0:00:41.19,Default,,0,0,0,,lockbox mein,
Dialogue: 0,0:00:41.19,0:00:43.05,Default,,0,0,0,,kapdon ke neeche rakh di.
Dialogue: 0,0:00:43.50,0:00:46.31,Default,,0,0,0,,Papa ka plan seedha tha.
Dialogue: 0,0:00:46.31,0:00:48.72,Default,,0,0,0,,Beta bada hoga,
Dialogue: 0,0:00:48.72,0:00:50.72,Default,,0,0,0,,college jaayega,
Dialogue: 0,0:00:50.72,0:00:53.13,Default,,0,0,0,,tab yeh FD kaam aayegi.
Dialogue: 0,0:00:53.13,0:00:56.34,Default,,0,0,0,,Har baar FD mature hoti,
Dialogue: 0,0:00:56.34,0:01:00.75,Default,,0,0,0,,Papa usse phir renew karwa dete.
Dialogue: 0,0:01:00.75,0:01:03.96,Default,,0,0,0,,Byaaj bhi usi mein jud jaata.
Dialogue: 0,0:01:03.96,0:01:05.97,Default,,0,0,0,,Ghar mein sab kehte,
Dialogue: 0,0:01:05.97,0:01:09.58,Default,,0,0,0,,Papa ka paisa toh safe hai.
Dialogue: 0,0:01:10.03,0:01:11.44,Default,,0,0,0,,Mummy bhi khush thi.
Dialogue: 0,0:01:11.44,0:01:13.71,Default,,0,0,0,,Share market ka darr nahi,
Dialogue: 0,0:01:13.71,0:01:16.82,Default,,0,0,0,,kisi agent ki chikni baatein nahi.
Dialogue: 0,0:01:16.82,0:01:17.39,Default,,0,0,0,,Bas bank,
Dialogue: 0,0:01:17.39,0:01:19.93,Default,,0,0,0,,receipt aur har saal badhti rakam.
Dialogue: 0,0:01:19.93,0:01:22.48,Default,,0,0,0,,Unke liye FD ek bharosa thi,
Dialogue: 0,0:01:22.48,0:01:25.59,Default,,0,0,0,,jaise almari mein rakha hua sona.
Dialogue: 0,0:01:26.04,0:01:29.32,Default,,0,0,0,,Ab beta bada ho gaya hai.
Dialogue: 0,0:01:29.32,0:01:30.97,Default,,0,0,0,,Hoodie pehne,
Dialogue: 0,0:01:30.97,0:01:32.61,Default,,0,0,0,,phone haath mein,
Dialogue: 0,0:01:32.61,0:01:35.07,Default,,0,0,0,,woh ab ghar ka Bhai hai.
Dialogue: 0,0:01:35.07,0:01:38.77,Default,,0,0,0,,Usne college ki fees ka form
Dialogue: 0,0:01:38.77,0:01:39.59,Default,,0,0,0,,dekha.
Dialogue: 0,0:01:39.59,0:01:42.46,Default,,0,0,0,,Papa ne garv se FD ki
Dialogue: 0,0:01:42.46,0:01:44.51,Default,,0,0,0,,receipt nikali.
Dialogue: 0,0:01:44.51,0:01:45.33,Default,,0,0,0,,Socha,
Dialogue: 0,0:01:45.33,0:01:48.21,Default,,0,0,0,,aaj woh din aa gaya jiska
Dialogue: 0,0:01:48.21,0:01:51.08,Default,,0,0,0,,itne saal intezaar kiya.
Dialogue: 0,0:01:51.53,0:01:56.10,Default,,0,0,0,,Bank Uncle ne calculator chalaya aur
Dialogue: 0,0:01:56.10,0:01:59.42,Default,,0,0,0,,maturity amount bataya.
Dialogue: 0,0:01:59.42,0:02:02.33,Default,,0,0,0,,Rakam sach mein badi thi,
Dialogue: 0,0:02:02.33,0:02:06.07,Default,,0,0,0,,shuru ki rakam se kai guna.
Dialogue: 0,0:02:06.07,0:02:08.15,Default,,0,0,0,,Papa muskuraye.
Dialogue: 0,0:02:08.15,0:02:10.64,Default,,0,0,0,,Phir Bhai ne fees ka form
Dialogue: 0,0:02:10.64,0:02:12.30,Default,,0,0,0,,saamne rakha.
Dialogue: 0,0:02:12.30,0:02:15.63,Default,,0,0,0,,Aur kamre mein ek ajeeb si
Dialogue: 0,0:02:15.63,0:02:17.29,Default,,0,0,0,,chuppi chha gayi.
Dialogue: 0,0:02:17.74,0:02:20.56,Default,,0,0,0,,Fees us FD se zyada thi.
Dialogue: 0,0:02:20.56,0:02:24.58,Default,,0,0,0,,Itni zyada ki Papa ko yakeen
Dialogue: 0,0:02:24.58,0:02:25.79,Default,,0,0,0,,nahi hua.
Dialogue: 0,0:02:25.79,0:02:29.81,Default,,0,0,0,,Jis paise se unke zamane mein
Dialogue: 0,0:02:29.81,0:02:32.63,Default,,0,0,0,,poori padhai ho jaati,
Dialogue: 0,0:02:32.63,0:02:37.06,Default,,0,0,0,,aaj usse kuch hi semester nikalte.
Dialogue: 0,0:02:37.06,0:02:40.28,Default,,0,0,0,,Paisa kahin gaya nahi tha.
Dialogue: 0,0:02:40.28,0:02:43.50,Default,,0,0,0,,Bas uski taakat kam ho gayi
Dialogue: 0,0:02:43.50,0:02:43.90,Default,,0,0,0,,thi.
Dialogue: 0,0:02:44.35,0:02:47.38,Default,,0,0,0,,Yahi hai mehngai ka chhupa tax.
Dialogue: 0,0:02:47.38,0:02:48.73,Default,,0,0,0,,Koi form nahi,
Dialogue: 0,0:02:48.73,0:02:50.76,Default,,0,0,0,,koi notice nahi,
Dialogue: 0,0:02:50.76,0:02:53.79,Default,,0,0,0,,passbook mein koi kata hua paisa
Dialogue: 0,0:02:53.79,0:02:55.14,Default,,0,0,0,,nahi dikhta.
Dialogue: 0,0:02:55.14,0:02:57.16,Default,,0,0,0,,Phir bhi yeh tax har saal
Dialogue: 0,0:02:57.16,0:02:58.85,Default,,0,0,0,,chupchaap lagta hai.
Dialogue: 0,0:02:58.85,0:03:01.21,Default,,0,0,0,,Aur sabse zyada un par,
Dialogue: 0,0:03:01.21,0:03:03.91,Default,,0,0,0,,jo sabse safe khelte hain.
Dialogue: 0,0:03:04.36,0:03:06.18,Default,,0,0,0,,Aaj ke sawaal yeh hain.
Dialogue: 0,0:03:06.18,0:03:06.79,Default,,0,0,0,,Pehla,
Dialogue: 0,0:03:06.79,0:03:08.31,Default,,0,0,0,,byaaj milta raha,
Dialogue: 0,0:03:08.31,0:03:10.74,Default,,0,0,0,,phir bhi paisa kam kaise hua?
Dialogue: 0,0:03:10.74,0:03:11.35,Default,,0,0,0,,Doosra,
Dialogue: 0,0:03:11.35,0:03:13.48,Default,,0,0,0,,FD par tax kab aur kitna
Dialogue: 0,0:03:13.48,0:03:14.39,Default,,0,0,0,,kat-ta hai?
Dialogue: 0,0:03:14.39,0:03:15.30,Default,,0,0,0,,Aur aakhri,
Dialogue: 0,0:03:15.30,0:03:17.43,Default,,0,0,0,,FD rakhein bhi ya nahi,
Dialogue: 0,0:03:17.43,0:03:20.47,Default,,0,0,0,,aur emergency fund kahan rakhein?
Dialogue: 0,0:03:20.47,0:03:21.38,Default,,0,0,0,,Seedhi baat,
Dialogue: 0,0:03:21.38,0:03:22.60,Default,,0,0,0,,ek ek karke.
Dialogue: 0,0:03:23.05,0:03:26.06,Default,,0,0,0,,Pehle ek chhota sa experiment.
Dialogue: 0,0:03:26.06,0:03:29.06,Default,,0,0,0,,Socho aaj kirana dukaan se aap
Dialogue: 0,0:03:29.06,0:03:31.47,Default,,0,0,0,,ek thaila saaman lete ho.
Dialogue: 0,0:03:31.47,0:03:31.77,Default,,0,0,0,,Daal,
Dialogue: 0,0:03:31.77,0:03:32.37,Default,,0,0,0,,chawal,
Dialogue: 0,0:03:32.37,0:03:32.67,Default,,0,0,0,,tel,
Dialogue: 0,0:03:32.67,0:03:33.57,Default,,0,0,0,,chai patti.
Dialogue: 0,0:03:33.57,0:03:36.58,Default,,0,0,0,,Ab wahi thaila agle saal lene
Dialogue: 0,0:03:36.58,0:03:36.88,Default,,0,0,0,,jaao.
Dialogue: 0,0:03:36.88,0:03:38.38,Default,,0,0,0,,Shopkeeper wahi,
Dialogue: 0,0:03:38.38,0:03:39.59,Default,,0,0,0,,saaman wahi,
Dialogue: 0,0:03:39.59,0:03:41.69,Default,,0,0,0,,par bill thoda zyada hai.
Dialogue: 0,0:03:42.14,0:03:44.32,Default,,0,0,0,,Isi ko mehngai kehte hain,
Dialogue: 0,0:03:44.32,0:03:46.51,Default,,0,0,0,,yaani har saal cheezon ke daam
Dialogue: 0,0:03:46.51,0:03:48.15,Default,,0,0,0,,ka thoda badh jaana.
Dialogue: 0,0:03:48.15,0:03:50.61,Default,,0,0,0,,Ek saal mein farak chhota lagta
Dialogue: 0,0:03:50.61,0:03:50.88,Default,,0,0,0,,hai.
Dialogue: 0,0:03:50.88,0:03:52.79,Default,,0,0,0,,Par saal dar saal yeh farak
Dialogue: 0,0:03:52.79,0:03:54.16,Default,,0,0,0,,judta jaata hai.
Dialogue: 0,0:03:54.16,0:03:56.34,Default,,0,0,0,,Bilkul FD ke byaaj ki tarah,
Dialogue: 0,0:03:56.34,0:03:57.98,Default,,0,0,0,,bas ulti disha mein.
Dialogue: 0,0:03:58.43,0:04:01.68,Default,,0,0,0,,Ab FD ka hisaab dekho.
Dialogue: 0,0:04:01.68,0:04:04.93,Default,,0,0,0,,Is saal July mein banks nayi
Dialogue: 0,0:04:04.93,0:04:10.04,Default,,0,0,0,,FD par average lagbhag 5.9 percent
Dialogue: 0,0:04:10.04,0:04:12.36,Default,,0,0,0,,byaaj de rahe the.
Dialogue: 0,0:04:12.36,0:04:17.01,Default,,0,0,0,,Yaani aapka paisa har saal itna
Dialogue: 0,0:04:17.01,0:04:18.40,Default,,0,0,0,,badhta hai.
Dialogue: 0,0:04:18.40,0:04:22.12,Default,,0,0,0,,Sunne mein achha lagta hai,
Dialogue: 0,0:04:22.12,0:04:23.51,Default,,0,0,0,,aur hai bhi.
Dialogue: 0,0:04:23.96,0:04:27.19,Default,,0,0,0,,Par asli sawaal yeh hai ki
Dialogue: 0,0:04:27.19,0:04:30.82,Default,,0,0,0,,aapka thaila kitna mehnga hua.
Dialogue: 0,0:04:30.82,0:04:34.45,Default,,0,0,0,,Agar daam bhi lagbhag utne hi
Dialogue: 0,0:04:34.45,0:04:35.25,Default,,0,0,0,,badhe,
Dialogue: 0,0:04:35.25,0:04:37.27,Default,,0,0,0,,jitna byaaj mila,
Dialogue: 0,0:04:37.27,0:04:40.09,Default,,0,0,0,,toh aap wahin khade ho.
Dialogue: 0,0:04:40.09,0:04:41.71,Default,,0,0,0,,Rakam badhi,
Dialogue: 0,0:04:41.71,0:04:45.34,Default,,0,0,0,,par thaile mein saaman utna hi
Dialogue: 0,0:04:45.34,0:04:48.16,Default,,0,0,0,,aata hai jitna pehle.
Dialogue: 0,0:04:48.61,0:04:51.27,Default,,0,0,0,,Isko kehte hain real return,
Dialogue: 0,0:04:51.27,0:04:53.93,Default,,0,0,0,,yaani mehngai kaat kar jo sach
Dialogue: 0,0:04:53.93,0:04:54.92,Default,,0,0,0,,mein bacha.
Dialogue: 0,0:04:54.92,0:04:58.91,Default,,0,0,0,,Passbook sirf nominal return dikhati hai,
Dialogue: 0,0:04:58.91,0:05:00.57,Default,,0,0,0,,yaani seedha byaaj.
Dialogue: 0,0:05:00.57,0:05:02.90,Default,,0,0,0,,Byaaj se mehngai ghata do,
Dialogue: 0,0:05:02.90,0:05:06.22,Default,,0,0,0,,jo bache wahi asli kamai hai.
Dialogue: 0,0:05:06.22,0:05:09.21,Default,,0,0,0,,Real return koi bank nahi chhaapta.
Dialogue: 0,0:05:09.66,0:05:12.95,Default,,0,0,0,,Ab socho Papa ke ghar mein
Dialogue: 0,0:05:12.95,0:05:13.77,Default,,0,0,0,,kya hua.
Dialogue: 0,0:05:13.77,0:05:15.82,Default,,0,0,0,,Har saal byaaj juda,
Dialogue: 0,0:05:15.82,0:05:18.29,Default,,0,0,0,,par college ki fees,
Dialogue: 0,0:05:18.29,0:05:19.11,Default,,0,0,0,,dawai,
Dialogue: 0,0:05:19.11,0:05:19.52,Default,,0,0,0,,doodh,
Dialogue: 0,0:05:19.52,0:05:23.63,Default,,0,0,0,,sab usse tezi se mehnge hote
Dialogue: 0,0:05:23.63,0:05:24.04,Default,,0,0,0,,gaye.
Dialogue: 0,0:05:24.04,0:05:27.74,Default,,0,0,0,,Padhai aur ilaaj toh aksar aam
Dialogue: 0,0:05:27.74,0:05:31.02,Default,,0,0,0,,mehngai se bhi tez bhaagte hain.
Dialogue: 0,0:05:31.02,0:05:33.90,Default,,0,0,0,,Wahi Papa ke saath hua.
Dialogue: 0,0:05:34.35,0:05:36.53,Default,,0,0,0,,Matlab FD ne Papa ko dhokha
Dialogue: 0,0:05:36.53,0:05:37.26,Default,,0,0,0,,nahi diya.
Dialogue: 0,0:05:37.26,0:05:39.20,Default,,0,0,0,,FD ne apna waada nibhaya.
Dialogue: 0,0:05:39.20,0:05:41.14,Default,,0,0,0,,Galti yeh thi ki ek lambe
Dialogue: 0,0:05:41.14,0:05:43.33,Default,,0,0,0,,goal ke liye aisa saadhan chuna,
Dialogue: 0,0:05:43.33,0:05:45.75,Default,,0,0,0,,jo mehngai se bas barabari kar
Dialogue: 0,0:05:45.75,0:05:46.48,Default,,0,0,0,,sakta tha,
Dialogue: 0,0:05:46.48,0:05:48.91,Default,,0,0,0,,use peeche nahi chhod sakta tha.
Dialogue: 0,0:05:49.36,0:05:51.40,Default,,0,0,0,,Mummy ne poocha,
Dialogue: 0,0:05:51.40,0:05:54.66,Default,,0,0,0,,toh kya hum itne saal ghaate
Dialogue: 0,0:05:54.66,0:05:55.48,Default,,0,0,0,,mein the?
Dialogue: 0,0:05:55.48,0:05:57.11,Default,,0,0,0,,Seedha jawab,
Dialogue: 0,0:05:57.11,0:06:00.38,Default,,0,0,0,,shayad poore ghaate mein nahi.
Dialogue: 0,0:06:00.38,0:06:02.82,Default,,0,0,0,,Par jitna socha tha,
Dialogue: 0,0:06:02.82,0:06:06.50,Default,,0,0,0,,utna aage bhi nahi badhe.
Dialogue: 0,0:06:06.50,0:06:09.76,Default,,0,0,0,,Aur yeh farak tab dikhta hai,
Dialogue: 0,0:06:09.76,0:06:13.43,Default,,0,0,0,,jab paisa sach mein chahiye hota
Dialogue: 0,0:06:13.43,0:06:13.84,Default,,0,0,0,,hai.
Dialogue: 0,0:06:14.29,0:06:15.84,Default,,0,0,0,,Ab doosra chor,
Dialogue: 0,0:06:15.84,0:06:19.32,Default,,0,0,0,,jo dikhta hai par log ignore
Dialogue: 0,0:06:19.32,0:06:20.48,Default,,0,0,0,,karte hain.
Dialogue: 0,0:06:20.48,0:06:24.74,Default,,0,0,0,,Behen office se lauti aur Papa
Dialogue: 0,0:06:24.74,0:06:27.44,Default,,0,0,0,,ki FD statement dekhi.
Dialogue: 0,0:06:27.44,0:06:31.31,Default,,0,0,0,,Usne ek line par ungli rakhi,
Dialogue: 0,0:06:31.31,0:06:31.70,Default,,0,0,0,,TDS.
Dialogue: 0,0:06:31.70,0:06:33.25,Default,,0,0,0,,Papa bole,
Dialogue: 0,0:06:33.25,0:06:36.34,Default,,0,0,0,,yeh bank ka koi kharcha hoga.
Dialogue: 0,0:06:36.34,0:06:38.66,Default,,0,0,0,,Behen ne sar hilaya,
Dialogue: 0,0:06:38.66,0:06:40.21,Default,,0,0,0,,nahi Papa.
Dialogue: 0,0:06:40.66,0:06:44.93,Default,,0,0,0,,TDS yaani tax deducted at source,
Dialogue: 0,0:06:44.93,0:06:48.77,Default,,0,0,0,,matlab bank byaaj dete hi pehle
Dialogue: 0,0:06:48.77,0:06:51.76,Default,,0,0,0,,thoda tax kaat leta hai.
Dialogue: 0,0:06:51.76,0:06:54.33,Default,,0,0,0,,Yeh poora tax nahi,
Dialogue: 0,0:06:54.33,0:06:56.89,Default,,0,0,0,,bas ek advance hai.
Dialogue: 0,0:06:56.89,0:07:01.16,Default,,0,0,0,,Asli tax aapke income tax slab
Dialogue: 0,0:07:01.16,0:07:04.15,Default,,0,0,0,,ke hisaab se lagta hai,
Dialogue: 0,0:07:04.15,0:07:07.14,Default,,0,0,0,,jab aap return bharte ho.
Dialogue: 0,0:07:07.59,0:07:11.11,Default,,0,0,0,,Slab yaani aapki kamai ki seedhi,
Dialogue: 0,0:07:11.11,0:07:13.22,Default,,0,0,0,,jitni oonchi kamai,
Dialogue: 0,0:07:13.22,0:07:15.68,Default,,0,0,0,,utna ooncha tax rate.
Dialogue: 0,0:07:15.68,0:07:18.50,Default,,0,0,0,,FD ka byaaj koi alag tohfa
Dialogue: 0,0:07:18.50,0:07:19.55,Default,,0,0,0,,nahi hai.
Dialogue: 0,0:07:19.55,0:07:23.07,Default,,0,0,0,,Woh aapki salary ya pension ke
Dialogue: 0,0:07:23.07,0:07:24.83,Default,,0,0,0,,saath jud jaata hai,
Dialogue: 0,0:07:24.83,0:07:28.00,Default,,0,0,0,,aur usi seedhi par charh jaata
Dialogue: 0,0:07:28.00,0:07:28.35,Default,,0,0,0,,hai.
Dialogue: 0,0:07:28.80,0:07:31.51,Default,,0,0,0,,Ab ek baat jo bahut log
Dialogue: 0,0:07:31.51,0:07:33.06,Default,,0,0,0,,nahi jaante.
Dialogue: 0,0:07:33.06,0:07:38.47,Default,,0,0,0,,Cumulative FD mein byaaj aapko maturity
Dialogue: 0,0:07:38.47,0:07:40.02,Default,,0,0,0,,par milta hai.
Dialogue: 0,0:07:40.02,0:07:42.73,Default,,0,0,0,,Par tax ke hisaab se woh
Dialogue: 0,0:07:42.73,0:07:45.82,Default,,0,0,0,,byaaj har saal kamaya hua maana
Dialogue: 0,0:07:45.82,0:07:46.98,Default,,0,0,0,,jaata hai.
Dialogue: 0,0:07:46.98,0:07:50.08,Default,,0,0,0,,Yaani paisa haath mein na aaye,
Dialogue: 0,0:07:50.08,0:07:52.40,Default,,0,0,0,,tax har saal banta hai.
Dialogue: 0,0:07:52.85,0:07:54.91,Default,,0,0,0,,Behen ne samjhaya,
Dialogue: 0,0:07:54.91,0:07:59.02,Default,,0,0,0,,maan lo kisi ki income sabse
Dialogue: 0,0:07:59.02,0:08:01.08,Default,,0,0,0,,oonche slab mein hai.
Dialogue: 0,0:08:01.08,0:08:04.78,Default,,0,0,0,,New regime mein yeh slab 30
Dialogue: 0,0:08:04.78,0:08:06.43,Default,,0,0,0,,percent ka hai.
Dialogue: 0,0:08:06.43,0:08:09.31,Default,,0,0,0,,Toh FD ke byaaj ka lagbhag
Dialogue: 0,0:08:09.31,0:08:13.42,Default,,0,0,0,,30 percent tax mein chala jaata
Dialogue: 0,0:08:13.42,0:08:13.83,Default,,0,0,0,,hai.
Dialogue: 0,0:08:13.83,0:08:15.07,Default,,0,0,0,,Jo bacha,
Dialogue: 0,0:08:15.07,0:08:18.77,Default,,0,0,0,,wahi asli byaaj ki kamai hai.
Dialogue: 0,0:08:19.22,0:08:21.34,Default,,0,0,0,,Ab is bache hue byaaj ko
Dialogue: 0,0:08:21.34,0:08:24.07,Default,,0,0,0,,mehngai ke saamne khada karo.
Dialogue: 0,0:08:24.07,0:08:26.49,Default,,0,0,0,,Ek taraf tax ne hissa liya,
Dialogue: 0,0:08:26.49,0:08:28.61,Default,,0,0,0,,doosri taraf mehngai ne.
Dialogue: 0,0:08:28.61,0:08:30.43,Default,,0,0,0,,Beech mein Papa ki FD,
Dialogue: 0,0:08:30.43,0:08:33.16,Default,,0,0,0,,jo bahar se badhti dikh rahi
Dialogue: 0,0:08:33.16,0:08:33.46,Default,,0,0,0,,thi,
Dialogue: 0,0:08:33.46,0:08:36.18,Default,,0,0,0,,andar se lagbhag ruki hui thi.
Dialogue: 0,0:08:36.18,0:08:37.70,Default,,0,0,0,,Yeh hai double chot.
Dialogue: 0,0:08:38.15,0:08:40.87,Default,,0,0,0,,Par har ghar ki kahani ek
Dialogue: 0,0:08:40.87,0:08:42.57,Default,,0,0,0,,jaisi nahi hai.
Dialogue: 0,0:08:42.57,0:08:45.97,Default,,0,0,0,,New regime mein agar aapki kul
Dialogue: 0,0:08:45.97,0:08:48.69,Default,,0,0,0,,income 12 lakh tak hai,
Dialogue: 0,0:08:48.69,0:08:51.75,Default,,0,0,0,,toh rebate ki wajah se tax
Dialogue: 0,0:08:51.75,0:08:54.47,Default,,0,0,0,,lagbhag zero ho jaata hai.
Dialogue: 0,0:08:54.47,0:08:57.53,Default,,0,0,0,,Rebate yaani sarkar ki chhoot,
Dialogue: 0,0:08:57.53,0:08:59.91,Default,,0,0,0,,jo tax ko kam ya khatam
Dialogue: 0,0:08:59.91,0:09:01.27,Default,,0,0,0,,kar deti hai.
Dialogue: 0,0:09:01.72,0:09:04.17,Default,,0,0,0,,Toh kai retired logon ke liye,
Dialogue: 0,0:09:04.17,0:09:06.90,Default,,0,0,0,,jinki pension aur byaaj milakar kam
Dialogue: 0,0:09:06.90,0:09:07.17,Default,,0,0,0,,hai,
Dialogue: 0,0:09:07.17,0:09:09.89,Default,,0,0,0,,tax wala chor itna bada nahi.
Dialogue: 0,0:09:09.89,0:09:12.34,Default,,0,0,0,,Unke liye asli chor mehngai hi
Dialogue: 0,0:09:12.34,0:09:12.62,Default,,0,0,0,,hai.
Dialogue: 0,0:09:12.62,0:09:15.07,Default,,0,0,0,,Aur oonchi kamai walon ke ghar
Dialogue: 0,0:09:15.07,0:09:17.25,Default,,0,0,0,,mein dono chor ek saath ghuste
Dialogue: 0,0:09:17.25,0:09:17.52,Default,,0,0,0,,hain.
Dialogue: 0,0:09:17.97,0:09:21.28,Default,,0,0,0,,Behen ne Papa se kaha,
Dialogue: 0,0:09:21.28,0:09:25.00,Default,,0,0,0,,galti tax bharne mein nahi hai,
Dialogue: 0,0:09:25.00,0:09:27.49,Default,,0,0,0,,tax toh dena hi hai.
Dialogue: 0,0:09:27.49,0:09:30.38,Default,,0,0,0,,Galti yeh hai ki hum sirf
Dialogue: 0,0:09:30.38,0:09:33.28,Default,,0,0,0,,byaaj ka rate dekhte hain.
Dialogue: 0,0:09:33.28,0:09:36.18,Default,,0,0,0,,Tax aur mehngai ke baad kya
Dialogue: 0,0:09:36.18,0:09:37.00,Default,,0,0,0,,bacha,
Dialogue: 0,0:09:37.00,0:09:41.14,Default,,0,0,0,,uska hisaab hum kabhi karte hi
Dialogue: 0,0:09:41.14,0:09:41.97,Default,,0,0,0,,nahi.
Dialogue: 0,0:09:42.42,0:09:45.84,Default,,0,0,0,,Ab yahan ek galat nateeja nikalna
Dialogue: 0,0:09:45.84,0:09:46.70,Default,,0,0,0,,aasaan hai.
Dialogue: 0,0:09:46.70,0:09:48.12,Default,,0,0,0,,Ki FD bekaar hai,
Dialogue: 0,0:09:48.12,0:09:48.98,Default,,0,0,0,,sab tod do.
Dialogue: 0,0:09:48.98,0:09:49.55,Default,,0,0,0,,Ruko.
Dialogue: 0,0:09:49.55,0:09:52.12,Default,,0,0,0,,Yeh bhi utni hi badi galti
Dialogue: 0,0:09:52.12,0:09:52.69,Default,,0,0,0,,hogi.
Dialogue: 0,0:09:52.69,0:09:54.40,Default,,0,0,0,,FD ka ek khaas kaam hai,
Dialogue: 0,0:09:54.40,0:09:56.11,Default,,0,0,0,,aur us kaam mein woh aaj
Dialogue: 0,0:09:56.11,0:09:57.82,Default,,0,0,0,,bhi bahut achhi hai.
Dialogue: 0,0:09:58.27,0:10:00.76,Default,,0,0,0,,Ek raat Mummy ki tabiyat achanak
Dialogue: 0,0:10:00.76,0:10:01.51,Default,,0,0,0,,bigad gayi.
Dialogue: 0,0:10:01.51,0:10:04.74,Default,,0,0,0,,Hospital ne admission se pehle deposit
Dialogue: 0,0:10:04.74,0:10:05.24,Default,,0,0,0,,maanga.
Dialogue: 0,0:10:05.24,0:10:07.48,Default,,0,0,0,,Us waqt share bechne ka time
Dialogue: 0,0:10:07.48,0:10:08.23,Default,,0,0,0,,nahi tha,
Dialogue: 0,0:10:08.23,0:10:10.72,Default,,0,0,0,,na market ke upar neeche hone
Dialogue: 0,0:10:10.72,0:10:11.71,Default,,0,0,0,,ka intezaar.
Dialogue: 0,0:10:11.71,0:10:13.46,Default,,0,0,0,,Paisa turant chahiye tha,
Dialogue: 0,0:10:13.46,0:10:14.95,Default,,0,0,0,,aur poora chahiye tha.
Dialogue: 0,0:10:15.40,0:10:18.20,Default,,0,0,0,,Yahi kaam aata hai emergency fund,
Dialogue: 0,0:10:18.20,0:10:20.49,Default,,0,0,0,,yaani mushkil waqt ke liye alag
Dialogue: 0,0:10:20.49,0:10:21.76,Default,,0,0,0,,rakha hua paisa.
Dialogue: 0,0:10:21.76,0:10:24.57,Default,,0,0,0,,Ismein sabse zaroori hai ki paisa
Dialogue: 0,0:10:24.57,0:10:25.58,Default,,0,0,0,,jaldi mile,
Dialogue: 0,0:10:25.58,0:10:28.38,Default,,0,0,0,,aur uski value achanak na gire.
Dialogue: 0,0:10:28.38,0:10:30.42,Default,,0,0,0,,Yahan zyada kamai nahi,
Dialogue: 0,0:10:30.42,0:10:31.69,Default,,0,0,0,,bharosa chahiye.
Dialogue: 0,0:10:31.69,0:10:33.99,Default,,0,0,0,,Aur yahan FD apna kaam karti
Dialogue: 0,0:10:33.99,0:10:34.24,Default,,0,0,0,,hai.
Dialogue: 0,0:10:34.69,0:10:36.90,Default,,0,0,0,,Papa ki ek chhoti FD alag
Dialogue: 0,0:10:36.90,0:10:37.64,Default,,0,0,0,,padi thi.
Dialogue: 0,0:10:37.64,0:10:39.36,Default,,0,0,0,,Bank ki app se use kuch
Dialogue: 0,0:10:39.36,0:10:41.82,Default,,0,0,0,,hi minute mein toda ja sakta
Dialogue: 0,0:10:41.82,0:10:42.07,Default,,0,0,0,,tha.
Dialogue: 0,0:10:42.07,0:10:43.30,Default,,0,0,0,,Thoda byaaj kata,
Dialogue: 0,0:10:43.30,0:10:44.53,Default,,0,0,0,,penalty lagi,
Dialogue: 0,0:10:44.53,0:10:46.49,Default,,0,0,0,,par paisa usi raat mil gaya.
Dialogue: 0,0:10:46.49,0:10:48.46,Default,,0,0,0,,Us raat kisi ne real return
Dialogue: 0,0:10:48.46,0:10:49.69,Default,,0,0,0,,ki baat nahi ki.
Dialogue: 0,0:10:50.14,0:10:53.87,Default,,0,0,0,,Aur bank mein paisa kitna surakshit
Dialogue: 0,0:10:53.87,0:10:54.24,Default,,0,0,0,,hai?
Dialogue: 0,0:10:54.24,0:10:57.98,Default,,0,0,0,,DICGC naam ki sanstha har depositor
Dialogue: 0,0:10:57.98,0:11:00.21,Default,,0,0,0,,ka ek bank mein 5 lakh
Dialogue: 0,0:11:00.21,0:11:03.95,Default,,0,0,0,,tak ka paisa insure karti hai.
Dialogue: 0,0:11:03.95,0:11:06.56,Default,,0,0,0,,Yaani bank ko kuch ho bhi
Dialogue: 0,0:11:06.56,0:11:06.93,Default,,0,0,0,,jaaye,
Dialogue: 0,0:11:06.93,0:11:09.54,Default,,0,0,0,,toh is had tak ka paisa
Dialogue: 0,0:11:09.54,0:11:12.90,Default,,0,0,0,,wapas milne ka intezaam hai.
Dialogue: 0,0:11:13.35,0:11:16.03,Default,,0,0,0,,Isliye samajhdaari yeh hai ki ek
Dialogue: 0,0:11:16.03,0:11:17.64,Default,,0,0,0,,hi bank mein sab kuch na
Dialogue: 0,0:11:17.64,0:11:18.18,Default,,0,0,0,,rakho.
Dialogue: 0,0:11:18.18,0:11:20.59,Default,,0,0,0,,Emergency fund ko hisson mein,
Dialogue: 0,0:11:20.59,0:11:22.74,Default,,0,0,0,,kuch FD aur kuch savings account
Dialogue: 0,0:11:22.74,0:11:23.55,Default,,0,0,0,,mein rakho.
Dialogue: 0,0:11:23.55,0:11:25.96,Default,,0,0,0,,Aur jo goals jaldi aane wale
Dialogue: 0,0:11:25.96,0:11:26.23,Default,,0,0,0,,hain,
Dialogue: 0,0:11:26.23,0:11:28.38,Default,,0,0,0,,jaise agle saal ki school fees,
Dialogue: 0,0:11:28.38,0:11:30.52,Default,,0,0,0,,unke liye bhi FD theek baithti
Dialogue: 0,0:11:30.52,0:11:30.79,Default,,0,0,0,,hai.
Dialogue: 0,0:11:31.24,0:11:32.83,Default,,0,0,0,,Matlab FD ek bartan hai,
Dialogue: 0,0:11:32.83,0:11:34.65,Default,,0,0,0,,aur har bartan ka apna kaam.
Dialogue: 0,0:11:34.65,0:11:36.69,Default,,0,0,0,,Doodh ubaalne ke liye bhagona,
Dialogue: 0,0:11:36.69,0:11:39.41,Default,,0,0,0,,dahi jamane ke liye alag katori.
Dialogue: 0,0:11:39.41,0:11:41.23,Default,,0,0,0,,Papa ne ek hi bartan mein
Dialogue: 0,0:11:41.23,0:11:42.37,Default,,0,0,0,,sab kuch jama diya.
Dialogue: 0,0:11:42.37,0:11:43.96,Default,,0,0,0,,Problem bartan mein nahi,
Dialogue: 0,0:11:43.96,0:11:46.00,Default,,0,0,0,,uske galat istemaal mein thi.
Dialogue: 0,0:11:46.45,0:11:48.52,Default,,0,0,0,,Toh asli galti kya thi?
Dialogue: 0,0:11:48.52,0:11:50.88,Default,,0,0,0,,Lambe goal ke liye sirf safe
Dialogue: 0,0:11:50.88,0:11:53.25,Default,,0,0,0,,dikhne wala raasta chunna.
Dialogue: 0,0:11:53.25,0:11:54.73,Default,,0,0,0,,Bachchon ki padhai,
Dialogue: 0,0:11:54.73,0:11:55.32,Default,,0,0,0,,shaadi,
Dialogue: 0,0:11:55.32,0:11:57.09,Default,,0,0,0,,apna retirement,
Dialogue: 0,0:11:57.09,0:11:58.86,Default,,0,0,0,,yeh sab lambe goals hain.
Dialogue: 0,0:11:58.86,0:12:02.41,Default,,0,0,0,,Inke liye paisa bachaana kaafi nahi,
Dialogue: 0,0:12:02.41,0:12:05.36,Default,,0,0,0,,use mehngai se aage bhi badhna
Dialogue: 0,0:12:05.36,0:12:06.25,Default,,0,0,0,,hota hai.
Dialogue: 0,0:12:06.70,0:12:09.12,Default,,0,0,0,,Isi liye Behen ne Papa ko
Dialogue: 0,0:12:09.12,0:12:10.74,Default,,0,0,0,,kuch aur raaste dikhaye.
Dialogue: 0,0:12:10.74,0:12:11.55,Default,,0,0,0,,Jaise PPF,
Dialogue: 0,0:12:11.55,0:12:13.70,Default,,0,0,0,,yaani Public Provident Fund,
Dialogue: 0,0:12:13.70,0:12:16.12,Default,,0,0,0,,ek sarkari bachat yojana.
Dialogue: 0,0:12:16.12,0:12:18.55,Default,,0,0,0,,Iska byaaj abhi 7.1 percent saal
Dialogue: 0,0:12:18.55,0:12:19.09,Default,,0,0,0,,ka hai.
Dialogue: 0,0:12:19.09,0:12:21.78,Default,,0,0,0,,Ismein paisa lambe samay ke liye
Dialogue: 0,0:12:21.78,0:12:22.86,Default,,0,0,0,,lock rehta hai,
Dialogue: 0,0:12:22.86,0:12:25.01,Default,,0,0,0,,isliye yeh lambe goals ke liye
Dialogue: 0,0:12:25.01,0:12:25.82,Default,,0,0,0,,bana hai.
Dialogue: 0,0:12:26.27,0:12:28.77,Default,,0,0,0,,Kuch log lambe goals ke liye
Dialogue: 0,0:12:28.77,0:12:31.62,Default,,0,0,0,,mutual fund ya SIP bhi dekhte
Dialogue: 0,0:12:31.62,0:12:31.98,Default,,0,0,0,,hain,
Dialogue: 0,0:12:31.98,0:12:36.26,Default,,0,0,0,,yaani har mahine thoda paisa market
Dialogue: 0,0:12:36.26,0:12:37.68,Default,,0,0,0,,mein lagana.
Dialogue: 0,0:12:37.68,0:12:40.89,Default,,0,0,0,,Wahan kamai fix nahi hoti,
Dialogue: 0,0:12:40.89,0:12:43.39,Default,,0,0,0,,upar neeche hoti hai.
Dialogue: 0,0:12:43.39,0:12:47.31,Default,,0,0,0,,Isliye wahan jaane se pehle apna
Dialogue: 0,0:12:47.31,0:12:51.59,Default,,0,0,0,,risk aur samay dono samajhna zaroori
Dialogue: 0,0:12:51.59,0:12:51.95,Default,,0,0,0,,hai.
Dialogue: 0,0:12:52.40,0:12:54.37,Default,,0,0,0,,Ab ek seedha tareeka,
Dialogue: 0,0:12:54.37,0:12:56.35,Default,,0,0,0,,jo aap aaj raat kar sakte
Dialogue: 0,0:12:56.35,0:12:56.63,Default,,0,0,0,,ho.
Dialogue: 0,0:12:56.63,0:12:58.88,Default,,0,0,0,,Apne har paise ko ek goal
Dialogue: 0,0:12:58.88,0:12:59.73,Default,,0,0,0,,se jodo.
Dialogue: 0,0:12:59.73,0:13:01.42,Default,,0,0,0,,Yeh paisa kab chahiye?
Dialogue: 0,0:13:01.42,0:13:02.55,Default,,0,0,0,,Jaldi chahiye,
Dialogue: 0,0:13:02.55,0:13:04.52,Default,,0,0,0,,toh FD ya savings theek hai.
Dialogue: 0,0:13:04.52,0:13:06.21,Default,,0,0,0,,Bahut saal baad chahiye,
Dialogue: 0,0:13:06.21,0:13:08.47,Default,,0,0,0,,toh dekho kya woh mehngai se
Dialogue: 0,0:13:08.47,0:13:10.16,Default,,0,0,0,,aage chal raha hai.
Dialogue: 0,0:13:10.61,0:13:11.77,Default,,0,0,0,,Doosra kaam,
Dialogue: 0,0:13:11.77,0:13:14.47,Default,,0,0,0,,har FD par khud se poochho.
Dialogue: 0,0:13:14.47,0:13:16.40,Default,,0,0,0,,Byaaj kitna mila?
Dialogue: 0,0:13:16.40,0:13:17.94,Default,,0,0,0,,Tax kitna gaya?
Dialogue: 0,0:13:17.94,0:13:21.03,Default,,0,0,0,,Aur us dauran ghar ka kharcha
Dialogue: 0,0:13:21.03,0:13:22.58,Default,,0,0,0,,kitna badha?
Dialogue: 0,0:13:22.58,0:13:23.73,Default,,0,0,0,,Jo bacha,
Dialogue: 0,0:13:23.73,0:13:27.21,Default,,0,0,0,,wahi aapki asli kamai hai.
Dialogue: 0,0:13:27.21,0:13:31.07,Default,,0,0,0,,Yeh hisaab koi bank nahi batayega,
Dialogue: 0,0:13:31.07,0:13:33.77,Default,,0,0,0,,aapko khud karna hoga.
Dialogue: 0,0:13:34.22,0:13:36.92,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:13:36.92,0:13:38.27,Default,,0,0,0,,Har ghar ki kamai,
Dialogue: 0,0:13:38.27,0:13:40.97,Default,,0,0,0,,zaroorat aur darr alag hote hain.
Dialogue: 0,0:13:40.97,0:13:44.49,Default,,0,0,0,,Bade faisle se pehle kisi registered
Dialogue: 0,0:13:44.49,0:13:46.38,Default,,0,0,0,,advisor se baat karein.
Dialogue: 0,0:13:46.38,0:13:48.54,Default,,0,0,0,,Main bas itna chahta hoon ki
Dialogue: 0,0:13:48.54,0:13:49.89,Default,,0,0,0,,aap rate ke saath,
Dialogue: 0,0:13:49.89,0:13:52.86,Default,,0,0,0,,uske peeche chhupa hisaab bhi dekhein.
Dialogue: 0,0:13:53.31,0:13:55.95,Default,,0,0,0,,Us raat Papa ne almari se
Dialogue: 0,0:13:55.95,0:13:58.88,Default,,0,0,0,,saari purani receipts nikali.
Dialogue: 0,0:13:58.88,0:14:00.64,Default,,0,0,0,,Unhe phenka nahi,
Dialogue: 0,0:14:00.64,0:14:03.58,Default,,0,0,0,,bas alag alag dheriyon mein baanta.
Dialogue: 0,0:14:03.58,0:14:05.63,Default,,0,0,0,,Yeh emergency ke liye,
Dialogue: 0,0:14:05.63,0:14:07.39,Default,,0,0,0,,yeh agle saal ke liye,
Dialogue: 0,0:14:07.39,0:14:09.74,Default,,0,0,0,,aur yeh lambe safar ke liye.
Dialogue: 0,0:14:09.74,0:14:12.67,Default,,0,0,0,,Pehli baar FD unke liye bharosa
Dialogue: 0,0:14:12.67,0:14:13.26,Default,,0,0,0,,bhi thi,
Dialogue: 0,0:14:13.26,0:14:14.43,Default,,0,0,0,,aur hisaab bhi.
Dialogue: 0,0:14:14.88,0:14:18.11,Default,,0,0,0,,Ab aapse ek seedha sawaal.
Dialogue: 0,0:14:18.11,0:14:22.15,Default,,0,0,0,,Aapke ghar mein sabse zyada paisa
Dialogue: 0,0:14:22.15,0:14:24.17,Default,,0,0,0,,kahan rakha hai,
Dialogue: 0,0:14:24.17,0:14:24.97,Default,,0,0,0,,FD mein,
Dialogue: 0,0:14:24.97,0:14:25.78,Default,,0,0,0,,gold mein,
Dialogue: 0,0:14:25.78,0:14:27.40,Default,,0,0,0,,ya kahin aur?
Dialogue: 0,0:14:27.40,0:14:30.63,Default,,0,0,0,,Comment mein bas ek shabd likhiye.
Dialogue: 0,0:14:30.63,0:14:31.84,Default,,0,0,0,,Dekhte hain,
Dialogue: 0,0:14:31.84,0:14:35.88,Default,,0,0,0,,kitne ghar Papa ki tarah sochte
Dialogue: 0,0:14:35.88,0:14:36.28,Default,,0,0,0,,hain.
Dialogue: 0,0:14:36.73,0:14:39.15,Default,,0,0,0,,Agle video mein baat gold ki,
Dialogue: 0,0:14:39.15,0:14:41.56,Default,,0,0,0,,jo har ghar ki almari mein
Dialogue: 0,0:14:41.56,0:14:43.08,Default,,0,0,0,,chupchaap pada hai.
Dialogue: 0,0:14:43.08,0:14:45.19,Default,,0,0,0,,Kya woh sach mein mehngai ko
Dialogue: 0,0:14:45.19,0:14:46.40,Default,,0,0,0,,harata hai,
Dialogue: 0,0:14:46.40,0:14:49.12,Default,,0,0,0,,ya bas humein aisa lagta hai?
Dialogue: 0,0:14:49.12,0:14:51.53,Default,,0,0,0,,Tab tak apni FD ki receipt
Dialogue: 0,0:14:51.53,0:14:53.65,Default,,0,0,0,,ek baar zaroor dekh lena.
