Dialogue: 0,0:00:00.00,0:00:01.28,Default,,0,0,0,,RBI ne byaaj ghataya,
Dialogue: 0,0:00:01.28,0:00:03.32,Default,,0,0,0,,toh kya aapka loan bhi utna
Dialogue: 0,0:00:03.32,0:00:04.34,Default,,0,0,0,,hi sasta hua?
Dialogue: 0,0:00:04.34,0:00:06.38,Default,,0,0,0,,Bhai ko poora yakeen tha ki
Dialogue: 0,0:00:06.38,0:00:06.64,Default,,0,0,0,,haan.
Dialogue: 0,0:00:07.09,0:00:08.06,Default,,0,0,0,,Sunday subah,
Dialogue: 0,0:00:08.06,0:00:09.28,Default,,0,0,0,,chai ki table par,
Dialogue: 0,0:00:09.28,0:00:11.70,Default,,0,0,0,,Bhai phone par headline padh raha
Dialogue: 0,0:00:11.70,0:00:11.95,Default,,0,0,0,,tha.
Dialogue: 0,0:00:11.95,0:00:13.16,Default,,0,0,0,,Repo rate cut,
Dialogue: 0,0:00:13.16,0:00:13.89,Default,,0,0,0,,loan sasta.
Dialogue: 0,0:00:14.34,0:00:16.13,Default,,0,0,0,,Repo rate yaani woh byaaj,
Dialogue: 0,0:00:16.13,0:00:17.70,Default,,0,0,0,,jis par RBI banks ko paisa
Dialogue: 0,0:00:17.70,0:00:18.82,Default,,0,0,0,,udhaar deta hai.
Dialogue: 0,0:00:19.27,0:00:20.70,Default,,0,0,0,,Bhai ka logic seedha tha.
Dialogue: 0,0:00:20.70,0:00:22.34,Default,,0,0,0,,RBI banks ko sasta de raha
Dialogue: 0,0:00:22.34,0:00:22.54,Default,,0,0,0,,hai,
Dialogue: 0,0:00:22.54,0:00:24.18,Default,,0,0,0,,toh bank bhi utna hi sasta
Dialogue: 0,0:00:24.18,0:00:24.59,Default,,0,0,0,,dega.
Dialogue: 0,0:00:25.04,0:00:27.34,Default,,0,0,0,,Isliye usne naye bike loan ka
Dialogue: 0,0:00:27.34,0:00:28.36,Default,,0,0,0,,plan bana liya.
Dialogue: 0,0:00:28.36,0:00:30.66,Default,,0,0,0,,Mummy ne chai rakhte hue pucha,
Dialogue: 0,0:00:30.66,0:00:31.68,Default,,0,0,0,,kitna gira?
Dialogue: 0,0:00:32.13,0:00:32.84,Default,,0,0,0,,Bhai bola,
Dialogue: 0,0:00:32.84,0:00:34.74,Default,,0,0,0,,poore 125 basis points.
Dialogue: 0,0:00:34.74,0:00:36.88,Default,,0,0,0,,Basis point yaani byaaj ka sabse
Dialogue: 0,0:00:36.88,0:00:37.83,Default,,0,0,0,,chhota tukda,
Dialogue: 0,0:00:37.83,0:00:39.49,Default,,0,0,0,,jisse rate naapte hain.
Dialogue: 0,0:00:39.94,0:00:42.40,Default,,0,0,0,,Phir RBI ka October Bulletin aaya.
Dialogue: 0,0:00:42.40,0:00:44.12,Default,,0,0,0,,Usmein naye loans ke byaaj par
Dialogue: 0,0:00:44.12,0:00:44.86,Default,,0,0,0,,study thi.
Dialogue: 0,0:00:45.31,0:00:47.34,Default,,0,0,0,,Banks ke naye loans ka average
Dialogue: 0,0:00:47.34,0:00:49.37,Default,,0,0,0,,byaaj sirf 93 basis points gira,
Dialogue: 0,0:00:49.37,0:00:50.95,Default,,0,0,0,,poore 125 nahi.
Dialogue: 0,0:00:51.40,0:00:53.21,Default,,0,0,0,,Yaani RBI ki di hui raahat
Dialogue: 0,0:00:53.21,0:00:55.03,Default,,0,0,0,,ka kuch hissa raaste mein hi
Dialogue: 0,0:00:55.03,0:00:55.48,Default,,0,0,0,,reh gaya.
Dialogue: 0,0:00:55.93,0:00:56.96,Default,,0,0,0,,Aur twist yeh hai,
Dialogue: 0,0:00:56.96,0:01:00.04,Default,,0,0,0,,average gira matlab har loan sasta
Dialogue: 0,0:01:00.04,0:01:00.81,Default,,0,0,0,,nahi hua.
Dialogue: 0,0:01:01.26,0:01:02.65,Default,,0,0,0,,Kuch girawat isliye thi,
Dialogue: 0,0:01:02.65,0:01:04.43,Default,,0,0,0,,kyunki banks ne alag tarah ke
Dialogue: 0,0:01:04.43,0:01:05.42,Default,,0,0,0,,loans zyada baante.
Dialogue: 0,0:01:05.87,0:01:07.45,Default,,0,0,0,,Toh headline mat dekho,
Dialogue: 0,0:01:07.45,0:01:09.48,Default,,0,0,0,,apne loan ka asli rate bank
Dialogue: 0,0:01:09.48,0:01:10.61,Default,,0,0,0,,se likh kar maango.
Dialogue: 0,0:01:10.61,0:01:12.87,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:13.32,0:01:15.28,Default,,0,0,0,,Aapke loan ka rate pichhli baar
Dialogue: 0,0:01:15.28,0:01:16.15,Default,,0,0,0,,kab check kiya tha?
Dialogue: 0,0:01:16.15,0:01:17.24,Default,,0,0,0,,Comments mein batao.
