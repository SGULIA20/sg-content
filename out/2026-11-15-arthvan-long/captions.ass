Dialogue: 0,0:00:00.00,0:00:02.17,Default,,0,0,0,,Nalanda ke khandahar mein jale hue
Dialogue: 0,0:00:02.17,0:00:03.16,Default,,0,0,0,,chawal kyun mile?
Dialogue: 0,0:00:03.16,0:00:04.55,Default,,0,0,0,,Sawaal chhota lagta hai,
Dialogue: 0,0:00:04.55,0:00:06.72,Default,,0,0,0,,par isme poori kahani chhupi hai.
Dialogue: 0,0:00:06.72,0:00:08.30,Default,,0,0,0,,Bihar ki mitti ke neeche,
Dialogue: 0,0:00:08.30,0:00:09.49,Default,,0,0,0,,mitti ke jaar mile.
Dialogue: 0,0:00:09.49,0:00:11.46,Default,,0,0,0,,Unke andar chawal ke daane the.
Dialogue: 0,0:00:11.46,0:00:11.86,Default,,0,0,0,,Kaale,
Dialogue: 0,0:00:11.86,0:00:12.65,Default,,0,0,0,,koyle jaise,
Dialogue: 0,0:00:12.65,0:00:13.84,Default,,0,0,0,,aur bahut purane.
Dialogue: 0,0:00:13.84,0:00:15.22,Default,,0,0,0,,Kisi rasoi mein nahi,
Dialogue: 0,0:00:15.22,0:00:17.00,Default,,0,0,0,,ek vidyalaya ke khandahar mein.
Dialogue: 0,0:00:17.45,0:00:19.19,Default,,0,0,0,,Yeh daane ASI ne nikaale.
Dialogue: 0,0:00:19.19,0:00:21.91,Default,,0,0,0,,ASI yaani Archaeological Survey of India,
Dialogue: 0,0:00:21.91,0:00:24.43,Default,,0,0,0,,woh sarkari sanstha jo purani jagahon
Dialogue: 0,0:00:24.43,0:00:25.59,Default,,0,0,0,,ki khudai karti hai.
Dialogue: 0,0:00:25.59,0:00:27.72,Default,,0,0,0,,Unke mutabik yeh chawal 12vi sadi
Dialogue: 0,0:00:27.72,0:00:28.11,Default,,0,0,0,,ke hain.
Dialogue: 0,0:00:28.11,0:00:29.85,Default,,0,0,0,,Aaj bhi yeh Nalanda ke site
Dialogue: 0,0:00:29.85,0:00:31.01,Default,,0,0,0,,museum mein rakhe hain.
Dialogue: 0,0:00:31.01,0:00:33.15,Default,,0,0,0,,Inhe pakane ke liye nahi jalaya
Dialogue: 0,0:00:33.15,0:00:33.53,Default,,0,0,0,,gaya tha.
Dialogue: 0,0:00:33.53,0:00:34.89,Default,,0,0,0,,Inhe aag ne jalaya tha.
Dialogue: 0,0:00:35.34,0:00:37.60,Default,,0,0,0,,Aapne shayad suna hoga ki Nalanda
Dialogue: 0,0:00:37.60,0:00:39.87,Default,,0,0,0,,ki library 3 mahine tak jalti
Dialogue: 0,0:00:39.87,0:00:40.28,Default,,0,0,0,,rahi.
Dialogue: 0,0:00:40.28,0:00:40.90,Default,,0,0,0,,WhatsApp par,
Dialogue: 0,0:00:40.90,0:00:41.31,Default,,0,0,0,,reels mein,
Dialogue: 0,0:00:41.31,0:00:42.96,Default,,0,0,0,,yeh baat har jagah ghoomti hai.
Dialogue: 0,0:00:42.96,0:00:44.81,Default,,0,0,0,,Par kya kisi purane granth mein
Dialogue: 0,0:00:44.81,0:00:45.64,Default,,0,0,0,,yeh likha hai?
Dialogue: 0,0:00:45.64,0:00:47.49,Default,,0,0,0,,Ya yeh baad mein judi kahani
Dialogue: 0,0:00:47.49,0:00:47.70,Default,,0,0,0,,hai?
Dialogue: 0,0:00:47.70,0:00:49.76,Default,,0,0,0,,Is video mein hum yahi dhoondhenge,
Dialogue: 0,0:00:49.76,0:00:50.58,Default,,0,0,0,,sabut ke saath.
Dialogue: 0,0:00:51.03,0:00:53.58,Default,,0,0,0,,Hum chalenge Tibet ke granthon se,
Dialogue: 0,0:00:53.58,0:00:55.62,Default,,0,0,0,,China ke ek yatri ke bayan
Dialogue: 0,0:00:55.62,0:00:55.88,Default,,0,0,0,,tak.
Dialogue: 0,0:00:55.88,0:00:57.41,Default,,0,0,0,,Phir ASI ki khudai,
Dialogue: 0,0:00:57.41,0:00:59.97,Default,,0,0,0,,raakh ki parton aur Persian itihaas
Dialogue: 0,0:00:59.97,0:01:00.99,Default,,0,0,0,,ki kitaab tak.
Dialogue: 0,0:01:00.99,0:01:03.28,Default,,0,0,0,,Har kadam par hum saaf batayenge.
Dialogue: 0,0:01:03.28,0:01:04.82,Default,,0,0,0,,Kya granth mein likha hai,
Dialogue: 0,0:01:04.82,0:01:06.60,Default,,0,0,0,,kya mitti se mila hai,
Dialogue: 0,0:01:06.60,0:01:08.39,Default,,0,0,0,,aur kya sirf lok-katha hai.
Dialogue: 0,0:01:08.84,0:01:10.80,Default,,0,0,0,,Pehle chalte hain us Nalanda mein,
Dialogue: 0,0:01:10.80,0:01:12.38,Default,,0,0,0,,jise granthon ne yaad rakha.
Dialogue: 0,0:01:12.38,0:01:14.34,Default,,0,0,0,,Nalanda ek mahavihara tha.
Dialogue: 0,0:01:14.34,0:01:16.89,Default,,0,0,0,,Mahavihara yaani bada Buddhist math aur
Dialogue: 0,0:01:16.89,0:01:17.48,Default,,0,0,0,,vidyalaya,
Dialogue: 0,0:01:17.48,0:01:19.25,Default,,0,0,0,,jahan bhikshu rehte bhi the aur
Dialogue: 0,0:01:19.25,0:01:20.03,Default,,0,0,0,,padhte bhi the.
Dialogue: 0,0:01:20.03,0:01:22.39,Default,,0,0,0,,Door-door se vidyarthi yahan seekhne aate
Dialogue: 0,0:01:22.39,0:01:22.59,Default,,0,0,0,,the.
Dialogue: 0,0:01:22.59,0:01:24.55,Default,,0,0,0,,Yeh uss zamane ki sabse mashhoor
Dialogue: 0,0:01:24.55,0:01:26.32,Default,,0,0,0,,jagahon mein gina jaata tha.
Dialogue: 0,0:01:26.77,0:01:28.34,Default,,0,0,0,,China se ek yatri aaya,
Dialogue: 0,0:01:28.34,0:01:29.23,Default,,0,0,0,,naam tha Xuanzang,
Dialogue: 0,0:01:29.23,0:01:31.02,Default,,0,0,0,,jinhe Hiuen Tsang bhi kehte hain.
Dialogue: 0,0:01:31.02,0:01:33.26,Default,,0,0,0,,Woh lambi aur mushkil yatra karke
Dialogue: 0,0:01:33.26,0:01:34.61,Default,,0,0,0,,Nalanda pahuncha.
Dialogue: 0,0:01:34.61,0:01:36.17,Default,,0,0,0,,Yahan woh 5 saal ruka.
Dialogue: 0,0:01:36.17,0:01:38.41,Default,,0,0,0,,Usne Buddhist tark aur darshan padha,
Dialogue: 0,0:01:38.41,0:01:40.88,Default,,0,0,0,,aur Panini ka Sanskrit vyakaran bhi
Dialogue: 0,0:01:40.88,0:01:41.32,Default,,0,0,0,,seekha.
Dialogue: 0,0:01:41.32,0:01:43.34,Default,,0,0,0,,Uske likhe bayan aaj bhi padhe
Dialogue: 0,0:01:43.34,0:01:44.01,Default,,0,0,0,,jaate hain.
Dialogue: 0,0:01:44.46,0:01:47.07,Default,,0,0,0,,Xuanzang ne apne guru Shilabhadra se
Dialogue: 0,0:01:47.07,0:01:48.38,Default,,0,0,0,,Yoga shastra seekha.
Dialogue: 0,0:01:48.38,0:01:48.81,Default,,0,0,0,,Socho,
Dialogue: 0,0:01:48.81,0:01:50.33,Default,,0,0,0,,ek videshi vidyarthi,
Dialogue: 0,0:01:50.33,0:01:51.42,Default,,0,0,0,,diye ki roshni mein,
Dialogue: 0,0:01:51.42,0:01:52.72,Default,,0,0,0,,pothiyan padh raha hai.
Dialogue: 0,0:01:52.72,0:01:54.90,Default,,0,0,0,,Pothi yaani haath se likhi kitaab.
Dialogue: 0,0:01:54.90,0:01:56.86,Default,,0,0,0,,Uss zamane mein har kitaab haath
Dialogue: 0,0:01:56.86,0:01:58.16,Default,,0,0,0,,se likhi jaati thi.
Dialogue: 0,0:01:58.16,0:02:00.77,Default,,0,0,0,,Yahi pothiyan aage chalkar is kahani
Dialogue: 0,0:02:00.77,0:02:01.86,Default,,0,0,0,,ka dil banti hain.
Dialogue: 0,0:02:02.31,0:02:04.75,Default,,0,0,0,,Tibet ke itihaas granth ek library
Dialogue: 0,0:02:04.75,0:02:05.86,Default,,0,0,0,,ka naam lete hain,
Dialogue: 0,0:02:05.86,0:02:06.74,Default,,0,0,0,,Dharmaganja.
Dialogue: 0,0:02:06.74,0:02:07.85,Default,,0,0,0,,Iska matlab hai,
Dialogue: 0,0:02:07.85,0:02:08.74,Default,,0,0,0,,dharm ka bazaar.
Dialogue: 0,0:02:08.74,0:02:10.51,Default,,0,0,0,,Yeh baat Sumpa Khenpo naam ke
Dialogue: 0,0:02:10.51,0:02:12.95,Default,,0,0,0,,Tibetan vidwan ki kitaab mein milti
Dialogue: 0,0:02:12.95,0:02:13.17,Default,,0,0,0,,hai.
Dialogue: 0,0:02:13.17,0:02:16.06,Default,,0,0,0,,Usme kai manzil wali badi imaaratein
Dialogue: 0,0:02:16.06,0:02:16.94,Default,,0,0,0,,bataayi gayi hain.
Dialogue: 0,0:02:16.94,0:02:18.49,Default,,0,0,0,,Naam the Ratnasagara,
Dialogue: 0,0:02:18.49,0:02:20.71,Default,,0,0,0,,Ratnodadhi aur Ratnaranjaka.
Dialogue: 0,0:02:21.16,0:02:23.44,Default,,0,0,0,,In granthon ke hisaab se Ratnodadhi
Dialogue: 0,0:02:23.44,0:02:24.68,Default,,0,0,0,,9 manzil ooncha tha.
Dialogue: 0,0:02:24.68,0:02:27.37,Default,,0,0,0,,Ismein sabse pavitra pothiyan rakhi jaati
Dialogue: 0,0:02:27.37,0:02:27.58,Default,,0,0,0,,thi,
Dialogue: 0,0:02:27.58,0:02:29.65,Default,,0,0,0,,jaise Prajnaparamita Sutra.
Dialogue: 0,0:02:29.65,0:02:30.48,Default,,0,0,0,,Par yaad rakhiye,
Dialogue: 0,0:02:30.48,0:02:31.51,Default,,0,0,0,,yeh granth ka bayan hai.
Dialogue: 0,0:02:31.51,0:02:33.38,Default,,0,0,0,,Khudai mein abhi tak aisi 9
Dialogue: 0,0:02:33.38,0:02:35.86,Default,,0,0,0,,manzil wali imaarat zameen se nahi
Dialogue: 0,0:02:35.86,0:02:36.48,Default,,0,0,0,,nikli hai.
Dialogue: 0,0:02:36.93,0:02:37.62,Default,,0,0,0,,Ab socho,
Dialogue: 0,0:02:37.62,0:02:38.55,Default,,0,0,0,,raat ka waqt hai.
Dialogue: 0,0:02:38.55,0:02:39.48,Default,,0,0,0,,Ooncha bhawan,
Dialogue: 0,0:02:39.48,0:02:41.33,Default,,0,0,0,,khidkiyon se diyon ki roshni aa
Dialogue: 0,0:02:41.33,0:02:42.02,Default,,0,0,0,,rahi hai.
Dialogue: 0,0:02:42.02,0:02:44.57,Default,,0,0,0,,Andar bhikshu chupchaap pothiyan likh rahe
Dialogue: 0,0:02:44.57,0:02:44.80,Default,,0,0,0,,hain,
Dialogue: 0,0:02:44.80,0:02:45.96,Default,,0,0,0,,sambhal rahe hain.
Dialogue: 0,0:02:45.96,0:02:48.27,Default,,0,0,0,,Yeh tasveer humare mann mein granthon
Dialogue: 0,0:02:48.27,0:02:49.20,Default,,0,0,0,,se aati hai.
Dialogue: 0,0:02:49.20,0:02:50.12,Default,,0,0,0,,Ab dekhte hain,
Dialogue: 0,0:02:50.12,0:02:52.20,Default,,0,0,0,,mitti is tasveer ke baare mein
Dialogue: 0,0:02:52.20,0:02:53.13,Default,,0,0,0,,kya kehti hai.
Dialogue: 0,0:02:53.58,0:02:54.42,Default,,0,0,0,,Granth ek baat hai,
Dialogue: 0,0:02:54.42,0:02:55.47,Default,,0,0,0,,mitti alag baat.
Dialogue: 0,0:02:55.47,0:02:58.21,Default,,0,0,0,,Archaeology yaani zameen khod kar purane
Dialogue: 0,0:02:58.21,0:03:00.31,Default,,0,0,0,,logon ke nishaan dhoondhne ka vigyan.
Dialogue: 0,0:03:00.31,0:03:02.84,Default,,0,0,0,,Nalanda ke khandahar sadiyon tak mitti
Dialogue: 0,0:03:02.84,0:03:04.31,Default,,0,0,0,,ke neeche dabe rahe.
Dialogue: 0,0:03:04.31,0:03:05.99,Default,,0,0,0,,Bahar se yeh bas mitti ke
Dialogue: 0,0:03:05.99,0:03:07.25,Default,,0,0,0,,oonche dher lagte the.
Dialogue: 0,0:03:07.25,0:03:09.36,Default,,0,0,0,,Kisi ko andaza nahi tha ki
Dialogue: 0,0:03:09.36,0:03:10.62,Default,,0,0,0,,neeche kya chhupa hai.
Dialogue: 0,0:03:11.07,0:03:13.77,Default,,0,0,0,,Phir ASI ne yahan baakayda khudai
Dialogue: 0,0:03:13.77,0:03:14.51,Default,,0,0,0,,shuru ki.
Dialogue: 0,0:03:14.51,0:03:17.46,Default,,0,0,0,,Yeh kaam 1915 se 1937 tak
Dialogue: 0,0:03:17.46,0:03:17.95,Default,,0,0,0,,chala.
Dialogue: 0,0:03:17.95,0:03:20.16,Default,,0,0,0,,Mazdoor aur archaeologist mil kar,
Dialogue: 0,0:03:20.16,0:03:21.39,Default,,0,0,0,,parat dar parat,
Dialogue: 0,0:03:21.39,0:03:22.86,Default,,0,0,0,,mitti hatate gaye.
Dialogue: 0,0:03:22.86,0:03:25.32,Default,,0,0,0,,Dheere dheere neeche se laal eenton
Dialogue: 0,0:03:25.32,0:03:27.53,Default,,0,0,0,,ki deewarein ubharne lagin.
Dialogue: 0,0:03:27.53,0:03:29.49,Default,,0,0,0,,Jaise koi shehar neend se jaag
Dialogue: 0,0:03:29.49,0:03:30.23,Default,,0,0,0,,raha ho.
Dialogue: 0,0:03:30.68,0:03:31.40,Default,,0,0,0,,Jo nikla,
Dialogue: 0,0:03:31.40,0:03:33.78,Default,,0,0,0,,woh kisi chhote math jaisa nahi
Dialogue: 0,0:03:33.78,0:03:34.02,Default,,0,0,0,,tha.
Dialogue: 0,0:03:34.02,0:03:36.41,Default,,0,0,0,,Seedhi line mein bane kai vihar
Dialogue: 0,0:03:36.41,0:03:36.65,Default,,0,0,0,,the,
Dialogue: 0,0:03:36.65,0:03:39.04,Default,,0,0,0,,aur unke saamne bade eenton ke
Dialogue: 0,0:03:39.04,0:03:39.52,Default,,0,0,0,,mandir.
Dialogue: 0,0:03:39.52,0:03:41.67,Default,,0,0,0,,Sab kuch ek soche samjhe naqshe
Dialogue: 0,0:03:41.67,0:03:42.62,Default,,0,0,0,,par bana tha.
Dialogue: 0,0:03:42.62,0:03:45.01,Default,,0,0,0,,Jaise kisi ne pehle poora plan
Dialogue: 0,0:03:45.01,0:03:45.73,Default,,0,0,0,,banaya ho,
Dialogue: 0,0:03:45.73,0:03:46.92,Default,,0,0,0,,phir eenth rakhi ho.
Dialogue: 0,0:03:47.37,0:03:49.88,Default,,0,0,0,,Vihar yaani woh imaarat jahan bhikshu
Dialogue: 0,0:03:49.88,0:03:50.51,Default,,0,0,0,,rehte the.
Dialogue: 0,0:03:50.51,0:03:51.77,Default,,0,0,0,,Beech mein khula aangan,
Dialogue: 0,0:03:51.77,0:03:53.65,Default,,0,0,0,,aur aas paas chhote chhote kamre.
Dialogue: 0,0:03:53.65,0:03:55.53,Default,,0,0,0,,Inhi kamron mein bhikshu rehte,
Dialogue: 0,0:03:55.53,0:03:57.00,Default,,0,0,0,,padhte aur so jaate the.
Dialogue: 0,0:03:57.00,0:03:58.88,Default,,0,0,0,,Aaj jab aap inme khade hote
Dialogue: 0,0:03:58.88,0:03:59.09,Default,,0,0,0,,hain,
Dialogue: 0,0:03:59.09,0:04:00.97,Default,,0,0,0,,toh lagta hai jaise abhi koi
Dialogue: 0,0:04:00.97,0:04:02.65,Default,,0,0,0,,pothi lekar andar aayega.
Dialogue: 0,0:04:03.10,0:04:05.12,Default,,0,0,0,,Aur phir khudai karne walon ko
Dialogue: 0,0:04:05.12,0:04:06.01,Default,,0,0,0,,kuch aur dikha.
Dialogue: 0,0:04:06.01,0:04:06.91,Default,,0,0,0,,Kaali mitti.
Dialogue: 0,0:04:06.91,0:04:08.25,Default,,0,0,0,,Raakh ki moti parat.
Dialogue: 0,0:04:08.25,0:04:10.05,Default,,0,0,0,,Jali hui lakdi ki kadiyan.
Dialogue: 0,0:04:10.05,0:04:12.06,Default,,0,0,0,,Aisi eentein jo garmi se rang
Dialogue: 0,0:04:12.06,0:04:13.19,Default,,0,0,0,,badal chuki thi.
Dialogue: 0,0:04:13.19,0:04:14.53,Default,,0,0,0,,Yeh sab ek hi baat ki
Dialogue: 0,0:04:14.53,0:04:16.10,Default,,0,0,0,,gawaahi de raha tha.
Dialogue: 0,0:04:16.10,0:04:18.34,Default,,0,0,0,,Yahan kabhi badi aag lagi thi.
Dialogue: 0,0:04:18.79,0:04:21.65,Default,,0,0,0,,ASI ke mutabik yahan 11 vihar
Dialogue: 0,0:04:21.65,0:04:22.13,Default,,0,0,0,,mile,
Dialogue: 0,0:04:22.13,0:04:24.27,Default,,0,0,0,,aur kai bade eenton ke mandir.
Dialogue: 0,0:04:24.27,0:04:25.94,Default,,0,0,0,,Yeh sab ek beech ki line
Dialogue: 0,0:04:25.94,0:04:27.13,Default,,0,0,0,,par sajaye gaye the.
Dialogue: 0,0:04:27.13,0:04:29.99,Default,,0,0,0,,Yaani Nalanda ek imaarat nahi tha.
Dialogue: 0,0:04:29.99,0:04:32.38,Default,,0,0,0,,Woh ek poore shehar jaisa campus
Dialogue: 0,0:04:32.38,0:04:32.62,Default,,0,0,0,,tha,
Dialogue: 0,0:04:32.62,0:04:33.57,Default,,0,0,0,,jahan padhai,
Dialogue: 0,0:04:33.57,0:04:35.00,Default,,0,0,0,,ibaadat aur rehna,
Dialogue: 0,0:04:35.00,0:04:36.19,Default,,0,0,0,,sab saath chalta tha.
Dialogue: 0,0:04:36.64,0:04:38.65,Default,,0,0,0,,ASI ne sabse pehle jis vihar
Dialogue: 0,0:04:38.65,0:04:39.45,Default,,0,0,0,,ki khudai ki,
Dialogue: 0,0:04:39.45,0:04:41.06,Default,,0,0,0,,wahan stratigraphy ki gayi.
Dialogue: 0,0:04:41.06,0:04:43.48,Default,,0,0,0,,Stratigraphy yaani mitti ki parton ko
Dialogue: 0,0:04:43.48,0:04:43.88,Default,,0,0,0,,padhna,
Dialogue: 0,0:04:43.88,0:04:45.89,Default,,0,0,0,,bilkul kitaab ke panno ki tarah.
Dialogue: 0,0:04:45.89,0:04:48.30,Default,,0,0,0,,Neeche wali parat purani hoti hai,
Dialogue: 0,0:04:48.30,0:04:49.31,Default,,0,0,0,,upar wali nayi.
Dialogue: 0,0:04:49.31,0:04:50.91,Default,,0,0,0,,Har parat ek alag daur ki
Dialogue: 0,0:04:50.91,0:04:52.32,Default,,0,0,0,,kahani sunati hai.
Dialogue: 0,0:04:52.77,0:04:54.49,Default,,0,0,0,,Is vihar mein 9 alag alag
Dialogue: 0,0:04:54.49,0:04:55.83,Default,,0,0,0,,daur ki banawat mili.
Dialogue: 0,0:04:55.83,0:04:56.21,Default,,0,0,0,,Matlab,
Dialogue: 0,0:04:56.21,0:04:57.55,Default,,0,0,0,,yeh vihar baar baar bana,
Dialogue: 0,0:04:57.55,0:04:57.93,Default,,0,0,0,,toota,
Dialogue: 0,0:04:57.93,0:04:58.89,Default,,0,0,0,,aur phir se bana.
Dialogue: 0,0:04:58.89,0:05:00.80,Default,,0,0,0,,Har peedhi ne purani deewar ke
Dialogue: 0,0:05:00.80,0:05:02.13,Default,,0,0,0,,upar nayi deewar uthayi.
Dialogue: 0,0:05:02.13,0:05:04.05,Default,,0,0,0,,Jaise ghar ki marammat hoti hai,
Dialogue: 0,0:05:04.05,0:05:05.77,Default,,0,0,0,,waise hi sadiyon tak yahan kaam
Dialogue: 0,0:05:05.77,0:05:06.53,Default,,0,0,0,,chalta raha.
Dialogue: 0,0:05:06.98,0:05:08.69,Default,,0,0,0,,Yeh baat bahut zaroori hai.
Dialogue: 0,0:05:08.69,0:05:10.84,Default,,0,0,0,,Nalanda ek din mein nahi bana.
Dialogue: 0,0:05:10.84,0:05:12.55,Default,,0,0,0,,Aur is sabut se lagta hai,
Dialogue: 0,0:05:12.55,0:05:14.05,Default,,0,0,0,,shayad ek din mein khatam bhi
Dialogue: 0,0:05:14.05,0:05:14.69,Default,,0,0,0,,nahi hua.
Dialogue: 0,0:05:14.69,0:05:17.05,Default,,0,0,0,,Sadiyon tak log yahan marammat karte
Dialogue: 0,0:05:17.05,0:05:17.48,Default,,0,0,0,,rahe.
Dialogue: 0,0:05:17.48,0:05:19.62,Default,,0,0,0,,Matlab nuksaan pehle bhi aaye honge,
Dialogue: 0,0:05:19.62,0:05:20.91,Default,,0,0,0,,aur log phir se jod kar
Dialogue: 0,0:05:20.91,0:05:21.98,Default,,0,0,0,,khade hue honge.
Dialogue: 0,0:05:22.43,0:05:24.51,Default,,0,0,0,,Ab un jale chawalon par lautte
Dialogue: 0,0:05:24.51,0:05:24.72,Default,,0,0,0,,hain.
Dialogue: 0,0:05:24.72,0:05:25.97,Default,,0,0,0,,Jaar mein rakhe chawal,
Dialogue: 0,0:05:25.97,0:05:27.43,Default,,0,0,0,,jo aag mein kaale pad gaye.
Dialogue: 0,0:05:27.43,0:05:29.51,Default,,0,0,0,,ASI ke museum mein yeh namoone
Dialogue: 0,0:05:29.51,0:05:30.55,Default,,0,0,0,,aaj bhi rakhe hain,
Dialogue: 0,0:05:30.55,0:05:31.38,Default,,0,0,0,,copper plate,
Dialogue: 0,0:05:31.38,0:05:33.05,Default,,0,0,0,,shilalekh aur sikkon ke saath.
Dialogue: 0,0:05:33.05,0:05:34.72,Default,,0,0,0,,Yeh woh sabut hai jise aap
Dialogue: 0,0:05:34.72,0:05:36.59,Default,,0,0,0,,apni aankhon se dekh sakte hain.
Dialogue: 0,0:05:37.04,0:05:38.93,Default,,0,0,0,,ASI ke mutabik yeh raakh ek
Dialogue: 0,0:05:38.93,0:05:40.81,Default,,0,0,0,,bade aur phaile hue jalne ki
Dialogue: 0,0:05:40.81,0:05:41.65,Default,,0,0,0,,nishaani hai.
Dialogue: 0,0:05:41.65,0:05:43.32,Default,,0,0,0,,Yaani aag sach mein lagi thi.
Dialogue: 0,0:05:43.32,0:05:44.79,Default,,0,0,0,,Yeh baat kahani nahi,
Dialogue: 0,0:05:44.79,0:05:46.05,Default,,0,0,0,,mitti ka sabut hai.
Dialogue: 0,0:05:46.05,0:05:47.51,Default,,0,0,0,,Par aag kitne din chali,
Dialogue: 0,0:05:47.51,0:05:48.35,Default,,0,0,0,,kisne lagayi,
Dialogue: 0,0:05:48.35,0:05:50.03,Default,,0,0,0,,yeh mitti nahi batati.
Dialogue: 0,0:05:50.03,0:05:52.12,Default,,0,0,0,,Yahin se bahas shuru hoti hai.
Dialogue: 0,0:05:52.57,0:05:54.84,Default,,0,0,0,,Ab aate hain sabse mashhoor daavon
Dialogue: 0,0:05:54.84,0:05:55.07,Default,,0,0,0,,par,
Dialogue: 0,0:05:55.07,0:05:56.66,Default,,0,0,0,,jo aap baar baar sunte hain.
Dialogue: 0,0:05:56.66,0:05:57.34,Default,,0,0,0,,Ek daava,
Dialogue: 0,0:05:57.34,0:06:00.07,Default,,0,0,0,,ki library mahino tak jalti rahi.
Dialogue: 0,0:06:00.07,0:06:00.98,Default,,0,0,0,,Aur ek daava,
Dialogue: 0,0:06:00.98,0:06:03.25,Default,,0,0,0,,ki wahan anginat kitaabein thi.
Dialogue: 0,0:06:03.25,0:06:03.93,Default,,0,0,0,,Dekhte hain,
Dialogue: 0,0:06:03.93,0:06:05.98,Default,,0,0,0,,in daavon ke peeche sabut kya
Dialogue: 0,0:06:05.98,0:06:06.20,Default,,0,0,0,,hai,
Dialogue: 0,0:06:06.20,0:06:08.25,Default,,0,0,0,,aur itihaskar kya kehte hain.
Dialogue: 0,0:06:08.70,0:06:11.11,Default,,0,0,0,,Kaha jaata hai Nalanda mein 90
Dialogue: 0,0:06:11.11,0:06:11.99,Default,,0,0,0,,lakh pothiyan thi.
Dialogue: 0,0:06:11.99,0:06:13.31,Default,,0,0,0,,Par itihaskar D.N.
Dialogue: 0,0:06:13.31,0:06:15.06,Default,,0,0,0,,Jha jaise vidwan kehte hain,
Dialogue: 0,0:06:15.06,0:06:16.38,Default,,0,0,0,,yeh sirf ek ginti hai.
Dialogue: 0,0:06:16.38,0:06:18.13,Default,,0,0,0,,Uss zamane ki koi suchi,
Dialogue: 0,0:06:18.13,0:06:19.89,Default,,0,0,0,,koi register nahi milta.
Dialogue: 0,0:06:19.89,0:06:21.43,Default,,0,0,0,,Asli sankhya kitni thi,
Dialogue: 0,0:06:21.43,0:06:23.18,Default,,0,0,0,,yeh aaj bhi koi nahi jaanta.
Dialogue: 0,0:06:23.63,0:06:25.05,Default,,0,0,0,,Wahin kuch log kehte hain,
Dialogue: 0,0:06:25.05,0:06:27.48,Default,,0,0,0,,itni oonchi aur badi imaaratein thi,
Dialogue: 0,0:06:27.48,0:06:29.51,Default,,0,0,0,,toh pothiyan bhi bahut rahi hongi.
Dialogue: 0,0:06:29.51,0:06:31.13,Default,,0,0,0,,Yeh baat samajh mein aati hai.
Dialogue: 0,0:06:31.13,0:06:32.75,Default,,0,0,0,,Par bahut hona aur ek tay
Dialogue: 0,0:06:32.75,0:06:33.57,Default,,0,0,0,,ginti hona,
Dialogue: 0,0:06:33.57,0:06:34.38,Default,,0,0,0,,inme fark hai.
Dialogue: 0,0:06:34.38,0:06:36.40,Default,,0,0,0,,Granth imaaraton ka zikr karte hain,
Dialogue: 0,0:06:36.40,0:06:38.23,Default,,0,0,0,,ginti ka sabut nahi milta.
Dialogue: 0,0:06:38.68,0:06:40.28,Default,,0,0,0,,Ab 3 mahine wali baat.
Dialogue: 0,0:06:40.28,0:06:41.68,Default,,0,0,0,,Itihaskar kehte hain,
Dialogue: 0,0:06:41.68,0:06:43.28,Default,,0,0,0,,us daur ka mukhya granth vihar
Dialogue: 0,0:06:43.28,0:06:44.88,Default,,0,0,0,,ke tootne ka zikr karta hai.
Dialogue: 0,0:06:44.88,0:06:46.68,Default,,0,0,0,,Par 3 mahine tak jalne ki
Dialogue: 0,0:06:46.68,0:06:48.08,Default,,0,0,0,,baat usme nahi milti.
Dialogue: 0,0:06:48.08,0:06:49.88,Default,,0,0,0,,Yeh ginti baad ki lok kahaniyon
Dialogue: 0,0:06:49.88,0:06:50.68,Default,,0,0,0,,mein aati hai,
Dialogue: 0,0:06:50.68,0:06:52.88,Default,,0,0,0,,purane likhe itihaas mein nahi.
Dialogue: 0,0:06:53.33,0:06:55.50,Default,,0,0,0,,Chronicle yaani itihaas ki diary,
Dialogue: 0,0:06:55.50,0:06:57.07,Default,,0,0,0,,jo raja ya sena ke daur
Dialogue: 0,0:06:57.07,0:06:58.25,Default,,0,0,0,,mein likhi jaati thi.
Dialogue: 0,0:06:58.25,0:07:00.42,Default,,0,0,0,,Aisi hi ek kitaab hai Tabaqat-i
Dialogue: 0,0:07:00.42,0:07:01.00,Default,,0,0,0,,Nasiri.
Dialogue: 0,0:07:01.00,0:07:04.15,Default,,0,0,0,,Ise Persian itihaskar Minhaj-i-Siraj ne likha.
Dialogue: 0,0:07:04.15,0:07:06.12,Default,,0,0,0,,Isme Bihar ke ek kile jaise
Dialogue: 0,0:07:06.12,0:07:07.89,Default,,0,0,0,,vihar par hamle ka zikr milta
Dialogue: 0,0:07:07.89,0:07:08.09,Default,,0,0,0,,hai.
Dialogue: 0,0:07:08.54,0:07:10.34,Default,,0,0,0,,Minhaj likhte hain ki Bakhtiyar Khalji
Dialogue: 0,0:07:10.34,0:07:11.95,Default,,0,0,0,,ki sena ne woh jagah jeeti.
Dialogue: 0,0:07:11.95,0:07:13.93,Default,,0,0,0,,Wahan bahut saari kitaabein mili.
Dialogue: 0,0:07:13.93,0:07:15.55,Default,,0,0,0,,Sena ne aise log dhoondhe jo
Dialogue: 0,0:07:15.55,0:07:17.35,Default,,0,0,0,,bata sakein ki kitaabon mein kya
Dialogue: 0,0:07:17.35,0:07:17.88,Default,,0,0,0,,likha hai.
Dialogue: 0,0:07:17.88,0:07:18.78,Default,,0,0,0,,Par granth kehta hai,
Dialogue: 0,0:07:18.78,0:07:20.58,Default,,0,0,0,,unhe padhne wale tab tak maare
Dialogue: 0,0:07:20.58,0:07:21.30,Default,,0,0,0,,ja chuke the.
Dialogue: 0,0:07:21.75,0:07:23.86,Default,,0,0,0,,Aur yahin itihaskar ek baat par
Dialogue: 0,0:07:23.86,0:07:24.91,Default,,0,0,0,,atak jaate hain.
Dialogue: 0,0:07:24.91,0:07:26.80,Default,,0,0,0,,Kitaab us jagah ko bas Bihar
Dialogue: 0,0:07:26.80,0:07:27.43,Default,,0,0,0,,kehti hai.
Dialogue: 0,0:07:27.43,0:07:29.12,Default,,0,0,0,,Kuch vidwan maante hain ki yeh
Dialogue: 0,0:07:29.12,0:07:29.96,Default,,0,0,0,,Nalanda tha.
Dialogue: 0,0:07:29.96,0:07:30.17,Default,,0,0,0,,D.N.
Dialogue: 0,0:07:30.17,0:07:32.27,Default,,0,0,0,,Jha jaise itihaskar kehte hain,
Dialogue: 0,0:07:32.27,0:07:34.59,Default,,0,0,0,,yeh paas ka Odantapuri vihar bhi
Dialogue: 0,0:07:34.59,0:07:35.43,Default,,0,0,0,,ho sakta hai.
Dialogue: 0,0:07:35.88,0:07:38.90,Default,,0,0,0,,Odantapuri bhi ek bada mahavihara tha,
Dialogue: 0,0:07:38.90,0:07:40.10,Default,,0,0,0,,Nalanda ke paas hi.
Dialogue: 0,0:07:40.10,0:07:41.91,Default,,0,0,0,,Woh bhi kile jaisa mazboot tha.
Dialogue: 0,0:07:41.91,0:07:43.72,Default,,0,0,0,,Isliye kitaab ka varnan us par
Dialogue: 0,0:07:43.72,0:07:44.93,Default,,0,0,0,,bhi fit ho sakta hai.
Dialogue: 0,0:07:44.93,0:07:45.33,Default,,0,0,0,,Matlab,
Dialogue: 0,0:07:45.33,0:07:47.34,Default,,0,0,0,,Nalanda mein aag ka sabut mitti
Dialogue: 0,0:07:47.34,0:07:47.74,Default,,0,0,0,,mein hai.
Dialogue: 0,0:07:47.74,0:07:48.75,Default,,0,0,0,,Par kis hamle mein,
Dialogue: 0,0:07:48.75,0:07:49.15,Default,,0,0,0,,kis din,
Dialogue: 0,0:07:49.15,0:07:50.96,Default,,0,0,0,,yeh abhi bhi bahas ka mudda
Dialogue: 0,0:07:50.96,0:07:51.16,Default,,0,0,0,,hai.
Dialogue: 0,0:07:51.61,0:07:53.36,Default,,0,0,0,,Ab ek aur kahani suniye,
Dialogue: 0,0:07:53.36,0:07:54.89,Default,,0,0,0,,jo Tibet se aati hai.
Dialogue: 0,0:07:54.89,0:07:56.20,Default,,0,0,0,,Yeh itihaas nahi,
Dialogue: 0,0:07:56.20,0:07:56.86,Default,,0,0,0,,legend hai,
Dialogue: 0,0:07:56.86,0:07:59.04,Default,,0,0,0,,yaani lok katha jiska koi pakad
Dialogue: 0,0:07:59.04,0:08:01.01,Default,,0,0,0,,mein aane wala sabut nahi.
Dialogue: 0,0:08:01.01,0:08:02.76,Default,,0,0,0,,Par yeh dikhati hai ki log
Dialogue: 0,0:08:02.76,0:08:04.51,Default,,0,0,0,,is aag ko sadiyon tak kaise
Dialogue: 0,0:08:04.51,0:08:05.60,Default,,0,0,0,,yaad rakhte rahe,
Dialogue: 0,0:08:05.60,0:08:07.13,Default,,0,0,0,,kaise sunate rahe.
Dialogue: 0,0:08:07.58,0:08:10.56,Default,,0,0,0,,Tibetan lekhak Taranatha ne likha ki
Dialogue: 0,0:08:10.56,0:08:12.62,Default,,0,0,0,,kuch apmaanit sadhuon ne 9 saal
Dialogue: 0,0:08:12.62,0:08:13.77,Default,,0,0,0,,tak tapasya ki.
Dialogue: 0,0:08:13.77,0:08:16.29,Default,,0,0,0,,Tapasya poori hone par woh laute.
Dialogue: 0,0:08:16.29,0:08:18.58,Default,,0,0,0,,Unhone mantra se bhari raakh har
Dialogue: 0,0:08:18.58,0:08:19.73,Default,,0,0,0,,taraf bikher di.
Dialogue: 0,0:08:19.73,0:08:21.33,Default,,0,0,0,,Aur kahani kehti hai,
Dialogue: 0,0:08:21.33,0:08:23.39,Default,,0,0,0,,usi raakh se library mein aag
Dialogue: 0,0:08:23.39,0:08:23.85,Default,,0,0,0,,lag gayi.
Dialogue: 0,0:08:23.85,0:08:25.46,Default,,0,0,0,,Kahani mein jaadu hai,
Dialogue: 0,0:08:25.46,0:08:27.06,Default,,0,0,0,,par dard asli lagta hai.
Dialogue: 0,0:08:27.51,0:08:28.91,Default,,0,0,0,,Ab ek aankhon dekha bayan.
Dialogue: 0,0:08:28.91,0:08:31.72,Default,,0,0,0,,Tibet ke bhikshu Dharmasvamin 1235 mein
Dialogue: 0,0:08:31.72,0:08:32.92,Default,,0,0,0,,Nalanda pahunche.
Dialogue: 0,0:08:32.92,0:08:34.33,Default,,0,0,0,,Yeh hamle ke kai saal baad
Dialogue: 0,0:08:34.33,0:08:34.93,Default,,0,0,0,,ki baat hai.
Dialogue: 0,0:08:34.93,0:08:37.34,Default,,0,0,0,,Unhone dekha ki Nalanda toota hua
Dialogue: 0,0:08:37.34,0:08:37.54,Default,,0,0,0,,tha,
Dialogue: 0,0:08:37.54,0:08:39.54,Default,,0,0,0,,par poori tarah khatam nahi hua
Dialogue: 0,0:08:39.54,0:08:39.74,Default,,0,0,0,,tha.
Dialogue: 0,0:08:39.74,0:08:41.55,Default,,0,0,0,,Unki jeevani mein yeh bayan aaj
Dialogue: 0,0:08:41.55,0:08:42.35,Default,,0,0,0,,bhi milta hai.
Dialogue: 0,0:08:42.80,0:08:45.42,Default,,0,0,0,,Wahan abbot Rahula Shribhadra ab bhi
Dialogue: 0,0:08:45.42,0:08:46.51,Default,,0,0,0,,padha rahe the.
Dialogue: 0,0:08:46.51,0:08:48.25,Default,,0,0,0,,Abbot yaani math ke pramukh.
Dialogue: 0,0:08:48.25,0:08:49.56,Default,,0,0,0,,Khandaharon ke beech,
Dialogue: 0,0:08:49.56,0:08:51.96,Default,,0,0,0,,kuch vidyarthi unke saamne baithe the.
Dialogue: 0,0:08:51.96,0:08:52.83,Default,,0,0,0,,Granth kehta hai,
Dialogue: 0,0:08:52.83,0:08:55.23,Default,,0,0,0,,Nalanda tab apne purane roop ka
Dialogue: 0,0:08:55.23,0:08:56.54,Default,,0,0,0,,bas ek saaya reh gaya tha.
Dialogue: 0,0:08:56.54,0:08:58.28,Default,,0,0,0,,Phir bhi padhai chal rahi thi.
Dialogue: 0,0:08:58.73,0:09:00.96,Default,,0,0,0,,Yeh bayan kahani ko badal deta
Dialogue: 0,0:09:00.96,0:09:01.18,Default,,0,0,0,,hai.
Dialogue: 0,0:09:01.18,0:09:03.85,Default,,0,0,0,,Agar 1235 mein bhi yahan padhai
Dialogue: 0,0:09:03.85,0:09:04.75,Default,,0,0,0,,chal rahi thi,
Dialogue: 0,0:09:04.75,0:09:06.97,Default,,0,0,0,,toh Nalanda ek jhatke mein khatam
Dialogue: 0,0:09:06.97,0:09:07.64,Default,,0,0,0,,nahi hua.
Dialogue: 0,0:09:07.64,0:09:08.75,Default,,0,0,0,,Shayad dheere dheere,
Dialogue: 0,0:09:08.75,0:09:10.09,Default,,0,0,0,,nuksaan par nuksaan se,
Dialogue: 0,0:09:10.09,0:09:11.43,Default,,0,0,0,,yeh khaali hota gaya.
Dialogue: 0,0:09:11.43,0:09:14.55,Default,,0,0,0,,Kuch itihaskar isi taraf ishara karte
Dialogue: 0,0:09:14.55,0:09:14.77,Default,,0,0,0,,hain.
Dialogue: 0,0:09:15.22,0:09:16.72,Default,,0,0,0,,Toh ab tak kya sach mein
Dialogue: 0,0:09:16.72,0:09:17.47,Default,,0,0,0,,pata hai?
Dialogue: 0,0:09:17.47,0:09:18.47,Default,,0,0,0,,Nalanda tha,
Dialogue: 0,0:09:18.47,0:09:19.72,Default,,0,0,0,,bahut bada tha,
Dialogue: 0,0:09:19.72,0:09:21.47,Default,,0,0,0,,aur usme aag lagi thi.
Dialogue: 0,0:09:21.47,0:09:22.72,Default,,0,0,0,,Yeh mitti aur granth,
Dialogue: 0,0:09:22.72,0:09:24.21,Default,,0,0,0,,dono batate hain.
Dialogue: 0,0:09:24.21,0:09:26.21,Default,,0,0,0,,Par kuch sawaal aaj bhi khule
Dialogue: 0,0:09:26.21,0:09:26.46,Default,,0,0,0,,hain.
Dialogue: 0,0:09:26.46,0:09:28.96,Default,,0,0,0,,Aur shayad yahi Nalanda ka sabse
Dialogue: 0,0:09:28.96,0:09:30.46,Default,,0,0,0,,bada rahasya hai.
Dialogue: 0,0:09:30.91,0:09:32.08,Default,,0,0,0,,Sabse bada sawaal,
Dialogue: 0,0:09:32.08,0:09:33.44,Default,,0,0,0,,Dharmaganja kahan tha?
Dialogue: 0,0:09:33.44,0:09:34.42,Default,,0,0,0,,Granthon mein naam hai,
Dialogue: 0,0:09:34.42,0:09:36.17,Default,,0,0,0,,oonchi imaaraton ka zikr hai.
Dialogue: 0,0:09:36.17,0:09:38.32,Default,,0,0,0,,Par khudai wale ilaake mein abhi
Dialogue: 0,0:09:38.32,0:09:39.68,Default,,0,0,0,,tak yeh tay nahi hua ki
Dialogue: 0,0:09:39.68,0:09:42.02,Default,,0,0,0,,library ki imaaratein theek kis jagah
Dialogue: 0,0:09:42.02,0:09:42.61,Default,,0,0,0,,khadi thi.
Dialogue: 0,0:09:42.61,0:09:44.16,Default,,0,0,0,,Shayad woh abhi bhi mitti ke
Dialogue: 0,0:09:44.16,0:09:44.75,Default,,0,0,0,,neeche hai.
Dialogue: 0,0:09:45.20,0:09:46.13,Default,,0,0,0,,Aur ek sawaal,
Dialogue: 0,0:09:46.13,0:09:47.52,Default,,0,0,0,,kaunsi pothiyan kho gayi?
Dialogue: 0,0:09:47.52,0:09:50.07,Default,,0,0,0,,Unki koi poori suchi nahi bachi.
Dialogue: 0,0:09:50.07,0:09:52.16,Default,,0,0,0,,Hum nahi jaante ki un shelfon
Dialogue: 0,0:09:52.16,0:09:53.55,Default,,0,0,0,,par kya kya likha tha.
Dialogue: 0,0:09:53.55,0:09:55.64,Default,,0,0,0,,Jo gyaan Xuanzang jaise yatri seekh
Dialogue: 0,0:09:55.64,0:09:56.34,Default,,0,0,0,,kar le gaye,
Dialogue: 0,0:09:56.34,0:09:57.03,Default,,0,0,0,,woh bacha.
Dialogue: 0,0:09:57.03,0:09:58.19,Default,,0,0,0,,Jo yahin reh gaya,
Dialogue: 0,0:09:58.19,0:10:00.28,Default,,0,0,0,,uske naam bhi hum nahi jaante.
Dialogue: 0,0:10:00.73,0:10:01.84,Default,,0,0,0,,Aaj aap Nalanda,
Dialogue: 0,0:10:01.84,0:10:03.18,Default,,0,0,0,,Bihar jaa sakte hain.
Dialogue: 0,0:10:03.18,0:10:06.07,Default,,0,0,0,,UNESCO ne ise World Heritage Site
Dialogue: 0,0:10:06.07,0:10:06.74,Default,,0,0,0,,maana hai,
Dialogue: 0,0:10:06.74,0:10:09.41,Default,,0,0,0,,yaani poori duniya ki saajhi virasat.
Dialogue: 0,0:10:09.41,0:10:10.74,Default,,0,0,0,,Laal eenton ke vihar,
Dialogue: 0,0:10:10.74,0:10:12.97,Default,,0,0,0,,oonche mandir aur lambe raste aaj
Dialogue: 0,0:10:12.97,0:10:13.86,Default,,0,0,0,,bhi khade hain.
Dialogue: 0,0:10:13.86,0:10:15.63,Default,,0,0,0,,Subah ki dhoop mein yeh jagah
Dialogue: 0,0:10:15.63,0:10:16.97,Default,,0,0,0,,alag hi dikhti hai.
Dialogue: 0,0:10:17.42,0:10:19.53,Default,,0,0,0,,Site museum mein woh jale chawal
Dialogue: 0,0:10:19.53,0:10:20.38,Default,,0,0,0,,zaroor dekhiye,
Dialogue: 0,0:10:20.38,0:10:22.28,Default,,0,0,0,,jo is kahani ki shuruaat the.
Dialogue: 0,0:10:22.28,0:10:23.12,Default,,0,0,0,,Copper plate,
Dialogue: 0,0:10:23.12,0:10:25.03,Default,,0,0,0,,sikke aur mitti ke bartan bhi
Dialogue: 0,0:10:25.03,0:10:25.66,Default,,0,0,0,,wahin hain.
Dialogue: 0,0:10:25.66,0:10:27.56,Default,,0,0,0,,Phir kisi vihar ke kamre mein
Dialogue: 0,0:10:27.56,0:10:28.83,Default,,0,0,0,,khade hokar socho.
Dialogue: 0,0:10:28.83,0:10:30.73,Default,,0,0,0,,Yahin kabhi koi bhikshu diye ki
Dialogue: 0,0:10:30.73,0:10:32.42,Default,,0,0,0,,roshni mein pothi padhta tha.
Dialogue: 0,0:10:32.87,0:10:34.65,Default,,0,0,0,,Aur jab aap kisi deewar par
Dialogue: 0,0:10:34.65,0:10:35.99,Default,,0,0,0,,kaala nishaan dekhein,
Dialogue: 0,0:10:35.99,0:10:37.11,Default,,0,0,0,,toh ek pal ruk jaiye.
Dialogue: 0,0:10:37.11,0:10:38.89,Default,,0,0,0,,Ho sakta hai woh usi aag
Dialogue: 0,0:10:38.89,0:10:39.56,Default,,0,0,0,,ki yaad ho.
Dialogue: 0,0:10:39.56,0:10:41.57,Default,,0,0,0,,Guide ki kahani bhi suniye,
Dialogue: 0,0:10:41.57,0:10:42.46,Default,,0,0,0,,mazaa aayega.
Dialogue: 0,0:10:42.46,0:10:44.25,Default,,0,0,0,,Par saath mein ek sawaal zaroor
Dialogue: 0,0:10:44.25,0:10:44.69,Default,,0,0,0,,poochiye.
Dialogue: 0,0:10:44.69,0:10:46.03,Default,,0,0,0,,Iska sabut kya hai?
Dialogue: 0,0:10:46.48,0:10:49.33,Default,,0,0,0,,Agli baar hum chalenge Odantapuri ki
Dialogue: 0,0:10:49.33,0:10:49.99,Default,,0,0,0,,talash mein.
Dialogue: 0,0:10:49.99,0:10:52.84,Default,,0,0,0,,Woh mahavihara jiska naam is kahani
Dialogue: 0,0:10:52.84,0:10:53.72,Default,,0,0,0,,mein baar baar aaya,
Dialogue: 0,0:10:53.72,0:10:55.91,Default,,0,0,0,,par jiska thikana aaj bhi bahas
Dialogue: 0,0:10:55.91,0:10:56.35,Default,,0,0,0,,mein hai.
Dialogue: 0,0:10:56.35,0:10:58.11,Default,,0,0,0,,Kya woh sach mein Nalanda ke
Dialogue: 0,0:10:58.11,0:10:58.55,Default,,0,0,0,,paas tha?
Dialogue: 0,0:10:58.55,0:10:59.86,Default,,0,0,0,,Wahan kya mila hai?
Dialogue: 0,0:10:59.86,0:11:01.40,Default,,0,0,0,,Sabut ke saath dekhenge.
Dialogue: 0,0:11:01.85,0:11:03.75,Default,,0,0,0,,Ab aapse ek aasaan sawaal.
Dialogue: 0,0:11:03.75,0:11:06.61,Default,,0,0,0,,Aapne Nalanda ke 3 mahine jalne
Dialogue: 0,0:11:06.61,0:11:08.28,Default,,0,0,0,,ki baat kahan suni thi,
Dialogue: 0,0:11:08.28,0:11:08.51,Default,,0,0,0,,school,
Dialogue: 0,0:11:08.51,0:11:09.47,Default,,0,0,0,,ghar ya WhatsApp?
Dialogue: 0,0:11:09.47,0:11:10.66,Default,,0,0,0,,Comment mein bataiye.
Dialogue: 0,0:11:10.66,0:11:12.80,Default,,0,0,0,,Aur agar aap Nalanda gaye hain,
Dialogue: 0,0:11:12.80,0:11:15.42,Default,,0,0,0,,toh bataiye wahan aapko sabse zyada
Dialogue: 0,0:11:15.42,0:11:16.37,Default,,0,0,0,,kya yaad raha.
