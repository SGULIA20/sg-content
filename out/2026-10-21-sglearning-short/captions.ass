Dialogue: 0,0:00:00.00,0:00:01.27,Default,,0,0,0,,Subah chai ke saath,
Dialogue: 0,0:00:01.27,0:00:03.80,Default,,0,0,0,,Bhai ke phone par headline chamki.
Dialogue: 0,0:00:04.25,0:00:06.26,Default,,0,0,0,,Tips Music har share par 6.50
Dialogue: 0,0:00:06.26,0:00:08.53,Default,,0,0,0,,rupaye dividend de rahi hai.
Dialogue: 0,0:00:08.53,0:00:11.05,Default,,0,0,0,,Dividend yaani profit ka hissa,
Dialogue: 0,0:00:11.05,0:00:12.81,Default,,0,0,0,,seedha shareholders ko.
Dialogue: 0,0:00:13.26,0:00:14.38,Default,,0,0,0,,Bhai ne socha,
Dialogue: 0,0:00:14.38,0:00:15.78,Default,,0,0,0,,aaj share le lo,
Dialogue: 0,0:00:15.78,0:00:17.46,Default,,0,0,0,,kal free paisa bank mein.
Dialogue: 0,0:00:17.91,0:00:19.49,Default,,0,0,0,,Uska logic simple tha.
Dialogue: 0,0:00:19.49,0:00:21.98,Default,,0,0,0,,Record date se pehle share demat
Dialogue: 0,0:00:21.98,0:00:22.43,Default,,0,0,0,,mein ho,
Dialogue: 0,0:00:22.43,0:00:23.79,Default,,0,0,0,,toh paisa milega.
Dialogue: 0,0:00:24.24,0:00:26.25,Default,,0,0,0,,Record date yaani woh din jab
Dialogue: 0,0:00:26.25,0:00:28.04,Default,,0,0,0,,company list banati hai,
Dialogue: 0,0:00:28.04,0:00:29.60,Default,,0,0,0,,kisko paisa dena hai.
Dialogue: 0,0:00:30.05,0:00:30.97,Default,,0,0,0,,Mummy boli,
Dialogue: 0,0:00:30.97,0:00:32.13,Default,,0,0,0,,itna aasaan hai,
Dialogue: 0,0:00:32.13,0:00:34.21,Default,,0,0,0,,toh sab yahi kyun nahi karte?
Dialogue: 0,0:00:34.66,0:00:36.37,Default,,0,0,0,,Agle din market khula,
Dialogue: 0,0:00:36.37,0:00:39.05,Default,,0,0,0,,aur share ka price lagbhag dividend
Dialogue: 0,0:00:39.05,0:00:40.02,Default,,0,0,0,,jitna gir gaya.
Dialogue: 0,0:00:40.47,0:00:42.47,Default,,0,0,0,,Ise ex-dividend kehte hain,
Dialogue: 0,0:00:42.47,0:00:44.90,Default,,0,0,0,,yaani ab share bina dividend ke
Dialogue: 0,0:00:44.90,0:00:45.79,Default,,0,0,0,,bik raha hai.
Dialogue: 0,0:00:46.24,0:00:46.97,Default,,0,0,0,,Phir aaya tax.
Dialogue: 0,0:00:46.97,0:00:49.91,Default,,0,0,0,,Dividend aapki income mein judta hai,
Dialogue: 0,0:00:49.91,0:00:51.13,Default,,0,0,0,,slab ke hisaab se.
Dialogue: 0,0:00:51.13,0:00:53.09,Default,,0,0,0,,Upar ke slab mein yeh 30
Dialogue: 0,0:00:53.09,0:00:54.56,Default,,0,0,0,,percent tak jaata hai.
Dialogue: 0,0:00:55.01,0:00:57.38,Default,,0,0,0,,Matlab paisa share ki keemat se
Dialogue: 0,0:00:57.38,0:00:57.85,Default,,0,0,0,,nikla,
Dialogue: 0,0:00:57.85,0:00:59.28,Default,,0,0,0,,aur aapke bank mein aaya.
Dialogue: 0,0:00:59.28,0:01:00.46,Default,,0,0,0,,Bas jagah badli,
Dialogue: 0,0:01:00.46,0:01:01.41,Default,,0,0,0,,aur tax alag.
Dialogue: 0,0:01:01.86,0:01:03.55,Default,,0,0,0,,Date ke peeche mat bhaago,
Dialogue: 0,0:01:03.55,0:01:05.46,Default,,0,0,0,,company ka business samjho.
Dialogue: 0,0:01:05.46,0:01:07.58,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:08.03,0:01:10.83,Default,,0,0,0,,Aapne kabhi dividend ke liye share
Dialogue: 0,0:01:10.83,0:01:11.34,Default,,0,0,0,,liya hai?
Dialogue: 0,0:01:11.34,0:01:12.11,Default,,0,0,0,,Haan ya na?
