Dialogue: 0,0:00:00.00,0:00:01.29,Default,,0,0,0,,Subah chai ke saath,
Dialogue: 0,0:00:01.29,0:00:03.36,Default,,0,0,0,,Bhai ke phone par khabar aayi.
Dialogue: 0,0:00:03.36,0:00:04.65,Default,,0,0,0,,Meta ki kamai,
Dialogue: 0,0:00:04.65,0:00:06.72,Default,,0,0,0,,Wall Street ki umeed se zyada
Dialogue: 0,0:00:06.72,0:00:07.24,Default,,0,0,0,,nikli.
Dialogue: 0,0:00:07.69,0:00:09.65,Default,,0,0,0,,Bhai ki har mahine ek SIP
Dialogue: 0,0:00:09.65,0:00:10.38,Default,,0,0,0,,jaati hai,
Dialogue: 0,0:00:10.38,0:00:11.85,Default,,0,0,0,,ek foreign tech fund mein.
Dialogue: 0,0:00:11.85,0:00:12.83,Default,,0,0,0,,Woh kehta hai,
Dialogue: 0,0:00:12.83,0:00:14.78,Default,,0,0,0,,duniya ki badi companies,
Dialogue: 0,0:00:14.78,0:00:16.25,Default,,0,0,0,,mera paisa wahin.
Dialogue: 0,0:00:16.70,0:00:18.55,Default,,0,0,0,,Usne socha,
Dialogue: 0,0:00:18.55,0:00:20.85,Default,,0,0,0,,kamai badhi hai,
Dialogue: 0,0:00:20.85,0:00:23.62,Default,,0,0,0,,toh fund bhi chamkega.
Dialogue: 0,0:00:24.07,0:00:25.70,Default,,0,0,0,,Logic seedha laga,
Dialogue: 0,0:00:25.70,0:00:27.06,Default,,0,0,0,,achhi company,
Dialogue: 0,0:00:27.06,0:00:28.14,Default,,0,0,0,,achha result,
Dialogue: 0,0:00:28.14,0:00:29.23,Default,,0,0,0,,achha return.
Dialogue: 0,0:00:29.68,0:00:31.91,Default,,0,0,0,,Isliye usne SIP badhane ka man
Dialogue: 0,0:00:31.91,0:00:32.58,Default,,0,0,0,,bana liya,
Dialogue: 0,0:00:32.58,0:00:34.36,Default,,0,0,0,,fund ke andar dekhe bina.
Dialogue: 0,0:00:34.81,0:00:36.62,Default,,0,0,0,,Par usi khabar mein ek aur
Dialogue: 0,0:00:36.62,0:00:37.30,Default,,0,0,0,,line thi,
Dialogue: 0,0:00:37.30,0:00:38.89,Default,,0,0,0,,jo Bhai ne padhi nahi.
Dialogue: 0,0:00:38.89,0:00:40.93,Default,,0,0,0,,Meta is saal AI par 145
Dialogue: 0,0:00:40.93,0:00:42.97,Default,,0,0,0,,billion dollar tak kharch karegi.
Dialogue: 0,0:00:43.42,0:00:45.31,Default,,0,0,0,,Isko capex kehte hain,
Dialogue: 0,0:00:45.31,0:00:48.29,Default,,0,0,0,,yaani data centre aur machines par
Dialogue: 0,0:00:48.29,0:00:49.37,Default,,0,0,0,,bada kharcha.
Dialogue: 0,0:00:49.37,0:00:50.18,Default,,0,0,0,,Aaj kharcha,
Dialogue: 0,0:00:50.18,0:00:51.26,Default,,0,0,0,,kamai shayad kal.
Dialogue: 0,0:00:51.71,0:00:53.68,Default,,0,0,0,,Kharcha itna bada ki free cash
Dialogue: 0,0:00:53.68,0:00:55.22,Default,,0,0,0,,flow minus mein chala gaya.
Dialogue: 0,0:00:55.22,0:00:57.19,Default,,0,0,0,,Free cash flow yaani saare kharche
Dialogue: 0,0:00:57.19,0:00:58.51,Default,,0,0,0,,ke baad jo cash bacha.
Dialogue: 0,0:00:58.96,0:01:00.25,Default,,0,0,0,,Ab twist suniye,
Dialogue: 0,0:01:00.25,0:01:02.51,Default,,0,0,0,,Bhai ke fund ka 10.38 percent
Dialogue: 0,0:01:02.51,0:01:04.44,Default,,0,0,0,,hissa sirf Meta hai.
Dialogue: 0,0:01:04.89,0:01:06.34,Default,,0,0,0,,Matlab Bhai ki SIP bhi is
Dialogue: 0,0:01:06.34,0:01:07.59,Default,,0,0,0,,AI daav mein shaamil hai.
Dialogue: 0,0:01:07.59,0:01:08.62,Default,,0,0,0,,Headline nahi,
Dialogue: 0,0:01:08.62,0:01:10.70,Default,,0,0,0,,fund ke andar ki companies dekhiye.
Dialogue: 0,0:01:10.70,0:01:12.77,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:13.22,0:01:15.93,Default,,0,0,0,,Aapki SIP ke andar kaunsi company
Dialogue: 0,0:01:15.93,0:01:17.16,Default,,0,0,0,,sabse badi hai,
Dialogue: 0,0:01:17.16,0:01:17.90,Default,,0,0,0,,pata hai?
