Dialogue: 0,0:00:00.00,0:00:02.03,Default,,0,0,0,,Papa bank se laute,
Dialogue: 0,0:00:02.03,0:00:04.39,Default,,0,0,0,,haath mein nayi FD ki raseed,
Dialogue: 0,0:00:04.39,0:00:06.08,Default,,0,0,0,,chehre par sukoon.
Dialogue: 0,0:00:06.53,0:00:08.27,Default,,0,0,0,,Unka mantra seedha hai,
Dialogue: 0,0:00:08.27,0:00:09.26,Default,,0,0,0,,FD safe hai,
Dialogue: 0,0:00:09.26,0:00:11.25,Default,,0,0,0,,paisa kabhi nahi doobta.
Dialogue: 0,0:00:11.70,0:00:13.41,Default,,0,0,0,,Bank Uncle ne bataya,
Dialogue: 0,0:00:13.41,0:00:15.11,Default,,0,0,0,,saal bhar ki FD par 6.25
Dialogue: 0,0:00:15.11,0:00:16.82,Default,,0,0,0,,percent byaaj milega.
Dialogue: 0,0:00:17.27,0:00:18.51,Default,,0,0,0,,Papa ne socha,
Dialogue: 0,0:00:18.51,0:00:20.25,Default,,0,0,0,,paisa har saal badhega,
Dialogue: 0,0:00:20.25,0:00:21.99,Default,,0,0,0,,aur tension bilkul nahi.
Dialogue: 0,0:00:22.44,0:00:24.09,Default,,0,0,0,,Passbook mein number badhta hai,
Dialogue: 0,0:00:24.09,0:00:25.74,Default,,0,0,0,,toh lagta hai hum aage badh
Dialogue: 0,0:00:25.74,0:00:26.36,Default,,0,0,0,,rahe hain.
Dialogue: 0,0:00:26.81,0:00:29.68,Default,,0,0,0,,Usi shaam Mummy kirane ka bill
Dialogue: 0,0:00:29.68,0:00:30.82,Default,,0,0,0,,dekh rahi thi,
Dialogue: 0,0:00:30.82,0:00:31.97,Default,,0,0,0,,sab kuch mehnga.
Dialogue: 0,0:00:32.42,0:00:35.44,Default,,0,0,0,,Mehngai yaani daam kitne badhe,
Dialogue: 0,0:00:35.44,0:00:38.46,Default,,0,0,0,,September mein yeh 5.54 percent thi.
Dialogue: 0,0:00:38.91,0:00:41.43,Default,,0,0,0,,Byaaj aur mehngai ka farak dekhiye,
Dialogue: 0,0:00:41.43,0:00:43.39,Default,,0,0,0,,bas zara sa bachta hai.
Dialogue: 0,0:00:43.84,0:00:45.35,Default,,0,0,0,,Phir us byaaj par aapke slab
Dialogue: 0,0:00:45.35,0:00:47.50,Default,,0,0,0,,ke hisaab se income tax lagta
Dialogue: 0,0:00:47.50,0:00:47.72,Default,,0,0,0,,hai.
Dialogue: 0,0:00:48.17,0:00:51.21,Default,,0,0,0,,Real return yaani mehngai aur tax
Dialogue: 0,0:00:51.21,0:00:53.57,Default,,0,0,0,,kaat kar jo sach mein bacha.
Dialogue: 0,0:00:54.02,0:00:56.01,Default,,0,0,0,,Unche tax slab waalon ke liye
Dialogue: 0,0:00:56.01,0:00:57.50,Default,,0,0,0,,yeh lagbhag kuch nahi,
Dialogue: 0,0:00:57.50,0:00:58.74,Default,,0,0,0,,kabhi minus mein.
Dialogue: 0,0:00:59.19,0:01:01.67,Default,,0,0,0,,FD aapke rupaye ko bachati hai,
Dialogue: 0,0:01:01.67,0:01:04.16,Default,,0,0,0,,rupaye ki khareedne ki taakat ko
Dialogue: 0,0:01:04.16,0:01:04.65,Default,,0,0,0,,nahi.
Dialogue: 0,0:01:04.65,0:01:05.89,Default,,0,0,0,,Apni FD ka byaaj,
Dialogue: 0,0:01:05.89,0:01:06.64,Default,,0,0,0,,tax ke baad,
Dialogue: 0,0:01:06.64,0:01:08.63,Default,,0,0,0,,mehngai se milaakar dekhiye.
Dialogue: 0,0:01:08.63,0:01:11.11,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:11.56,0:01:14.21,Default,,0,0,0,,Aapki FD mehngai se aage hai
Dialogue: 0,0:01:14.21,0:01:15.09,Default,,0,0,0,,ya peeche?
Dialogue: 0,0:01:15.09,0:01:16.56,Default,,0,0,0,,Comment mein likhiye.
