Dialogue: 0,0:00:00.00,0:00:02.19,Default,,0,0,0,,Papa ghar aate hi dining table
Dialogue: 0,0:00:02.19,0:00:03.94,Default,,0,0,0,,par nayi FD receipt rakh dete
Dialogue: 0,0:00:03.94,0:00:04.16,Default,,0,0,0,,hain.
Dialogue: 0,0:00:04.61,0:00:05.92,Default,,0,0,0,,Chehre par sukoon tha,
Dialogue: 0,0:00:05.92,0:00:08.32,Default,,0,0,0,,bole bank mein paisa hamesha bilkul
Dialogue: 0,0:00:08.32,0:00:09.41,Default,,0,0,0,,safe rehta hai.
Dialogue: 0,0:00:09.86,0:00:12.50,Default,,0,0,0,,Humare parivaaron mein saalon se savings
Dialogue: 0,0:00:12.50,0:00:14.13,Default,,0,0,0,,ka matlab sirf FD receipt hi
Dialogue: 0,0:00:14.13,0:00:14.74,Default,,0,0,0,,raha hai.
Dialogue: 0,0:00:15.19,0:00:18.47,Default,,0,0,0,,Bank uncle ne unhe senior citizen
Dialogue: 0,0:00:18.47,0:00:20.85,Default,,0,0,0,,scheme mein 7.05 percent ka byaaj
Dialogue: 0,0:00:20.85,0:00:21.15,Default,,0,0,0,,diya.
Dialogue: 0,0:00:21.60,0:00:23.95,Default,,0,0,0,,Par tax aur badhti mehangai ke
Dialogue: 0,0:00:23.95,0:00:24.21,Default,,0,0,0,,baad,
Dialogue: 0,0:00:24.21,0:00:25.52,Default,,0,0,0,,haath mein kya bacha?
Dialogue: 0,0:00:25.97,0:00:27.13,Default,,0,0,0,,Tax katne ke baad,
Dialogue: 0,0:00:27.13,0:00:29.68,Default,,0,0,0,,aapke paise ki khareedne ki taqat
Dialogue: 0,0:00:29.68,0:00:30.61,Default,,0,0,0,,ghatt jati hai.
Dialogue: 0,0:00:31.06,0:00:32.91,Default,,0,0,0,,Doosre options par dhyan dena bhi
Dialogue: 0,0:00:32.91,0:00:33.73,Default,,0,0,0,,zaroori hai.
Dialogue: 0,0:00:33.73,0:00:35.78,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:36.23,0:00:38.07,Default,,0,0,0,,Aapke ghar mein FD par kisko
Dialogue: 0,0:00:38.07,0:00:39.91,Default,,0,0,0,,sabse zyada bharosa hai?
