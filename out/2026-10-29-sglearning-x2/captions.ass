Dialogue: 0,0:00:00.00,0:00:02.63,Default,,0,0,0,,Innodata ne India mein reportedly 550
Dialogue: 0,0:00:02.63,0:00:03.68,Default,,0,0,0,,logon ko nikaala.
Dialogue: 0,0:00:04.13,0:00:05.31,Default,,0,0,0,,Employees kehte hain,
Dialogue: 0,0:00:05.31,0:00:07.42,Default,,0,0,0,,laptop aur access achanak band.
Dialogue: 0,0:00:07.42,0:00:10.01,Default,,0,0,0,,Shares 25 percent se zyada gire.
Dialogue: 0,0:00:10.46,0:00:12.59,Default,,0,0,0,,Company AI ke liye data label
Dialogue: 0,0:00:12.59,0:00:13.23,Default,,0,0,0,,karti hai,
Dialogue: 0,0:00:13.23,0:00:15.58,Default,,0,0,0,,yaani AI ko sikhane wali tagging.
Dialogue: 0,0:00:16.03,0:00:17.09,Default,,0,0,0,,Industry trend:
Dialogue: 0,0:00:17.09,0:00:19.75,Default,,0,0,0,,AI ko kam manual labelling chahiye,
Dialogue: 0,0:00:19.75,0:00:21.87,Default,,0,0,0,,clients kaam andar le rahe hain.
Dialogue: 0,0:00:22.32,0:00:24.99,Default,,0,0,0,,Isliye data annotation aur back-office jobs
Dialogue: 0,0:00:24.99,0:00:26.52,Default,,0,0,0,,sabse pehle khatre mein hain.
Dialogue: 0,0:00:26.97,0:00:28.94,Default,,0,0,0,,Job gayi toh salary rukti hai,
Dialogue: 0,0:00:28.94,0:00:29.82,Default,,0,0,0,,EMI nahi.
Dialogue: 0,0:00:29.82,0:00:32.01,Default,,0,0,0,,Company ka health cover bhi khatam.
Dialogue: 0,0:00:32.46,0:00:34.11,Default,,0,0,0,,Industrial Relations Code mein,
Dialogue: 0,0:00:34.11,0:00:35.22,Default,,0,0,0,,agar aap 'worker' hain,
Dialogue: 0,0:00:35.22,0:00:36.13,Default,,0,0,0,,manager nahi,
Dialogue: 0,0:00:36.13,0:00:38.34,Default,,0,0,0,,toh notice ya uske badle salary.
Dialogue: 0,0:00:38.79,0:00:40.63,Default,,0,0,0,,Har poore saal ke hisaab se
Dialogue: 0,0:00:40.63,0:00:42.93,Default,,0,0,0,,retrenchment compensation milta hai,
Dialogue: 0,0:00:42.93,0:00:45.23,Default,,0,0,0,,plus re-skilling fund mein alag paisa.
Dialogue: 0,0:00:45.68,0:00:46.70,Default,,0,0,0,,Code on Wages:
Dialogue: 0,0:00:46.70,0:00:47.91,Default,,0,0,0,,dues 2 working days mein.
Dialogue: 0,0:00:47.91,0:00:48.73,Default,,0,0,0,,Nahi mile,
Dialogue: 0,0:00:48.73,0:00:50.76,Default,,0,0,0,,toh labour commissioner ko complaint.
Dialogue: 0,0:00:51.21,0:00:52.13,Default,,0,0,0,,Khud se poocho:
Dialogue: 0,0:00:52.13,0:00:53.97,Default,,0,0,0,,mera kaam AI kar sakta hai
Dialogue: 0,0:00:53.97,0:00:54.19,Default,,0,0,0,,kya?
Dialogue: 0,0:00:54.19,0:00:56.49,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:56.94,0:00:58.48,Default,,0,0,0,,Us dost ko bhejo jo data
Dialogue: 0,0:00:58.48,0:01:00.02,Default,,0,0,0,,ya back-office job mein hai.
