Dialogue: 0,0:00:42.96,0:00:45.86,Default,,0,0,0,,Spread yaani base rate ke upar
Dialogue: 0,0:00:45.86,0:00:47.31,Default,,0,0,0,,bank ka munafa.
Dialogue: 0,0:00:47.76,0:00:50.37,Default,,0,0,0,,FD renew karte waqt yaad rakho,
Dialogue: 0,0:00:50.37,0:00:52.10,Default,,0,0,0,,DICGC har bank mein 5 lakh
Dialogue: 0,0:00:52.10,0:00:53.84,Default,,0,0,0,,tak cover deta hai.
Dialogue: 0,0:00:54.29,0:00:55.88,Default,,0,0,0,,Rate girna khabar hai,
Dialogue: 0,0:00:55.88,0:00:57.70,Default,,0,0,0,,EMI girwana aapka kaam.
Dialogue: 0,0:00:57.70,0:00:59.97,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:00.42,0:01:01.82,Default,,0,0,0,,Yeh us bhai ko bhejo jo
Dialogue: 0,0:01:01.82,0:01:04.02,Default,,0,0,0,,purane home loan ki EMI bharta
