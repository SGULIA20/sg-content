Dialogue: 0,0:00:14.10,0:00:15.14,Default,,0,0,0,,yaani MCLR,
Dialogue: 0,0:00:15.14,0:00:17.90,Default,,0,0,0,,October mein 8.55 percent hua.
Dialogue: 0,0:00:18.35,0:00:20.85,Default,,0,0,0,,Isi liye naye FD pe byaaj
Dialogue: 0,0:00:20.85,0:00:21.56,Default,,0,0,0,,gira,
Dialogue: 0,0:00:21.56,0:00:22.99,Default,,0,0,0,,sirf 5.61 percent.
Dialogue: 0,0:00:23.44,0:00:26.04,Default,,0,0,0,,Purani FD abhi 6.55 percent kama
Dialogue: 0,0:00:26.04,0:00:26.51,Default,,0,0,0,,rahi,
Dialogue: 0,0:00:26.51,0:00:28.64,Default,,0,0,0,,renew karte hi kam milega.
Dialogue: 0,0:00:29.09,0:00:30.13,Default,,0,0,0,,Reportedly,
Dialogue: 0,0:00:30.13,0:00:32.47,Default,,0,0,0,,gold ke badle loan 83 percent
Dialogue: 0,0:00:32.47,0:00:32.99,Default,,0,0,0,,badhe.
Dialogue: 0,0:00:32.99,0:00:34.81,Default,,0,0,0,,Log udhaar pe chal rahe.
Dialogue: 0,0:00:35.26,0:00:37.12,Default,,0,0,0,,Floating home loan ka rate apne
Dialogue: 0,0:00:37.12,0:00:38.04,Default,,0,0,0,,aap nahi girta.
Dialogue: 0,0:00:38.04,0:00:39.90,Default,,0,0,0,,Woh reset date par badalta hai.
Dialogue: 0,0:00:40.35,0:00:41.51,Default,,0,0,0,,Bank se poochho,
