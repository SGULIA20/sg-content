Dialogue: 0,0:00:00.00,0:00:01.78,Default,,0,0,0,,Bhai ne bill bharne ka button
Dialogue: 0,0:00:01.78,0:00:02.23,Default,,0,0,0,,dabaya,
Dialogue: 0,0:00:02.23,0:00:03.56,Default,,0,0,0,,aur karz phir bhi badh gaya.
Dialogue: 0,0:00:03.56,0:00:05.57,Default,,0,0,0,,Button ka naam tha minimum due.
Dialogue: 0,0:00:05.57,0:00:06.46,Default,,0,0,0,,Usne socha,
Dialogue: 0,0:00:06.46,0:00:07.57,Default,,0,0,0,,aaj ka kaam ho gaya.
Dialogue: 0,0:00:07.57,0:00:09.58,Default,,0,0,0,,Asal mein usi raat ek meter
Dialogue: 0,0:00:09.58,0:00:10.47,Default,,0,0,0,,chalu ho gaya.
Dialogue: 0,0:00:10.47,0:00:13.14,Default,,0,0,0,,Woh meter mahine dar mahine chalta
Dialogue: 0,0:00:13.14,0:00:13.59,Default,,0,0,0,,raha,
Dialogue: 0,0:00:13.59,0:00:14.48,Default,,0,0,0,,bilkul chupchaap.
Dialogue: 0,0:00:14.93,0:00:15.58,Default,,0,0,0,,Der raat,
Dialogue: 0,0:00:15.58,0:00:18.50,Default,,0,0,0,,Bhai bistar par phone dekh raha
Dialogue: 0,0:00:18.50,0:00:18.82,Default,,0,0,0,,hai.
Dialogue: 0,0:00:18.82,0:00:20.77,Default,,0,0,0,,Card ki app khuli hai,
Dialogue: 0,0:00:20.77,0:00:22.72,Default,,0,0,0,,upar laal rang mein bill.
Dialogue: 0,0:00:22.72,0:00:24.34,Default,,0,0,0,,Neeche button hain,
Dialogue: 0,0:00:24.34,0:00:26.93,Default,,0,0,0,,total due aur minimum due.
Dialogue: 0,0:00:26.93,0:00:30.83,Default,,0,0,0,,Minimum due wala amount bahut chhota
Dialogue: 0,0:00:30.83,0:00:31.80,Default,,0,0,0,,dikhta hai.
Dialogue: 0,0:00:31.80,0:00:35.37,Default,,0,0,0,,Bhai muskura kar wahi dabata hai.
Dialogue: 0,0:00:35.82,0:00:38.69,Default,,0,0,0,,Kuch mahine baad Behen uska statement
Dialogue: 0,0:00:38.69,0:00:39.41,Default,,0,0,0,,dekhti hai.
Dialogue: 0,0:00:39.41,0:00:41.32,Default,,0,0,0,,Naya kharcha toh usne kiya hi
Dialogue: 0,0:00:41.32,0:00:41.80,Default,,0,0,0,,nahi.
Dialogue: 0,0:00:41.80,0:00:43.72,Default,,0,0,0,,Phir bhi bill pehle se bada
Dialogue: 0,0:00:43.72,0:00:43.96,Default,,0,0,0,,hai.
Dialogue: 0,0:00:43.96,0:00:45.15,Default,,0,0,0,,Behen poochti hai,
Dialogue: 0,0:00:45.15,0:00:47.07,Default,,0,0,0,,tune paisa bhara tha na?
Dialogue: 0,0:00:47.07,0:00:48.02,Default,,0,0,0,,Bhai kehta hai,
Dialogue: 0,0:00:48.02,0:00:48.27,Default,,0,0,0,,haan,
Dialogue: 0,0:00:48.27,0:00:49.22,Default,,0,0,0,,har mahine,
Dialogue: 0,0:00:49.22,0:00:49.94,Default,,0,0,0,,time par.
Dialogue: 0,0:00:50.39,0:00:52.41,Default,,0,0,0,,Toh yahan kuch sawaal uthte hain.
Dialogue: 0,0:00:52.41,0:00:54.65,Default,,0,0,0,,Minimum due bharne par asal mein
Dialogue: 0,0:00:54.65,0:00:55.55,Default,,0,0,0,,hota kya hai?
Dialogue: 0,0:00:55.55,0:00:57.56,Default,,0,0,0,,Bill saalon tak khatam kyun nahi
Dialogue: 0,0:00:57.56,0:00:58.01,Default,,0,0,0,,hota?
Dialogue: 0,0:00:58.01,0:00:59.58,Default,,0,0,0,,Aur card ka byaaj baaki loans
Dialogue: 0,0:00:59.58,0:01:00.92,Default,,0,0,0,,se itna bhaari kyun?
Dialogue: 0,0:01:00.92,0:01:02.72,Default,,0,0,0,,Aaj inhe kahani ke saath,
Dialogue: 0,0:01:02.72,0:01:04.51,Default,,0,0,0,,seedhi bhasha mein samjhenge.
Dialogue: 0,0:01:04.96,0:01:06.86,Default,,0,0,0,,Aur end mein bahar nikalne ka
Dialogue: 0,0:01:06.86,0:01:08.13,Default,,0,0,0,,raasta bhi dekhenge.
Dialogue: 0,0:01:08.13,0:01:09.61,Default,,0,0,0,,Kyunki yeh jaal sirf Bhai ka
Dialogue: 0,0:01:09.61,0:01:10.25,Default,,0,0,0,,nahi hai.
Dialogue: 0,0:01:10.25,0:01:12.15,Default,,0,0,0,,Festive sale ka season hai,
Dialogue: 0,0:01:12.15,0:01:12.58,Default,,0,0,0,,phone,
Dialogue: 0,0:01:12.58,0:01:12.79,Default,,0,0,0,,TV,
Dialogue: 0,0:01:12.79,0:01:13.21,Default,,0,0,0,,fridge,
Dialogue: 0,0:01:13.21,0:01:14.69,Default,,0,0,0,,sab card par aa raha hai.
Dialogue: 0,0:01:14.69,0:01:16.81,Default,,0,0,0,,Isliye yeh kahani shayad aapke ghar
Dialogue: 0,0:01:16.81,0:01:17.44,Default,,0,0,0,,ki bhi hai.
Dialogue: 0,0:01:17.89,0:01:19.66,Default,,0,0,0,,Shuru se shuru karte hain.
Dialogue: 0,0:01:19.66,0:01:21.66,Default,,0,0,0,,Festive sale chal rahi thi.
Dialogue: 0,0:01:21.66,0:01:23.65,Default,,0,0,0,,Bhai ka purana phone slow ho
Dialogue: 0,0:01:23.65,0:01:24.09,Default,,0,0,0,,gaya tha.
Dialogue: 0,0:01:24.09,0:01:25.87,Default,,0,0,0,,Online naya phone dikha,
Dialogue: 0,0:01:25.87,0:01:26.75,Default,,0,0,0,,bada discount,
Dialogue: 0,0:01:26.75,0:01:28.08,Default,,0,0,0,,upar se card offer.
Dialogue: 0,0:01:28.08,0:01:28.97,Default,,0,0,0,,Usne socha,
Dialogue: 0,0:01:28.97,0:01:30.30,Default,,0,0,0,,abhi le leta hoon,
Dialogue: 0,0:01:30.30,0:01:31.85,Default,,0,0,0,,paisa baad mein de dunga.
Dialogue: 0,0:01:32.30,0:01:33.65,Default,,0,0,0,,Yahan tak sab theek tha.
Dialogue: 0,0:01:33.65,0:01:35.44,Default,,0,0,0,,Credit card asal mein bank ka
Dialogue: 0,0:01:35.44,0:01:36.11,Default,,0,0,0,,udhaar hai.
Dialogue: 0,0:01:36.11,0:01:37.23,Default,,0,0,0,,Aap aaj kharchte ho,
Dialogue: 0,0:01:37.23,0:01:39.48,Default,,0,0,0,,bank dukaandaar ko paisa deta hai.
Dialogue: 0,0:01:39.48,0:01:41.72,Default,,0,0,0,,Mahine ke end mein bank statement
Dialogue: 0,0:01:41.72,0:01:42.39,Default,,0,0,0,,bhejta hai.
Dialogue: 0,0:01:42.39,0:01:45.31,Default,,0,0,0,,Statement yaani poore mahine ke kharche
Dialogue: 0,0:01:45.31,0:01:45.98,Default,,0,0,0,,ka hisaab.
Dialogue: 0,0:01:46.43,0:01:47.83,Default,,0,0,0,,Ab ek badhiya cheez samjhiye.
Dialogue: 0,0:01:47.83,0:01:49.62,Default,,0,0,0,,Agar poora bill time par bhar
Dialogue: 0,0:01:49.62,0:01:49.82,Default,,0,0,0,,do,
Dialogue: 0,0:01:49.82,0:01:50.81,Default,,0,0,0,,toh koi byaaj nahi.
Dialogue: 0,0:01:50.81,0:01:53.01,Default,,0,0,0,,Isse interest-free period kehte hain,
Dialogue: 0,0:01:53.01,0:01:54.60,Default,,0,0,0,,yaani muft udhaar ka samay.
Dialogue: 0,0:01:54.60,0:01:56.59,Default,,0,0,0,,Card companies yeh samay 20 se
Dialogue: 0,0:01:56.59,0:01:57.99,Default,,0,0,0,,50 din tak deti hain.
Dialogue: 0,0:01:58.44,0:01:58.93,Default,,0,0,0,,Socho,
Dialogue: 0,0:01:58.93,0:02:01.16,Default,,0,0,0,,bank aapko lagbhag 50 din tak
Dialogue: 0,0:02:01.16,0:02:02.89,Default,,0,0,0,,muft paisa de raha hai.
Dialogue: 0,0:02:02.89,0:02:03.38,Default,,0,0,0,,Na byaaj,
Dialogue: 0,0:02:03.38,0:02:04.12,Default,,0,0,0,,na koi fees.
Dialogue: 0,0:02:04.12,0:02:04.86,Default,,0,0,0,,Bas shart hai,
Dialogue: 0,0:02:04.86,0:02:07.09,Default,,0,0,0,,poora bill time par bharna hai.
Dialogue: 0,0:02:07.09,0:02:08.82,Default,,0,0,0,,Yeh shart hi poore khel ki
Dialogue: 0,0:02:08.82,0:02:09.56,Default,,0,0,0,,chaabi hai,
Dialogue: 0,0:02:09.56,0:02:11.04,Default,,0,0,0,,isko yaad rakhiyega.
Dialogue: 0,0:02:11.49,0:02:12.73,Default,,0,0,0,,Phir statement aaya.
Dialogue: 0,0:02:12.73,0:02:14.97,Default,,0,0,0,,Bill phone ki keemat jitna tha.
Dialogue: 0,0:02:14.97,0:02:17.46,Default,,0,0,0,,Salary aane mein abhi der thi,
Dialogue: 0,0:02:17.46,0:02:19.45,Default,,0,0,0,,aur ghar ka kiraaya bhi dena
Dialogue: 0,0:02:19.45,0:02:19.70,Default,,0,0,0,,tha.
Dialogue: 0,0:02:19.70,0:02:21.94,Default,,0,0,0,,App ne ek aasaan raasta dikhaya,
Dialogue: 0,0:02:21.94,0:02:22.94,Default,,0,0,0,,minimum due.
Dialogue: 0,0:02:22.94,0:02:24.93,Default,,0,0,0,,Bill ka bas chhota sa hissa.
Dialogue: 0,0:02:25.38,0:02:27.56,Default,,0,0,0,,Minimum due yaani woh chhoti rakam,
Dialogue: 0,0:02:27.56,0:02:29.14,Default,,0,0,0,,jo bhar do toh bank defaulter
Dialogue: 0,0:02:29.14,0:02:30.13,Default,,0,0,0,,nahi bolega.
Dialogue: 0,0:02:30.13,0:02:31.72,Default,,0,0,0,,Late fees nahi lagegi,
Dialogue: 0,0:02:31.72,0:02:33.10,Default,,0,0,0,,account chalta rahega.
Dialogue: 0,0:02:33.10,0:02:33.89,Default,,0,0,0,,Bhai ko laga,
Dialogue: 0,0:02:33.89,0:02:35.48,Default,,0,0,0,,bank khud yeh option de raha
Dialogue: 0,0:02:35.48,0:02:35.67,Default,,0,0,0,,hai.
Dialogue: 0,0:02:35.67,0:02:37.06,Default,,0,0,0,,Toh zaroor safe hoga.
Dialogue: 0,0:02:37.51,0:02:39.18,Default,,0,0,0,,Aur logic samajh bhi aata hai.
Dialogue: 0,0:02:39.18,0:02:40.66,Default,,0,0,0,,Papa hamesha kehte the,
Dialogue: 0,0:02:40.66,0:02:41.76,Default,,0,0,0,,kist time par bharo,
Dialogue: 0,0:02:41.76,0:02:43.06,Default,,0,0,0,,record achha rahega.
Dialogue: 0,0:02:43.06,0:02:43.80,Default,,0,0,0,,Bhai ne socha,
Dialogue: 0,0:02:43.80,0:02:45.47,Default,,0,0,0,,minimum bhi toh time par bhar
Dialogue: 0,0:02:45.47,0:02:46.02,Default,,0,0,0,,raha hoon.
Dialogue: 0,0:02:46.02,0:02:48.24,Default,,0,0,0,,Baaki paisa agle mahine de dunga.
Dialogue: 0,0:02:48.24,0:02:49.35,Default,,0,0,0,,Isme galat kya hai?
Dialogue: 0,0:02:49.80,0:02:51.41,Default,,0,0,0,,Galat woh hai jo app bada
Dialogue: 0,0:02:51.41,0:02:52.62,Default,,0,0,0,,karke nahi likhti.
Dialogue: 0,0:02:52.62,0:02:54.63,Default,,0,0,0,,Jaise hi poora bill nahi bhara,
Dialogue: 0,0:02:54.63,0:02:56.24,Default,,0,0,0,,muft udhaar ka samay khatam.
Dialogue: 0,0:02:56.24,0:02:57.85,Default,,0,0,0,,Sirf baaki paise par nahi,
Dialogue: 0,0:02:57.85,0:02:59.47,Default,,0,0,0,,poore bill par byaaj lagta hai.
Dialogue: 0,0:02:59.47,0:03:01.48,Default,,0,0,0,,Aur aksar kharidaari ke din se
Dialogue: 0,0:03:01.48,0:03:01.68,Default,,0,0,0,,hi.
Dialogue: 0,0:03:02.13,0:03:04.55,Default,,0,0,0,,Matlab Bhai ne jo socha tha,
Dialogue: 0,0:03:04.55,0:03:05.46,Default,,0,0,0,,ulta hua.
Dialogue: 0,0:03:05.46,0:03:06.98,Default,,0,0,0,,Usne socha tha,
Dialogue: 0,0:03:06.98,0:03:10.31,Default,,0,0,0,,baaki rakam par thoda byaaj lagega.
Dialogue: 0,0:03:10.31,0:03:12.74,Default,,0,0,0,,Asal mein naye kharche par bhi
Dialogue: 0,0:03:12.74,0:03:14.86,Default,,0,0,0,,muft samay nahi milta.
Dialogue: 0,0:03:14.86,0:03:17.59,Default,,0,0,0,,Jab tak purana bill saaf nahi,
Dialogue: 0,0:03:17.59,0:03:20.01,Default,,0,0,0,,har nayi swipe par seedha byaaj.
Dialogue: 0,0:03:20.46,0:03:21.49,Default,,0,0,0,,Ab agla sawaal.
Dialogue: 0,0:03:21.49,0:03:23.15,Default,,0,0,0,,Card ka byaaj itna bhaari kyun
Dialogue: 0,0:03:23.15,0:03:23.35,Default,,0,0,0,,hai?
Dialogue: 0,0:03:23.35,0:03:25.21,Default,,0,0,0,,Iske liye pehle Papa ki PPF
Dialogue: 0,0:03:25.21,0:03:26.66,Default,,0,0,0,,wali soch samajhte hain.
Dialogue: 0,0:03:26.66,0:03:28.72,Default,,0,0,0,,Kyunki wahi hamara normal hai,
Dialogue: 0,0:03:28.72,0:03:29.96,Default,,0,0,0,,jis se hum har byaaj ko
Dialogue: 0,0:03:29.96,0:03:30.58,Default,,0,0,0,,naapte hain.
Dialogue: 0,0:03:31.03,0:03:34.47,Default,,0,0,0,,Papa ki almari mein PPF ki
Dialogue: 0,0:03:34.47,0:03:35.62,Default,,0,0,0,,passbook hai.
Dialogue: 0,0:03:35.62,0:03:38.68,Default,,0,0,0,,PPF par lagbhag 7.1 percent saal
Dialogue: 0,0:03:38.68,0:03:40.59,Default,,0,0,0,,ka byaaj milta hai.
Dialogue: 0,0:03:40.59,0:03:44.79,Default,,0,0,0,,Papa ise achha return maante hain.
Dialogue: 0,0:03:44.79,0:03:46.71,Default,,0,0,0,,Ab ulta socho.
Dialogue: 0,0:03:46.71,0:03:49.76,Default,,0,0,0,,Card par aap byaaj lete nahi,
Dialogue: 0,0:03:49.76,0:03:50.91,Default,,0,0,0,,dete ho.
Dialogue: 0,0:03:51.36,0:03:52.84,Default,,0,0,0,,Aur card ka byaaj PPF wale
Dialogue: 0,0:03:52.84,0:03:54.53,Default,,0,0,0,,byaaj se kai guna hota hai.
Dialogue: 0,0:03:54.53,0:03:56.86,Default,,0,0,0,,Statement mein yeh mahine ke hisaab
Dialogue: 0,0:03:56.86,0:03:58.13,Default,,0,0,0,,se likha hota hai.
Dialogue: 0,0:03:58.13,0:04:00.03,Default,,0,0,0,,Mahine ka chhota sa percent,
Dialogue: 0,0:04:00.03,0:04:01.72,Default,,0,0,0,,sunne mein halka lagta hai.
Dialogue: 0,0:04:01.72,0:04:03.21,Default,,0,0,0,,Saal bhar jodo toh aankh khul
Dialogue: 0,0:04:03.21,0:04:03.84,Default,,0,0,0,,jaati hai.
Dialogue: 0,0:04:04.29,0:04:06.51,Default,,0,0,0,,Upar se yeh byaaj compounding wala
Dialogue: 0,0:04:06.51,0:04:06.73,Default,,0,0,0,,hai.
Dialogue: 0,0:04:06.73,0:04:08.72,Default,,0,0,0,,Compounding yaani byaaj par bhi byaaj.
Dialogue: 0,0:04:08.72,0:04:10.49,Default,,0,0,0,,Is mahine jo byaaj laga,
Dialogue: 0,0:04:10.49,0:04:12.49,Default,,0,0,0,,woh agle mahine bill mein jud
Dialogue: 0,0:04:12.49,0:04:12.71,Default,,0,0,0,,gaya.
Dialogue: 0,0:04:12.71,0:04:14.93,Default,,0,0,0,,Agle mahine byaaj us bade bill
Dialogue: 0,0:04:14.93,0:04:15.81,Default,,0,0,0,,par lagega.
Dialogue: 0,0:04:15.81,0:04:18.03,Default,,0,0,0,,Bill har mahine thoda phool jaata
Dialogue: 0,0:04:18.03,0:04:18.25,Default,,0,0,0,,hai.
Dialogue: 0,0:04:18.70,0:04:20.39,Default,,0,0,0,,Socho karz ek balti hai,
Dialogue: 0,0:04:20.39,0:04:22.81,Default,,0,0,0,,jise aap khaali karna chahte ho.
Dialogue: 0,0:04:22.81,0:04:25.23,Default,,0,0,0,,Aap har mahine ek lota paani
Dialogue: 0,0:04:25.23,0:04:26.20,Default,,0,0,0,,nikaalte ho.
Dialogue: 0,0:04:26.20,0:04:28.13,Default,,0,0,0,,Par upar se nal khula hai,
Dialogue: 0,0:04:28.13,0:04:28.86,Default,,0,0,0,,byaaj ka nal.
Dialogue: 0,0:04:28.86,0:04:30.07,Default,,0,0,0,,Jitna nikaalo,
Dialogue: 0,0:04:30.07,0:04:32.00,Default,,0,0,0,,utna wapas aa jaata hai.
Dialogue: 0,0:04:32.00,0:04:34.42,Default,,0,0,0,,Balti kabhi khaali nahi hoti.
Dialogue: 0,0:04:34.87,0:04:37.83,Default,,0,0,0,,Aur abhi kahani khatam nahi hui.
Dialogue: 0,0:04:37.83,0:04:39.71,Default,,0,0,0,,Byaaj aur fees par sarkar GST
Dialogue: 0,0:04:39.71,0:04:40.79,Default,,0,0,0,,bhi leti hai.
Dialogue: 0,0:04:40.79,0:04:43.74,Default,,0,0,0,,GST yaani services par lagne wala
Dialogue: 0,0:04:43.74,0:04:44.01,Default,,0,0,0,,tax.
Dialogue: 0,0:04:44.01,0:04:45.63,Default,,0,0,0,,Card ke byaaj aur fees par
Dialogue: 0,0:04:45.63,0:04:47.24,Default,,0,0,0,,yeh 18 percent hai.
Dialogue: 0,0:04:47.24,0:04:49.39,Default,,0,0,0,,Yaani byaaj ke upar bhi tax.
Dialogue: 0,0:04:49.84,0:04:52.33,Default,,0,0,0,,Ab Bhai ke statement ki lines
Dialogue: 0,0:04:52.33,0:04:52.88,Default,,0,0,0,,padhiye.
Dialogue: 0,0:04:52.88,0:04:54.27,Default,,0,0,0,,Finance charges,
Dialogue: 0,0:04:54.27,0:04:55.10,Default,,0,0,0,,yaani byaaj.
Dialogue: 0,0:04:55.10,0:04:56.48,Default,,0,0,0,,Uske neeche GST.
Dialogue: 0,0:04:56.48,0:04:57.87,Default,,0,0,0,,Kabhi late fees,
Dialogue: 0,0:04:57.87,0:04:58.97,Default,,0,0,0,,uspar phir GST.
Dialogue: 0,0:04:58.97,0:05:01.19,Default,,0,0,0,,Bhai ko laga tha woh phone
Dialogue: 0,0:05:01.19,0:05:03.40,Default,,0,0,0,,ki keemat chuka raha hai.
Dialogue: 0,0:05:03.40,0:05:05.34,Default,,0,0,0,,Asal mein woh byaaj aur tax
Dialogue: 0,0:05:05.34,0:05:06.72,Default,,0,0,0,,chuka raha tha.
Dialogue: 0,0:05:07.17,0:05:09.61,Default,,0,0,0,,Phir ek mahine salary der se
Dialogue: 0,0:05:09.61,0:05:09.86,Default,,0,0,0,,aayi.
Dialogue: 0,0:05:09.86,0:05:11.81,Default,,0,0,0,,Minimum due bhi miss ho gaya.
Dialogue: 0,0:05:11.81,0:05:13.27,Default,,0,0,0,,Ab late fees lagi,
Dialogue: 0,0:05:13.27,0:05:14.49,Default,,0,0,0,,uspar GST laga,
Dialogue: 0,0:05:14.49,0:05:16.20,Default,,0,0,0,,aur byaaj toh chal hi raha
Dialogue: 0,0:05:16.20,0:05:16.44,Default,,0,0,0,,tha.
Dialogue: 0,0:05:16.44,0:05:18.15,Default,,0,0,0,,Thodi si der ne bill aur
Dialogue: 0,0:05:18.15,0:05:19.13,Default,,0,0,0,,bada kar diya.
Dialogue: 0,0:05:19.58,0:05:21.39,Default,,0,0,0,,Aur ek cheez chupchaap hoti hai.
Dialogue: 0,0:05:21.39,0:05:23.89,Default,,0,0,0,,Late payment aapke credit score mein
Dialogue: 0,0:05:23.89,0:05:25.25,Default,,0,0,0,,record ho jaata hai.
Dialogue: 0,0:05:25.25,0:05:27.98,Default,,0,0,0,,Credit score yaani aapki udhaar wali
Dialogue: 0,0:05:27.98,0:05:28.66,Default,,0,0,0,,report card.
Dialogue: 0,0:05:28.66,0:05:30.24,Default,,0,0,0,,Kal ko home loan ya car
Dialogue: 0,0:05:30.24,0:05:31.15,Default,,0,0,0,,loan lena ho,
Dialogue: 0,0:05:31.15,0:05:32.74,Default,,0,0,0,,toh bank yahi dekhta hai.
Dialogue: 0,0:05:33.19,0:05:34.75,Default,,0,0,0,,Ab sabse bada sawaal.
Dialogue: 0,0:05:34.75,0:05:36.98,Default,,0,0,0,,Bhai har mahine paisa bhar raha
Dialogue: 0,0:05:36.98,0:05:37.20,Default,,0,0,0,,hai.
Dialogue: 0,0:05:37.20,0:05:38.98,Default,,0,0,0,,Phir bhi bill khatam kyun nahi
Dialogue: 0,0:05:38.98,0:05:39.43,Default,,0,0,0,,hota?
Dialogue: 0,0:05:39.43,0:05:41.43,Default,,0,0,0,,Iska jawaab chhupa hai is baat
Dialogue: 0,0:05:41.43,0:05:41.65,Default,,0,0,0,,mein,
Dialogue: 0,0:05:41.65,0:05:43.88,Default,,0,0,0,,ki aapka bhara hua paisa jaata
Dialogue: 0,0:05:43.88,0:05:44.55,Default,,0,0,0,,kahan hai.
Dialogue: 0,0:05:45.00,0:05:46.91,Default,,0,0,0,,Jab aap minimum due bharte ho,
Dialogue: 0,0:05:46.91,0:05:49.25,Default,,0,0,0,,bank pehle apna hissa kaatata hai.
Dialogue: 0,0:05:49.25,0:05:49.89,Default,,0,0,0,,Pehle tax,
Dialogue: 0,0:05:49.89,0:05:50.31,Default,,0,0,0,,phir fees,
Dialogue: 0,0:05:50.31,0:05:50.74,Default,,0,0,0,,phir byaaj.
Dialogue: 0,0:05:50.74,0:05:51.59,Default,,0,0,0,,Jo bachta hai,
Dialogue: 0,0:05:51.59,0:05:53.71,Default,,0,0,0,,wahi asli udhaar se kam hota
Dialogue: 0,0:05:53.71,0:05:53.93,Default,,0,0,0,,hai.
Dialogue: 0,0:05:53.93,0:05:56.26,Default,,0,0,0,,Asli udhaar ko principal kehte hain,
Dialogue: 0,0:05:56.26,0:05:58.39,Default,,0,0,0,,yaani jo aapne asal mein kharcha
Dialogue: 0,0:05:58.39,0:05:58.60,Default,,0,0,0,,tha.
Dialogue: 0,0:05:59.05,0:06:00.37,Default,,0,0,0,,Minimum due chhota hai,
Dialogue: 0,0:06:00.37,0:06:01.69,Default,,0,0,0,,aur byaaj ka hissa bada.
Dialogue: 0,0:06:01.69,0:06:03.57,Default,,0,0,0,,Toh principal mein har mahine bas
Dialogue: 0,0:06:03.57,0:06:04.89,Default,,0,0,0,,thoda farak padta hai.
Dialogue: 0,0:06:04.89,0:06:06.58,Default,,0,0,0,,Jaise aap treadmill par daud rahe
Dialogue: 0,0:06:06.58,0:06:06.77,Default,,0,0,0,,ho.
Dialogue: 0,0:06:06.77,0:06:08.46,Default,,0,0,0,,Paseena poora aa raha hai,
Dialogue: 0,0:06:08.46,0:06:09.97,Default,,0,0,0,,par jagah wahi ki wahi.
Dialogue: 0,0:06:10.42,0:06:12.26,Default,,0,0,0,,Kuch banks statement mein yeh bhi
Dialogue: 0,0:06:12.26,0:06:13.18,Default,,0,0,0,,batate hain,
Dialogue: 0,0:06:13.18,0:06:15.49,Default,,0,0,0,,ki sirf minimum bharoge toh bill
Dialogue: 0,0:06:15.49,0:06:16.64,Default,,0,0,0,,kab khatam hoga.
Dialogue: 0,0:06:16.64,0:06:18.48,Default,,0,0,0,,Bhai ne woh line pehli baar
Dialogue: 0,0:06:18.48,0:06:19.40,Default,,0,0,0,,dhyan se padhi.
Dialogue: 0,0:06:19.40,0:06:21.48,Default,,0,0,0,,Jawaab mahino mein nahi tha.
Dialogue: 0,0:06:21.48,0:06:22.86,Default,,0,0,0,,Jawaab saalon mein tha.
Dialogue: 0,0:06:23.31,0:06:23.77,Default,,0,0,0,,Socho,
Dialogue: 0,0:06:23.77,0:06:25.36,Default,,0,0,0,,ek phone jo kuch saal mein
Dialogue: 0,0:06:25.36,0:06:26.73,Default,,0,0,0,,purana ho jaayega.
Dialogue: 0,0:06:26.73,0:06:28.78,Default,,0,0,0,,Uska karz shayad usse bhi lamba
Dialogue: 0,0:06:28.78,0:06:29.47,Default,,0,0,0,,chalega.
Dialogue: 0,0:06:29.47,0:06:30.83,Default,,0,0,0,,Naya phone aa jaayega,
Dialogue: 0,0:06:30.83,0:06:33.11,Default,,0,0,0,,aur purane phone ki kist abhi
Dialogue: 0,0:06:33.11,0:06:34.48,Default,,0,0,0,,bhi chal rahi hogi.
Dialogue: 0,0:06:34.48,0:06:36.76,Default,,0,0,0,,Yahi hai minimum due ka asli
Dialogue: 0,0:06:36.76,0:06:36.99,Default,,0,0,0,,jaal.
Dialogue: 0,0:06:37.44,0:06:39.98,Default,,0,0,0,,Aur is beech zindagi rukti nahi.
Dialogue: 0,0:06:39.98,0:06:42.52,Default,,0,0,0,,Agle mahine Mummy ki dawai,
Dialogue: 0,0:06:42.52,0:06:43.28,Default,,0,0,0,,school ki fees,
Dialogue: 0,0:06:43.28,0:06:44.55,Default,,0,0,0,,shaadi ka shagun.
Dialogue: 0,0:06:44.55,0:06:46.58,Default,,0,0,0,,Thoda aur card par chala gaya.
Dialogue: 0,0:06:46.58,0:06:48.62,Default,,0,0,0,,Purane bill par naya bill chadh
Dialogue: 0,0:06:48.62,0:06:48.87,Default,,0,0,0,,gaya.
Dialogue: 0,0:06:48.87,0:06:51.41,Default,,0,0,0,,Ab minimum due bhi bada dikhne
Dialogue: 0,0:06:51.41,0:06:51.92,Default,,0,0,0,,laga.
Dialogue: 0,0:06:52.37,0:06:54.36,Default,,0,0,0,,Mummy ne chai rakhte hue poocha,
Dialogue: 0,0:06:54.36,0:06:54.80,Default,,0,0,0,,beta,
Dialogue: 0,0:06:54.80,0:06:57.23,Default,,0,0,0,,har mahine paisa kahan ja raha
Dialogue: 0,0:06:57.23,0:06:57.44,Default,,0,0,0,,hai?
Dialogue: 0,0:06:57.44,0:06:59.21,Default,,0,0,0,,Bhai ke paas jawaab nahi tha.
Dialogue: 0,0:06:59.21,0:07:00.54,Default,,0,0,0,,Salary aati thi,
Dialogue: 0,0:07:00.54,0:07:02.30,Default,,0,0,0,,aur pehle hafte mein card mein
Dialogue: 0,0:07:02.30,0:07:03.40,Default,,0,0,0,,chali jaati thi.
Dialogue: 0,0:07:03.40,0:07:05.61,Default,,0,0,0,,Bachat dheere dheere khatam ho gayi.
Dialogue: 0,0:07:06.06,0:07:08.00,Default,,0,0,0,,Yahi sabse badi keemat hai.
Dialogue: 0,0:07:08.00,0:07:09.51,Default,,0,0,0,,Byaaj sirf bank ko nahi ja
Dialogue: 0,0:07:09.51,0:07:09.94,Default,,0,0,0,,raha.
Dialogue: 0,0:07:09.94,0:07:11.88,Default,,0,0,0,,Woh aapki bachat kha raha hai.
Dialogue: 0,0:07:11.88,0:07:13.61,Default,,0,0,0,,Jo paisa SIP mein ja sakta
Dialogue: 0,0:07:13.61,0:07:13.83,Default,,0,0,0,,tha,
Dialogue: 0,0:07:13.83,0:07:15.77,Default,,0,0,0,,emergency fund ban sakta tha,
Dialogue: 0,0:07:15.77,0:07:17.49,Default,,0,0,0,,woh har mahine byaaj mein ud
Dialogue: 0,0:07:17.49,0:07:18.14,Default,,0,0,0,,raha hai.
Dialogue: 0,0:07:18.59,0:07:19.87,Default,,0,0,0,,Toh galti kahan hui?
Dialogue: 0,0:07:19.87,0:07:22.01,Default,,0,0,0,,Galti phone kharidna nahi thi.
Dialogue: 0,0:07:22.01,0:07:23.94,Default,,0,0,0,,Galti thi minimum due ko bill
Dialogue: 0,0:07:23.94,0:07:25.01,Default,,0,0,0,,bharna samajhna.
Dialogue: 0,0:07:25.01,0:07:27.15,Default,,0,0,0,,Minimum due bill bharna nahi hai.
Dialogue: 0,0:07:27.15,0:07:28.86,Default,,0,0,0,,Woh bas bank ko batana hai,
Dialogue: 0,0:07:28.86,0:07:30.79,Default,,0,0,0,,ki main abhi bhaaga nahi hoon.
Dialogue: 0,0:07:31.24,0:07:32.78,Default,,0,0,0,,Ab bahar kaise niklein?
Dialogue: 0,0:07:32.78,0:07:34.10,Default,,0,0,0,,Sabse seedha raasta,
Dialogue: 0,0:07:34.10,0:07:35.20,Default,,0,0,0,,poora bill bharo,
Dialogue: 0,0:07:35.20,0:07:35.64,Default,,0,0,0,,har baar.
Dialogue: 0,0:07:35.64,0:07:36.96,Default,,0,0,0,,Card utna hi chalao,
Dialogue: 0,0:07:36.96,0:07:39.16,Default,,0,0,0,,jitna mahine ke end tak chuka
Dialogue: 0,0:07:39.16,0:07:39.60,Default,,0,0,0,,sako.
Dialogue: 0,0:07:39.60,0:07:41.14,Default,,0,0,0,,Tab woh 50 din tak ka
Dialogue: 0,0:07:41.14,0:07:42.90,Default,,0,0,0,,muft udhaar sach mein aapke kaam
Dialogue: 0,0:07:42.90,0:07:43.56,Default,,0,0,0,,aata hai.
Dialogue: 0,0:07:44.01,0:07:45.76,Default,,0,0,0,,Agar bill bada hai aur ek
Dialogue: 0,0:07:45.76,0:07:47.07,Default,,0,0,0,,saath nahi bhar sakte,
Dialogue: 0,0:07:47.07,0:07:48.81,Default,,0,0,0,,toh use EMI mein badlo.
Dialogue: 0,0:07:48.81,0:07:49.90,Default,,0,0,0,,Bank se baat karo,
Dialogue: 0,0:07:49.90,0:07:51.43,Default,,0,0,0,,ya app mein option dhoondo.
Dialogue: 0,0:07:51.43,0:07:52.96,Default,,0,0,0,,EMI yaani fixed kist,
Dialogue: 0,0:07:52.96,0:07:53.83,Default,,0,0,0,,fixed samay.
Dialogue: 0,0:07:53.83,0:07:54.71,Default,,0,0,0,,Byaaj aksar kam,
Dialogue: 0,0:07:54.71,0:07:55.80,Default,,0,0,0,,aur end kab hoga,
Dialogue: 0,0:07:55.80,0:07:56.89,Default,,0,0,0,,pehle se pata.
Dialogue: 0,0:07:57.34,0:08:00.80,Default,,0,0,0,,Ek aur raasta hai balance transfer.
Dialogue: 0,0:08:00.80,0:08:04.26,Default,,0,0,0,,Yaani purana bill kisi aur card
Dialogue: 0,0:08:04.26,0:08:05.64,Default,,0,0,0,,par shift karna,
Dialogue: 0,0:08:05.64,0:08:08.41,Default,,0,0,0,,jahan kuch samay kam byaaj ho.
Dialogue: 0,0:08:08.41,0:08:11.18,Default,,0,0,0,,Iski fees aur sharten dhyan se
Dialogue: 0,0:08:11.18,0:08:11.87,Default,,0,0,0,,padho.
Dialogue: 0,0:08:11.87,0:08:14.64,Default,,0,0,0,,Warna ek jaal se nikal kar
Dialogue: 0,0:08:14.64,0:08:17.06,Default,,0,0,0,,naye jaal mein pahunch jaoge.
Dialogue: 0,0:08:17.51,0:08:19.47,Default,,0,0,0,,Ya phir personal loan lekar card
Dialogue: 0,0:08:19.47,0:08:21.22,Default,,0,0,0,,ka poora bill ek saath chuka
Dialogue: 0,0:08:21.22,0:08:21.44,Default,,0,0,0,,do.
Dialogue: 0,0:08:21.44,0:08:23.18,Default,,0,0,0,,Personal loan ka byaaj bhi kam
Dialogue: 0,0:08:23.18,0:08:24.06,Default,,0,0,0,,nahi hota,
Dialogue: 0,0:08:24.06,0:08:26.02,Default,,0,0,0,,par aksar card se halka padta
Dialogue: 0,0:08:26.02,0:08:26.24,Default,,0,0,0,,hai.
Dialogue: 0,0:08:26.24,0:08:27.55,Default,,0,0,0,,Aur loan ke baad card ko
Dialogue: 0,0:08:27.55,0:08:29.51,Default,,0,0,0,,phir se bharna shuru mat karo.
Dialogue: 0,0:08:29.96,0:08:31.61,Default,,0,0,0,,Ek chhoti si aadat bhi kaam
Dialogue: 0,0:08:31.61,0:08:32.22,Default,,0,0,0,,aati hai.
Dialogue: 0,0:08:32.22,0:08:34.28,Default,,0,0,0,,Card ka auto-debit poore bill par
Dialogue: 0,0:08:34.28,0:08:34.69,Default,,0,0,0,,lagao,
Dialogue: 0,0:08:34.69,0:08:35.92,Default,,0,0,0,,minimum par nahi.
Dialogue: 0,0:08:35.92,0:08:37.36,Default,,0,0,0,,Behen yahi karti hai,
Dialogue: 0,0:08:37.36,0:08:38.80,Default,,0,0,0,,uska card suvidha hai,
Dialogue: 0,0:08:38.80,0:08:39.42,Default,,0,0,0,,karz nahi.
Dialogue: 0,0:08:39.42,0:08:41.48,Default,,0,0,0,,Yeh investment advice nahi hai,
Dialogue: 0,0:08:41.48,0:08:43.12,Default,,0,0,0,,bas hisaab ki seedhi baat hai.
Dialogue: 0,0:08:43.57,0:08:45.38,Default,,0,0,0,,Kahani ka nichod yeh hai.
Dialogue: 0,0:08:45.38,0:08:47.41,Default,,0,0,0,,Minimum due ek suvidha hai,
Dialogue: 0,0:08:47.41,0:08:48.31,Default,,0,0,0,,raasta nahi.
Dialogue: 0,0:08:48.31,0:08:50.80,Default,,0,0,0,,Woh aaj ki pareshani se bachata
Dialogue: 0,0:08:50.80,0:08:51.02,Default,,0,0,0,,hai,
Dialogue: 0,0:08:51.02,0:08:52.60,Default,,0,0,0,,par kal ka bill bada kar
Dialogue: 0,0:08:52.60,0:08:53.28,Default,,0,0,0,,deta hai.
Dialogue: 0,0:08:53.28,0:08:55.31,Default,,0,0,0,,Jis din poora bill bharna mushkil
Dialogue: 0,0:08:55.31,0:08:55.76,Default,,0,0,0,,lage,
Dialogue: 0,0:08:55.76,0:08:56.67,Default,,0,0,0,,raasta badlo,
Dialogue: 0,0:08:56.67,0:08:57.57,Default,,0,0,0,,button nahi.
Dialogue: 0,0:08:58.02,0:09:00.08,Default,,0,0,0,,Agli video mein ek aur jaal
Dialogue: 0,0:09:00.08,0:09:00.86,Default,,0,0,0,,kholenge,
Dialogue: 0,0:09:00.86,0:09:03.18,Default,,0,0,0,,jo is festive season mein har
Dialogue: 0,0:09:03.18,0:09:04.47,Default,,0,0,0,,jagah dikhta hai.
Dialogue: 0,0:09:04.47,0:09:05.50,Default,,0,0,0,,No cost EMI.
Dialogue: 0,0:09:05.50,0:09:07.04,Default,,0,0,0,,Kya woh sach mein no cost
Dialogue: 0,0:09:07.04,0:09:07.82,Default,,0,0,0,,hota hai?
Dialogue: 0,0:09:07.82,0:09:10.14,Default,,0,0,0,,Tab tak apna card statement dhyan
Dialogue: 0,0:09:10.14,0:09:10.91,Default,,0,0,0,,se padhiye,
Dialogue: 0,0:09:10.91,0:09:12.46,Default,,0,0,0,,khaaskar chhote akshar.
Dialogue: 0,0:09:12.91,0:09:13.79,Default,,0,0,0,,Ab aap batao,
Dialogue: 0,0:09:13.79,0:09:15.34,Default,,0,0,0,,comments mein seedha jawaab.
Dialogue: 0,0:09:15.34,0:09:17.77,Default,,0,0,0,,Aapne kabhi sirf minimum due bhara
Dialogue: 0,0:09:17.77,0:09:18.00,Default,,0,0,0,,hai?
Dialogue: 0,0:09:18.00,0:09:18.66,Default,,0,0,0,,Haan ya na,
Dialogue: 0,0:09:18.66,0:09:19.76,Default,,0,0,0,,bas itna likh do.
Dialogue: 0,0:09:19.76,0:09:22.20,Default,,0,0,0,,Kisi ki aisi kahani pata ho,
Dialogue: 0,0:09:22.20,0:09:23.30,Default,,0,0,0,,toh woh bhi likhna,
Dialogue: 0,0:09:23.30,0:09:24.63,Default,,0,0,0,,doosron ke kaam aayegi.
