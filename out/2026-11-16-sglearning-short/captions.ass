Dialogue: 0,0:00:00.00,0:00:01.96,Default,,0,0,0,,Jis share ko sab khareed rahe
Dialogue: 0,0:00:01.96,0:00:02.18,Default,,0,0,0,,hon,
Dialogue: 0,0:00:02.18,0:00:03.92,Default,,0,0,0,,wahi sabse khatarnak kyun?
Dialogue: 0,0:00:04.37,0:00:06.63,Default,,0,0,0,,Ketan Parekh ke chune share roz
Dialogue: 0,0:00:06.63,0:00:07.53,Default,,0,0,0,,chadh rahe the.
Dialogue: 0,0:00:07.98,0:00:08.87,Default,,0,0,0,,Sab sochte,
Dialogue: 0,0:00:08.87,0:00:10.94,Default,,0,0,0,,itne log galat kaise?
Dialogue: 0,0:00:11.39,0:00:13.27,Default,,0,0,0,,Bhai ne bhi FD tod di.
Dialogue: 0,0:00:13.72,0:00:14.47,Default,,0,0,0,,Lekin twist:
Dialogue: 0,0:00:14.47,0:00:16.71,Default,,0,0,0,,yeh tezi udhaar ke paise se
Dialogue: 0,0:00:16.71,0:00:16.96,Default,,0,0,0,,thi.
Dialogue: 0,0:00:17.41,0:00:18.33,Default,,0,0,0,,Reportedly,
Dialogue: 0,0:00:18.33,0:00:20.62,Default,,0,0,0,,Madhavpura bank ki 50,000 logon ki
Dialogue: 0,0:00:20.62,0:00:22.69,Default,,0,0,0,,bachat broker ko ja rahi thi.
Dialogue: 0,0:00:23.14,0:00:24.18,Default,,0,0,0,,Craze toota,
Dialogue: 0,0:00:24.18,0:00:25.22,Default,,0,0,0,,share gire,
Dialogue: 0,0:00:25.22,0:00:27.30,Default,,0,0,0,,bank ke bahar line lag gayi.
Dialogue: 0,0:00:27.75,0:00:29.46,Default,,0,0,0,,Jo share sab khareedein,
Dialogue: 0,0:00:29.46,0:00:30.44,Default,,0,0,0,,wahan poochiye,
Dialogue: 0,0:00:30.44,0:00:32.15,Default,,0,0,0,,peeche kiska paisa hai?
Dialogue: 0,0:00:32.60,0:00:33.49,Default,,0,0,0,,Aaj bank doobe,
Dialogue: 0,0:00:33.49,0:00:35.06,Default,,0,0,0,,toh bhi 5 lakh tak wapas
Dialogue: 0,0:00:35.06,0:00:35.73,Default,,0,0,0,,milta hai.
Dialogue: 0,0:00:35.73,0:00:38.41,Default,,0,0,0,,Emergency bachat isi had mein rakhiye.
Dialogue: 0,0:00:38.41,0:00:40.64,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:41.09,0:00:42.80,Default,,0,0,0,,Us dost ko bhejo jo kehta
Dialogue: 0,0:00:42.80,0:00:43.02,Default,,0,0,0,,hai,
Dialogue: 0,0:00:43.02,0:00:44.73,Default,,0,0,0,,sab le rahe hain toh safe.
