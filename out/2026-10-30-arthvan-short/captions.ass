Dialogue: 0,0:00:00.00,0:00:01.56,Default,,0,0,0,,Kya patthar ke khambe sur gaa
Dialogue: 0,0:00:01.56,0:00:02.15,Default,,0,0,0,,sakte hain?
Dialogue: 0,0:00:02.15,0:00:05.48,Default,,0,0,0,,Portuguese vyapari Domingo Paes ne Vijayanagara
Dialogue: 0,0:00:05.48,0:00:07.24,Default,,0,0,0,,ko Rome jitna bada likha.
Dialogue: 0,0:00:07.69,0:00:10.06,Default,,0,0,0,,Isi sheher Hampi mein Vittala mandir
Dialogue: 0,0:00:10.06,0:00:10.26,Default,,0,0,0,,hai.
Dialogue: 0,0:00:10.26,0:00:11.64,Default,,0,0,0,,Lok kahani kehti hai,
Dialogue: 0,0:00:11.64,0:00:13.22,Default,,0,0,0,,iske khambe sa re ga ma
Dialogue: 0,0:00:13.22,0:00:14.01,Default,,0,0,0,,bajate hain.
Dialogue: 0,0:00:14.46,0:00:16.93,Default,,0,0,0,,ASI yaani desh ki puratattva sanstha.
Dialogue: 0,0:00:16.93,0:00:18.38,Default,,0,0,0,,Uske records kehte hain,
Dialogue: 0,0:00:18.38,0:00:20.64,Default,,0,0,0,,mandir Raja Deva Raya ke zamane
Dialogue: 0,0:00:20.64,0:00:21.26,Default,,0,0,0,,mein bana.
Dialogue: 0,0:00:21.71,0:00:23.26,Default,,0,0,0,,Phir ek kahani chali,
Dialogue: 0,0:00:23.26,0:00:25.03,Default,,0,0,0,,Angrezon ne khambe kaate,
Dialogue: 0,0:00:25.03,0:00:26.36,Default,,0,0,0,,andar dhaatu dhoondhne.
Dialogue: 0,0:00:26.36,0:00:28.79,Default,,0,0,0,,Iska koi pakka sabut nahi milta.
Dialogue: 0,0:00:29.24,0:00:30.74,Default,,0,0,0,,ASI ke mutabik,
Dialogue: 0,0:00:30.74,0:00:33.74,Default,,0,0,0,,1565 mein sultanate ki fauj ne
Dialogue: 0,0:00:33.74,0:00:34.99,Default,,0,0,0,,rajdhani loot li.
Dialogue: 0,0:00:34.99,0:00:37.49,Default,,0,0,0,,Toote khambe usi loot aur mausam
Dialogue: 0,0:00:37.49,0:00:38.24,Default,,0,0,0,,ki maar hain.
Dialogue: 0,0:00:38.69,0:00:41.33,Default,,0,0,0,,Indira Gandhi Centre for Atomic Research
Dialogue: 0,0:00:41.33,0:00:42.76,Default,,0,0,0,,ne ultrasonic jaanch ki.
Dialogue: 0,0:00:42.76,0:00:44.99,Default,,0,0,0,,Yaani awaaz ki tarangon se patthar
Dialogue: 0,0:00:44.99,0:00:46.01,Default,,0,0,0,,ke andar jhaankna.
Dialogue: 0,0:00:46.01,0:00:48.45,Default,,0,0,0,,Khambe poori tarah thos granite nikle.
Dialogue: 0,0:00:48.90,0:00:50.02,Default,,0,0,0,,Ab sawaal yeh hai.
Dialogue: 0,0:00:50.02,0:00:51.37,Default,,0,0,0,,Kuch scholars kehte hain,
Dialogue: 0,0:00:51.37,0:00:53.84,Default,,0,0,0,,kaarigaron ne khambe jaan-boojh kar sur
Dialogue: 0,0:00:53.84,0:00:54.74,Default,,0,0,0,,mein tune kiye.
Dialogue: 0,0:00:55.19,0:00:56.32,Default,,0,0,0,,Doosre kehte hain,
Dialogue: 0,0:00:56.32,0:00:58.35,Default,,0,0,0,,bas alag motai aur lambai se
Dialogue: 0,0:00:58.35,0:00:59.92,Default,,0,0,0,,alag awaaz aati hai.
Dialogue: 0,0:00:59.92,0:01:01.50,Default,,0,0,0,,Asli tareeka kya tha,
Dialogue: 0,0:01:01.50,0:01:02.63,Default,,0,0,0,,koi nahi jaanta.
Dialogue: 0,0:01:03.08,0:01:04.84,Default,,0,0,0,,Sheher ke size par bhi bahas
Dialogue: 0,0:01:04.84,0:01:05.03,Default,,0,0,0,,hai.
Dialogue: 0,0:01:05.03,0:01:07.37,Default,,0,0,0,,Historian Tertius Chandler ise Beijing ke
Dialogue: 0,0:01:07.37,0:01:08.94,Default,,0,0,0,,baad sabse bada maante the.
Dialogue: 0,0:01:08.94,0:01:10.89,Default,,0,0,0,,Landscape archaeologists kehte hain,
Dialogue: 0,0:01:10.89,0:01:12.84,Default,,0,0,0,,anumaan bahut alag-alag hain.
Dialogue: 0,0:01:13.29,0:01:13.96,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:01:13.96,0:01:17.08,Default,,0,0,0,,ASI ne 2008 mein khambe thapthapana
Dialogue: 0,0:01:17.08,0:01:17.75,Default,,0,0,0,,band kar diya.
Dialogue: 0,0:01:17.75,0:01:20.64,Default,,0,0,0,,Taaki purana granite andar se kamzor
Dialogue: 0,0:01:20.64,0:01:21.09,Default,,0,0,0,,na ho.
Dialogue: 0,0:01:21.54,0:01:22.52,Default,,0,0,0,,Aaj Hampi jaaiye,
Dialogue: 0,0:01:22.52,0:01:25.47,Default,,0,0,0,,Vittala mandir ka mandap apni aankhon
Dialogue: 0,0:01:25.47,0:01:26.20,Default,,0,0,0,,se dekhiye.
Dialogue: 0,0:01:26.20,0:01:28.90,Default,,0,0,0,,Chup khambe bhi kahani sunaate hain.
Dialogue: 0,0:01:29.35,0:01:30.71,Default,,0,0,0,,Aapko kya lagta hai,
Dialogue: 0,0:01:30.71,0:01:32.75,Default,,0,0,0,,sur jaan-boojh kar bane ya sanyog
Dialogue: 0,0:01:32.75,0:01:32.98,Default,,0,0,0,,tha?
Dialogue: 0,0:01:32.98,0:01:34.11,Default,,0,0,0,,Comment mein likhiye.
