Dialogue: 0,0:00:00.00,0:00:01.23,Default,,0,0,0,,Shakuni ka badla,
Dialogue: 0,0:00:01.23,0:00:03.06,Default,,0,0,0,,Mahabharat ke text mein hai hi
Dialogue: 0,0:00:03.06,0:00:03.47,Default,,0,0,0,,nahi?
Dialogue: 0,0:00:03.47,0:00:05.72,Default,,0,0,0,,Jis kahani ne Shakuni ko hero
Dialogue: 0,0:00:05.72,0:00:06.74,Default,,0,0,0,,jaisa bana diya,
Dialogue: 0,0:00:06.74,0:00:08.57,Default,,0,0,0,,woh purane text mein milti hi
Dialogue: 0,0:00:08.57,0:00:08.98,Default,,0,0,0,,nahi.
Dialogue: 0,0:00:08.98,0:00:10.01,Default,,0,0,0,,Toh aayi kahan se?
Dialogue: 0,0:00:10.46,0:00:13.01,Default,,0,0,0,,Aapne yeh kahani zaroor suni hogi.
Dialogue: 0,0:00:13.01,0:00:15.35,Default,,0,0,0,,Shakuni ka poora parivaar qaid mein
Dialogue: 0,0:00:15.35,0:00:16.20,Default,,0,0,0,,bhookha mara.
Dialogue: 0,0:00:16.20,0:00:17.91,Default,,0,0,0,,Aur Shakuni ne kasam khayi,
Dialogue: 0,0:00:17.91,0:00:19.82,Default,,0,0,0,,Kuru vansh ko andar se khatam
Dialogue: 0,0:00:19.82,0:00:20.46,Default,,0,0,0,,karunga.
Dialogue: 0,0:00:20.46,0:00:22.16,Default,,0,0,0,,Kitni bhayanak kasam hai na?
Dialogue: 0,0:00:22.61,0:00:24.81,Default,,0,0,0,,Kahani yahan nahi rukti.
Dialogue: 0,0:00:24.81,0:00:27.50,Default,,0,0,0,,Kehte hain uske pasey uske pita
Dialogue: 0,0:00:27.50,0:00:29.21,Default,,0,0,0,,ki haddiyon se bane the.
Dialogue: 0,0:00:29.21,0:00:30.67,Default,,0,0,0,,Jo Shakuni bolta,
Dialogue: 0,0:00:30.67,0:00:31.65,Default,,0,0,0,,wahi girta.
Dialogue: 0,0:00:31.65,0:00:33.85,Default,,0,0,0,,Rongte khade ho jaate hain na?
Dialogue: 0,0:00:33.85,0:00:34.82,Default,,0,0,0,,Par sach kya hai?
Dialogue: 0,0:00:35.27,0:00:36.77,Default,,0,0,0,,Lekin yahan twist hai.
Dialogue: 0,0:00:36.77,0:00:39.53,Default,,0,0,0,,Sabse jaanche-parkhe Sanskrit text mein yeh
Dialogue: 0,0:00:39.53,0:00:42.03,Default,,0,0,0,,qaid wali kahani hai hi nahi.
Dialogue: 0,0:00:42.03,0:00:45.03,Default,,0,0,0,,Wahan toh Shakuni ke pita Subala
Dialogue: 0,0:00:45.03,0:00:46.28,Default,,0,0,0,,zinda dikhte hain,
Dialogue: 0,0:00:46.28,0:00:48.28,Default,,0,0,0,,shahi samaroh mein baithe.
Dialogue: 0,0:00:48.73,0:00:50.69,Default,,0,0,0,,Aur mitti bhi kuch keh rahi
Dialogue: 0,0:00:50.69,0:00:50.94,Default,,0,0,0,,hai.
Dialogue: 0,0:00:50.94,0:00:53.39,Default,,0,0,0,,Hastinapur ki khudai mein khel ke
Dialogue: 0,0:00:53.39,0:00:55.10,Default,,0,0,0,,purane mohre mile.
Dialogue: 0,0:00:55.10,0:00:58.04,Default,,0,0,0,,Gandhar ki purani raajdhani bhi mili.
Dialogue: 0,0:00:58.04,0:00:59.75,Default,,0,0,0,,Toh kahani aur sabut,
Dialogue: 0,0:00:59.75,0:01:00.98,Default,,0,0,0,,kahan milte hain?
Dialogue: 0,0:01:01.43,0:01:02.97,Default,,0,0,0,,Is video mein har baat par
Dialogue: 0,0:01:02.97,0:01:04.08,Default,,0,0,0,,label milega.
Dialogue: 0,0:01:04.08,0:01:05.18,Default,,0,0,0,,Kya scripture hai,
Dialogue: 0,0:01:05.18,0:01:06.06,Default,,0,0,0,,kya lokkatha,
Dialogue: 0,0:01:06.06,0:01:07.83,Default,,0,0,0,,aur kahan vidvaan ladte hain.
Dialogue: 0,0:01:07.83,0:01:08.93,Default,,0,0,0,,Par pehle chaliye,
Dialogue: 0,0:01:08.93,0:01:11.14,Default,,0,0,0,,us sabha mein jahan pasey phenke
Dialogue: 0,0:01:11.14,0:01:11.36,Default,,0,0,0,,gaye.
Dialogue: 0,0:01:11.81,0:01:14.27,Default,,0,0,0,,Mahabharat ka ek hissa hai,
Dialogue: 0,0:01:14.27,0:01:15.37,Default,,0,0,0,,Sabha Parva.
Dialogue: 0,0:01:15.37,0:01:17.02,Default,,0,0,0,,Parva yaani adhyaay,
Dialogue: 0,0:01:17.02,0:01:18.39,Default,,0,0,0,,ek bada chapter.
Dialogue: 0,0:01:18.39,0:01:20.86,Default,,0,0,0,,Isi chapter mein woh khel hota
Dialogue: 0,0:01:20.86,0:01:21.13,Default,,0,0,0,,hai,
Dialogue: 0,0:01:21.13,0:01:24.15,Default,,0,0,0,,jisne poori kahani ka rukh badal
Dialogue: 0,0:01:24.15,0:01:24.42,Default,,0,0,0,,diya.
Dialogue: 0,0:01:24.42,0:01:24.97,Default,,0,0,0,,Kaise?
Dialogue: 0,0:01:25.42,0:01:27.55,Default,,0,0,0,,Hastinapur ka mahal.
Dialogue: 0,0:01:27.55,0:01:30.28,Default,,0,0,0,,Saamne Duryodhan aur Kaurav bhai.
Dialogue: 0,0:01:30.28,0:01:33.33,Default,,0,0,0,,Unke saamne Yudhishthir aur Pandav.
Dialogue: 0,0:01:33.33,0:01:35.45,Default,,0,0,0,,Beech mein pasey ka takhta.
Dialogue: 0,0:01:35.45,0:01:38.80,Default,,0,0,0,,Aur Duryodhan ki jagah pasey phenkta
Dialogue: 0,0:01:38.80,0:01:40.32,Default,,0,0,0,,hai uska mama,
Dialogue: 0,0:01:40.32,0:01:41.23,Default,,0,0,0,,Shakuni.
Dialogue: 0,0:01:41.68,0:01:43.03,Default,,0,0,0,,Shakuni kaun tha?
Dialogue: 0,0:01:43.03,0:01:44.66,Default,,0,0,0,,Gandhar ka rajkumar,
Dialogue: 0,0:01:44.66,0:01:46.82,Default,,0,0,0,,raja Subala ka beta.
Dialogue: 0,0:01:46.82,0:01:48.44,Default,,0,0,0,,Aur Gandhari ka bhai,
Dialogue: 0,0:01:48.44,0:01:51.15,Default,,0,0,0,,yaani Duryodhan ka sagaa mama.
Dialogue: 0,0:01:51.15,0:01:52.50,Default,,0,0,0,,Rishta ghar ka tha,
Dialogue: 0,0:01:52.50,0:01:54.13,Default,,0,0,0,,par khel dushmani ka.
Dialogue: 0,0:01:54.13,0:01:55.21,Default,,0,0,0,,Dilchasp hai na?
Dialogue: 0,0:01:55.66,0:01:58.36,Default,,0,0,0,,Text mein Shakuni Duryodhan ka salaahkaar
Dialogue: 0,0:01:58.36,0:01:58.58,Default,,0,0,0,,hai,
Dialogue: 0,0:01:58.58,0:02:00.38,Default,,0,0,0,,pasey ka mahir khiladi.
Dialogue: 0,0:02:00.38,0:02:02.62,Default,,0,0,0,,Yudhishthir ko khel se inkaar karna
Dialogue: 0,0:02:02.62,0:02:03.52,Default,,0,0,0,,nahi aata.
Dialogue: 0,0:02:03.52,0:02:06.22,Default,,0,0,0,,Aur Duryodhan ko yahi kamzori chahiye
Dialogue: 0,0:02:06.22,0:02:06.44,Default,,0,0,0,,thi.
Dialogue: 0,0:02:06.44,0:02:07.57,Default,,0,0,0,,Jaal bichh chuka tha.
Dialogue: 0,0:02:08.02,0:02:09.16,Default,,0,0,0,,Daav lagte hain.
Dialogue: 0,0:02:09.16,0:02:10.02,Default,,0,0,0,,Pehle dhan,
Dialogue: 0,0:02:10.02,0:02:10.88,Default,,0,0,0,,phir sona,
Dialogue: 0,0:02:10.88,0:02:12.31,Default,,0,0,0,,phir rath aur ghode.
Dialogue: 0,0:02:12.31,0:02:14.88,Default,,0,0,0,,Har baar pasey Shakuni ke haq
Dialogue: 0,0:02:14.88,0:02:16.03,Default,,0,0,0,,mein girte hain.
Dialogue: 0,0:02:16.03,0:02:18.89,Default,,0,0,0,,Sabha mein sannata chha jaata hai.
Dialogue: 0,0:02:18.89,0:02:21.47,Default,,0,0,0,,Kisi ko yakeen nahi hota.
Dialogue: 0,0:02:21.92,0:02:24.63,Default,,0,0,0,,Phir Yudhishthir apna rajya haar jaate
Dialogue: 0,0:02:24.63,0:02:24.88,Default,,0,0,0,,hain.
Dialogue: 0,0:02:24.88,0:02:25.87,Default,,0,0,0,,Phir apne bhai.
Dialogue: 0,0:02:25.87,0:02:26.86,Default,,0,0,0,,Phir khud ko bhi.
Dialogue: 0,0:02:26.86,0:02:27.35,Default,,0,0,0,,Socho,
Dialogue: 0,0:02:27.35,0:02:29.33,Default,,0,0,0,,ek raja jo apne aap ko
Dialogue: 0,0:02:29.33,0:02:30.56,Default,,0,0,0,,daav par laga de.
Dialogue: 0,0:02:30.56,0:02:32.54,Default,,0,0,0,,Aur phir bhi khel nahi rukta.
Dialogue: 0,0:02:32.99,0:02:34.79,Default,,0,0,0,,Aur phir sabse kaala pal.
Dialogue: 0,0:02:34.79,0:02:37.36,Default,,0,0,0,,Draupadi ko daav par lagaya jaata
Dialogue: 0,0:02:37.36,0:02:37.61,Default,,0,0,0,,hai.
Dialogue: 0,0:02:37.61,0:02:39.41,Default,,0,0,0,,Woh bhi haar di jaati hai.
Dialogue: 0,0:02:39.41,0:02:42.50,Default,,0,0,0,,Mahabharat ke sabse dardnaak drishyon mein
Dialogue: 0,0:02:42.50,0:02:43.53,Default,,0,0,0,,se yeh ek hai.
Dialogue: 0,0:02:43.97,0:02:46.40,Default,,0,0,0,,Is poore khel mein Shakuni kya
Dialogue: 0,0:02:46.40,0:02:46.66,Default,,0,0,0,,hai?
Dialogue: 0,0:02:46.66,0:02:49.09,Default,,0,0,0,,Text mein woh Duryodhan ka chaalaak
Dialogue: 0,0:02:49.09,0:02:50.16,Default,,0,0,0,,salaahkaar hai.
Dialogue: 0,0:02:50.16,0:02:51.51,Default,,0,0,0,,Chaal chalne wala,
Dialogue: 0,0:02:51.51,0:02:52.85,Default,,0,0,0,,pasey ka mahir.
Dialogue: 0,0:02:52.85,0:02:55.00,Default,,0,0,0,,Par badle ki koi gupt kasam?
Dialogue: 0,0:02:55.00,0:02:56.89,Default,,0,0,0,,Woh kahin nahi dikhti.
Dialogue: 0,0:02:57.34,0:02:58.77,Default,,0,0,0,,Toh sawaal uthta hai.
Dialogue: 0,0:02:58.77,0:03:00.68,Default,,0,0,0,,Agar text mein badla nahi,
Dialogue: 0,0:03:00.68,0:03:03.31,Default,,0,0,0,,toh woh dukhbhari kahani kahan se
Dialogue: 0,0:03:03.31,0:03:03.55,Default,,0,0,0,,aayi?
Dialogue: 0,0:03:03.55,0:03:05.70,Default,,0,0,0,,Jawab chhupa hai gaon ki chaupal
Dialogue: 0,0:03:05.70,0:03:07.13,Default,,0,0,0,,aur natak ke manch par.
Dialogue: 0,0:03:07.13,0:03:08.09,Default,,0,0,0,,Chaliye wahan.
Dialogue: 0,0:03:08.54,0:03:10.59,Default,,0,0,0,,Ab chalte hain lokkatha ki taraf.
Dialogue: 0,0:03:10.59,0:03:13.05,Default,,0,0,0,,Lokkatha yaani woh kahani jo pidhi
Dialogue: 0,0:03:13.05,0:03:14.28,Default,,0,0,0,,dar pidhi sunayi gayi.
Dialogue: 0,0:03:14.28,0:03:15.71,Default,,0,0,0,,Zubaan se zubaan chali,
Dialogue: 0,0:03:15.71,0:03:17.76,Default,,0,0,0,,par purane text mein likhi nahi
Dialogue: 0,0:03:17.76,0:03:18.17,Default,,0,0,0,,mili.
Dialogue: 0,0:03:18.62,0:03:21.08,Default,,0,0,0,,Is kahani mein Gandhari ki shaadi
Dialogue: 0,0:03:21.08,0:03:22.87,Default,,0,0,0,,Dhritarashtra se hoti hai.
Dialogue: 0,0:03:22.87,0:03:24.88,Default,,0,0,0,,Par phir Gandhar ke parivaar par
Dialogue: 0,0:03:24.88,0:03:26.45,Default,,0,0,0,,musibat toot padti hai.
Dialogue: 0,0:03:26.45,0:03:28.91,Default,,0,0,0,,Raja Subala aur unke bete qaid
Dialogue: 0,0:03:28.91,0:03:29.80,Default,,0,0,0,,ho jaate hain.
Dialogue: 0,0:03:30.25,0:03:33.16,Default,,0,0,0,,Kehte hain Dhritarashtra ne unhe kaal-kothri
Dialogue: 0,0:03:33.16,0:03:34.28,Default,,0,0,0,,mein band karwa diya.
Dialogue: 0,0:03:34.28,0:03:36.74,Default,,0,0,0,,Khaane ko bas chawal ke gine-chune
Dialogue: 0,0:03:36.74,0:03:37.19,Default,,0,0,0,,daane.
Dialogue: 0,0:03:37.19,0:03:37.86,Default,,0,0,0,,Itne kam,
Dialogue: 0,0:03:37.86,0:03:39.43,Default,,0,0,0,,ki kisi ka pet bhar hi
Dialogue: 0,0:03:39.43,0:03:40.10,Default,,0,0,0,,na sake.
Dialogue: 0,0:03:40.55,0:03:43.18,Default,,0,0,0,,Tab raja Subala bada faisla karte
Dialogue: 0,0:03:43.18,0:03:43.40,Default,,0,0,0,,hain.
Dialogue: 0,0:03:43.40,0:03:44.72,Default,,0,0,0,,Sab bhookhe rahenge,
Dialogue: 0,0:03:44.72,0:03:47.14,Default,,0,0,0,,par khana sirf Shakuni ko milega.
Dialogue: 0,0:03:47.14,0:03:49.33,Default,,0,0,0,,Kyunki usi ko zinda rehna hai.
Dialogue: 0,0:03:49.33,0:03:49.77,Default,,0,0,0,,Kis liye?
Dialogue: 0,0:03:49.77,0:03:51.09,Default,,0,0,0,,Badla lene ke liye.
Dialogue: 0,0:03:51.54,0:03:53.87,Default,,0,0,0,,Socho us kothri ka manzar.
Dialogue: 0,0:03:53.87,0:03:56.48,Default,,0,0,0,,Bhai bari bari dam todte hain.
Dialogue: 0,0:03:56.48,0:03:58.81,Default,,0,0,0,,Aur Shakuni sab dekhta hai,
Dialogue: 0,0:03:58.81,0:03:59.39,Default,,0,0,0,,chupchaap,
Dialogue: 0,0:03:59.39,0:04:00.84,Default,,0,0,0,,aankhon mein aag liye.
Dialogue: 0,0:04:00.84,0:04:03.75,Default,,0,0,0,,Lokkatha ka asli dard yahin hai.
Dialogue: 0,0:04:04.20,0:04:05.66,Default,,0,0,0,,Lokkatha kehti hai,
Dialogue: 0,0:04:05.66,0:04:08.10,Default,,0,0,0,,Shakuni ko isiliye bachaya gaya.
Dialogue: 0,0:04:08.10,0:04:10.78,Default,,0,0,0,,Taaki woh Hastinapur ke andar reh
Dialogue: 0,0:04:10.78,0:04:11.02,Default,,0,0,0,,kar,
Dialogue: 0,0:04:11.02,0:04:12.97,Default,,0,0,0,,Kuru vansh ko jad se khatam
Dialogue: 0,0:04:12.97,0:04:13.70,Default,,0,0,0,,kar sake.
Dialogue: 0,0:04:13.70,0:04:14.43,Default,,0,0,0,,Ek lamba,
Dialogue: 0,0:04:14.43,0:04:15.65,Default,,0,0,0,,thanda intezaar.
Dialogue: 0,0:04:16.10,0:04:18.56,Default,,0,0,0,,Ab aata hai sabse ajeeb hissa.
Dialogue: 0,0:04:18.56,0:04:20.79,Default,,0,0,0,,Raja Subala ki maut ke baad,
Dialogue: 0,0:04:20.79,0:04:24.00,Default,,0,0,0,,Shakuni unki haddi se pasey banata
Dialogue: 0,0:04:24.00,0:04:24.25,Default,,0,0,0,,hai.
Dialogue: 0,0:04:24.25,0:04:25.97,Default,,0,0,0,,Kuch kehte jaangh ki haddi,
Dialogue: 0,0:04:25.97,0:04:27.21,Default,,0,0,0,,kuch kehte reedh ki.
Dialogue: 0,0:04:27.66,0:04:29.17,Default,,0,0,0,,In paso ki khaasiyat?
Dialogue: 0,0:04:29.17,0:04:31.43,Default,,0,0,0,,Woh Shakuni ka hukm maante the.
Dialogue: 0,0:04:31.43,0:04:32.44,Default,,0,0,0,,Jo woh bolta,
Dialogue: 0,0:04:32.44,0:04:33.45,Default,,0,0,0,,wahi girta.
Dialogue: 0,0:04:33.45,0:04:36.47,Default,,0,0,0,,Isiliye Yudhishthir kabhi jeet hi nahi
Dialogue: 0,0:04:36.47,0:04:36.72,Default,,0,0,0,,paaye.
Dialogue: 0,0:04:36.72,0:04:38.73,Default,,0,0,0,,Kahani yahi kehti hai.
Dialogue: 0,0:04:39.18,0:04:41.91,Default,,0,0,0,,Yeh kahani Amar Chitra Katha jaisi
Dialogue: 0,0:04:41.91,0:04:44.19,Default,,0,0,0,,kitabon ke folklore mein bhi aayi.
Dialogue: 0,0:04:44.19,0:04:46.23,Default,,0,0,0,,Aur yahin se Shakuni ka naya
Dialogue: 0,0:04:46.23,0:04:47.14,Default,,0,0,0,,chehra bana.
Dialogue: 0,0:04:47.14,0:04:48.05,Default,,0,0,0,,Khalnayak nahi,
Dialogue: 0,0:04:48.05,0:04:49.64,Default,,0,0,0,,ek dukhi bhai aur beta.
Dialogue: 0,0:04:50.09,0:04:51.61,Default,,0,0,0,,Lekin label yaad rakhiye,
Dialogue: 0,0:04:51.61,0:04:52.69,Default,,0,0,0,,yeh lokkatha hai.
Dialogue: 0,0:04:52.69,0:04:55.08,Default,,0,0,0,,Iska source koi purana Sanskrit text
Dialogue: 0,0:04:55.08,0:04:55.51,Default,,0,0,0,,nahi.
Dialogue: 0,0:04:55.51,0:04:57.24,Default,,0,0,0,,Toh asli text kya kehta hai?
Dialogue: 0,0:04:57.24,0:04:58.98,Default,,0,0,0,,Wahan twist aur bhi bada hai.
Dialogue: 0,0:04:59.43,0:05:00.71,Default,,0,0,0,,Pehle ek shabd samjho,
Dialogue: 0,0:05:00.71,0:05:01.99,Default,,0,0,0,,critical edition.
Dialogue: 0,0:05:01.99,0:05:04.98,Default,,0,0,0,,Yaani bahut saari purani pandulipiyon ko
Dialogue: 0,0:05:04.98,0:05:06.47,Default,,0,0,0,,mila kar banaya gaya text.
Dialogue: 0,0:05:06.47,0:05:09.25,Default,,0,0,0,,Pandulipi yaani haath se likhi purani
Dialogue: 0,0:05:09.25,0:05:09.68,Default,,0,0,0,,kitab.
Dialogue: 0,0:05:09.68,0:05:11.60,Default,,0,0,0,,Sabse jaancha hua Mahabharat.
Dialogue: 0,0:05:12.05,0:05:14.42,Default,,0,0,0,,Vidvaanon ne alag alag ilaakon ki
Dialogue: 0,0:05:14.42,0:05:15.61,Default,,0,0,0,,pandulipiyan milaayi.
Dialogue: 0,0:05:15.61,0:05:16.99,Default,,0,0,0,,Jo hissa sab mein milta,
Dialogue: 0,0:05:16.99,0:05:17.58,Default,,0,0,0,,woh rakha.
Dialogue: 0,0:05:17.58,0:05:18.97,Default,,0,0,0,,Jo baad mein juda laga,
Dialogue: 0,0:05:18.97,0:05:19.96,Default,,0,0,0,,use alag kiya.
Dialogue: 0,0:05:19.96,0:05:21.74,Default,,0,0,0,,Bilkul detective jaisa kaam.
Dialogue: 0,0:05:22.19,0:05:23.81,Default,,0,0,0,,Aur is text mein Gandhar ke
Dialogue: 0,0:05:23.81,0:05:26.36,Default,,0,0,0,,parivaar ki qaid wali kahani hai
Dialogue: 0,0:05:26.36,0:05:27.05,Default,,0,0,0,,hi nahi.
Dialogue: 0,0:05:27.05,0:05:27.52,Default,,0,0,0,,Na bhookh,
Dialogue: 0,0:05:27.52,0:05:28.44,Default,,0,0,0,,na kaal-kothri,
Dialogue: 0,0:05:28.44,0:05:30.07,Default,,0,0,0,,na haddiyon wale pasey.
Dialogue: 0,0:05:30.07,0:05:30.99,Default,,0,0,0,,Kuch bhi nahi.
Dialogue: 0,0:05:30.99,0:05:31.92,Default,,0,0,0,,Hairaani hui?
Dialogue: 0,0:05:32.37,0:05:32.85,Default,,0,0,0,,Ulta,
Dialogue: 0,0:05:32.85,0:05:35.47,Default,,0,0,0,,text mein raja Subala zinda dikhte
Dialogue: 0,0:05:35.47,0:05:35.71,Default,,0,0,0,,hain.
Dialogue: 0,0:05:35.71,0:05:38.33,Default,,0,0,0,,Woh shahi samarohon mein aate hain,
Dialogue: 0,0:05:38.33,0:05:39.29,Default,,0,0,0,,mehmaan bankar.
Dialogue: 0,0:05:39.29,0:05:41.20,Default,,0,0,0,,Toh jis pita ki haddi se
Dialogue: 0,0:05:41.20,0:05:42.15,Default,,0,0,0,,pasey bane,
Dialogue: 0,0:05:42.15,0:05:43.34,Default,,0,0,0,,woh toh zinda tha?
Dialogue: 0,0:05:43.79,0:05:46.24,Default,,0,0,0,,Yahin kahani palat jaati hai.
Dialogue: 0,0:05:46.24,0:05:48.94,Default,,0,0,0,,Text ka Shakuni ek chaalaak salaahkaar
Dialogue: 0,0:05:48.94,0:05:49.18,Default,,0,0,0,,hai,
Dialogue: 0,0:05:49.18,0:05:50.65,Default,,0,0,0,,Duryodhan ke paksh ka.
Dialogue: 0,0:05:50.65,0:05:53.10,Default,,0,0,0,,Uski chaal mein badla nahi dikhta.
Dialogue: 0,0:05:53.10,0:05:55.31,Default,,0,0,0,,Dikhta hai Duryodhan ka faayda.
Dialogue: 0,0:05:55.76,0:05:57.77,Default,,0,0,0,,Matlab text ke hisaab se Shakuni
Dialogue: 0,0:05:57.77,0:05:59.38,Default,,0,0,0,,ka koi gupt mission nahi tha.
Dialogue: 0,0:05:59.38,0:06:01.39,Default,,0,0,0,,Woh bas apne bhaanje ko jitaana
Dialogue: 0,0:06:01.39,0:06:01.99,Default,,0,0,0,,chahta tha.
Dialogue: 0,0:06:01.99,0:06:02.60,Default,,0,0,0,,Seedhi baat,
Dialogue: 0,0:06:02.60,0:06:04.61,Default,,0,0,0,,lokkatha se bilkul alag tasveer.
Dialogue: 0,0:06:05.06,0:06:07.40,Default,,0,0,0,,Toh kya Mahabharat ki duniya bas
Dialogue: 0,0:06:07.40,0:06:08.34,Default,,0,0,0,,kalpana hai?
Dialogue: 0,0:06:08.34,0:06:09.05,Default,,0,0,0,,Kya pasey,
Dialogue: 0,0:06:09.05,0:06:11.87,Default,,0,0,0,,Hastinapur aur Gandhar sirf kahani ke
Dialogue: 0,0:06:11.87,0:06:12.33,Default,,0,0,0,,naam hain?
Dialogue: 0,0:06:12.33,0:06:14.21,Default,,0,0,0,,Iska jawab text mein nahi,
Dialogue: 0,0:06:14.21,0:06:16.09,Default,,0,0,0,,mitti ke neeche dabaa hai.
Dialogue: 0,0:06:16.54,0:06:18.02,Default,,0,0,0,,Chaliye Hastinapur.
Dialogue: 0,0:06:18.02,0:06:19.25,Default,,0,0,0,,Uttar Pradesh mein,
Dialogue: 0,0:06:19.25,0:06:21.72,Default,,0,0,0,,Ganga ki purani dhaara ke paas,
Dialogue: 0,0:06:21.72,0:06:23.44,Default,,0,0,0,,ek purana teela hai.
Dialogue: 0,0:06:23.44,0:06:25.90,Default,,0,0,0,,Teela yaani mitti ka ooncha dher,
Dialogue: 0,0:06:25.90,0:06:29.11,Default,,0,0,0,,jiske neeche purani bastiyan dabi hoti
Dialogue: 0,0:06:29.11,0:06:29.35,Default,,0,0,0,,hain.
Dialogue: 0,0:06:29.80,0:06:32.10,Default,,0,0,0,,Archaeological Survey of India,
Dialogue: 0,0:06:32.10,0:06:33.02,Default,,0,0,0,,yaani ASI.
Dialogue: 0,0:06:33.02,0:06:34.63,Default,,0,0,0,,Desh ki sarkari sanstha,
Dialogue: 0,0:06:34.63,0:06:37.16,Default,,0,0,0,,jo purani jagahon ki khudai aur
Dialogue: 0,0:06:37.16,0:06:38.31,Default,,0,0,0,,dekhbhaal karti hai.
Dialogue: 0,0:06:38.31,0:06:40.61,Default,,0,0,0,,ASI ki team Hastinapur ke is
Dialogue: 0,0:06:40.61,0:06:41.98,Default,,0,0,0,,teele par pahunchi.
Dialogue: 0,0:06:42.43,0:06:45.93,Default,,0,0,0,,Khudai chali 1950 se 1952 tak.
Dialogue: 0,0:06:45.93,0:06:48.18,Default,,0,0,0,,Mitti ki parat dar parat jaanch
Dialogue: 0,0:06:48.18,0:06:48.43,Default,,0,0,0,,hui.
Dialogue: 0,0:06:48.43,0:06:50.69,Default,,0,0,0,,Har parat ek alag zamana,
Dialogue: 0,0:06:50.69,0:06:52.44,Default,,0,0,0,,jaise kitab ke panne,
Dialogue: 0,0:06:52.44,0:06:54.69,Default,,0,0,0,,neeche wala sabse purana.
Dialogue: 0,0:06:55.13,0:06:57.26,Default,,0,0,0,,Ek parat mein mile Painted Grey
Dialogue: 0,0:06:57.26,0:06:58.44,Default,,0,0,0,,Ware ke bartan.
Dialogue: 0,0:06:58.44,0:07:00.56,Default,,0,0,0,,Yaani saleti rang ke bartan,
Dialogue: 0,0:07:00.56,0:07:02.45,Default,,0,0,0,,jin par kaale rang se design
Dialogue: 0,0:07:02.45,0:07:03.62,Default,,0,0,0,,bane hote the.
Dialogue: 0,0:07:03.62,0:07:05.98,Default,,0,0,0,,Yeh ek khaas purana zamana tha.
Dialogue: 0,0:07:06.43,0:07:08.76,Default,,0,0,0,,Aur isi zamane ki parat mein
Dialogue: 0,0:07:08.76,0:07:09.92,Default,,0,0,0,,mili ek khaas cheez.
Dialogue: 0,0:07:09.92,0:07:11.55,Default,,0,0,0,,Chhoti golakaar tikiyaan,
Dialogue: 0,0:07:11.55,0:07:12.71,Default,,0,0,0,,terracotta ki.
Dialogue: 0,0:07:12.71,0:07:15.51,Default,,0,0,0,,Terracotta yaani aag mein paki mitti.
Dialogue: 0,0:07:15.51,0:07:16.67,Default,,0,0,0,,Inka kaam kya tha?
Dialogue: 0,0:07:17.12,0:07:19.85,Default,,0,0,0,,ASI ke vidvaanon ne inhe kya
Dialogue: 0,0:07:19.85,0:07:20.39,Default,,0,0,0,,maana?
Dialogue: 0,0:07:20.39,0:07:21.48,Default,,0,0,0,,Khel ke mohre.
Dialogue: 0,0:07:21.48,0:07:23.11,Default,,0,0,0,,Yaani gaming counters,
Dialogue: 0,0:07:23.11,0:07:25.29,Default,,0,0,0,,jaise aaj ludo ki gotiyan.
Dialogue: 0,0:07:25.29,0:07:25.84,Default,,0,0,0,,Socho,
Dialogue: 0,0:07:25.84,0:07:28.56,Default,,0,0,0,,Hastinapur ki mitti mein khel ke
Dialogue: 0,0:07:28.56,0:07:29.11,Default,,0,0,0,,mohre!
Dialogue: 0,0:07:29.56,0:07:30.57,Default,,0,0,0,,Par dhyaan rakhiye.
Dialogue: 0,0:07:30.57,0:07:33.11,Default,,0,0,0,,Yeh mohre Shakuni ke nahi hain.
Dialogue: 0,0:07:33.11,0:07:35.65,Default,,0,0,0,,Inpar kisi ka naam nahi likha.
Dialogue: 0,0:07:35.65,0:07:37.68,Default,,0,0,0,,Yeh bas itna batate hain,
Dialogue: 0,0:07:37.68,0:07:39.71,Default,,0,0,0,,ki yahan log khel khelte the.
Dialogue: 0,0:07:40.16,0:07:43.45,Default,,0,0,0,,Matlab khel ki sanskriti Hastinapur mein
Dialogue: 0,0:07:43.45,0:07:43.73,Default,,0,0,0,,thi,
Dialogue: 0,0:07:43.73,0:07:45.37,Default,,0,0,0,,yeh mitti maanti hai.
Dialogue: 0,0:07:45.37,0:07:47.84,Default,,0,0,0,,Lekin pasey ki woh sabha sach
Dialogue: 0,0:07:47.84,0:07:48.39,Default,,0,0,0,,mein hui,
Dialogue: 0,0:07:48.39,0:07:51.14,Default,,0,0,0,,yeh koi khudai sabit nahi karti.
Dialogue: 0,0:07:51.14,0:07:51.96,Default,,0,0,0,,Farq samjhiye.
Dialogue: 0,0:07:52.41,0:07:55.10,Default,,0,0,0,,Toh Hastinapur ka hisaab ho gaya.
Dialogue: 0,0:07:55.10,0:07:56.44,Default,,0,0,0,,Ab doosra sawaal.
Dialogue: 0,0:07:56.44,0:07:57.79,Default,,0,0,0,,Shakuni ka ghar,
Dialogue: 0,0:07:57.79,0:07:58.33,Default,,0,0,0,,Gandhar.
Dialogue: 0,0:07:58.33,0:07:59.94,Default,,0,0,0,,Woh jagah sach mein thi,
Dialogue: 0,0:07:59.94,0:08:02.09,Default,,0,0,0,,ya bas kahani ka ek naam?
Dialogue: 0,0:08:02.09,0:08:03.71,Default,,0,0,0,,Chaliye uttar-pashchim.
Dialogue: 0,0:08:04.16,0:08:04.71,Default,,0,0,0,,Gandhar,
Dialogue: 0,0:08:04.71,0:08:08.58,Default,,0,0,0,,purane Bharat ka uttar-pashchimi ilaaka.
Dialogue: 0,0:08:08.58,0:08:09.14,Default,,0,0,0,,Pahaad,
Dialogue: 0,0:08:09.14,0:08:10.52,Default,,0,0,0,,ghaatiyan aur nadiyan.
Dialogue: 0,0:08:10.52,0:08:12.18,Default,,0,0,0,,Kahani kehti hai,
Dialogue: 0,0:08:12.18,0:08:16.05,Default,,0,0,0,,yahin se Gandhari bahu bankar Hastinapur
Dialogue: 0,0:08:16.05,0:08:16.60,Default,,0,0,0,,aayi thi.
Dialogue: 0,0:08:16.60,0:08:18.54,Default,,0,0,0,,Par mitti kya kehti hai?
Dialogue: 0,0:08:18.99,0:08:21.27,Default,,0,0,0,,Gandhar ki raajdhani mani jaati thi
Dialogue: 0,0:08:21.27,0:08:22.10,Default,,0,0,0,,Takshashila,
Dialogue: 0,0:08:22.10,0:08:23.97,Default,,0,0,0,,jise Taxila bhi kehte hain.
Dialogue: 0,0:08:23.97,0:08:25.83,Default,,0,0,0,,Yahan khudai ki Sir John Marshall
Dialogue: 0,0:08:25.83,0:08:26.04,Default,,0,0,0,,ne,
Dialogue: 0,0:08:26.04,0:08:28.53,Default,,0,0,0,,Archaeological Survey of India ke liye.
Dialogue: 0,0:08:28.98,0:08:32.48,Default,,0,0,0,,Yeh kaam chala 1913 se 1934
Dialogue: 0,0:08:32.48,0:08:32.74,Default,,0,0,0,,tak.
Dialogue: 0,0:08:32.74,0:08:33.28,Default,,0,0,0,,Lambi,
Dialogue: 0,0:08:33.28,0:08:34.36,Default,,0,0,0,,dheemi khudai.
Dialogue: 0,0:08:34.36,0:08:36.78,Default,,0,0,0,,Aur mitti ke neeche se nikli
Dialogue: 0,0:08:36.78,0:08:39.20,Default,,0,0,0,,parat dar parat basi bastiyan.
Dialogue: 0,0:08:39.20,0:08:41.62,Default,,0,0,0,,Ek purana shehar jaag utha.
Dialogue: 0,0:08:42.07,0:08:44.79,Default,,0,0,0,,Sabse purani basti mili Bhir Mound
Dialogue: 0,0:08:44.79,0:08:46.03,Default,,0,0,0,,naam ke teele par.
Dialogue: 0,0:08:46.03,0:08:47.51,Default,,0,0,0,,Wahan gharon ki neev,
Dialogue: 0,0:08:47.51,0:08:48.01,Default,,0,0,0,,galiyan,
Dialogue: 0,0:08:48.01,0:08:50.24,Default,,0,0,0,,aur roz ki zindagi ke nishaan
Dialogue: 0,0:08:50.24,0:08:50.73,Default,,0,0,0,,mile.
Dialogue: 0,0:08:50.73,0:08:52.71,Default,,0,0,0,,Log yahan sach mein rehte the.
Dialogue: 0,0:08:53.16,0:08:55.39,Default,,0,0,0,,Toh Gandhar koi kalpana ka desh
Dialogue: 0,0:08:55.39,0:08:56.13,Default,,0,0,0,,nahi tha.
Dialogue: 0,0:08:56.13,0:08:57.62,Default,,0,0,0,,Woh asli raajya tha,
Dialogue: 0,0:08:57.62,0:08:59.10,Default,,0,0,0,,asli shehron wala.
Dialogue: 0,0:08:59.10,0:09:01.58,Default,,0,0,0,,Yeh ASI ki khudai saaf dikhati
Dialogue: 0,0:09:01.58,0:09:01.83,Default,,0,0,0,,hai.
Dialogue: 0,0:09:01.83,0:09:03.06,Default,,0,0,0,,Ab twist ki baari.
Dialogue: 0,0:09:03.51,0:09:05.22,Default,,0,0,0,,Lekin yahan bhi wahi baat.
Dialogue: 0,0:09:05.22,0:09:07.58,Default,,0,0,0,,Taxila mein Shakuni ka koi nishaan
Dialogue: 0,0:09:07.58,0:09:08.43,Default,,0,0,0,,nahi mila.
Dialogue: 0,0:09:08.43,0:09:09.50,Default,,0,0,0,,Na mahal par naam,
Dialogue: 0,0:09:09.50,0:09:10.57,Default,,0,0,0,,na koi shilalekh.
Dialogue: 0,0:09:10.57,0:09:12.92,Default,,0,0,0,,Shilalekh yaani patthar par likhi baat.
Dialogue: 0,0:09:13.37,0:09:15.03,Default,,0,0,0,,Toh tasveer yeh bani.
Dialogue: 0,0:09:15.03,0:09:16.13,Default,,0,0,0,,Jagah asli,
Dialogue: 0,0:09:16.13,0:09:16.96,Default,,0,0,0,,khel asli,
Dialogue: 0,0:09:16.96,0:09:18.07,Default,,0,0,0,,mohre asli.
Dialogue: 0,0:09:18.07,0:09:20.00,Default,,0,0,0,,Par badle ki kahani?
Dialogue: 0,0:09:20.00,0:09:22.21,Default,,0,0,0,,Uska sabut kahin nahi.
Dialogue: 0,0:09:22.21,0:09:24.42,Default,,0,0,0,,Toh vidvaan aakhir kis baat par
Dialogue: 0,0:09:24.42,0:09:25.25,Default,,0,0,0,,ladte hain?
Dialogue: 0,0:09:25.70,0:09:26.72,Default,,0,0,0,,Pehla jhagda.
Dialogue: 0,0:09:26.72,0:09:29.55,Default,,0,0,0,,Yeh badle wali kahani shuru kab
Dialogue: 0,0:09:29.55,0:09:29.80,Default,,0,0,0,,hui?
Dialogue: 0,0:09:29.80,0:09:31.60,Default,,0,0,0,,Vidvaan isme bant gaye hain.
Dialogue: 0,0:09:31.60,0:09:33.91,Default,,0,0,0,,Aur dono taraf ke tark kaafi
Dialogue: 0,0:09:33.91,0:09:34.68,Default,,0,0,0,,dilchasp hain.
Dialogue: 0,0:09:34.68,0:09:35.71,Default,,0,0,0,,Suniye dhyaan se.
Dialogue: 0,0:09:36.16,0:09:37.48,Default,,0,0,0,,Kuch vidvaan kehte hain,
Dialogue: 0,0:09:37.48,0:09:40.79,Default,,0,0,0,,yeh kahani purani lok-natak parampara se
Dialogue: 0,0:09:40.79,0:09:41.01,Default,,0,0,0,,aayi.
Dialogue: 0,0:09:41.01,0:09:43.44,Default,,0,0,0,,Jaise Tamil Nadu ka Terukkuttu,
Dialogue: 0,0:09:43.44,0:09:44.99,Default,,0,0,0,,gaon ki galiyon mein raat bhar
Dialogue: 0,0:09:44.99,0:09:46.31,Default,,0,0,0,,chalne wala natak.
Dialogue: 0,0:09:46.76,0:09:48.69,Default,,0,0,0,,Ya uttar Bharat ki Nautanki,
Dialogue: 0,0:09:48.69,0:09:50.83,Default,,0,0,0,,jahan gaayak aur kalakaar mele mein
Dialogue: 0,0:09:50.83,0:09:52.11,Default,,0,0,0,,kahani gaate the.
Dialogue: 0,0:09:52.11,0:09:54.68,Default,,0,0,0,,In manchon par kahaniyan badalti rehti
Dialogue: 0,0:09:54.68,0:09:54.89,Default,,0,0,0,,thi,
Dialogue: 0,0:09:54.89,0:09:56.61,Default,,0,0,0,,darshak ke dil ke hisaab se.
Dialogue: 0,0:09:57.06,0:09:58.77,Default,,0,0,0,,Doosre vidvaan kehte hain,
Dialogue: 0,0:09:58.77,0:09:59.26,Default,,0,0,0,,nahi.
Dialogue: 0,0:09:59.26,0:10:01.22,Default,,0,0,0,,Yeh kahani zyada nayi hai.
Dialogue: 0,0:10:01.22,0:10:03.67,Default,,0,0,0,,Aaj ke zamane ke stage natak
Dialogue: 0,0:10:03.67,0:10:05.87,Default,,0,0,0,,aur TV serial ne isse badha
Dialogue: 0,0:10:05.87,0:10:07.10,Default,,0,0,0,,chadha kar failaya.
Dialogue: 0,0:10:07.10,0:10:07.83,Default,,0,0,0,,Kaun sahi?
Dialogue: 0,0:10:08.28,0:10:09.70,Default,,0,0,0,,Unka tark seedha hai.
Dialogue: 0,0:10:09.70,0:10:12.06,Default,,0,0,0,,Purane likhe hue sabut kam hain.
Dialogue: 0,0:10:12.06,0:10:14.18,Default,,0,0,0,,Aur dukhi Shakuni ka chehra,
Dialogue: 0,0:10:14.18,0:10:16.31,Default,,0,0,0,,TV aur natak ke zariye lagbhag
Dialogue: 0,0:10:16.31,0:10:17.73,Default,,0,0,0,,har ghar tak pahuncha.
Dialogue: 0,0:10:18.18,0:10:19.53,Default,,0,0,0,,Ab doosra jhagda,
Dialogue: 0,0:10:19.53,0:10:20.62,Default,,0,0,0,,aur bhi gehra.
Dialogue: 0,0:10:20.62,0:10:22.79,Default,,0,0,0,,Pasey ka khel asal mein tha
Dialogue: 0,0:10:22.79,0:10:23.07,Default,,0,0,0,,kya?
Dialogue: 0,0:10:23.07,0:10:24.15,Default,,0,0,0,,Seedha dhokha,
Dialogue: 0,0:10:24.15,0:10:26.33,Default,,0,0,0,,ya koi purani dharmik rasm?
Dialogue: 0,0:10:26.33,0:10:29.04,Default,,0,0,0,,Yahan bhi vidvaan aamne-saamne hain.
Dialogue: 0,0:10:29.49,0:10:30.66,Default,,0,0,0,,Kuch kehte hain,
Dialogue: 0,0:10:30.66,0:10:32.42,Default,,0,0,0,,yeh saaf chaal-baazi thi.
Dialogue: 0,0:10:32.42,0:10:35.63,Default,,0,0,0,,Ek chaalaak khiladi ne bhole raja
Dialogue: 0,0:10:35.63,0:10:36.51,Default,,0,0,0,,ko haraya,
Dialogue: 0,0:10:36.51,0:10:36.80,Default,,0,0,0,,bas.
Dialogue: 0,0:10:36.80,0:10:39.14,Default,,0,0,0,,Isme koi rahasya nahi,
Dialogue: 0,0:10:39.14,0:10:40.90,Default,,0,0,0,,sirf hunar aur dhokha.
Dialogue: 0,0:10:41.35,0:10:42.58,Default,,0,0,0,,Doosre kehte hain,
Dialogue: 0,0:10:42.58,0:10:45.30,Default,,0,0,0,,isme Vedic Rajasuya yagya ki chhaap
Dialogue: 0,0:10:45.30,0:10:45.54,Default,,0,0,0,,hai.
Dialogue: 0,0:10:45.54,0:10:48.50,Default,,0,0,0,,Rajasuya yaani raja banne ka bada
Dialogue: 0,0:10:48.50,0:10:49.00,Default,,0,0,0,,yagya.
Dialogue: 0,0:10:49.00,0:10:50.97,Default,,0,0,0,,Usme pasey ka khel bhi ek
Dialogue: 0,0:10:50.97,0:10:52.45,Default,,0,0,0,,rasm maani jaati thi.
Dialogue: 0,0:10:52.90,0:10:53.88,Default,,0,0,0,,Aur dilchasp baat,
Dialogue: 0,0:10:53.88,0:10:56.55,Default,,0,0,0,,Yudhishthir ne Rajasuya yagya kiya tha,
Dialogue: 0,0:10:56.55,0:10:58.02,Default,,0,0,0,,Sabha Parva mein hi.
Dialogue: 0,0:10:58.02,0:10:59.96,Default,,0,0,0,,Toh kya pasey ka khel usi
Dialogue: 0,0:10:59.96,0:11:02.40,Default,,0,0,0,,purani parampara ki goonj tha?
Dialogue: 0,0:11:02.85,0:11:03.95,Default,,0,0,0,,Agar yeh sach hai,
Dialogue: 0,0:11:03.95,0:11:06.15,Default,,0,0,0,,toh Shakuni sirf dhokebaaz nahi.
Dialogue: 0,0:11:06.15,0:11:08.35,Default,,0,0,0,,Woh ek purani rasm ka khiladi
Dialogue: 0,0:11:08.35,0:11:08.57,Default,,0,0,0,,hai.
Dialogue: 0,0:11:08.57,0:11:10.11,Default,,0,0,0,,Par yeh bhi tay nahi hua.
Dialogue: 0,0:11:10.11,0:11:11.87,Default,,0,0,0,,Bahas abhi bhi khuli hai.
Dialogue: 0,0:11:12.32,0:11:13.98,Default,,0,0,0,,Ab woh baat jo koi nahi
Dialogue: 0,0:11:13.98,0:11:14.45,Default,,0,0,0,,jaanta.
Dialogue: 0,0:11:14.45,0:11:17.05,Default,,0,0,0,,Badle wali kahani pehli baar kab
Dialogue: 0,0:11:17.05,0:11:18.47,Default,,0,0,0,,aur kahan sunayi gayi?
Dialogue: 0,0:11:18.47,0:11:20.60,Default,,0,0,0,,Kisi ke paas iska saaf jawab
Dialogue: 0,0:11:20.60,0:11:21.07,Default,,0,0,0,,nahi.
Dialogue: 0,0:11:21.07,0:11:22.02,Default,,0,0,0,,Ajeeb hai na?
Dialogue: 0,0:11:22.47,0:11:23.30,Default,,0,0,0,,Kis gaon mein,
Dialogue: 0,0:11:23.30,0:11:25.24,Default,,0,0,0,,kis natak mandali ne,
Dialogue: 0,0:11:25.24,0:11:28.00,Default,,0,0,0,,pehli baar Shakuni ko dukhi bhai
Dialogue: 0,0:11:28.00,0:11:28.56,Default,,0,0,0,,banaya?
Dialogue: 0,0:11:28.56,0:11:29.94,Default,,0,0,0,,Woh pal kho gaya hai.
Dialogue: 0,0:11:29.94,0:11:32.16,Default,,0,0,0,,Jaise hawa mein ud gayi koi
Dialogue: 0,0:11:32.16,0:11:32.43,Default,,0,0,0,,baat.
Dialogue: 0,0:11:32.88,0:11:34.54,Default,,0,0,0,,Aur haddiyon wale pasey?
Dialogue: 0,0:11:34.54,0:11:36.91,Default,,0,0,0,,Unka koi purana likhit roop is
Dialogue: 0,0:11:36.91,0:11:39.52,Default,,0,0,0,,kahani ke sabut mein nahi milta.
Dialogue: 0,0:11:39.52,0:11:42.12,Default,,0,0,0,,Woh kahani zubaan se zubaan chali,
Dialogue: 0,0:11:42.12,0:11:44.26,Default,,0,0,0,,kitabon tak baad mein pahunchi.
Dialogue: 0,0:11:44.71,0:11:47.06,Default,,0,0,0,,Toh Shakuni ka chehra badal gaya
Dialogue: 0,0:11:47.06,0:11:47.29,Default,,0,0,0,,hai.
Dialogue: 0,0:11:47.29,0:11:48.94,Default,,0,0,0,,Text mein chaalaak salaahkaar.
Dialogue: 0,0:11:48.94,0:11:50.35,Default,,0,0,0,,Lokkatha mein dukhi,
Dialogue: 0,0:11:50.35,0:11:51.99,Default,,0,0,0,,badla lene wala bhai.
Dialogue: 0,0:11:51.99,0:11:54.81,Default,,0,0,0,,Dono hamari virasat ka hissa hain.
Dialogue: 0,0:11:54.81,0:11:55.99,Default,,0,0,0,,Par alag alag.
Dialogue: 0,0:11:56.44,0:11:58.09,Default,,0,0,0,,Ab aap khud kya dekh sakte
Dialogue: 0,0:11:58.09,0:11:58.32,Default,,0,0,0,,hain?
Dialogue: 0,0:11:58.32,0:12:01.14,Default,,0,0,0,,Hastinapur ka purana teela aaj bhi
Dialogue: 0,0:12:01.14,0:12:02.56,Default,,0,0,0,,Uttar Pradesh mein hai.
Dialogue: 0,0:12:02.56,0:12:04.91,Default,,0,0,0,,Ganga ki purani dhaara ke paas,
Dialogue: 0,0:12:04.91,0:12:07.03,Default,,0,0,0,,khamosh khada intezaar karta.
Dialogue: 0,0:12:07.48,0:12:09.41,Default,,0,0,0,,Wahan khade ho kar sochiye.
Dialogue: 0,0:12:09.41,0:12:11.83,Default,,0,0,0,,Isi mitti ki paraton se khel
Dialogue: 0,0:12:11.83,0:12:13.27,Default,,0,0,0,,ke mohre nikle the.
Dialogue: 0,0:12:13.27,0:12:14.72,Default,,0,0,0,,Shayad kisi bachche ne,
Dialogue: 0,0:12:14.72,0:12:15.45,Default,,0,0,0,,kisi shaam,
Dialogue: 0,0:12:15.45,0:12:16.65,Default,,0,0,0,,inse khela ho.
Dialogue: 0,0:12:16.65,0:12:18.83,Default,,0,0,0,,Rongte khade karne wali baat.
Dialogue: 0,0:12:19.28,0:12:21.79,Default,,0,0,0,,Mahabharat ki kahaniyan aaj bhi gaon
Dialogue: 0,0:12:21.79,0:12:23.16,Default,,0,0,0,,ke manch par zinda hain.
Dialogue: 0,0:12:23.16,0:12:26.13,Default,,0,0,0,,Kisi mele mein Terukkuttu ya Nautanki
Dialogue: 0,0:12:26.13,0:12:26.58,Default,,0,0,0,,dekhiye.
Dialogue: 0,0:12:26.58,0:12:28.64,Default,,0,0,0,,Shakuni ka kaun sa roop milta
Dialogue: 0,0:12:28.64,0:12:28.87,Default,,0,0,0,,hai,
Dialogue: 0,0:12:28.87,0:12:29.55,Default,,0,0,0,,dhyaan dijiye.
Dialogue: 0,0:12:30.00,0:12:32.45,Default,,0,0,0,,Aur ghar par Mahabharat ka Sabha
Dialogue: 0,0:12:32.45,0:12:33.43,Default,,0,0,0,,Parva padhiye.
Dialogue: 0,0:12:33.43,0:12:34.17,Default,,0,0,0,,Khud dekhiye,
Dialogue: 0,0:12:34.17,0:12:35.88,Default,,0,0,0,,Shakuni kya kehta hai,
Dialogue: 0,0:12:35.88,0:12:36.86,Default,,0,0,0,,kya karta hai.
Dialogue: 0,0:12:36.86,0:12:39.07,Default,,0,0,0,,Tab sabut kisi aur ka nahi,
Dialogue: 0,0:12:39.07,0:12:41.03,Default,,0,0,0,,aapke apne haath mein hoga.
Dialogue: 0,0:12:41.48,0:12:43.14,Default,,0,0,0,,Toh shuruaat ka sawaal yaad hai?
Dialogue: 0,0:12:43.14,0:12:45.63,Default,,0,0,0,,Shakuni ka badla Mahabharat ke text
Dialogue: 0,0:12:45.63,0:12:46.67,Default,,0,0,0,,mein hai ya nahi?
Dialogue: 0,0:12:46.67,0:12:47.50,Default,,0,0,0,,Jawab mil gaya.
Dialogue: 0,0:12:47.50,0:12:48.33,Default,,0,0,0,,Text mein nahi,
Dialogue: 0,0:12:48.33,0:12:49.36,Default,,0,0,0,,lokkatha mein hai.
Dialogue: 0,0:12:49.81,0:12:52.44,Default,,0,0,0,,Lekin isse lokkatha chhoti nahi hoti.
Dialogue: 0,0:12:52.44,0:12:54.26,Default,,0,0,0,,Woh dikhati hai ki log khalnayak
Dialogue: 0,0:12:54.26,0:12:55.47,Default,,0,0,0,,mein bhi dard dhoondhte hain.
Dialogue: 0,0:12:55.47,0:12:58.10,Default,,0,0,0,,Yahi hamari kahaniyon ki asli taakat
Dialogue: 0,0:12:58.10,0:12:58.30,Default,,0,0,0,,hai.
Dialogue: 0,0:12:58.75,0:13:01.53,Default,,0,0,0,,Agle video mein chalenge Kurukshetra.
Dialogue: 0,0:13:01.53,0:13:03.61,Default,,0,0,0,,Woh maidan jahan yeh sab khatam
Dialogue: 0,0:13:03.61,0:13:03.84,Default,,0,0,0,,hua.
Dialogue: 0,0:13:03.84,0:13:05.92,Default,,0,0,0,,Wahan ki mitti kya kehti hai?
Dialogue: 0,0:13:05.92,0:13:06.85,Default,,0,0,0,,Sabut ke saath,
Dialogue: 0,0:13:06.85,0:13:08.01,Default,,0,0,0,,wahin milte hain.
Dialogue: 0,0:13:08.46,0:13:09.95,Default,,0,0,0,,Ab aapki baari.
Dialogue: 0,0:13:09.95,0:13:13.22,Default,,0,0,0,,Aapke hisaab se Shakuni khalnayak tha,
Dialogue: 0,0:13:13.22,0:13:15.01,Default,,0,0,0,,ya badle ka shikaar?
Dialogue: 0,0:13:15.01,0:13:17.39,Default,,0,0,0,,Comment mein bas ek shabd likhiye,
Dialogue: 0,0:13:17.39,0:13:18.88,Default,,0,0,0,,khalnayak ya shikaar.
Dialogue: 0,0:13:18.88,0:13:20.07,Default,,0,0,0,,Main padhunga.
