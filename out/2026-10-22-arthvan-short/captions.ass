Dialogue: 0,0:00:00.00,0:00:00.71,Default,,0,0,0,,Kailash,
Dialogue: 0,0:00:00.71,0:00:03.18,Default,,0,0,0,,woh pahad jis par aaj tak
Dialogue: 0,0:00:03.18,0:00:04.95,Default,,0,0,0,,koi nahi chadha.
Dialogue: 0,0:00:04.95,0:00:05.31,Default,,0,0,0,,Kyon?
Dialogue: 0,0:00:05.31,0:00:08.49,Default,,0,0,0,,Shiva Purana mein yeh Shiv ji
Dialogue: 0,0:00:08.49,0:00:11.32,Default,,0,0,0,,aur Parvati ji ka ghar hai.
Dialogue: 0,0:00:11.77,0:00:14.37,Default,,0,0,0,,Skanda Purana kehta hai,
Dialogue: 0,0:00:14.37,0:00:17.62,Default,,0,0,0,,iske darshan se paap aise mitte
Dialogue: 0,0:00:17.62,0:00:17.95,Default,,0,0,0,,hain,
Dialogue: 0,0:00:17.95,0:00:19.57,Default,,0,0,0,,jaise dhoop mein os.
Dialogue: 0,0:00:20.02,0:00:21.04,Default,,0,0,0,,Ab sabut.
Dialogue: 0,0:00:21.04,0:00:24.45,Default,,0,0,0,,Kailash ke paas Ngari ilaake mein,
Dialogue: 0,0:00:24.45,0:00:27.86,Default,,0,0,0,,1997 mein khudai shuru hui.
Dialogue: 0,0:00:28.31,0:00:31.50,Default,,0,0,0,,Team thi Sichuan University aur Tibet
Dialogue: 0,0:00:31.50,0:00:34.15,Default,,0,0,0,,ke Bureau of Cultural Relics ki.
Dialogue: 0,0:00:34.60,0:00:37.94,Default,,0,0,0,,Piyang-Donggar mein bahut saari gufaayein mili,
Dialogue: 0,0:00:37.94,0:00:40.16,Default,,0,0,0,,jinmein kabhi log rehte the.
Dialogue: 0,0:00:40.61,0:00:43.41,Default,,0,0,0,,Deewaron par Buddhist murals,
Dialogue: 0,0:00:43.41,0:00:46.91,Default,,0,0,0,,yaani purani rangeen tasveerein,
Dialogue: 0,0:00:46.91,0:00:49.01,Default,,0,0,0,,aur kabrein bhi mili.
Dialogue: 0,0:00:49.46,0:00:51.46,Default,,0,0,0,,Kahaniyan kehti hain,
Dialogue: 0,0:00:51.46,0:00:54.13,Default,,0,0,0,,koi anjaan shakti rokti hai.
Dialogue: 0,0:00:54.13,0:00:57.80,Default,,0,0,0,,Par mountaineer Reinhold Messner kehte hain,
Dialogue: 0,0:00:57.80,0:01:00.80,Default,,0,0,0,,6,638 metre ka yeh pahad chadha
Dialogue: 0,0:01:00.80,0:01:02.14,Default,,0,0,0,,ja sakta hai.
Dialogue: 0,0:01:02.59,0:01:04.77,Default,,0,0,0,,Parampara kehti hai,
Dialogue: 0,0:01:04.77,0:01:05.39,Default,,0,0,0,,Indus,
Dialogue: 0,0:01:05.39,0:01:06.01,Default,,0,0,0,,Sutlej,
Dialogue: 0,0:01:06.01,0:01:10.37,Default,,0,0,0,,Brahmaputra aur Karnali Kailash se nikalti
Dialogue: 0,0:01:10.37,0:01:10.68,Default,,0,0,0,,hain.
Dialogue: 0,0:01:10.68,0:01:13.48,Default,,0,0,0,,Paani ke vaigyanik kehte hain,
Dialogue: 0,0:01:13.48,0:01:16.59,Default,,0,0,0,,inke glacier alag ghaatiyon mein hain.
Dialogue: 0,0:01:17.04,0:01:19.73,Default,,0,0,0,,Kuch lekhak ise insaan ka banaya
Dialogue: 0,0:01:19.73,0:01:21.35,Default,,0,0,0,,pyramid kehte hain.
Dialogue: 0,0:01:21.35,0:01:24.04,Default,,0,0,0,,Chattanon ke vaigyanik kehte hain,
Dialogue: 0,0:01:24.04,0:01:25.39,Default,,0,0,0,,yeh kudrati hai,
Dialogue: 0,0:01:25.39,0:01:27.00,Default,,0,0,0,,glaciers ki taraashi.
Dialogue: 0,0:01:27.45,0:01:29.53,Default,,0,0,0,,Tibet ki kahani kehti hai,
Dialogue: 0,0:01:29.53,0:01:32.75,Default,,0,0,0,,yogi Milarepa subah ki kiran pakadkar
Dialogue: 0,0:01:32.75,0:01:34.37,Default,,0,0,0,,choti tak pahunche the.
Dialogue: 0,0:01:34.82,0:01:36.59,Default,,0,0,0,,Asli baat seedhi hai,
Dialogue: 0,0:01:36.59,0:01:39.55,Default,,0,0,0,,chadhne ki permit hi nahi milti,
Dialogue: 0,0:01:39.55,0:01:41.32,Default,,0,0,0,,shraddha ke samman mein.
Dialogue: 0,0:01:41.32,0:01:44.27,Default,,0,0,0,,Aap aaj parikrama kar sakte hain,
Dialogue: 0,0:01:44.27,0:01:46.34,Default,,0,0,0,,pahad ke ird-gird paidal.
Dialogue: 0,0:01:46.79,0:01:50.31,Default,,0,0,0,,Aap Kailash ki parikrama karna chahoge?
Dialogue: 0,0:01:50.31,0:01:52.47,Default,,0,0,0,,Comment mein haan ya na likho.
