Dialogue: 0,0:00:00.00,0:00:03.09,Default,,0,0,0,,Prayagraj ke Hanuman ji khade nahi,
Dialogue: 0,0:00:03.09,0:00:04.50,Default,,0,0,0,,lete hue kyun hain?
Dialogue: 0,0:00:04.50,0:00:05.91,Default,,0,0,0,,Sangam kinare,
Dialogue: 0,0:00:05.91,0:00:07.31,Default,,0,0,0,,zameen ke neeche.
Dialogue: 0,0:00:07.76,0:00:09.39,Default,,0,0,0,,Shiva Purana kehta hai,
Dialogue: 0,0:00:09.39,0:00:12.23,Default,,0,0,0,,Hanuman ne Patala mein asur Mahiravan
Dialogue: 0,0:00:12.23,0:00:12.84,Default,,0,0,0,,ko maara.
Dialogue: 0,0:00:12.84,0:00:13.04,Default,,0,0,0,,Ram,
Dialogue: 0,0:00:13.04,0:00:14.87,Default,,0,0,0,,Lakshman ko surakshit wapas laaye.
Dialogue: 0,0:00:15.32,0:00:16.91,Default,,0,0,0,,Sthaniya katha kehti hai,
Dialogue: 0,0:00:16.91,0:00:19.42,Default,,0,0,0,,thake Hanuman Sita ji ke kehne
Dialogue: 0,0:00:19.42,0:00:21.24,Default,,0,0,0,,par Sangam kinare let gaye.
Dialogue: 0,0:00:21.69,0:00:22.79,Default,,0,0,0,,Ek aur katha,
Dialogue: 0,0:00:22.79,0:00:25.27,Default,,0,0,0,,Kannauj ke bina santaan seth ne
Dialogue: 0,0:00:25.27,0:00:28.30,Default,,0,0,0,,Vindhyachal ke patthar se murti banwayi.
Dialogue: 0,0:00:28.30,0:00:29.40,Default,,0,0,0,,Prayag mein chhodi,
Dialogue: 0,0:00:29.40,0:00:30.50,Default,,0,0,0,,to beta hua.
Dialogue: 0,0:00:30.95,0:00:33.22,Default,,0,0,0,,Baad mein Baba Balagiri ji ko
Dialogue: 0,0:00:33.22,0:00:35.25,Default,,0,0,0,,dhuni khodte waqt murti mili.
Dialogue: 0,0:00:35.25,0:00:37.74,Default,,0,0,0,,Dhuni yaani pooja ki pavitra aag.
Dialogue: 0,0:00:38.19,0:00:39.02,Default,,0,0,0,,Ab sabut.
Dialogue: 0,0:00:39.02,0:00:41.52,Default,,0,0,0,,Paas hi Allahabad Qila hai.
Dialogue: 0,0:00:41.52,0:00:42.07,Default,,0,0,0,,ASI,
Dialogue: 0,0:00:42.07,0:00:45.12,Default,,0,0,0,,yaani sarkari puratatva vibhag,
Dialogue: 0,0:00:45.12,0:00:48.44,Default,,0,0,0,,kehta hai Akbar ne ise 1583
Dialogue: 0,0:00:48.44,0:00:49.27,Default,,0,0,0,,mein banwaya.
Dialogue: 0,0:00:49.72,0:00:52.03,Default,,0,0,0,,Qile mein Ashok stambh par Maurya
Dialogue: 0,0:00:52.03,0:00:53.06,Default,,0,0,0,,kaal ke lekh hain.
Dialogue: 0,0:00:53.06,0:00:53.83,Default,,0,0,0,,Lekin twist,
Dialogue: 0,0:00:53.83,0:00:56.13,Default,,0,0,0,,murti ki koi khudai nahi hui.
Dialogue: 0,0:00:56.59,0:00:59.45,Default,,0,0,0,,Kya murti jaan-boojhkar leti banayi gayi?
Dialogue: 0,0:00:59.45,0:01:00.76,Default,,0,0,0,,Mandir kehta hai,
Dialogue: 0,0:01:00.76,0:01:01.02,Default,,0,0,0,,haan,
Dialogue: 0,0:01:01.02,0:01:01.80,Default,,0,0,0,,veer mudra,
Dialogue: 0,0:01:01.80,0:01:03.63,Default,,0,0,0,,yaani yoddha ki mudra.
Dialogue: 0,0:01:03.63,0:01:05.19,Default,,0,0,0,,Kuch vidwan kehte hain,
Dialogue: 0,0:01:05.19,0:01:07.54,Default,,0,0,0,,khadi murti mitti mein jhuk gayi.
Dialogue: 0,0:01:07.99,0:01:09.81,Default,,0,0,0,,Umar par bhi do raay.
Dialogue: 0,0:01:09.81,0:01:13.15,Default,,0,0,0,,Mandir kehta hai lagbhag 700 saal.
Dialogue: 0,0:01:13.15,0:01:15.27,Default,,0,0,0,,Itihaskar kehte hain,
Dialogue: 0,0:01:15.27,0:01:16.48,Default,,0,0,0,,Bhakti daur ki.
Dialogue: 0,0:01:16.93,0:01:17.81,Default,,0,0,0,,Sach kya hai?
Dialogue: 0,0:01:17.81,0:01:20.45,Default,,0,0,0,,Asli umar aaj tak tay nahi
Dialogue: 0,0:01:20.45,0:01:20.75,Default,,0,0,0,,hui.
Dialogue: 0,0:01:20.75,0:01:23.98,Default,,0,0,0,,Rahasya abhi bhi zameen ke neeche.
Dialogue: 0,0:01:24.43,0:01:25.65,Default,,0,0,0,,Sabse bada twist.
Dialogue: 0,0:01:25.65,0:01:27.86,Default,,0,0,0,,Baadh mein Ganga ka paani mandir
Dialogue: 0,0:01:27.86,0:01:29.08,Default,,0,0,0,,mein utarta hai.
Dialogue: 0,0:01:29.08,0:01:30.06,Default,,0,0,0,,Bhakt kehte hain,
Dialogue: 0,0:01:30.06,0:01:32.51,Default,,0,0,0,,Ganga maiya charan dhone aati hain.
Dialogue: 0,0:01:32.96,0:01:34.63,Default,,0,0,0,,Aaj bhi qile ke bagal mein
Dialogue: 0,0:01:34.63,0:01:35.67,Default,,0,0,0,,seedhiyan utariye,
Dialogue: 0,0:01:35.67,0:01:37.55,Default,,0,0,0,,lete Hanuman saamne honge.
Dialogue: 0,0:01:37.99,0:01:38.89,Default,,0,0,0,,Nani ko bhejo,
Dialogue: 0,0:01:38.89,0:01:41.22,Default,,0,0,0,,jinhone lete Hanuman ki katha sunayi
Dialogue: 0,0:01:41.22,0:01:41.40,Default,,0,0,0,,thi.
