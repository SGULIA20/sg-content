Dialogue: 0,0:00:00.00,0:00:02.54,Default,,0,0,0,,Kedarnath ki deewaron par yeh kharoch
Dialogue: 0,0:00:02.54,0:00:04.16,Default,,0,0,0,,ke nishaan kisne chhode?
Dialogue: 0,0:00:04.61,0:00:05.92,Default,,0,0,0,,Katha kehti hai,
Dialogue: 0,0:00:05.92,0:00:07.77,Default,,0,0,0,,yuddh ke baad Pandav Shiv ko
Dialogue: 0,0:00:07.77,0:00:08.82,Default,,0,0,0,,dhoondh rahe the.
Dialogue: 0,0:00:08.82,0:00:10.92,Default,,0,0,0,,Shiv bail ban kar pahadon mein
Dialogue: 0,0:00:10.92,0:00:11.45,Default,,0,0,0,,chhup gaye.
Dialogue: 0,0:00:11.90,0:00:13.05,Default,,0,0,0,,Bhim ne pehchaan liya,
Dialogue: 0,0:00:13.05,0:00:14.90,Default,,0,0,0,,toh bail dharti mein samaa gaya.
Dialogue: 0,0:00:14.90,0:00:16.52,Default,,0,0,0,,Bahar reh gaya sirf kubad,
Dialogue: 0,0:00:16.52,0:00:18.83,Default,,0,0,0,,jo aaj Kedarnath mein pooja jaata
Dialogue: 0,0:00:18.83,0:00:19.06,Default,,0,0,0,,hai.
Dialogue: 0,0:00:19.51,0:00:20.11,Default,,0,0,0,,Ab sabut:
Dialogue: 0,0:00:20.11,0:00:22.91,Default,,0,0,0,,Wadia Institute of Himalayan Geology ko
Dialogue: 0,0:00:22.91,0:00:25.11,Default,,0,0,0,,pattharon par peeli lakeerein mili.
Dialogue: 0,0:00:25.56,0:00:27.20,Default,,0,0,0,,Inhe striations kehte hain,
Dialogue: 0,0:00:27.20,0:00:29.30,Default,,0,0,0,,yaani chalti barf ki ghisai ke
Dialogue: 0,0:00:29.30,0:00:29.77,Default,,0,0,0,,nishaan.
Dialogue: 0,0:00:29.77,0:00:31.17,Default,,0,0,0,,Matlab kabhi glacier,
Dialogue: 0,0:00:31.17,0:00:33.50,Default,,0,0,0,,yaani barf ki dheere chalti nadi,
Dialogue: 0,0:00:33.50,0:00:35.84,Default,,0,0,0,,mandir ke chaaron taraf sarka tha.
Dialogue: 0,0:00:36.29,0:00:38.86,Default,,0,0,0,,Archaeological Survey of India ne bataya,
Dialogue: 0,0:00:38.86,0:00:41.04,Default,,0,0,0,,pattharon ke beech koi masala nahi.
Dialogue: 0,0:00:41.04,0:00:42.82,Default,,0,0,0,,Granite block lohe ke clamp se
Dialogue: 0,0:00:42.82,0:00:43.41,Default,,0,0,0,,jude hain.
Dialogue: 0,0:00:43.86,0:00:44.70,Default,,0,0,0,,Banwaya kisne?
Dialogue: 0,0:00:44.70,0:00:47.24,Default,,0,0,0,,Kuch Adi Shankaracharya ka naam lete
Dialogue: 0,0:00:47.24,0:00:47.45,Default,,0,0,0,,hain,
Dialogue: 0,0:00:47.45,0:00:49.14,Default,,0,0,0,,kuch Malwa ke Raja Bhoj ka.
Dialogue: 0,0:00:49.59,0:00:51.87,Default,,0,0,0,,ASI banawat se umar aankta hai,
Dialogue: 0,0:00:51.87,0:00:53.93,Default,,0,0,0,,par maanyata hai pooja usse bhi
Dialogue: 0,0:00:53.93,0:00:54.76,Default,,0,0,0,,purani hai.
Dialogue: 0,0:00:54.76,0:00:56.83,Default,,0,0,0,,Pakka jawab kisi ke paas nahi.
Dialogue: 0,0:00:57.28,0:00:59.30,Default,,0,0,0,,Glacier ne mandir ko kitni der
Dialogue: 0,0:00:59.30,0:00:59.74,Default,,0,0,0,,dhaka,
Dialogue: 0,0:00:59.74,0:01:01.76,Default,,0,0,0,,yeh bhi abhi khula sawaal hai.
Dialogue: 0,0:01:02.21,0:01:04.75,Default,,0,0,0,,Twist June 2013 mein aaya.
Dialogue: 0,0:01:04.75,0:01:07.01,Default,,0,0,0,,Baadh ke saath ek vishaal patthar,
Dialogue: 0,0:01:07.01,0:01:08.71,Default,,0,0,0,,30 feet se lamba,
Dialogue: 0,0:01:08.71,0:01:11.25,Default,,0,0,0,,theek mandir ke peeche aa ruka.
Dialogue: 0,0:01:11.70,0:01:14.57,Default,,0,0,0,,Geological Survey of India ke mutabik,
Dialogue: 0,0:01:14.57,0:01:16.12,Default,,0,0,0,,isne dhaara ko baant diya.
Dialogue: 0,0:01:16.12,0:01:17.45,Default,,0,0,0,,Ishaan mandir beh gaya,
Dialogue: 0,0:01:17.45,0:01:18.55,Default,,0,0,0,,par garbhagriha,
Dialogue: 0,0:01:18.55,0:01:19.66,Default,,0,0,0,,jahan shivling hai,
Dialogue: 0,0:01:19.66,0:01:20.54,Default,,0,0,0,,bacha raha.
Dialogue: 0,0:01:20.99,0:01:22.92,Default,,0,0,0,,Log ise Bhim Shila kehte hain.
Dialogue: 0,0:01:22.92,0:01:24.63,Default,,0,0,0,,Aaj bhi yeh mandir ke peeche
Dialogue: 0,0:01:24.63,0:01:25.27,Default,,0,0,0,,dikhta hai.
Dialogue: 0,0:01:25.72,0:01:27.35,Default,,0,0,0,,Us dost ko bhejo jo har
Dialogue: 0,0:01:27.35,0:01:29.69,Default,,0,0,0,,saal Kedarnath jaane ki baat karta
Dialogue: 0,0:01:29.69,0:01:29.92,Default,,0,0,0,,hai.
