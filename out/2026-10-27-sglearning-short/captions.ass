Dialogue: 0,0:00:00.00,0:00:01.79,Default,,0,0,0,,Subah subah,
Dialogue: 0,0:00:01.79,0:00:04.92,Default,,0,0,0,,Bhai ki screen par sab hara
Dialogue: 0,0:00:04.92,0:00:06.71,Default,,0,0,0,,hi hara tha.
Dialogue: 0,0:00:06.71,0:00:09.40,Default,,0,0,0,,Group mein message aaya,
Dialogue: 0,0:00:09.40,0:00:12.08,Default,,0,0,0,,market wapas aa gaya.
Dialogue: 0,0:00:12.53,0:00:13.59,Default,,0,0,0,,Aaj expiry thi.
Dialogue: 0,0:00:13.59,0:00:15.93,Default,,0,0,0,,Expiry yaani hafte ke saudon ka
Dialogue: 0,0:00:15.93,0:00:16.56,Default,,0,0,0,,aakhri din,
Dialogue: 0,0:00:16.56,0:00:18.05,Default,,0,0,0,,jab sab kuch tez chalta hai.
Dialogue: 0,0:00:18.50,0:00:20.46,Default,,0,0,0,,Bhai ne socha,
Dialogue: 0,0:00:20.46,0:00:25.37,Default,,0,0,0,,crude ki khabar purani ho gayi,
Dialogue: 0,0:00:25.37,0:00:29.30,Default,,0,0,0,,market ne use bhula diya.
Dialogue: 0,0:00:29.75,0:00:32.65,Default,,0,0,0,,Kuch ghanton mein Sensex lagbhag 74,682
Dialogue: 0,0:00:32.65,0:00:33.61,Default,,0,0,0,,tak chadh gaya.
Dialogue: 0,0:00:33.61,0:00:34.90,Default,,0,0,0,,Bhai ko laga,
Dialogue: 0,0:00:34.90,0:00:37.15,Default,,0,0,0,,ab toh rukega nahi.
Dialogue: 0,0:00:37.60,0:00:41.84,Default,,0,0,0,,Usne apni chhoti bachat se ek
Dialogue: 0,0:00:41.84,0:00:43.96,Default,,0,0,0,,tez saudaa le liya.
Dialogue: 0,0:00:43.96,0:00:46.93,Default,,0,0,0,,Sab upar ja rahe hain,
Dialogue: 0,0:00:46.93,0:00:49.48,Default,,0,0,0,,main kyun peeche rahun?
Dialogue: 0,0:00:49.93,0:00:52.36,Default,,0,0,0,,Phir aayi dopahar ki bikwali.
Dialogue: 0,0:00:52.36,0:00:55.07,Default,,0,0,0,,Bikwali yaani log ek saath bechne
Dialogue: 0,0:00:55.07,0:00:55.61,Default,,0,0,0,,lage.
Dialogue: 0,0:00:56.06,0:01:00.43,Default,,0,0,0,,Shaam tak saari badhat gaayab.
Dialogue: 0,0:01:00.43,0:01:04.17,Default,,0,0,0,,Sensex neeche band hua,
Dialogue: 0,0:01:04.17,0:01:08.54,Default,,0,0,0,,aur Bhai ka paisa doob gaya.
Dialogue: 0,0:01:08.99,0:01:12.55,Default,,0,0,0,,Wajah koi chart nahi thi.
Dialogue: 0,0:01:12.55,0:01:17.13,Default,,0,0,0,,Wajah thi Middle East ka tension,
Dialogue: 0,0:01:17.13,0:01:21.71,Default,,0,0,0,,aur mehenga hota crude oil.
Dialogue: 0,0:01:22.16,0:01:22.83,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:01:22.83,0:01:25.51,Default,,0,0,0,,India apna lagbhag 88 percent crude
Dialogue: 0,0:01:25.51,0:01:27.08,Default,,0,0,0,,bahar se mangata hai.
Dialogue: 0,0:01:27.08,0:01:28.20,Default,,0,0,0,,Toh crude ki aag,
Dialogue: 0,0:01:28.20,0:01:30.88,Default,,0,0,0,,seedhe hamare market tak pahunchti hai.
Dialogue: 0,0:01:31.33,0:01:34.47,Default,,0,0,0,,Aur yahi crude petrol,
Dialogue: 0,0:01:34.47,0:01:38.97,Default,,0,0,0,,sabzi aur EMI ka hisaab badal
Dialogue: 0,0:01:38.97,0:01:40.32,Default,,0,0,0,,sakta hai.
Dialogue: 0,0:01:40.32,0:01:42.11,Default,,0,0,0,,Mehenga tel,
Dialogue: 0,0:01:42.11,0:01:44.81,Default,,0,0,0,,toh byaaj cut bhi der se.
Dialogue: 0,0:01:45.26,0:01:46.69,Default,,0,0,0,,Agar aap SIP wale hain,
Dialogue: 0,0:01:46.69,0:01:48.32,Default,,0,0,0,,toh roz ka hara laal aapki
Dialogue: 0,0:01:48.32,0:01:49.54,Default,,0,0,0,,kahani nahi hai.
Dialogue: 0,0:01:49.54,0:01:51.58,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:01:52.03,0:01:55.08,Default,,0,0,0,,Aapne kabhi expiry ke din trade
Dialogue: 0,0:01:55.08,0:01:55.36,Default,,0,0,0,,kiya?
Dialogue: 0,0:01:55.36,0:01:56.19,Default,,0,0,0,,Haan ya naa?
