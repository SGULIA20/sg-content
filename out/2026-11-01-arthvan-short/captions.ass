Dialogue: 0,0:00:00.00,0:00:02.49,Default,,0,0,0,,Ram Setu ke neeche drill kiya
Dialogue: 0,0:00:02.49,0:00:02.80,Default,,0,0,0,,gaya,
Dialogue: 0,0:00:02.80,0:00:04.04,Default,,0,0,0,,toh kya mila?
Dialogue: 0,0:00:04.49,0:00:06.26,Default,,0,0,0,,Valmiki Ramayana mein,
Dialogue: 0,0:00:06.26,0:00:09.56,Default,,0,0,0,,vanar Nala samundar par setu banate
Dialogue: 0,0:00:09.56,0:00:09.81,Default,,0,0,0,,hain.
Dialogue: 0,0:00:09.81,0:00:10.06,Default,,0,0,0,,Ped,
Dialogue: 0,0:00:10.06,0:00:12.85,Default,,0,0,0,,patthar aur chattanein lehron mein daali
Dialogue: 0,0:00:12.85,0:00:13.61,Default,,0,0,0,,jaati hain.
Dialogue: 0,0:00:14.06,0:00:15.19,Default,,0,0,0,,Granth kehta hai,
Dialogue: 0,0:00:15.19,0:00:17.45,Default,,0,0,0,,yeh mahapath sirf 5 din mein
Dialogue: 0,0:00:17.45,0:00:18.02,Default,,0,0,0,,bana.
Dialogue: 0,0:00:18.47,0:00:21.71,Default,,0,0,0,,Phir ISRO ke Space Applications Centre
Dialogue: 0,0:00:21.71,0:00:23.88,Default,,0,0,0,,ne satellite se dekha.
Dialogue: 0,0:00:23.88,0:00:26.85,Default,,0,0,0,,Remote sensing yaani door se zameen
Dialogue: 0,0:00:26.85,0:00:27.39,Default,,0,0,0,,ki jaanch.
Dialogue: 0,0:00:27.84,0:00:28.86,Default,,0,0,0,,Nateeja,
Dialogue: 0,0:00:28.86,0:00:31.92,Default,,0,0,0,,103 chhote patch reefs ki ek
Dialogue: 0,0:00:31.92,0:00:32.60,Default,,0,0,0,,line.
Dialogue: 0,0:00:32.60,0:00:36.00,Default,,0,0,0,,Patch reef yaani samundar mein coral
Dialogue: 0,0:00:36.00,0:00:37.36,Default,,0,0,0,,ke chhote dher.
Dialogue: 0,0:00:37.81,0:00:41.19,Default,,0,0,0,,Geological Survey of India ne wahan
Dialogue: 0,0:00:41.19,0:00:42.59,Default,,0,0,0,,core drilling ki.
Dialogue: 0,0:00:42.59,0:00:45.12,Default,,0,0,0,,Yaani pipe daal kar andar ki
Dialogue: 0,0:00:45.12,0:00:47.09,Default,,0,0,0,,parat bahar nikaalna.
Dialogue: 0,0:00:47.54,0:00:50.69,Default,,0,0,0,,Andar mila calcareous sandstone,
Dialogue: 0,0:00:50.69,0:00:53.22,Default,,0,0,0,,coral aur samundari ret.
Dialogue: 0,0:00:53.22,0:00:56.68,Default,,0,0,0,,Calcareous yaani chune wala patthar,
Dialogue: 0,0:00:56.68,0:00:58.26,Default,,0,0,0,,seepiyon se bana.
Dialogue: 0,0:00:58.71,0:01:01.90,Default,,0,0,0,,Archaeological Survey of India ne Supreme
Dialogue: 0,0:01:01.90,0:01:03.27,Default,,0,0,0,,Court mein apni raay di.
Dialogue: 0,0:01:03.27,0:01:05.32,Default,,0,0,0,,Yeh ret aur coral ki kudrati
Dialogue: 0,0:01:05.32,0:01:06.23,Default,,0,0,0,,banawat hai.
Dialogue: 0,0:01:06.68,0:01:09.72,Default,,0,0,0,,Lekin kuch geologists alag raay rakhte
Dialogue: 0,0:01:09.72,0:01:10.00,Default,,0,0,0,,hain.
Dialogue: 0,0:01:10.00,0:01:12.77,Default,,0,0,0,,Coral ke bade patthar dheeli ret
Dialogue: 0,0:01:12.77,0:01:14.43,Default,,0,0,0,,ke upar baithe hain,
Dialogue: 0,0:01:14.43,0:01:16.64,Default,,0,0,0,,jaise kisi ne rakhe hon.
Dialogue: 0,0:01:17.09,0:01:20.57,Default,,0,0,0,,Mainstream scientists ise tombolo kehte hain.
Dialogue: 0,0:01:20.57,0:01:23.76,Default,,0,0,0,,Tombolo yaani lehron se bani ret
Dialogue: 0,0:01:23.76,0:01:25.21,Default,,0,0,0,,ki patli patti.
Dialogue: 0,0:01:25.66,0:01:27.77,Default,,0,0,0,,Patthar khud aaye ya laaye gaye?
Dialogue: 0,0:01:27.77,0:01:31.08,Default,,0,0,0,,Iska aakhri jawab abhi kisi ke
Dialogue: 0,0:01:31.08,0:01:31.98,Default,,0,0,0,,paas nahi.
Dialogue: 0,0:01:32.43,0:01:33.37,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:01:33.37,0:01:35.88,Default,,0,0,0,,dono paksh ek hi drill core
Dialogue: 0,0:01:35.88,0:01:36.82,Default,,0,0,0,,padhte hain.
Dialogue: 0,0:01:36.82,0:01:40.26,Default,,0,0,0,,Rameswaram ke kinare se yeh shoals
Dialogue: 0,0:01:40.26,0:01:41.83,Default,,0,0,0,,aaj bhi dikhte hain.
Dialogue: 0,0:01:42.28,0:01:44.35,Default,,0,0,0,,Us dost ko bhejo jo kehta
Dialogue: 0,0:01:44.35,0:01:46.16,Default,,0,0,0,,hai Ram Setu sirf ret hai.
