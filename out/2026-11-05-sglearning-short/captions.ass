Dialogue: 0,0:00:00.00,0:00:02.75,Default,,0,0,0,,Aapki SIP ka paisa Meta ke
Dialogue: 0,0:00:02.75,0:00:04.88,Default,,0,0,0,,AI pe kharch ho raha hai?
Dialogue: 0,0:00:05.33,0:00:07.88,Default,,0,0,0,,Bhai har mahine FANG plus ETF
Dialogue: 0,0:00:07.88,0:00:09.47,Default,,0,0,0,,mein SIP karta hai.
Dialogue: 0,0:00:09.47,0:00:12.02,Default,,0,0,0,,Us fund mein Meta ka hissa
Dialogue: 0,0:00:12.02,0:00:13.29,Default,,0,0,0,,10.38 percent hai.
Dialogue: 0,0:00:13.74,0:00:15.62,Default,,0,0,0,,Uska logic simple hai,
Dialogue: 0,0:00:15.62,0:00:18.58,Default,,0,0,0,,Meta umeed se zyada kamaata hai.
Dialogue: 0,0:00:19.03,0:00:22.07,Default,,0,0,0,,Toh AI pe kharcha matlab aage
Dialogue: 0,0:00:22.07,0:00:22.75,Default,,0,0,0,,ki growth.
Dialogue: 0,0:00:23.20,0:00:24.96,Default,,0,0,0,,Par Meta ne is saal ka
Dialogue: 0,0:00:24.96,0:00:27.72,Default,,0,0,0,,AI kharcha 145 billion dollar tak
Dialogue: 0,0:00:27.72,0:00:28.47,Default,,0,0,0,,badha diya.
Dialogue: 0,0:00:28.47,0:00:30.98,Default,,0,0,0,,Capex yaani data center aur chips
Dialogue: 0,0:00:30.98,0:00:33.24,Default,,0,0,0,,pe hone wala bada kharcha.
Dialogue: 0,0:00:33.69,0:00:35.86,Default,,0,0,0,,Is quarter free cash flow minus
Dialogue: 0,0:00:35.86,0:00:36.95,Default,,0,0,0,,mein chala gaya,
Dialogue: 0,0:00:36.95,0:00:39.39,Default,,0,0,0,,yaani kharche ke baad cash nahi
Dialogue: 0,0:00:39.39,0:00:39.93,Default,,0,0,0,,bacha.
Dialogue: 0,0:00:40.38,0:00:41.47,Default,,0,0,0,,Kamai badhi,
Dialogue: 0,0:00:41.47,0:00:43.11,Default,,0,0,0,,par jeb ka cash minus.
Dialogue: 0,0:00:43.11,0:00:44.74,Default,,0,0,0,,Apne ETF mein dekho,
Dialogue: 0,0:00:44.74,0:00:46.65,Default,,0,0,0,,paisa kiske daav pe hai.
Dialogue: 0,0:00:46.65,0:00:49.38,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:49.83,0:00:51.72,Default,,0,0,0,,Us bhai ko bhejo jo FANG
Dialogue: 0,0:00:51.72,0:00:54.15,Default,,0,0,0,,ETF ko sabse safe maanta hai.
