Dialogue: 0,0:00:00.00,0:00:02.16,Default,,0,0,0,,Sensex 60.9 percent gira,
Dialogue: 0,0:00:02.16,0:00:04.93,Default,,0,0,0,,phir bhi SIP chalane wale jeet
Dialogue: 0,0:00:04.93,0:00:05.24,Default,,0,0,0,,gaye.
Dialogue: 0,0:00:05.69,0:00:08.85,Default,,0,0,0,,2008 mein Amreeka ka bank Lehman
Dialogue: 0,0:00:08.85,0:00:09.38,Default,,0,0,0,,dooba,
Dialogue: 0,0:00:09.38,0:00:10.69,Default,,0,0,0,,aur darr India aaya.
Dialogue: 0,0:00:10.69,0:00:11.74,Default,,0,0,0,,Naukri ka darr,
Dialogue: 0,0:00:11.74,0:00:13.59,Default,,0,0,0,,ghar mein SIP band karne ki
Dialogue: 0,0:00:13.59,0:00:13.85,Default,,0,0,0,,baat.
Dialogue: 0,0:00:14.30,0:00:15.04,Default,,0,0,0,,Aap hote,
Dialogue: 0,0:00:15.04,0:00:16.26,Default,,0,0,0,,toh SIP band karte?
Dialogue: 0,0:00:16.71,0:00:18.93,Default,,0,0,0,,Bahut logon ne SIP rok di.
Dialogue: 0,0:00:18.93,0:00:21.71,Default,,0,0,0,,Girte market mein paisa kyun daalein?
Dialogue: 0,0:00:22.16,0:00:24.73,Default,,0,0,0,,Videshi investors bhi paisa nikaal rahe
Dialogue: 0,0:00:24.73,0:00:24.93,Default,,0,0,0,,the,
Dialogue: 0,0:00:24.93,0:00:26.12,Default,,0,0,0,,toh darr sahi laga.
Dialogue: 0,0:00:26.57,0:00:28.00,Default,,0,0,0,,Jinki SIP chalti rahi,
Dialogue: 0,0:00:28.00,0:00:30.24,Default,,0,0,0,,unhe sasti keemat par zyada hisse
Dialogue: 0,0:00:30.24,0:00:30.65,Default,,0,0,0,,mile.
Dialogue: 0,0:00:31.10,0:00:34.22,Default,,0,0,0,,Phir 2009 mein Nifty 75.76 percent
Dialogue: 0,0:00:34.22,0:00:34.79,Default,,0,0,0,,chadha,
Dialogue: 0,0:00:34.79,0:00:36.78,Default,,0,0,0,,wahi hisse chamak gaye.
Dialogue: 0,0:00:37.23,0:00:39.16,Default,,0,0,0,,Girta market dushman nahi,
Dialogue: 0,0:00:39.16,0:00:39.89,Default,,0,0,0,,sale tha.
Dialogue: 0,0:00:39.89,0:00:42.31,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:42.76,0:00:44.32,Default,,0,0,0,,Us dost ko bhejo jo girte
Dialogue: 0,0:00:44.32,0:00:45.88,Default,,0,0,0,,market mein SIP band kar deta
Dialogue: 0,0:00:45.88,0:00:46.08,Default,,0,0,0,,hai.
