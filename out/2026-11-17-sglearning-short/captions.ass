Dialogue: 0,0:00:00.00,0:00:01.42,Default,,0,0,0,,Sensex aadha ho gaya,
Dialogue: 0,0:00:01.42,0:00:03.55,Default,,0,0,0,,phir bhi SIP wale kaise jeete?
Dialogue: 0,0:00:04.00,0:00:04.28,Default,,0,0,0,,2008.
Dialogue: 0,0:00:04.28,0:00:06.88,Default,,0,0,0,,Amreeka ka bank Lehman dooba,
Dialogue: 0,0:00:06.88,0:00:08.61,Default,,0,0,0,,aur darr India tak aaya.
Dialogue: 0,0:00:09.06,0:00:10.95,Default,,0,0,0,,Sensex 21,000 se girkar aadhe se
Dialogue: 0,0:00:10.95,0:00:12.01,Default,,0,0,0,,bhi neeche aa gaya.
Dialogue: 0,0:00:12.01,0:00:13.48,Default,,0,0,0,,Sharma ji ne SIP band kar
Dialogue: 0,0:00:13.48,0:00:13.69,Default,,0,0,0,,di.
Dialogue: 0,0:00:14.14,0:00:14.96,Default,,0,0,0,,Soch seedhi thi:
Dialogue: 0,0:00:14.96,0:00:17.01,Default,,0,0,0,,girte market mein paisa kyun daalna?
Dialogue: 0,0:00:17.46,0:00:19.33,Default,,0,0,0,,Padosi Mehta ji ne SIP chalu
Dialogue: 0,0:00:19.33,0:00:19.70,Default,,0,0,0,,rakhi.
Dialogue: 0,0:00:19.70,0:00:20.26,Default,,0,0,0,,Kisht wahi,
Dialogue: 0,0:00:20.26,0:00:21.94,Default,,0,0,0,,par saste daam par zyada hisse
Dialogue: 0,0:00:21.94,0:00:22.31,Default,,0,0,0,,mile.
Dialogue: 0,0:00:22.76,0:00:24.80,Default,,0,0,0,,SIP yaani har mahine tay rakam.
Dialogue: 0,0:00:24.80,0:00:25.42,Default,,0,0,0,,Daam gire,
Dialogue: 0,0:00:25.42,0:00:27.25,Default,,0,0,0,,toh usi rakam mein zyada maal.
Dialogue: 0,0:00:27.70,0:00:30.54,Default,,0,0,0,,Phir 2009 mein Nifty 75.76 percent
Dialogue: 0,0:00:30.54,0:00:31.06,Default,,0,0,0,,chadha.
Dialogue: 0,0:00:31.06,0:00:33.64,Default,,0,0,0,,Mehta ji ke saste hisse chamak
Dialogue: 0,0:00:33.64,0:00:34.15,Default,,0,0,0,,uthe.
Dialogue: 0,0:00:34.60,0:00:35.66,Default,,0,0,0,,Sharma ji laute,
Dialogue: 0,0:00:35.66,0:00:36.71,Default,,0,0,0,,par mehnge daam par.
Dialogue: 0,0:00:36.71,0:00:38.39,Default,,0,0,0,,Girta market dushman nahi,
Dialogue: 0,0:00:38.39,0:00:39.03,Default,,0,0,0,,sale tha.
Dialogue: 0,0:00:39.03,0:00:41.13,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:41.58,0:00:42.92,Default,,0,0,0,,Us dost ko bhejo jo market
Dialogue: 0,0:00:42.92,0:00:44.26,Default,,0,0,0,,girte hi SIP band kar deta
Dialogue: 0,0:00:44.26,0:00:44.43,Default,,0,0,0,,hai.
