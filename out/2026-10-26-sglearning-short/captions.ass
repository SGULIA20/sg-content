Dialogue: 0,0:00:00.00,0:00:07.11,Default,,0,0,0,,Budhvaar subah,
Dialogue: 0,0:00:07.11,0:00:24.88,Default,,0,0,0,,office canteen mein Bhai ka phone
Dialogue: 0,0:00:24.88,0:00:37.32,Default,,0,0,0,,lagataar baj raha hai.
Dialogue: 0,0:00:37.77,0:00:41.24,Default,,0,0,0,,Group mein message aaya,
Dialogue: 0,0:00:41.24,0:00:44.71,Default,,0,0,0,,Sensex udd raha hai,
Dialogue: 0,0:00:44.71,0:00:47.03,Default,,0,0,0,,abhi ghuso.
Dialogue: 0,0:00:47.03,0:00:53.39,Default,,0,0,0,,Sensex yaani desh ki badi companies
Dialogue: 0,0:00:53.39,0:00:55.13,Default,,0,0,0,,ka score.
Dialogue: 0,0:00:55.58,0:01:01.94,Default,,0,0,0,,Din ke beech Sensex lagbhag 829
Dialogue: 0,0:01:01.94,0:01:06.40,Default,,0,0,0,,points upar chala gaya tha.
Dialogue: 0,0:01:06.40,0:01:09.58,Default,,0,0,0,,Har screen hari thi.
Dialogue: 0,0:01:10.03,0:01:11.00,Default,,0,0,0,,Bhai ne socha,
Dialogue: 0,0:01:11.00,0:01:12.45,Default,,0,0,0,,sab khareed rahe hain,
Dialogue: 0,0:01:12.45,0:01:14.15,Default,,0,0,0,,toh main peeche kyun rahun.
Dialogue: 0,0:01:14.60,0:01:18.02,Default,,0,0,0,,Logic seedha tha,
Dialogue: 0,0:01:18.02,0:01:22.80,Default,,0,0,0,,jo upar ja raha hai,
Dialogue: 0,0:01:22.80,0:01:26.89,Default,,0,0,0,,woh aur upar jayega.
Dialogue: 0,0:01:26.89,0:01:32.36,Default,,0,0,0,,Lunch mein jaldi se order daal
Dialogue: 0,0:01:32.36,0:01:33.04,Default,,0,0,0,,diya.
Dialogue: 0,0:01:33.49,0:01:35.30,Default,,0,0,0,,Behen ne poocha,
Dialogue: 0,0:01:35.30,0:01:36.39,Default,,0,0,0,,badha kyun?
Dialogue: 0,0:01:36.39,0:01:37.47,Default,,0,0,0,,Bhai bola,
Dialogue: 0,0:01:37.47,0:01:38.92,Default,,0,0,0,,wajah chhodo,
Dialogue: 0,0:01:38.92,0:01:40.73,Default,,0,0,0,,bas tezi dekho.
Dialogue: 0,0:01:41.18,0:01:45.07,Default,,0,0,0,,Dopahar ke baad market palatne laga.
Dialogue: 0,0:01:45.07,0:01:47.98,Default,,0,0,0,,Ek ek karke saari tezi gayab.
Dialogue: 0,0:01:48.43,0:01:51.94,Default,,0,0,0,,Shaam ko Sensex 143 points neeche
Dialogue: 0,0:01:51.94,0:01:52.64,Default,,0,0,0,,band hua.
Dialogue: 0,0:01:52.64,0:01:54.05,Default,,0,0,0,,Upar nahi,
Dialogue: 0,0:01:54.05,0:01:54.75,Default,,0,0,0,,neeche.
Dialogue: 0,0:01:55.20,0:01:57.71,Default,,0,0,0,,Bhai ne sabse oonche daam par
Dialogue: 0,0:01:57.71,0:01:58.96,Default,,0,0,0,,entry li thi.
Dialogue: 0,0:01:58.96,0:02:00.84,Default,,0,0,0,,Ab uski screen laal thi.
Dialogue: 0,0:02:01.29,0:02:03.38,Default,,0,0,0,,Twist yeh hai,
Dialogue: 0,0:02:03.38,0:02:08.95,Default,,0,0,0,,ek din ki tezi sirf khabar
Dialogue: 0,0:02:08.95,0:02:09.65,Default,,0,0,0,,hai,
Dialogue: 0,0:02:09.65,0:02:11.74,Default,,0,0,0,,plan nahi.
Dialogue: 0,0:02:11.74,0:02:18.01,Default,,0,0,0,,Market din bhar mood badalta hai.
Dialogue: 0,0:02:18.46,0:02:20.06,Default,,0,0,0,,Group ka shor nahi,
Dialogue: 0,0:02:20.06,0:02:22.30,Default,,0,0,0,,apna goal dekh kar chalo.
Dialogue: 0,0:02:22.30,0:02:25.50,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:02:25.95,0:02:29.33,Default,,0,0,0,,Aapne kabhi tezi dekh kar jaldi
Dialogue: 0,0:02:29.33,0:02:31.02,Default,,0,0,0,,mein khareeda hai?
Dialogue: 0,0:02:31.02,0:02:32.03,Default,,0,0,0,,Haan ya na?
