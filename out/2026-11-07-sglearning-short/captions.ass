Dialogue: 0,0:00:00.00,0:00:01.19,Default,,0,0,0,,Aapki SIP doobe,
Dialogue: 0,0:00:01.19,0:00:03.32,Default,,0,0,0,,phir bhi fund house kyun kamata
Dialogue: 0,0:00:03.32,0:00:03.56,Default,,0,0,0,,hai?
Dialogue: 0,0:00:04.01,0:00:06.16,Default,,0,0,0,,Har mahine salary aate hi SIP
Dialogue: 0,0:00:06.16,0:00:06.94,Default,,0,0,0,,kat jaati hai.
Dialogue: 0,0:00:06.94,0:00:08.11,Default,,0,0,0,,Wife ko lagta hai,
Dialogue: 0,0:00:08.11,0:00:09.87,Default,,0,0,0,,yeh paisa sirf hamare liye kaam
Dialogue: 0,0:00:09.87,0:00:10.45,Default,,0,0,0,,karta hai.
Dialogue: 0,0:00:10.90,0:00:12.04,Default,,0,0,0,,Market gira,
Dialogue: 0,0:00:12.04,0:00:14.32,Default,,0,0,0,,Papa bole SIP band karo.
Dialogue: 0,0:00:14.32,0:00:16.31,Default,,0,0,0,,Wife ne chalu rakhi,
Dialogue: 0,0:00:16.31,0:00:18.02,Default,,0,0,0,,plan lambi daud ka tha.
Dialogue: 0,0:00:18.47,0:00:19.94,Default,,0,0,0,,Unka logic seedha tha,
Dialogue: 0,0:00:19.94,0:00:22.47,Default,,0,0,0,,hum kamayenge tabhi fund wale kamayenge.
Dialogue: 0,0:00:22.92,0:00:25.38,Default,,0,0,0,,Nippon Life India lakhon logon ki
Dialogue: 0,0:00:25.38,0:00:26.50,Default,,0,0,0,,SIP sambhalti hai.
Dialogue: 0,0:00:26.50,0:00:27.39,Default,,0,0,0,,Andaza tha,
Dialogue: 0,0:00:27.39,0:00:30.52,Default,,0,0,0,,July-September ka munafa 4.22 billion rupaye.
Dialogue: 0,0:00:30.97,0:00:33.51,Default,,0,0,0,,Pichhle saal se 22.3 percent zyada.
Dialogue: 0,0:00:33.51,0:00:35.76,Default,,0,0,0,,Kyunki fees har din kat-ti hai,
Dialogue: 0,0:00:35.76,0:00:37.73,Default,,0,0,0,,market gire ya chadhe.
Dialogue: 0,0:00:38.18,0:00:39.37,Default,,0,0,0,,Aap partner nahi,
Dialogue: 0,0:00:39.37,0:00:40.33,Default,,0,0,0,,customer ho.
Dialogue: 0,0:00:40.33,0:00:42.00,Default,,0,0,0,,Expense ratio dekho,
Dialogue: 0,0:00:42.00,0:00:43.43,Default,,0,0,0,,yaani saal bhar ki fees.
Dialogue: 0,0:00:43.43,0:00:45.82,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:46.27,0:00:47.98,Default,,0,0,0,,Us dost ko bhejo jo sochta
Dialogue: 0,0:00:47.98,0:00:49.70,Default,,0,0,0,,hai fund wale bhi saath doobte
Dialogue: 0,0:00:49.70,0:00:49.91,Default,,0,0,0,,hain.
