Dialogue: 0,0:00:00.00,0:00:02.23,Default,,0,0,0,,Binance se record chori hui,
Dialogue: 0,0:00:02.23,0:00:03.96,Default,,0,0,0,,phir 90 percent wapas?
Dialogue: 0,0:00:04.41,0:00:06.81,Default,,0,0,0,,Binance duniya ka sabse bada crypto
Dialogue: 0,0:00:06.81,0:00:07.61,Default,,0,0,0,,exchange hai,
Dialogue: 0,0:00:07.61,0:00:09.81,Default,,0,0,0,,digital sikkon ki online mandi.
Dialogue: 0,0:00:10.26,0:00:11.84,Default,,0,0,0,,Company ke mutabik,
Dialogue: 0,0:00:11.84,0:00:13.64,Default,,0,0,0,,hackers ne ab tak ki sabse
Dialogue: 0,0:00:13.64,0:00:15.22,Default,,0,0,0,,badi crypto chori ki.
Dialogue: 0,0:00:15.67,0:00:17.62,Default,,0,0,0,,Phir Binance ne apni jeb se
Dialogue: 0,0:00:17.62,0:00:19.80,Default,,0,0,0,,naye token kharid kar 90 percent
Dialogue: 0,0:00:19.80,0:00:20.23,Default,,0,0,0,,bhar diya.
Dialogue: 0,0:00:20.68,0:00:22.14,Default,,0,0,0,,Paisa emergency fund,
Dialogue: 0,0:00:22.14,0:00:22.98,Default,,0,0,0,,yaani SAFU,
Dialogue: 0,0:00:22.98,0:00:25.27,Default,,0,0,0,,aur company ke apne khazane se
Dialogue: 0,0:00:25.27,0:00:25.48,Default,,0,0,0,,aaya.
Dialogue: 0,0:00:25.93,0:00:27.98,Default,,0,0,0,,Baaki hissa mushkil se milne wale
Dialogue: 0,0:00:27.98,0:00:28.73,Default,,0,0,0,,tokens ka hai,
Dialogue: 0,0:00:28.73,0:00:30.41,Default,,0,0,0,,isme thoda time lagega.
Dialogue: 0,0:00:30.86,0:00:32.99,Default,,0,0,0,,India mein crypto kamai par seedha
Dialogue: 0,0:00:32.99,0:00:34.70,Default,,0,0,0,,30 percent tax lagta hai.
Dialogue: 0,0:00:35.15,0:00:37.26,Default,,0,0,0,,Har bechne par 1 percent TDS
Dialogue: 0,0:00:37.26,0:00:38.31,Default,,0,0,0,,bhi kat'ta hai,
Dialogue: 0,0:00:38.31,0:00:40.69,Default,,0,0,0,,yaani tax pehle hi kat jaata
Dialogue: 0,0:00:40.69,0:00:40.95,Default,,0,0,0,,hai.
Dialogue: 0,0:00:41.40,0:00:43.38,Default,,0,0,0,,Income Tax rules mein chori ya
Dialogue: 0,0:00:43.38,0:00:44.77,Default,,0,0,0,,phansa crypto ka nuksaan,
Dialogue: 0,0:00:44.77,0:00:46.56,Default,,0,0,0,,kamai se minus nahi hota.
Dialogue: 0,0:00:47.01,0:00:48.58,Default,,0,0,0,,Isliye munafa nahi,
Dialogue: 0,0:00:48.58,0:00:50.37,Default,,0,0,0,,platform ki tijori dekho.
Dialogue: 0,0:00:50.37,0:00:52.61,Default,,0,0,0,,Yeh investment advice nahi hai.
Dialogue: 0,0:00:53.06,0:00:54.46,Default,,0,0,0,,Yeh us bhai ko bhejo jo
Dialogue: 0,0:00:54.46,0:00:56.26,Default,,0,0,0,,exchange par crypto rakhta hai.
