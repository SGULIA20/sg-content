Dialogue: 0,0:00:00.00,0:00:02.19,Default,,0,0,0,,Ek patthar ne Kedarnath mandir ko
Dialogue: 0,0:00:02.19,0:00:03.07,Default,,0,0,0,,kaise bachaya?
Dialogue: 0,0:00:03.07,0:00:05.26,Default,,0,0,0,,Skanda Purana Kedar ko Shiv ka
Dialogue: 0,0:00:05.26,0:00:06.36,Default,,0,0,0,,dham batata hai.
Dialogue: 0,0:00:06.81,0:00:08.08,Default,,0,0,0,,Lok katha kehti hai,
Dialogue: 0,0:00:08.08,0:00:10.19,Default,,0,0,0,,Pandav yahan Shiv ki kripa maangne
Dialogue: 0,0:00:10.19,0:00:10.61,Default,,0,0,0,,aaye the.
Dialogue: 0,0:00:11.06,0:00:14.87,Default,,0,0,0,,June 2013 mein Chorabari se baadh
Dialogue: 0,0:00:14.87,0:00:15.17,Default,,0,0,0,,aayi,
Dialogue: 0,0:00:15.17,0:00:17.22,Default,,0,0,0,,keechad aur patthar lekar.
Dialogue: 0,0:00:17.67,0:00:21.13,Default,,0,0,0,,ASI yaani Archaeological Survey of India
Dialogue: 0,0:00:21.13,0:00:21.88,Default,,0,0,0,,ne jaanch ki.
Dialogue: 0,0:00:21.88,0:00:23.61,Default,,0,0,0,,Aas paas ke ghar aur Ishaan
Dialogue: 0,0:00:23.61,0:00:24.60,Default,,0,0,0,,mandir beh gaye.
Dialogue: 0,0:00:24.60,0:00:27.07,Default,,0,0,0,,Par mandir ka andar wala kamra
Dialogue: 0,0:00:27.07,0:00:28.31,Default,,0,0,0,,salamat raha.
Dialogue: 0,0:00:28.76,0:00:31.13,Default,,0,0,0,,Geological Survey of India ne dekha,
Dialogue: 0,0:00:31.13,0:00:32.91,Default,,0,0,0,,ek vishaal boulder mandir ke theek
Dialogue: 0,0:00:32.91,0:00:33.70,Default,,0,0,0,,peeche ruka.
Dialogue: 0,0:00:33.70,0:00:35.68,Default,,0,0,0,,Usne malbe ko dono taraf baant
Dialogue: 0,0:00:35.68,0:00:35.88,Default,,0,0,0,,diya.
Dialogue: 0,0:00:36.33,0:00:38.17,Default,,0,0,0,,Patthar bina masale ke,
Dialogue: 0,0:00:38.17,0:00:40.02,Default,,0,0,0,,lohe ke clamp se jode gaye
Dialogue: 0,0:00:40.02,0:00:40.25,Default,,0,0,0,,the.
Dialogue: 0,0:00:40.25,0:00:42.33,Default,,0,0,0,,ASI is dhaanche ko lagbhag saal
Dialogue: 0,0:00:42.33,0:00:44.17,Default,,0,0,0,,1050 ka maanta hai.
Dialogue: 0,0:00:44.62,0:00:45.84,Default,,0,0,0,,Par banwaya kisne?
Dialogue: 0,0:00:45.84,0:00:48.53,Default,,0,0,0,,Kuch Adi Shankaracharya kehte hain,
Dialogue: 0,0:00:48.53,0:00:49.51,Default,,0,0,0,,kuch Raja Bhoj,
Dialogue: 0,0:00:49.51,0:00:50.98,Default,,0,0,0,,kuch Katyuri raaja.
Dialogue: 0,0:00:51.43,0:00:54.16,Default,,0,0,0,,Wadia Institute ko deewaron par glacier
Dialogue: 0,0:00:54.16,0:00:55.42,Default,,0,0,0,,ki kharonchein mili,
Dialogue: 0,0:00:55.42,0:00:57.31,Default,,0,0,0,,yaani barf ki nadi ke nishaan.
Dialogue: 0,0:00:57.76,0:00:59.65,Default,,0,0,0,,Kuch kehte hain mandir sadiyon barf
Dialogue: 0,0:00:59.65,0:01:00.70,Default,,0,0,0,,mein dabaa raha.
Dialogue: 0,0:01:00.70,0:01:01.76,Default,,0,0,0,,Doosre kehte hain,
Dialogue: 0,0:01:01.76,0:01:03.44,Default,,0,0,0,,glacier ne sirf kinara chhua.
Dialogue: 0,0:01:03.89,0:01:05.40,Default,,0,0,0,,Pehla mandir kab bana,
Dialogue: 0,0:01:05.40,0:01:07.13,Default,,0,0,0,,aur boulder wahin kyun ruka,
Dialogue: 0,0:01:07.13,0:01:08.21,Default,,0,0,0,,koi nahi jaanta.
Dialogue: 0,0:01:08.66,0:01:10.52,Default,,0,0,0,,Aaj log ise Bhim Shila kehte
Dialogue: 0,0:01:10.52,0:01:10.73,Default,,0,0,0,,hain.
Dialogue: 0,0:01:10.73,0:01:12.59,Default,,0,0,0,,Mandir ke peeche aap ise khud
Dialogue: 0,0:01:12.59,0:01:13.42,Default,,0,0,0,,dekh sakte hain.
Dialogue: 0,0:01:13.87,0:01:15.27,Default,,0,0,0,,Aapko kya lagta hai,
Dialogue: 0,0:01:15.27,0:01:18.08,Default,,0,0,0,,mandir patthar ne bachaya ya kaarigari
Dialogue: 0,0:01:18.08,0:01:18.31,Default,,0,0,0,,ne?
