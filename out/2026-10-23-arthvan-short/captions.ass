Dialogue: 0,0:00:00.00,0:00:02.57,Default,,0,0,0,,Ek patthar ne Kedarnath mandir ko
Dialogue: 0,0:00:02.57,0:00:03.59,Default,,0,0,0,,kaise bachaya?
Dialogue: 0,0:00:03.59,0:00:06.16,Default,,0,0,0,,Skanda Purana Kedar ko Shiv ka
Dialogue: 0,0:00:06.16,0:00:07.44,Default,,0,0,0,,dham batata hai.
Dialogue: 0,0:00:07.89,0:00:09.42,Default,,0,0,0,,Lok katha kehti hai,
Dialogue: 0,0:00:09.42,0:00:11.98,Default,,0,0,0,,Pandav yahan Shiv ki kripa maangne
Dialogue: 0,0:00:11.98,0:00:12.49,Default,,0,0,0,,aaye the.
Dialogue: 0,0:00:12.94,0:00:16.43,Default,,0,0,0,,June 2013 mein Chorabari se baadh
Dialogue: 0,0:00:16.43,0:00:16.70,Default,,0,0,0,,aayi,
Dialogue: 0,0:00:16.70,0:00:18.58,Default,,0,0,0,,keechad aur patthar lekar.
Dialogue: 0,0:00:19.03,0:00:22.31,Default,,0,0,0,,ASI yaani Archaeological Survey of India
Dialogue: 0,0:00:22.31,0:00:23.02,Default,,0,0,0,,ne jaanch ki.
Dialogue: 0,0:00:23.02,0:00:24.66,Default,,0,0,0,,Aas paas ke ghar aur Ishaan
Dialogue: 0,0:00:24.66,0:00:25.59,Default,,0,0,0,,mandir beh gaye.
Dialogue: 0,0:00:25.59,0:00:27.94,Default,,0,0,0,,Par mandir ka andar wala kamra
Dialogue: 0,0:00:27.94,0:00:29.11,Default,,0,0,0,,salamat raha.
Dialogue: 0,0:00:29.56,0:00:32.52,Default,,0,0,0,,Geological Survey of India ne dekha,
Dialogue: 0,0:00:32.52,0:00:34.74,Default,,0,0,0,,ek vishaal boulder mandir ke theek
Dialogue: 0,0:00:34.74,0:00:35.73,Default,,0,0,0,,peeche ruka.
Dialogue: 0,0:00:35.73,0:00:38.19,Default,,0,0,0,,Usne malbe ko dono taraf baant
Dialogue: 0,0:00:38.19,0:00:38.44,Default,,0,0,0,,diya.
Dialogue: 0,0:00:38.89,0:00:40.80,Default,,0,0,0,,Patthar bina masale ke,
Dialogue: 0,0:00:40.80,0:00:42.71,Default,,0,0,0,,lohe ke clamp se jode gaye
Dialogue: 0,0:00:42.71,0:00:42.95,Default,,0,0,0,,the.
Dialogue: 0,0:00:42.95,0:00:45.10,Default,,0,0,0,,ASI is dhaanche ko lagbhag saal
Dialogue: 0,0:00:45.10,0:00:47.01,Default,,0,0,0,,1050 ka maanta hai.
Dialogue: 0,0:00:47.46,0:00:53.37,Default,,0,0,0,,Par banwaya kisne?
Dialogue: 0,0:00:53.37,0:01:06.36,Default,,0,0,0,,Kuch Adi Shankaracharya kehte hain,
Dialogue: 0,0:01:06.36,0:01:11.09,Default,,0,0,0,,kuch Raja Bhoj,
Dialogue: 0,0:01:11.09,0:01:18.18,Default,,0,0,0,,kuch Katyuri raaja.
Dialogue: 0,0:01:18.63,0:01:21.53,Default,,0,0,0,,Wadia Institute ko deewaron par glacier
Dialogue: 0,0:01:21.53,0:01:22.86,Default,,0,0,0,,ki kharonchein mili,
Dialogue: 0,0:01:22.86,0:01:24.87,Default,,0,0,0,,yaani barf ki nadi ke nishaan.
Dialogue: 0,0:01:25.32,0:01:27.71,Default,,0,0,0,,Kuch kehte hain mandir sadiyon barf
Dialogue: 0,0:01:27.71,0:01:29.03,Default,,0,0,0,,mein dabaa raha.
Dialogue: 0,0:01:29.03,0:01:30.36,Default,,0,0,0,,Doosre kehte hain,
Dialogue: 0,0:01:30.36,0:01:32.48,Default,,0,0,0,,glacier ne sirf kinara chhua.
Dialogue: 0,0:01:32.93,0:01:36.46,Default,,0,0,0,,Pehla mandir kab bana,
Dialogue: 0,0:01:36.46,0:01:40.49,Default,,0,0,0,,aur boulder wahin kyun ruka,
Dialogue: 0,0:01:40.49,0:01:43.01,Default,,0,0,0,,koi nahi jaanta.
Dialogue: 0,0:01:43.46,0:01:45.35,Default,,0,0,0,,Aaj log ise Bhim Shila kehte
Dialogue: 0,0:01:45.35,0:01:45.56,Default,,0,0,0,,hain.
Dialogue: 0,0:01:45.56,0:01:47.46,Default,,0,0,0,,Mandir ke peeche aap ise khud
Dialogue: 0,0:01:47.46,0:01:48.30,Default,,0,0,0,,dekh sakte hain.
Dialogue: 0,0:01:48.75,0:01:50.28,Default,,0,0,0,,Aapko kya lagta hai,
Dialogue: 0,0:01:50.28,0:01:53.33,Default,,0,0,0,,mandir patthar ne bachaya ya kaarigari
Dialogue: 0,0:01:53.33,0:01:53.59,Default,,0,0,0,,ne?
