# Copy to .env and fill in. Names and sources: docs/secrets.md. Never commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_SGLEARNING_REFRESH_TOKEN=
YT_ARTHVAN_REFRESH_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# LinkedIn (optional; personal profile): client id/secret only for `python -m engine.linkedin --auth`, which prints the other two
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
# optional: override the LinkedIn-Version header (YYYYMM)
LINKEDIN_VERSION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: lets refresh-tokens rotate secrets itself
ACTIONS_PAT=
# optional: the founder's control room (private claude.ai page); value from Supabase → Vault → sg_command_ingest
SG_COMMAND_KEY=
